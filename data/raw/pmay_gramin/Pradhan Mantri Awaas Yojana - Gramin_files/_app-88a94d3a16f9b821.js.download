3e \u0b09\u0b32\u0b4d\u0b32\u0b19\u0b4d\u0b18\u0b28 \u0b2c\u0b3f\u0b37\u0b5f\u0b30\u0b47 24 \u0b18\u0b23\u0b4d\u0b1f\u0b3e \u0b2e\u0b27\u0b4d\u0b5f\u0b30\u0b47 \u0b2e\u0b3e\u0b07\u0b38\u0b4d\u0b1a\u0b3f\u0b2e \u0b26\u0b33\u0b15\u0b41 \u0b1c\u0b23\u0b3e\u0b07\u0b2c\u0b3e\u0b15\u0b41 \u0b2a\u0b21\u0b3c\u0b3f\u0b2c, \u0b0f\u0b2c\u0b02 \u0b09\u0b32\u0b4d\u0b32\u0b19\u0b4d\u0b18\u0b28\u0b15\u0b41 \u0b39\u0b4d\u0b30\u0b3e\u0b38 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b24\u0b41\u0b30\u0b28\u0b4d\u0b24 \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b3e\u0b28\u0b41\u0b37\u0b4d\u0b20\u0b3e\u0b28 \u0b17\u0b4d\u0b30\u0b39\u0b23 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b2a\u0b21\u0b3c\u0b3f\u0b2c\u0964 \u0b24\u0b43\u0b24\u0b40\u0b5f \u0b2a\u0b15\u0b4d\u0b37 \u0b2e\u0b42\u0b32\u0b4d\u0b5f\u0b3e\u0b19\u0b4d\u0b15\u0b28 \u0b38\u0b2e\u0b47\u0b24 \u0b28\u0b3f\u0b5f\u0b2e\u0b3f\u0b24 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b05\u0b21\u0b3f\u0b1f\u0b4d, \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b2e\u0b3e\u0b28\u0b15 \u0b38\u0b39\u0b3f\u0b24 \u0b28\u0b3f\u0b30\u0b28\u0b4d\u0b24\u0b30 \u0b05\u0b28\u0b41\u0b2a\u0b3e\u0b33\u0b28 \u0b38\u0b41\u0b28\u0b3f\u0b36\u0b4d\u0b1a\u0b3f\u0b24 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b15\u0b30\u0b3e\u0b2f\u0b3f\u0b2c\u0b3e \u0b09\u0b1a\u0b3f\u0b24\u0964"),(0,xe.Z)(ee,"urlSubHeading3Text","<span> <span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span>"),(0,xe.Z)(ee,"urlSubHeading4Text","<span> <span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span>"),(0,xe.Z)(ee,"urlSubHeading5Text","1. 1 \u0b06\u0b2a\u0b23 \u0b38\u0b2e\u0b38\u0b4d\u0b24 \u0b2a\u0b4d\u0b30\u0b2f\u0b41\u0b1c\u0b4d\u0b5f \u0b06\u0b07\u0b28, \u0b28\u0b3f\u0b5f\u0b2e\u0b3e\u0b2c\u0b33\u0b40 \u0b0f\u0b2c\u0b02 \u0b24\u0b43\u0b24\u0b40\u0b5f \u0b2a\u0b15\u0b4d\u0b37 \u0b05\u0b27\u0b3f\u0b15\u0b3e\u0b30 (\u0b21\u0b3e\u0b1f\u0b3e \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b38\u0b2b\u0b4d\u0b1f\u0b71\u0b47\u0b5f\u0b3e\u0b30, \u0b17\u0b4b\u0b2a\u0b28\u0b40\u0b5f\u0b24\u0b3e \u0b07\u0b24\u0b4d\u0b5f\u0b3e\u0b26\u0b3f \u0b06\u0b2e\u0b26\u0b3e\u0b28\u0b40 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b30\u0b2a\u0b4d\u0b24\u0b3e\u0b28\u0b3f \u0b38\u0b2e\u0b4d\u0b2c\u0b28\u0b4d\u0b27\u0b40\u0b5f \u0b38\u0b40\u0b2e\u0b3f\u0b24 \u0b06\u0b07\u0b28 \u0b38\u0b2e\u0b47\u0b24) \u0b2a\u0b3e\u0b33\u0b28 \u0b15\u0b30\u0b3f\u0b2c\u0b47 | 2.2 \u0b06\u0b2a\u0b23 \u0b2a\u0b4d\u0b30\u0b1a\u0b33\u0b3f\u0b24 \u0b21\u0b3e\u0b1f\u0b3e \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b06\u0b07\u0b28 \u0b0f\u0b2c\u0b02 \u0b28\u0b3f\u0b5f\u0b2e\u0b3e\u0b2c\u0b33\u0b40\u0b15\u0b41 \u0b38\u0b40\u0b2e\u0b3f\u0b24 \u0b28\u0b15\u0b30\u0b3f \u0b2a\u0b3e\u0b33\u0b28 \u0b15\u0b30\u0b3f\u0b2c\u0b47 \u0b2f\u0b47\u0b09\u0b01\u0b25\u0b3f\u0b30\u0b47 \u0b21\u0b3f\u0b1c\u0b3f\u0b1f\u0b3e\u0b32\u0b4d \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b17\u0b24 \u0b21\u0b3e\u0b1f\u0b3e \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b05\u0b27\u0b3f\u0b28\u0b3f\u0b5f\u0b2e, 2023, \u0b0f\u0b2c\u0b02 \u0b38\u0b42\u0b1a\u0b28\u0b3e \u0b2a\u0b4d\u0b30\u0b2f\u0b41\u0b15\u0b4d\u0b24\u0b3f\u0b2c\u0b3f\u0b26\u0b4d\u0b5f\u0b3e \u0b05\u0b27\u0b3f\u0b28\u0b3f\u0b5f\u0b2e, 2000, \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b38\u0b47\u0b25\u0b3f\u0b30\u0b47 \u0b2a\u0b4d\u0b30\u0b38\u0b4d\u0b24\u0b41\u0b24 \u0b39\u0b4b\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b28\u0b3f\u0b5f\u0b2e \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b28\u0b3f\u0b5f\u0b2e\u0b3e\u0b2c\u0b33\u0b40, \u0b0f\u0b2c\u0b02 \u0b05\u0b28\u0b4d\u0b5f\u0b3e\u0b28\u0b4d\u0b5f \u0b2a\u0b4d\u0b30\u0b3e\u0b38\u0b19\u0b4d\u0b17\u0b3f\u0b15 \u0b2a\u0b4d\u0b30\u0b1a\u0b33\u0b3f\u0b24 \u0b06\u0b07\u0b28/\u0b28\u0b3f\u0b5f\u0b2e/\u0b05\u0b27\u0b4d\u0b5f\u0b3e\u0b26\u0b47\u0b36/\u0b2c\u0b3f\u0b1c\u0b4d\u0b1e\u0b2a\u0b4d\u0b24\u0b3f/\u0b09\u0b2a\u0b2c\u0b3f\u0b27\u0b3f \u0b07\u0b24\u0b4d\u0b5f\u0b3e\u0b26\u0b3f \u0b05\u0b28\u0b4d\u0b24\u0b30\u0b4d\u0b2d\u0b41\u0b15\u0b4d\u0b24 | \u0b0f\u0b39\u0b3f \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40 \u0b05\u0b28\u0b41\u0b2f\u0b3e\u0b5f\u0b40 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b06\u0b15\u0b4d\u0b38\u0b47\u0b38\u0b4d \u0b39\u0b4b\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2a\u0b4d\u0b30\u0b3e\u0b2a\u0b4d\u0b24 \u0b39\u0b4b\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b24\u0b25\u0b4d\u0b5f\u0b15\u0b41 \u0b2a\u0b30\u0b3f\u0b1a\u0b3e\u0b33\u0b28\u0b3e \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b38\u0b2e\u0b5f\u0b30\u0b47 \u0b06\u0b2a\u0b23 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b28\u0b3f\u0b30\u0b4d\u0b26\u0b4d\u0b26\u0b3f\u0b37\u0b4d\u0b1f \u0b06\u0b07\u0b28 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b28\u0b3f\u0b5f\u0b2e\u0b3e\u0b2c\u0b33\u0b40 \u0b05\u0b27\u0b40\u0b28\u0b30\u0b47 \u0b2a\u0b30\u0b3f\u0b1a\u0b3e\u0b33\u0b3f\u0b24 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b24\u0b25\u0b4d\u0b5f \u0b2a\u0b4d\u0b30\u0b15\u0b4d\u0b30\u0b3f\u0b5f\u0b3e\u0b15\u0b30\u0b23 \u0b15\u0b30\u0b3f\u0b2c\u0b47 \u0b28\u0b3e\u0b39\u0b3f\u0b01 \u0b2f\u0b3e\u0b39\u0b3e \u0b2a\u0b43\u0b25\u0b15 \u0b38\u0b2e\u0b4d\u0b2e\u0b24\u0b3f \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b05\u0b28\u0b41\u0b2e\u0b4b\u0b26\u0b28 \u0b06\u0b2c\u0b36\u0b4d\u0b5f\u0b15 \u0b15\u0b30\u0b47 |"),(0,xe.Z)(ee,"urlSubHeading6Text","<span> 6.1 \u0b2e\u0b3e\u0b07\u0b01 \u0b38\u0b4d\u0b15\u0b3f\u0b2e\u0b4d \u0b5f\u0b41. \u0b06\u0b30\u0b4d. \u0b0f\u0b32\u0b4d. \u0b15\u0b41 \u0b0f\u0b2a\u0b30\u0b3f \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b09\u0b2a\u0b3e\u0b5f\u0b30\u0b47 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3e\u0b2f\u0b3f\u0b2c\u0b3e \u0b09\u0b1a\u0b3f\u0b24 \u0b28\u0b41\u0b39\u0b47\u0b01 \u0b2f\u0b3e\u0b39\u0b3e \u0b2c\u0b3f\u0b2d\u0b4d\u0b30\u0b3e\u0b28\u0b4d\u0b24\u0b3f\u0b15\u0b30, \u0b2c\u0b3f\u0b2d\u0b4d\u0b30\u0b3e\u0b28\u0b4d\u0b24\u0b3f\u0b15\u0b30 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2c\u0b47\u0b06\u0b07\u0b28, \u0b2f\u0b47\u0b09\u0b01\u0b25\u0b3f\u0b30\u0b47 \u0b2c\u0b47\u0b06\u0b07\u0b28 \u0b2a\u0b41\u0b28\u0b03\u0b28\u0b3f\u0b30\u0b4d\u0b26\u0b47\u0b36, \u0b2b\u0b3f\u0b36\u0b3f\u0b19\u0b4d\u0b17\u0b4d \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b05\u0b28\u0b4d\u0b5f\u0b3e\u0b28\u0b4d\u0b5f \u0b26\u0b42\u0b37\u0b3f\u0b24 \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b15\u0b33\u0b3e\u0b2a \u0b05\u0b28\u0b4d\u0b24\u0b30\u0b4d\u0b2d\u0b41\u0b15\u0b4d\u0b24 \u0b15\u0b3f\u0b28\u0b4d\u0b24\u0b41 \u0b38\u0b40\u0b2e\u0b3f\u0b24 \u0b28\u0b41\u0b39\u0b47\u0b01\u0964 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b41 \u0b5f\u0b41. \u0b06\u0b30\u0b4d. \u0b0f\u0b32\u0b4d. \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b28\u0b3f\u0b37\u0b47\u0b27 \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b1b\u0b3f \u0b2f\u0b3e\u0b39\u0b3e \u0b2e\u0b3e\u0b07\u0b01 \u0b38\u0b4d\u0b15\u0b3f\u0b2e\u0b4d \u0b30 \u0b2c\u0b3f\u0b36\u0b4d\u0b71\u0b38\u0b28\u0b40\u0b5f\u0b24\u0b3e\u0b15\u0b41 \u0b2d\u0b41\u0b32\u0b4d \u0b2d\u0b3e\u0b2c\u0b30\u0b47 \u0b09\u0b2a\u0b38\u0b4d\u0b25\u0b3e\u0b2a\u0b28 \u0b15\u0b30\u0b47 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b39\u0b4d\u0b30\u0b3e\u0b38 \u0b15\u0b30\u0b47 | </span> </span> 6.2 \u0b2e\u0b3e\u0b07\u0b01 \u0b38\u0b4d\u0b15\u0b3f\u0b2e\u0b4d \u0b30 \u0b2a\u0b42\u0b30\u0b4d\u0b2c \u0b32\u0b3f\u0b16\u0b3f\u0b24 \u0b38\u0b2e\u0b4d\u0b2e\u0b24\u0b3f \u0b2c\u0b3f\u0b28\u0b3e \u0b2c\u0b3e\u0b23\u0b3f\u0b1c\u0b4d\u0b5f\u0b3f\u0b15 \u0b2c\u0b3f\u0b1c\u0b4d\u0b1e\u0b3e\u0b2a\u0b28, \u0b2a\u0b4d\u0b30\u0b1a\u0b3e\u0b30 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b32\u0b3e\u0b2d \u0b2a\u0b30\u0b3f\u0b1a\u0b3e\u0b33\u0b3f\u0b24 \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b15\u0b33\u0b3e\u0b2a\u0b30\u0b47 \u0b5f\u0b41. \u0b06\u0b30\u0b4d. \u0b0f\u0b32\u0b4d. \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3e\u0b2f\u0b3f\u0b2c \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964"),(0,xe.Z)(ee,"urlSubHeading7Text",'\u0b06\u0b2a\u0b23 (\u0b0f\u0b15 "\u0b15\u0b4d\u0b37\u0b24\u0b3f\u0b2a\u0b42\u0b30\u0b23 \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28\u0b15\u0b3e\u0b30\u0b40 \u0b2a\u0b15\u0b4d\u0b37" \u0b2d\u0b3e\u0b2c\u0b47), \u0b06\u0b07\u0b28 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b05\u0b28\u0b41\u0b2e\u0b4b\u0b26\u0b3f\u0b24 \u0b38\u0b30\u0b4d\u0b2c\u0b3e\u0b27\u0b3f\u0b15 \u0b38\u0b40\u0b2e\u0b3e \u0b2a\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b28\u0b4d\u0b24, \u0b06\u0b2e\u0b15\u0b41 \u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b15\u0b30\u0b3f\u0b2c\u0b47, \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b26\u0b47\u0b2c\u0b47 \u0b0f\u0b2c\u0b02 \u0b15\u0b4d\u0b37\u0b24\u0b3f\u0b2a\u0b42\u0b30\u0b23 \u0b26\u0b47\u0b2c\u0b47 (\u0b0f\u0b15 "\u0b15\u0b4d\u0b37\u0b24\u0b3f\u0b2a\u0b42\u0b30\u0b23 \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28\u0b15\u0b3e\u0b30\u0b40 \u0b2a\u0b15\u0b4d\u0b37" \u0b2d\u0b3e\u0b2c\u0b47)\u0964 \u0b15\u0b4d\u0b37\u0b24\u0b3f\u0b2a\u0b42\u0b30\u0b23 \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28\u0b15\u0b3e\u0b30\u0b40 \u0b2a\u0b15\u0b4d\u0b37 \u0b15\u0b4d\u0b37\u0b24\u0b3f\u0b2a\u0b42\u0b30\u0b23 \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28\u0b15\u0b3e\u0b30\u0b40 \u0b2a\u0b15\u0b4d\u0b37 \u0b0f\u0b2c\u0b02 \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15 \u0b05\u0b27\u0b3f\u0b15\u0b3e\u0b30\u0b40, \u0b15\u0b30\u0b4d\u0b2e\u0b1a\u0b3e\u0b30\u0b40, \u0b28\u0b3f\u0b30\u0b4d\u0b26\u0b4d\u0b26\u0b47\u0b36\u0b15 \u0b0f\u0b2c\u0b02 \u0b2a\u0b30\u0b3e\u0b2e\u0b30\u0b4d\u0b36\u0b26\u0b3e\u0b24\u0b3e, \u0b2f\u0b47\u0b09\u0b01 \u0b15\u0b4d\u0b37\u0b47\u0b24\u0b4d\u0b30\u0b30\u0b47 \u0b39\u0b47\u0b09, (\u0b0f\u0b39\u0b3f \u0b16\u0b23\u0b4d\u0b21\u0b30\u0b47 \'\u0b15\u0b4d\u0b37\u0b24\u0b3f\u0b2a\u0b42\u0b30\u0b23 \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28\u0b15\u0b3e\u0b30\u0b40 \u0b2a\u0b15\u0b4d\u0b37\' \u0b2d\u0b3e\u0b2c\u0b47 \u0b38\u0b42\u0b1a\u0b3f\u0b24 \u0b38\u0b2e\u0b38\u0b4d\u0b24 \u0b24\u0b43\u0b24\u0b40\u0b5f \u0b2a\u0b15\u0b4d\u0b37) \u0b19\u0b4d\u0b15\u0b41 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b0f\u0b2c\u0b02 \u0b38\u0b2e\u0b38\u0b4d\u0b24 \u0b2a\u0b4d\u0b30\u0b2e\u0b3e\u0b23\u0b3f\u0b24 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b15\u0b25\u0b3f\u0b24 \u0b15\u0b4d\u0b37\u0b24\u0b3f, \u0b26\u0b3e\u0b2c\u0b3f, \u0b15\u0b4d\u0b37\u0b24\u0b3f, \u0b26\u0b3e\u0b5f\u0b3f\u0b24\u0b4d\u0b71, \u0b38\u0b41\u0b27, \u0b2a\u0b41\u0b30\u0b38\u0b4d\u0b15\u0b3e\u0b30, \u0b30\u0b3e\u0b5f, \u0b38\u0b2e\u0b3e\u0b27\u0b3e\u0b28, \u0b1c\u0b4b\u0b30\u0b3f\u0b2e\u0b3e\u0b28\u0b3e, \u0b0f\u0b2c\u0b02 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b24\u0b43\u0b24\u0b40\u0b5f \u0b2a\u0b15\u0b4d\u0b37 \u0b26\u0b3e\u0b2c\u0b3f, \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b3e\u0b28\u0b41\u0b37\u0b4d\u0b20\u0b3e\u0b28, \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b3e\u0b28\u0b41\u0b37\u0b4d\u0b20\u0b3e\u0b28\u0b30 \u0b15\u0b3e\u0b30\u0b23, \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2e\u0b3e\u0b2e\u0b32\u0b3e \u0b15\u0b3e\u0b30\u0b23\u0b30\u0b41 \u0b09\u0b2a\u0b41\u0b1c\u0b3f\u0b25\u0b3f\u0b2c\u0b3e \u0b2e\u0b15\u0b26\u0b4d\u0b26\u0b2e\u0b3e \u0b38\u0b2e\u0b4d\u0b2c\u0b28\u0b4d\u0b27\u0b40\u0b5f \u0b06\u0b2a\u0b4b\u0b37 \u0b2c\u0b41\u0b1d\u0b3e\u0b2e\u0b23\u0b3e \u0b20\u0b3e\u0b30\u0b41 \u0b0f\u0b2c\u0b02 \u0b24\u0b3e \'\u0b2c\u0b3f\u0b30\u0b41\u0b26\u0b4d\u0b27\u0b30\u0b47 \u0b15\u0b4d\u0b37\u0b24\u0b3f\u0b15\u0b3e\u0b30\u0b15 \u0b30\u0b16\u0b3f\u0b2c\u0b47\u0964 / \u0b38\u0b4d\u0b2a\u0b3e\u0b28>'),(0,xe.Z)(ee,"urlSubHeading8Text","8. 1...............................................................................................................................................................................................\u0964"),(0,xe.Z)(ee,"urlSubHeading9Text","9. 1 \u0b24\u0b41\u0b30\u0b28\u0b4d\u0b24 \u0b05\u0b2a\u0b38\u0b3e\u0b30\u0b23 \u0b06\u0b26\u0b47\u0b36 \u0b26\u0b47\u0b2c\u0b3e\u0b30 \u0b05\u0b27\u0b3f\u0b15\u0b3e\u0b30 \u0b2e\u0b3e\u0b07\u0b38\u0b4d\u0b1a\u0b3f\u0b2e\u0b4d\u0b30 \u0b30\u0b39\u0b3f\u0b1b\u0b3f \u0b0f\u0b2c\u0b02 \u0b2f\u0b26\u0b3f \u0b06\u0b2a\u0b23 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40\u0b30 \u0b09\u0b32\u0b4d\u0b32\u0b19\u0b4d\u0b18\u0b28 \u0b15\u0b30\u0b41\u0b25\u0b3f\u0b2c\u0b3e\u0b30 \u0b1c\u0b23\u0b3e\u0b2a\u0b21\u0b3c\u0b28\u0b4d\u0b24\u0b3f, \u0b24\u0b47\u0b2c\u0b47 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b41 \u0b24\u0b41\u0b30\u0b28\u0b4d\u0b24 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b71\u0b47\u0b2c\u0b38\u0b3e\u0b07\u0b1f\u0b30\u0b41 \u0b5f\u0b41. \u0b06\u0b30. \u0b0f\u0b32. \u0b15\u0b41 \u0b39\u0b1f\u0b3e\u0b07\u0b2c\u0b3e\u0b15\u0b41 \u0b2a\u0b21\u0b3c\u0b3f\u0b2c\u0964"),(0,xe.Z)(ee,"urlSubHeading10Text","\u0b5f\u0b41. \u0b06\u0b30\u0b4d. \u0b0f\u0b32\u0b4d. \u0b38\u0b4d\u0b25\u0b3e\u0b2a\u0b28, \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b2a\u0b26\u0b15\u0b4d\u0b37\u0b47\u0b2a \u0b0f\u0b2c\u0b02 \u0b2c\u0b3f\u0b37\u0b5f\u0b2c\u0b38\u0b4d\u0b24\u0b41 \u0b39\u0b4b\u0b37\u0b4d\u0b1f\u0b3f\u0b02 \u0b2a\u0b3e\u0b07\u0b01 \u0b38\u0b30\u0b4d\u0b2c\u0b4b\u0b24\u0b4d\u0b24\u0b2e \u0b05\u0b2d\u0b4d\u0b5f\u0b3e\u0b38 \u0b38\u0b2e\u0b47\u0b24, \u0b0f\u0b39\u0b3f \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40\u0b15\u0b41 \u0b2a\u0b3e\u0b33\u0b28 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b30\u0b47 \u0b2a\u0b15\u0b4d\u0b37\u0b15\u0b41 \u0b38\u0b39\u0b3e\u0b5f\u0b24\u0b3e \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b2e\u0b3e\u0b07\u0b38\u0b4d \u0b38\u0b4d\u0b15\u0b3f\u0b2e\u0b4d, \u0b28\u0b3f\u0b1c \u0b07\u0b1a\u0b4d\u0b1b\u0b3e\u0b28\u0b41\u0b38\u0b3e\u0b30\u0b47, \u0b38\u0b2e\u0b4d\u0b2c\u0b33 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b28\u0b3f\u0b30\u0b4d\u0b26\u0b4d\u0b26\u0b47\u0b36\u0b3e\u0b2c\u0b33\u0b40 \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b47\u0964"),(0,xe.Z)(ee,"urlSubHeading11Text","<span> a. \u0b71\u0b47\u0b2c\u0b4d\u0b38\u0b3e\u0b07\u0b1f\u0b4d\u0b30\u0b47 \u0b38\u0b40\u0b2e\u0b3f\u0b24\u0b24\u0b3e, \u0b1f\u0b4d\u0b30\u0b47\u0b21\u0b2e\u0b3e\u0b30\u0b4d\u0b15, \u0b15\u0b2a\u0b3f\u0b30\u0b3e\u0b07\u0b1f\u0b4d, \u0b21\u0b3f\u0b1c\u0b3e\u0b07\u0b28\u0b4d \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2a\u0b47\u0b1f\u0b47\u0b23\u0b4d\u0b1f \u0b38\u0b2e\u0b47\u0b24 \u0b38\u0b2e\u0b38\u0b4d\u0b24 \u0b2c\u0b4c\u0b26\u0b4d\u0b27\u0b3f\u0b15 \u0b38\u0b2e\u0b4d\u0b2a\u0b24\u0b4d\u0b24\u0b3f \u0b05\u0b27\u0b3f\u0b15\u0b3e\u0b30 \u0b0f\u0b2c\u0b02 \u0b38\u0b4d\u0b71\u0b3e\u0b30\u0b4d\u0b25 \u0b15\u0b47\u0b2c\u0b33 \u0b06\u0b2e\u0b30 \u0b39\u0b47\u0b2c\u0964 \u0b0f\u0b39\u0b3f \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2a\u0b4d\u0b30\u0b15\u0b3e\u0b30\u0b47 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b41 \u0b71\u0b47\u0b2c\u0b4d\u0b38\u0b3e\u0b07\u0b1f\u0b4d\u0b30\u0b47 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2e\u0b3e\u0b32\u0b3f\u0b15\u0b3e\u0b28\u0b3e \u0b05\u0b27\u0b3f\u0b15\u0b3e\u0b30 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b38\u0b4d\u0b71\u0b24\u0b28\u0b4d\u0b24\u0b4d\u0b30\u0b24\u0b3e \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28 \u0b15\u0b30\u0b3f\u0b2c \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964 </span> <span> b. \u0b06\u0b2e\u0b30 \u0b2a\u0b42\u0b30\u0b4d\u0b2c \u0b32\u0b3f\u0b16\u0b3f\u0b24 \u0b05\u0b28\u0b41\u0b2e\u0b4b\u0b26\u0b28 \u0b2c\u0b3f\u0b28\u0b3e \u0b06\u0b2e \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b38\u0b39\u0b2d\u0b3e\u0b17\u0b40\u0b24\u0b3e, \u0b2a\u0b4d\u0b30\u0b3e\u0b5f\u0b4b\u0b1c\u0b15\u0b24\u0b3e \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b05\u0b28\u0b41\u0b2e\u0b4b\u0b26\u0b28 \u0b2a\u0b4d\u0b30\u0b38\u0b4d\u0b24\u0b3e\u0b2c \u0b26\u0b47\u0b09\u0b25\u0b3f\u0b2c\u0b3e \u0b71\u0b47\u0b2c\u0b4d\u0b38\u0b3e\u0b07\u0b1f\u0b4d\u0b30\u0b47 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b39\u0b4b\u0b37\u0b4d\u0b1f\u0b3f\u0b02/\u0b39\u0b3e\u0b07\u0b2a\u0b30\u0b32\u0b3f\u0b19\u0b4d\u0b15\u0b3f\u0b02 \u0b38\u0b2e\u0b4d\u0b2a\u0b30\u0b4d\u0b15\u0b30\u0b47 \u0b06\u0b2a\u0b23 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2c\u0b3f\u0b2c\u0b43\u0b24\u0b4d\u0b24\u0b3f \u0b26\u0b47\u0b2c\u0b47 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964 </span> <span> c. \u0b06\u0b2e\u0b47 \u0b0f\u0b15 \u0b39\u0b3e\u0b07\u0b2a\u0b30\u0b32\u0b3f\u0b19\u0b4d\u0b15\u0b15\u0b41 \u0b05\u0b28\u0b41\u0b2e\u0b24\u0b3f \u0b26\u0b47\u0b09\u0b1b\u0b41 \u0b2f\u0b3e\u0b39\u0b3e \u0b15\u0b47\u0b2c\u0b33 \u0b06\u0b2e\u0b30 \u0b28\u0b3e\u0b2e \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b71\u0b47\u0b2c\u0b4d\u0b38\u0b3e\u0b07\u0b1f \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b2a\u0b4d\u0b30\u0b26\u0b30\u0b4d\u0b36\u0b28 \u0b15\u0b30\u0b3f\u0b25\u0b3e\u0b0f\u0964 \u0b39\u0b3e\u0b07\u0b2a\u0b30\u0b32\u0b3f\u0b19\u0b4d\u0b15 \u0b2d\u0b3e\u0b2c\u0b30\u0b47 \u0b2e\u0b4b \u0b38\u0b4d\u0b15\u0b3f\u0b2e\u0b4d \u0b32\u0b4b\u0b17\u0b4b, \u0b2c\u0b3e\u0b23\u0b3f\u0b1c\u0b4d\u0b5f \u0b28\u0b3e\u0b2e \u0b0f\u0b2c\u0b02 \u0b1f\u0b4d\u0b30\u0b47\u0b21\u0b2e\u0b3e\u0b30\u0b4d\u0b15\u0b30 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2a\u0b4d\u0b30\u0b26\u0b30\u0b4d\u0b36\u0b28\u0b15\u0b41 \u0b05\u0b28\u0b41\u0b2e\u0b24\u0b3f \u0b26\u0b3f\u0b06\u0b2f\u0b3f\u0b2c \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964"),(0,xe.Z)(ee,"urlSubHeading12Text","<span> \u0b06\u0b2e\u0b47 \u0b2f\u0b47\u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b38\u0b2e\u0b5f\u0b30\u0b47, \u0b2c\u0b3f\u0b1c\u0b4d\u0b1e\u0b2a\u0b4d\u0b24\u0b3f \u0b38\u0b39\u0b3f\u0b24 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2c\u0b3f\u0b28\u0b3e, \u0b0f\u0b39\u0b3f \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40\u0b15\u0b41 \u0b2a\u0b30\u0b3f\u0b2c\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b28 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b30 \u0b05\u0b27\u0b3f\u0b15\u0b3e\u0b30 \u0b38\u0b02\u0b30\u0b15\u0b4d\u0b37\u0b3f\u0b24 \u0b30\u0b16\u0b3f\u0b1b\u0b41\u0964 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b41 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b09\u0b1b\u0b3f \u0b2f\u0b47 \u0b06\u0b2a\u0b23 \u0b2e\u0b3e\u0b07\u0b38\u0b4d\u0b1a\u0b3f\u0b2e \u0b5f\u0b41. \u0b06\u0b30. \u0b0f\u0b32. \u0b30 \u0b28\u0b3f\u0b30\u0b28\u0b4d\u0b24\u0b30 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30/\u0b39\u0b4b\u0b37\u0b4d\u0b1f\u0b3f\u0b02 \u0b2a\u0b3e\u0b07\u0b01 \u0b38\u0b2e\u0b5f \u0b38\u0b2e\u0b5f\u0b30\u0b47 \u0b0f\u0b39\u0b3f \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40\u0b15\u0b41 \u0b38\u0b2e\u0b40\u0b15\u0b4d\u0b37\u0b3e \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964"),(0,xe.Z)(ee,"urlSubHeading13Text","\u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2a\u0b30\u0b3f\u0b38\u0b4d\u0b25\u0b3f\u0b24\u0b3f\u0b30\u0b47 \u0b06\u0b2e\u0b47 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2a\u0b30\u0b4b\u0b15\u0b4d\u0b37, \u0b38\u0b4d\u0b71\u0b24\u0b28\u0b4d\u0b24\u0b4d\u0b30, \u0b06\u0b28\u0b41\u0b38\u0b19\u0b4d\u0b17\u0b3f\u0b15 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2b\u0b33\u0b38\u0b4d\u0b71\u0b30\u0b42\u0b2a \u0b15\u0b4d\u0b37\u0b24\u0b3f \u0b2a\u0b3e\u0b07\u0b01 \u0b09\u0b24\u0b4d\u0b24\u0b30\u0b26\u0b3e\u0b5f\u0b40 \u0b39\u0b47\u0b2c\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01 \u0b2f\u0b3e\u0b39\u0b3e \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b2e\u0b3e\u0b07\u0b38\u0b4d\u0b1a\u0b3f\u0b2e URL \u0b30 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30/\u0b39\u0b4b\u0b37\u0b4d\u0b1f\u0b3f\u0b02\u0b30\u0b41 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b0f\u0b39\u0b3e \u0b38\u0b39\u0b3f\u0b24 \u0b1c\u0b21\u0b3f\u0b24, \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b3e\u0b28\u0b41\u0b37\u0b4d\u0b20\u0b3e\u0b28\u0b30 \u0b15\u0b3e\u0b30\u0b23 \u0b28\u0b3f\u0b30\u0b4d\u0b2c\u0b3f\u0b36\u0b47\u0b37\u0b30\u0b47 (\u0b1a\u0b41\u0b15\u0b4d\u0b24\u0b3f, \u0b28\u0b3f\u0b30\u0b4d\u0b2f\u0b3e\u0b24\u0b28\u0b3e, \u0b71\u0b3e\u0b30\u0b47\u0b23\u0b4d\u0b1f\u0b3f \u0b09\u0b32\u0b4d\u0b32\u0b02\u0b18\u0b28, \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b05\u0b28\u0b4d\u0b5f\u0b25\u0b3e) \u0b0f\u0b2c\u0b02 \u0b2f\u0b26\u0b3f\u0b13 \u0b06\u0b2e\u0b15\u0b41 \u0b0f\u0b2a\u0b30\u0b3f \u0b15\u0b4d\u0b37\u0b24\u0b3f\u0b30 \u0b38\u0b2e\u0b4d\u0b2d\u0b3e\u0b2c\u0b28\u0b3e \u0b2c\u0b3f\u0b37\u0b5f\u0b30\u0b47 \u0b2a\u0b30\u0b3e\u0b2e\u0b30\u0b4d\u0b36 \u0b26\u0b3f\u0b06\u0b2f\u0b3e\u0b07\u0b1b\u0b3f |"),(0,xe.Z)(ee,"urlSubHeading14Text","\u0b2f\u0b26\u0b3f \u0b0f\u0b39\u0b3f \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40\u0b30 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2c\u0b4d\u0b5f\u0b2c\u0b38\u0b4d\u0b25\u0b3e \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b23\u0b30\u0b41 \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b15\u0b3e\u0b30\u0b40 \u0b39\u0b4b\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c \u0b28\u0b3e\u0b39\u0b3f\u0b01 \u0b2c\u0b4b\u0b32\u0b3f \u0b38\u0b4d\u0b25\u0b3f\u0b30 \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b0f, \u0b24\u0b47\u0b2c\u0b47 \u0b0f\u0b39\u0b3e\u0b30 \u0b05\u0b2c\u0b36\u0b3f\u0b37\u0b4d\u0b1f \u0b2c\u0b4d\u0b5f\u0b2c\u0b38\u0b4d\u0b25\u0b3e \u0b2a\u0b4d\u0b30\u0b2d\u0b3e\u0b2c\u0b3f\u0b24 \u0b39\u0b47\u0b2c \u0b28\u0b3e\u0b39\u0b3f\u0b01 \u0b0f\u0b2c\u0b02 \u0b38\u0b2e\u0b4d\u0b2a\u0b42\u0b30\u0b4d\u0b23\u0b4d\u0b23 \u0b2c\u0b33\u0b2c\u0b24\u0b4d\u0b24\u0b30 \u0b30\u0b39\u0b3f\u0b2c\u0964"),(0,xe.Z)(ee,"urlSubHeading15Text","\u0b2a\u0b4d\u0b32\u0b3e\u0b1f\u0b2b\u0b30\u0b4d\u0b2e, \u0b0f\u0b39\u0b3e\u0b30 \u0b2c\u0b3f\u0b37\u0b5f\u0b2c\u0b38\u0b4d\u0b24\u0b41 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b0f\u0b39\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b38\u0b2e\u0b4d\u0b2c\u0b28\u0b4d\u0b27\u0b40\u0b5f \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b05\u0b2d\u0b3f\u0b2f\u0b4b\u0b17, \u0b05\u0b2d\u0b3f\u0b2f\u0b4b\u0b17 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b1a\u0b3f\u0b28\u0b4d\u0b24\u0b3e, \u0b2a\u0b4d\u0b30\u0b25\u0b2e\u0b47 \u0b38\u0b3f\u0b1f\u0b3f\u0b13, \u0b0f\u0b28\u0b07\u0b1c\u0b3f\u0b21\u0b3f, \u0b21\u0b3f\u0b1c\u0b3f\u0b1f\u0b3e\u0b32 \u0b07\u0b23\u0b4d\u0b21\u0b3f\u0b06 \u0b15\u0b30\u0b4d\u0b2a\u0b4b\u0b30\u0b47\u0b38\u0b28\u0b15\u0b41 \u0b28\u0b3f\u0b30\u0b4d\u0b26\u0b4d\u0b26\u0b47\u0b36\u0b3f\u0b24 \u0b39\u0b47\u0b2c \u0b0f\u0b2c\u0b02 \u0b2e\u0b27\u0b4d\u0b5f\u0b38\u0b4d\u0b25\u0b24\u0b3e \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b2a\u0b3e\u0b30\u0b38\u0b4d\u0b2a\u0b30\u0b3f\u0b15 \u0b38\u0b2e\u0b3e\u0b27\u0b3e\u0b28 \u0b15\u0b30\u0b3e\u0b2f\u0b3f\u0b2c\u0964 \u0b0f\u0b39\u0b3f \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40 \u0b2d\u0b3e\u0b30\u0b24\u0b40\u0b5f \u0b06\u0b07\u0b28 \u0b05\u0b28\u0b41\u0b2f\u0b3e\u0b5f\u0b40 \u0b2a\u0b30\u0b3f\u0b1a\u0b3e\u0b33\u0b3f\u0b24 \u0b39\u0b47\u0b2c \u0b0f\u0b2c\u0b02 \u0b2a\u0b4d\u0b30\u0b24\u0b4d\u0b5f\u0b47\u0b15 \u0b2a\u0b15\u0b4d\u0b37 \u0b26\u0b3f\u0b32\u0b4d\u0b32\u0b40, \u0b2d\u0b3e\u0b30\u0b24\u0b30 \u0b28\u0b4d\u0b5f\u0b3e\u0b5f\u0b3e\u0b33\u0b5f\u0b30 \u0b05\u0b27\u0b3f\u0b15\u0b3e\u0b30 \u0b15\u0b4d\u0b37\u0b47\u0b24\u0b4d\u0b30\u0b15\u0b41 \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b3f\u0b2c\u0b47 | \u0b0f\u0b39\u0b3e\u0b30 \u0b05\u0b38\u0b4d\u0b24\u0b3f\u0b24\u0b4d\u0b71, \u0b2c\u0b48\u0b27\u0b24\u0b3e \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b38\u0b2e\u0b3e\u0b2a\u0b4d\u0b24\u0b3f \u0b38\u0b2e\u0b4d\u0b2c\u0b28\u0b4d\u0b27\u0b40\u0b5f \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2a\u0b4d\u0b30\u0b36\u0b4d\u0b28 \u0b38\u0b2e\u0b47\u0b24 \u0b0f\u0b39\u0b3f \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40\u0b30\u0b41 \u0b09\u0b24\u0b4d\u0b2a\u0b28\u0b4d\u0b28 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2a\u0b3e\u0b30\u0b4d\u0b25\u0b15\u0b4d\u0b5f \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2c\u0b3f\u0b2c\u0b3e\u0b26 \u0b2a\u0b15\u0b4d\u0b37\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b2a\u0b3e\u0b30\u0b38\u0b4d\u0b2a\u0b30\u0b3f\u0b15 \u0b2d\u0b3e\u0b2c\u0b30\u0b47 \u0b06\u0b32\u0b4b\u0b1a\u0b28\u0b3e \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b38\u0b2e\u0b3e\u0b27\u0b3e\u0b28 \u0b15\u0b30\u0b3e\u0b2f\u0b3f\u0b2c | \u0b09\u0b2a\u0b30\u0b4b\u0b15\u0b4d\u0b24 \u0b2c\u0b3f\u0b2c\u0b3e\u0b26\u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15\u0b30 \u0b38\u0b2e\u0b3e\u0b27\u0b3e\u0b28 \u0b28 \u0b39\u0b47\u0b32\u0b47, \u0b2c\u0b3f\u0b2c\u0b3e\u0b26 \u0b09\u0b2d\u0b5f \u0b2a\u0b15\u0b4d\u0b37 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b2a\u0b3e\u0b30\u0b38\u0b4d\u0b2a\u0b30\u0b3f\u0b15 \u0b2d\u0b3e\u0b2c\u0b30\u0b47 \u0b28\u0b3f\u0b2f\u0b41\u0b15\u0b4d\u0b24 \u0b0f\u0b15\u0b2e\u0b3e\u0b24\u0b4d\u0b30 \u0b2e\u0b27\u0b4d\u0b5f\u0b38\u0b4d\u0b25\u0b19\u0b4d\u0b15 \u0b2e\u0b27\u0b4d\u0b5f\u0b38\u0b4d\u0b25\u0b24\u0b3e \u0b28\u0b3f\u0b15\u0b1f\u0b15\u0b41 \u0b2a\u0b20\u0b3e\u0b2f\u0b3f\u0b2c |"),(0,xe.Z)(ee,"urlHostingText1",'<p> \u0b0f\u0b39\u0b3f \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40 ("\u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40") \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b71\u0b47\u0b2c\u0b38\u0b3e\u0b07\u0b1f\u0b30\u0b47 \u0b2e\u0b3e\u0b07\u0b38\u0b4d\u0b1a\u0b3f\u0b2e\u0b4d\u0b30 \u0b5f\u0b41. \u0b06\u0b30\u0b4d. \u0b0f\u0b32\u0b4d. \u0b39\u0b4b\u0b37\u0b4d\u0b1f\u0b3f\u0b02 \u0b0f\u0b2c\u0b02 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30\u0b15\u0b41 \u0b28\u0b3f\u0b5f\u0b28\u0b4d\u0b24\u0b4d\u0b30\u0b23 \u0b15\u0b30\u0b3f\u0b25\u0b3e\u0b0f\u0964 \u0b2e\u0b3e\u0b07\u0b38\u0b4d\u0b1a\u0b3f\u0b2e\u0b4d\u0b30 \u0b5f\u0b41. \u0b06\u0b30\u0b4d. \u0b0f\u0b32\u0b4d. \u0b39\u0b4b\u0b37\u0b4d\u0b1f\u0b3f\u0b02 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f ("\u0b2a\u0b4d\u0b32\u0b3e\u0b1f\u0b2b\u0b30\u0b4d\u0b2e/\u0b06\u0b2e\u0b47/\u0b06\u0b2e\u0b47/\u0b06\u0b2e\u0b30"), \u0b06\u0b2a\u0b23 \u0b0f\u0b39\u0b3f \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b15\u0b20\u0b4b\u0b30 \u0b2d\u0b3e\u0b2c\u0b30\u0b47 \u0b06\u0b2c\u0b26\u0b4d\u0b27 \u0b39\u0b47\u0b2c\u0b3e\u0b15\u0b41 \u0b30\u0b3e\u0b1c\u0b3f \u0b39\u0b41\u0b05\u0b28\u0b4d\u0b24\u0b3f \u0b0f\u0b2c\u0b02 \u0b0f\u0b39\u0b3f \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40 \u0b06\u0b2e \u0b38\u0b39\u0b3f\u0b24 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b38\u0b2e\u0b4d\u0b2a\u0b30\u0b4d\u0b15\u0b15\u0b41 \u0b28\u0b3f\u0b5f\u0b28\u0b4d\u0b24\u0b4d\u0b30\u0b23 \u0b15\u0b30\u0b47\u0964 \u0b38\u0b2e\u0b38\u0b4d\u0b24 \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40\u0b15\u0b41 \u0b2f\u0b24\u0b4d\u0b28\u0b30 \u0b38\u0b39\u0b3f\u0b24 \u0b2a\u0b22\u0b3c\u0b28\u0b4d\u0b24\u0b41\u0964 \u0b2f\u0b26\u0b3f \u0b06\u0b2a\u0b23 \u0b0f\u0b39\u0b3f \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40 \u0b38\u0b39\u0b3f\u0b24 \u0b38\u0b39\u0b2e\u0b24 \u0b28\u0b41\u0b39\u0b01\u0b28\u0b4d\u0b24\u0b3f, \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b09\u0b26\u0b4d\u0b26\u0b47\u0b36\u0b4d\u0b5f\u0b30\u0b47 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b71\u0b47\u0b2c\u0b38\u0b3e\u0b07\u0b1f\u0b30\u0b47 \u0b2e\u0b3e\u0b07\u0b38\u0b4d\u0b1a\u0b3f\u0b2e\u0b4d\u0b30 \u0b5f\u0b41. \u0b06\u0b30\u0b4d. \u0b0f\u0b32\u0b4d. \u0b39\u0b4b\u0b37\u0b4d\u0b1f\u0b3f\u0b02 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30\u0b30\u0b41 \u0b26\u0b42\u0b30\u0b47\u0b07 \u0b30\u0b41\u0b39\u0b28\u0b4d\u0b24\u0b41\u0964 \u0b0f\u0b39\u0b3f \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40\u0b17\u0b41\u0b21\u0b3f\u0b15\u0b30 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2c\u0b3f\u0b1a\u0b4d\u0b5f\u0b41\u0b24\u0b3f \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b05\u0b2a\u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b0f\u0b39\u0b3f \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40\u0b30 \u0b09\u0b32\u0b4d\u0b32\u0b02\u0b18\u0b28 \u0b2c\u0b4b\u0b32\u0b3f \u0b2c\u0b3f\u0b2c\u0b47\u0b1a\u0b28\u0b3e \u0b15\u0b30\u0b3e\u0b2f\u0b3f\u0b2c \u0b0f\u0b2c\u0b02 \u0b0f\u0b39\u0b3e\u0b30 \u0b2b\u0b33\u0b38\u0b4d\u0b71\u0b30\u0b42\u0b2a \u0b5f\u0b41. \u0b06\u0b30\u0b4d. \u0b0f\u0b32\u0b4d. \u0b39\u0b4b\u0b37\u0b4d\u0b1f/\u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b24\u0b4