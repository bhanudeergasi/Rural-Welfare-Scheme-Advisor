8\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6",hiwStep1Head:"\u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",hiwStep1:"<span>\u0ca8\u0cbf\u0cae\u0ccd\u0cae <strong>\u0cae\u0cc2\u0cb2 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cbf!</strong></span>",hiwStep2Head:"\u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbf.",hiwStep2:"<span>\u0ca8\u0cae\u0ccd\u0cae \u0cb8\u0cb0\u0ccd\u0c9a\u0ccd \u0c87\u0c82\u0c9c\u0cbf\u0ca8\u0ccd <strong>\u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0ca4 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6</strong>!</span>",hiwStep3Head:"\u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0ca8\u0ccd\u0cb5\u0caf\u0cbf\u0cb8\u0cbf",hiwStep3:"<span><strong>\u0cb8\u0cc2\u0c95\u0ccd\u0ca4\u0cb5\u0cbe\u0ca6 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0ca8\u0ccd\u0cb5\u0caf\u0cbf\u0cb8\u0cbf</strong></span>",aboutSubHead:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0caa\u0ca1\u0cc6\u0caf\u0cbf\u0cb0\u0cbf!",aboutHead:"\u0cac\u0c97\u0ccd\u0c97\u0cc6",aboutDesc1:"\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0c92\u0c82\u0ca6\u0cc1 \u0cb0\u0cbe\u0cb7\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0caf \u0cb5\u0cc7\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1, \u0c87\u0ca6\u0cc1 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3 \u0c92\u0c82\u0ca6\u0cc1-\u0ca8\u0cbf\u0cb2\u0cc1\u0c97\u0ca1\u0cc6 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbe\u0c9f \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c86\u0cb5\u0cbf\u0cb7\u0ccd\u0c95\u0cbe\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0cb5 \u0c97\u0cc1\u0cb0\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0ca6\u0cc6.",aboutDesc2:"\u0c87\u0ca6\u0cc1 \u0ca8\u0cbe\u0c97\u0cb0\u0cbf\u0c95\u0cb0 \u0c85\u0cb0\u0ccd\u0cb9\u0ca4\u0cc6\u0caf \u0c86\u0ca7\u0cbe\u0cb0\u0ca6 \u0cae\u0cc7\u0cb2\u0cc6 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0cb2\u0cc1 \u0ca8\u0cb5\u0cc0\u0ca8, \u0ca4\u0c82\u0ca4\u0ccd\u0cb0\u0c9c\u0ccd\u0c9e\u0cbe\u0ca8 \u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0caa\u0cb0\u0cbf\u0cb9\u0cbe\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",aboutDesc3:"\u0c88 \u0cb5\u0cc7\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cc1 \u0ca8\u0cbe\u0c97\u0cb0\u0cbf\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0cb8\u0cc2\u0c95\u0ccd\u0ca4\u0cb5\u0cbe\u0ca6 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0cb2\u0cc1 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0cb5\u0cbf\u0cb5\u0cbf\u0ca7 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cb9\u0cc7\u0c97\u0cc6 \u0c85\u0cb0\u0ccd\u0c9c\u0cbf \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1 \u0c8e\u0c82\u0cac\u0cc1\u0ca6\u0cb0 \u0cac\u0c97\u0ccd\u0c97\u0cc6\u0caf\u0cc2 \u0c87\u0ca6\u0cc1 \u0cae\u0cbe\u0cb0\u0ccd\u0c97\u0ca6\u0cb0\u0ccd\u0cb6\u0ca8 \u0ca8\u0cc0\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0cb9\u0cc0\u0c97\u0cbe\u0c97\u0cbf \u0c85\u0ca8\u0cc7\u0c95 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0c9c\u0cbe\u0cb2\u0ca4\u0cbe\u0ca3\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cc1\u0cb5 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2.",vision:"\u0ca8\u0cae\u0ccd\u0cae \u0ca6\u0cc2\u0cb0\u0ca6\u0cc3\u0cb7\u0ccd\u0c9f\u0cbf",visionText:"\u0ca8\u0cbe\u0c97\u0cb0\u0cbf\u0c95\u0cb0 \u0c9c\u0cc0\u0cb5\u0ca8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc1\u0cb2\u0cad\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0ca8\u0cae\u0ccd\u0cae \u0ca6\u0cc3\u0cb7\u0ccd\u0c9f\u0cbf\u0c95\u0ccb\u0ca8\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.",mission:"\u0ca8\u0cae\u0ccd\u0cae \u0cae\u0cbf\u0cb7\u0ca8\u0ccd",mission1:"\u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb0\u0caf\u0ccb\u0c9c\u0ca8\u0c97\u0cb3\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0-\u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc1\u0c97\u0cae\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0ca8\u0cae\u0ccd\u0cae \u0c89\u0ca6\u0ccd\u0ca6\u0cc7\u0cb6\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.",mission2:"\u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb0\u0caf\u0ccb\u0c9c\u0ca8 \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbe\u0ca6 \u0cb8\u0cae\u0caf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb6\u0ccd\u0cb0\u0cae\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0ca1\u0cbf\u0cae\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf.",aboutPageDesc1:"\u0cb5\u0cbf\u0ca6\u0ccd\u0caf\u0cc1\u0ca8\u0ccd\u0cae\u0cbe\u0ca8 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf \u0ca4\u0c82\u0ca4\u0ccd\u0cb0\u0c9c\u0ccd\u0c9e\u0cbe\u0ca8 \u0cb8\u0c9a\u0cbf\u0cb5\u0cbe\u0cb2\u0caf (\u0c8e\u0c82\u0c87\u0c90\u0c9f\u0cbf\u0cb5\u0cc8), \u0c86\u0ca1\u0cb3\u0cbf\u0ca4\u0cbe\u0ca4\u0ccd\u0cae\u0c95 \u0cb8\u0cc1\u0ca7\u0cbe\u0cb0\u0ca3\u0cc6\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cbe\u0cb0\u0ccd\u0cb5\u0c9c\u0ca8\u0cbf\u0c95 \u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6 \u0c87\u0cb2\u0cbe\u0c96\u0cc6 (\u0ca1\u0cbf\u0c8e\u0c86\u0cb0\u0ccd\u0caa\u0cbf\u0c9c\u0cbf) \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c87\u0ca4\u0cb0 \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb0\u0cbe\u0c9c\u0ccd\u0caf \u0cb8\u0c9a\u0cbf\u0cb5\u0cbe\u0cb2\u0caf\u0c97\u0cb3\u0cc1/\u0c87\u0cb2\u0cbe\u0c96\u0cc6\u0c97\u0cb3 \u0cb8\u0cb9\u0cad\u0cbe\u0c97\u0cbf\u0ca4\u0ccd\u0cb5\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb0\u0cbe\u0cb7\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0caf \u0c87-\u0c86\u0ca1\u0cb3\u0cbf\u0ca4 \u0cb5\u0cbf\u0cad\u0cbe\u0c97\u0cb5\u0cc1 (\u0c8e\u0ca8\u0ccd\u0c87\u0c9c\u0cbf\u0ca1\u0cbf) \u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0cb5\u0cc7\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0cad\u0cbf\u0cb5\u0cc3\u0ca6\u0ccd\u0ca7\u0cbf\u0caa\u0ca1\u0cbf\u0cb8\u0cbf\u0ca6\u0cc6, \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6.",eligibilityCheckHead:"\u0c85\u0cb0\u0ccd\u0cb9\u0ca4\u0cbe \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6",eligibilityCheckDesc:"\u0cb5\u0cbf\u0cb5\u0cbf\u0ca7 \u0cae\u0cbe\u0ca8\u0ca6\u0c82\u0ca1\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 \u0c97\u0cc1\u0ca3\u0cb2\u0c95\u0ccd\u0cb7\u0ca3\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c85\u0cb0\u0ccd\u0cb9\u0ca4\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",schemeFinderHead:"\u0caf\u0ccb\u0c9c\u0ca8\u0cc6 \u0cb6\u0ccb\u0ca7\u0c95",schemeFinderDesc:"\u0cb5\u0cbf\u0cb5\u0cbf\u0ca7 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cab\u0cbf\u0cb2\u0ccd\u0c9f\u0cb0\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0ca1\u0ccd\u0cb0\u0cbf\u0cb2\u0ccd \u0ca1\u0ccc\u0ca8\u0ccd\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cc1\u0cb2\u0cad \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbe\u0c9f",schemeInDetailHead:"\u0cb5\u0cbf\u0cb5\u0cb0\u0cb5\u0cbe\u0ca6 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6",schemeInDetailDesc:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c85\u0cb0\u0ccd\u0c9c\u0cbf \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0cb8\u0cc2\u0c95\u0ccd\u0cb7\u0ccd\u0cae \u0ca7\u0cbe\u0ca8\u0ccd\u0caf\u0ca6 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0cae\u0cc0\u0cb8\u0cb2\u0cbe\u0ca6 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf \u0caa\u0cc1\u0c9f\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c86\u0cb3\u0cb5\u0cbe\u0c97\u0cbf \u0cb9\u0ccb\u0c97\u0cbf.",documentRequired:"\u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1",faqHead:"\u0caa\u0ca6\u0cc7 \u0caa\u0ca6\u0cc7 \u0c95\u0cc7\u0cb3\u0cb2\u0cbe\u0c97\u0cc1\u0cb5 \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6\u0c97\u0cb3\u0cc1",faqSubHead1:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0c97\u0cb3\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0ca8\u0cae\u0ccd\u0cae \u0c9c\u0ccd\u0c9e\u0cbe\u0ca8\u0ca6 \u0cae\u0cc2\u0cb2\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf!",ques1:"\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0c8e\u0c82\u0ca6\u0cb0\u0cc7\u0ca8\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c87\u0ca6\u0cc1 \u0c87\u0ca4\u0cb0 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cb2\u0ccd\u0c97\u0cb3\u0cbf\u0c97\u0cbf\u0c82\u0ca4 \u0cb9\u0cc7\u0c97\u0cc6 \u0cad\u0cbf\u0ca8\u0ccd\u0ca8\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6?",ans1:"\u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb0\u0cbe\u0c9c\u0ccd\u0caf/\u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0cbe\u0ca1\u0cb3\u0cbf\u0ca4 \u0caa\u0ccd\u0cb0\u0ca6\u0cc7\u0cb6\u0c97\u0cb3 \u0c8e\u0cb0\u0ca1\u0cc2 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0c97\u0cb3\u0cbf\u0c82\u0ca6 \u0cb5\u0ccd\u0caf\u0cbe\u0caa\u0c95 \u0cb6\u0ccd\u0cb0\u0cc7\u0ca3\u0cbf\u0caf \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0c92\u0c82\u0ca6\u0cc1 \u0cb0\u0cbe\u0cb7\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0caf \u0cb5\u0cc7\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c87\u0ca6\u0cc1 \u0c9c\u0ca8\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cbe \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3 \u0c86\u0ca7\u0cbe\u0cb0\u0ca6 \u0cae\u0cc7\u0cb2\u0cc6 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbe\u0c9f \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0ca8\u0ccd\u0cb5\u0cc7\u0cb7\u0ca3\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0c92\u0c82\u0ca6\u0cc1 \u0ca8\u0cbf\u0cb2\u0cc1\u0c97\u0ca1\u0cc6 \u0cb5\u0cc7\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0cb8\u0cbe\u0c82\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0caf\u0cbf\u0c95 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cb2\u0ccd\u0c97\u0cb3\u0cbf\u0c97\u0cbf\u0c82\u0ca4 \u0cad\u0cbf\u0ca8\u0ccd\u0ca8\u0cb5\u0cbe\u0c97\u0cbf, \u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0, \u0cb0\u0cbe\u0c9c\u0ccd\u0caf \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0cbe\u0ca1\u0cb3\u0cbf\u0ca4 \u0caa\u0ccd\u0cb0\u0ca6\u0cc7\u0cb6\u0c97\u0cb3 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0c82\u0ca6\u0cc7 \u0cb5\u0cc7\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0c92\u0c9f\u0ccd\u0c9f\u0cc1\u0c97\u0cc2\u0ca1\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cbf\u0c97\u0cc6 \u0c85\u0cb5\u0cb0 \u0c85\u0cb0\u0ccd\u0cb9\u0ca4\u0cc6\u0caf \u0c86\u0ca7\u0cbe\u0cb0\u0ca6 \u0cae\u0cc7\u0cb2\u0cc6 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0ca4 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0cb2\u0cc1 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",ques2:"\u0ca8\u0ca8\u0ccd\u0ca8 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf\u0cc1 \u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0ca8\u0cbe\u0c97\u0cb0\u0cbf\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0cb9\u0cc7\u0c97\u0cc6 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6?",ans2:"\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0ca8\u0cbe\u0c97\u0cb0\u0cbf\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0c92\u0c82\u0ca6\u0cc7 \u0cb8\u0ccd\u0ca5\u0cb3\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0ca4 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0cb2\u0cc1 \u0c85\u0ca8\u0cc1\u0cb5\u0cc1 \u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0ca1\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb0\u0cb3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6, \u0c85\u0ca8\u0cc7\u0c95 \u0c87\u0cb2\u0cbe\u0c96\u0cbe \u0c9c\u0cbe\u0cb2\u0ca4\u0cbe\u0ca3\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cc1\u0cb5 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0cb9\u0cbe\u0c95\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe \u0c85\u0cb5\u0cb0 \u0c85\u0cb0\u0ccd\u0cb9\u0ca4\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb5\u0ccd\u0caf\u0cbe\u0caa\u0c95 \u0caf\u0ccb\u0c9c\u0ca8\u0cbe \u0cae\u0cbe\u0cb0\u0ccd\u0c97\u0cb8\u0cc2\u0c9a\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",ques3:"\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0cb9\u0cc7\u0c97\u0cc6 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6?",ans3:"\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0ca8\u0cbe\u0c97\u0cb0\u0cbf\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0c85\u0cb5\u0cb0\u0cc1 \u0c85\u0cb0\u0ccd\u0cb9\u0cb0\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0cb2\u0cc1 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cb8\u0cb0\u0cb3 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0 \u0cb8\u0ccd\u0ca8\u0cc7\u0cb9\u0cbf \u0cae\u0cc2\u0cb0\u0cc1-\u0cb9\u0c82\u0ca4\u0ca6 \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0cc1\u0cb8\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6\u0c83 \u0cb9\u0c82\u0ca4 1: \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cc1 \u0c9c\u0ca8\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cbe, \u0c86\u0ca6\u0cbe\u0caf, \u0cb8\u0cbe\u0cae\u0cbe\u0c9c\u0cbf\u0c95 \u0cb5\u0cb0\u0ccd\u0c97 \u0cae\u0cc1\u0c82\u0ca4\u0cbe\u0ca6 \u0cae\u0cc2\u0cb2\u0cad\u0cc2\u0ca4 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6. \u0cb9\u0c82\u0ca4 2: \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cbf\u0ca6 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf \u0c86\u0ca7\u0cbe\u0cb0\u0ca6 \u0cae\u0cc7\u0cb2\u0cc6, \u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0ca8\u0cc2\u0cb0\u0cbe\u0cb0\u0cc1 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0ca4 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0ca6\u0cb0\u0ccd\u0cb6\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0cb9\u0c82\u0ca4 3: \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cc1 \u0c85\u0cb0\u0ccd\u0cb9 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3 \u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbf\u0cb5\u0cb0\u0cb5\u0cbe\u0ca6 \u0c9c\u0ccd\u0c9e\u0cbe\u0ca8, \u0caa\u0ca6\u0cc7 \u0caa\u0ca6\u0cc7 \u0c95\u0cc7\u0cb3\u0cb2\u0cbe\u0c97\u0cc1\u0cb5 \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0cb0\u0ccd\u0c9c\u0cbf \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0caf\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cae\u0cc0\u0cb8\u0cb2\u0cbe\u0ca6 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf \u0caa\u0cc1\u0c9f\u0ca6\u0cbf\u0c82\u0ca6 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0cb0\u0ccd\u0c9c\u0cbf \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0caf\u0cbe \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0caf\u0cc1\u0c86\u0cb0\u0ccd\u0c8e\u0cb2\u0ccd\u0c97\u0cc6 \u0ca8\u0ccd\u0caf\u0cbe\u0cb5\u0cbf\u0c97\u0cc7\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",ques4:"\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbf\u0cb3\u0cbf\u0caf\u0cc1\u0cb5 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0cb5\u0cbf\u0ca7\u0cbe\u0ca8\u0cb5\u0cc7\u0ca8\u0cc1?",ans4:"\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0cb5\u0cc7\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0cb2\u0cc1, \u0ca8\u0cbe\u0c97\u0cb0\u0cbf\u0c95\u0cb0\u0cc1 \u0cb5\u0cc7\u0ca6\u0cbf\u0c95\u0cc6\u0caf \u0c85\u0ca7\u0cbf\u0c95\u0cc3\u0ca4 \u0c9c\u0cbe\u0cb2\u0ca4\u0cbe\u0ca3\u0c95\u0ccd\u0c95\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0cae\u0cc1\u0c96\u0caa\u0cc1\u0c9f\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c92\u0cae\u0ccd\u0cae\u0cc6, \u0c85\u0cb5\u0cb0\u0cc1 '\u0cab\u0cc8\u0c82\u0ca1\u0ccd \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd\u0cb8\u0ccd \u0cab\u0cbe\u0cb0\u0ccd \u0caf\u0cc2' \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6, \u0c87\u0ca6\u0cc1 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cbf\u0c97\u0cc6 \u0cb5\u0caf\u0cb8\u0ccd\u0cb8\u0cc1, \u0cb2\u0cbf\u0c82\u0c97, \u0c86\u0ca6\u0cbe\u0caf \u0cae\u0c9f\u0ccd\u0c9f, \u0cb5\u0cb0\u0ccd\u0c97 \u0cae\u0cc1\u0c82\u0ca4\u0cbe\u0ca6 \u0c85\u0cb5\u0cb0 \u0c9c\u0ca8\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cbe \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0ca8\u0cc1\u0cb5\u0cc1 \u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c88 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0, \u0cb5\u0cc7\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cc1 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0 \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ca6 \u0cae\u0cc7\u0cb2\u0cc6 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0ca4 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3 \u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",ques5:"\u0c92\u0c82\u0ca6\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0ca6\u0cbf\u0cb7\u0ccd\u0c9f \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0caf\u0cbe\u0cb5 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0ca8\u0ca8\u0ccd\u0ca8 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0caa\u0ca1\u0cc6\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",ans5:"\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0c85\u0cb0\u0ccd\u0cb9\u0ca4\u0cbe \u0cae\u0cbe\u0ca8\u0ca6\u0c82\u0ca1\u0c97\u0cb3\u0cc1, \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0cb5 \u0caa\u0ccd\u0cb0\u0caf\u0ccb\u0c9c\u0ca8\u0c97\u0cb3\u0cc1, \u0c85\u0cb0\u0ccd\u0c9c\u0cbf \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbe\u0ca6 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0ca6\u0c82\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0cb8\u0cae\u0c97\u0ccd\u0cb0 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c87\u0ca6\u0cc1 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cc6 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0cc0\u0cb8\u0cb2\u0cbe\u0ca6 \u0caa\u0ca6\u0cc7 \u0caa\u0ca6\u0cc7 \u0c95\u0cc7\u0cb3\u0cb2\u0cbe\u0c97\u0cc1\u0cb5 \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6\u0c97\u0cb3\u0cc1 (\u0c8e\u0cab\u0ccd\u0c8e\u0c95\u0ccd\u0caf\u0cc2) \u0cb5\u0cbf\u0cad\u0cbe\u0c97\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb9 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0ca6\u0cc6.",ques6:"\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3 \u0cb5\u0cbf\u0cb6\u0cbe\u0cb2 \u0cb5\u0cb0\u0ccd\u0c97\u0c97\u0cb3\u0cc1 \u0caf\u0cbe\u0cb5\u0cc1\u0cb5\u0cc1?",ans6:"\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0cb5\u0cc7\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0cb5\u0cc1\u0c97\u0cb3 \u0caa\u0ccd\u0cb0\u0caf\u0ccb\u0c9c\u0ca8\u0c97\u0cb3 \u0cb8\u0ccd\u0cb5\u0cb0\u0cc2\u0caa \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c89\u0ca6\u0ccd\u0ca6\u0cc7\u0cb6\u0cbf\u0ca4 \u0cab\u0cb2\u0cbe\u0ca8\u0cc1\u0cad\u0cb5\u0cbf\u0c97\u0cb3 \u0c86\u0ca7\u0cbe\u0cb0\u0ca6 \u0cae\u0cc7\u0cb2\u0cc6 15 \u0cb5\u0cb0\u0ccd\u0c97\u0c97\u0cb3\u0cbe\u0c97\u0cbf \u0cb5\u0cbf\u0c82\u0c97\u0ca1\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c88 \u0cb5\u0cbf\u0cad\u0cbe\u0c97\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0cc3\u0cb7\u0cbf, \u0c97\u0ccd\u0cb0\u0cbe\u0cae\u0cc0\u0ca3 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0cb0\u0cbf\u0cb8\u0cb0; \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0cbf\u0c82\u0c97\u0ccd, \u0cb9\u0ca3\u0c95\u0cbe\u0cb8\u0cc1 \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbf\u0cae\u0cc6; \u0cb5\u0ccd\u0caf\u0cbe\u0caa\u0cbe\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c89\u0ca6\u0ccd\u0caf\u0cae\u0cb6\u0cc0\u0cb2\u0ca4\u0cc6; \u0cb6\u0cbf\u0c95\u0ccd\u0cb7\u0ca3 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c95\u0cb2\u0cbf\u0c95\u0cc6; \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0ccd\u0cb5\u0cbe\u0cb8\u0ccd\u0ca5\u0ccd\u0caf; \u0cb5\u0cb8\u0ca4\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c86\u0cb6\u0ccd\u0cb0\u0caf; \u0cb8\u0cbe\u0cb0\u0ccd\u0cb5\u0c9c\u0ca8\u0cbf\u0c95 \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0ca4\u0cc6, \u0c95\u0cbe\u0ca8\u0cc2\u0ca8\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0ccd\u0caf\u0cbe\u0caf; \u0cb5\u0cbf\u0c9c\u0ccd\u0c9e\u0cbe\u0ca8, \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf \u0ca4\u0c82\u0ca4\u0ccd\u0cb0\u0c9c\u0ccd\u0c9e\u0cbe\u0ca8 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0c82\u0cb5\u0cb9\u0ca8; \u0c95\u0ccc\u0cb6\u0cb2\u0ccd\u0caf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c89\u0ca6\u0ccd\u0caf\u0ccb\u0c97; \u0cb8\u0cae\u0cbe\u0c9c \u0c95\u0cb2\u0ccd\u0caf\u0cbe\u0ca3 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cac\u0cb2\u0cc0\u0c95\u0cb0\u0ca3; \u0c95\u0ccd\u0cb0\u0cc0\u0ca1\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0c82\u0cb8\u0ccd\u0c95\u0cc3\u0ca4\u0cbf; \u0cb8\u0cbe\u0cb0\u0cbf\u0c97\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cc2\u0cb2\u0cb8\u0ccc\u0c95\u0cb0\u0ccd\u0caf; \u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb0\u0cb5\u0cbe\u0cb8\u0ccb\u0ca6\u0ccd\u0caf\u0cae; \u0c89\u0caa\u0caf\u0cc1\u0c95\u0ccd\u0ca4\u0ca4\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0cc8\u0cb0\u0ccd\u0cae\u0cb2\u0ccd\u0caf; \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cb9\u0cbf\u0cb3\u0cc6\u0caf\u0cb0\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0c95\u0ccd\u0c95\u0cb3\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb5\u0cc6.",ques7:"\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0cac\u0cb9\u0cc1\u0cad\u0cbe\u0cb7\u0cbe \u0cac\u0cc6\u0c82\u0cac\u0cb2\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6\u0caf\u0cc7?",ans7:"\u0cb9\u0ccc\u0ca6\u0cc1, \u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0c87\u0c82\u0c97\u0ccd\u0cb2\u0cbf\u0cb7\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0ca6\u0c82\u0ca4\u0cc6 15 \u0cad\u0cbe\u0cb7\u0cc6\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cb5\u0cbf\u0cb7\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cc6\u0c82\u0cac\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0cb6\u0cc0\u0c98\u0ccd\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cc7 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1\u0cb5\u0cb0\u0cbf \u0cad\u0cbe\u0cb0\u0ca4\u0cc0\u0caf \u0cad\u0cbe\u0cb7\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cac\u0cc6\u0c82\u0cac\u0cb2\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1.",ques8:"\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0cb5\u0cc7\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cc1 \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb0\u0cbe\u0c9c\u0ccd\u0caf/\u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0cbe\u0ca1\u0cb3\u0cbf\u0ca4 \u0caa\u0ccd\u0cb0\u0ca6\u0cc7\u0cb6\u0c97\u0cb3 \u0ca8\u0cbf\u0cb0\u0ccd\u0ca6\u0cbf\u0cb7\u0ccd\u0c9f \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0ca6\u0cb0\u0ccd\u0cb6\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6\u0caf\u0cc7?",ans8:"\u0cb9\u0ccc\u0ca6\u0cc1, \u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 4,700 \u0c95\u0ccd\u0c95\u0cc2 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1 \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb0\u0cbe\u0c9c\u0ccd\u0caf/\u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0cbe\u0ca1\u0cb3\u0cbf\u0ca4 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0ca6 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1\u0cb5\u0cb0\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0cc1 \u0ca8\u0cbf\u0cb0\u0c82\u0ca4\u0cb0\u0cb5\u0cbe\u0c97\u0cbf \u0cb5\u0cc7\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0c86\u0ca8\u0ccd\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cb2\u0cc7 \u0c87\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6.",ques9:"\u0ca8\u0ca8\u0c97\u0cc6 \u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cbf\u0cb0\u0ccd\u0ca6\u0cbf\u0cb7\u0ccd\u0c9f \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca8\u0cbe\u0ca8\u0cc1 \u0c8f\u0ca8\u0cc1 \u0cae\u0cbe\u0ca1\u0cac\u0cc7\u0c95\u0cc1?",ans9:'\u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4, 4,700\u0c95\u0ccd\u0c95\u0cc2 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1 \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb0\u0cbe\u0c9c\u0ccd\u0caf/\u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0cbe\u0ca1\u0cb3\u0cbf\u0ca4 \u0caa\u0ccd\u0cb0\u0ca6\u0cc7\u0cb6\u0c97\u0cb3 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0cb5\u0cc7\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0ca8\u0cbf\u0caf\u0cae\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1\u0cb5\u0cb0\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6. \u0ca8\u0cbe\u0c97\u0cb0\u0cbf\u0c95\u0cb0\u0cc1 \u0cb5\u0cc7\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 "\u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cbf" \u0cb5\u0cbf\u0cad\u0cbe\u0c97\u0ca6 \u0cae\u0cc2\u0cb2\u0c95 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c95\u0cbe\u0ca3\u0cc6\u0caf\u0cbe\u0ca6 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.',ques10:"\u0cae\u0cb0\u0cbe\u0ca0\u0cbf \u0cad\u0cbe\u0cb7\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0ca8 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3 \u0cb5\u0cbf\u0cb7\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0ca6\u0ccb\u0cb7\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0c95\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6. \u0ca8\u0cbe\u0ca8\u0cc1 \u0c8f\u0ca8\u0cc1 \u0cae\u0cbe\u0ca1\u0cac\u0cc7\u0c95\u0cc1?",ans10:"\u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf \u0cb5\u0cbf\u0cb7\u0caf\u0ca6 \u0cae\u0cb0\u0cbe\u0ca0\u0cbf \u0c86\u0cb5\u0cc3\u0ca4\u0ccd\u0ca4\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb5\u0ccd\u0caf\u0ca4\u0ccd\u0caf\u0cbe\u0cb8 \u0c95\u0c82\u0ca1\u0cc1\u0cac\u0c82\u0ca6\u0cb0\u0cc6, \u0cb8\u0ccd\u0caa\u0cb7\u0ccd\u0c9f\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0c87\u0c82\u0c97\u0ccd\u0cb2\u0cbf\u0cb7\u0ccd \u0c86\u0cb5\u0cc3\u0ca4\u0ccd\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c89\u0cb2\u0ccd\u0cb2\u0cc7\u0c96\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbe\u0c97\u0cb0\u0cbf\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0cb8\u0cc2\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0ca6\u0cb0\u0cc6, \u0c85\u0ca4\u0ccd\u0caf\u0c82\u0ca4 \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0ca6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cc3\u0ca4 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0c86\u0caf\u0cbe \u0cb8\u0c9a\u0cbf\u0cb5\u0cbe\u0cb2\u0caf\u0ca6 \u0c85\u0ca5\u0cb5\u0cbe \u0c87\u0cb2\u0cbe\u0c96\u0cc6\u0caf \u0c85\u0ca7\u0cbf\u0c95\u0cc3\u0ca4 \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cb2\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c89\u0cb2\u0ccd\u0cb2\u0cc7\u0c96\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf, support-myscheme[at]digitalindia[dot]gov[dot]in \u0c97\u0cc6 \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cb0\u0ca6\u0cbf \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",ques11:"\u0cb5\u0cbf\u0ca6\u0ccd\u0caf\u0cbe\u0cb0\u0ccd\u0ca5\u0cbf\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cb5\u0cbf\u0ca6\u0ccd\u0caf\u0cbe\u0cb0\u0ccd\u0ca5\u0cbf\u0cb5\u0cc7\u0ca4\u0ca8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0cb5 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0c85\u0ca8\u0ccd\u0cb5\u0cc7\u0cb7\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6. \u0c87\u0ca6\u0cc1 \u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cc7?",ans11:"\u0cb9\u0ccc\u0ca6\u0cc1, \u0cb5\u0cbf\u0ca6\u0ccd\u0caf\u0cbe\u0cb0\u0ccd\u0ca5\u0cbf\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cb5\u0cbf\u0ca6\u0ccd\u0caf\u0cbe\u0cb0\u0ccd\u0ca5\u0cbf\u0cb5\u0cc7\u0ca4\u0ca8 \u0cb8\u0cc7\u0cb0\u0cbf\u0ca6\u0c82\u0ca4\u0cc6 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0caa\u0ccd\u0cb0\u0caf\u0ccb\u0c9c\u0ca8\u0c97\u0cb3 \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0ccd\u0caf\u0cbe\u0caa\u0ccd\u0ca4\u0cbf\u0caf \u0c86\u0ca7\u0cbe\u0cb0\u0ca6 \u0cae\u0cc7\u0cb2\u0cc6 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc1\u0cb2\u0cad\u0cb5\u0cbe\u0c97\u0cbf \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cb2\u0cc1, \u0c85\u0ca8\u0ccd\u0cb5\u0cc7\u0cb7\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbe\u0c97\u0cb0\u0cbf\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0c85\u0ca8\u0cc1\u0cb5\u0cc1 \u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0ca1\u0cc1\u0cb5 \u0c95\u0cc0\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbe\u0c9f \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0ca8\u0cc0\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",ques12:"\u0ca8\u0cbe\u0ca8\u0cc1 \u0c92\u0c82\u0ca6\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0ca6\u0cbf\u0cb7\u0ccd\u0c9f \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cc6 \u0c85\u0cb0\u0ccd\u0c9c\u0cbf \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0cb0\u0ccd\u0c9c\u0cbf \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbf\u0cb3\u0cbf\u0caf\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6. \u0ca8\u0cbe\u0ca8\u0cc1 \u0c88 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0ca8\u0ccd\u0ca8 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0c82\u0ca1\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cac\u0cb9\u0cc1\u0ca6\u0cc7?",ans12:"\u0cb9\u0ccc\u0ca6\u0cc1, \u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cc6 \u0c85\u0cb0\u0ccd\u0c9c\u0cbf \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbe\u0ca6 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3 \u0cb8\u0c82\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6, \u0c87\u0ca6\u0cc1 \u0ca8\u0cbe\u0c97\u0cb0\u0cbf\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0cb8\u0cc1\u0cb2\u0cad\u0cb5\u0cbe\u0c97\u0cbf \u0ca4\u0caf\u0cbe\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0cb0\u0ccd\u0c9c\u0cbf \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0ca8\u0cc1\u0cb5\u0cc1 \u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",ques13:"\u0ca8\u0cbe\u0ca8\u0cc1 \u0ca8\u0ca8\u0ccd\u0ca8 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf \u0cae\u0cc2\u0cb2\u0c95 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c85\u0cb0\u0ccd\u0c9c\u0cbf \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc7?",ans13:"\u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4, \u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0ca4 \u0cb8\u0c9a\u0cbf\u0cb5\u0cbe\u0cb2\u0caf \u0c85\u0ca5\u0cb5\u0cbe \u0c87\u0cb2\u0cbe\u0c96\u0cc6\u0caf \u0c86\u0caf\u0cbe \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0caa\u0cc1\u0c9f\u0c95\u0ccd\u0c95\u0cc6 \u0cae\u0cb0\u0cc1\u0ca8\u0cbf\u0cb0\u0ccd\u0ca6\u0cc7\u0cb6\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0cae\u0cc1\u0c82\u0cac\u0cb0\u0cc1\u0cb5 \u0cb9\u0c82\u0ca4\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf, \u0ca8\u0cbe\u0c97\u0cb0\u0cbf\u0c95\u0cb0\u0cc1 \u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cb2\u0ccd/\u0c89\u0cae\u0c82\u0c97\u0ccd \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c85\u0cb0\u0ccd\u0c9c\u0cbf \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0c8e\u0c82\u0ca6\u0cc1 \u0c8a\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.",ques14:'\u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cbf\u0c97\u0cc6 \u0cb8\u0cc2\u0c95\u0ccd\u0ca4\u0cb5\u0cbe\u0ca6 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0ccd\u0cb5\u0cc7\u0cb7\u0cbf\u0cb8\u0cb2\u0cc1, \u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd\u0ca8 "\u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbe\u0c9f" \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0caf\u0cbe\u0cb5 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cbe\u0c97\u0cbf\u0ca6\u0cc6?',ans14:'\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd\u0ca8 "\u0caa\u0cb0\u0ccd\u0cb8\u0ca8\u0cb2\u0cc8\u0cb8\u0ccd\u0ca1\u0ccd \u0cb8\u0cb0\u0ccd\u0c9a\u0ccd" \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cb2\u0cc1, \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cc1 \u0cb2\u0cbf\u0c82\u0c97, \u0cb5\u0caf\u0cb8\u0ccd\u0cb8\u0cc1, \u0cb5\u0cc8\u0cb5\u0cbe\u0cb9\u0cbf\u0c95 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf, \u0cb0\u0cbe\u0c9c\u0ccd\u0caf, \u0cb5\u0cbe\u0cb8\u0cb8\u0ccd\u0ca5\u0cb3 (\u0ca8\u0c97\u0cb0 \u0c85\u0ca5\u0cb5\u0cbe \u0c97\u0ccd\u0cb0\u0cbe\u0cae\u0cc0\u0ca3), \u0cb8\u0cbe\u0cae\u0cbe\u0c9c\u0cbf\u0c95 \u0cb5\u0cb0\u0ccd\u0c97, \u0c85\u0c82\u0c97\u0cb5\u0cc8\u0c95\u0cb2\u0ccd\u0caf \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf, \u0c85\u0cb2\u0ccd\u0caa\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cbe\u0ca4 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf, \u0c89\u0ca6\u0ccd\u0caf\u0ccb\u0c97 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c87\u0ca4\u0cb0 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0ca4 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0c82\u0ca4\u0cb9 \u0cae\u0cc2\u0cb2 \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c87\u0ca6\u0cc1 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0 \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd\u0c97\u0cc6 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1 \u0cb8\u0cc2\u0c95\u0ccd\u0ca4\u0cb5\u0cbe\u0ca6 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.',ques15:'"\u0c9a\u0cc6\u0c95\u0ccd \u0c8e\u0cb2\u0cbf\u0c9c\u0cbf\u0cac\u0cbf\u0cb2\u0cbf\u0c9f\u0cbf \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cbe\u0cb5\u0cb3\u0cbf" \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0cb5\u0cc7\u0ca8\u0cc1?',ans15:'"\u0c9a\u0cc6\u0c95\u0ccd \u0c8e\u0cb2\u0cbf\u0c9c\u0cbf\u0cac\u0cbf\u0cb2\u0cbf\u0c9f\u0cbf \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cbe\u0cb5\u0cb3\u0cbf" \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0cb5\u0cc1 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6-\u0ca8\u0cbf\u0cb0\u0ccd\u0ca6\u0cbf\u0cb7\u0ccd\u0c9f \u0c85\u0cb0\u0ccd\u0cb9\u0ca4\u0cbe \u0cae\u0cbe\u0ca8\u0ca6\u0c82\u0ca1\u0c97\u0cb3 \u0cae\u0cc7\u0cb2\u0cc6 \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cbf\u0c97\u0cc6 \u0cb8\u0cb0\u0cb3\u0cb5\u0cbe\u0ca6 \u0cb9\u0ccc\u0ca6\u0cc1/\u0c87\u0cb2\u0ccd\u0cb2 \u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cbe\u0cb5\u0cb3\u0cbf\u0caf \u0cae\u0cc2\u0cb2\u0c95 \u0ca4\u0cae\u0ccd\u0cae \u0c85\u0cb0\u0ccd\u0cb9\u0ca4\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0ca8\u0cc1\u0cb5\u0cc1 \u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cbf\u0ca6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0c97\u0cb3 \u0c86\u0ca7\u0cbe\u0cb0\u0ca6 \u0cae\u0cc7\u0cb2\u0cc6, \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0ca6\u0cbf\u0cb7\u0ccd\u0c9f \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cc6 \u0c85\u0cb0\u0ccd\u0cb9\u0cb0\u0cbe\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0cb0\u0cc6\u0caf\u0cc7 \u0c8e\u0c82\u0ca6\u0cc1 \u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cb0\u0ccd\u0ca3\u0caf\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.',ques16:"\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0c9a\u0cbe\u0c9f\u0ccd\u0cac\u0cbe\u0c9f\u0ccd \u0cb8\u0ccc\u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0ca6\u0cc6\u0caf\u0cc7 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c87\u0ca6\u0cc1 \u0ca8\u0cbe\u0c97\u0cb0\u0cbf\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0cb9\u0cc7\u0c97\u0cc6 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6?",ans16:"\u0cb9\u0ccc\u0ca6\u0cc1, \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0ca4 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0cc1\u0cb5\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cbe\u0c97\u0cb0\u0cbf\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0ca7\u0ccd\u0cb5\u0ca8\u0cbf-\u0cb6\u0c95\u0ccd\u0ca4\u0c97\u0cca\u0c82\u0ca1, \u0cac\u0cb9\u0cc1\u0cad\u0cbe\u0cb7\u0cbe \u0c8e\u0c90-\u0c9a\u0cbe\u0cb2\u0cbf\u0ca4 \u0c9a\u0cbe\u0c9f\u0ccd\u0cac\u0cbe\u0c9f\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cbf\u0ca6\u0cc6. \u0c9a\u0cbe\u0c9f\u0ccd\u0cac\u0cbe\u0c9f\u0ccd \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0 \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6, \u0cb8\u0c82\u0cad\u0cbe\u0cb7\u0ca3\u0cbe \u0cb8\u0cb9\u0cbe\u0caf\u0ca6 \u0cae\u0cc2\u0cb2\u0c95 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf \u0c86\u0cb5\u0cbf\u0cb7\u0ccd\u0c95\u0cbe\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb0\u0cb3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c86\u0c95\u0cb0\u0ccd\u0cb7\u0c95 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0 \u0cb8\u0ccd\u0ca8\u0cc7\u0cb9\u0cbf \u0c85\u0ca8\u0cc1\u0cad\u0cb5\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0ca1\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0-\u0ca8\u0cbe\u0c97\u0cb0\u0cbf\u0c95\u0cb0 \u0cb8\u0c82\u0cb5\u0cb9\u0ca8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",ques17:"\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5 \u0c8e\u0c90 \u0c9a\u0cbe\u0c9f\u0ccd\u0cac\u0cbe\u0c9f\u0ccd\u0ca8 \u0caa\u0ccd\u0cb0\u0cae\u0cc1\u0c96 \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c97\u0cb3\u0cc1 \u0caf\u0cbe\u0cb5\u0cc1\u0cb5\u0cc1?",ans17:"\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0c8e\u0c90 \u0c9a\u0cbe\u0c9f\u0ccd\u0cac\u0cbe\u0c9f\u0ccd \u0ca7\u0ccd\u0cb5\u0ca8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ca0\u0ccd\u0caf \u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0cb8\u0c82\u0cb5\u0cb9\u0ca8\u0c97\u0cb3\u0cc1, \u0cb9\u0cbf\u0c82\u0ca6\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c87\u0c82\u0c97\u0ccd\u0cb2\u0cbf\u0cb7\u0ccd\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca6\u0ccd\u0cb5\u0cbf\u0cad\u0cbe\u0cb7\u0cbe \u0cac\u0cc6\u0c82\u0cac\u0cb2, \u0cb8\u0c82\u0ca6\u0cb0\u0ccd\u0cad-\u0c85\u0cb0\u0cbf\u0cb5\u0cbf\u0ca8 \u0cb8\u0c82\u0cad\u0cbe\u0cb7\u0ca3\u0cc6\u0c97\u0cb3\u0cc1, \u0c85\u0ca7\u0cbf\u0cb5\u0cc7\u0cb6\u0ca8-\u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0c9a\u0cbe\u0c9f\u0ccd \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0c95\u0cb2\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0cb5 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6, \u0c87\u0ca6\u0cc1 \u0ca4\u0ca1\u0cc6\u0cb0\u0cb9\u0cbf\u0ca4 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0 \u0cb8\u0ccd\u0ca8\u0cc7\u0cb9\u0cbf \u0c85\u0ca8\u0cc1\u0cad\u0cb5\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c96\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf\u0caa\u0ca1\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",ques18:"\u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3 \u0cb5\u0cbf\u0cb7\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0cb8\u0cbf\u0ca6\u0c82\u0ca4\u0cc6 \u0ca8\u0ca8\u0ccd\u0ca8 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",ans18:'\u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf \u0caa\u0cc1\u0c9f\u0ca6 \u0c95\u0cc6\u0cb3\u0cad\u0cbe\u0c97\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5 "\u0c87\u0ca6\u0cc1 \u0cb8\u0cb9\u0cbe\u0caf\u0c95\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6\u0caf\u0cc7?" \u0c8e\u0c82\u0cac \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0caf \u0cb5\u0cbf\u0cad\u0cbe\u0c97\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6, \u0c87\u0ca6\u0cc1 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cbf\u0c97\u0cc6 \u0cb5\u0cbf\u0cb7\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 1 \u0cb0\u0cbf\u0c82\u0ca6 5 \u0ca8\u0c95\u0ccd\u0cb7\u0ca4\u0ccd\u0cb0\u0c97\u0cb3\u0cbf\u0c82\u0ca6 \u0cb0\u0cc7\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0cb5\u0cb0 \u0c85\u0ca8\u0cc1\u0cad\u0cb5\u0c97\u0cb3\u0cc1, \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cb3\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u0c85\u0ca8\u0cc1\u0cb5\u0cc1 \u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cc1 \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0cb5\u0cbf\u0cb5\u0cb0\u0cb5\u0cbe\u0ca6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 support-myscheme@digitalindia.gov.in \u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1, \u0c87\u0ca6\u0cc1 \u0cb5\u0cc7\u0ca6\u0cbf\u0c95\u0cc6\u0caf \u0ca8\u0cbf\u0cb0\u0c82\u0ca4\u0cb0 \u0cb8\u0cc1\u0ca7\u0cbe\u0cb0\u0ca3\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cbe\u0ca4\u0ccd\u0cae\u0c95\u0ca4\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0caa\u0ca1\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.',ques19:"\u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cc1 \u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb9\u0cc7\u0c97\u0cc6 \u0cb8\u0cc8\u0ca8\u0ccd \u0c85\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0cb8\u0cc8\u0ca8\u0ccd \u0c87\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",ans19:"\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cc7\u0cb0\u0cbf \u0caa\u0cc6\u0cb9\u0ccd\u0c9a\u0cbe\u0ca8\u0ccd (\u0ca8\u0ccd\u0caf\u0cbe\u0cb7\u0ca8\u0cb2\u0ccd \u0cb8\u0cbf\u0c82\u0c97\u0cb2\u0ccd \u0cb8\u0cc8\u0ca8\u0ccd-\u0c86\u0ca8\u0ccd) \u0ca8\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb8\u0c82\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6, \u0c87\u0ca6\u0cc1 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cbf\u0c97\u0cc6 \u0ca4\u0cae\u0ccd\u0cae \u0cae\u0cc7\u0cb0\u0cbf \u0caa\u0cc6\u0cb9\u0ccd\u0c9a\u0cbe\u0ca8\u0ccd \u0cb0\u0cc1\u0c9c\u0cc1\u0cb5\u0cbe\u0ca4\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cc1 \u0cb8\u0cc8\u0ca8\u0ccd \u0c85\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0cb8\u0cc8\u0ca8\u0ccd \u0c87\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c85\u0ca8\u0cc1\u0cb5\u0cc1 \u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cc1 \u0cb8\u0cc8\u0ca8\u0ccd \u0c87\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0ca6\u0cc6\u0caf\u0cc7 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0ccd\u0cb0\u0ccc\u0cb8\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c86\u0ca6\u0cbe\u0c97\u0ccd\u0caf\u0cc2, \u0cb8\u0cc8\u0ca8\u0ccd \u0c87\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cc1\u0ca6\u0cb0\u0cbf\u0c82\u0ca6 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cc1 \u0ca4\u0cae\u0ccd\u0cae \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c89\u0cb3\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1, \u0cac\u0cc1\u0c95\u0ccd\u0cae\u0cbe\u0cb0\u0ccd\u0c95\u0ccd \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0cb5\u0cb0\u0cc1 \u0c89\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3 \u0c86\u0ca7\u0cbe\u0cb0\u0ca6 \u0cae\u0cc7\u0cb2\u0cc6 \u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb6\u0cbf\u0cab\u0cbe\u0cb0\u0cb8\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",ques20:"\u0cae\u0cc8 \u0cb8\u0ccd\u0c95\u0cc0\u0cae\u0ccd \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cbe\u0ca8\u0cc1 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",ans20:"\u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0c95\u0cc0\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd\u0c97\u0cb3 \u0cae\u0cc2\u0cb2\u0c95 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbe\u0c9f, \u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb6\u0cbf\u0cab\u0cbe\u0cb0\u0cb8\u0cc1\u0c97\u0cb3\u0cc1, \u0cb0\u0cbe\u0c9c\u0ccd\u0caf/\u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0cbe\u0ca1\u0cb3\u0cbf\u0ca4 \u0caa\u0ccd\u0cb0\u0ca6\u0cc7\u0cb6 \u0c85\u0ca5\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0ca6 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0c97\u0cb3 \u0cab\u0cbf\u0cb2\u0ccd\u0c9f\u0cb0\u0cbf\u0c82\u0c97\u0ccd, \u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf \u0cb2\u0cbe\u0cad\u0ca6 \u0cb5\u0cb0\u0ccd\u0c97\u0c97\u0cb3 \u0cae\u0cc2\u0cb2\u0c95 \u0cac\u0ccd\u0cb0\u0ccc\u0cb8\u0cbf\u0c82\u0c97\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cbe\u0cb0\u0ccd\u0c97\u