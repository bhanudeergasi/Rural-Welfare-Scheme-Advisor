1\u0631\u06cc\u0648\u06ba \u06a9\u06cc \u0632\u0646\u062f\u06af\u06cc \u06a9\u0648 \u0622\u0633\u0627\u0646 \u0628\u0646\u0627\u0646\u0627 \u06c1\u06d2\u06d4",mission:"\u06c1\u0645\u0627\u0631\u0627 \u0645\u0634\u0646",mission1:"\u06c1\u0645\u0627\u0631\u0627 \u0645\u0634\u0646 \u0633\u0631\u06a9\u0627\u0631\u06cc \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u0627\u0648\u0631 \u0641\u0648\u0627\u0626\u062f \u06a9\u06d2 \u0644\u06cc\u06d2 \u062d\u06a9\u0648\u0645\u062a-\u0635\u0627\u0631\u0641 \u0627\u0646\u0679\u0631\u0641\u06cc\u0633 \u06a9\u0648 \u06c1\u0645\u0648\u0627\u0631 \u06a9\u0631\u0646\u0627 \u06c1\u06d2\u06d4",mission2:"\u0633\u0631\u06a9\u0627\u0631\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u06d2 \u0627\u0648\u0631 \u0627\u0633 \u0633\u06d2 \u0641\u0627\u0626\u062f\u06c1 \u0627\u0679\u06be\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0631\u06a9\u0627\u0631 \u0648\u0642\u062a \u0627\u0648\u0631 \u06a9\u0648\u0634\u0634 \u06a9\u0648 \u06a9\u0645 \u06a9\u0631\u06cc\u06ba\u06d4",aboutPageDesc1:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0627\u0644\u06cc\u06a9\u0679\u0631\u0627\u0646\u06a9\u0633 \u0627\u0648\u0631 \u0627\u0646\u0641\u0627\u0631\u0645\u06cc\u0634\u0646 \u0679\u06cc\u06a9\u0646\u0627\u0644\u0648\u062c\u06cc \u06a9\u06cc \u0648\u0632\u0627\u0631\u062a (\u0627\u06cc\u0645 \u0627\u06cc \u0622\u0626\u06cc \u0679\u06cc \u0648\u0627\u0626\u06cc)\u060c \u0627\u0646\u062a\u0638\u0627\u0645\u06cc \u0627\u0635\u0644\u0627\u062d\u0627\u062a \u0627\u0648\u0631 \u0639\u0648\u0627\u0645\u06cc \u0634\u06a9\u0627\u06cc\u0627\u062a \u06a9\u06d2 \u0645\u062d\u06a9\u0645\u06d2 (\u0688\u06cc \u0627\u06d2 \u0622\u0631 \u067e\u06cc \u062c\u06cc) \u06a9\u06d2 \u062a\u0639\u0627\u0648\u0646 \u0633\u06d2 \u0627\u0648\u0631 \u062f\u06cc\u06af\u0631 \u0645\u0631\u06a9\u0632\u06cc \u0627\u0648\u0631 \u0631\u06cc\u0627\u0633\u062a\u06cc \u0648\u0632\u0627\u0631\u062a\u0648\u06ba/\u0645\u062d\u06a9\u0645\u0648\u06ba \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0634\u0631\u0627\u06a9\u062a \u0645\u06cc\u06ba \u0646\u06cc\u0634\u0646\u0644 \u0627\u06cc-\u06af\u0648\u0631\u0646\u0646\u0633 \u0688\u0648\u06cc\u0698\u0646 (\u0627\u06cc\u0646 \u0627\u06cc \u062c\u06cc \u0688\u06cc) \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u062a\u06cc\u0627\u0631\u060c \u0645\u0646\u0638\u0645 \u0627\u0648\u0631 \u0686\u0644\u0627\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u06d4",eligibilityCheckHead:"\u0627\u06c1\u0644\u06cc\u062a \u06a9\u06cc \u062c\u0627\u0646\u0686",eligibilityCheckDesc:"\u0622\u067e \u0645\u062e\u062a\u0644\u0641 \u0645\u0639\u06cc\u0627\u0631\u0627\u062a \u0627\u0648\u0631 \u0630\u0627\u062a\u06cc \u0635\u0641\u0627\u062a \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u0648\u0626\u06d2 \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u067e\u0646\u06cc \u0627\u06c1\u0644\u06cc\u062a \u06a9\u06cc \u062c\u0627\u0646\u0686 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",schemeFinderHead:"\u0627\u0633\u06a9\u06cc\u0645 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u06d2 \u0648\u0627\u0644\u0627",schemeFinderDesc:"\u0645\u062e\u062a\u0644\u0641 \u0633\u0631\u06a9\u0627\u0631\u06cc \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u0641\u0644\u0679\u0631 \u067e\u0631 \u0645\u0628\u0646\u06cc \u0688\u0631\u0644 \u0688\u0627\u0624\u0646 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u062a\u06cc\u0632 \u0627\u0648\u0631 \u0622\u0633\u0627\u0646 \u062a\u0644\u0627\u0634",schemeInDetailHead:"\u062a\u0641\u0635\u06cc\u0644 \u0633\u06d2 \u0627\u0633\u06a9\u06cc\u0645",schemeInDetailDesc:"\u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062f\u06cc\u0646\u06d2 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0639\u0645\u062f\u06c1 \u0627\u0646\u0627\u062c \u0648\u0627\u0644\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u0648\u0642\u0641 \u0634\u062f\u06c1 \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06d2 \u0635\u0641\u062d\u0627\u062a \u067e\u0631 \u06af\u06c1\u0631\u06cc \u063a\u0648\u0637\u06c1 \u0644\u06af\u0627\u0626\u06cc\u06ba",documentRequired:"\u0645\u0637\u0644\u0648\u0628\u06c1 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a",faqHead:"\u0627\u06a9\u062b\u0631 \u067e\u0648\u0686\u06be\u06d2 \u06af\u0626\u06d2 \u0633\u0648\u0627\u0644\u0627\u062a",faqSubHead1:"\u0627\u067e\u0646\u06d2 \u06a9\u0686\u06be \u062c\u0648\u0627\u0628\u0627\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u06c1\u0645\u0627\u0631\u06cc \u0639\u0644\u0645\u06cc \u0628\u0646\u06cc\u0627\u062f \u06a9\u0648 \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba!",ques1:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06cc\u0627 \u06c1\u06d2\u060c \u0627\u0648\u0631 \u06cc\u06c1 \u062f\u06cc\u06af\u0631 \u0633\u0631\u06a9\u0627\u0631\u06cc \u067e\u0648\u0631\u0679\u0644\u0632 \u0633\u06d2 \u06a9\u06cc\u0633\u06d2 \u0645\u062e\u062a\u0644\u0641 \u06c1\u06d2\u061f",ans1:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0645\u0631\u06a9\u0632\u06cc \u0627\u0648\u0631 \u0631\u06cc\u0627\u0633\u062a\u06cc/\u0645\u0631\u06a9\u0632 \u06a9\u06d2 \u0632\u06cc\u0631 \u0627\u0646\u062a\u0638\u0627\u0645 \u0639\u0644\u0627\u0642\u0648\u06ba \u06a9\u06cc \u062f\u0648\u0646\u0648\u06ba \u062d\u06a9\u0648\u0645\u062a\u0648\u06ba \u0633\u06d2 \u0645\u062e\u062a\u0644\u0641 \u0642\u0633\u0645 \u06a9\u06cc \u0633\u0631\u06a9\u0627\u0631\u06cc \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc\u06a9 \u0642\u0648\u0645\u06cc \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u06c1\u06d2\u06d4 \u06cc\u06c1 \u0622\u0628\u0627\u062f\u06cc\u0627\u062a\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u067e\u0631 \u0645\u0628\u0646\u06cc \u0633\u0631\u06a9\u0627\u0631\u06cc \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u06cc \u062a\u0644\u0627\u0634 \u0627\u0648\u0631 \u062f\u0631\u06cc\u0627\u0641\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc\u06a9 \u0648\u0646 \u0627\u0633\u0679\u0627\u067e \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u06c1\u06d2\u06d4 \u0631\u0648\u0627\u06cc\u062a\u06cc \u0633\u0631\u06a9\u0627\u0631\u06cc \u067e\u0648\u0631\u0679\u0644\u0632 \u06a9\u06d2 \u0628\u0631\u0639\u06a9\u0633\u060c \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0645\u0631\u06a9\u0632\u06cc \u062d\u06a9\u0648\u0645\u062a\u060c \u0631\u06cc\u0627\u0633\u062a\u06cc \u062d\u06a9\u0648\u0645\u062a\u0648\u06ba \u0627\u0648\u0631 \u0645\u0631\u06a9\u0632 \u06a9\u06d2 \u0632\u06cc\u0631 \u0627\u0646\u062a\u0638\u0627\u0645 \u0639\u0644\u0627\u0642\u0648\u06ba \u06a9\u06cc \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u0648 \u0627\u06cc\u06a9 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u067e\u0631 \u0644\u0627\u062a\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u0627\u0646 \u06a9\u06cc \u0627\u06c1\u0644\u06cc\u062a \u06a9\u06cc \u0628\u0646\u06cc\u0627\u062f \u067e\u0631 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0627\u0633\u06a9\u06cc\u0645\u06cc\u06ba \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u06d2 \u0645\u06cc\u06ba \u0645\u062f\u062f \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4",ques2:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0639\u0627\u0645 \u0634\u06c1\u0631\u06cc\u0648\u06ba \u06a9\u06cc \u06a9\u0633 \u0637\u0631\u062d \u0645\u062f\u062f \u06a9\u0631\u06d2 \u06af\u06cc\u061f",ans2:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0634\u06c1\u0631\u06cc\u0648\u06ba \u06a9\u0648 \u0627\u06cc\u06a9 \u062c\u06af\u06c1 \u067e\u0631 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u0648 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0642\u0627\u0628\u0644 \u0628\u0646\u0627 \u06a9\u0631 \u0633\u0631\u06a9\u0627\u0631\u06cc \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc \u06a9\u0648 \u0622\u0633\u0627\u0646 \u0628\u0646\u0627\u062a\u0627 \u06c1\u06d2\u060c \u0645\u062a\u0639\u062f\u062f \u0645\u062d\u06a9\u0645\u06c1 \u062c\u0627\u062a\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679\u0648\u06ba \u067e\u0631 \u062c\u0627\u0646\u06d2 \u06cc\u0627 \u0627\u0646 \u06a9\u06cc \u0627\u06c1\u0644\u06cc\u062a \u06a9\u06cc \u062c\u0627\u0646\u0686 \u067e\u0691\u062a\u0627\u0644 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06d2 \u0648\u0633\u06cc\u0639 \u0631\u06c1\u0646\u0645\u0627 \u0627\u0635\u0648\u0644\u0648\u06ba \u06a9\u0627 \u062c\u0627\u0626\u0632\u06c1 \u0644\u06cc\u0646\u06d2 \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u06a9\u0648 \u062e\u062a\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4",ques3:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06cc\u0633\u06d2 \u06a9\u0627\u0645 \u06a9\u0631\u062a\u06cc \u06c1\u06d2\u061f",ans3:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0634\u06c1\u0631\u06cc\u0648\u06ba \u06a9\u0648 \u0633\u0631\u06a9\u0627\u0631\u06cc \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u0648 \u062f\u0631\u06cc\u0627\u0641\u062a \u06a9\u0631\u0646\u06d2 \u0645\u06cc\u06ba \u0645\u062f\u062f \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc\u06a9 \u0633\u0627\u062f\u06c1 \u0627\u0648\u0631 \u0635\u0627\u0631\u0641 \u062f\u0648\u0633\u062a \u062a\u06cc\u0646 \u0645\u0631\u0627\u062d\u0644 \u06a9\u06d2 \u0639\u0645\u0644 \u067e\u0631 \u0639\u0645\u0644 \u06a9\u0631\u062a\u0627 \u06c1\u06d2 \u062c\u0633 \u06a9\u06d2 \u0648\u06c1 \u0627\u06c1\u0644 \u06c1\u06cc\u06ba: \u0645\u0631\u062d\u0644\u06c1 1: \u0635\u0627\u0631\u0641 \u0628\u0646\u06cc\u0627\u062f\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u062c\u06cc\u0633\u06d2 \u0622\u0628\u0627\u062f\u06cc\u0627\u062a\u06cc\u060c \u0622\u0645\u062f\u0646\u06cc\u060c \u0633\u0645\u0627\u062c\u06cc \u0632\u0645\u0631\u06c1 \u0648\u063a\u06cc\u0631\u06c1 \u062f\u0631\u062c \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u0645\u0631\u062d\u0644\u06c1 2: \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062f\u06c1 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u06cc \u0628\u0646\u06cc\u0627\u062f \u067e\u0631\u060c \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0635\u0627\u0631\u0641 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0633\u06cc\u0646\u06a9\u0691\u0648\u06ba \u0633\u0631\u06a9\u0627\u0631\u06cc \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u0633\u06d2 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u0648 \u062f\u06a9\u06be\u0627\u062a\u0627 \u06c1\u06d2\u06d4 \u0645\u0631\u062d\u0644\u06c1 3: \u0635\u0627\u0631\u0641 \u0627\u06c1\u0644 \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u06cc \u0641\u06c1\u0631\u0633\u062a \u0645\u06cc\u06ba \u0633\u06d2 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u062a\u0641\u0635\u06cc\u0644\u06cc \u0639\u0644\u0645\u060c \u0639\u0645\u0648\u0645\u06cc \u0633\u0648\u0627\u0644\u0627\u062a\u060c \u0627\u0648\u0631 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u06d2 \u0639\u0645\u0644 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0648\u0642\u0641 \u0634\u062f\u06c1 \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06d2 \u0635\u0641\u062d\u06c1 \u0633\u06d2 \u0645\u0632\u06cc\u062f \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062d\u0627\u0635\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062f\u06cc\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u062a\u0639\u0644\u0642\u06c1 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u06d2 \u06cc\u0648 \u0622\u0631 \u0627\u06cc\u0644 \u067e\u0631 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4",ques4:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u067e\u0631 \u0635\u062d\u06cc\u062d \u0627\u0633\u06a9\u06cc\u0645 \u062c\u0627\u0646\u0646\u06d2 \u06a9\u0627 \u0637\u0631\u06cc\u0642\u06c1 \u06a9\u0627\u0631 \u06a9\u06cc\u0627 \u06c1\u06d2\u061f",ans4:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u067e\u0631 \u0635\u062d\u06cc\u062d \u0627\u0633\u06a9\u06cc\u0645 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0634\u06c1\u0631\u06cc \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u06a9\u06cc \u0633\u0631\u06a9\u0627\u0631\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679 \u067e\u0631 \u062c\u0627 \u06a9\u0631 \u0634\u0631\u0648\u0639\u0627\u062a \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06c1\u0648\u0645 \u067e\u06cc\u062c \u067e\u0631 \u0627\u06cc\u06a9 \u0628\u0627\u0631\u060c \u0627\u0646\u06c1\u06cc\u06ba '\u0622\u067e \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633\u06a9\u06cc\u0645\u06cc\u06ba \u062a\u0644\u0627\u0634 \u06a9\u0631\u06cc\u06ba' \u0641\u06cc\u0686\u0631 \u0645\u0644\u06d2 \u06af\u0627\u060c \u062c\u0648 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u0627\u067e\u0646\u06cc \u0622\u0628\u0627\u062f\u06cc\u0627\u062a\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a\u060c \u062c\u06cc\u0633\u06d2 \u0639\u0645\u0631\u060c \u062c\u0646\u0633\u060c \u0622\u0645\u062f\u0646\u06cc \u06a9\u06cc \u0633\u0637\u062d\u060c \u0632\u0645\u0631\u06c1 \u0648\u063a\u06cc\u0631\u06c1 \u062f\u0631\u062c \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a \u062f\u06cc\u062a\u0627 \u06c1\u06d2\u06d4 \u0627\u06cc\u06a9 \u0628\u0627\u0631 \u06cc\u06c1 \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u062c\u0645\u0639 \u06a9\u0631\u0648\u0627\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f\u060c \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0635\u0627\u0631\u0641 \u06a9\u06d2 \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u06a9\u06cc \u0628\u0646\u06cc\u0627\u062f \u067e\u0631 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u06cc \u0641\u06c1\u0631\u0633\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u06d2 \u06af\u0627\u06d4",ques5:"\u0645\u062c\u06be\u06d2 \u0627\u067e\u0646\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0631 \u06a9\u0633\u06cc \u062e\u0627\u0635 \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u06a9\u06cc\u0627 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u0644 \u0633\u06a9\u062a\u06cc \u06c1\u06cc\u06ba\u061f",ans5:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u06c1\u0631 \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u062c\u0627\u0645\u0639 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u060c \u062c\u0633 \u0645\u06cc\u06ba \u0627\u06c1\u0644\u06cc\u062a \u06a9\u06d2 \u0645\u0639\u06cc\u0627\u0631\u060c \u067e\u06cc\u0634 \u06a9\u0631\u062f\u06c1 \u0641\u0648\u0627\u0626\u062f\u060c \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u06d2 \u0637\u0631\u06cc\u0642\u06c1 \u06a9\u0627\u0631 \u0627\u0648\u0631 \u0627\u0633\u06a9\u06cc\u0645 \u0633\u06d2 \u0641\u0627\u0626\u062f\u06c1 \u0627\u0679\u06be\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0631\u06a9\u0627\u0631 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u0634\u0627\u0645\u0644 \u06c1\u06cc\u06ba\u06d4 \u0627\u0633 \u0645\u06cc\u06ba \u0627\u0633\u06a9\u06cc\u0645 \u0633\u06d2 \u0645\u062a\u0639\u0644\u0642 \u0639\u0627\u0645 \u0633\u0648\u0627\u0644\u0627\u062a \u06a9\u0648 \u062d\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc\u06a9 \u0648\u0642\u0641 \u0634\u062f\u06c1 \u0627\u06a9\u062b\u0631 \u067e\u0648\u0686\u06be\u06d2 \u062c\u0627\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0633\u0648\u0627\u0644\u0627\u062a (\u0627\u06cc\u0641 \u0627\u06d2 \u06a9\u06cc\u0648) \u0633\u06cc\u06a9\u0634\u0646 \u0628\u06be\u06cc \u0634\u0627\u0645\u0644 \u06c1\u06d2\u06d4",ques6:"\u0648\u06c1 \u06a9\u0648\u0646 \u0633\u06d2 \u0648\u0633\u06cc\u0639 \u0632\u0645\u0631\u06d2 \u06c1\u06cc\u06ba \u062c\u0646 \u06a9\u06d2 \u062a\u062d\u062a \u0627\u0633\u06a9\u06cc\u0645\u06cc\u06ba \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0631 \u062f\u0633\u062a\u06cc\u0627\u0628 \u06c1\u06cc\u06ba\u061f",ans6:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u067e\u0631 \u062f\u0633\u062a\u06cc\u0627\u0628 \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u0648 \u0627\u0646 \u06a9\u06d2 \u0641\u0648\u0627\u0626\u062f \u06a9\u06cc \u0646\u0648\u0639\u06cc\u062a \u0627\u0648\u0631 \u06c1\u062f\u0641 \u0633\u06d2 \u0645\u0633\u062a\u0641\u06cc\u062f \u06c1\u0648\u0646\u06d2 \u0648\u0627\u0644\u0648\u06ba \u06a9\u06cc \u0628\u0646\u06cc\u0627\u062f \u067e\u0631 15 \u0632\u0645\u0631\u0648\u06ba \u0645\u06cc\u06ba \u062a\u0642\u0633\u06cc\u0645 \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4 \u0627\u0646 \u0632\u0645\u0631\u0648\u06ba \u0645\u06cc\u06ba \u0632\u0631\u0627\u0639\u062a\u060c \u062f\u06cc\u06c1\u06cc \u0627\u0648\u0631 \u0645\u0627\u062d\u0648\u0644\u06cc\u0627\u062a \u061b \u0628\u06cc\u0646\u06a9\u0646\u06af\u060c \u0645\u0627\u0644\u06cc\u0627\u062a\u06cc \u062e\u062f\u0645\u0627\u062a \u0627\u0648\u0631 \u0628\u06cc\u0645\u06c1 \u061b \u06a9\u0627\u0631\u0648\u0628\u0627\u0631 \u0627\u0648\u0631 \u0635\u0646\u0639\u062a \u06a9\u0627\u0631\u06cc \u061b \u062a\u0639\u0644\u06cc\u0645 \u0627\u0648\u0631 \u0633\u06cc\u06a9\u06be\u0646\u0627 \u061b \u0635\u062d\u062a \u0627\u0648\u0631 \u062a\u0646\u062f\u0631\u0633\u062a\u06cc \u061b \u0631\u06c1\u0627\u0626\u0634 \u0627\u0648\u0631 \u067e\u0646\u0627\u06c1 \u06af\u0627\u06c1 \u061b \u0639\u0648\u0627\u0645\u06cc \u062a\u062d\u0641\u0638\u060c \u0642\u0627\u0646\u0648\u0646 \u0627\u0648\u0631 \u0627\u0646\u0635\u0627\u0641 \u061b \u0633\u0627\u0626\u0646\u0633\u060c \u0622\u0626\u06cc \u0679\u06cc \u0627\u0648\u0631 \u0645\u0648\u0627\u0635\u0644\u0627\u062a \u061b \u06c1\u0646\u0631 \u0627\u0648\u0631 \u0631\u0648\u0632\u06af\u0627\u0631 \u061b \u0633\u0645\u0627\u062c\u06cc \u0628\u06c1\u0628\u0648\u062f \u0627\u0648\u0631 \u0628\u0627\u0627\u062e\u062a\u06cc\u0627\u0631 \u0628\u0646\u0627\u0646\u0627 \u061b \u06a9\u06be\u06cc\u0644 \u0627\u0648\u0631 \u062b\u0642\u0627\u0641\u062a \u061b \u0646\u0642\u0644 \u0648 \u062d\u0645\u0644 \u0627\u0648\u0631 \u0628\u0646\u06cc\u0627\u062f\u06cc \u0688\u06be\u0627\u0646\u0686\u06c1 \u061b \u0633\u0641\u0631 \u0627\u0648\u0631 \u0633\u06cc\u0627\u062d\u062a \u061b \u0627\u0641\u0627\u062f\u06cc\u062a \u0627\u0648\u0631 \u0635\u0641\u0627\u0626\u06cc \u0633\u062a\u06be\u0631\u0627\u0626\u06cc \u061b \u0627\u0648\u0631 \u062e\u0648\u0627\u062a\u06cc\u0646 \u0627\u0648\u0631 \u0628\u0686\u06d2 \u0634\u0627\u0645\u0644 \u06c1\u06cc\u06ba\u06d4",ques7:"\u06a9\u06cc\u0627 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u06a9\u062b\u06cc\u0631 \u0644\u0633\u0627\u0646\u06cc \u0645\u062f\u062f \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u061f",ans7:"\u062c\u06cc \u06c1\u0627\u06ba\u060c \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0641\u06cc \u0627\u0644\u062d\u0627\u0644 \u0627\u0646\u06af\u0631\u06cc\u0632\u06cc \u0633\u0645\u06cc\u062a 15 \u0632\u0628\u0627\u0646\u0648\u06ba \u0645\u06cc\u06ba \u0645\u0648\u0627\u062f \u06a9\u06cc \u062d\u0645\u0627\u06cc\u062a \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u0627\u0636\u0627\u0641\u06cc \u06c1\u0646\u062f\u0648\u0633\u062a\u0627\u0646\u06cc \u0632\u0628\u0627\u0646\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u0633\u067e\u0648\u0631\u0679 \u062c\u0644\u062f \u06c1\u06cc \u0641\u0631\u0627\u06c1\u0645 \u06a9\u06cc \u062c\u0627\u0626\u06d2 \u06af\u06cc\u06d4",ques8:"\u06a9\u06cc\u0627 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0645\u0631\u06a9\u0632\u06cc \u0627\u0648\u0631 \u0631\u06cc\u0627\u0633\u062a/\u0645\u0631\u06a9\u0632 \u06a9\u06d2 \u0632\u06cc\u0631 \u0627\u0646\u062a\u0638\u0627\u0645 \u0639\u0644\u0627\u0642\u0648\u06ba \u06a9\u06cc \u0645\u062e\u0635\u0648\u0635 \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u0648 \u0638\u0627\u06c1\u0631 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u061f",ans8:"\u062c\u06cc \u06c1\u0627\u06ba\u060c \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0641\u06cc \u0627\u0644\u062d\u0627\u0644 4,700 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u0645\u0631\u06a9\u0632\u06cc \u062d\u06a9\u0648\u0645\u062a \u0627\u0648\u0631 \u0631\u06cc\u0627\u0633\u062a\u06cc/\u0645\u0631\u06a9\u0632 \u06a9\u06d2 \u0632\u06cc\u0631 \u0627\u0646\u062a\u0638\u0627\u0645 \u0639\u0644\u0627\u0642\u0648\u06ba \u06a9\u06cc \u062d\u06a9\u0648\u0645\u062a \u06a9\u06cc \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u0627\u0636\u0627\u0641\u06cc \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u0648 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u067e\u0631 \u0645\u0633\u0644\u0633\u0644 \u062c\u0627\u0631\u06cc \u0631\u06a9\u06be\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4",ques9:"\u0645\u062c\u06be\u06d2 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u067e\u0631 \u06a9\u0648\u0626\u06cc \u0645\u062e\u0635\u0648\u0635 \u0627\u0633\u06a9\u06cc\u0645 \u0646\u06c1\u06cc\u06ba \u0645\u0644 \u0633\u06a9\u06cc\u06d4 \u0645\u062c\u06be\u06d2 \u06a9\u06cc\u0627 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2\u061f",ans9:'\u0641\u06cc \u0627\u0644\u062d\u0627\u0644 \u0645\u0631\u06a9\u0632\u06cc \u062d\u06a9\u0648\u0645\u062a \u0627\u0648\u0631 \u0631\u06cc\u0627\u0633\u062a\u06cc/\u0645\u0631\u06a9\u0632 \u06a9\u06d2 \u0632\u06cc\u0631 \u0627\u0646\u062a\u0638\u0627\u0645 \u0639\u0644\u0627\u0642\u0648\u06ba \u06a9\u06cc 4,700 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u0648 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u067e\u0631 \u0634\u0627\u0645\u0644 \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4 \u0627\u0636\u0627\u0641\u06cc \u0627\u0633\u06a9\u06cc\u0645\u06cc\u06ba \u0628\u0627\u0642\u0627\u0639\u062f\u06af\u06cc \u0633\u06d2 \u0634\u0627\u0645\u0644 \u06a9\u06cc \u062c\u0627 \u0631\u06c1\u06cc \u06c1\u06cc\u06ba\u06d4 \u0634\u06c1\u0631\u06cc \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u067e\u0631 \u062f\u0633\u062a\u06cc\u0627\u0628 "\u06af\u06cc\u0679 \u0627\u0646 \u0679\u0686" \u0633\u06cc\u06a9\u0634\u0646 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u06af\u0645\u0634\u062f\u06c1 \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u06cc\u0627 \u062a\u062c\u0627\u0648\u06cc\u0632 \u0634\u06cc\u0626\u0631 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4',ques10:"\u0645\u062c\u06be\u06d2 \u0645\u0631\u0627\u0679\u06be\u06cc \u0632\u0628\u0627\u0646 \u0645\u06cc\u06ba \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u06d2 \u0645\u0648\u0627\u062f \u0645\u06cc\u06ba \u06a9\u0686\u06be \u063a\u0644\u0637\u06cc\u0627\u06ba \u0646\u0638\u0631 \u0622\u0626\u06cc\u06ba\u06d4 \u0645\u062c\u06be\u06d2 \u06a9\u06cc\u0627 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2\u061f",ans10:"\u0627\u06af\u0631 \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06d2 \u0645\u0648\u0627\u062f \u06a9\u06d2 \u0645\u0631\u0627\u0679\u06be\u06cc \u0648\u0631\u0698\u0646 \u0645\u06cc\u06ba \u06a9\u0648\u0626\u06cc \u062a\u0636\u0627\u062f \u0646\u0638\u0631 \u0622\u062a\u0627 \u06c1\u06d2 \u062a\u0648 \u0634\u06c1\u0631\u06cc\u0648\u06ba \u06a9\u0648 \u0645\u0634\u0648\u0631\u06c1 \u062f\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0648\u06c1 \u0648\u0636\u0627\u062d\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0646\u06af\u0631\u06cc\u0632\u06cc \u0648\u0631\u0698\u0646 \u06a9\u0627 \u062d\u0648\u0627\u0644\u06c1 \u062f\u06cc\u06ba\u06d4 \u0627\u06af\u0631 \u0645\u0633\u0626\u0644\u06c1 \u0628\u0631\u0642\u0631\u0627\u0631 \u0631\u06c1\u062a\u0627 \u06c1\u06d2 \u062a\u0648 \u0627\u0646\u062a\u06c1\u0627\u0626\u06cc \u062f\u0631\u0633\u062a \u0627\u0648\u0631 \u062a\u0627\u0632\u06c1 \u062a\u0631\u06cc\u0646 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0648\u0632\u0627\u0631\u062a \u06cc\u0627 \u0645\u062d\u06a9\u0645\u06c1 \u06a9\u06d2 \u0633\u0631\u06a9\u0627\u0631\u06cc \u067e\u0648\u0631\u0679\u0644 \u06a9\u0627 \u062d\u0648\u0627\u0644\u06c1 \u062f\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u0645\u0632\u06cc\u062f \u0628\u0631\u0622\u06ba\u060c support-myscheme[at]digitalindia[dot]gov[dot]in \u067e\u0631 \u0627\u06cc \u0645\u06cc\u0644 \u0628\u06be\u06cc\u062c \u06a9\u0631 \u0627\u0633 \u0645\u0633\u0626\u0644\u06d2 \u06a9\u06cc \u0627\u0637\u0644\u0627\u0639 \u062f\u06cc \u062c\u0627 \u0633\u06a9\u062a\u06cc \u06c1\u06d2\u06d4",ques11:"\u0645\u06cc\u06ba \u0627\u0646 \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u0648 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u062a\u0627 \u06c1\u0648\u06ba \u062c\u0646 \u06a9\u06d2 \u062a\u062d\u062a \u0637\u0644\u0628\u0627\u0621 \u06a9\u0648 \u0648\u0638\u0627\u0626\u0641 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u06cc\u06d2 \u062c\u0627\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06a9\u06cc\u0627 \u06cc\u06c1 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0645\u0645\u06a9\u0646 \u06c1\u06d2\u061f",ans11:"\u062c\u06cc \u06c1\u0627\u06ba\u060c \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0645\u0637\u0644\u0648\u0628\u06c1 \u0627\u0644\u0641\u0627\u0638 \u067e\u0631 \u0645\u0628\u0646\u06cc \u0633\u0631\u0686 \u0641\u06cc\u0686\u0631 \u067e\u06cc\u0634 \u06a9\u0631\u062a\u0627 \u06c1\u06d2 \u062c\u0648 \u0634\u06c1\u0631\u06cc\u0648\u06ba \u06a9\u0648 \u0637\u0644\u0628\u0627\u0621 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633\u06a9\u0627\u0644\u0631\u0634\u067e \u0633\u0645\u06cc\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062f\u06c1 \u0641\u0648\u0627\u0626\u062f \u06a9\u06cc \u0642\u0633\u0645 \u0627\u0648\u0631 \u062d\u062f \u06a9\u06cc \u0628\u0646\u06cc\u0627\u062f \u067e\u0631 \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u0648 \u0622\u0633\u0627\u0646\u06cc \u0633\u06d2 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u06d2\u060c \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u06d2 \u0627\u0648\u0631 \u0634\u0646\u0627\u062e\u062a \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0642\u0627\u0628\u0644 \u0628\u0646\u0627\u062a\u0627 \u06c1\u06d2\u06d4",ques12:"\u0645\u06cc\u06ba \u0627\u06cc\u06a9 \u0645\u062e\u0635\u0648\u0635 \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062f\u06cc\u0646\u0627 \u0686\u0627\u06c1\u062a\u0627 \u06c1\u0648\u06ba \u0627\u0648\u0631 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0631\u06a9\u0627\u0631 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u062c\u0627\u0646\u0646\u0627 \u0686\u0627\u06c1\u062a\u0627 \u06c1\u0648\u06ba\u06d4 \u06a9\u06cc\u0627 \u0645\u062c\u06be\u06d2 \u06cc\u06c1 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u06cc\u0631\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0631 \u0645\u0644 \u0633\u06a9\u062a\u06cc \u06c1\u06cc\u06ba\u061f",ans12:"\u062c\u06cc \u06c1\u0627\u06ba\u060c \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u06c1\u0631 \u0627\u0633\u06a9\u06cc\u0645 \u0645\u06cc\u06ba \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062f\u06cc\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0631\u06a9\u0627\u0631 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u06a9\u06cc \u0645\u06a9\u0645\u0644 \u0641\u06c1\u0631\u0633\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u060c \u062c\u0633 \u0633\u06d2 \u0634\u06c1\u0631\u06cc \u0622\u0633\u0627\u0646\u06cc \u0633\u06d2 \u062a\u06cc\u0627\u0631\u06cc \u0627\u0648\u0631 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062f\u06d2 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",ques13:"\u06a9\u06cc\u0627 \u0645\u06cc\u06ba \u0627\u067e\u0646\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062f\u06d2 \u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",ans13:"\u0641\u06cc \u0627\u0644\u062d\u0627\u0644\u060c \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0648\u0632\u0627\u0631\u062a \u06cc\u0627 \u0645\u062d\u06a9\u0645\u06c1 \u06a9\u06d2 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0627\u0633\u06a9\u06cc\u0645 \u0627\u06cc\u067e\u0644\u06cc \u06a9\u06cc\u0634\u0646 \u067e\u06cc\u062c \u067e\u0631 \u0631\u06cc \u0688\u0627\u0626\u0631\u06cc\u06a9\u0679 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u0622\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0645\u0631\u0627\u062d\u0644 \u0645\u06cc\u06ba \u06cc\u06c1 \u062a\u0635\u0648\u0631 \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0634\u06c1\u0631\u06cc \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0648\u0631\u0679\u0644/\u0627\u0645\u0646\u06af \u0627\u06cc\u067e\u0644\u06cc \u06a9\u06cc\u0634\u0646 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062f\u06d2 \u0633\u06a9\u06cc\u06ba \u06af\u06d2\u06d4",ques14:'\u06a9\u0633\u06cc \u0635\u0627\u0631\u0641 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0628\u06c1\u062a\u0631\u06cc\u0646 \u0645\u0648\u0632\u0648\u06ba \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u0648 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06d2 "\u067e\u0631\u0633\u0646\u0644\u0627\u0626\u0632\u0688 \u0633\u0631\u0686" \u0641\u06cc\u0686\u0631 \u0645\u06cc\u06ba \u06a9\u0648\u0646 \u0633\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u06c1\u06d2\u061f',ans14:'\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06d2 "\u067e\u0631\u0633\u0646\u0644\u0627\u0626\u0632\u0688 \u0633\u0631\u0686" \u0641\u06cc\u0686\u0631 \u06a9\u0648 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u0628\u0646\u06cc\u0627\u062f\u06cc \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u062c\u06cc\u0633\u06d2 \u062c\u0646\u0633\u060c \u0639\u0645\u0631\u060c \u0627\u0632\u062f\u0648\u0627\u062c\u06cc \u062d\u06cc\u062b\u06cc\u062a\u060c \u0631\u06cc\u0627\u0633\u062a\u060c \u0631\u06c1\u0627\u0626\u0634 \u06a9\u06cc \u062c\u06af\u06c1 (\u0634\u06c1\u0631\u06cc \u06cc\u0627 \u062f\u06cc\u06c1\u06cc)\u060c \u0633\u0645\u0627\u062c\u06cc \u0632\u0645\u0631\u06c1\u060c \u0645\u0639\u0630\u0648\u0631\u06cc \u06a9\u06cc \u062d\u06cc\u062b\u06cc\u062a\u060c \u0627\u0642\u0644\u06cc\u062a\u06cc \u062d\u06cc\u062b\u06cc\u062a\u060c \u0631\u0648\u0632\u06af\u0627\u0631 \u06a9\u06cc \u062d\u06cc\u062b\u06cc\u062a\u060c \u0627\u0648\u0631 \u062f\u06cc\u06af\u0631 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u06c1\u06d2\u06d4 \u0627\u0633 \u0633\u06d2 \u0635\u0627\u0631\u0641 \u06a9\u06d2 \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0633\u0628 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u06cc \u0634\u0646\u0627\u062e\u062a \u06a9\u0631\u0646\u06d2 \u0645\u06cc\u06ba \u0645\u062f\u062f \u0645\u0644\u062a\u06cc \u06c1\u06d2\u06d4',ques15:'"\u0686\u06cc\u06a9 \u0627\u06cc\u0644\u06cc\u062c\u06cc\u0628\u0644\u0679\u06cc \u0633\u0648\u0627\u0644\u0646\u0627\u0645\u06c1" \u06a9\u06cc \u062e\u0635\u0648\u0635\u06cc\u062a \u06a9\u06cc\u0627 \u06c1\u06d2\u061f',ans15:'"\u0686\u06cc\u06a9 \u0627\u06cc\u0644\u06cc\u062c\u06cc\u0628\u0644\u0679\u06cc \u0633\u0648\u0627\u0644\u0646\u0627\u0645\u06c1" \u0641\u06cc\u0686\u0631 \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06d2 \u0645\u062e\u0635\u0648\u0635 \u0627\u06c1\u0644\u06cc\u062a \u06a9\u06d2 \u0645\u0639\u06cc\u0627\u0631 \u067e\u0631 \u0645\u0631\u06a9\u0648\u0632 \u06c1\u06d2 \u0627\u0648\u0631 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u0627\u06cc\u06a9 \u0633\u0627\u062f\u06c1 \u06c1\u0627\u06ba/\u0646\u06c1\u06cc\u06ba \u067e\u0631 \u0645\u0628\u0646\u06cc \u0633\u0648\u0627\u0644\u0646\u0627\u0645\u06d2 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0627\u067e\u0646\u06cc \u0627\u06c1\u0644\u06cc\u062a \u06a9\u06cc \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0642\u0627\u0628\u0644 \u0628\u0646\u0627\u062a\u0627 \u06c1\u06d2\u06d4 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062f\u06c1 \u062c\u0648\u0627\u0628\u0627\u062a \u06a9\u06cc \u0628\u0646\u06cc\u0627\u062f \u067e\u0631\u060c \u0635\u0627\u0631\u0641\u06cc\u0646 \u0641\u0648\u0631\u06cc \u0637\u0648\u0631 \u067e\u0631 \u0627\u0646\u062f\u0627\u0632\u06c1 \u0644\u06af\u0627 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0622\u06cc\u0627 \u0648\u06c1 \u06a9\u0633\u06cc \u062e\u0627\u0635 \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06d2 \u0627\u06c1\u0644 \u06c1\u06cc\u06ba \u06cc\u0627 \u0646\u06c1\u06cc\u06ba\u06d4',ques16:"\u06a9\u06cc\u0627 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0645\u06cc\u06ba \u0686\u06cc\u0679 \u0628\u0648\u0679 \u06a9\u06cc \u0633\u06c1\u0648\u0644\u062a \u06c1\u06d2\u060c \u0627\u0648\u0631 \u06cc\u06c1 \u0634\u06c1\u0631\u06cc\u0648\u06ba \u06a9\u06cc \u06a9\u0633 \u0637\u0631\u062d \u0645\u062f\u062f \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u061f",ans16:"\u062c\u06cc \u06c1\u0627\u06ba\u060c \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0646\u06d2 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0633\u0631\u06a9\u0627\u0631\u06cc \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u0648 \u062f\u0631\u06cc\u0627\u0641\u062a \u06a9\u0631\u0646\u06d2 \u0645\u06cc\u06ba \u0634\u06c1\u0631\u06cc\u0648\u06ba \u06a9\u06cc \u0645\u062f\u062f \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc\u06a9 \u0622\u0648\u0627\u0632 \u0633\u06d2 \u0686\u0644\u0646\u06d2 \u0648\u0627\u0644\u0627\u060c \u06a9\u062b\u06cc\u0631 \u0644\u0633\u0627\u0646\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u0633\u06d2 \u0686\u0644\u0646\u06d2 \u0648\u0627\u0644\u0627 \u0686\u06cc\u0679 \u0628\u0648\u0679 \u062a\u0639\u06cc\u0646\u0627\u062a \u06a9\u06cc\u0627 \u06c1\u06d2\u06d4 \u0686\u06cc\u0679 \u0628\u0648\u0679 \u0635\u0627\u0631\u0641 \u06a9\u06d2 \u0633\u0648\u0627\u0644\u0627\u062a \u06a9\u06d2 \u0630\u0627\u062a\u06cc \u0627\u0648\u0631 \u0641\u0648\u0631\u06cc \u062c\u0648\u0627\u0628\u0627\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u060c \u0628\u0627\u062a \u0686\u06cc\u062a \u06a9\u06cc \u0645\u062f\u062f \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06cc \u062f\u0631\u06cc\u0627\u0641\u062a \u06a9\u0648 \u0622\u0633\u0627\u0646 \u0628\u0646\u0627\u062a\u0627 \u06c1\u06d2\u060c \u0627\u0648\u0631 \u0627\u06cc\u06a9 \u062f\u0644\u06a9\u0634 \u0627\u0648\u0631 \u0635\u0627\u0631\u0641 \u062f\u0648\u0633\u062a \u062a\u062c\u0631\u0628\u06c1 \u067e\u06cc\u0634 \u06a9\u0631\u06a9\u06d2 \u062d\u06a9\u0648\u0645\u062a \u0627\u0648\u0631 \u0634\u06c1\u0631\u06cc\u0648\u06ba \u06a9\u06d2 \u062f\u0631\u0645\u06cc\u0627\u0646 \u0628\u0627\u062a \u0686\u06cc\u062a \u06a9\u0648 \u0628\u0691\u06be\u0627\u062a\u0627 \u06c1\u06d2\u06d4",ques17:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0631 \u0627\u06d2 \u0622\u0626\u06cc \u0686\u06cc\u0679 \u0628\u0648\u0679 \u06a9\u06cc \u06a9\u0644\u06cc\u062f\u06cc \u062e\u0635\u0648\u0635\u06cc\u0627\u062a \u06a9\u06cc\u0627 \u06c1\u06cc\u06ba\u061f",ans17:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0627\u06d2 \u0622\u0626\u06cc \u0686\u06cc\u0679 \u0628\u0648\u0679 \u0622\u0648\u0627\u0632 \u0627\u0648\u0631 \u0645\u062a\u0646 \u067e\u0631 \u0645\u0628\u0646\u06cc \u062a\u0639\u0627\u0645\u0644\u0627\u062a\u060c \u06c1\u0646\u062f\u06cc \u0627\u0648\u0631 \u0627\u0646\u06af\u0631\u06cc\u0632\u06cc \u0645\u06cc\u06ba \u062f\u0648 \u0644\u0633\u0627\u0646\u06cc \u062a\u0639\u0627\u0648\u0646\u060c \u0633\u06cc\u0627\u0642 \u0648 \u0633\u0628\u0627\u0642 \u0633\u06d2 \u0622\u06af\u0627\u06c1 \u06af\u0641\u062a\u06af\u0648\u060c \u0633\u06cc\u0634\u0646 \u067e\u0631 \u0645\u0628\u0646\u06cc \u0686\u06cc\u0679 \u06c1\u0633\u0679\u0631\u06cc\u060c \u0627\u0648\u0631 \u062c\u0648\u0627\u0628\u0627\u062a \u06a9\u0648 \u06a9\u0627\u067e\u06cc \u06a9\u0631\u0646\u06d2 \u0627\u0648\u0631 \u0634\u06cc\u0626\u0631 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a \u067e\u06cc\u0634 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u060c \u062c\u0633 \u0633\u06d2 \u0627\u06cc\u06a9 \u06c1\u0645\u0648\u0627\u0631 \u0627\u0648\u0631 \u0635\u0627\u0631\u0641 \u062f\u0648\u0633\u062a \u062a\u062c\u0631\u0628\u06c1 \u06a9\u0648 \u06cc\u0642\u06cc\u0646\u06cc \u0628\u0646\u0627\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u06d4",ques18:"\u0645\u06cc\u06ba \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u06d2 \u0645\u0648\u0627\u062f \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u0627\u067e\u0646\u06cc \u0631\u0627\u0626\u06d2 \u06a9\u06cc\u0633\u06d2 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",ans18:'\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u06c1\u0631 \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06d2 \u0635\u0641\u062d\u06d2 \u06a9\u06d2 \u0646\u0686\u0644\u06d2 \u062d\u0635\u06d2 \u0645\u06cc\u06ba "\u06a9\u06cc\u0627 \u06cc\u06c1 \u0645\u062f\u062f\u06af\u0627\u0631 \u062a\u06be\u0627\u061f" \u0641\u06cc\u0688 \u0628\u06cc\u06a9 \u0633\u06cc\u06a9\u0634\u0646 \u067e\u06cc\u0634 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u060c \u062c\u0633 \u0633\u06d2 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 1 \u0633\u06d2 5 \u0633\u062a\u0627\u0631\u0648\u06ba \u062a\u06a9 \u0645\u0648\u0627\u062f \u06a9\u06cc \u062f\u0631\u062c\u06c1 \u0628\u0646\u062f\u06cc \u06a9\u0631\u0646\u06d2 \u0627\u0648\u0631 \u0627\u067e\u0646\u06d2 \u062a\u062c\u0631\u0628\u0627\u062a\u060c \u062a\u062c\u0627\u0648\u06cc\u0632 \u06cc\u0627 \u0641\u06cc\u0688 \u0628\u06cc\u06a9 \u06a9\u0627 \u0627\u0634\u062a\u0631\u0627\u06a9 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a \u0645\u0644\u062a\u06cc \u06c1\u06d2\u06d4 \u0635\u0627\u0631\u0641\u06cc\u0646 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u06a9\u06cc \u0645\u0633\u0644\u0633\u0644 \u0628\u06c1\u062a\u0631\u06cc \u0627\u0648\u0631 \u0631\u062f\u0639\u0645\u0644 \u06a9\u0648 \u06cc\u0642\u06cc\u0646\u06cc \u0628\u0646\u0627\u0646\u06d2 \u0645\u06cc\u06ba \u0645\u062f\u062f \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc \u0645\u06cc\u0644 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 support-myscheme@digitalindia.gov.in \u067e\u0631 \u062a\u0641\u0635\u06cc\u0644\u06cc \u0641\u06cc\u0688 \u0628\u06cc\u06a9 \u0628\u06be\u06cc \u0628\u06be\u06cc\u062c \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4',ques19:"\u06a9\u0648\u0626\u06cc \u0635\u0627\u0631\u0641 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0631 \u06a9\u06cc\u0633\u06d2 \u0633\u0627\u0626\u0646 \u0627\u067e \u06cc\u0627 \u0633\u0627\u0626\u0646 \u0627\u0646 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u061f",ans19:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0645\u06cc\u0631\u06cc \u067e\u06c1\u0644 (\u0646\u06cc\u0634\u0646\u0644 \u0633\u0646\u06af\u0644 \u0633\u0627\u0626\u0646 \u0622\u0646) \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0645\u0631\u0628\u0648\u0637 \u06c1\u06d2\u060c \u062c\u0648 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u0627\u067e\u0646\u06cc \u0645\u06cc\u0631\u06cc \u067e\u06c1\u0644 \u06a9\u06cc \u0627\u0633\u0646\u0627\u062f \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u0648\u0626\u06d2 \u0633\u0627\u0626\u0646 \u0627\u067e \u06a9\u0631\u0646\u06d2 \u06cc\u0627 \u0633\u0627\u0626\u0646 \u0627\u0646 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0642\u0627\u0628\u0644 \u0628\u0646\u0627\u062a\u0627 \u06c1\u06d2\u06d4 \u0635\u0627\u0631\u0641\u06cc\u0646 \u0633\u0627\u0626\u0646 \u0627\u0646 \u06a9\u06cc\u06d2 \u0628\u063a\u06cc\u0631 \u0633\u0631\u06a9\u0627\u0631\u06cc \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u0648 \u0628\u0631\u0627\u0624\u0632 \u0627\u0648\u0631 \u0633\u0631\u0686 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u062a\u0627\u06c1\u0645\u060c \u0633\u0627\u0626\u0646 \u0627\u0646 \u06a9\u0631\u0646\u06d2 \u0633\u06d2 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u0627\u067e\u0646\u06d2 \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u06a9\u0648 \u0645\u062d\u0641\u0648\u0638 \u06a9\u0631\u0646\u06d2\u060c \u0628\u06a9 \u0645\u0627\u0631\u06a9 \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba\u060c \u0627\u0648\u0631 \u0627\u0646 \u06a9\u06cc \u0645\u062d\u0641\u0648\u0638 \u06a9\u0631\u062f\u06c1 \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u06a9\u06cc \u0628\u0646\u06cc\u0627\u062f \u067e\u0631 \u0630\u0627\u062a\u06cc \u0633\u0641\u0627\u0631\u0634\u0627\u062a \u062d\u0627\u0635\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a \u0645\u0644\u062a\u06cc \u06c1\u06d2\u06d4",ques20:"\u0645\u06cc\u06ba \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u067e\u0631 \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06cc\u0633\u06d2 \u062a\u0644\u0627\u0634 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",ans20:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0627\u0633\u06a9\u06cc\u0645\u0648\u06ba \u06a9\u0648 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u06d2 \u0627\u0648\u0631 \u062f\u0631\u06cc\u0627\u0641\u062a \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0645\u062a\u0639\u062f\u062f \u0637\u0631\u06cc\u0642\u06d2 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u060c \u0628\u0634\u0645\u0648\u0644 \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06d2 \u0646\u0627\u0645 \u06cc\u0627 \u0645\u0637\u0644\u0648\u0628\u06c1 \u0627\u0644\u0641\u0627\u0638 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u0627\u060c \u0630\u0627\u062a\u06cc \u0633\u0641\u0627\u0631\u0634\u0627\u062a\u060c \u0631\u06cc\u0627\u0633\u062a/\u0645\u0631\u06a9\u0632 \u06a9\u06d2 \u0632\u06cc\u0631 \u0627\u0646\u062a\u0638\u0627\u0645 \u0639\u0644\u0627\u0642\u06d2 \u06cc\u0627 \u0645\u0631\u06a9\u0632\u06cc \u062d\u06a9\u0648\u0645\u062a \u