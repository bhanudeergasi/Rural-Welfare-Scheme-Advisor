2\u0927\u092e\u0947 \u0915\u094b\u0928\u094b \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0928\u0939\u093f \u0915\u0930\u0948\u0924 \u0905\u091b\u093f\u0964 \u0915\u094b\u0928\u094b \u092a\u0930\u093f\u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947, \u090f\u092e. \u0908. \u0906\u0908. \u091f\u0940. \u092f\u093e \u090f\u0928. \u0908. \u091c\u0940. \u0921\u0940. \u090f\u0939\u093f \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u0947 \u092a\u0930\u093f\u0923\u093e\u092e\u0938\u094d\u0935\u0930\u0942\u092a \u092d\u0947\u0932 \u0915\u094b\u0928\u094b \u0939\u093e\u0928\u093f, \u0915\u094d\u0937\u0924\u093f, \u0926\u093e\u092f\u093f\u0924\u094d\u0935 \u092f\u093e \u0916\u0930\u094d\u091a \u0915\u0947 \u0932\u0947\u0932 \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u0940 \u0928\u0939\u093f \u0939\u094b\u092f\u0924, \u091c\u093e\u0939\u093f \u092e\u0947 \u092c\u093f\u0928\u093e \u0915\u094b\u0928\u094b \u0938\u0940\u092e\u093e \u0915\u0947, \u0915\u094b\u0928\u094b \u0924\u094d\u0930\u0941\u091f\u093f, \u0935\u093e\u092f\u0930\u0938, \u0924\u094d\u0930\u0941\u091f\u093f, \u091a\u0942\u0915, \u092c\u093e\u0927\u093e \u092f\u093e \u0926\u0947\u0930\u0940, \u0905\u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u092f\u093e \u0926\u0942\u0930\u0938\u094d\u0925, \u0936\u093e\u092e\u093f\u0932 \u091b\u0948\u0915\u0964 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e\u0915 \u0909\u092a\u092f\u094b\u0917 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0915 \u090f\u0915\u092e\u093e\u0924\u094d\u0930 \u091c\u094b\u0916\u093f\u092e \u0905\u091b\u093f\u0964 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0935\u093f\u0936\u0947\u0937 \u0930\u0942\u092a\u0938\u0901 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f \u0906 \u0938\u0939\u092e\u0924 \u0939\u094b\u0907\u0924 \u0905\