0c \u062a\u06c1\u0655 \u062a\u06be\u0631\u0688 \u067e\u0627\u0631\u0679\u06cc \u062d\u0642\u0648\u0642\u0686 \u062a\u0639\u0645\u06cc\u0644 (\u0628\u0634\u0645\u0648\u0644 \u0688\u06cc\u0679\u0627 \u06cc\u0627 \u0633\u0627\u0641\u0679 \u0648\u06cc\u0626\u0631\u0686 \u062f\u0631\u0622\u0645\u062f \u06cc\u0627 \u0628\u0631\u0622\u0645\u062f\u060c \u067e\u0631\u0627\u0626\u06cc\u0648\u06cc\u0633\u06cc \u0648\u063a\u06cc\u0631\u06c1 \u06a9\u0633 \u0628\u0627\u0631\u0633 \u0645\u0646\u065b\u0632 \u0645\u062d\u062f\u0648\u062f \u0642\u0648\u0627\u0646\u06cc\u0646)\u06d4 \u062a\u0645 \u06a9\u0631\u0646 \u0688\u06cc\u0679\u0627 \u067e\u0631\u0648\u0679\u06cc\u06a9\u0634\u0646 \u0642\u0648\u0627\u0646\u06cc\u0646 \u062a\u06c1\u0655 \u0636\u0648\u0627\u0628\u0637\u0686 \u067e\u0627\u0628\u0646\u062f\u06cc \u0628\u0634\u0645\u0648\u0644 \u0688\u06cc\u062c\u06cc\u0679\u0644 \u067e\u0631\u0633\u0646\u0644 \u0688\u06cc\u0679\u0627 \u067e\u0631\u0648\u0679\u06cc\u06a9\u0634\u0646 \u0627\u06cc\u06a9\u0679\u060c 2023\u060c \u062a\u06c1\u0655 \u0627\u0646\u0641\u0627\u0631\u0645\u06cc\u0634\u0646 \u0679\u06cc\u06a9\u0646\u0627\u0644\u0648\u062c\u06cc \u0627\u06cc\u06a9\u0679\u060c 2000\u060c \u06cc\u0627 \u0627\u062a\u06be \u0645\u0646\u065b\u0632 \u0628\u0646\u0627\u0648\u0646\u06c1\u0655 \u0622\u0645\u062a \u06a9\u0646\u06c1\u06c1 \u0642\u0648\u0627\u0639\u062f \u06cc\u0627 \u0636\u0648\u0627\u0628\u0637\u060c \u062a\u06c1\u0655 \u0627\u0633\u062a\u0639\u0645\u0627\u0644\u06a9 \u0648\u0642\u062a\u06c1\u0655 \u0628\u0627\u0642\u06cc \u0645\u062a\u0639\u0644\u0642\u06c1 \u0642\u0648\u0627\u0646\u06cc\u0646/\u0642\u0648\u0627\u0639\u062f/\u0622\u0631\u0688\u06cc\u0646\u0646\u0633/\u0627\u0637\u0644\u0627\u0639\u0627\u062a/\u0636\u0645\u0646\u06cc \u0642\u0648\u0627\u0646\u06cc\u0646 \u0648\u063a\u06cc\u0631\u06c1\u06d4"),(0,xe.Z)(de,"urlSubHeading6Text","\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06cc\u0648 \u0622\u0631 \u0627\u06cc\u0644 \u06af\u0698\u06be \u0646\u06c1\u0655 \u06a9\u0646\u06c1 \u062a\u06c1 \u0637\u0631\u06cc\u0642\u06c1\u0655 \u0633\u06ed\u062a\u06cd \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u06c1\u0655 \u06cc\u0646 \u06cc\u0633 \u062f\u06be\u0648\u06a9\u06c1 \u062f\u06c1\u06cc\u060c \u06af\u0645\u0631\u0627\u06c1 \u06a9\u0646 \u06cc\u0627 \u063a\u0623\u0631 \u0642\u0627\u0646\u0648\u0646\u06cc \u0622\u0633\u06c1\u0655\u060c \u0628\u0634\u0645\u0648\u0644 \u063a\u0623\u0631 \u0642\u0627\u0646\u0648\u0646\u06cc \u0631\u06cc \u0688\u0627\u0626\u0631\u06cc\u06a9\u0634\u0646\u0632\u060c \u0641\u0634\u0646\u06af\u060c \u06cc\u0627 \u0628\u0627\u0642\u06cc \u0628\u062f\u0646\u06cc\u062a\u06cc \u06c1\u0646\u065b\u0632 \u0633\u0631\u06af\u0631\u0645\u06cc\u06c1\u0655 \u062a\u0627\u0645 \u0645\u062d\u062f\u0648\u062f \u0622\u0633\u06c1\u0655 \u0646\u06c1\u0655\u06d4 \u062a\u06c4\u06c1\u06c1 \u067e\u0632\u0655 \u0646\u06c1\u0655 \u06cc\u0648 \u0622\u0631 \u0627\u06cc\u0644 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u0633 \u067e\u06cc\u0679\u06be \u0645\u0645\u0627\u0646\u0639\u062a \u06cc\u062a\u06be \u067e\u0623\u0679\u06be\u06cd \u06cc\u06cc\u06c1\u0655 \u0646\u06c1\u0655 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645\u0686 \u0633\u0627\u06a9\u06be \u063a\u0644\u0637 \u062b\u0623\u0628\u062a \u06a9\u0631\u0646\u06c1\u0655 \u06cc\u0627 \u06a9\u0645 \u06a9\u0631\u0646\u06c1\u0655\u06d4 \u06cc\u0648 \u0622\u0631 \u0627\u06cc\u0644 \u06af\u0698\u06be \u0646\u06c1\u0655 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645\u0686 \u067e\u06cc\u0634\u06af\u06cc \u062a\u062d\u0631\u06cc\u0631\u06cc \u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u0628\u063a\u0623\u0631 \u062a\u062c\u0627\u0631\u062a\u06cc \u0627\u0634\u062a\u06c1\u0627\u0631\u0633\u060c \u067e\u0631\u0648\u0645\u0648\u0634\u0646\u0646\u060c \u06cc\u0627 \u0645\u0646\u0627\u0641\u0633 \u067e\u06cc\u0679\u06be \u0645\u0628\u0646\u06cc \u0633\u0631\u06af\u0631\u0645\u06cc\u0646 \u0645\u0646\u065b\u0632 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u06c1\u0655 \u06cc\u0646\u06d4"),(0,xe.Z)(de,"urlSubHeading7Text",'\u062a\u0648\u0658\u06c1\u06c1\u06c1 (\u0628\u0637\u0648\u0631 "\u0645\u0639\u0627\u0648\u0636\u06c1\u0655 \u062f\u0672\u0631\u06cc \u067e\u0627\u0631\u0679\u06cc")\u060c \u0642\u0627\u0646\u0648\u0646 \u06a9\u06c1 \u0630\u0631\u06cc\u0639 \u0627\u062c\u0627\u0632\u062a \u062f\u0646\u06c1\u0655 \u0622\u0645\u0655\u0698 \u0632\u06cc\u0627\u062f\u0655 \u06a9\u06be\u0648\u062a\u06c1\u0655 \u0632\u06cc\u0627\u062f\u0655 \u062d\u062f\u0633 \u062a\u0627\u0645\u060c \u0627\u0633\u06c1 \u0628\u0686\u0627\u0648\u060c \u062d\u0641\u0627\u0638\u062a \u062a\u06c1\u0655 \u0645\u0639\u0627\u0648\u0636\u06c1\u0655 \u06a9\u0631\u06cc\u0648 (\u0628\u0637\u0648\u0631 "\u0645\u0639\u0627\u0648\u0636\u06c1\u0655 \u062f\u0672\u0631\u06cc \u067e\u0627\u0631\u0679\u06cc")\u06d4 \u0645\u0639\u0627\u0648\u0636\u06c1\u0655 \u062f\u0672\u0631\u06cc \u067e\u0627\u0631\u0679\u06cc \u0645\u0639\u0627\u0648\u0636\u06c1\u0655 \u062f\u0672\u0631\u06cc \u067e\u0627\u0631\u0679\u06cc \u062a\u06c1\u0655 \u062a\u06c1\u0646\u062f\u06cc\u0646 \u0627\u0641\u0633\u0631\u0646\u060c \u0645\u0644\u0627\u0632\u0645\u06cc\u0646\u060c \u0688\u0627\u0626\u0631\u06cc\u06a9\u0679\u0631\u0632\u0646\u060c \u062a\u06c1\u0655 \u06a9\u0646\u0633\u0644\u0679\u0646\u0679\u0646\u0679\u0646\u060c \u06cc\u062a\u06be\u06a9\u0646 \u0632\u0646 \u0635\u0648\u0631\u062a \u062d\u0627\u0644 \u0622\u0633\u06c1 (\u062a\u0645\u0627\u0645 \u062a\u06be\u0631\u0688 \u067e\u0627\u0631\u0679\u06cc \u06cc\u0645\u0646 \'\u0645\u0639\u0627\u0648\u0636\u06c1\u0655 \u062f\u0672\u0631\u06cc \u067e\u0627\u0631\u0679\u06cc\' \u06a9\u0633 \u0637\u0648\u0631\u0633 \u067e\u06cc\u0679\u06be \u0648\u0646\u0646\u06c1\u0655 \u0686\u06be \u06cc\u0648\u0627\u0646)\u060c \u06a9\u0646\u06c1 \u062a\u06c1\u0655 \u062a\u0645\u0627\u0645 \u062b\u0672\u0628\u062a \u06cc\u0627 \u0645\u0628\u06cc\u0646\u06c1 \u0646\u0642\u0635\u0627\u0646\u0627\u062a\u060c \u0645\u0637\u0627\u0644\u0628\u0627\u062a\u060c \u0646\u0642\u0635\u0627\u0646\u0627\u062a\u060c \u0648\u0627\u062c\u0628\u0627\u062a\u060c \u0633\u0648\u062f\u060c \u0627\u06cc\u0648\u0627\u0631\u0688\u0632\u060c \u0641\u06cc\u0635\u0644\u06c1\u0655\u060c \u062a\u0635\u0641\u06cc\u06c1\u060c \u062c\u0631\u0645\u0627\u0646\u06c1\u0655\u060c \u062c\u0631\u0645\u0627\u0646\u06c1\u0655\u060c \u062a\u06c1\u0655 \u06a9\u0646\u06c1 \u062a\u06c1 \u062a\u06be\u0631\u0688 \u067e\u0627\u0631\u0679\u06cc \u06c1\u0646\u065b\u062f \u062f\u0639\u0648\u0655\u060c \u0627\u0639\u0645\u0627\u0644\u060c \u06a9\u0627\u0631\u0648\u0672\u06cc\u06cc \u06c1\u0646\u065b\u062f \u0648\u062c\u0648\u06c1\u0627\u062a\u060c \u06cc\u0627 \u0645\u0642\u062f\u0645\u0633 \u0633\u06ed\u062a\u06cd \u0645\u062a\u0639\u0644\u0642 \u0633\u0645\u062c\u06be\u0648\u062a\u06c1\u0655\u060c \u06cc\u0645 \u06cc\u0645\u0646 \u06c1\u0646\u065b\u062f \u0648\u062c\u06c1 \u0633\u06ed\u062a\u06cd \u0686\u06be \u067e\u0654\u062f\u0655 \u06af\u0698\u0627\u0646\u06d4 / \u0633\u067e\u0627\u0646>'),(0,xe.Z)(de,"urlSubHeading8Text",'8. 1 \u0627\u06d2 \u067e\u06cc \u0622\u06cc\u06c1\u0655 \u0686\u06be \u06a9\u0648\u0646\u06c1\u0655 \u062a\u06c1\u0655 \u0642\u0633\u0645\u0686 \u0648\u0627\u0631\u0646\u0679\u06cc \u0628\u063a\u0672\u0631 "\u06cc\u062a\u06be \u06a9\u0655\u0646 \u0686\u06be" \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u06c1\u0655 \u06cc\u0648\u0627\u0646\u06d4 \u0623\u0633\u06cd \u0686\u06be \u062a\u0645\u0627\u0645 \u0648\u0627\u0631\u0646\u0679\u06cc\u0632\u060c \u0627\u0638\u06c1\u0627\u0631 \u06cc\u0627 \u0645\u0636\u0645\u0631\u060c \u0628\u0634\u0645\u0648\u0644 \u062a\u062c\u0627\u0631\u062a\u06cc \u0627\u06c1\u0644\u06cc\u062a\u0686 \u0648\u0627\u0631\u0646\u0679\u06cc\u0632\u060c \u06a9\u0646\u06c1\u0655 \u062e\u0627\u0635 \u0645\u0642\u0635\u062f \u062e\u0627\u0637\u0631\u0655 \u0641\u0679\u0646\u0633\u060c \u062a\u06c1\u0655 \u0639\u062f\u0645 \u062e\u0644\u0627\u0641 \u0648\u0631\u0632\u06cc\u06d4 \u067e\u0627\u0631\u0679\u06cc \u0622\u0633\u06c1 \u0645\u06a9\u0645\u0644 \u0637\u0648\u0631\u0633 \u067e\u06cc\u0679\u06be \u0630\u0645\u06c1 \u062f\u0627\u0631 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06cc\u0648 \u0622\u0631 \u0627\u06cc\u0644\u0686 \u0645\u06cc\u0632\u0628\u0672\u0646\u06cc \u0633\u06ed\u062a\u06cd \u0648\u0627\u0628\u0633\u062a\u06c1 \u06a9\u0646\u06c1\u06c1 \u062a\u06c1\u0655 \u062a\u0645\u0627\u0645 \u062e\u0637\u0631\u0627\u062a\u0646 \u062e\u0627\u0637\u0631\u0655\u060c \u0628\u0634\u0645\u0648\u0644 \u0645\u06af\u0631 \u0645\u062d\u062f\u0648\u062f \u0646\u06c1\u0655 \u0633\u0627\u0626\u0628\u0631 \u0633\u06cc\u06a9\u06cc\u0648\u0631\u0679\u06cc \u062e\u0637\u0631\u0655\u060c \u0648\u0642\u0627\u0631\u0633 \u0646\u0642\u0635\u0627\u0646\u060c \u06cc\u0627 \u0642\u0627\u0646\u0648\u0646\u06cc \u0646\u062a\u0627\u0626\u062c\u06d4'),(0,xe.Z)(de,"urlSubHeading9Text","<span> 9.1 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0686\u06be \u0641\u0648\u0631\u06cc \u0637\u0648\u0631 \u06c1\u0679\u0627\u0648\u0646\u06a9 \u062d\u06a9\u0645 \u062f\u06cc\u0646\u06a9 \u062d\u0642 \u0645\u062d\u0641\u0648\u0638 \u062a\u06be\u0648\u0627\u0646 \u062a\u06c1\u0655 \u062a\u06c4\u06c1\u06c1 \u067e\u0632\u0655 \u0641\u0648\u0631\u06cc \u0637\u0648\u0631 \u067e\u0646\u0646\u06c1 \u0648\u06cc\u0628 \u0633\u0627\u06cc\u0679\u06c1 \u067e\u0620\u0679\u06be \u06cc\u0648 \u0622\u0631 \u0627\u06cc\u0644 \u06c1\u0679\u0627\u0648\u0646\u06a9 \u0636\u0654\u0631\u0648\u0657\u0631\u062a \u0627\u06af\u0631 \u062a\u06c1\u06cd \u06a9\u0646\u06c1\u0655 \u062a\u06c1\u0655 \u0634\u0631\u0637\u0655\u0686 \u062e\u0644\u0627\u0641 \u0648\u0631\u0632\u06cc \u06a9\u0631\u0627\u0646 \u0644\u0628\u0646\u06c1\u0655 \u0686\u06be \u06cc\u0648\u0627\u0646\u06d4 </span> <span> 9.2 \u067e\u0627\u0631\u0679\u06cc \u067e\u0632\u0655 \u06cc\u062a\u06be \u06a9\u062a\u06be \u0628\u0627\u062a\u06be \u062d\u0672\u0635\u0644 \u06a9\u0631\u0646\u06c1\u0655 \u067e\u062a\u06c1\u0655 \u0627\u0691\u062a\u0627\u0644\u06cc\u0633 (48) \u06af\u06be\u0646\u0679\u0646 \u0645\u0646\u065b\u0632 \u06c1\u0679\u0627\u0648\u0646\u06a9 \u06cc\u062a\u06be \u062d\u06a9\u0645\u0686 \u062a\u0639\u0645\u06cc\u0644 \u06a9\u0631\u0646\u06d4"),(0,xe.Z)(de,"urlSubHeading10Text","\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06c1\u06cc\u065b\u06a9\u06c1\u0655 \u067e\u0646\u0646\u06c1\u0655 \u0635\u0648\u0627\u0628\u062f\u06cc\u062f \u067e\u06cc\u0679\u06be \u06cc\u0645\u0646 \u0634\u0631\u0637\u0646 \u06c1\u0646\u065b\u0632 \u062a\u0639\u0645\u06cc\u0644 \u0645\u0646\u065b\u0632 \u067e\u0627\u0631\u0679\u06cc \u06c1\u0646\u065b\u0632 \u0645\u062f\u062f \u062e\u0623\u0637\u0631\u0655 \u0648\u0633\u0623\u0626\u0644 \u06cc\u0627 \u0631\u06c1\u0646\u0645\u0627 \u062e\u0637\u0648\u0637 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062a\u06be\u060c \u0628\u0634\u0645\u0648\u0644 \u06cc\u0648 \u0622\u0631 \u0627\u06cc\u0644 \u067e\u0644\u06cc\u0633\u0645\u0646\u0679\u060c \u062d\u0641\u0627\u0638\u062a\u06cc \u0627\u0642\u062f\u0627\u0645\u0627\u062a\u060c \u062a\u06c1\u0655 \u0645\u0648\u0627\u062f\u0686 \u06c1\u0648\u0633\u0679\u0646\u06af \u062e\u0623\u0637\u0631\u0655 \u0628\u06c1\u062a\u0631\u06cc\u0646 \u0637\u0631\u06cc\u0642\u06c1\u0655\u06d4"),(0,xe.Z)(de,"urlSubHeading11Text","\u0648\u06cc\u0628 \u0633\u0627\u06cc\u0679\u06c1 \u067e\u06cc\u0679\u06be \u062a\u0645\u0627\u0645 \u062f\u0627\u0646\u0634\u0648\u0631\u0627\u0646\u06c1 \u0627\u0645\u0644\u0627\u06a9\u0655\u06a9 \u062d\u0642\u0648\u0642 \u062a\u06c1\u0655 \u0645\u0641\u0627\u062f\u0627\u062a \u0628\u0634\u0645\u0648\u0644 \u062d\u062f\u0655\u060c \u062a\u062c\u0627\u0631\u062a\u06cc \u0646\u0634\u0627\u0646\u060c \u06a9\u0627\u067e\u06cc \u0631\u0627\u0626\u0679\u060c \u0688\u06cc\u0632\u0627\u0626\u0646\u060c \u06cc\u0627 \u067e\u06cc\u0679\u0646\u0679 \u06af\u0698\u06be\u0646 \u062e\u0635\u0648\u0635\u06cc \u0637\u0648\u0631\u0633 \u067e\u06cc\u0679\u06be \u0627\u0633\u06c1 \u0633\u0655\u062a\u06cd \u062a\u0639\u0644\u0642 \u062a\u06be\u0627\u0648\u0627\u0646\u06d4 \u06cc\u0645 \u0634\u0631\u0627\u0626\u0637 \u0686\u06be \u0646\u06c1\u0655 \u06a9\u0646\u06c1 \u062a\u06c1\u0655 \u0637\u0631\u06cc\u0642\u06c1\u0655 \u0633\u0655\u062a\u06cd \u062a\u06c4\u06c1\u06c1 \u0648\u06cc\u0628 \u0633\u0627\u06cc\u0679\u06c1 \u067e\u06cc\u0679\u06be \u0645\u0644\u06a9\u06cc\u062a\u0655\u06a9 \u062d\u0642\u0648\u0642 \u06cc\u0627 \u0627\u0633\u062a\u062b\u0646\u06cc \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0627\u0646\u06d4 </span> <span> b. \u062a\u0648\u06c1\u06c1 \u06a9\u0631\u06cc\u0648 \u0646\u06c1\u0655 \u0648\u06cc\u0628 \u0633\u0627\u06cc\u0679\u06c1 \u06c1\u0646\u0632 \u06c1\u0648\u0633\u0679\u0646\u06af/\u06c1\u0627\u0626\u067e\u0631 \u0644\u0646\u06a9\u0646\u06af \u06a9\u0633 \u0628\u0627\u0631\u0633 \u0645\u0646\u0632 \u06a9\u0646\u065b\u06c1\u06c1 \u0628\u06cc\u0627\u0646 \u06cc\u0648\u0633 \u0633\u0655\u0646\u0632\u0646 \u0628\u0631\u0648\u0646\u065b\u06c1\u06c1 \u062a\u062d\u0631\u06cc\u0631\u06cc \u0645\u0646\u0638\u0648\u0631\u06cc \u0628\u063a\u0672\u0631 \u0686\u06be \u0627\u0633\u06c1 \u0633\u0655\u062a\u06cd \u0634\u0631\u0627\u06a9\u062a \u062f\u0627\u0631\u06cc\u060c \u0633\u067e\u0627\u0646\u0633\u0631\u0634\u067e\u060c \u06cc\u0627 \u062a\u0648\u062b\u06cc\u0642\u0655\u0686 \u062a\u062c\u0648\u06cc\u0632 \u06a9\u0631\u0627\u0646\u06d4 </span> <span> c. \u0627\u0633\u06c1 \u0686\u06be \u0627\u06a9\u06be \u06c1\u0627\u0626\u067e\u0631 \u0644\u0646\u06a9\u0655\u0686 \u0627\u062c\u0627\u0632\u062a \u06cc\u0648\u0633 \u0635\u0631\u0641 \u0633\u0627\u0646\u06c1 \u0646\u0627\u0648 \u06cc\u0627 \u0648\u06cc\u0628 \u0633\u0627\u06cc\u0679\u06c1 \u06c1\u0646\u062f \u067e\u062a\u06c1 \u0686\u06be \u0638\u0672\u06c1\u0631 \u06a9\u0631\u0627\u0646\u06d4 \u06c1\u0627\u0626\u067e\u0631 \u0644\u0646\u06a9 \u06a9\u06c1 \u0637\u0648\u0631\u0633 \u067e\u06cc\u0679\u06be \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0644\u0648\u06af\u0648\u060c \u062a\u062c\u0627\u0631\u062a\u06cc \u0646\u0627\u0648\u060c \u062a\u06c1\u0655 \u0679\u0631\u06cc\u0688 \u0645\u0627\u0631\u06a9\u0655\u06a9 \u06a9\u0646\u065b\u06c1\u06c1 \u062a\u06c1\u0655 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06cc\u0627 \u0688\u0633\u067e\u0644\u06d2 \u06c1\u06cc\u06a9\u0648 \u0646\u06c1\u0655 \u0627\u062c\u0627\u0632\u062a \u062f\u062a\u06be\u06d4"),(0,xe.Z)(de,"urlSubHeading12Text","<span> \u0627\u0633\u06c1 \u0686\u06be \u06a9\u0646\u06c1 \u062a\u06c1 \u0648\u0642\u062a\u06c1\u0655 \u06cc\u0645\u0646 \u0634\u0631\u0637\u0646 \u0645\u0646\u065b\u0632 \u062a\u0631\u0645\u06cc\u0645 \u06a9\u0631\u0646\u06a9 \u062d\u0642 \u0645\u062d\u0641\u0648\u0638\u06d4 \u062a\u06c4\u06c1\u06c1 \u0686\u06be \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0631\u0646\u06c1\u0655 \u06cc\u0648\u0627\u0646 \u0632 \u062a\u06c1\u06cd \u06a9\u0654\u0631\u0648 \u0645\u06cc\u06cc\u0633\u06a9\u06cc\u0645 \u06cc\u0648 \u0622\u0631 \u0627\u06cc\u0644 \u06a9\u06c1 \u0644\u06af\u0627\u062a\u0627\u0631 \u0627\u0633\u062a\u0639\u0645\u0627\u0644/\u06c1\u0648\u0633\u0679\u0646\u06af \u062e\u0672\u0637\u0631\u0655 \u06cc\u0645\u0646 \u0634\u0631\u0637\u0646 \u06c1\u0646\u065b\u062f \u0648\u0642\u062a\u0627 \u0641\u0648\u0642\u062a\u0627 \u062c\u0672\u06cc\u0632\u0655\u06d4"),(0,xe.Z)(de,"urlSubHeading13Text","\u06a9\u0646\u06c1\u0655 \u062a\u06cc\u06cc\u06c1\u0655 \u0635\u0648\u0631\u062a\u0633 \u0645\u0646\u065b\u0632 \u0622\u0633\u06c1\u0655 \u0646\u06c1\u0655 \u0623\u0633 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06cc\u0648 \u0622\u0631 \u0627\u06cc\u0644 \u06a9\u06c1 \u0627\u0633\u062a\u0639\u0645\u0627\u0644/\u06c1\u0648\u0633\u0679\u0646\u06af \u0633\u06ed\u062a\u06cd \u06cc\u0627 \u0627\u0645\u06c1\u0655 \u06a9\u0633 \u062d\u0648\u0627\u0644\u06c1\u0655 \u0633\u06ed\u062a\u06cd \u067e\u06cc\u062f\u0655 \u06af\u0698\u06be\u0646 \u0648\u0623\u0644 \u06a9\u0646\u06c1\u06c1 \u0628\u0627\u0644\u0648\u0627\u0633\u0637\u06c1\u060c \u062e\u06