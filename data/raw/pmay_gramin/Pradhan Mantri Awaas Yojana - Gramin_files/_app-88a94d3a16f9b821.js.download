rong></span>",hiwStep2Head:"\u0924\u093e\u0915\u0942\u0964",hiwStep2:"<span>\u0939\u092e\u0930 \u0916\u094b\u091c \u0907\u0902\u091c\u0928 <strong>\u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u092f\u094b\u091c\u0928\u093e\u0938\u092d \u092a\u093e\u092f\u092c</strong>!</span>",hiwStep3Head:"\u091a\u0941\u0928\u0942 \u0906 \u0932\u093e\u0917\u0942 \u0915\u0930\u0942",hiwStep3:"<span><strong>\u0938\u092c\u0938\u0901 \u0909\u092a\u092f\u0941\u0915\u094d\u0924 \u092f\u094b\u091c\u0928\u093e \u0932\u0947\u0932 \u091a\u0941\u0928\u0942 \u0906 \u0932\u093e\u0917\u0942 \u0915\u0930\u0942</strong></span>",aboutSubHead:"\u0905\u092a\u0928 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e \u090f\u0924\u093d \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0942!",aboutHead:"\u090f\u0915\u0930 \u0935\u093f\u0937\u092f\u092e\u0947\u0964",aboutDesc1:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u090f\u0915\u091f\u093e \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u092e\u0902\u091a \u0905\u091b\u093f \u091c\u0915\u0930 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e \u0938\u092d\u0915 \u0916\u094b\u091c \u0906 \u0916\u094b\u091c\u0915\u0947\u0901 \u090f\u0915 \u092c\u0947\u0930\u092e\u0947 \u0909\u092a\u0932\u092c\u094d\u0927 \u0915\u0930\u093e\u092c\u092f \u091b\u0948\u0915\u0964",aboutDesc2:"\u0908 \u0928\u093e\u0917\u0930\u093f\u0915\u0915 \u092f\u094b\u0917\u094d\u092f\u0924\u093e\u0915 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092f\u094b\u091c\u0928\u093e\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0924\u0915\u092c\u093e\u0915 \u0932\u0947\u0932 \u090f\u0915\u091f\u093e \u0928\u0935\u0940\u0928, \u092a\u094d\u0930\u094c\u0926\u094d\u092f\u094b\u0917\u093f\u0915\u0940 \u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u092e\u093e\u0927\u093e\u0928 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f\u0964",aboutDesc3:"\u0908 \u092e\u0902\u091a \u0928\u093e\u0917\u0930\u093f\u0915\u0915\u0947\u0901 \u0939\u0941\u0928\u0915\u093e \u0932\u0947\u0932 \u0938\u0939\u0940 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0938\u092d \u0924\u0915\u092c\u093e\u092e\u0947 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0930\u0948\u0924 \u0905\u091b\u093f\u0964 \u0908 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e \u0938\u092d\u0915 \u0932\u0947\u0932 \u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u092c\u093e\u0915 \u0924\u0930\u0940\u0915\u093e \u092a\u0930 \u0938\u0947\u0939\u094b \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f\u0964 \u090f\u0939\u093f \u0932\u0947\u0932 \u0905\u0928\u0947\u0915 \u0938\u0930\u0915\u093e\u0930\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 \u091c\u092f\u092c\u093e\u0915 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0928\u0939\u093f \u0905\u091b\u093f\u0964",vision:"\u0939\u092e\u0930 \u0926\u0943\u0937\u094d\u091f\u093f",visionText:"\u0939\u092e\u0930 \u0926\u0943\u0937\u094d\u091f\u093f \u0928\u093e\u0917\u0930\u093f\u0915\u0915 \u091c\u0940\u0935\u0928\u0915\u0947\u0901 \u0906\u0938\u093e\u0928 \u092c\u0928\u092f\u092c\u093e\u0915 \u0905\u091b\u093f\u0964",mission:"\u0939\u092e\u0930 \u092e\u093f\u0936\u0928",mission1:"\u0939\u092e\u0930 \u092e\u093f\u0936\u0928 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e \u0906 \u0932\u093e\u092d\u0915 \u0932\u0947\u0932 \u0938\u0930\u0915\u093e\u0930-\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0907\u0902\u091f\u0930\u092b\u0947\u0938\u0915\u0947\u0901 \u0938\u0941\u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093f\u0924 \u0915\u0930\u092c \u0905\u091b\u093f\u0964",mission2:"\u0915\u094b\u0928\u094b \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0915\u0947\u0901 \u0924\u0915\u092c\u093e\u0915 \u0906 \u0913\u0915\u0930 \u0932\u093e\u092d \u0909\u0920\u092f\u092c\u093e\u0915 \u0932\u0947\u0932 \u0906\u0935\u0936\u094d\u092f\u0915 \u0938\u092e\u092f \u0906 \u092a\u094d\u0930\u092f\u093e\u0938\u0915\u0947\u0901 \u0915\u092e \u0915\u0930\u0942\u0964",aboutPageDesc1:"\u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0908-\u0936\u093e\u0938\u0928 \u092a\u094d\u0930\u092d\u093e\u0917 (\u090f\u0928. \u0908. \u091c\u0940. \u0921\u0940.) \u0926\u094d\u0935\u093e\u0930\u093e \u0935\u093f\u0915\u0938\u093f\u0924, \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0906 \u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u0905\u091b\u093f, \u091c\u0947 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093e\u0928\u093f\u0915\u094d\u0938 \u0906 \u0938\u0942\u091a\u0928\u093e \u092a\u094d\u0930\u094c\u0926\u094d\u092f\u094b\u0917\u093f\u0915\u0940 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f (\u090f\u092e. \u0908. \u0906\u0908. \u091f\u0940. \u0935\u093e\u0908.), \u092a\u094d\u0930\u0936\u093e\u0938\u0928\u093f\u0915 \u0938\u0941\u0927\u093e\u0930 \u0906 \u0932\u094b\u0915 \u0936\u093f\u0915\u093e\u092f\u0924 \u0935\u093f\u092d\u093e\u0917 (\u0921\u0940. \u090f. \u0906\u0930. \u092a\u0940. \u091c\u0940.) \u0915 \u0938\u0939\u092f\u094b\u0917\u0938\u0901 \u0906 \u0905\u0928\u094d\u092f \u0915\u0947\u0928\u094d\u0926\u094d\u0930\u0940\u092f \u0906 \u0930\u093e\u091c\u094d\u092f \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f/\u0935\u093f\u092d\u093e\u0917\u0938\u092d\u0915 \u0938\u093e\u091d\u0947\u0926\u093e\u0930\u0940\u092e\u0947 \u0905\u091b\u093f\u0964",eligibilityCheckHead:"\u092f\u094b\u0917\u094d\u092f\u0924\u093e \u091c\u093e\u0901\u091a",eligibilityCheckDesc:"\u0905\u0939\u093e\u0901 \u0905\u0932\u0917-\u0905\u0932\u0917 \u092e\u093e\u0928\u0926\u0902\u0921 \u0906 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0935\u093f\u0936\u0947\u0937\u0924\u093e\u0915 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0948\u0924 \u092f\u094b\u091c\u0928\u093e\u0915 \u0932\u0947\u0932 \u0905\u092a\u0928 \u092f\u094b\u0917\u094d\u092f\u0924\u093e\u0915 \u091c\u093e\u0901\u091a \u0915\u093d \u0938\u0915\u0948\u0924 \u091b\u0940\u0964",schemeFinderHead:"\u092f\u094b\u091c\u0928\u093e \u0916\u094b\u091c\u0915\u0930\u094d\u0924\u093e",schemeFinderDesc:"\u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0938\u092d\u0915 \u0932\u0947\u0932 \u092b\u093f\u0932\u094d\u091f\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0921\u094d\u0930\u093f\u0932 \u0921\u093e\u0909\u0928\u0915 \u0938\u0919\u094d\u0917 \u0924\u0947\u091c \u0906 \u0906\u0938\u093e\u0928 \u0916\u094b\u091c",schemeInDetailHead:"\u0935\u093f\u0938\u094d\u0924\u093e\u0930\u0938\u0901 \u092f\u094b\u091c\u0928\u093e",schemeInDetailDesc:"\u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u092c\u093e\u0938\u0901 \u092a\u0939\u093f\u0928\u0947 \u0928\u0940\u0915 \u0926\u093e\u0928\u093e \u092f\u094b\u091c\u0928\u093e\u0915 \u0935\u093f\u0935\u0930\u0923\u0915 \u0932\u0947\u0932 \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u092f\u094b\u091c\u0928\u093e \u092a\u0943\u0937\u094d\u0920\u092e\u0947 \u0917\u0939\u0930\u093e\u0908\u0938\u0901 \u0917\u094b\u0924\u093e \u0932\u0917\u093e\u0909\u0964",documentRequired:"\u0906\u0935\u0936\u094d\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u0938\u092d",faqHead:"\u0905\u0915\u094d\u0938\u0930 \u092a\u0942\u091b\u0947 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u092a\u094d\u0930\u0936\u094d\u0928",faqSubHead1:"\u0905\u092a\u0928 \u0915\u093f\u091b\u0941 \u091c\u0935\u093e\u092c\u0915 \u0932\u0947\u0932 \u0939\u092e\u0930 \u091c\u094d\u091e\u093e\u0928 \u0906\u0927\u093e\u0930\u0915 \u091c\u093e\u0901\u091a \u0915\u0930\u0942!",ques1:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u0915\u0940 \u091b\u0948, \u0906\u0930 \u0908 \u0905\u0928\u094d\u092f \u0938\u0930\u0915\u093e\u0930\u0940 \u092a\u094b\u0930\u094d\u091f\u0932 \u0938\u0901 \u0915\u0947\u0928\u093e \u0905\u0932\u0917 \u091b\u0948?",ans1:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u0915\u0947\u0928\u094d\u0926\u094d\u0930 \u0906 \u0930\u093e\u091c\u094d\u092f/\u0915\u0947\u0928\u094d\u0926\u094d\u0930 \u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936 \u0926\u0941\u0928\u0942 \u0938\u0930\u0915\u093e\u0930\u0938\u0901 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0938\u092d\u0915 \u090f\u0915\u091f\u093e \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u0936\u094d\u0930\u0943\u0902\u0916\u0932\u093e\u0915 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u092c\u093e\u0915 \u0932\u0947\u0932 \u090f\u0915\u091f\u093e \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u092e\u0902\u091a \u0905\u091b\u093f\u0964 \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0935\u093f\u0935\u0930\u0923\u0915 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0938\u092d\u0915 \u0916\u094b\u091c \u0906 \u0916\u094b\u091c\u0915 \u0932\u0947\u0932 \u0908 \u090f\u0915\u091f\u093e \u0935\u0928-\u0938\u094d\u091f\u0949\u092a \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0905\u091b\u093f\u0964 \u092a\u093e\u0930\u092e\u094d\u092a\u0930\u093f\u0915 \u0938\u0930\u0915\u093e\u0930\u0940 \u092a\u094b\u0930\u094d\u091f\u0932\u0915 \u0935\u093f\u092a\u0930\u0940\u0924, \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0915\u0947\u0928\u094d\u0926\u094d\u0930 \u0938\u0930\u0915\u093e\u0930, \u0930\u093e\u091c\u094d\u092f \u0938\u0930\u0915\u093e\u0930 \u0906 \u0915\u0947\u0928\u094d\u0926\u094d\u0930 \u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936\u0915 \u092f\u094b\u091c\u0928\u093e\u0938\u092d\u0915\u0947\u0901 \u090f\u0915 \u092e\u0902\u091a \u092a\u0930 \u090f\u0915 \u0938\u0919\u094d\u0917 \u0932\u092c\u0948\u0924 \u0905\u091b\u093f \u0906 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0938\u092d\u0915\u0947\u0901 \u0905\u092a\u0928 \u092f\u094b\u0917\u094d\u092f\u0924\u093e\u0915 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u092f\u094b\u091c\u0928\u093e\u0938\u092d \u0924\u0915\u092c\u093e\u092e\u0947 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0930\u0948\u0924 \u0905\u091b\u093f\u0964",ques2:"\u0939\u092e\u0930 \u092f\u094b\u091c\u0928\u093e \u0906\u092e \u0928\u093e\u0917\u0930\u093f\u0915\u0915 \u0915\u094b\u0928\u093e \u092e\u0926\u0924\u093f \u0915\u0930\u0924?",ans2:"\u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0928\u093e\u0917\u0930\u093f\u0915\u0938\u092d\u0915\u0947\u0901 \u090f\u0915 \u0920\u093e\u092e \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u092f\u094b\u091c\u0928\u093e\u0938\u092d\u0915 \u0916\u094b\u091c \u0915\u0930\u092c\u093e\u092e\u0947 \u0938\u0915\u094d\u0937\u092e \u092c\u0928\u093e \u0915\u093d \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0938\u092d \u0924\u0915 \u092a\u0939\u0941\u0901\u091a\u0915\u0947\u0901 \u0938\u0930\u0932 \u092c\u0928\u093e\u092c\u0948\u0924 \u0905\u091b\u093f, \u0905\u0928\u0947\u0915 \u0935\u093f\u092d\u093e\u0917\u0940\u092f \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u0938\u092d \u092a\u0930 \u091c\u093e\u092f \u0935\u093e \u0905\u092a\u0928 \u092f\u094b\u0917\u094d\u092f\u0924\u093e\u0915 \u091c\u093e\u0901\u091a \u0915\u0930\u092c\u093e\u0915 \u0932\u0947\u0932 \u0935\u094d\u092f\u093e\u092a\u0915 \u092f\u094b\u091c\u0928\u093e \u0926\u093f\u0936\u093e\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u0915 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u092c\u093e\u0915 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e\u0915\u0947\u0901 \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f\u0964",ques3:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u0915\u0947\u0928\u093e \u0915\u093e\u091c \u0915\u0930\u0948\u0924 \u0905\u091b\u093f?",ans3:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u090f\u0915\u091f\u093e \u0938\u0930\u0932 \u0906 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0905\u0928\u0941\u0915\u0942\u0932 \u0924\u0940\u0928-\u091a\u0930\u0923\u0940\u092f \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e\u0915 \u092a\u093e\u0932\u0928 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f \u091c\u0947 \u0928\u093e\u0917\u0930\u093f\u0915\u0938\u092d\u0915\u0947\u0901 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0938\u092d\u0915 \u0916\u094b\u091c \u0915\u0930\u092c\u093e\u092e\u0947 \u092e\u0926\u0924\u093f \u0915\u0930\u0948\u0924 \u0905\u091b\u093f \u091c\u0915\u0930 \u0932\u0947\u0932 \u0913 \u092a\u093e\u0924\u094d\u0930 \u091b\u0925\u093f\u0903 \u091a\u0930\u0923 1: \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f, \u0906\u092f, \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0936\u094d\u0930\u0947\u0923\u0940 \u0906\u0926\u093f \u091c\u0947\u0939\u0928 \u092c\u0941\u0928\u093f\u092f\u093e\u0926\u0940 \u0935\u093f\u0935\u0930\u0923 \u0926\u0930\u094d\u091c \u0915\u0930\u0948\u0924 \u0905\u091b\u093f\u0964 \u091a\u0930\u0923 2: \u0926\u0947\u0932 \u0917\u0947\u0932 \u091c\u093e\u0928\u0915\u093e\u0930\u0940\u0915 \u0906\u0927\u093e\u0930 \u092a\u0930, \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0915 \u0932\u0947\u0932 \u0938\u0948\u0915\u0921\u093c\u094b\u0902 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0938\u092d\u0915 \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u092f\u094b\u091c\u0928\u093e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f\u0964 \u091a\u0930\u0923 3: \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u092f\u094b\u0917\u094d\u092f \u092f\u094b\u091c\u0928\u093e\u0938\u092d\u0915 \u0938\u0942\u091a\u0940\u092e\u0947\u0938\u0901 \u091a\u092f\u0928 \u0915\u093d \u0938\u0915\u0948\u0924 \u0905\u091b\u093f \u0906 \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940, \u090f\u092b\u090f\u0915\u094d\u092f\u0942, \u0906 \u0906\u0935\u0947\u0926\u0928 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e\u0915 \u0938\u0919\u094d\u0917 \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u092f\u094b\u091c\u0928\u093e \u092a\u0943\u0937\u094d\u0920\u0938\u0901 \u092c\u0947\u0938\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u093d \u0938\u0915\u0948\u0924 \u0905\u091b\u093f \u0906 \u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u092c\u093e\u0915 \u0932\u0947\u0932 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0906\u0935\u0947\u0926\u0928 \u092f\u0942\u0906\u0930\u090f\u0932 \u092a\u0930 \u091c\u093e \u0938\u0915\u0948\u0924 \u0905\u091b\u093f\u0964",ques4:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0938\u0939\u0940 \u092f\u094b\u091c\u0928\u093e\u0915\u0947\u0901 \u091c\u093e\u0928\u092c\u093e\u0915 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0940 \u0905\u091b\u093f?",ans4:"\u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0938\u0939\u0940 \u092f\u094b\u091c\u0928\u093e \u0924\u0915\u092c\u093e\u0915 \u0932\u0947\u0932 \u0928\u093e\u0917\u0930\u093f\u0915 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e\u0915 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 \u091c\u093e \u0915\u093d \u0936\u0941\u0930\u0941\u0906\u0924 \u0915\u093d \u0938\u0915\u0948\u0924 \u091b\u0925\u093f\u0964 \u090f\u0915 \u092c\u0947\u0930 \u0939\u094b\u092e\u092a\u0947\u091c \u092a\u0930 \u0939\u0941\u0928\u0915\u093e '\u092b\u093e\u0907\u0928\u094d\u0921 \u0938\u094d\u0915\u0940\u092e\u094d\u0938 \u092b\u0949\u0930 \u092f\u0942' \u092b\u0940\u091a\u0930 \u092d\u0947\u091f\u0924, \u091c\u093e\u0939\u093f \u0938\u0901 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0905\u092a\u0928 \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0935\u093f\u0935\u0930\u0923, \u091c\u0947\u0928\u093e \u0909\u092e\u094d\u0930, \u0932\u093f\u0902\u0917, \u0906\u092f \u0938\u094d\u0924\u0930, \u0936\u094d\u0930\u0947\u0923\u0940 \u0906\u0926\u093f \u0926\u0930\u094d\u091c \u0915\u093d \u0938\u0915\u0948\u0924 \u091b\u0925\u093f\u0964 \u090f\u0915 \u092c\u0947\u0930 \u091c\u0916\u0928 \u0908 \u0935\u093f\u0935\u0930\u0923 \u091c\u092e\u093e \u092d\u093d \u091c\u093e\u092f\u0924 \u0924\u0916\u0928 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u0938\u0942\u091a\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0964",ques5:"\u0915\u094b\u0928\u094b \u0935\u093f\u0936\u0947\u0937 \u092f\u094b\u091c\u0928\u093e\u0915 \u0935\u093f\u0937\u092f\u092e\u0947 \u0939\u092e\u0930\u093e \u0915\u094b\u0928-\u0915\u094b\u0928 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0905\u092a\u0928 \u092f\u094b\u091c\u0928\u093e \u092a\u0930 \u092d\u0947\u091f \u0938\u0915\u0948\u0924 \u0905\u091b\u093f?",ans5:"\u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092f\u094b\u091c\u0928\u093e \u092a\u0930 \u0935\u094d\u092f\u093e\u092a\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f, \u091c\u093e\u0939\u093f\u092e\u0947 \u092a\u093e\u0924\u094d\u0930\u0924\u093e \u092e\u093e\u0928\u0926\u0902\u0921, \u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935\u093f\u0924 \u0932\u093e\u092d, \u0906\u0935\u0947\u0926\u0928 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e, \u0906 \u092f\u094b\u091c\u0928\u093e\u0915 \u0932\u093e\u092d \u0909\u0920\u092f\u092c\u093e\u0915 \u0932\u0947\u0932 \u0906\u0935\u0936\u094d\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c \u0936\u093e\u092e\u093f\u0932 \u0905\u091b\u093f\u0964 \u090f\u0939\u093f\u092e\u0947 \u092f\u094b\u091c\u0928\u093e\u0938\u0901 \u0938\u092e\u094d\u092c\u0928\u094d\u0927\u093f\u0924 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u092a\u094d\u0930\u0936\u094d\u0928\u0938\u092d\u0915 \u0938\u092e\u093e\u0927\u093e\u0928 \u0915\u0930\u092c\u093e\u0915 \u0932\u0947\u0932 \u090f\u0915\u091f\u093e \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u0905\u0915\u094d\u0938\u0930 \u092a\u0942\u091b\u0932 \u091c\u093e\u092f\u0935\u0932\u093e \u092a\u094d\u0930\u0936\u094d\u0928 (\u090f\u092b. \u090f. \u0915\u094d\u092f\u0942.) \u0916\u0902\u0921 \u0938\u0947\u0939\u094b \u0905\u091b\u093f\u0964",ques6:"\u0939\u092e\u0930 \u092f\u094b\u091c\u0928\u093e \u092a\u0930 \u0915\u094b\u0928-\u0915\u094b\u0928 \u0935\u094d\u092f\u093e\u092a\u0915 \u0936\u094d\u0930\u0947\u0923\u0940\u0915 \u0905\u0928\u094d\u0924\u0930\u094d\u0917\u0924 \u092f\u094b\u091c\u0928\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0905\u091b\u093f?",ans6:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u092f\u094b\u091c\u0928\u093e\u0915\u0947\u0901 \u0935\u094d\u092f\u093e\u092a\u0915 \u0930\u0942\u092a\u0938\u0901 15 \u0936\u094d\u0930\u0947\u0923\u0940\u092e\u0947 \u0935\u0930\u094d\u0917\u0940\u0915\u0943\u0924 \u0915\u092f\u0932 \u0917\u0947\u0932 \u0905\u091b\u093f \u091c\u0947 \u0913\u0915\u0930 \u0932\u093e\u092d\u0915 \u092a\u094d\u0930\u0915\u0943\u0924\u093f \u0906 \u0932\u0915\u094d\u0937\u093f\u0924 \u0932\u093e\u092d\u093e\u0930\u094d\u0925\u0940\u0915 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0905\u091b\u093f\u0964 \u090f\u0939\u093f \u0936\u094d\u0930\u0947\u0923\u0940\u092e\u0947 \u0915\u0943\u0937\u093f, \u0917\u094d\u0930\u093e\u092e\u0940\u0923 \u0906 \u092a\u0930\u094d\u092f\u093e\u0935\u0930\u0923; \u092c\u0948\u0902\u0915\u093f\u0902\u0917, \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0938\u0947\u0935\u093e \u0906 \u092c\u0940\u092e\u093e; \u0935\u094d\u092f\u0935\u0938\u093e\u092f \u0906 \u0909\u0926\u094d\u092f\u092e\u093f\u0924\u093e; \u0936\u093f\u0915\u094d\u0937\u093e \u0906 \u0936\u093f\u0915\u094d\u0937\u093e; \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0906 \u0915\u0932\u094d\u092f\u093e\u0923; \u0906\u0935\u093e\u0938 \u0906 \u0906\u0936\u094d\u0930\u092f; \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e, \u0915\u093e\u0928\u0942\u0928 \u0906 \u0928\u094d\u092f\u093e\u092f; \u0935\u093f\u091c\u094d\u091e\u093e\u0928, \u0906\u0908\u091f\u0940 \u0906 \u0938\u0902\u091a\u093e\u0930; \u0915\u094c\u0936\u0932 \u0906 \u0930\u094b\u091c\u0917\u093e\u0930; \u0938\u092e\u093e\u091c \u0915\u0932\u094d\u092f\u093e\u0923 \u0906 \u0938\u0936\u0915\u094d\u0924\u093f\u0915\u0930\u0923; \u0916\u0947\u0932 \u0906 \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f; \u092a\u0930\u093f\u0935\u0939\u0928 \u0906 \u0906\u0927\u093e\u0930\u092d\u0942\u0924 \u0938\u0902\u0930\u091a\u0928\u093e; \u092f\u093e\u0924\u094d\u0930\u093e \u0906 \u092a\u0930\u094d\u092f\u091f\u0928; \u0909\u092a\u092f\u094b\u0917\u093f\u0924\u093e \u0906 \u0938\u094d\u0935\u091a\u094d\u091b\u0924\u093e; \u0906 \u092e\u0939\u093f\u0932\u093e \u0906 \u092c\u093e\u0932 \u0936\u093e\u092e\u093f\u0932 \u0905\u091b\u093f\u0964",ques7:"\u0915\u0940 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092c\u0939\u0941\u092d\u093e\u0937\u0940 \u0938\u092e\u0930\u094d\u0925\u0928 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f?",ans7:"\u0939\u0901, \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0935\u0930\u094d\u0924\u092e\u093e\u0928\u092e\u0947 \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940 \u0938\u0939\u093f\u0924 15 \u092d\u093e\u0937\u093e\u092e\u0947 \u0938\u093e\u092e\u0917\u094d\u0930\u0940\u0915 \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f\u0964 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u092d\u093e\u0930\u0924\u0940\u092f \u092d\u093e\u0937\u093e\u0915 \u0932\u0947\u0932 \u0938\u092e\u0930\u094d\u0925\u0928 \u0936\u0940\u0918\u094d\u0930 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u092f\u0932 \u091c\u093e\u092f\u0924\u0964",ques8:"\u0915\u0940 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0915\u0947\u0902\u0926\u094d\u0930 \u0906 \u0930\u093e\u091c\u094d\u092f/\u0915\u0947\u0902\u0926\u094d\u0930 \u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936 \u0926\u0941\u0928\u0942-\u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092f\u094b\u091c\u0928\u093e\u0915\u0947\u0901 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f?",ans8:"\u0939\u093e\u0902, \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 4,700 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0930\u0915\u093e\u0930 \u0906 \u0930\u093e\u091c\u094d\u092f/\u0915\u0947\u0902\u0926\u094d\u0930 \u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936 \u0938\u0930\u0915\u093e\u0930 \u0915\u0947 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f\u0964 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0932\u0917\u093e\u0924\u093e\u0930 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u092f\u094b\u091c\u0928\u093e\u0938\u092d\u0915\u0947\u0901 \u0936\u093e\u092e\u093f\u0932 \u0915\u092f\u0932 \u091c\u093e\u092f\u0924\u0964",ques9:"\u0939\u092e\u0930\u093e \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0915\u094b\u0928\u094b \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092f\u094b\u091c\u0928\u093e \u0928\u0939\u093f \u092d\u0947\u091f\u0932\u0948\u0915\u0964 \u0939\u092e\u0930\u093e \u0915\u0940 \u0915\u0930\u092c\u093e\u0915 \u091a\u093e\u0939\u0940?",ans9:'\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947 4,700 \u0938\u0901 \u092c\u0947\u0938\u0940 \u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0930\u0915\u093e\u0930 \u0906 \u0930\u093e\u091c\u094d\u092f/\u0915\u0947\u0902\u0926\u094d\u0930 \u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936 \u0938\u0930\u0915\u093e\u0930 \u0915\u0947 \u092f\u094b\u091c\u0928\u093e \u0915\u0947\u0901 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0936\u093e\u092e\u093f\u0932 \u0915\u0948\u0932 \u0917\u0947\u0932 \u091b\u0948\u0915\u0964 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u092f\u094b\u091c\u0928\u093e \u0928\u093f\u092f\u092e\u093f\u0924 \u0930\u0942\u092a\u0938\u0901 \u091c\u094b\u0921\u093c\u0932 \u091c\u093e \u0930\u0939\u0932 \u0905\u091b\u093f\u0964 \u092a\u094d\u0932\u0948\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 "\u0917\u0947\u091f \u0907\u0928 \u091f\u091a" \u0938\u0947\u0915\u094d\u0936\u0928 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0901 \u0928\u093e\u0917\u0930\u093f\u0915 \u0915\u094b\u0928\u094b \u0932\u093e\u092a\u0924\u093e \u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0935\u093f\u0935\u0930\u0923 \u092f\u093e \u0938\u0941\u091d\u093e\u0935 \u0938\u093e\u091d\u093e \u0915\u093d \u0938\u0915\u0948\u0924 \u091b\u0925\u093f\u0964',ques10:"\u0939\u092e\u0930\u093e \u092e\u0930\u093e\u0920\u0940 \u092d\u093e\u0937\u093e\u0915 \u092f\u094b\u091c\u0928\u093e\u0915 \u0938\u093e\u092e\u0917\u094d\u0930\u0940\u092e\u0947 \u0915\u093f\u091b\u0941 \u0924\u094d\u0930\u0941\u091f\u093f \u092d\u0947\u091f\u0932\u0964 \u0939\u092e\u0930\u093e \u0915\u0940 \u0915\u0930\u092c\u093e\u0915 \u091a\u093e\u0939\u0940?",ans10:"\u092f\u0926\u093f \u092f\u094b\u091c\u0928\u093e\u0915 \u0938\u093e\u092e\u0917\u094d\u0930\u0940\u0915 \u092e\u0930\u093e\u0920\u0940 \u0938\u0902\u0938\u094d\u0915\u0930\u0923\u092e\u0947 \u0915\u094b\u0928\u094b \u0935\u093f\u0938\u0919\u094d\u0917\u0924\u093f \u0926\u0947\u0916\u0932 \u091c\u093e\u0907\u0924 \u0905\u091b\u093f \u0924\u0916\u0928 \u0928\u093e\u0917\u0930\u093f\u0915\u0938\u092d\u0915\u0947\u0901 \u0938\u0932\u093e\u0939 \u0926\u0947\u0932 \u091c\u093e\u0907\u0924 \u0905\u091b\u093f \u091c\u0947 \u0913 \u0938\u094d\u092a\u0937\u094d\u091f\u0940\u0915\u0930\u0923\u0915 \u0932\u0947\u0932 \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940 \u0938\u0902\u0938\u094d\u0915\u0930\u0923\u0915 \u0938\u0928\u094d\u0926\u0930\u094d\u092d \u0932\u0947\u0902\u0964 \u091c\u0901 \u0938\u092e\u0938\u094d\u092f\u093e \u092c\u0928\u0932 \u0930\u0939\u0948\u0924 \u0905\u091b\u093f \u0924\u0901 \u0938\u092c\u0938\u0901 \u0938\u091f\u0940\u0915 \u0906 \u0905\u0926\u094d\u092f\u0924\u0928 \u091c\u093e\u0928\u0915\u093e\u0930\u0940\u0915 \u0932\u0947\u0932 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092e\u0928\u094d\u0924\u094d\u0930\u093e\u0932\u092f \u092f\u093e \u0935\u093f\u092d\u093e\u0917\u0915 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u092a\u094b\u0930\u094d\u091f\u0932\u0915\u0947\u0901 \u0938\u0902\u0926\u0930\u094d\u092d\u093f\u0924 \u0915\u092f\u0932 \u091c\u093e \u0938\u0915\u0948\u0924 \u0905\u091b\u093f\u0964 \u090f\u0915\u0930 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924, support-myscheme[at]digitalindia[dot]gov[dot]in \u092a\u0930 \u0908\u092e\u0947\u0932 \u092a\u0920\u093e \u0915\u093d \u090f\u0939\u093f \u0938\u092e\u0938\u094d\u092f\u093e\u0915 \u0938\u0942\u091a\u0928\u093e \u0926\u0947\u0932 \u091c\u093e \u0938\u0915\u0948\u0924 \u0905\u091b\u093f\u0964",ques11:"\u0939\u092e \u090f\u0939\u0928 \u092f\u094b\u091c\u0928\u093e\u0938\u092d\u0915 \u0905\u0928\u094d\u0935\u0947\u0937\u0923 \u0915\u0930\u092f \u091a\u093e\u0939\u0948\u0924 \u091b\u0940 \u091c\u0915\u0930 \u0905\u0928\u094d\u0924\u0930\u094d\u0917\u0924 \u091b\u093e\u0924\u094d\u0930\u0938\u092d\u0915\u0947\u0901 \u091b\u093e\u0924\u094d\u0930\u0935\u0943\u0924\u094d\u0924\u093f \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u092f\u0932 \u091c\u093e\u0907\u0924 \u0905\u091b\u093f\u0964 \u0915\u0940 \u0908 \u0939\u092e\u0930 \u092f\u094b\u091c\u0928\u093e\u0915 \u092e\u093e\u0927\u094d\u092f\u092e\u0938\u0901 \u0938\u092e\u094d\u092d\u0935 \u0905\u091b\u093f?",ans11:"\u0939\u0901, \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u090f\u0915\u091f\u093e \u092e\u0941\u0916\u094d\u092f \u0936\u092c\u094d\u0926-\u0906\u0927\u093e\u0930\u093f\u0924 \u0916\u094b\u091c \u0938\u0941\u0935\u093f\u0927\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f \u091c\u0947 \u0928\u093e\u0917\u0930\u093f\u0915\u0938\u092d\u0915\u0947\u0901 \u091b\u093e\u0924\u094d\u0930\u0938\u092d \u0932\u0947\u0932 \u091b\u093e\u0924\u094d\u0930\u0935\u0943\u0924\u094d\u0924\u093f \u0938\u0939\u093f\u0924 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u092f\u0932 \u0917\u0947\u0932 \u0932\u093e\u092d\u0915 \u092a\u094d\u0930\u0915\u093e\u0930 \u0906 \u0935\u093f\u0938\u094d\u0924\u093e\u0930\u0915 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092f\u094b\u091c\u0928\u093e\u0938\u092d\u0915\u0947\u0901 \u0906\u0938\u093e\u0928\u0940\u0938\u0901 \u0924\u0915\u092c\u093e\u0915, \u0905\u0928\u094d\u0935\u0947\u0937\u0923 \u0915\u0930\u092c\u093e\u0915 \u0906 \u091a\u093f\u0928\u094d\u0939\u092c\u093e\u0915 \u0932\u0947\u0932 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0948\u0924 \u0905\u091b\u093f\u0964",ques12:"\u0939\u092e \u090f\u0915\u091f\u093e \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092f\u094b\u091c\u0928\u093e \u0932\u0947\u0932 \u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u092f \u091a\u093e\u0939\u0948\u0924 \u091b\u0940 \u0906 \u0906\u0935\u0947\u0926\u0928 \u0932\u0947\u0932 \u0906\u0935\u0936\u094d\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c \u0938\u092d \u091c\u093e\u0928\u093f \u091a\u093e\u0939\u0948\u0924 \u091b\u0940\u0964 \u0915\u0940 \u0939\u092e\u0930\u093e \u0908 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0905\u092a\u0928 \u092f\u094b\u091c\u0928\u093e \u092a\u0930 \u092d\u0947\u091f \u0938\u0915\u0948\u0924 \u0905\u091b\u093f?",ans12:"\u0939\u0901, \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092f\u094b\u091c\u0928\u093e\u092e\u0947 \u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u092c\u093e\u0915 \u0932\u0947\u0932 \u0906\u0935\u0936\u094d\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u0938\u092d\u0915 \u092a\u0942\u0930\u094d\u0923 \u0938\u0942\u091a\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f, \u091c\u093e\u0939\u093f \u0938\u0901 \u0928\u093e\u0917\u0930\u093f\u0915 \u0906\u0938\u093e\u0928\u0940\u0938\u0901 \u0924\u0948\u092f\u093e\u0930\u0940 \u0906 \u0906\u0935\u0947\u0926\u0928 \u0915\u093d \u0938\u0915\u0948\u0924 \u091b\u0925\u093f\u0964",ques13:"\u0915\u0940 \u0939\u092e \u0905\u092a\u0928 \u092f\u094b\u091c\u0928\u093e\u0915 \u092e\u093e\u0927\u094d\u092f\u092e\u0938\u0901 \u092f\u094b\u091c\u0928\u093e \u0938\u092d\u0915 \u0932\u0947\u0932 \u0906\u0935\u0947\u0926\u0928 \u0915\u093d \u0938\u0915\u0948\u0924 \u091b\u0940?",ans13:"\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u092f\u093e \u0935\u093f\u092d\u093e\u0917 \u0915\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092f\u094b\u091c\u0928\u093e \u0906\u0935\u0947\u0926\u0928 \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u092a\u0941\u0928\u0930\u094d\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0915\u0930\u0948 \u091b\u0948\u0915\u0964 \u0906\u0917\u093e\u092e\u0940 \u091a\u0930\u0923\u092e\u0947 \u0908 \u092a\u0930\u093f\u0915\u0932\u094d\u092a\u0928\u093e \u0915\u092f\u0932 \u0917\u0947\u0932 \u0905\u091b\u093f \u091c\u0947 \u0928\u093e\u0917\u0930\u093f\u0915 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094b\u0930\u094d\u091f\u0932/\u0909\u092e\u0902\u0917 \u0905\u0928\u0941\u092a\u094d\u0930\u092f\u094b\u0917\u0915 \u092e\u093e\u0927\u094d\u092f\u092e\u0938\u0901 \u092f\u094b\u091c\u0928\u093e \u0938\u092d\u0915 \u0932\u0947\u0932 \u0906\u0935\u0947\u0926\u0928 \u0915\u093d \u0938\u0915\u0925\u093f\u0964",ques14:'\u0915\u094b\u0928\u094b \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0915 \u0932\u0947\u0932 \u0938\u092c\u0938\u0901 \u0909\u092a\u092f\u0941\u0915\u094d\u0924 \u092f\u094b\u091c\u0928\u093e\u0938\u092d\u0915 \u0905\u0928\u094d\u0935\u0947\u0937\u0923 \u0915\u0930\u092c\u093e\u0915 \u0932\u0947\u0932, \u092e\u093e\u0908\u0938\u094d\u0915\u0940\u092e\u0915 "\u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0916\u094b\u091c" \u0938\u0941\u0935\u093f\u0927\u093e\u092e\u0947 \u0915\u094b\u0928-\u0915\u094b\u0928 \u0935\u093f\u0935\u0930\u0923 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u092c\u093e\u0915 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0905\u091b\u093f?',ans14:'\u092e\u093e\u0908\u0938\u094d\u0915\u0940\u092e\u0915 "\u092a\u0930\u094d\u0938\u0928\u0932\u093e\u0907\u091c\u094d\u0921 \u0938\u0930\u094d\u091a" \u092b\u0940\u091a\u0930\u0915 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u092c\u093e\u0915 \u0932\u0947\u0932 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947\u0901 \u0932\u093f\u0902\u0917, \u0906\u092f\u0941, \u0935\u0948\u0935\u093e\u0939\u093f\u0915 \u0938\u094d\u0925\u093f\u0924\u093f, \u0930\u093e\u091c\u094d\u092f, \u0928\u093f\u0935\u093e\u0938 \u0938\u094d\u0925\u093e\u0928 (\u0936\u0939\u0930\u0940 \u092f\u093e \u0917\u094d\u0930\u093e\u092e\u0940\u0923), \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0936\u094d\u0930\u0947\u0923\u0940, \u0905\u0915\u094d\u0937\u092e\u0924\u093e \u0938\u094d\u0925\u093f\u0924\u093f, \u0905\u0932\u094d\u092a\u0938\u0902\u0916\u094d\u092f\u0915 \u0938\u094d\u0925\u093f\u0924\u093f, \u0930\u094b\u091c\u0917\u093e\u0930 \u0938\u094d\u0925\u093f\u0924\u093f, \u0906 \u0905\u0928\u094d\u092f \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u091c\u0947\u0939\u0928 \u092c\u0941\u0928\u093f\u092f\u093e\u0926\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0935\u093f\u0935\u0930\u0923 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u092f \u0915\u0947 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u091b\u0948\u0915\u0964 \u0908 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0915\u0947 \u0932\u0947\u0932 \u0938\u092c\u0938\u0901 \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u092a\u0939\u091a\u093e\u0928 \u0915\u0930\u0948 \u092e\u0947 \u092e\u0926\u0926 \u0915\u0930\u0948\u0924 \u091b\u0948\u0915\u0964',ques15:'"\u091a\u0947\u0915 \u090f\u0932\u093f\u091c\u093f\u092c\u093f\u0932\u093f\u091f\u0940 \u0915\u094d\u0935\u0947\u0936\u094d\u091a\u0928\u0947\u092f\u0930" \u092b\u0940\u091a\u0930 \u0915\u0940 \u091b\u0948?',ans15:'"\u091a\u0947\u0915 \u090f\u0932\u093f\u091c\u093f\u092c\u093f\u0932\u093f\u091f\u0940 \u0915\u094d\u0935\u0947\u0936\u094d\u091a\u0928\u0947\u092f\u0930" \u0938\u0941\u0935\u093f\u0927\u093e \u092f\u094b\u091c\u0928\u093e-\u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092a\u093e\u0924\u094d\u0930\u0924\u093e \u092e\u093e\u0928\u0926\u0902\u0921\u092a\u0930 \u0915\u0947\u0928\u094d\u0926\u094d\u0930\u093f\u0924 \u0905\u091b\u093f \u0906 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0938\u092d\u0915\u0947\u0901 \u090f\u0915\u091f\u093e \u0938\u0930\u0932 \u0939\u093e\u0901/\u0928\u0939\u093f-\u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u094d\u0930\u0936\u094d\u0928\u093e\u0935\u0932\u0940\u0915 \u092e\u093e\u0927\u094d\u092f\u092e\u0938\u0901 \u0905\u092a\u0928 \u092f\u094b\u0917\u094d\u092f\u0924\u093e\u0915 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u0930\u092c\u093e\u092e\u0947 \u0938\u0915\u094d\u0937\u092e \u092c\u0928\u092c\u0948\u0924 \u0905\u091b\u093f\u0964 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u092f\u0932 \u0917\u0947\u0932 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e\u0915 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u091c\u0932\u094d\u0926\u0940\u0938\u0901 \u0906\u0915\u0932\u0928 \u0915\u093d \u0938\u0915\u0948\u0924 \u091b\u0925\u093f \u091c\u0947 \u0913 \u0915\u094b\u0928\u094b \u0935\u093f\u0936\u0947\u0937 \u092f\u094b\u091c\u0928\u093e\u0915 \u092a\u093e\u0924\u094d\u0930 \u091b\u0925\u093f \u0915\u093f \u0928\u0939\u093f\u0964',ques16:"\u0915\u0940 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e\u092e\u0947 \u091a\u0948\u091f\u092c\u0949\u091f\u0915 \u0938\u0941\u0935\u093f\u0927\u093e \u0905\u091b\u093f, \u0906 \u0908 \u0928\u093e\u0917\u0930\u093f\u0915\u0938\u092d\u0915 \u0915\u094b\u0928\u093e \u092e\u0926\u0924\u093f \u0915\u0930\u0948\u0924 \u0905\u091b\u093f?",ans16:"\u0939\u0901, \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u090f\u0915\u091f\u093e \u0906\u0935\u093e\u091c-\u0938\u0915\u094d\u0937\u092e, \u092c\u0939\u0941\u092d\u093e\u0937\u0940 \u090f\u0906\u0908-\u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u091a\u0948\u091f\u092c\u0949\u091f \u0924\u0948\u0928\u093e\u0924 \u0915\u092f\u0928\u0947 \u0905\u091b\u093f \u091c\u0947 \u0928\u093e\u0917\u0930\u093f\u0915\u0938\u092d\u0915\u0947\u0901 \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0938\u092d\u0915 \u0916\u094b\u091c\u092e\u0947 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0930\u092f\u0964 \u091a\u0948\u091f\u092c\u0949\u091f \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u092a\u094d\u0930\u0936\u094d\u0928 \u0915\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0906 \u0924\u0924\u094d\u0915\u093e\u0932 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0948 \u091b\u0948, \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0947 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0901 \u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u0916\u094b\u091c \u0915\u0947 \u0938\u0930\u0932 \u0915\u0930\u0948 \u091b\u0948, \u0906 \u090f\u0915 \u0906\u0915\u0930\u094d\u0937\u0915 \u0906 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u0905\u0928\u0941\u0915\u0942\u0932 \u0905\u0928\u0941\u092d\u0935 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u093d \u0915\u0947 \u0938\u0930\u0915\u093e\u0930-\u0928\u093e\u0917\u0930\u093f\u0915 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0947 \u092c\u0922\u093e\u0935\u093e \u0926\u0948\u0924 \u091b\u0948\u0915\u0964",ques17:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u0930 \u090f\u0906\u0908 \u091a\u0948\u091f\u092c\u0949\u091f\u0915 \u092a\u094d\u0930\u092e\u0941\u0916 \u0935\u093f\u0936\u0947\u0937\u0924\u093e \u0915\u0940 \u0905\u091b\u093f?",ans17:"\u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u090f\u0906\u0908 \u091a\u0948\u091f\u092c\u0949\u091f \u0906\u0935\u093e\u091c \u0906 \u092a\u093e\u0920-\u0906\u0927\u093e\u0930\u093f\u0924 \u092c\u093e\u0924\u091a\u0940\u0924, \u0939\u093f\u0928\u094d\u0926\u0940 \u0906 \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940\u092e\u0947 \u0926\u094d\u0935\u093f\u092d\u093e\u0937\u0940 \u0938\u092e\u0930\u094d\u0925\u0928, \u0938\u0902\u0926\u0930\u094d\u092d-\u091c\u093e\u0917\u0930\u0942\u0915 \u0935\u093e\u0930\u094d\u0924\u093e\u0932\u093e\u092a, \u0938\u0924\u094d\u0930-\u0906\u0927\u093e\u0930\u093f\u0924 \u091a\u0948\u091f \u0907\u0924\u093f\u0939\u093e\u0938, \u0906 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e\u0938\u092d\u0915\u0947\u0901 \u092a\u094d\u0930\u0924\u093f\u0932\u093f\u092a\u093f \u0906 \u0938\u093e\u091d\u093e \u0915\u0930\u092c\u093e\u0915 \u0935\u093f\u0915\u0932\u094d\u092a \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f, \u091c\u0947 \u090f\u0915 \u0928\u093f\u0930\u094d\u092c\u093e\u0927 \u0906 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e-\u0905\u0928\u0941\u0915\u0942\u0932 \u0905\u0928\u0941\u092d\u0935 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f\u0964",ques18:"\u0939\u092e \u092f\u094b\u091c\u0928\u093e \u0938\u092d\u0915 \u0935\u093f\u0937\u092f-\u0935\u0938\u094d\u0924\u0941\u0915 \u0938\u0902\u092c\u0902\u0927\u092e\u0947 \u0905\u092a\u0928 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u094b\u0928\u093e \u0926\u093d \u0938\u0915\u0948\u0924 \u091b\u0940?",ans18:'\u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092f\u094b\u091c\u0928\u093e \u092a\u0943\u0937\u094d\u0920\u0915 \u0928\u093f\u091a\u0932\u093e \u092d\u093e\u0917\u092e\u0947 "\u0915\u0940 \u0908 \u0938\u0939\u093e\u092f\u0915 \u091b\u0932?" \u092b\u0940\u0921\u092c\u0948\u0915 \u0938\u0947\u0915\u094d\u0936\u0928 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f, \u091c\u093e\u0939\u093f \u0938\u0901 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0938\u093e\u092e\u0917\u094d\u0930\u0940\u0915\u0947\u0901 1 \u0938\u0901 5 \u0938\u094d\u091f\u093e\u0930 \u0924\u0915 \u0930\u0947\u091f \u0915\u093d \u0938\u0915\u0948\u0924 \u091b\u0925\u093f \u0906 \u0905\u092a\u0928 \u0905\u0928\u0941\u092d\u0935, \u0938\u0941\u091d\u093e\u0935 \u092f\u093e \u092b\u0940\u0921\u092c\u0948\u0915 \u0938\u093e\u091d\u093e \u0915\u093d \u0938\u0915\u0948\u0924 \u091b\u0925\u093f\u0964 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0908\u092e\u0947\u0932 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0901 support-myscheme@digitalindia.gov.in \u092a\u0930 \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u0947\u0939\u094b \u092a\u0920\u093e \u0938\u0915\u0948\u0924 \u091b\u0925\u093f, \u091c\u093e\u0939\u093f \u0938\u0901 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0915\u0947 \u0928\u093f\u0930\u0902\u0924\u0930 \u0938\u0941\u0927\u093e\u0930 \u0906 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u092f \u092e\u0947 \u092e\u0926\u0926 \u092d\u0947\u091f\u0924\u0964',ques19:"\u0915\u094b\u0928\u094b \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u0930 \u0915\u094b\u0928\u093e \u0938\u093e\u0907\u0928 \u0905\u092a \u0915\u093d \u0938\u0915\u0948\u0924 \u0905\u091b\u093f \u092f\u093e \u0938\u093e\u0907\u0928 \u0907\u0928 \u0915\u094b\u0928\u093e \u0915\u093d \u0938\u0915\u0948\u0924 \u0905\u091b\u093f?",ans19:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0947\u0930\u093f\u092a\u0947\u0939\u091a\u093e\u0928 (\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u090f\u0915\u0932 \u0938\u093e\u0907\u0928-\u0911\u0928) \u0915 \u0938\u0902\u0917 \u090f\u0915\u0940\u0915\u0943\u0924 \u0905\u091b\u093f, \u091c\u093e\u0939\u093f \u0938\u0901 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0905\u092a\u0928 \u092e\u0947\u0930\u093f\u092a\u0947\u0939\u091a\u093e\u0928 \u092a\u0930\u093f\u091a\u092f \u092a\u0924\u094d\u0930\u0915 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0948\u0924 \u0938\u093e\u0907\u0928 \u0905\u092a \u0935\u093e \u0938\u093e\u0907\u0928 \u0907\u0928 \u0915\u093d \u0938\u0915\u0948\u0924 \u091b\u0925\u093f\u0964 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u092c\u093f\u0928\u093e \u0938\u093e\u0907\u0928 \u0907\u0928 \u0915\u092f\u0932 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0915\u0947\u0901 \u092c\u094d\u0930\u093e\u0909\u091c\u093c \u0906 \u0938\u0930\u094d\u091a \u0915\u093d \u0938\u0915\u0948\u0924 \u091b\u0925\u093f\u0964 \u092e\u0941\u0926\u093e, \u0938\u093e\u0907\u0928 \u0907\u0928 \u0915\u0930\u092c\u093e\u0938\u0901 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0938\u092d\u0915\u0947\u0901 \u0905\u092a\u0928 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0938\u0947\u0935 \u0915\u0930\u092c\u093e\u0915, \u092f\u094b\u091c\u0928\u093e\u0915\u0947\u0901 \u092c\u0941\u0915\u092e\u093e\u0930\u094d\u0915 \u0915\u0930\u092c\u093e\u0915, \u0906 \u0938\u0947\u0935 \u0915\u092f\u0932 \u0917\u0947\u0932 \u0935\u093f\u0935\u0930\u0923\u0915 \u0906\u0927\u093e\u0930\u092a\u0930 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0905\u0928\u0941\u0936\u0902\u0938\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u092c\u093e\u0915 \u0905\u0935\u0938\u0930 \u092d\u0947\u091f\u0948\u0924 \u0905\u091b\u093f\u0964",ques20:"\u0939\u092e \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0915\u094b\u0928\u094b \u092f\u094b\u091c\u0928\u093e \u0915\u0947\u0928\u093e \u0924\u093e\u0915 \u0938\u0915\u0948\u0924 \u091b\u0940?",ans20:"\u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092f\u094b\u091c\u0928\u093e\u0915\u0947\u0901 \u0924\u0915\u092c\u093e\u0915 \u0906 \u0916\u094b\u091c\u092c\u093e\u0915 \u0905\u0928\u0947\u0915 \u0924\u0930\u0940\u0915\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f, \u091c\u093e\u0939\u093f\u092e\u0947 \u092f\u094b\u091c\u0928\u093e\u0915 \u0928\u093e\u092e \u0935\u093e \u092e\u0941\u0916\u094d\u092f \u0936\u092c\u094d\u0926\u0915 \u0905\u0928\u0941\u0938\u093e\u0930 \u0916\u094b\u091c, \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0905\u0928\u0941\u0936\u0902\u0938\u093e, \u0930\u093e\u091c\u094d\u092f/\u0915\u0947\u0928\u094d\u0926\u094d\u0930 \u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936 \u0935\u093e \u0915\u0947\u0928\u094d\u0926\u094d\u0930 \u0938\u0930\u0915\u093e\u0930\u0915 \u092f\u094b\u091c\u0928\u093e\u0938\u092d \u0926\u094d\u0935\u093e\u0930\u093e \u091b\u093e\u0928-\u092c\u0940\u0928, \u092f\u094b\u091c\u0928\u093e \u0932\u093e\u092d \u0936\u094d\u0930\u0947\u0923\u0940\u0938\u092d \u0926\u094d\u0935\u093e\u0930\u093e \u092c\u094d\u0930\u093e\u0909\u091c\u093c\u093f\u0902\u0917, \u0906 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0938\u0939\u093e\u092f\u0924\u093e\u0915 \u0932\u0947\u0932 \u090f\u0906\u0908-\u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u091a\u0948\u091f\u092c\u0949\u091f\u0915 \u0909\u092a\u092f\u094b\u0917 \u0936\u093e\u092e\u093f\u0932 \u0905\u091b\u093f\u0964",viewMore:"\u0905\u09