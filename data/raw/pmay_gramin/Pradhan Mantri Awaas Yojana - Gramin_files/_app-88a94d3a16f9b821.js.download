lityStatementText","<p> \u0939\u092e \u0908 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u092f \u0932\u0947\u0932 \u092a\u094d\u0930\u0924\u093f\u092c\u0926\u094d\u0927 \u091b\u0940 \u0915\u093f \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0910\u092a \u0909\u092a\u092f\u094b\u0917, \u0924\u0915\u0928\u0940\u0915 \u092f\u093e \u0915\u094d\u0937\u092e\u0924\u093e \u092e\u0947 \u0915\u094b\u0928\u094b \u0909\u092a\u0915\u0930\u0923\u0915 \u092a\u0930\u0935\u093e\u0939 \u0915\u093f\u090f \u092c\u093f\u0928\u093e \u0938\u092d \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u0932\u0947\u0932 \u0938\u0941\u0932\u092d \u0939\u094b\u0964 \u090f\u0915\u0930\u093e \u090f\u0915\u091f\u093e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0938\u0901 \u092c\u0928\u093e\u0913\u0932 \u0917\u0947\u0932 \u091b\u0948, \u0924\u093e\u0915\u093f \u0913\u0915\u0930 \u0906\u0917\u0902\u0924\u0941\u0915 \u0915\u0947 \u0905\u0927\u093f\u0915\u0924\u092e \u092a\u0939\u0941\u0902\u091a \u0906 \u0909\u092a\u092f\u094b\u0917\u093f\u0924\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0948\u0932 \u091c\u093e \u0938\u0915\u092f\u0964 \u090f\u0915\u0930 \u092a\u0930\u093f\u0923\u093e\u092e\u0938\u094d\u0935\u0930\u0942\u092a \u0908 \u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u0915\u0947\u0901 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0909\u092a\u0915\u0930\u0923 \u091c\u0947\u0928\u093e \u0921\u0947\u0938\u094d\u0915\u091f\u0949\u092a/\u0932\u0948\u092a\u091f\u0949\u092a \u0915\u0902\u092a\u094d\u092f\u0942\u091f\u0930, \u0935\u0947\u092c-\u0938\u0915\u094d\u0937\u092e \u092e\u094b\u092c\u093e\u0907\u0932 \u0909\u092a\u0915\u0930\u0923 \u0906\u0926\u093f \u0938\u0901 \u0926\u0947\u0916\u0932 \u091c\u093e \u0938\u0915\u092f\u0964 </p> <p> \u0939\u092e \u0908 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u092f \u0915\u0947 \u0932\u0947\u0932 \u0905\u092a\u0928 \u0938\u0930\u094d\u0935\u0936\u094d\u0930\u0947\u0937\u094d\u0920 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0948\u0932 \u0917\u0947\u0932 \u091b\u0948 \u0915\u093f \u090f\u0939\u093f \u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u092a\u0930 \u0938\u092c \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0935\u093f\u0915\u0932\u093e\u0902\u0917 \u0932\u094b\u0915 \u0915\u0947 \u0932\u0947\u0932 \u0938\u0941\u0932\u092d \u0939\u094b\u0964 \u0909\u0926\u093e\u0939\u0930\u0923 \u0915\u0947 \u0932\u0947\u0932, \u090f\u0915 \u0926\u0943\u0937\u094d\u091f\u093f\u092c\u093e\u0927\u093f\u0924 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0938\u0939\u093e\u092f\u0915 \u0924\u0915\u0928\u0940\u0915, \u091c\u0947\u0928\u093e \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0930\u0940\u0921\u0930 \u0906 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0906\u0935\u0930\u094d\u0927\u0915 \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u093d \u090f\u0939\u093f \u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u0924\u0915 \u092a\u0939\u0941\u0901\u091a \u0915\u093d \u0938\u0915\u0948 \u091b\u0948\u0964 </p> <p> \u0939\u092e\u0930 \u0932\u0915\u094d\u0937\u094d\u092f \u092e\u093e\u0928\u0915 \u0915\u0947 \u0905\u0928\u0941\u092a\u093e\u0932\u0928 \u0915\u0930\u0948 \u0906\u0930 \u0938\u093f\u0926\u094d\u0927\u093e\u0928\u094d\u0924\u0915 \u092a\u093e\u0932\u0928 \u0915\u0930\u0948 \u0915\u0947 \u0938\u0947\u0939\u094b \u091b\u0948\u0915\u0964 \u092c\u093e\u0939\u0930\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u0938\u092d\u0964 \u092c\u093e\u0939\u0930\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u0915 \u0930\u0916\u0930\u0916\u093e\u0935 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0935\u093f\u092d\u093e\u0917\u0938\u092d \u0926\u094d\u0935\u093e\u0930\u093e \u0915\u092f\u0932 \u091c\u093e\u0907\u0924 \u0905\u091b\u093f \u091c\u0947 \u090f\u0939\u093f \u0938\u093e\u0907\u091f\u0938\u092d\u0915\u0947\u0901 \u0938\u0941\u0932\u092d \u092c\u0928\u0947\u092c\u093e\u0915 \u0932\u0947\u0932 \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u0940 \u0905\u091b\u093f\u0964 </p> <p> \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0905\u092a\u0928 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e\u0915\u0947\u0901 \u0935\u093f\u0915\u0932\u093e\u0902\u0917 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0915 \u0932\u0947\u0932 \u0938\u0941\u0932\u092d \u092c\u0928\u0947\u092c\u093e\u0915 \u0926\u093f\u0936\u093e\u092e\u0947 \u0915\u093e\u091c \u0915\u093d \u0930\u0939\u0932 \u0905\u091b\u093f, \u092f\u0926\u094d\u092f\u092a\u093f \u0935\u0930\u094d\u0924\u092e\u093e\u0928\u092e\u0947 \u092a\u094b\u0930\u094d\u091f\u0947\u092c\u0932 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092a\u094d\u0930\u093e\u0930\u0942\u092a (\u092a\u0940\u0921\u0940\u090f\u092b) \u092b\u093e\u0907\u0932\u0938\u092d \u0938\u0941\u0932\u092d \u0928\u0939\u093f \u0905\u091b\u093f\u0964 \u090f\u0915\u0930 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924, \u0939\u093f\u0928\u094d\u0926\u0940 \u092d\u093e\u0937\u093e\u092e\u0947 \u0926\u0947\u0932 \u0917\u0947\u0932 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0938\u0947\u0939\u094b \u0938\u0941\u0932\u092d \u0928\u0939\u093f \u0905\u091b\u093f\u0964 </p> <p> \u092f\u0926\u093f \u0905\u0939\u093e\u0901\u0915\u0947\u0901 \u090f\u0939\u093f \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e\u0915 \u0938\u0941\u0932\u092d\u0924\u093e\u0915 \u0938\u0902\u092c\u0902\u0927\u092e\u0947 \u0915\u094b\u0928\u094b \u0938\u092e\u0938\u094d\u092f\u093e \u092f\u093e \u0938\u0941\u091d\u093e\u0935 \u0905\u091b\u093f, \u0924\u0901 \u0915\u0943\u092a\u092f\u093e \u0939\u092e\u0930\u093e \u0938\u092d\u0915\u0947\u0901 support-myscheme[at]myScheme[dot]gov[dot]in \u0932\u093f\u0916\u0942 \u091c\u0947 \u0939\u092e\u0930\u093e \u0938\u092d\u0915\u0947\u0901 \u0938\u0939\u093e\u092f\u0915 \u0924\u0930\u0940\u0915\u093e\u0938\u0901 \u091c\u0935\u093e\u092c \u0926\u0947\u092c\u093e\u092e\u0947 \u0938\u0915\u094d\u0937\u092e \u092c\u0928\u093e \u0938\u0915\u092f\u0964 \u0915\u0940 \u0939\u092e\u0930\u093e \u0938\u092d\u0915\u0947\u0901 \u0905\u092a\u0928 \u0938\u0902\u092a\u0930\u094d\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940\u0915 \u0938\u0919\u094d\u0917 \u0938\u092e\u0938\u094d\u092f\u093e\u0915 \u092a\u094d\u0930\u0915\u0943\u0924\u093f \u092c\u0924\u093e\u0909\u0964"),(0,xe.Z)(he,"privacyPolicy","\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f"),(0,xe.Z)(he,"hyperlinkPolicy","\u0939\u093e\u0907\u092a\u0930\u0932\u093f\u0902\u0915\u093f\u0902\u0917 \u0928\u0940\u0924\u093f"),(0,xe.Z)(he,"termsOfUse","\u0909\u092a\u092f\u094b\u0917\u0915 \u0936\u0930\u094d\u0924\u0938\u092d"),(0,xe.Z)(he,"terms","\u0928\u093f\u092f\u092e \u0906 \u0936\u0930\u094d\u0924\u0938\u092d"),(0,xe.Z)(he,"copyrightPolicy","\u092a\u094d\u0930\u0924\u093f\u0932\u093f\u092a\u093f \u0905\u0927\u093f\u0915\u093e\u0930 \u0928\u0940\u0924\u093f"),(0,xe.Z)(he,"termsConditions","<p> \u0928\u093f\u092f\u092e \u0906 \u0936\u0930\u094d\u0924\u0938\u092d </p>"),(0,xe.Z)(he,"copyrightPolicyText","\u090f\u0939\u093f \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0938\u093e\u092e\u0917\u094d\u0930\u0940\u0915\u0947\u0901 \u0928\u093f\u0903\u0936\u0941\u0932\u094d\u0915 \u092a\u0941\u0928\u0930\u0941\u0924\u094d\u092a\u093e\u0926\u093f\u0924 \u0915\u092f\u0932 \u091c\u093e \u0938\u0915\u0948\u0924 \u0905\u091b\u093f\u0964 \u092e\u0941\u0926\u093e, \u0938\u093e\u092e\u0917\u094d\u0930\u0940\u0915\u0947\u0901 \u0938\u091f\u0940\u0915 \u0930\u0942\u092a\u0938\u0901 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u092c\u093e\u0915 \u091a\u093e\u0939\u0940 \u0906 \u0905\u092a\u092e\u093e\u0928\u091c\u0928\u0915 \u0924\u0930\u0940\u0915\u093e\u0938\u0901 \u0905\u0925\u0935\u093e \u092d\u094d\u0930\u093e\u092e\u0915 \u0938\u0928\u094d\u0926\u0930\u094d\u092d\u092e\u0947 \u090f\u0915\u0930 \u0909\u092a\u092f\u094b\u0917 \u0928\u0939\u093f \u0915\u0930\u092c\u093e\u0915 \u091a\u093e\u0939\u0940\u0964 \u091c\u0924\u093d \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u092f\u0932 \u091c\u093e \u0930\u0939\u0932 \u0905\u091b\u093f \u0935\u093e \u0926\u094b\u0938\u0930\u0915\u0947\u0901 \u091c\u093e\u0930\u0940 \u0915\u092f\u0932 \u091c\u093e \u0930\u0939\u0932 \u0905\u091b\u093f, \u0938\u094d\u0930\u094b\u0924\u0915\u0947\u0901 \u092a\u094d\u0930\u092e\u0941\u0916\u0924\u093e\u0938\u0901 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u092c\u093e\u0915 \u091a\u093e\u0939\u0940\u0964 \u092f\u0926\u094d\u092f\u092a\u093f \u090f\u0939\u093f \u0938\u093e\u092e\u0917\u094d\u0930\u0940\u0915 \u092a\u0941\u0928\u0930\u0941\u0924\u094d\u092a\u093e\u0926\u0928 \u0915\u0930\u092c\u093e\u0915 \u0905\u0928\u0941\u092e\u0924\u093f \u0915\u094b\u0928\u094b \u090f\u0939\u0928 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092a\u0930 \u0928\u0939\u093f \u0926\u0947\u0932 \u091c\u093e\u092f\u0924 \u091c\u0915\u0930 \u092a\u0939\u091a\u093e\u0928 \u0915\u094b\u0928\u094b \u0924\u0943\u0924\u0940\u092f \u092a\u0915\u094d\u0937 (\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0938\u093e\u092e\u0917\u094d\u0930\u0940) \u0915 \u092a\u094d\u0930\u0924\u093f\u0932\u093f\u092a\u094d\u092f\u093e\u0927\u093f\u0915\u093e\u0930\u0915 \u0930\u0942\u092a\u092e\u0947 \u0915\u092f\u0932 \u0917\u0947\u0932 \u0939\u094b\u0964 \u090f\u0939\u0928 \u0938\u093e\u092e\u0917\u094d\u0930\u0940\u0915 \u092a\u0941\u0928\u0930\u0941\u0924\u094d\u092a\u093e\u0926\u0928\u0915 \u0905\u0927\u093f\u0915\u093e\u0930 \u0938\u092e\u094d\u092c\u0928\u094d\u0927\u093f\u0924 \u092a\u094d\u0930\u0924\u093f\u0932\u093f\u092a\u093f \u0905\u0927\u093f\u0915\u093e\u0930 \u0927\u093e\u0930\u0915\u0938\u0901 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u092c\u093e\u0915 \u091a\u093e\u0939\u0940\u0964"),(0,xe.Z)(he,"privacyPolicyText","<p> \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a\u0938\u0901 \u0905\u0939\u093e\u0901\u0938\u0901 \u0915\u094b\u0928\u094b \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 (\u091c\u0947\u0928\u093e \u0928\u093e\u092e, \u092b\u094b\u0928 \u0928\u092e\u094d\u092c\u0930 \u092f\u093e \u0908-\u092e\u0947\u0932 \u092a\u0924\u093e) \u0928\u0939\u093f \u092a\u0915\u0921\u093c\u0948\u0924 \u0905\u091b\u093f, \u091c\u0947 \u0905\u0939\u093e\u0901\u0915\u0947\u0901 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0930\u0942\u092a\u0938\u0901 \u0905\u0939\u093e\u0901\u0915 \u092a\u0939\u093f\u091a\u093e\u0928 \u0915\u0930\u092c\u093e\u0915 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0948\u0924 \u0905\u091b\u093f\u0964 \u091c\u0901 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0905\u0939\u093e\u0901\u0915\u0947\u0901 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u092c\u093e\u0915 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f, \u0924\u0901 \u0905\u0939\u093e\u0901\u0915\u0947\u0901 \u0913\u0939\u093f \u0935\u093f\u0936\u0947\u0937 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u0915 \u0932\u0947\u0932 \u0938\u0942\u091a\u093f\u0924 \u0915\u092f\u0932 \u091c\u093e\u092f\u0924 \u091c\u0915\u0930 \u0932\u0947\u0932 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u090f\u0915\u0924\u094d\u0930\u093f\u0924 \u0915\u092f\u0932 \u091c\u093e\u0907\u0924 \u0905\u091b\u093f \u0906 \u0905\u0939\u093e\u0901\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0932\u0947\u0932 \u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0909\u092a\u093e\u092f \u0915\u092f\u0932 \u091c\u093e\u092f\u0924\u0964 \u0939\u092e \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u0930 \u0938\u094d\u0935\u0948\u091a\u094d\u091b\u093f\u0915 \u0930\u0942\u092a\u0938\u0901 \u0915\u094b\u0928\u094b \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u092a\u0939\u091a\u093e\u0928 \u092f\u094b\u0917\u094d\u092f \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u094b\u0928\u094b \u0924\u0943\u0924\u0940\u092f \u092a\u0915\u094d\u0937 (\u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915/\u0928\u093f\u091c\u0940) \u0915\u0947\u0901 \u0928\u0939\u093f \u092c\u0947\u091a\u0948\u0924 \u091b\u0940 \u0935\u093e \u0938\u093e\u091d\u093e \u0928\u0939\u093f \u0915\u0930\u0948\u0924 \u091b\u0940\u0964 \u090f\u0939\u093f \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0926\u0947\u0932 \u0917\u0947\u0932 \u0915\u094b\u0928\u094b \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0939\u093e\u0928\u093f, \u0926\u0941\u0930\u0941\u092a\u092f\u094b\u0917, \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u092a\u0939\u0941\u0901\u091a \u092f\u093e \u092a\u094d\u0930\u0915\u091f\u0940\u0915\u0930\u0923, \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928, \u092f\u093e \u0935\u093f\u0928\u093e\u0936\u0938\u0901 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0939\u0924\u0964 \u0939\u092e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0915 \u092c\u093e\u0930\u0947\u092e\u0947 \u0915\u093f\u091b\u0941 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u090f\u0915\u0924\u094d\u0930 \u0915\u0930\u0948\u0924 \u091b\u0940, \u091c\u0947\u0928\u093e \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 (\u0906\u0908\u092a\u0940) \u092a\u0924\u093e, \u0921\u094b\u092e\u0947\u0928 \u0928\u093e\u092e, \u092c\u094d\u0930\u093e\u0909\u091c\u093c\u0930 \u092a\u094d\u0930\u0915\u093e\u0930\u0964"),(0,xe.Z)(he,"hyperlinkPolicyText","<p> <strong> \u092c\u093e\u0939\u0930\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u0938\u092d/\u092a\u094d\u0932\u0947\u091f\u092b\u0930\u094d\u092e\u0938\u092d\u0915 \u0932\u093f\u0902\u0915 </strong> </p> <p> \u090f\u0939\u093f \u092a\u094d\u0932\u0947\u091f\u092b\u0930\u094d\u092e\u092e\u0947 \u0915\u0924\u0947\u0915\u094b \u0938\u094d\u0925\u093e\u0928\u092a\u0930 \u0905\u0939\u093e\u0901\u0915\u0947\u0901 \u0906\u0928 \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u0938\u092d/\u092a\u094d\u0932\u0947\u091f\u092b\u0930\u094d\u092e\u0938\u092d\u0915 \u0932\u093f\u0902\u0915 \u092d\u0947\u091f\u0924\u0964 \u0932\u093f\u0902\u0915\u0938\u092d \u0905\u0939\u093e\u0901\u0915 \u0938\u0941\u0935\u093f\u0927\u093e\u0915 \u0932\u0947\u0932 \u0930\u093e\u0916\u0932 \u0917\u0947\u0932 \u0905\u091b\u093f\u0964 \u0932\u093f\u0902\u0915 \u0915\u092f\u0932 \u0917\u0947\u0932 \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u0915 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0906 \u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f\u0924\u093e\u0915 \u0932\u0947\u0932 \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u0940 \u0928\u0939\u093f \u0905\u091b\u093f \u0906 \u091c\u0930\u0942\u0930\u0940 \u0928\u0939\u093f \u0905\u091b\u093f \u091c\u0947 \u0913\u0939\u093f\u092e\u0947 \u0935\u094d\u092f\u0915\u094d\u0924 \u0935\u093f\u091a\u093e\u0930\u0938\u092d\u0915 \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0930\u0948\u0924 \u0939\u094b\u0964 \u092e\u093e\u0924\u094d\u0930 \u0932\u093f\u0902\u0915\u0915 \u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f \u0935\u093e \u090f\u0939\u093f \u092a\u094d\u0932\u0947\u091f\u092b\u0930\u094d\u092e\u092a\u0930 \u090f\u0915\u0930 \u0938\u0942\u091a\u0940\u0915\u0947\u0901 \u0915\u094b\u0928\u094b \u092a\u094d\u0930\u0915\u093e\u0930\u0915 \u0938\u092e\u0930\u094d\u0925\u0928\u0915 \u0930\u0942\u092a\u092e\u0947 \u0928\u0939\u093f \u092e\u093e\u0928\u0932 \u091c\u093e\u092f\u0964 \u0939\u092e \u0917\u093e\u0930\u0902\u091f\u0940 \u0928\u0939\u093f \u0926\u093d \u0938\u0915\u0948\u0924 \u091b\u0940 \u091c\u0947 \u0908 \u0932\u093f\u0902\u0915\u0938\u092d \u0938\u092c \u0938\u092e\u092f \u0915\u093e\u091c \u0915\u0930\u0924 \u0906 \u0932\u093f\u0902\u0915 \u0915\u092f\u0932 \u0917\u0947\u0932 \u092a\u0943\u0937\u094d\u0920\u0938\u092d\u0915 \u0909\u092a\u0932\u092c\u094d\u0927\u0924\u093e \u092a\u0930 \u0939\u092e\u0930 \u0938\u092d\u0915 \u0915\u094b\u0928\u094b \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0928\u0939\u093f \u0905\u091b\u093f\u0964 </p> <strong> \u0905\u0928\u094d\u092f \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u0938\u092d \u0926\u094d\u0935\u093e\u0930\u093e \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e\u0915 \u0932\u093f\u0902\u0915\u0938\u092d </strong> </p> <strong> \u0939\u092e\u0930\u093e \u0938\u092d\u0915\u0947\u0901 \u0915\u094b\u0928\u094b \u0906\u092a\u0924\u094d\u0924\u093f \u0928\u0939\u093f \u0905\u091b\u093f"),(0,xe.Z)(he,"termsText1","<p> \u0909\u092a\u092f\u094b\u0917\u0915 \u0908 \u0936\u0930\u094d\u0924\u0938\u092d https://www.myscheme.gov.in \u0915 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0915 \u0930\u0942\u092a\u092e\u0947 \u0905\u0939\u093e\u0901\u0915 \u0905\u0927\u093f\u0915\u093e\u0930 \u0906 \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u093f\u0924\u094d\u0935\u0915 \u0935\u0930\u094d\u0923\u0928 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f\u0964 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0916\u093e\u0924\u093e \u092c\u0928\u0947\u092c\u093e\u0915 \u0932\u0947\u0932 \u0905\u0939\u093e\u0901\u0915\u0947\u0901 \u090f\u0939\u093f \u0909\u092a\u092f\u094b\u0917\u0915 \u0936\u0930\u094d\u0924\u0938\u092d\u0915\u0947\u0901 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u092c\u093e\u0915 \u091a\u093e\u0939\u0940\u0964 </p> <p> \u090f\u092e\u0908\u0906\u0908\u091f\u0940\u0935\u093e\u0908 \u0906 \u092d\u093e\u0930\u0924 \u0938\u0930\u0915\u093e\u0930 \u0915\u094b\u0928\u094b \u0938\u092e\u092f \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0906 \u090f\u0939\u093f \u0909\u092a\u092f\u094b\u0917\u0915 \u0936\u0930\u094d\u0924\u0938\u092d\u092e\u0947 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0915\u0930\u092c\u093e\u0915 \u0905\u0927\u093f\u0915\u093e\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0948\u0924 \u0905\u091b\u093f\u0964 \u091c\u0901 \u0913 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0905\u0939\u093e\u0901\u0915 \u0905\u0927\u093f\u0915\u093e\u0930 \u0935\u093e \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u093f\u0924\u094d\u0935\u0938\u092d\u0915\u0947\u0901 \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f \u0924\u0901 \u0905\u0939\u093e\u0901\u0915\u0947\u0901 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e\u0915 \u092e\u093e\u0927\u094d\u092f\u092e\u0938\u0901 \u0938\u0942\u091a\u093f\u0924 \u0915\u092f\u0932 \u091c\u093e\u092f\u0924\u0964 </p> <p> \u0909\u092a\u092f\u094b\u0917\u0915 \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0936\u0930\u094d\u0924\u0938\u092d \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u092d\u093d \u091c\u093e\u092f\u0924 \u0905\u091b\u093f \u0906 \u0915\u094b\u0928\u094b \u0928\u093f\u092f\u092e \u0906 \u0936\u0930\u094d\u0924\u0938\u092d\u0915\u0947\u0901 \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u093d \u0926\u0947\u0924 \u091c\u0947 \u0905\u0939\u093e\u0901 \u092a\u0939\u093f\u0928\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u092f\u0928\u0947 \u091b\u0940 \u091c\u0947 \u0905\u0939\u093e\u0901 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e\u0915 \u0909\u092a\u092f\u094b\u0917\u0915\u0947\u0901 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0930\u0948\u0924 \u091b\u0940\u0964 \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0928\u093f\u092f\u092e \u0906 \u0936\u0930\u094d\u0924\u0938\u092d \u092a\u094d\u0930\u092d\u093e\u0935\u0940 \u092d\u093d \u091c\u093e\u092f\u0924 \u0905\u091b\u093f \u091c\u0947\u0928\u093e \u0905\u0939\u093e\u0901 \u090f\u0915\u0930\u093e \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u093d \u0932\u0947\u0932\u0939\u0941\u0901 \u0906 \u0905\u092a\u0928 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0916\u093e\u0924\u093e \u092c\u0928\u093e \u0932\u0947\u0932\u0939\u0941\u0901\u0964 \u092d\u093e\u0930\u0924 \u0938\u0930\u0915\u093e\u0930\u0915 \u0938\u0902\u0917\u0920\u0928, \u0935\u093f\u092d\u093e\u0917 \u0906 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f\u0938\u092d\u0964 \u092f\u0926\u094d\u092f\u092a\u093f \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u0930 \u0938\u093e\u092e\u0917\u094d\u0930\u0940\u0915 \u0938\u091f\u0940\u0915\u0924\u093e \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u092c\u093e\u0915 \u0932\u0947\u0932 \u0938\u092d \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u092f\u0932 \u0917\u0947\u0932 \u0905\u091b\u093f, \u092e\u0941\u0926\u093e \u090f\u0915\u0930\u093e \u0915\u093e\u0928\u0942\u0928\u0915 \u092c\u092f\u093e\u0928\u0915 \u0930\u0942\u092a\u092e\u0947 \u0928\u0939\u093f \u092e\u093e\u0928\u0932 \u091c\u093e\u092f \u0905\u0925\u0935\u093e \u0915\u094b\u0928\u094b \u0915\u093e\u0928\u0942\u0928\u0940 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u0915 \u0932\u0947\u0932 \u0909\u092a\u092f\u094b\u0917 \u0928\u0939\u093f \u0915\u092f\u0932 \u091c\u093e\u092f\u0964 \u0915\u094b\u0928\u094b \u0905\u0938\u094d\u092a\u0937\u094d\u091f\u0924\u093e \u0935\u093e \u0936\u0902\u0915\u093e\u0915 \u0938\u094d\u0925\u093f\u0924\u093f\u092e\u0947, \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0938\u092d\u0915\u0947\u0901 \u0938\u0932\u093e\u0939 \u0926\u0947\u0932 \u091c\u093e\u0907\u0924 \u0905\u091b\u093f \u091c\u0947 \u0913 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f/\u0935\u093f\u092d\u093e\u0917/\u0938\u0902\u0917\u0920\u0928 \u0906/\u0935\u093e \u0905\u0928\u094d\u092f \u0938\u094d\u0930\u094b\u0924 (\u0938\u092d\u0915) \u0938\u0901 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924/\u091c\u093e\u0901\u091a \u0915\u0930\u092f \u0906 \u0909\u091a\u093f\u0924 \u092a\u0947\u0936\u0947\u0935\u0930 \u0938\u0932\u093e\u0939 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u092f\u0964 </p> <p> \u0915\u094b\u0928\u094b \u092a\u0930\u093f\u0938\u094d\u0925\u093f\u0924\u093f\u092e\u0947 \u0938\u0930\u0915\u093e\u0930\u0940 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f/\u0935\u093f\u092d\u093e\u0917/\u0938\u0902\u0917\u0920\u0928 \u092c\u093f\u0928\u093e \u0938\u0940\u092e\u093e, \u0905\u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u0935\u093e \u092a\u0930\u093f\u0923\u093e\u092e\u0940 \u0939\u093e\u0928\u093f \u0935\u093e \u0915\u094d\u0937\u0924\u093f, \u0935\u093e \u0909\u092a\u092f\u094b\u0917\u0938\u0901 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u094b\u0928\u094b \u0916\u0930\u094d\u091a, \u0939\u093e\u0928\u093f \u0935\u093e \u0915\u094d\u0937\u0924\u093f \u0932\u0947\u0932 \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u0940 \u0928\u0939\u093f \u0939\u094b\u092f\u0924\u0964"),(0,xe.Z)(he,"termsHead1","\u0909\u092a\u092f\u094b\u0917\u0915 \u0938\u0940\u092e\u093e\u0903"),(0,xe.Z)(he,"termsText2","<p> \u092e\u093e\u0908\u0938\u094d\u0915\u0940\u092e\u0915 \u0915\u094b\u0928\u094b \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u0909\u092a\u092f\u094b\u0917 \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u093f\u0924 \u0905\u091b\u093f\u0964 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0943\u0937\u094d\u0920\u0938\u092d \u0924\u0915 \u092a\u0939\u0941\u0901\u091a, \u0928\u093f\u0917\u0930\u093e\u0928\u0940, \u092f\u093e \u092a\u094d\u0930\u0924\u093f\u0932\u093f\u092a\u093f \u0915\u0930\u092c\u093e\u0915 \u0932\u0947\u0932 \u0915\u094b\u0928\u094b \u0938\u0949\u092b\u094d\u091f\u0935\u0947\u092f\u0930 (\u091c\u0947\u0928\u093e \u092c\u0949\u091f, \u0938\u094d\u0915\u094d\u0930\u0948\u092a\u0930 \u091f\u0942\u0932) \u092f\u093e \u0905\u0928\u094d\u092f \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0909\u092a\u0915\u0930\u0923\u0915 \u0909\u092a\u092f\u094b\u0917 \u0924\u0916\u0928 \u0924\u0915 \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u093f\u0924 \u0905\u091b\u093f \u091c\u0916\u0928 \u0924\u0915 \u092e\u093e\u0908\u0938\u094d\u0915\u0940\u092e \u0926\u094d\u0935\u093e\u0930\u093e \u0932\u093f\u0916\u093f\u0924 \u0930\u0942\u092a \u092e\u0947 \u0938\u094d\u092a\u0937\u094d\u091f \u0930\u0942\u092a \u0938\u0901 \u0905\u0927\u093f\u0915\u0943\u0924 \u0928\u0939\u093f \u0915\u092f\u0932 \u0917\u0947\u0932 \u0939\u094b\u0964"),(0,xe.Z)(he,"termsHead2","\u0905\u0939\u093e\u0901\u0915 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092a\u0930 \u0935\u093f\u091a\u093e\u0930 \u0915\u0930\u092f \u092c\u0932\u093e \u0928\u0940\u0924\u093f\u0903"),(0,xe.Z)(he,"termsText3","<p> \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u0930 \u0909\u092a\u092f\u094b\u0917 \u0932\u0947\u0932 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u092c \u092f\u093e \u0915\u094b\u0928\u094b \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u091c\u092e\u093e \u0915\u0930\u092c, \u0905\u0939\u093e\u0901 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e\u0915\u0947\u0901 \u090f\u0915\u091f\u093e \u0938\u094d\u0925\u093e\u092f\u0940, \u0935\u093f\u0936\u094d\u0935\u0935\u094d\u092f\u093e\u092a\u0940, \u0930\u0949\u092f\u0932\u094d\u091f\u0940-\u092e\u0941\u0915\u094d\u0924, \u0905\u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928\u0940\u092f, \u0917\u0948\u0930-\u0905\u0928\u0928\u094d\u092f \u0905\u0927\u093f\u0915\u093e\u0930 \u0906 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0948\u0924 \u091b\u0940 (\u092f\u093e \u0935\u093e\u0930\u0902\u091f \u0915\u0930\u0948\u0924 \u091b\u0940 \u091c\u0947 \u090f\u0939\u0928 \u0905\u0927\u093f\u0915\u093e\u0930\u0915 \u092e\u093e\u0932\u093f\u0915 \u0938\u094d\u092a\u0937\u094d\u091f \u0930\u0942\u092a \u0938\u0901 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u092f\u0928\u0947 \u0905\u091b\u093f), \u091c\u0915\u0930 \u0909\u092a\u092f\u094b\u0917, \u092a\u0941\u0928\u0930\u0941\u0924\u094d\u092a\u093e\u0926\u0928, \u0938\u0902\u0936\u094b\u0927\u0928, \u0905\u0928\u0941\u0915\u0942\u0932\u0928, \u092a\u094d\u0930\u0915\u093e\u0936\u0928, \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0930\u0942\u092a \u0938\u0901 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928, \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0930\u0942\u092a \u0938\u0901 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928, \u0921\u093f\u091c\u093f\u091f\u0932 \u0930\u0942\u092a \u0938\u0901 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0906 \u0921\u093f\u091c\u093f\u091f\u0932 \u0930\u0942\u092a \u0938\u0901 \u0905\u0928\u0941\u0935\u093e\u0926 \u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930 \u0905\u091b\u093f, \u090f\u0939\u0928 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0938\u0901 \u0935\u094d\u092f\u0941\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u093e\u091c \u092c\u0928\u093e\u0909 \u0906 \u0935\u093f\u0924\u0930\u093f\u0924 \u0915\u0930\u0942 \u092f\u093e \u090f\u0939\u0928 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u0947\u0901 \u0915\u094b\u0928\u094b \u0930\u0942\u092a, \u092e\u093e\u0927\u094d\u092f\u092e, \u092f\u093e \u0924\u0915\u0928\u0940\u0915 \u092e\u0947 \u0936\u093e\u092e\u093f\u0932 \u0915\u0930\u0942 \u091c\u0947 \u0906\u092c \u092a\u0942\u0930\u093e \u092c\u094d\u0930\u0939\u094d\u092e\u093e\u0923\u094d\u0921 \u092e\u0947 \u091c\u094d\u091e\u093e\u0924 \u092f\u093e \u092c\u093e\u0926 \u092e\u0947 \u0935\u093f\u0915\u0938\u093f\u0924 \u0915\u0948\u0932 \u0917\u0947\u0932 \u0905\u091b\u093f\u0964 \u0905\u0939\u093e\u0901 \u0938\u0939\u092e\u0924 \u091b\u0940 \u091c\u0947 \u0905\u0939\u093e\u0901 \u0915\u0947\u0901 \u092a\u094d\u0930\u0926\u093e\u0924\u093e \u0915\u0947 \u0916\u093f\u0932\u093e\u092b \u0915\u094b\u0928\u094b \u0915\u0925\u093f\u0924 \u092f\u093e \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u092f\u093e \u0939\u092e\u0930\u093e \u0938\u0901 \u0905\u0939\u093e\u0901\u0915 \u0938\u0902\u091a\u093e\u0930 \u092e\u0947 \u0915\u094b\u0928\u094b \u0938\u094d\u0935\u093e\u092e\u093f\u0924\u094d\u0935 \u0905\u0927\u093f\u0915\u093e\u0930 \u0915\u0947 \u0926\u0941\u0930\u0941\u092a\u092f\u094b\u0917 \u0915\u0947 \u0932\u0947\u0932 \u0915\u094b\u0928\u094b \u0938\u0939\u093e\u0930\u093e \u0928\u0939\u093f \u092d\u0947\u091f\u0924\u0964"),(0,xe.Z)(he,"termsHead3","\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0915 \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u093f\u0924\u094d\u0935\u0903"),(0,xe.Z)(he,"termsText4","<p> \u0905\u0939\u093e\u0901 \u0905\u0935\u0936\u094d\u092f: </p>"),(0,xe.Z)(he,"termsPoints","\u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092f\u093e \u0938\u0926\u0938\u094d\u092f \u0938\u0947\u0935\u093e \u0924\u0915 \u092a\u0939\u0941\u0901\u091a\u092f \u0935\u093e\u0932\u093e \u092f\u093e \u092a\u0939\u0941\u0901\u091a\u092f \u0915\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0948 \u0935\u093e\u0932\u093e \u0938\u094d\u0935\u093e\u092d\u093e\u0935\u093f\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u092c\u0928\u093f \u091c\u093e\u092f; \u0915\u093f\u0938\u0940 \u0905\u0928\u094d\u092f \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u0947 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092f\u093e \u0938\u0926\u0938\u094d\u092f \u0938\u0947\u0935\u093e \u0916\u093e\u0924\u093e \u0924\u0915 \u092a\u0939\u0941\u0901\u091a \u092f\u093e \u0932\u093f\u0902\u0915 \u092f\u093e \u092a\u0939\u0941\u0901\u091a \u092f\u093e \u0932\u093f\u0902\u0915 (\u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u092f\u093e \u0905\u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u0930\u0942\u092a \u0938\u0947) \u0915\u0947 \u0924\u0932\u093e\u0936 \u0928 \u0915\u0930\u0948; \u0915\u093f\u0938\u0940 \u0905\u0928\u094d\u092f \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u094b \u0905\u092a\u0928\u093e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e \u0914\u0930 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0928 \u0926\u0947; \u0939\u0930 \u0938\u092e\u092f \u0905\u092a\u0928\u0947 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0916\u093e\u0924\u0947 \u0915\u093e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e, \u0914\u0930 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0930\u0916\u0947\u0902 \u0914\u0930 \u0915\u093f\u0938\u0940 \u0914\u0930 \u0915\u094b \u0905\u092a\u0928\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u093e \u0916\u0941\u0932\u093e\u0938\u093e \u0928 \u0915\u0930\u0947\u0902; \u0905\u0917\u0930 \u0906\u092a\u0915\u094b \u0938\u0902\u0926\u0947\u0939 \u0939\u094b \u0915\u093f \u0906\u092a\u0915\u0947 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0916\u093e\u0924\u0947 \u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0947 \u0938\u092e\u091d\u094c\u0924\u093e \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948 \u0924\u094b \u0924\u0941\u0930\u0902\u0924 \u0939\u0947\u0932\u094d\u092a\u0921\u0947\u0938\u094d\u0915 \u0915\u094b \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0930\u0947\u0902 \u091c\u0948\u0938\u0947 \u0915\u093f\u0903 \u0906\u092a\u0915\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092f\u093e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e \u0916\u094b \u0917\u092f\u093e \u0939\u0948 \u092f\u093e \u091a\u094b\u0930\u0940 \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0901 \u0905\u092d\u093f\u0917\u092e \u0915\u0948\u0932 \u0917\u0947\u0932 \u0905\u091b\u093f, \u0906 \u0915\u0947\u0935\u0932 \u0913\u0939\u093f \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e \u0906 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0935\u093f\u0935\u0930\u0923\u0915 \u0909\u092a\u092f\u094b\u0917 \u0915\u0948\u0932 \u0917\u0947\u0932 \u0905\u091b\u093f \u091c\u0947 \u0935\u093f\u0936\u0947\u0937 \u0930\u0942\u092a \u0938\u0901 \u0905\u0939\u093e\u0901 \u0915\u0947 \u0932\u0947\u0932 \u0906\u0935\u0902\u091f\u093f\u0924 \u0915\u0948\u0932 \u0917\u0947\u0932 \u0905\u091b\u093f\u0964 </li> <li> \u0905\u0939\u093e\u0901 \u0915\u0947\u0901 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0906 \u0905\u092a\u0928 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0916\u093e\u0924\u093e\u0915 \u0909\u092a\u092f\u094b\u0917 \u092e\u093e\u0924\u094d\u0930 \u0935\u0948\u0927 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u0915 \u0932\u0947\u0932 \u0906 \u090f\u0939\u093f \u0924\u0930\u0939\u0947\u0901 \u0915\u0930\u092c \u091a\u093e\u0939\u0940 \u091c\u0947 \u0915\u094b\u0928\u094b \u0924\u0940\u0938\u0930\u0947 \u092a\u0915\u094d\u0937 \u0926\u094d\u0935\u093e\u0930\u093e \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e\u0915 \u0909\u092a\u092f\u094b\u0917 \u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930 \u0915\u0947 \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u092f\u093e \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u093f\u0924 \u092f\u093e \u092c\u093e\u0927\u093f\u0924 \u0928\u0948 \u0915\u0930\u092f\u0964 \u090f\u0939\u093f\u092e\u0947 \u090f\u0939\u0928 \u0906\u091a\u0930\u0923 \u0936\u093e\u092e\u093f\u0932 \u0905\u091b\u093f \u091c\u0947 \u0917\u0948\u0930\u0915\u093e\u0928\u0942\u0928\u0940 \u0905\u091b\u093f \u092f\u093e \u091c\u0947 \u0915\u094b\u0928\u094b \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u0947 \u092a\u0930\u0947\u0936\u093e\u0928 \u092f\u093e \u092a\u0930\u0947\u0936\u093e\u0928\u0940 \u092f\u093e \u0905\u0938\u0941\u0935\u093f\u0927\u093e \u092a\u0948\u0926\u093e \u0915\u093d \u0938\u0915\u0948\u0924 \u0905\u091b\u093f, \u0905\u0936\u094d\u0932\u0940\u0932 \u092f\u093e \u0906\u092a\u0924\u094d\u0924\u093f\u091c\u0928\u0915 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u0947 \u092a\u094d\u0930\u0938\u093e\u0930\u0923, \u092f\u093e \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092e\u0947 \u0935\u094d\u092f\u0935\u0927\u093e\u0928 \u092a\u0948\u0926\u093e \u0915\u093d \u0938\u0915\u0948\u0924 \u0905\u091b\u093f\u0964"),(0,xe.Z)(he,"termsHead4","\u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u091c\u0947 \u0905\u0939\u093e\u0901 \u0939\u092e\u0930 \u092f\u094b\u091c\u0928\u093e \u092a\u0930 \u0926\u0948\u0924 \u091b\u0940\u0964"),(0,xe.Z)(he,"termsText5","<p> \u092f\u0926\u093f \u0905\u0939\u093e\u0901\u0915 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0916\u093e\u0924\u093e\u0915 \u092d\u0940\u0924\u0930 \u0905\u0939\u093e\u0901\u0915\u0947\u0901 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u092c\u093e\u0915 \u0932\u0947\u0932 \u0915\u0939\u0932 \u091c\u093e\u0907\u0924 \u0905\u091b\u093f, \u0924\u0901 \u0905\u0939\u093e\u0901 \u091c\u0947 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0948\u0924 \u091b\u0940 \u0938\u0947 \u092a\u0942\u0930\u094d\u0923 \u0906 \u0938\u091f\u0940\u0915 \u0939\u094b\u0905\u092f \u091a\u093e\u0939\u0940\u0964 \u0905\u0939\u093e\u0901 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0948\u0924 \u091b\u0940 \u091c\u0947 \u092f\u0926\u093f \u0905\u0939\u093e\u0901 \u0905\u092a\u0942\u0930\u094d\u0923, \u0917\u0932\u0924, \u092f\u093e \u0917\u0932\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0948\u0924 \u091b\u0940, \u0915\u094b\u0928\u094b \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0930\u092c\u093e\u0915 (\u092f\u093e \u0915\u0930\u092c\u093e\u0915 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u092c\u093e\u0915) \u0932\u0947\u0932 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e\u0915 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0948\u0924 \u091b\u0940, \u092f\u093e \u0905\u0928\u094d\u092f\u0925\u093e \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e\u0915 \u0926\u0941\u0930\u0941\u092a\u092f\u094b\u0917 \u0915\u0930\u0948\u0924 \u091b\u0940, \u0924\u0901 \u0908 \u0905\u0939\u093e\u0901\u0915 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u0939\u0941\u0901\u091a\u0915\u0947\u0901 \u0928\u093f\u0932\u0902\u092c\u093f\u0924 \u092f\u093e \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u093d \u0938\u0915\u0948\u0924 \u0905\u091b\u093f\u0964 </p> \u0917\u0932\u0924 \u092f\u093e \u092d\u094d\u0930\u093e\u092e\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0926\u0947\u092c \u0917\u0902\u092d\u0940\u0930 \u0905\u092a\u0930\u093e\u0927 \u0925\u093f\u0915\u0964 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e\u0915 \u092e\u093e\u0927\u094d\u092f\u092e\u0938\u0901 \u0905\u092a\u0942\u0930\u094d\u0923, \u0917\u0932\u0924, \u092f\u093e \u0917\u0932\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u092c \u0913\u0939\u093f \u0924\u0930\u0939\u0947\u0901 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0915\u092f\u0932 \u091c\u093e\u092f\u0924 \u091c\u0947\u0928\u093e \u0915\u094b\u0928\u094b \u092a\u094d\u0930\u092a\u0924\u094d\u0930 \u092a\u0930 \u092f\u093e \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0930\u0942\u092a\u0938\u0901 \u0917\u0932\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u092c \u0906 \u0913\u0915\u0930 \u092a\u0930\u093f\u0923\u093e\u092e\u0938\u094d\u0935\u0930\u0942\u092a \u0905\u092d\u093f\u092f\u094b\u091c\u0928 \u0906 \u0926\u0940\u0935\u093e\u0928\u0940 \u092f\u093e \u0906\u092a\u0930\u093e\u0927\u093f\u0915 \u0926\u0902\u0921 \u092d\u093d \u0938\u0915\u0948\u0924 \u0905\u091b\u093f\u0964"),(0,xe.Z)(he,"securityPolicy","\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0928\u0940\u0924\u093f"),(0,xe.Z)(he,"securityText","\u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u090f\u092e\u0947\u091c\u0949\u0928 \u0935\u0947\u092c \u0938\u0930\u094d\u0935\u093f\u0938\u0947\u091c (\u090f\u0921\u092c\u094d\u0932\u094d\u092f\u0942\u090f\u0938) \u0926\u094d\u0935\u093e\u0930\u093e \u0939\u094b\u0938\u094d\u091f \u0915\u092f\u0932 \u091c\u093e\u0907\u0924 \u0905\u091b\u093f\u0964 \u0905\u0924\u0903 \u090f\u0939\u093f \u0935\u093f\u092d\u093e\u0917\u0915 \u092e\u0902\u091a\u0938\u0901 \u0938\u092e\u094d\u092c\u0928\u094d\u0927\u093f\u0924 \u0938\u092d \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u0941\u0926\u094d\u0926\u093e\u0915\u0947\u0901 \u090f\u0928. \u0908. \u091c\u0940. \u0921\u0940. \u0926\u094d\u0935\u093e\u0930\u093e \u0939\u0932 \u0915\u092f\u0932 \u091c\u093e\u092f\u0924\u0964 \u090f\u0928. \u0908. \u091c\u0940. \u0921\u0940. \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0926\u093f\u0936\u093e\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u0915 \u0905\u0928\u0941\u0938\u093e\u0930 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e\u0928\u0941\u0938\u093e\u0930 \u0906\u0935\u0936\u094d\u092f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0932\u0947\u0916\u093e\u092a\u0930\u0940\u0915\u094d\u0937\u093e \u0915\u093d \u0938\u0915\u0948\u0924 \u0905\u091b\u093f\u0964"),(0,xe.Z)(he,"monitoringPolicy","\u0928\u093f\u0917\u0930\u093e\u0928\u0940 \u0928\u0940\u0924\u093f"),(0,xe.Z)(he,"monitoringText","\u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u091f\u0940\u092e \u0938\u092e\u092f-\u0938\u092e\u092f \u092a\u0930 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e\u0915 \u0928\u093f\u0917\u0930\u093e\u0928\u0940 \u0915\u0930\u0924 \u091c\u093e\u0939\u093f \u0938\u0901 \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u0906 \u0905\u0928\u0941\u0915\u0942\u0932\u0924\u093e \u0915\u0947 \u092e\u0941\u0926\u094d\u0926\u093e \u091c\u0947\u0928\u093e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928, \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0937\u092e\u0924\u093e, \u091f\u0942\u091f\u0940-\u092b\u0942\u091f\u0940 \u0932\u093f\u0902\u0915, \u092f\u093e\u0924\u093e\u092f\u093e\u0924 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0906 \u0906\u0917\u0902\u0924\u0941\u0915\u0915 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0947 \u0938\u092e\u093e\u0927\u093e\u0928 \u0906 \u0920\u0940\u0915 \u0915\u0948\u0932 \u091c\u093e \u0938\u0915\u092f\u0964"),(0,xe.Z)(he,"contingencyManagement","\u0906\u0915\u0938\u094d\u092e\u093f\u0915\u0924\u093e \u092a\u094d\u0930\u092c\u0902\u0927\u0928"),(0,xe.Z)(he,"contingencyText","\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0938\u092d\u0915\u0947\u0901 \u0938\u0942\u091a\u0928\u093e \u0906 \u0938\u0947\u0935\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u092c\u093e\u0915 \u0932\u0947\u0932 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e\u0915\u0947\u0901 \u0939\u0930 \u0938\u092e\u092f \u0915\u094d\u0930\u093f\u092f\u093e\u0936\u0940\u0932 \u0906 \u091a\u093e\u0932\u0942 \u0930\u0939\u092c\u093e\u0915 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0905\u091b\u093f\u0964 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u090f\u092e\u0947\u091c\u0949\u0928 \u0935\u0947\u092c \u0938\u0930\u094d\u0935\u093f\u0938\u0947\u091c \u0926\u094d\u0935\u093e\u0930\u093e \u0939\u094b\u0938\u094d\u091f \u0915\u092f\u0932 \u091c\u093e\u0907\u0924 \u0905\u091b\u093f \u0906 \u090f\u0921\u092c\u094d\u0932\u094d\u092f\u0942\u090f\u0938 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e\u0928\u0941\u0938\u093e\u0930 \u0924\u0924\u094d\u0915\u093e\u0932 \u0915\u0926\u092e \u0909\u0920\u092c\u0948\u0924 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e\u0915 \u0921\u093e\u0909\u0928\u091f\u093e\u0907\u092e\u0915\u0947\u0901 \u092f\u0925\u093e\u0938\u0902\u092d\u0935 \u0915\u092e \u0915\u0930\u092c\u093e\u0915 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0924\u0964 \u0938\u093e\u0907\u091f \u0915\u0947 \u0935\u093f\u0930\u0942\u092a\u0923/\u0939\u0948\u0915\u093f\u0902\u0917, \u0921\u0947\u091f\u093e \u092d\u094d\u0930\u0937\u094d\u091f\u093e\u091a\u093e\u0930, \u0939\u093e\u0930\u094d\u0921\u0935\u0947\u092f\u0930/\u0938\u0949\u092b\u094d\u091f\u0935\u0947\u092f\u0930 \u0915\u094d\u0930\u0948\u0936 \u0906 \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u0906\u092a\u0926\u093e \u091c\u0947\u0939\u0928 \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947 \u090f\u0921\u092c\u094d\u0932\u094d\u092f\u0942\u090f\u0938 \u0915\u092e \u0938\u0901 \u0915\u092e \u0938\u092e\u092f \u092e\u0947 \u0938\u093e\u0907\u091f \u0915\u0947 \u092a\u0941\u0928\u0930\u094d\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0948 \u0915\u0947 \u092a\u0942\u0930\u093e \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0924\u0964 \u090f. \u0921\u092c\u094d\u0932\u094d\u092f\u0942. \u090f\u0938. \u0915 \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u0940 \u0905\u091b\u093f \u091c\u0947 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0921\u0947\u091f\u093e \u0915\u0947 \u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u0915 \u0932\u0947\u0932 \u0926\u0942\u0930\u0938\u094d\u0925 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0938\u094d\u0925\u093f\u0924 \u0906\u092a\u0926\u093e \u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f \u0938\u094d\u0925\u0932 \u092a\u0930 \u0930\u093e\u0916\u0932 \u091c\u093e\u092f\u0964"),(0,xe.Z)(he,"tcForURL