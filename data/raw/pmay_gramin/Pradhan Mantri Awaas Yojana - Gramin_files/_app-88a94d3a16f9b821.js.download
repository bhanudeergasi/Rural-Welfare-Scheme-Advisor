copyLink:"\u0932\u093f\u0902\u0915 \u0915\u0949\u092a\u0940 \u0915\u0930\u0947\u0902",linkCopied1:"\u0932\u093f\u0902\u0915 \u0915\u0949\u092a\u0940 \u0915\u093f\u092f\u093e \u0917\u092f\u093e",followUs:"\u0939\u092e\u0947\u0902 \u092b\u0949\u0932\u094b \u0915\u0930\u0947\u0902",socialConnect:"\u0938\u094b\u0936\u0932 \u0915\u0928\u0947\u0915\u094d\u091f",bhashiniDisclaimer:"\u092d\u093e\u0938\u093f\u0928\u0940 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0905\u0928\u0941\u0935\u093e\u0926 \u0915\u093f\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902",bhashiniDisclaimer1:"\u0939\u092e\u0928\u0947 \u0938\u092d\u0940 \u0905\u0928\u0941\u0935\u093e\u0926\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092d\u0936\u093f\u0928\u0940 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u0939\u0948",translationDisclaimer:"\u0939\u092e\u0928\u0947 \u0939\u093f\u0902\u0926\u0940 \u0914\u0930 \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940 \u0938\u0939\u093f\u0924 15 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u092d\u093e\u0937\u093e\u0913\u0902 \u092e\u0947\u0902 \u092e\u093e\u0908\u0938\u094d\u0915\u0940\u092e \u092e\u094b\u092c\u093e\u0907\u0932 \u0910\u092a/\u0935\u0947\u092c \u0915\u093e \u0905\u0928\u0941\u0935\u093e\u0926 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u0939\u0932 \u0915\u0940 \u0939\u0948\u0964 \u091f\u0947\u0915\u094d\u0938\u094d\u091f, \u090f\u092a\u094d\u0932\u0940\u0915\u0947\u0936\u0928, \u0917\u094d\u0930\u093e\u092b\u093f\u0915\u094d\u0938 \u0914\u0930 \u0921\u0949\u0915\u094d\u092f\u0942\u092e\u0947\u0902\u091f\u094d\u0938 \u0938\u0939\u093f\u0924 \u0915\u0941\u091b \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u093e \u0905\u0928\u0941\u0935\u093e\u0926 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0905\u0928\u0941\u0935\u093e\u0926 \u0938\u091f\u0940\u0915 \u0928\u0939\u0940\u0902 \u0