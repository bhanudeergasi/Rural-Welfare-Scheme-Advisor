u09a8\u09cb \u09a6\u09be\u09af\u09bc\u09bf\u09a4\u09cd\u09ac \u0997\u09cd\u09f0\u09b9\u09a3 \u09a8\u0995\u09f0\u09c7\u0964 \u0995\u09cb\u09a8\u09cb \u09aa\u09f0\u09bf\u09b8\u09cd\u09a5\u09bf\u09a4\u09bf\u09a4\u09c7, \u098f\u0987 \u09aa\u09cd\u09b2\u09c7\u099f\u09ab\u09f0\u09cd\u09ae\u09f0 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0\u09f0 \u09ab\u09b2\u09a4 \u09b9\u09cb\u09f1\u09be \u09af\u09bf\u0995\u09cb\u09a8\u09cb \u09b2\u09cb\u0995\u099a\u09be\u09a8, \u0995\u09cd\u09b7\u09a4\u09bf, \u09a6\u09be\u09af\u09bc\u09ac\u09a6\u09cd\u09a7\u09a4\u09be \u09ac\u09be \u09ac\u09cd\u09af\u09af\u09bc\u09f0 \u09ac\u09be\u09ac\u09c7 \u098f\u09ae. \u0987. \u0986\u0987. \u099f\u09bf. \u09ac\u09be \u098f\u09a8. \u0987. \u099c\u09bf. \u09a1\u09bf. \u09a6\u09be\u09af\u09bc\u09ac\u09a6\u09cd\u09a7 \u09a8\u09b9 '\u09ac, \u09af\u09be\u09f0 \u09ad\u09bf\u09a4\u09f0\u09a4 \u0986\u099b\u09c7 \u0995\u09cb\u09a8\u09cb \u09b8\u09c0\u09ae\u09be\u09ac\u09a6\u09cd\u09a7\u09a4\u09be \u0985\u09ac\u09bf\u09b9\u09a8\u09c7, \u0995\u09cb\u09a8\u09cb \u09a6\u09cb\u09b7, \u09ad\u09be\u0987\u09f0\u09be\u099b, \u09a4\u09cd\u09f0\u09c1\u099f\u09bf, \u09ac\u09be\u09a6 \u09a6\u09bf\u09af\u09bc\u09be, \u09ac\u09be\u09a7\u09be \u09ac\u09be \u09ac\u09bf\u09b2\u09ae\u09cd\u09ac, \u0987\u09af\u09bc\u09be\u09f0 \u09b8\u09a8\u09cd\u09a6\u09f0\u09cd\u09ad\u09a4, \u09aa\u09f0\u09cb\u0995\u09cd\u09b7 \u09ac\u09be \u09a6\u09c2\u09f0\u09f1\u09f0\u09cd\u09a4\u09c0\u0964 \u09aa\u09cd\u09b2\u09c7\u099f\u09ab\u09f0\u09cd\u09ae\u09f0 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0\u0995\u09be\u09f0\u09c0\u09f0 \u098f\u0995\u09ae\u09be\u09a4\u09cd\u09f0 \u09ac\u09bf\u09aa\u09a6\u09be\u09b6\u0982\u0995\u09be\u09f0 \u09ac\u09bf\u09b7\u09af\u09bc\u0964 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0\u0995\u09be\u09f0\u09c0\u09af\u09bc\u09c7 \u09ac\u09bf\u09b6\u09c7\u09b7\u09ad\u09be\u09f1\u09c7 \u09b8\u09cd\u09ac\u09c0\u0995\u09be\u09f0 \u0995\u09f0\u09c7 \u0986\u09f0\u09c1 \u09b8\u09a8\u09cd\u09ae