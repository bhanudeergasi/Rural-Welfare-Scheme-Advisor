u0915\u0947 \u092c\u093f\u0928\u093e \u0915\u094b\u0928\u094b \u092e\u0927\u094d\u092f\u0935\u0930\u094d\u0924\u0940 \u092a\u0943\u0937\u094d\u0920, \u092a\u0949\u092a-\u0905\u092a, \u092f\u093e \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092a\u0930\u0924 \u0915\u0947 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 myScheme.gov.in \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0915\u0930\u092f \u0915\u0947 \u091a\u093e\u0939\u0940\u0964 </span> <span> 1.3 \u0939\u092e \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0915\u0947 \u092a\u0943\u0937\u094d\u0920 \u0915\u0947\u0901 \u0905\u0939\u093e\u0901\u0915 \u0938\u093e\u0907\u091f \u092a\u0930 \u092b\u094d\u0930\u0947\u092e \u092e\u0947 \u0932\u094b\u0921 \u0915\u0930\u092f \u0915\u0947 \u0905\u0928\u0941\u092e\u0924\u093f \u0928\u0948 \u0926\u0948\u0924 \u091b\u0940\u0964 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0938\u0901 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092a\u0943\u0937\u094d\u0920 \u0915\u0947\u0901 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u0928\u0935 \u0916\u0941\u091c\u0932 \u092c\u094d\u0930\u093e\u0909\u091c\u093c\u0930 \u0935\u093f\u0902\u0921\u094b \u092e\u0947 \u0932\u094b\u0921 \u0915\u0930\u092f \u0915\u0947 \u091a\u093e\u0939\u0940\u0964"),(0,xe.Z)(he,"urlSubHeading2Text","<span> 2.1 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0921\u0947\u091f\u093e \u0906 \u092f\u0942\u0906\u0930\u090f\u0932\u0915 \u0905\u0916\u0923\u094d\u0921\u0924\u093e\u0915 \u0930\u0915\u094d\u0937\u093e \u0932\u0947\u0932 \u092a\u093e\u0930\u094d\u091f\u0940\u0915\u0947\u0901 \u090f\u091a\u091f\u0940\u091f\u0940\u092a\u0940\u090f\u0938 \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u0936\u0928, \u092b\u093e\u092f\u0930\u0935\u0949\u0932 \u0938\u0941\u0930\u0915\u094d\u0937\u093e, \u0906 \u0928\u093f\u092f\u092e\u093f\u0924 \u092a\u094d\u0930\u0935\u0947\u0936 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0938\u0939\u093f\u0924 \u092e\u091c\u092c\u0942\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932\u0915\u0947\u0901 \u0932\u093e\u0917\u0942 \u0915\u0930\u092c\u093e\u0915 \u091a\u093e\u0939\u0940\u0964 </span> <span> 2.2 \u092a\u093e\u0930\u094d\u091f\u0940\u0915\u0947\u0901 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u093e\u0928\u0915\u0938\u092d\u0915 \u092a\u093e\u0932\u0928 \u0915\u0930\u092c\u093e\u0915 \u091a\u093e\u0939\u0940, \u091c\u093e\u0939\u093f\u092e\u0947 \u0935\u0947\u092c \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u092e\u091c\u094b\u0930\u0940\u0915 \u0932\u0947\u0932 \u0913\u0921\u092c\u094d\u0932\u094d\u092f\u0942\u090f\u090f\u0938\u092a\u0940 \u0936\u0940\u0930\u094d\u0937 10 \u0938\u0947\u0939\u094b \u0936\u093e\u092e\u093f\u0932 \u0905\u091b\u093f\u0964 </span> <span> 2.3 \u0915\u094b\u0928\u094b \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0909\u0932\u094d\u0932\u0902\u0918\u0928\u0915 \u0938\u0942\u091a\u0928\u093e 24 \u0918\u0902\u091f\u093e\u0915 \u092d\u0940\u0924\u0930 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u091f\u0940\u092e\u0915\u0947\u0901 \u0926\u0947\u0932 \u091c\u092f\u092c\u093e\u0915 \u091a\u093e\u0939\u0940, \u0906 \u0909\u0932\u094d\u0932\u0902\u0918\u0928\u0915\u0947\u0901 \u0915\u092e \u0915\u0930\u092c\u093e\u0915 \u0932\u0947\u0932 \u0924\u0924\u094d\u0915\u093e\u0932 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u092f\u0932 \u091c\u092f\u092c\u093e\u0915 \u091a\u093e\u0939\u0940\u0964 </span> <span> 2.4 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u093e\u0928\u0915 \u0938\u092d\u0915 \u0928\u093f\u0930\u0902\u0924\u0930 \u0905\u0928\u0941\u092a\u093e\u0932\u0928 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u092c\u093e\u0915 \u0932\u0947\u0932 \u0924\u0943\u0924\u0940\u092f-\u092a\u0915\u094d\u0937 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0938\u0939\u093f\u0924 \u0928\u093f\u092f\u092e\u093f\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0911\u0921\u093f\u091f \u0915\u092f\u0932 \u091c\u092f\u092c\u093e\u0915 \u091a\u093e\u0939\u0940\u0964"),(0,xe.Z)(he,"urlSubHeading3Text","<span> <span> </span> </span> </span> </span> </span> </span> </span> </span> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p> </p>"),(0,xe.Z)(he,"urlSubHeading4Text","<\u0938\u094d\u092a\u0948\u0928> <\u0938\u094d\u092a\u0948\u0928> </\u0938\u094d\u092a\u0948\u0928> </\u0938\u094d\u092a\u0948\u0928> </\u0938\u094d\u092a\u0948\u0928> </\u0938\u094d\u092a\u0948\u0928> </\u0938\u094d\u092a\u0948\u0928> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span>"),(0,xe.Z)(he,"urlSubHeading5Text","<\u0938\u094d\u092a\u0948\u0928> 5.1 \u0905\u0939\u093e\u0901 \u0938\u092d \u0932\u093e\u0917\u0942 \u0915\u093e\u0928\u0942\u0928, \u0935\u093f\u0928\u093f\u092f\u092e\u0928, \u0906 \u0924\u0943\u0924\u0940\u092f \u092a\u0915\u094d\u0937\u0915 \u0905\u0927\u093f\u0915\u093e\u0930\u0915 \u092a\u093e\u0932\u0928 \u0915\u0930\u092c (\u0921\u0947\u091f\u093e \u092f\u093e \u0938\u0949\u092b\u094d\u091f\u0935\u0947\u092f\u0930, \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0906\u0926\u093f \u0915\u0947 \u0906\u092f\u093e\u0924 \u092f\u093e \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947\u0902 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0938\u0940\u092e\u093e \u0915\u0947 \u0915\u093e\u0928\u0942\u0928 \u0938\u0939\u093f\u0924)\u0964 </\u0938\u094d\u092a\u0948\u0928> <\u0938\u094d\u092a\u0948\u0928> 5.2 \u0905\u0939\u093e\u0901 \u092a\u094d\u0930\u091a\u0932\u093f\u0924 \u0921\u0947\u091f\u093e \u0938\u0902\u0930\u0915\u094d\u0937\u0923 \u0915\u093e\u0928\u0942\u0928 \u0906 \u0935\u093f\u0928\u093f\u092f\u092e \u0915\u0947 \u092a\u093e\u0932\u0928 \u0915\u0930\u092c, \u091c\u093e\u0939\u093f \u092e\u0947 \u0921\u093f\u091c\u093f\u091f\u0932 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0921\u0947\u091f\u093e \u0938\u0902\u0930\u0915\u094d\u0937\u0923 \u0905\u0927\u093f\u0928\u093f\u092f\u092e, 2023, \u0906 \u0938\u0942\u091a\u0928\u093e \u092a\u094d\u0930\u094c\u0926\u094d\u092f\u094b\u0917\u093f\u0915\u0940 \u0905\u0927\u093f\u0928\u093f\u092f\u092e, 2000, \u092f\u093e \u0913\u0939\u093f \u092e\u0947 \u092c\u0928\u093e\u0913\u0932 \u0917\u0947\u0932 \u0915\u094b\u0928\u094b \u0928\u093f\u092f\u092e \u092f\u093e \u0935\u093f\u0928\u093f\u092f\u092e, \u0906 \u0905\u0928\u094d\u092f \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u092a\u094d\u0930\u091a\u0932\u093f\u0924 \u0915\u093e\u0928\u0942\u0928/\u0928\u093f\u092f\u092e/\u0905\u0927\u094d\u092f\u093e\u0926\u0947\u0936/\u0905\u0927\u093f\u0938\u0942\u091a\u0928\u093e/\u0909\u092a\u0928\u093f\u092f\u092e \u0906\u0926\u093f \u0936\u093e\u092e\u093f\u0932 \u0905\u091b\u093f, \u090f\u0939\u093f \u0936\u0930\u094d\u0924\u0938\u092d \u0915\u0947 \u0924\u0939\u0924 \u0905\u0939\u093e\u0901 \u0926\u094d\u0935\u093e\u0930\u093e \u090f\u0915\u094d\u0938\u0947\u0938 \u092f\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0921\u0947\u091f\u093e \u0915\u0947 \u0938\u0902\u092d\u093e\u0932\u0928\u0947 \u0915\u0947 \u0938\u092e\u092f\u0964 <// \u0938\u094d\u092a\u0948\u0928> <\u0938\u094d\u092a\u0948\u0928> 5.3 \u0905\u0939\u093e\u0901 \u0915\u094b\u0928\u094b \u0921\u0947\u091f\u093e \u0915\u0947 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0928\u0939\u093f \u0915\u0930\u092c \u091c\u0947 \u0915\u094b\u0928\u094b \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u0915\u093e\u0928\u0942\u0928 \u092f\u093e \u0935\u093f\u0928\u093f\u092f\u092e \u0915\u0947 \u0924\u0939\u0924 \u0936\u093e\u0938\u093f\u0924 \u0905\u091b\u093f \u091c\u0915\u0930\u093e \u092c\u093f\u0928\u093e \u0905\u0932\u0917 \u0938\u0939\u092e\u0924\u093f \u092f\u093e \u0905\u0928\u0941\u092e\u094b\u0926\u0928 \u0915\u0947 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u091b\u0948\u0915\u0964"),(0,xe.Z)(he,"urlSubHeading6Text","<\u0938\u094d\u092a\u0948\u0928> 6.1 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092f\u0942\u0906\u0930\u090f\u0932\u0915 \u0909\u092a\u092f\u094b\u0917 \u0915\u094b\u0928\u094b \u0924\u0930\u0939\u0947\u0901 \u091b\u0932-\u0915\u092a\u091f\u092a\u0942\u0930\u094d\u0923, \u092d\u094d\u0930\u093e\u092e\u0915 \u092f\u093e \u0917\u0948\u0930\u0915\u093e\u0928\u0942\u0928\u0940 \u0928\u0939\u093f \u0915\u092f\u0932 \u091c\u093e \u0938\u0915\u0948\u0924 \u0905\u091b\u093f, \u091c\u093e\u0939\u093f\u092e\u0947 \u0917\u0948\u0930\u0915\u093e\u0928\u0942\u0928\u0940 \u092a\u0941\u0928\u0930\u094d\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u0928, \u092b\u093c\u093f\u0936\u093f\u0902\u0917, \u092f\u093e \u0905\u0928\u094d\u092f \u0926\u0941\u0930\u094d\u092d\u093e\u0935\u0928\u093e\u092a\u0942\u0930\u094d\u0923 \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u0938\u092d \u0924\u0915 \u0938\u0940\u092e\u093f\u0924 \u0928\u0939\u093f \u0905\u091b\u093f\u0964 \u0905\u0939\u093e\u0901\u0915\u0947\u0901 \u092f\u0942\u0906\u0930\u090f\u0932\u0915 \u0909\u092a\u092f\u094b\u0917 \u090f\u0939\u093f \u0924\u0930\u0939\u0947\u0901 \u0928\u0939\u093f \u0915\u092f\u0932 \u091c\u093e \u0938\u0915\u0948\u0924 \u0905\u091b\u093f \u091c\u0947 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e\u0915 \u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f\u0924\u093e\u0915\u0947\u0901 \u0917\u0932\u0924 \u0926\u0947\u0916\u092c\u0948\u0924 \u0939\u094b \u092f\u093e \u0915\u092e \u0915\u0930\u0948\u0924 \u0939\u094b\u0964 </\u0938\u094d\u092a\u0948\u0928> </\u0938\u094d\u092a\u0948\u0928> 6.2 \u092f\u0942\u0906\u0930\u090f\u0932\u0915 \u0909\u092a\u092f\u094b\u0917 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e\u0915 \u092a\u0942\u0930\u094d\u0935 \u0932\u093f\u0916\u093f\u0924 \u0938\u0939\u092e\u0924\u093f \u092c\u093f\u0928\u093e \u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928, \u092a\u094d\u0930\u091a\u093e\u0930, \u092f\u093e \u0932\u093e\u092d-\u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u0938\u092d\u092e\u0947 \u0928\u0939\u093f \u0915\u092f\u0932 \u091c\u093e\u092f\u0924\u0964"),(0,xe.Z)(he,"urlSubHeading7Text",'<\u0938\u094d\u092a\u0948\u0928> \u0905\u0939\u093e\u0901 (\u090f\u0915 "\u0915\u094d\u0937\u0924\u093f\u092a\u0942\u0930\u094d\u0924\u093f \u092a\u093e\u0930\u094d\u091f\u0940" \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902), \u0915\u093e\u0928\u0942\u0928 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u0928\u0941\u092e\u0924 \u0905\u0927\u093f\u0915\u0924\u092e \u0938\u0940\u092e\u093e \u0924\u0915, \u0939\u092e\u0930 \u0930\u0915\u094d\u0937\u093e \u0915\u0930\u092c, \u0930\u0915\u094d\u0937\u093e \u0915\u0930\u092c, \u0906 \u0915\u094d\u0937\u0924\u093f\u092a\u0942\u0930\u094d\u0924\u093f \u0915\u0930\u092c (\u090f\u0915 "\u0915\u094d\u0937\u0924\u093f\u092a\u0942\u0930\u094d\u0924\u093f \u092a\u093e\u0930\u094d\u091f\u0940" \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902)\u0964 \u0915\u094d\u0937\u0924\u093f\u092a\u0942\u0930\u094d\u0924\u093f \u092a\u093e\u0930\u094d\u091f\u0940 \u0915\u094d\u0937\u0924\u093f\u092a\u0942\u0930\u094d\u0924\u093f \u092a\u093e\u0930\u094d\u091f\u0940 \u0906 \u0913\u0915\u0930 \u0905\u0927\u093f\u0915\u093e\u0930\u0940, \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940, \u0928\u093f\u0926\u0947\u0936\u0915, \u0906 \u0938\u0932\u093e\u0939\u0915\u093e\u0930, \u091c\u0947 \u092e\u093e\u092e\u0932\u093e \u0939\u094b (\u090f\u0939\u093f \u0916\u0902\u0921 \u092e\u0947\u0902 \'\u0915\u094d\u0937\u0924\u093f\u092a\u0942\u0930\u094d\u0924\u093f \u092a\u093e\u0930\u094d\u091f\u0940\' \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0938\u0902\u0926\u0930\u094d\u092d\u093f\u0924 \u0938\u092c \u0924\u0940\u0938\u0930\u0947 \u092a\u0915\u094d\u0937), \u0915\u094b\u0928\u094b \u0914\u0930 \u0938\u092c \u0938\u093f\u0926\u094d\u0927 \u092f\u093e \u0915\u0925\u093f\u0924 \u0928\u0941\u0915\u0938\u093e\u0928, \u092e\u093e\u0901\u0917, \u0939\u0930\u094d\u091c\u093e\u0928\u093e, \u0926\u0947\u0928\u0926\u093e\u0930\u093f\u092f\u093e\u0901, \u092c\u094d\u092f\u093e\u091c, \u092a\u0941\u0930\u0938\u094d\u0915\u093e\u0930, \u0928\u093f\u0930\u094d\u0923\u092f, \u0928\u093f\u092a\u091f\u093e\u0928, \u091c\u0941\u0930\u094d\u092e\u093e\u0928\u093e, \u091c\u0941\u0930\u094d\u092e\u093e\u0928\u093e, \u0906 \u0938\u092e\u091d\u094c\u0924\u093e \u0938\u0901 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0915\u094b\u0928\u094b \u0924\u0940\u0938\u0930\u0947 \u092a\u0915\u094d\u0937 \u0915\u0947 \u0926\u093e\u0935\u093e, \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908, \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0947 \u0915\u093e\u0930\u0923, \u092f\u093e \u092e\u0941\u0915\u0926\u092e\u093e \u0938\u0901 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0938\u092e\u091d\u094c\u0924\u093e, / \u0938\u094d\u092a\u0948\u0928>'),(0,xe.Z)(he,"urlSubHeading8Text",'8. 1 \u090f\u092a\u0940\u0906\u0908 \u092c\u093f\u0928\u093e \u0915\u094b\u0928\u094b \u092a\u094d\u0930\u0915\u093e\u0930\u0915 \u0935\u093e\u0930\u0902\u091f\u0940\u0915 "\u091c\u0947\u0928\u093e \u0905\u091b\u093f" \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u092f\u0932 \u091c\u093e\u0907\u0924 \u0905\u091b\u093f\u0964 \u0939\u092e \u0938\u092d \u0938\u094d\u092a\u0937\u094d\u091f \u092f\u093e \u0928\u093f\u0939\u093f\u0924 \u0935\u093e\u0930\u0902\u091f\u0940\u0915\u0947\u0901 \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0948\u0924 \u091b\u0940, \u091c\u093e\u0939\u093f\u092e\u0947 \u0935\u094d\u092f\u093e\u092a\u093e\u0930 \u092f\u094b\u0917\u094d\u092f\u0924\u093e\u0915 \u0935\u093e\u0930\u0902\u091f\u0940, \u0915\u094b\u0928\u094b \u0935\u093f\u0936\u0947\u0937 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u0915 \u0932\u0947\u0932 \u092f\u094b\u0917\u094d\u092f\u0924\u093e, \u0906 \u0917\u0948\u0930-\u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u0924\u0915 \u0938\u0940\u092e\u093f\u0924 \u0928\u0939\u093f \u0905\u091b\u093f\u0964 8.2 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092f\u0942\u0906\u0930\u090f\u0932 \u0915\u0947 \u0939\u094b\u0938\u094d\u091f\u093f\u0902\u0917 \u0938\u0901 \u091c\u0941\u0921\u093c\u0932 \u0915\u094b\u0928\u094b \u0906 \u0938\u092d \u091c\u094b\u0916\u093f\u092e\u0915 \u0932\u0947\u0932 \u092a\u093e\u0930\u094d\u091f\u0940 \u092a\u0942\u0930\u094d\u0923\u0924\u0903 \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u0939\u094b\u092f\u0924, \u091c\u093e\u0939\u093f\u092e\u0947 \u0938\u093e\u0907\u092c\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0916\u0924\u0930\u093e, \u092a\u094d\u0930\u0924\u093f\u0937\u094d\u0920\u093e\u0924\u094d\u092e\u0915 \u0915\u094d\u0937\u0924\u093f, \u092f\u093e \u0915\u093e\u0928\u0942\u0928\u0940 \u092a\u0930\u093f\u0923\u093e\u092e \u0924\u0915 \u0938\u0940\u092e\u093f\u0924 \u0928\u0939\u093f \u0905\u091b\u093f\u0964 8.3 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092f\u0942\u0906\u0930\u090f\u0932 \u0915\u0947 \u0939\u094b\u0938\u094d\u091f\u093f\u0902\u0917 \u0938\u0901 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092a\u093e\u0930\u094d\u091f\u0940 \u0915\u0947 \u0915\u093e\u0930\u094d\u092f \u092f\u093e \u091a\u0942\u0915 \u0938\u0901 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u094b\u0928\u094b \u0915\u094d\u0937\u0924\u093f, \u0939\u093e\u0928\u093f, \u092f\u093e \u0926\u0947\u0928\u0926\u093e\u0930\u093f\u0915 \u0932\u0947\u0932 \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u0940 \u0928\u0939\u093f \u0939\u094b\u092f\u0924\u0964 \u092a\u093e\u0930\u094d\u091f\u0940 \u0938\u092c \u0915\u0947 \u0905\u0928\u0941\u092a\u093e\u0932\u0928 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u092f \u0932\u0947\u0932 \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u0939\u094b\u092f\u0924\u0964'),(0,xe.Z)(he,"urlSubHeading9Text","<span> 9.1 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0924\u0924\u094d\u0915\u093e\u0932 \u0939\u091f\u093e\u0928\u0947 \u0915\u093e \u0906\u0926\u0947\u0936 \u0926\u0947\u0928\u0947 \u0915\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0924\u093e \u0939\u0948 \u0914\u0930 \u0905\u0917\u0930 \u0905\u0939\u093e\u0901 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0936\u0930\u094d\u0924 \u0915\u0947 \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u0915\u0930\u0924\u0947 \u092a\u093e\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u0906\u092a\u0915\u094b \u0924\u0941\u0930\u0902\u0924 \u0905\u092a\u0928\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0938\u0947 \u092f\u0942\u0906\u0930\u090f\u0932 \u0915\u094b \u0939\u091f\u093e\u0928\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0917\u0940\u0964 </span> <span> 9.2 \u092a\u093e\u0930\u094d\u091f\u0940 \u0915\u094b \u0907\u0938 \u0924\u0930\u0939 \u0915\u0947 \u0938\u0902\u091a\u093e\u0930 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0905\u0921\u093c\u0924\u093e\u0932\u0940\u0938 (48) \u0918\u0902\u091f\u0947 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0939\u091f\u093e\u0928\u0947 \u0915\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0906\u0926\u0947\u0936 \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e\u0964"),(0,xe.Z)(he,"urlSubHeading10Text","<span> \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0905\u092a\u0928 \u0935\u093f\u0935\u0947\u0915 \u092a\u0930, \u092f\u0942\u0906\u0930\u090f\u0932 \u092a\u094d\u0932\u0947\u0938\u092e\u0947\u0902\u091f, \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0909\u092a\u093e\u092f, \u0906 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0939\u094b\u0938\u094d\u091f\u093f\u0902\u0917\u0915 \u0932\u0947\u0932 \u0938\u0930\u094d\u0935\u0936\u094d\u0930\u0947\u0937\u094d\u0920 \u092a\u094d\u0930\u0925\u093e \u0938\u0939\u093f\u0924 \u090f\u0939\u093f \u0936\u0930\u094d\u0924\u0938\u092d\u0915 \u092a\u093e\u0932\u0928\u092e\u0947 \u092a\u093e\u0930\u094d\u091f\u0940\u0915 \u0938\u0939\u093e\u092f\u0924\u093e \u0932\u0947\u0932 \u0938\u0902\u0938\u093e\u0927\u0928 \u092f\u093e \u0926\u093f\u0936\u093e\u0928\u093f\u0930\u094d\u0926\u0947\u0936 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u093d \u0938\u0915\u0948\u0924 \u0905\u091b\u093f\u0964"),(0,xe.Z)(he,"urlSubHeading11Text","</span> a. \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u092e\u0947 \u092c\u093f\u0928\u093e \u0938\u0940\u092e\u093e, \u091f\u094d\u0930\u0947\u0921\u092e\u093e\u0930\u094d\u0915, \u0915\u0949\u092a\u0940\u0930\u093e\u0907\u091f, \u0921\u093f\u091c\u093e\u0907\u0928, \u092f\u093e \u092a\u0947\u091f\u0947\u0902\u091f \u0938\u0939\u093f\u0924 \u0938\u092d \u092c\u094c\u0926\u094d\u0927\u093f\u0915 \u0938\u0902\u092a\u0926\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0906 \u0939\u093f\u0924 \u0935\u093f\u0936\u0947\u0937 \u0930\u0942\u092a\u0938\u0901 \u0939\u092e\u0930\u093e \u0938\u092d\u0915 \u0939\u094b\u092f\u0924\u0964 \u0908 \u0936\u0930\u094d\u0924\u0938\u092d \u0905\u0939\u093e\u0901\u0915\u0947\u0901 \u0915\u094b\u0928\u094b \u092a\u094d\u0930\u0915\u093e\u0930\u0947\u0901 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 \u0915\u094b\u0928\u094b \u0938\u094d\u0935\u093e\u092e\u093f\u0924\u094d\u0935 \u0905\u0927\u093f\u0915\u093e\u0930 \u092f\u093e \u0935\u093f\u0936\u093f\u0937\u094d\u091f\u0924\u093e \u0928\u0939\u093f \u0926\u0948\u0924 \u0905\u091b\u093f\u0964 </span> <span> b. \u0905\u0939\u093e\u0901 \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u0915 \u0905\u092a\u0928 \u0939\u094b\u0938\u094d\u091f\u093f\u0902\u0917/\u0939\u093e\u0907\u092a\u0930\u0932\u093f\u0902\u0915\u093f\u0902\u0917\u0915 \u0938\u0902\u092c\u0902\u0927\u092e\u0947 \u0915\u094b\u0928\u094b \u092c\u092f\u093e\u0928 \u0928\u0939\u093f \u0926\u0947\u092c\u0948\u0915 \u091c\u0947 \u0939\u092e\u0930 \u092a\u0942\u0930\u094d\u0935 \u0932\u093f\u0916\u093f\u0924 \u0905\u0928\u0941\u092e\u094b\u0926\u0928\u0915 \u092c\u093f\u0928\u093e \u0939\u092e\u0930\u093e \u0938\u092d\u0915 \u0938\u0919\u094d\u0917 \u0938\u093e\u091d\u0947\u0926\u093e\u0930\u0940, \u092a\u094d\u0930\u093e\u092f\u094b\u091c\u0928, \u092f\u093e \u0938\u092e\u0930\u094d\u0925\u0928\u0915 \u0938\u0941\u091d\u093e\u0935 \u0926\u0948\u0924 \u0905\u091b\u093f\u0964 </span> <span> c. \u0939\u092e\u0938\u092d \u090f\u0915 \u0939\u093e\u0907\u092a\u0930\u0932\u093f\u0902\u0915\u0915 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0948\u0924 \u091b\u0940 \u091c\u0947 \u0915\u0947\u0935\u0932 \u0939\u092e\u0930 \u0928\u093e\u092e \u092f\u093e \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u0915 \u092a\u0924\u093e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0948\u0924 \u0905\u091b\u093f\u0964 \u0939\u093e\u0907\u092a\u0930\u0932\u093f\u0902\u0915\u0915 \u0930\u0942\u092a\u092e\u0947 \u0939\u092e\u0930 \u0938\u094d\u0915\u0940\u092e \u0932\u094b\u0917\u094b, \u091f\u094d\u0930\u0947\u0921 \u0928\u093e\u092e, \u0906 \u091f\u094d\u0930\u0947\u0921\u092e\u093e\u0930\u094d\u0915\u0915 \u0915\u094b\u0928\u094b \u0909\u092a\u092f\u094b\u0917 \u092f\u093e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928\u0915 \u0905\u0928\u0941\u092e\u0924\u093f \u0928\u0939\u093f \u0926\u0947\u0932 \u091c\u093e\u092f\u0924\u0964"),(0,xe.Z)(he,"urlSubHeading12Text","\u0939\u092e\u0938\u092d \u0932\u0917 \u0915\u094b\u0928\u094b \u0938\u092e\u092f, \u092a\u0942\u0930\u094d\u0935 \u0938\u0942\u091a\u0928\u093e \u0915\u0947 \u0938\u0902\u0917 \u092f\u093e \u092c\u093f\u0928\u093e, \u090f\u0939\u093f \u0936\u0930\u094d\u0924\u0938\u092d \u0915\u0947 \u0938\u0902\u0936\u094b\u0927\u093f\u0924 \u0915\u0930\u0948 \u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0905\u091b\u093f\u0964 \u0905\u0939\u093e\u0901 \u0938\u0901 \u0905\u0928\u0941\u0930\u094b\u0927 \u0905\u091b\u093f \u091c\u0947 \u0905\u0939\u093e\u0901 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092f\u0942\u0906\u0930\u090f\u0932 \u0915\u0947 \u0905\u092a\u0928 \u0928\u093f\u0930\u0902\u0924\u0930 \u0909\u092a\u092f\u094b\u0917/\u0939\u094b\u0938\u094d\u091f\u093f\u0902\u0917 \u0915\u0947 \u0932\u0947\u0932 \u0938\u092e\u092f-\u0938\u092e\u092f \u092a\u0930 \u090f\u0939\u093f \u0936\u0930\u094d\u0924\u0938\u092d \u0915\u0947 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0942\u0964"),(0,xe.Z)(he,"urlSubHeading13Text","\u0915\u094b\u0928\u094b \u092a\u0930\u093f\u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947 \u0939\u092e \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092f\u0942\u0906\u0930\u090f\u0932 \u0915\u0947 \u0905\u0939\u093e\u0901\u0915 \u0909\u092a\u092f\u094b\u0917/\u0939\u094b\u0938\u094d\u091f\u093f\u0902\u0917 \u0938\u0901 \u092f\u093e \u0913\u0915\u0930 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u094b\u0928\u094b \u0905\u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937, \u0935\u093f\u0936\u0947\u0937, \u0906\u0915\u0938\u094d\u092e\u093f\u0915, \u092f\u093e \u092a\u0930\u093f\u0923\u093e\u092e\u0940 \u0915\u094d\u0937\u0924\u093f \u0915\u0947 \u0932\u0947\u0932 \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u0940 \u0928\u0939\u093f \u0930\u0939\u092c, \u091a\u093e\u0939\u0947 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0947 \u0915\u093e\u0930\u0923 (\u091a\u093e\u0939\u0947 \u0905\u0928\u0941\u092c\u0902\u0927, \u0905\u092a\u0915\u0943\u0924\u094d\u092f, \u0935\u093e\u0930\u0902\u091f\u0940 \u0915\u0947 \u0909\u0932\u094d\u0932\u0902\u0918\u0928, \u092f\u093e \u0905\u0928\u094d\u092f\u0925\u093e) \u0906 \u092d\u0932\u0947 \u0939\u0940 \u0939\u092e\u0947 \u090f\u0939\u0928 \u0915\u094d\u0937\u0924\u093f \u0915\u0947 \u0938\u0902\u092d\u093e\u0935\u0928\u093e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0938\u0932\u093e\u0939 \u0926\u0947\u0932 \u0917\u0947\u0932 \u0939\u094b\u0964"),(0,xe.Z)(he,"urlSubHeading14Text","\u092f\u0926\u093f \u090f\u0939\u093f \u0936\u0930\u094d\u0924\u0938\u092d\u0915 \u0915\u094b\u0928\u094b \u092a\u094d\u0930\u093e\u0935\u0927\u093e\u0928 \u0915\u094b\u0928\u094b \u0915\u093e\u0930\u0923\u0938\u0901 \u0905\u092a\u094d\u0930\u0935\u0930\u094d\u0924\u0928\u0940\u092f \u092e\u093e\u0928\u0932 \u091c\u093e\u0907\u0924 \u0905\u091b\u093f \u0924\u0916\u0928 \u090f\u0915\u0930 \u0936\u0947\u0937 \u092a\u094d\u0930\u093e\u0935\u0927\u093e\u0928 \u0905\u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0906 \u092a\u0942\u0930\u094d\u0923 \u092c\u0932 \u0906 \u092a\u094d\u0930\u092d\u093e\u0935\u092e\u0947 \u0930\u0939\u0924\u0964"),(0,xe.Z)(he,"urlSubHeading15Text","\u092a\u094d\u0932\u0947\u091f\u092b\u0930\u094d\u092e, \u090f\u0915\u0930 \u0938\u093e\u092e\u0917\u094d\u0930\u0940, \u092f\u093e \u090f\u0915\u0930 \u0938\u0947\u0935\u093e\u0915 \u0938\u0902\u092c\u0902\u0927\u092e\u0947 \u0915\u094b\u0928\u094b \u0936\u093f\u0915\u093e\u092f\u0924, \u0936\u093f\u0915\u093e\u092f\u0924, \u092f\u093e \u091a\u093f\u0928\u094d\u0924\u093e, \u092a\u0939\u093f\u0928\u0947 \u0938\u0940. \u091f\u0940. \u0913., \u090f\u0928. \u0908. \u091c\u0940. \u0921\u0940., \u0921\u093f\u091c\u093f\u091f\u0932 \u0907\u0902\u0921\u093f\u092f\u093e \u0928\u093f\u0917\u092e\u0915\u0947\u0901 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0915\u092f\u0932 \u091c\u093e\u092f\u0924 \u0906 \u092e\u0927\u094d\u092f\u0938\u094d\u0925\u0924\u093e\u0915 \u092e\u093e\u0927\u094d\u092f\u092e\u0938\u0901 \u0906\u092a\u0938\u0940 \u0930\u0942\u092a\u0938\u0901 \u0939\u0932 \u0915\u092f\u0932 \u091c\u093e\u092f\u0924\u0964 \u0908 \u0936\u0930\u094d\u0924\u0938\u092d \u092d\u093e\u0930\u0924\u0940\u092f \u0915\u093e\u0928\u0942\u0928\u0915 \u0905\u0928\u0941\u0938\u093e\u0930 \u0936\u093e\u0938\u093f\u0924 \u0939\u094b\u092f\u0924 \u0906 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092a\u0915\u094d\u0937 \u0926\u093f\u0932\u094d\u0932\u0940, \u092d\u093e\u0930\u0924\u0915 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u0915 \u0905\u0927\u093f\u0915\u093e\u0930 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u092e\u0947 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0939\u094b\u092f\u0924\u0964 \u090f\u0915\u0930 \u0905\u0938\u094d\u0924\u093f\u0924\u094d\u0935, \u0935\u0948\u0927\u0924\u093e, \u092f\u093e \u0938\u092e\u093e\u092a\u094d\u0924\u093f \u0938\u092e\u094d\u092c\u0928\u094d\u0927\u0940 \u0915\u094b\u0928\u094b \u092a\u094d\u0930\u0936\u094d\u0928 \u0938\u0939\u093f\u0924 \u090f\u0939\u093f \u0936\u0930\u094d\u0924\u0938\u092d\u0938\u0901 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u094b\u0928\u094b \u092e\u0924\u092d\u0947\u0926 \u092f\u093e \u0935\u093f\u0935\u093e\u0926 \u092a\u0915\u094d\u0937 \u0926\u094d\u0935\u093e\u0930\u093e \u0906\u092a\u0938\u0940 \u092c\u093e\u0924\u091a\u0940\u0924\u0915 \u092e\u093e\u0927\u094d\u092f\u092e\u0938\u0901 \u0939\u0932 \u0915\u092f\u0932 \u091c\u093e\u092f\u0924\u0964 \u090a\u092a\u0930 \u0935\u0930\u094d\u0923\u093f\u0924 \u0935\u093f\u0935\u093e\u0926\u0915 \u0938\u092e\u093e\u0927\u093e\u0928 \u0928\u0939\u093f \u0939\u094b\u092f\u092c\u093e\u0915 \u0938\u094d\u0925\u093f\u0924\u093f\u092e\u0947, \u0935\u093f\u0935\u093e\u0926\u0915\u0947\u0901 \u0926\u0941\u0928\u0942 \u092a\u0915\u094d\u0937 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u093e\u0930\u0938\u094d\u092a\u0930\u093f\u0915 \u0930\u0942\u092a\u0938\u0901 \u0928\u093f\u092f\u0941\u0915\u094d\u0924 \u090f\u0915\u0932 \u092e\u0927\u094d\u092f\u0938\u094d\u0925\u0915 \u092e\u0927\u094d\u092f\u0938\u094d\u0925\u0924\u093e\u0915 \u0932\u0947\u0932 \u0938\u0902\u0926\u0930\u094d\u092d\