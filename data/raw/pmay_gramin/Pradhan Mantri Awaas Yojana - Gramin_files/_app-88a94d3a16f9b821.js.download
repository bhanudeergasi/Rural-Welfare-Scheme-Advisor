u0a28 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48\u0964",aboutDesc3:"\u0a07\u0a39 \u0a2e\u0a70\u0a1a \u0a28\u0a3e\u0a17\u0a30\u0a3f\u0a15\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a09\u0a28\u0a4d\u0a39\u0a3e\u0a02 \u0a32\u0a08 \u0a38\u0a39\u0a40 \u0a38\u0a30\u0a15\u0a3e\u0a30\u0a40 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a32\u0a71\u0a2d\u0a23 \u0a35\u0a3f\u0a71\u0a1a \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a07\u0a39 \u0a35\u0a71\u0a16-\u0a35\u0a71\u0a16 \u0a38\u0a30\u0a15\u0a3e\u0a30\u0a40 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a32\u0a08 \u0a05\u0a30\u0a1c\u0a3c\u0a40 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a26\u0a47\u0a23\u0a40 \u0a39\u0a48, \u0a07\u0a38 \u0a2c\u0a3e\u0a30\u0a47 \u0a35\u0a40 \u0a38\u0a47\u0a27 \u0a26\u0a3f\u0a70\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a07\u0a38 \u0a32\u0a08 \u0a15\u0a08 \u0a38\u0a30\u0a15\u0a3e\u0a30\u0a40 \u0a35\u0a48\u0a71\u0a2c\u0a38\u0a3e\u0a08\u0a1f\u0a3e\u0a02 '\u0a24\u0a47 \u0a1c\u0a3e\u0a23 \u0a26\u0a40 \u0a1c\u0a3c\u0a30\u0a42\u0a30\u0a24 \u0a28\u0a39\u0a40\u0a02 \u0a39\u0a48\u0964",vision:"\u0a38\u0a3e\u0a21\u0a3e \u0a26\u0a4d\u0a30\u0a3f\u0a38\u0a3c\u0a1f\u0a40\u0a15\u0a4b\u0a23",visionText:"\u0a38\u0a3e\u0a21\u0a3e \u0a26\u0a4d\u0a30\u0a3f\u0a38\u0a3c\u0a1f\u0a40\u0a15\u0a4b\u0a23 \u0a28\u0a3e\u0a17\u0a30\u0a3f\u0a15\u0a3e\u0a02 \u0a26\u0a47 \u0a1c\u0a40\u0a35\u0a28 \u0a28\u0a42\u0a70 \u0a05\u0a38\u0a3e\u0a28 \u0a2c\u0a23\u0a3e\u0a09\u0a23\u0a3e \u0a39\u0a48\u0964",mission:"\u0a38\u0a3e\u0a21\u0a3e \u0a2e\u0a3f\u0a38\u0a3c\u0a28",mission1:"\u0a38\u0a3e\u0a21\u0a3e \u0a2e\u0a3f\u0a38\u0a3c\u0a28 \u0a38\u0a30\u0a15\u0a3e\u0a30\u0a40 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a05\u0a24\u0a47 \u0a32\u0a3e\u0a2d\u0a3e\u0a02 \u0a32\u0a08 \u0a38\u0a30\u0a15\u0a3e\u0a30-\u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e \u0a07\u0a70\u0a1f\u0a30\u0a2b\u0a47\u0a38 \u0a28\u0a42\u0a70 \u0a38\u0a41\u0a1a\u0a3e\u0a30\u0a42 \u0a2c\u0a23\u0a3e\u0a09\u0a23\u0a3e \u0a39\u0a48\u0964",mission2:"\u0a38\u0a30\u0a15\u0a3e\u0a30\u0a40 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a32\u0a71\u0a2d\u0a23 \u0a05\u0a24\u0a47 \u0a09\u0a38 \u0a26\u0a3e \u0a32\u0a3e\u0a2d \u0a32\u0a48\u0a23 \u0a32\u0a08 \u0a32\u0a71\u0a17\u0a23 \u0a35\u0a3e\u0a32\u0a47 \u0a38\u0a2e\u0a47\u0a02 \u0a05\u0a24\u0a47 \u0a2e\u0a3f\u0a39\u0a28\u0a24 \u0a28\u0a42\u0a70 \u0a18\u0a1f\u0a3e\u0a13\u0964",aboutPageDesc1:"\u0a2e\u0a3e\u0a08-\u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a07\u0a32\u0a48\u0a15\u0a1f\u0a4d\u0a30\u0a4c\u0a28\u0a3f\u0a15\u0a38 \u0a05\u0a24\u0a47 \u0a38\u0a42\u0a1a\u0a28\u0a3e \u0a1f\u0a48\u0a15\u0a28\u0a4b\u0a32\u0a4b\u0a1c\u0a40 \u0a2e\u0a70\u0a24\u0a30\u0a3e\u0a32\u0a47 (\u0a10\u0a71\u0a2e. \u0a08. \u0a06\u0a08. \u0a1f\u0a40. \u0a35\u0a3e\u0a08.), \u0a2a\u0a4d\u0a30\u0a38\u0a3c\u0a3e\u0a38\u0a15\u0a40 \u0a38\u0a41\u0a27\u0a3e\u0a30 \u0a05\u0a24\u0a47 \u0a1c\u0a28\u0a24\u0a15 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 \u0a35\u0a3f\u0a2d\u0a3e\u0a17 (\u0a21\u0a40. \u0a0f. \u0a06\u0a30. \u0a2a\u0a40. \u0a1c\u0a40.) \u0a05\u0a24\u0a47 \u0a39\u0a4b\u0a30 \u0a15\u0a47\u0a02\u0a26\u0a30\u0a40 \u0a05\u0a24\u0a47 \u0a30\u0a3e\u0a1c \u0a2e\u0a70\u0a24\u0a30\u0a3e\u0a32\u0a3f\u0a06\u0a02/\u0a35\u0a3f\u0a2d\u0a3e\u0a17\u0a3e\u0a02 \u0a26\u0a40 \u0a2d\u0a3e\u0a08\u0a35\u0a3e\u0a32\u0a40 \u0a28\u0a3e\u0a32 \u0a30\u0a3e\u0a38\u0a3c\u0a1f\u0a30\u0a40 \u0a08-\u0a17\u0a35\u0a30\u0a28\u0a48\u0a02\u0a38 \u0a21\u0a3f\u0a35\u0a40\u0a1c\u0a3c\u0a28 (\u0a10\u0a71\u0a28. \u0a08. \u0a1c\u0a40. \u0a21\u0a40.) \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a35\u0a3f\u0a15\u0a38\u0a24, \u0a2a\u0a4d\u0a30\u0a2c\u0a70\u0a27\u0a3f\u0a24 \u0a05\u0a24\u0a47 \u0a38\u0a70\u0a1a\u0a3e\u0a32\u0a3f\u0a24 \u0a15\u0a40\u0a24\u0a3e \u0a17\u0a3f\u0a06 \u0a39\u0a48\u0964",eligibilityCheckHead:"\u0a2f\u0a4b\u0a17\u0a24\u0a3e \u0a1c\u0a3e\u0a02\u0a1a",eligibilityCheckDesc:"\u0a24\u0a41\u0a38\u0a40\u0a02 \u0a35\u0a71\u0a16-\u0a35\u0a71\u0a16 \u0a2e\u0a3e\u0a2a\u0a26\u0a70\u0a21\u0a3e\u0a02 \u0a05\u0a24\u0a47 \u0a28\u0a3f\u0a71\u0a1c\u0a40 \u0a17\u0a41\u0a23\u0a3e\u0a02 \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a32\u0a08 \u0a06\u0a2a\u0a23\u0a40 \u0a2f\u0a4b\u0a17\u0a24\u0a3e \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b\u0964",schemeFinderHead:"\u0a38\u0a15\u0a40\u0a2e \u0a2b\u0a3e\u0a08\u0a02\u0a21\u0a30",schemeFinderDesc:"\u0a35\u0a71\u0a16-\u0a35\u0a71\u0a16 \u0a38\u0a30\u0a15\u0a3e\u0a30\u0a40 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a32\u0a08 \u0a2b\u0a3f\u0a32\u0a1f\u0a30 \u0a05\u0a27\u0a3e\u0a30\u0a24 \u0a21\u0a4d\u0a30\u0a3f\u0a32 \u0a21\u0a3e\u0a0a\u0a28\u0a1c\u0a3c \u0a28\u0a3e\u0a32 \u0a24\u0a47\u0a1c\u0a3c \u0a05\u0a24\u0a47 \u0a05\u0a38\u0a3e\u0a28 \u0a16\u0a4b\u0a1c",schemeInDetailHead:"\u0a35\u0a3f\u0a38\u0a25\u0a3e\u0a30 \u0a35\u0a3f\u0a71\u0a1a \u0a2f\u0a4b\u0a1c\u0a28\u0a3e",schemeInDetailDesc:"\u0a05\u0a30\u0a1c\u0a3c\u0a40 \u0a26\u0a47\u0a23 \u0a24\u0a4b\u0a02 \u0a2a\u0a39\u0a3f\u0a32\u0a3e\u0a02 \u0a35\u0a27\u0a40\u0a06 \u0a26\u0a3e\u0a23\u0a47\u0a26\u0a3e\u0a30 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a26\u0a47 \u0a35\u0a47\u0a30\u0a35\u0a3f\u0a06\u0a02 \u0a32\u0a08 \u0a38\u0a2e\u0a30\u0a2a\u0a3f\u0a24 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a2a\u0a70\u0a28\u0a3f\u0a06\u0a02 \u0a35\u0a3f\u0a71\u0a1a \u0a21\u0a42\u0a70\u0a18\u0a40 \u0a21\u0a41\u0a2c\u0a15\u0a40 \u0a32\u0a17\u0a3e\u0a13",documentRequired:"\u0a32\u0a4b\u0a21\u0a3c\u0a40\u0a02\u0a26\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c",faqHead:"\u0a05\u0a15\u0a38\u0a30 \u0a2a\u0a41\u0a71\u0a1b\u0a47 \u0a1c\u0a3e\u0a02\u0a26\u0a47 \u0a38\u0a35\u0a3e\u0a32",faqSubHead1:"\u0a06\u0a2a\u0a23\u0a47 \u0a15\u0a41\u0a71\u0a1d \u0a1c\u0a35\u0a3e\u0a2c\u0a3e\u0a02 \u0a32\u0a08 \u0a38\u0a3e\u0a21\u0a47 \u0a17\u0a3f\u0a06\u0a28 \u0a05\u0a27\u0a3e\u0a30 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a4b!",ques1:"\u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a15\u0a40 \u0a39\u0a48 \u0a05\u0a24\u0a47 \u0a07\u0a39 \u0a39\u0a4b\u0a30 \u0a38\u0a30\u0a15\u0a3e\u0a30\u0a40 \u0a2a\u0a4b\u0a30\u0a1f\u0a32\u0a3e\u0a02 \u0a24\u0a4b\u0a02 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a35\u0a71\u0a16\u0a30\u0a3e \u0a39\u0a48?",ans1:"\u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a05\u0a24\u0a47 \u0a30\u0a3e\u0a1c/\u0a15\u0a47\u0a02\u0a26\u0a30 \u0a38\u0a3c\u0a3e\u0a38\u0a24 \u0a2a\u0a4d\u0a30\u0a26\u0a47\u0a38\u0a3c \u0a38\u0a30\u0a15\u0a3e\u0a30\u0a3e\u0a02 \u0a26\u0a4b\u0a35\u0a3e\u0a02 \u0a24\u0a4b\u0a02 \u0a38\u0a30\u0a15\u0a3e\u0a30\u0a40 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a40 \u0a07\u0a71\u0a15 \u0a35\u0a3f\u0a38\u0a3c\u0a3e\u0a32 \u0a38\u0a3c\u0a4d\u0a30\u0a47\u0a23\u0a40 \u0a24\u0a71\u0a15 \u0a2a\u0a39\u0a41\u0a70\u0a1a \u0a32\u0a08 \u0a07\u0a71\u0a15 \u0a30\u0a3e\u0a38\u0a3c\u0a1f\u0a30\u0a40 \u0a2e\u0a70\u0a1a \u0a39\u0a48\u0964 \u0a07\u0a39 \u0a1c\u0a28\u0a38\u0a70\u0a16\u0a3f\u0a06 \u0a35\u0a47\u0a30\u0a35\u0a3f\u0a06\u0a02 \u0a26\u0a47 \u0a05\u0a27\u0a3e\u0a30 \u0a09\u0a71\u0a24\u0a47 \u0a38\u0a30\u0a15\u0a3e\u0a30\u0a40 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a40 \u0a16\u0a4b\u0a1c \u0a05\u0a24\u0a47 \u0a16\u0a4b\u0a1c \u0a32\u0a08 \u0a07\u0a71\u0a15 \u0a35\u0a28-\u0a38\u0a1f\u0a3e\u0a2a \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a39\u0a48\u0964 \u0a30\u0a35\u0a3e\u0a07\u0a24\u0a40 \u0a38\u0a30\u0a15\u0a3e\u0a30\u0a40 \u0a2a\u0a4b\u0a30\u0a1f\u0a32\u0a3e\u0a02 \u0a26\u0a47 \u0a09\u0a32\u0a1f, \u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a38\u0a30\u0a15\u0a3e\u0a30, \u0a30\u0a3e\u0a1c \u0a38\u0a30\u0a15\u0a3e\u0a30\u0a3e\u0a02 \u0a05\u0a24\u0a47 \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a38\u0a3c\u0a3e\u0a38\u0a3f\u0a24 \u0a2a\u0a4d\u0a30\u0a26\u0a47\u0a38\u0a3c\u0a3e\u0a02 \u0a26\u0a40\u0a06\u0a02 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a07\u0a71\u0a15 \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e '\u0a24\u0a47 \u0a32\u0a3f\u0a06\u0a09\u0a02\u0a26\u0a40 \u0a39\u0a48 \u0a05\u0a24\u0a47 \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a09\u0a28\u0a4d\u0a39\u0a3e\u0a02 \u0a26\u0a40 \u0a2f\u0a4b\u0a17\u0a24\u0a3e \u0a26\u0a47 \u0a05\u0a27\u0a3e\u0a30' \u0a24\u0a47 \u0a22\u0a41\u0a15\u0a35\u0a40\u0a06\u0a02 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a32\u0a71\u0a2d\u0a23 \u0a35\u0a3f\u0a71\u0a1a \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e \u0a15\u0a30\u0a26\u0a40 \u0a39\u0a48\u0964",ques2:"\u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a06\u0a2e \u0a28\u0a3e\u0a17\u0a30\u0a3f\u0a15\u0a3e\u0a02 \u0a26\u0a40 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a2e\u0a26\u0a26 \u0a15\u0a30\u0a47\u0a17\u0a40?",ans2:"\u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a28\u0a3e\u0a17\u0a30\u0a3f\u0a15\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a07\u0a71\u0a15 \u0a1c\u0a17\u0a4d\u0a39\u0a3e '\u0a24\u0a47 \u0a22\u0a41\u0a15\u0a35\u0a40\u0a06\u0a02 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a32\u0a71\u0a2d\u0a23 \u0a26\u0a47 \u0a2f\u0a4b\u0a17 \u0a2c\u0a23\u0a3e \u0a15\u0a47 \u0a38\u0a30\u0a15\u0a3e\u0a30\u0a40 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a24\u0a71\u0a15 \u0a2a\u0a39\u0a41\u0a70\u0a1a \u0a28\u0a42\u0a70 \u0a38\u0a30\u0a32 \u0a2c\u0a23\u0a3e\u0a09\u0a02\u0a26\u0a3e \u0a39\u0a48, \u0a1c\u0a3f\u0a38 \u0a28\u0a3e\u0a32 \u0a09\u0a28\u0a4d\u0a39\u0a3e\u0a02 \u0a26\u0a40 \u0a2f\u0a4b\u0a17\u0a24\u0a3e \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a15\u0a08 \u0a35\u0a3f\u0a2d\u0a3e\u0a17\u0a40 \u0a35\u0a48\u0a2c\u0a38\u0a3e\u0a08\u0a1f\u0a3e\u0a02' \u0a24\u0a47 \u0a1c\u0a3e\u0a23 \u0a1c\u0a3e\u0a02 \u0a35\u0a3f\u0a06\u0a2a\u0a15 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a26\u0a3f\u0a38\u0a3c\u0a3e-\u0a28\u0a3f\u0a30\u0a26\u0a47\u0a38\u0a3c\u0a3e\u0a02 \u0a26\u0a40 \u0a38\u0a2e\u0a40\u0a16\u0a3f\u0a06 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a1c\u0a3c\u0a30\u0a42\u0a30\u0a24 \u0a16\u0a24\u0a2e \u0a39\u0a4b \u0a1c\u0a3e\u0a02\u0a26\u0a40 \u0a39\u0a48\u0964",ques3:"\u0a2e\u0a3e\u0a08-\u0a38\u0a15\u0a40\u0a2e \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a15\u0a70\u0a2e \u0a15\u0a30\u0a26\u0a40 \u0a39\u0a48?",ans3:"\u0a2e\u0a3e\u0a08-\u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a28\u0a3e\u0a17\u0a30\u0a3f\u0a15\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a38\u0a30\u0a15\u0a3e\u0a30\u0a40 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a40 \u0a16\u0a4b\u0a1c \u0a15\u0a30\u0a28 \u0a35\u0a3f\u0a71\u0a1a \u0a2e\u0a26\u0a26 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a15 \u0a38\u0a27\u0a3e\u0a30\u0a28 \u0a05\u0a24\u0a47 \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e-\u0a05\u0a28\u0a41\u0a15\u0a42\u0a32 \u0a24\u0a3f\u0a70\u0a28-\u0a2a\u0a21\u0a3c\u0a3e\u0a35\u0a40 \u0a2a\u0a4d\u0a30\u0a15\u0a3f\u0a30\u0a3f\u0a06 \u0a26\u0a40 \u0a2a\u0a3e\u0a32\u0a23\u0a3e \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48 \u0a1c\u0a3f\u0a38 \u0a32\u0a08 \u0a09\u0a39 \u0a2f\u0a4b\u0a17 \u0a39\u0a28\u0a03 \u0a15\u0a26\u0a2e 1: \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e \u0a1c\u0a28\u0a38\u0a70\u0a16\u0a3f\u0a06, \u0a06\u0a2e\u0a26\u0a28, \u0a38\u0a2e\u0a3e\u0a1c\u0a3f\u0a15 \u0a38\u0a3c\u0a4d\u0a30\u0a47\u0a23\u0a40 \u0a06\u0a26\u0a3f \u0a35\u0a30\u0a17\u0a47 \u0a2c\u0a41\u0a28\u0a3f\u0a06\u0a26\u0a40 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a15\u0a26\u0a2e 2: \u0a26\u0a3f\u0a71\u0a24\u0a40 \u0a17\u0a08 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a26\u0a47 \u0a05\u0a27\u0a3e\u0a30 '\u0a24\u0a47, \u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e \u0a32\u0a08 \u0a38\u0a48\u0a02\u0a15\u0a21\u0a3c\u0a47 \u0a38\u0a30\u0a15\u0a3e\u0a30\u0a40 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a40\u0a06\u0a02 \u0a22\u0a41\u0a15\u0a35\u0a40\u0a06\u0a02 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a2a\u0a4d\u0a30\u0a26\u0a30\u0a38\u0a3c\u0a3f\u0a24 \u0a15\u0a30\u0a26\u0a40 \u0a39\u0a48\u0964 \u0a15\u0a26\u0a2e 3: \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e \u0a2f\u0a4b\u0a17 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a40 \u0a38\u0a42\u0a1a\u0a40 \u0a35\u0a3f\u0a71\u0a1a\u0a4b\u0a02 \u0a1a\u0a4b\u0a23 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48 \u0a05\u0a24\u0a47 \u0a35\u0a3f\u0a38\u0a24\u0a4d\u0a30\u0a3f\u0a24 \u0a17\u0a3f\u0a06\u0a28, \u0a05\u0a15\u0a38\u0a30 \u0a2a\u0a41\u0a71\u0a1b\u0a47 \u0a1c\u0a3e\u0a23 \u0a35\u0a3e\u0a32\u0a47 \u0a38\u0a35\u0a3e\u0a32\u0a3e\u0a02 \u0a05\u0a24\u0a47 \u0a05\u0a30\u0a1c\u0a3c\u0a40 \u0a2a\u0a4d\u0a30\u0a15\u0a3f\u0a30\u0a3f\u0a06 \u0a26\u0a47 \u0a28\u0a3e\u0a32 \u0a38\u0a2e\u0a30\u0a2a\u0a3f\u0a24 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a2a\u0a70\u0a28\u0a47 \u0a24\u0a4b\u0a02 \u0a35\u0a27\u0a47\u0a30\u0a47 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48 \u0a05\u0a24\u0a47 \u0a05\u0a30\u0a1c\u0a3c\u0a40 \u0a26\u0a47\u0a23 \u0a32\u0a08 \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a05\u0a30\u0a1c\u0a3c\u0a40 \u0a2f\u0a42\u0a06\u0a30\u0a10\u0a32 '\u0a24\u0a47 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964",ques4:"\u0a2e\u0a3e\u0a08-\u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a09\u0a71\u0a24\u0a47 \u0a38\u0a39\u0a40 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a28\u0a42\u0a70 \u0a1c\u0a3e\u0a23\u0a28 \u0a26\u0a40 \u0a2a\u0a4d\u0a30\u0a15\u0a3f\u0a30\u0a3f\u0a06 \u0a15\u0a40 \u0a39\u0a48?",ans4:"\u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e '\u0a24\u0a47 \u0a38\u0a39\u0a40 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a32\u0a71\u0a2d\u0a23 \u0a32\u0a08, \u0a28\u0a3e\u0a17\u0a30\u0a3f\u0a15 \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a26\u0a40 \u0a05\u0a27\u0a3f\u0a15\u0a3e\u0a30\u0a24 \u0a35\u0a48\u0a71\u0a2c\u0a38\u0a3e\u0a08\u0a1f' \u0a24\u0a47 \u0a1c\u0a3e \u0a15\u0a47 \u0a38\u0a3c\u0a41\u0a30\u0a42\u0a06\u0a24 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28\u0964 \u0a07\u0a71\u0a15 \u0a35\u0a3e\u0a30 \u0a39\u0a4b\u0a2e\u0a2a\u0a47\u0a1c \u0a09\u0a71\u0a24\u0a47, \u0a09\u0a39\u0a28\u0a3e\u0a02 \u0a28\u0a42\u0a70 '\u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a32\u0a08 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a32\u0a71\u0a2d\u0a4b' \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c\u0a24\u0a3e \u0a2e\u0a3f\u0a32\u0a47\u0a17\u0a40, \u0a1c\u0a4b \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a06\u0a2a\u0a23\u0a40 \u0a1c\u0a28\u0a38\u0a70\u0a16\u0a3f\u0a06 \u0a26\u0a47 \u0a35\u0a47\u0a30\u0a35\u0a47, \u0a1c\u0a3f\u0a35\u0a47\u0a02 \u0a15\u0a3f \u0a09\u0a2e\u0a30, \u0a32\u0a3f\u0a70\u0a17, \u0a06\u0a2e\u0a26\u0a28 \u0a26\u0a3e \u0a2a\u0a71\u0a27\u0a30, \u0a38\u0a3c\u0a4d\u0a30\u0a47\u0a23\u0a40, \u0a06\u0a26\u0a3f \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a06\u0a17\u0a3f\u0a06 \u0a26\u0a3f\u0a70\u0a26\u0a40 \u0a39\u0a48\u0964 \u0a07\u0a71\u0a15 \u0a35\u0a3e\u0a30 \u0a1c\u0a26\u0a4b\u0a02 \u0a07\u0a39 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a39\u0a4b \u0a1c\u0a3e\u0a02\u0a26\u0a47 \u0a39\u0a28, \u0a24\u0a3e\u0a02 \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e \u0a26\u0a47 \u0a2a\u0a4d\u0a30\u0a4b\u0a2b\u0a3e\u0a08\u0a32 \u0a26\u0a47 \u0a05\u0a27\u0a3e\u0a30 '\u0a24\u0a47 \u0a38\u0a70\u0a2c\u0a70\u0a27\u0a3f\u0a24 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a40 \u0a07\u0a71\u0a15 \u0a38\u0a42\u0a1a\u0a40 \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a47\u0a17\u0a3e\u0964",ques5:"\u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a2c\u0a3e\u0a30\u0a47 \u0a2e\u0a48\u0a28\u0a42\u0a70 \u0a15\u0a3f\u0a39\u0a21\u0a3c\u0a40 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a2e\u0a47\u0a30\u0a40 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a09\u0a71\u0a24\u0a47 \u0a2e\u0a3f\u0a32 \u0a38\u0a15\u0a26\u0a40 \u0a39\u0a48?",ans5:"\u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a39\u0a30\u0a47\u0a15 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a2c\u0a3e\u0a30\u0a47 \u0a35\u0a3f\u0a06\u0a2a\u0a15 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48, \u0a1c\u0a3f\u0a38 \u0a35\u0a3f\u0a71\u0a1a \u0a2f\u0a4b\u0a17\u0a24\u0a3e \u0a26\u0a47 \u0a2e\u0a3e\u0a2a\u0a26\u0a70\u0a21, \u0a2a\u0a47\u0a38\u0a3c \u0a15\u0a40\u0a24\u0a47 \u0a17\u0a0f \u0a32\u0a3e\u0a2d, \u0a05\u0a30\u0a1c\u0a3c\u0a40 \u0a2a\u0a4d\u0a30\u0a15\u0a3f\u0a30\u0a3f\u0a06 \u0a05\u0a24\u0a47 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a26\u0a3e \u0a32\u0a3e\u0a2d \u0a32\u0a48\u0a23 \u0a32\u0a08 \u0a32\u0a4b\u0a21\u0a3c\u0a40\u0a02\u0a26\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a38\u0a3c\u0a3e\u0a2e\u0a32 \u0a39\u0a28\u0964 \u0a07\u0a38 \u0a35\u0a3f\u0a71\u0a1a \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a28\u0a3e\u0a32 \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a06\u0a2e \u0a2a\u0a4d\u0a30\u0a38\u0a3c\u0a28\u0a3e\u0a02 \u0a26\u0a47 \u0a39\u0a71\u0a32 \u0a32\u0a08 \u0a07\u0a71\u0a15 \u0a38\u0a2e\u0a30\u0a2a\u0a3f\u0a24 \u0a05\u0a15\u0a38\u0a30 \u0a2a\u0a41\u0a71\u0a1b\u0a47 \u0a1c\u0a3e\u0a23 \u0a35\u0a3e\u0a32\u0a47 \u0a2a\u0a4d\u0a30\u0a38\u0a3c\u0a28 (\u0a10\u0a71\u0a2b\u0a0f\u0a15\u0a3f\u0a0a.) \u0a38\u0a48\u0a15\u0a38\u0a3c\u0a28 \u0a35\u0a40 \u0a39\u0a48\u0964",ques6:"\u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a09\u0a71\u0a24\u0a47 \u0a15\u0a3f\u0a39\u0a21\u0a3c\u0a40\u0a06\u0a02 \u0a35\u0a3f\u0a06\u0a2a\u0a15 \u0a38\u0a3c\u0a4d\u0a30\u0a47\u0a23\u0a40\u0a06\u0a02 \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a39\u0a28?",ans6:"\u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a09\u0a71\u0a24\u0a47 \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a09\u0a28\u0a4d\u0a39\u0a3e\u0a02 \u0a26\u0a47 \u0a32\u0a3e\u0a2d\u0a3e\u0a02 \u0a26\u0a40 \u0a2a\u0a4d\u0a30\u0a15\u0a3f\u0a30\u0a24\u0a40 \u0a05\u0a24\u0a47 \u0a1f\u0a40\u0a1a\u0a3e\u0a17\u0a24 \u0a32\u0a3e\u0a2d\u0a3e\u0a30\u0a25\u0a40\u0a06\u0a02 \u0a26\u0a47 \u0a05\u0a27\u0a3e\u0a30 \u0a09\u0a71\u0a24\u0a47 15 \u0a38\u0a3c\u0a4d\u0a30\u0a47\u0a23\u0a40\u0a06\u0a02 \u0a35\u0a3f\u0a71\u0a1a \u0a35\u0a70\u0a21\u0a3f\u0a06 \u0a17\u0a3f\u0a06 \u0a39\u0a48\u0964 \u0a07\u0a28\u0a4d\u0a39\u0a3e\u0a02 \u0a38\u0a3c\u0a4d\u0a30\u0a47\u0a23\u0a40\u0a06\u0a02 \u0a35\u0a3f\u0a71\u0a1a \u0a16\u0a47\u0a24\u0a40\u0a2c\u0a3e\u0a21\u0a3c\u0a40, \u0a2a\u0a47\u0a02\u0a21\u0a42 \u0a05\u0a24\u0a47 \u0a35\u0a3e\u0a24\u0a3e\u0a35\u0a30\u0a23; \u0a2c\u0a48\u0a02\u0a15\u0a3f\u0a70\u0a17, \u0a35\u0a3f\u0a71\u0a24\u0a40 \u0a38\u0a47\u0a35\u0a3e\u0a35\u0a3e\u0a02 \u0a05\u0a24\u0a47 \u0a2c\u0a40\u0a2e\u0a3e; \u0a15\u0a3e\u0a30\u0a4b\u0a2c\u0a3e\u0a30 \u0a05\u0a24\u0a47 \u0a09\u0a71\u0a26\u0a2e\u0a24\u0a3e; \u0a38\u0a3f\u0a71\u0a16\u0a3f\u0a06 \u0a05\u0a24\u0a47 \u0a38\u0a3f\u0a71\u0a16\u0a3f\u0a06; \u0a38\u0a3f\u0a39\u0a24 \u0a05\u0a24\u0a47 \u0a24\u0a70\u0a26\u0a30\u0a41\u0a38\u0a24\u0a40; \u0a30\u0a3f\u0a39\u0a3e\u0a07\u0a38\u0a3c \u0a05\u0a24\u0a47 \u0a38\u0a3c\u0a48\u0a32\u0a1f\u0a30; \u0a1c\u0a28\u0a24\u0a15 \u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a06, \u0a15\u0a3e\u0a28\u0a42\u0a70\u0a28 \u0a05\u0a24\u0a47 \u0a28\u0a3f\u0a06\u0a02; \u0a35\u0a3f\u0a17\u0a3f\u0a06\u0a28, \u0a06\u0a08. \u0a1f\u0a40. \u0a05\u0a24\u0a47 \u0a38\u0a70\u0a1a\u0a3e\u0a30; \u0a39\u0a41\u0a28\u0a30 \u0a05\u0a24\u0a47 \u0a30\u0a4b\u0a1c\u0a3c\u0a17\u0a3e\u0a30; \u0a38\u0a2e\u0a3e\u0a1c \u0a2d\u0a32\u0a3e\u0a08 \u0a05\u0a24\u0a47 \u0a38\u0a38\u0a3c\u0a15\u0a24\u0a40\u0a15\u0a30\u0a28; \u0a16\u0a47\u0a21\u0a3e\u0a02 \u0a05\u0a24\u0a47 \u0a38\u0a71\u0a2d\u0a3f\u0a06\u0a1a\u0a3e\u0a30; \u0a06\u0a35\u0a3e\u0a1c\u0a3e\u0a08 \u0a05\u0a24\u0a47 \u0a2c\u0a41\u0a28\u0a3f\u0a06\u0a26\u0a40 \u0a22\u0a3e\u0a02\u0a1a\u0a3e; \u0a2f\u0a3e\u0a24\u0a30\u0a3e \u0a05\u0a24\u0a47 \u0a38\u0a48\u0a30-\u0a38\u0a2a\u0a3e\u0a1f\u0a3e; \u0a09\u0a2a\u0a2f\u0a4b\u0a17\u0a24\u0a3e \u0a05\u0a24\u0a47 \u0a38\u0a35\u0a71\u0a1b\u0a24\u0a3e; \u0a05\u0a24\u0a47 \u0a14\u0a30\u0a24\u0a3e\u0a02 \u0a05\u0a24\u0a47 \u0a2c\u0a71\u0a1a\u0a47 \u0a38\u0a3c\u0a3e\u0a2e\u0a32 \u0a39\u0a28\u0964",ques7:"\u0a15\u0a40 \u0a2e\u0a3e\u0a08-\u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a2c\u0a39\u0a41\u0a2d\u0a3e\u0a38\u0a3c\u0a3e\u0a08 \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48?",ans7:"\u0a39\u0a3e\u0a02, \u0a2e\u0a3e\u0a08\u0a38\u0a3c\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a35\u0a30\u0a24\u0a2e\u0a3e\u0a28 \u0a35\u0a3f\u0a71\u0a1a \u0a05\u0a70\u0a17\u0a30\u0a47\u0a1c\u0a3c\u0a40 \u0a38\u0a2e\u0a47\u0a24 15 \u0a2d\u0a3e\u0a38\u0a3c\u0a3e\u0a35\u0a3e\u0a02 \u0a35\u0a3f\u0a71\u0a1a \u0a38\u0a2e\u0a71\u0a17\u0a30\u0a40 \u0a26\u0a3e \u0a38\u0a2e\u0a30\u0a25\u0a28 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a05\u0a24\u0a3f\u0a30\u0a3f\u0a15\u0a24 \u0a2d\u0a3e\u0a30\u0a24\u0a40 \u0a2d\u0a3e\u0a38\u0a3c\u0a3e\u0a35\u0a3e\u0a02 \u0a32\u0a08 \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e \u0a1c\u0a32\u0a26\u0a40 \u0a39\u0a40 \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a40\u0964",ques8:"\u0a15\u0a40 \u0a2e\u0a3e\u0a08-\u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a05\u0a24\u0a47 \u0a30\u0a3e\u0a1c/\u0a15\u0a47\u0a02\u0a26\u0a30 \u0a38\u0a3c\u0a3e\u0a38\u0a3f\u0a24 \u0a2a\u0a4d\u0a30\u0a26\u0a47\u0a38\u0a3c-\u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a4b\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a2a\u0a4d\u0a30\u0a26\u0a30\u0a38\u0a3c\u0a3f\u0a24 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48?",ans8:"\u0a39\u0a3e\u0a02, \u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a35\u0a30\u0a24\u0a2e\u0a3e\u0a28 \u0a35\u0a3f\u0a71\u0a1a 4,700 \u0a24\u0a4b\u0a02 \u0a35\u0a71\u0a27 \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a38\u0a30\u0a15\u0a3e\u0a30 \u0a05\u0a24\u0a47 \u0a30\u0a3e\u0a1c/\u0a15\u0a47\u0a02\u0a26\u0a30 \u0a38\u0a3c\u0a3e\u0a38\u0a3f\u0a24 \u0a2a\u0a4d\u0a30\u0a26\u0a47\u0a38\u0a3c \u0a38\u0a30\u0a15\u0a3e\u0a30 \u0a26\u0a40\u0a06\u0a02 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a24\u0a71\u0a15 \u0a2a\u0a39\u0a41\u0a70\u0a1a \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a05\u0a24\u0a3f\u0a30\u0a3f\u0a15\u0a24 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a28\u0a3f\u0a30\u0a70\u0a24\u0a30 \u0a05\u0a27\u0a3e\u0a30 '\u0a24\u0a47 \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e' \u0a24\u0a47 \u0a38\u0a3c\u0a3e\u0a2e\u0a32 \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e\u0a02\u0a26\u0a3e \u0a30\u0a39\u0a47\u0a17\u0a3e\u0964",ques9:"\u0a2e\u0a48\u0a28\u0a42\u0a70 \u0a2e\u0a3e\u0a08-\u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a09\u0a71\u0a24\u0a47 \u0a15\u0a4b\u0a08 \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c \u0a38\u0a15\u0a40\u0a2e \u0a28\u0a39\u0a40\u0a02 \u0a2e\u0a3f\u0a32\u0a40\u0964 \u0a2e\u0a48\u0a02 \u0a15\u0a40 \u0a15\u0a30\u0a3e\u0a02?",ans9:"\u0a35\u0a30\u0a24\u0a2e\u0a3e\u0a28 \u0a35\u0a3f\u0a71\u0a1a, 4,700 \u0a24\u0a4b\u0a02 \u0a35\u0a71\u0a27 \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a38\u0a30\u0a15\u0a3e\u0a30 \u0a05\u0a24\u0a47 \u0a30\u0a3e\u0a1c/\u0a15\u0a47\u0a02\u0a26\u0a30 \u0a38\u0a3c\u0a3e\u0a38\u0a3f\u0a24 \u0a2a\u0a4d\u0a30\u0a26\u0a47\u0a38\u0a3c \u0a38\u0a30\u0a15\u0a3e\u0a30 \u0a26\u0a40\u0a06\u0a02 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e '\u0a24\u0a47 \u0a38\u0a3c\u0a3e\u0a2e\u0a32 \u0a15\u0a40\u0a24\u0a3e \u0a17\u0a3f\u0a06 \u0a39\u0a48\u0964 \u0a35\u0a3e\u0a27\u0a42 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a28\u0a3f\u0a2f\u0a2e\u0a3f\u0a24 \u0a24\u0a4c\u0a30 \u0a09\u0a71\u0a24\u0a47 \u0a1c\u0a4b\u0a21\u0a3c\u0a40\u0a06\u0a02 \u0a1c\u0a3e \u0a30\u0a39\u0a40\u0a06\u0a02 \u0a39\u0a28\u0964 \u0a28\u0a3e\u0a17\u0a30\u0a3f\u0a15 \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e '\u0a24\u0a47 \u0a09\u0a2a\u0a32\u0a2c\u0a27' \u0a17\u0a47\u0a1f \u0a07\u0a28 \u0a1f\u0a71\u0a1a '\u0a38\u0a48\u0a15\u0a38\u0a3c\u0a28 \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a40 \u0a17\u0a41\u0a70\u0a2e \u0a39\u0a4b\u0a08 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a2c\u0a3e\u0a30\u0a47 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a1c\u0a3e\u0a02 \u0a38\u0a41\u0a1d\u0a3e\u0a05 \u0a38\u0a3e\u0a02\u0a1d\u0a47 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28\u0964",ques10:"\u0a2e\u0a48\u0a02 \u0a2e\u0a30\u0a3e\u0a20\u0a40 \u0a2d\u0a3e\u0a38\u0a3c\u0a3e \u0a35\u0a3f\u0a71\u0a1a \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a40 \u0a38\u0a2e\u0a71\u0a17\u0a30\u0a40 \u0a35\u0a3f\u0a71\u0a1a \u0a15\u0a41\u0a1d \u0a17\u0a32\u0a24\u0a40\u0a06\u0a02 \u0a32\u0a71\u0a2d\u0a40\u0a06\u0a02\u0964 \u0a2e\u0a48\u0a02 \u0a15\u0a40 \u0a15\u0a30\u0a3e\u0a02?",ans10:"\u0a1c\u0a47\u0a15\u0a30 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a26\u0a40 \u0a38\u0a2e\u0a71\u0a17\u0a30\u0a40 \u0a26\u0a47 \u0a2e\u0a30\u0a3e\u0a20\u0a40 \u0a38\u0a70\u0a38\u0a15\u0a30\u0a23 \u0a35\u0a3f\u0a71\u0a1a \u0a15\u0a4b\u0a08 \u0a35\u0a3f\u0a38\u0a70\u0a17\u0a24\u0a40 \u0a35\u0a47\u0a16\u0a40 \u0a1c\u0a3e\u0a02\u0a26\u0a40 \u0a39\u0a48, \u0a24\u0a3e\u0a02 \u0a28\u0a3e\u0a17\u0a30\u0a3f\u0a15\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a38\u0a2a\u0a71\u0a38\u0a3c\u0a1f\u0a40\u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a05\u0a70\u0a17\u0a30\u0a47\u0a1c\u0a3c\u0a40 \u0a38\u0a70\u0a38\u0a15\u0a30\u0a23 \u0a26\u0a3e \u0a39\u0a35\u0a3e\u0a32\u0a3e \u0a32\u0a48\u0a23 \u0a26\u0a40 \u0a38\u0a32\u0a3e\u0a39 \u0a26\u0a3f\u0a71\u0a24\u0a40 \u0a1c\u0a3e\u0a02\u0a26\u0a40 \u0a39\u0a48\u0964 \u0a1c\u0a47 \u0a38\u0a2e\u0a71\u0a38\u0a3f\u0a06 \u0a2c\u0a23\u0a40 \u0a30\u0a39\u0a3f\u0a70\u0a26\u0a40 \u0a39\u0a48, \u0a24\u0a3e\u0a02 \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a2e\u0a70\u0a24\u0a30\u0a3e\u0a32\u0a47 \u0a1c\u0a3e\u0a02 \u0a35\u0a3f\u0a2d\u0a3e\u0a17 \u0a26\u0a47 \u0a05\u0a27\u0a3f\u0a15\u0a3e\u0a30\u0a24 \u0a2a\u0a4b\u0a30\u0a1f\u0a32 \u0a28\u0a42\u0a70 \u0a38\u0a2d \u0a24\u0a4b\u0a02 \u0a38\u0a39\u0a40 \u0a05\u0a24\u0a47 \u0a24\u0a3e\u0a1c\u0a3c\u0a3e \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a32\u0a08 \u0a2d\u0a47\u0a1c\u0a3f\u0a06 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a07\u0a38 \u0a24\u0a4b\u0a02 \u0a07\u0a32\u0a3e\u0a35\u0a3e, support-myscheme[at]digitalindia[dot]gov[dot]in '\u0a24\u0a47 \u0a08\u0a2e\u0a47\u0a32 \u0a2d\u0a47\u0a1c \u0a15\u0a47 \u0a07\u0a38 \u0a2e\u0a41\u0a71\u0a26\u0a47 \u0a26\u0a40 \u0a30\u0a3f\u0a2a\u0a4b\u0a30\u0a1f \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a40 \u0a39\u0a48\u0964",ques11:"\u0a2e\u0a48\u0a02 \u0a09\u0a28\u0a4d\u0a39\u0a3e\u0a02 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a40 \u0a2a\u0a21\u0a3c\u0a1a\u0a4b\u0a32 \u0a15\u0a30\u0a28\u0a3e \u0a1a\u0a3e\u0a39\u0a41\u0a70\u0a26\u0a3e \u0a39\u0a3e\u0a02 \u0a1c\u0a3f\u0a28\u0a4d\u0a39\u0a3e\u0a02 \u0a24\u0a39\u0a3f\u0a24 \u0a35\u0a3f\u0a26\u0a3f\u0a06\u0a30\u0a25\u0a40\u0a06\u0a02 \u0a28\u0a42\u0a70 \u0a38\u0a15\u0a3e\u0a32\u0a30\u0a38\u0a3c\u0a3f\u0a2a \u0a26\u0a3f\u0a71\u0a24\u0a40 \u0a1c\u0a3e\u0a02\u0a26\u0a40 \u0a39\u0a48\u0964 \u0a15\u0a40 \u0a07\u0a39 \u0a2e\u0a3e\u0a08-\u0a38\u0a15\u0a40\u0a2e \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a38\u0a70\u0a2d\u0a35 \u0a39\u0a48?",ans11:"\u0a39\u0a3e\u0a02, \u0a2e\u0a3e\u0a08-\u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a07\u0a71\u0a15 \u0a15\u0a40\u0a35\u0a30\u0a21-\u0a05\u0a27\u0a3e\u0a30\u0a24 \u0a16\u0a4b\u0a1c \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c\u0a24\u0a3e \u0a26\u0a40 \u0a2a\u0a47\u0a38\u0a3c\u0a15\u0a38\u0a3c \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48 \u0a1c\u0a4b \u0a28\u0a3e\u0a17\u0a30\u0a3f\u0a15\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a35\u0a3f\u0a26\u0a3f\u0a06\u0a30\u0a25\u0a40\u0a06\u0a02 \u0a32\u0a08 \u0a38\u0a15\u0a3e\u0a32\u0a30\u0a38\u0a3c\u0a3f\u0a2a \u0a38\u0a2e\u0a47\u0a24 \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a40\u0a24\u0a47 \u0a17\u0a0f \u0a32\u0a3e\u0a2d\u0a3e\u0a02 \u0a26\u0a40 \u0a15\u0a3f\u0a38\u0a2e \u0a05\u0a24\u0a47 \u0a39\u0a71\u0a26 \u0a26\u0a47 \u0a05\u0a27\u0a3e\u0a30 '\u0a24\u0a47 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a05\u0a38\u0a3e\u0a28\u0a40 \u0a28\u0a3e\u0a32 \u0a16\u0a4b\u0a1c\u0a23, \u0a16\u0a4b\u0a1c\u0a23 \u0a05\u0a24\u0a47 \u0a2a\u0a1b\u0a3e\u0a23 \u0a15\u0a30\u0a28 \u0a26\u0a47 \u0a2f\u0a4b\u0a17 \u0a2c\u0a23\u0a3e\u0a09\u0a02\u0a26\u0a3e \u0a39\u0a48\u0964",ques12:"\u0a2e\u0a48\u0a02 \u0a07\u0a71\u0a15 \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a32\u0a08 \u0a05\u0a30\u0a1c\u0a3c\u0a40 \u0a26\u0a47\u0a23\u0a3e \u0a1a\u0a3e\u0a39\u0a41\u0a70\u0a26\u0a3e \u0a39\u0a3e\u0a02 \u0a05\u0a24\u0a47 \u0a05\u0a30\u0a1c\u0a3c\u0a40 \u0a26\u0a47\u0a23 \u0a32\u0a08 \u0a32\u0a4b\u0a21\u0a3c\u0a40\u0a02\u0a26\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c\u0a3e\u0a02 \u0a2c\u0a3e\u0a30\u0a47 \u0a1c\u0a3e\u0a23\u0a28\u0a3e \u0a1a\u0a3e\u0a39\u0a41\u0a70\u0a26\u0a3e \u0a39\u0a3e\u0a02\u0964 \u0a15\u0a40 \u0a2e\u0a48\u0a02 \u0a07\u0a39 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a06\u0a2a\u0a23\u0a40 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a09\u0a71\u0a24\u0a47 \u0a32\u0a71\u0a2d \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a3e\u0a02?",ans12:"\u0a39\u0a3e\u0a02, \u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a39\u0a30\u0a47\u0a15 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a32\u0a08 \u0a05\u0a30\u0a1c\u0a3c\u0a40 \u0a26\u0a47\u0a23 \u0a32\u0a08 \u0a32\u0a4b\u0a21\u0a3c\u0a40\u0a02\u0a26\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c\u0a3e\u0a02 \u0a26\u0a40 \u0a2a\u0a42\u0a30\u0a40 \u0a38\u0a42\u0a1a\u0a40 \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48, \u0a1c\u0a3f\u0a38 \u0a28\u0a3e\u0a32 \u0a28\u0a3e\u0a17\u0a30\u0a3f\u0a15 \u0a06\u0a38\u0a3e\u0a28\u0a40 \u0a28\u0a3e\u0a32 \u0a24\u0a3f\u0a06\u0a30 \u0a39\u0a4b \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28 \u0a05\u0a24\u0a47 \u0a05\u0a30\u0a1c\u0a3c\u0a40 \u0a26\u0a47 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28\u0964",ques13:"\u0a15\u0a40 \u0a2e\u0a48\u0a02 \u0a06\u0a2a\u0a23\u0a40 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a32\u0a08 \u0a05\u0a30\u0a1c\u0a3c\u0a40 \u0a26\u0a47 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a3e\u0a02?",ans13:"\u0a35\u0a30\u0a24\u0a2e\u0a3e\u0a28 \u0a35\u0a3f\u0a71\u0a1a, \u0a2e\u0a3e\u0a08-\u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a2e\u0a70\u0a24\u0a30\u0a3e\u0a32\u0a47 \u0a1c\u0a3e\u0a02 \u0a35\u0a3f\u0a2d\u0a3e\u0a17 \u0a26\u0a47 \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a38\u0a15\u0a40\u0a2e \u0a10\u0a2a\u0a32\u0a40\u0a15\u0a47\u0a38\u0a3c\u0a28 \u0a2a\u0a47\u0a1c '\u0a24\u0a47 \u0a2e\u0a41\u0a21\u0a3c \u0a28\u0a3f\u0a30\u0a26\u0a47\u0a38\u0a3c\u0a3f\u0a24 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a06\u0a09\u0a23 \u0a35\u0a3e\u0a32\u0a47 \u0a2a\u0a21\u0a3c\u0a3e\u0a35\u0a3e\u0a02 \u0a35\u0a3f\u0a71\u0a1a, \u0a07\u0a39 \u0a15\u0a32\u0a2a\u0a28\u0a3e \u0a15\u0a40\u0a24\u0a40 \u0a17\u0a08 \u0a39\u0a48 \u0a15\u0a3f \u0a28\u0a3e\u0a17\u0a30\u0a3f\u0a15 \u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a4b\u0a30\u0a1f\u0a32/\u0a09\u0a2e\u0a70\u0a17 \u0a10\u0a2a\u0a32\u0a40\u0a15\u0a47\u0a38\u0a3c\u0a28 \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a32\u0a08 \u0a05\u0a30\u0a1c\u0a3c\u0a40 \u0a26\u0a47 \u0a38\u0a15\u0a23\u0a17\u0a47\u0964",ques14:'\u0a07\u0a71\u0a15 \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e \u0a32\u0a08 \u0a38\u0a2d \u0a24\u0a4b\u0a02 \u0a35\u0a27\u0a40\u0a06 \u0a05\u0a28\u0a41\u0a15\u0a42\u0a32 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a40 \u0a2a\u0a21\u0a3c\u0a1a\u0a4b\u0a32 \u0a15\u0a30\u0a28 \u0a32\u0a08, \u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a26\u0a40 "\u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40\u0a17\u0a24 \u0a16\u0a4b\u0a1c" \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c\u0a24\u0a3e \u0a35\u0a3f\u0a71\u0a1a \u0a15\u0a3f\u0a39\u0a21\u0a3c\u0a47 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a1c\u0a3c\u0a30\u0a42\u0a30\u0a24 \u0a39\u0a48?',ans14:'\u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a26\u0a40 "\u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40\u0a17\u0a24 \u0a16\u0a4b\u0a1c" \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c\u0a24\u0a3e \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a28 \u0a32\u0a08, \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a32\u0a3f\u0a70\u0a17, \u0a09\u0a2e\u0a30, \u0a35\u0a3f\u0a06\u0a39\u0a41\u0a24\u0a3e \u0a38\u0a25\u0a3f\u0a24\u0a40, \u0a30\u0a3e\u0a1c, \u0a28\u0a3f\u0a35\u0a3e\u0a38 \u0a38\u0a25\u0a3e\u0a28 (\u0a38\u0a3c\u0a39\u0a3f\u0a30\u0a40 \u0a1c\u0a3e\u0a02 \u0a2a\u0a47\u0a02\u0a21\u0a42), \u0a38\u0a2e\u0a3e\u0a1c\u0a3f\u0a15 \u0a38\u0a3c\u0a4d\u0a30\u0a47\u0a23\u0a40, \u0a05\u0a2a\u0a70\u0a17\u0a24\u0a3e \u0a38\u0a25\u0a3f\u0a24\u0a40, \u0a18\u0a71\u0a1f \u0a17\u0a3f\u0a23\u0a24\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40, \u0a30\u0a41\u0a1c\u0a3c\u0a17\u0a3e\u0a30 \u0a26\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a05\u0a24\u0a47 \u0a39\u0a4b\u0a30 \u0a38\u0a70\u0a2c\u0a70\u0a27\u0a3f\u0a24 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a35\u0a30\u0a17\u0a47 \u0a2e\u0a41\u0a22\u0a32\u0a47 \u0a2a\u0a4d\u0a30\u0a4b\u0a2b\u0a3e\u0a08\u0a32 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a32\u0a4b\u0a21\u0a3c \u0a39\u0a41\u0a70\u0a26\u0a40 \u0a39\u0a48\u0964 \u0a07\u0a39 \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e \u0a26\u0a47 \u0a2a\u0a4d\u0a30\u0a4b\u0a2b\u0a3e\u0a08\u0a32 \u0a32\u0a08 \u0a38\u0a2d \u0a24\u0a4b\u0a02 \u0a22\u0a41\u0a15\u0a35\u0a40\u0a02 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a40 \u0a2a\u0a1b\u0a3e\u0a23 \u0a15\u0a30\u0a28 \u0a35\u0a3f\u0a71\u0a1a \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48\u0964',ques15:'"\u0a1c\u0a3e\u0a02\u0a1a \u0a2f\u0a4b\u0a17\u0a24\u0a3e \u0a2a\u0a4d\u0a30\u0a38\u0a3c\u0a28\u0a3e\u0a35\u0a32\u0a40" \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c\u0a24\u0a3e \u0a15\u0a40 \u0a39\u0a48?',ans15:'"\u0a1c\u0a3e\u0a02\u0a1a \u0a2f\u0a4b\u0a17\u0a24\u0a3e \u0a2a\u0a4d\u0a30\u0a38\u0a3c\u0a28\u0a3e\u0a35\u0a32\u0a40" \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c\u0a24\u0a3e \u0a2f\u0a4b\u0a1c\u0a28\u0a3e-\u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c \u0a2f\u0a4b\u0a17\u0a24\u0a3e \u0a2e\u0a3e\u0a2a\u0a26\u0a70\u0a21\u0a3e\u0a02 \u0a09\u0a71\u0a24\u0a47 \u0a15\u0a47\u0a02\u0a26\u0a4d\u0a30\u0a3f\u0a24 \u0a39\u0a48 \u0a05\u0a24\u0a47 \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a07\u0a71\u0a15 \u0a38\u0a27\u0a3e\u0a30\u0a28 \u0a39\u0a3e\u0a02/\u0a28\u0a39\u0a40\u0a02-\u0a05\u0a27\u0a3e\u0a30\u0a24 \u0a2a\u0a4d\u0a30\u0a38\u0a3c\u0a28\u0a3e\u0a35\u0a32\u0a40 \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a06\u0a2a\u0a23\u0a40 \u0a2f\u0a4b\u0a17\u0a24\u0a3e \u0a26\u0a40 \u0a24\u0a38\u0a26\u0a40\u0a15 \u0a15\u0a30\u0a28 \u0a26\u0a47 \u0a2f\u0a4b\u0a17 \u0a2c\u0a23\u0a3e\u0a09\u0a02\u0a26\u0a40 \u0a39\u0a48\u0964 \u0a2e\u0a41\u0a39\u0a71\u0a08\u0a06 \u0a15\u0a40\u0a24\u0a40\u0a06\u0a02 \u0a17\u0a08\u0a06\u0a02 \u0a2a\u0a4d\u0a30\u0a24\u0a40\u0a15\u0a3f\u0a30\u0a3f\u0a06\u0a35\u0a3e\u0a02 \u0a26\u0a47 \u0a05\u0a27\u0a3e\u0a30 \'\u0a24\u0a47, \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e \u0a24\u0a41\u0a30\u0a70\u0a24 \u0a2e\u0a41\u0a32\u0a3e\u0a02\u0a15\u0a23 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28 \u0a15\u0a3f \u0a15\u0a40 \u0a09\u0a39 \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a32\u0a08 \u0a2f\u0a4b\u0a17 \u0a39\u0a28\u0964',ques16:"\u0a15\u0a40 \u0a2e\u0a3e\u0a08\u0a38\u0a3c\u0a40\u0a2e \u0a35\u0a3f\u0a71\u0a1a \u0a1a\u0a48\u0a1f\u0a2c\u0a4c\u0a1f \u0a26\u0a40 \u0a38\u0a39\u0a42\u0a32\u0a24 \u0a39\u0a48 \u0a05\u0a24\u0a47 \u0a07\u0a39 \u0a28\u0a3e\u0a17\u0a30\u0a3f\u0a15\u0a3e\u0a02 \u0a26\u0a40 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a2e\u0a26\u0a26 \u0a15\u0a30\u0a26\u0a40 \u0a39\u0a48?",ans16:"\u0a39\u0a3e\u0a02, \u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a28\u0a47 \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a38\u0a30\u0a15\u0a3e\u0a30\u0a40 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a40 \u0a16\u0a4b\u0a1c \u0a15\u0a30\u0a28 \u0a35\u0a3f\u0a71\u0a1a \u0a28\u0a3e\u0a17\u0a30\u0a3f\u0a15\u0a3e\u0a02 \u0a26\u0a40 \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e \u0a32\u0a08 \u0a07\u0a71\u0a15 \u0a05\u0a35\u0a3e\u0a1c\u0a3c-\u0a38\u0a2e\u0a30\u0a71\u0a25, \u0a2c\u0a39\u0a41\u0a2d\u0a3e\u0a38\u0a3c\u0a3e\u0a08 \u0a0f. \u0a06\u0a08.-\u0a38\u0a70\u0a1a\u0a3e\u0a32\u0a3f\u0a24 \u0a1a\u0a48\u0a1f\u0a2c\u0a4c\u0a1f \u0a28\u0a42\u0a70 \u0a24\u0a48\u0a28\u0a3e\u0a24 \u0a15\u0a40\u0a24\u0a3e \u0a39\u0a48\u0964 \u0a1a\u0a48\u0a1f\u0a2c\u0a4c\u0a1f \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e \u0a26\u0a47 \u0a2a\u0a4d\u0a30\u0a38\u0a3c\u0a28\u0a3e\u0a02 \u0a26\u0a47 \u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40\u0a17\u0a24 \u0a05\u0a24\u0a47 \u0a24\u0a41\u0a30\u0a70\u0a24 \u0a1c\u0a35\u0a3e\u0a2c \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48, \u0a17\u0a71\u0a32\u0a2c\u0a3e\u0a24 \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a26\u0a40 \u0a16\u0a4b\u0a1c \u0a28\u0a42\u0a70 \u0a38\u0a30\u0a32 \u0a2c\u0a23\u0a3e\u0a09\u0a02\u0a26\u0a3e \u0a39\u0a48, \u0a05\u0a24\u0a47 \u0a07\u0a71\u0a15 \u0a06\u0a15\u0a30\u0a38\u0a3c\u0a15 \u0a05\u0a24\u0a47 \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e-\u0a05\u0a28\u0a41\u0a15\u0a42\u0a32 \u0a05\u0a28\u0a41\u0a2d\u0a35 \u0a26\u0a40 \u0a2a\u0a47\u0a38\u0a3c\u0a15\u0a38\u0a3c \u0a15\u0a30\u0a15\u0a47 \u0a38\u0a30\u0a15\u0a3e\u0a30-\u0a28\u0a3e\u0a17\u0a30\u0a3f\u0a15 \u0a17\u0a71\u0a32\u0a2c\u0a3e\u0a24 \u0a28\u0a42\u0a70 \u0a35\u0a27\u0a3e\u0a09\u0a02\u0a26\u0a3e \u0a39\u0a48\u0964",ques17:"\u0a2e\u0a3e\u0a08-\u0a38\u0a15\u0a40\u0a2e \u0a09\u0a71\u0a24\u0a47 \u0a0f. \u0a06\u0a08. \u0a1a\u0a48\u0a1f\u0a2c\u0a4c\u0a1f \u0a26\u0a40\u0a06\u0a02 \u0a2e\u0a41\u0a71\u0a16 \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c\u0a24\u0a3e\u0a35\u0a3e\u0a02 \u0a15\u0a40 \u0a39\u0a28?",ans17:"\u0a2e\u0a3e\u0a08-\u0a38\u0a15\u0a40\u0a2e \u0a0f. \u0a06\u0a08. \u0a1a\u0a48\u0a1f\u0a2c\u0a4b\u0a1f \u0a06\u0a35\u0a3e\u0a1c\u0a3c \u0a05\u0a24\u0a47 \u0a1f\u0a48\u0a15\u0a38\u0a1f-\u0a05\u0a27\u0a3e\u0a30\u0a24 \u0a17\u0a71\u0a32\u0a2c\u0a3e\u0a24, \u0a39\u0a3f\u0a70\u0a26\u0a40 \u0a05\u0a24\u0a47 \u0a05\u0a70\u0a17\u0a30\u0a47\u0a1c\u0a3c\u0a40 \u0a35\u0a3f\u0a71\u0a1a \u0a26\u0a4b\u0a2d\u0a3e\u0a38\u0a3c\u0a3e\u0a08 \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e, \u0a2a\u0a4d\u0a30\u0a38\u0a70\u0a17-\u0a1c\u0a3e\u0a17\u0a30\u0a42\u0a15 \u0a17\u0a71\u0a32\u0a2c\u0a3e\u0a24, \u0a38\u0a48\u0a38\u0a3c\u0a28-\u0a05\u0a27\u0a3e\u0a30\u0a24 \u0a17\u0a71\u0a32\u0a2c\u0a3e\u0a24 \u0a07\u0a24\u0a3f\u0a39\u0a3e\u0a38 \u0a05\u0a24\u0a47 \u0a2a\u0a4d\u0a30\u0a24\u0a40\u0a15\u0a3f\u0a30\u0a3f\u0a06\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a15\u0a3e\u0a2a\u0a40 \u0a15\u0a30\u0a28 \u0a05\u0a24\u0a47 \u0a38\u0a3e\u0a02\u0a1d\u0a3e \u0a15\u0a30\u0a28 \u0a26\u0a47 \u0a35\u0a3f\u0a15\u0a32\u0a2a \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48, \u0a07\u0a71\u0a15 \u0a28\u0a3f\u0a30\u0a35\u0a3f\u0a18\u0a28 \u0a05\u0a24\u0a47 \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e-\u0a05\u0a28\u0a41\u0a15\u0a42\u0a32 \u0a05\u0a28\u0a41\u0a2d\u0a35 \u0a28\u0a42\u0a70 \u0a2f\u0a15\u0a40\u0a28\u0a40 \u0a2c\u0a23\u0a3e\u0a09\u0a02\u0a26\u0a3e \u0a39\u0a48\u0964",ques18:"\u0a2e\u0a48\u0a02 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a40 \u0a38\u0a2e\u0a71\u0a17\u0a30\u0a40 \u0a26\u0a47 \u0a38\u0a70\u0a2c\u0a70\u0a27 \u0a35\u0a3f\u0a71\u0a1a \u0a06\u0a2a\u0a23\u0a40 \u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a26\u0a47 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a3e\u0a02?",ans18:"\u0a2e\u0a3e\u0a08 \u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a39\u0a30\u0a47\u0a15 \u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a47\u0a1c \u0a26\u0a47 \u0a39\u0a47\u0a20\u0a3e\u0a02 \u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15 \u0a38\u0a48\u0a15\u0a38\u0a3c\u0a28 \u0a26\u0a40 \u0a2a\u0a47\u0a38\u0a3c\u0a15\u0a38\u0a3c \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48, \u0a1c\u0a3f\u0a38 \u0a28\u0a3e\u0a32 \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a38\u0a2e\u0a71\u0a17\u0a30\u0a40 \u0a28\u0a42\u0a70 1 \u0a24\u0a4b\u0a02 5 \u0a38\u0a1f\u0a3e\u0a30\u0a3e\u0a02 \u0a24\u0a71\u0a15 \u0a26\u0a30\u0a1c\u0a3e \u0a26\u0a47\u0a23 \u0a05\u0a24\u0a47 \u0a06\u0a2a\u0a23\u0a47 \u0a24\u0a1c\u0a3c\u0a30\u0a2c\u0a3f\u0a06\u0a02, \u0a38\u0a41\u0a1d\u0a3e\u0a35\u0a3e\u0a02 \u0a1c\u0a3e\u0a02 \u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15 \u0a28\u0a42\u0a70 \u0a38\u0a3e\u0a02\u0a1d\u0a3e \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a06\u0a17\u0a3f\u0a06 \u0a2e\u0a3f\u0a32\u0a26\u0a40 \u0a39\u0a48\u0964 \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e \u0a08\u0a2e\u0a47\u0a32 \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a35\u0a3f\u0a38\u0a24\u0a4d\u0a30\u0a3f\u0a24 \u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15 support-myscheme@digitalindia.gov.in '\u0a24\u0a47 \u0a35\u0a40 \u0a2d\u0a47\u0a1c \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28, \u0a1c\u0a3f\u0a38 \u0a28\u0a3e\u0a32 \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a26\u0a47 \u0a28\u0a3f\u0a30\u0a70\u0a24\u0a30 \u0a38\u0a41\u0a27\u0a3e\u0a30 \u0a05\u0a24\u0a47 \u0a2a\u0a4d\u0a30\u0a24\u0a40\u0a15\u0a3f\u0a30\u0a3f\u0a06 \u0a28\u0a42\u0a70 \u0a2f\u0a15\u0a40\u0a28\u0a40 \u0a2c\u0a23\u0a3e\u0a09\u0a23 \u0a35\u0a3f\u0a71\u0a1a \u0a2e\u0a26\u0a26 \u0a2e\u0a3f\u0a32\u0a26\u0a40 \u0a39\u0a48\u0964",ques19:"\u0a07\u0a71\u0a15 \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e \u0a2e\u0a3e\u0a08\u0a38\u0a3c\u0a3e\u0a08\u0a2e \u0a09\u0a71\u0a24\u0a47 \u0a38\u0a3e\u0a08\u0a28 \u0a05\u0a2a \u0a1c\u0a3e\u0a02 \u0a38\u0a3e\u0a08\u0a28 \u0a07\u0a28 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48?",ans19:"\u0a2e\u0a3e\u0a08-\u0a38\u0a15\u0a40\u0a2e \u0a28\u0a42\u0a70 \u0a2e\u0a47\u0a30\u0a40-\u0a2a\u0a39\u0a3f\u0a32\u0a35\u0a3e\u0a28 (\u0a28\u0a48\u0a38\u0a3c\u0a28\u0a32 \u0a38\u0a3f\u0a70\u0a17\u0a32 \u0a38\u0a3e\u0a08\u0a28-\u0a06\u0a28) \u0a28\u0a3e\u0a32 \u0a1c\u0a4b\u0a21\u0a3c\u0a3f\u0a06 \u0a17\u0a3f\u0a06 \u0a39\u0a48, \u0a1c\u0a3f\u0a38 \u0a28\u0a3e\u0a32 \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e \u0a06\u0a2a\u0a23\u0a40 \u0a2e\u0a47\u0a30\u0a40-\u0a2a\u0a39\u0a3f\u0a32\u0a35\u0a3e\u0a28 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23 \u0a2a\u0a71\u0a24\u0a30\u0a3e\u0a02 \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47 \u0a38\u0a3e\u0a08\u0a28 \u0a05\u0a2a \u0a1c\u0a3e\u0a02 \u0a38\u0a3e\u0a08\u0a28 \u0a07\u0a28 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28\u0964 \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e \u0a2c\u0a3f\u0a28\u0a3e\u0a02 \u0a38\u0a3e\u0a08\u0a28 \u0a07\u0a28 \u0a15\u0a40\u0a24\u0a47 \u0a38\u0a30\u0a15\u0a3e\u0a30\u0a40 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a35\u0a47\u0a16 \u0a05\u0a24\u0a47 \u0a16\u0a4b\u0a1c \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28\u0964 \u0a39\u0a3e\u0a32\u0a3e\u0a02\u0a15\u0a3f, \u0a38\u0a3e\u0a08\u0a28 \u0a07\u0a28 \u0a15\u0a30\u0a28 \u0a28\u0a3e\u0a32 \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e \u0a06\u0a2a\u0a23\u0a40 \u0a2a\u0a4d\u0a30\u0a4b\u0a2b\u0a3e\u0a08\u0a32, \u0a2c\u0a41\u0a71\u0a15\u0a2e\u0a3e\u0a30\u0a15 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a05\u0a24 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28 \u0a05\u0a24\u0a47 \u0a06\u0a2a\u0a23\u0a47 \u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a05\u0a24 \u0a35\u0a47\u0a30\u0a35\u0a3f\u0a06\u0a02 \u0a26\u0a47 \u0a05\u0a27\u0a3e\u0a30 '\u0a24\u0a47 \u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40\u0a17\u0a24 \u0a38\u0a3f\u0a2b\u0a3e\u0a30\u0a38\u0a3c\u0a3e\u0a02 \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28\u0964",ques20:"\u0a2e\u0a48\u0a02 \u0a2e\u0a3e\u0a08-\u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a09\u0a71\u0a24\u0a47 \u0a07\u0a71\u0a15 \u0a38\u0a15\u0a40\u0a2e \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a32\u0a71\u0a2d \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a3e\u0a02?",ans20:"\u0a2e\u0a3e\u0a08-\u0a38\u0a15\u0a40\u0a2e \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a16\u0a4b\u0a1c\u0a23 \u0a05\u0a24\u0a47 \u0a16\u0a4b\u0a1c\u0a23 \u0a26\u0a47 \u0a15\u0a08 \u0a24\u0a30\u0a40\u0a15\u0a47 \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48, \u0a1c\u0a3f\u0a38 \u0a35\u0a3f\u0a71\u0a1a \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a26\u0a47 \u0a28\u0a3e\u0a2e \u0a1c\u0a3e\u0a02 \u0a2e\u0a41\u0a71\u0a16 \u0a38\u0a3c\u0a2c\u0a26\u0a3e\u0a02 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a16\u0a4b\u0a1c, \u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40\u0a17\u0a24 \u0a38\u0a3f\u0a2b\u0a3e\u0a30\u0a38\u0a3c\u0a3e\u0a02, \u0a30\u0a3e\u0a1c/\u0a15\u0a47\u0a02\u0a26\u0a30 \u0a38\u0a3c\u0a3e\u0a38\u0a3f\u0a24 \u0a2a\u0a4d\u0a30\u0a26\u0a47\u0a38\u0a3c \u0a1c\u0a3e\u0a02 \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a38\u0a30\u0a15\u0a3e\u0a30 \u0a26\u0a40\u0a06\u0a02 \u0a2f\u0a4b\u0a1c\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a2b\u0a3f\u0a32\u0a1f\u0a30\u0a3f\u0a70\u0a17, \u0a2f\u0a4b\u0a1c\u0a28\u0a3e \u0a32\u0a3e\u0a2d \u0a38\u0a3c\u0a4d\u0a30\u0a47\u0a23\u0a40\u0a06\u0a02 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a2c\u0a4d\u0a30\u0a3e\u0a0a\u0a1c\u0a3c\u0a3f\u0a70\u0a17 \u0a05\u0a24\u0a47 \u0a28\u0a3f\u0a30\u0a26\u0a47\u0a38\u0a3c\u0a3f\u0a24 \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e \u0a32\u0a08 \u0a0f