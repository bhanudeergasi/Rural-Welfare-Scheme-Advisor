u0d24\u0d3f\u0d28\u0d3e\u0d7d \u0d12\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d27\u0d3f\u0d15\u0d02 \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c \u0d35\u0d46\u0d2c\u0d4d\u0d38\u0d48\u0d31\u0d4d\u0d31\u0d41\u0d15\u0d7e \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d23\u0d4d\u0d1f\u0d24\u0d3f\u0d32\u0d4d\u0d32.",vision:"\u0d28\u0d2e\u0d4d\u0d2e\u0d41\u0d1f\u0d46 \u0d26\u0d7c\u0d36\u0d28\u0d02",visionText:"\u0d2a\u0d4c\u0d30\u0d28\u0d4d\u0d2e\u0d3e\u0d30\u0d41\u0d1f\u0d46 \u0d1c\u0d40\u0d35\u0d3f\u0d24\u0d02 \u0d0e\u0d33\u0d41\u0d2a\u0d4d\u0d2a\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15 \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d3e\u0d23\u0d4d \u0d1e\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d15\u0d3e\u0d34\u0d4d\u0d1a\u0d2a\u0d4d\u0d2a\u0d3e\u0d1f\u0d4d.",mission:"\u0d1e\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d26\u0d4c\u0d24\u0d4d\u0d2f\u0d02",mission1:"\u0d17\u0d35\u0d7a\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d06\u0d28\u0d41\u0d15\u0d42\u0d32\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d17\u0d35\u0d7a\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d-\u0d2f\u0d42\u0d38\u0d7c \u0d07\u0d28\u0d4d\u0d31\u0d7c\u0d2b\u0d47\u0d38\u0d4d \u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d15\u0d4d\u0d37\u0d2e\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15 \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d3e\u0d23\u0d4d \u0d1e\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d26\u0d4c\u0d24\u0d4d\u0d2f\u0d02.",mission2:"\u0d12\u0d30\u0d41 \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d2f\u0d4b\u0d1c\u0d28\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d38\u0d2e\u0d2f\u0d35\u0d41\u0d02 \u0d2a\u0d30\u0d3f\u0d36\u0d4d\u0d30\u0d2e\u0d35\u0d41\u0d02 \u0d15\u0d41\u0d31\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d15.",aboutPageDesc1:"\u0d07\u0d32\u0d15\u0d4d\u0d1f\u0d4d\u0d30\u0d4b\u0d23\u0d3f\u0d15\u0d4d\u0d38\u0d4d \u0d06\u0d7b\u0d21\u0d4d \u0d07\u0d7b\u0d2b\u0d7c\u0d2e\u0d47\u0d37\u0d7b \u0d1f\u0d46\u0d15\u0d4d\u0d28\u0d4b\u0d33\u0d1c\u0d3f \u0d2e\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d3e\u0d32\u0d2f\u0d02 (\u0d0e\u0d02. \u0d07. \u0d10. \u0d1f\u0d3f. \u0d35\u0d48), \u0d05\u0d21\u0d4d\u0d2e\u0d3f\u0d28\u0d3f\u0d38\u0d4d\u0d1f\u0d4d\u0d30\u0d47\u0d31\u0d4d\u0d31\u0d40\u0d35\u0d4d \u0d31\u0d3f\u0d2b\u0d4b\u0d02\u0d38\u0d4d \u0d06\u0d7b\u0d21\u0d4d \u0d2a\u0d2c\u0d4d\u0d32\u0d3f\u0d15\u0d4d \u0d17\u0d4d\u0d30\u0d40\u0d35\u0d7b\u0d38\u0d4d \u0d35\u0d15\u0d41\u0d2a\u0d4d\u0d2a\u0d4d (\u0d21\u0d3f. \u0d0e. \u0d06\u0d7c. \u0d2a\u0d3f. \u0d1c\u0d3f), \u0d2e\u0d31\u0d4d\u0d31\u0d4d \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30, \u0d38\u0d02\u0d38\u0d4d\u0d25\u0d3e\u0d28 \u0d2e\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d3e\u0d32\u0d2f\u0d19\u0d4d\u0d19\u0d7e/\u0d35\u0d15\u0d41\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d41\u0d1f\u0d46 \u0d2a\u0d19\u0d4d\u0d15\u0d3e\u0d33\u0d3f\u0d24\u0d4d\u0d24\u0d24\u0d4d\u0d24\u0d4b\u0d1f\u0d46 \u0d28\u0d3e\u0d37\u0d23\u0d7d \u0d07-\u0d17\u0d35\u0d47\u0d23\u0d7b\u0d38\u0d4d \u0d21\u0d3f\u0d35\u0d3f\u0d37\u0d7b (\u0d0e\u0d7b. \u0d07. \u0d1c\u0d3f. \u0d21\u0d3f) \u0d06\u0d23\u0d4d \u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d02 \u0d35\u0d3f\u0d15\u0d38\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d41\u0d02 \u0d28\u0d3f\u0d2f\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d41\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d.",eligibilityCheckHead:"\u0d2f\u0d4b\u0d17\u0d4d\u0d2f\u0d24 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15",eligibilityCheckDesc:"\u0d35\u0d4d\u0d2f\u0d24\u0d4d\u0d2f\u0d38\u0d4d\u0d24 \u0d2e\u0d3e\u0d28\u0d26\u0d23\u0d4d\u0d21\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d17\u0d24 \u0d38\u0d35\u0d3f\u0d36\u0d47\u0d37\u0d24\u0d15\u0d33\u0d41\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33 \u0d2f\u0d4b\u0d17\u0d4d\u0d2f\u0d24 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02.",schemeFinderHead:"\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2b\u0d48\u0d7b\u0d21\u0d7c",schemeFinderDesc:"\u0d35\u0d3f\u0d35\u0d3f\u0d27 \u0d17\u0d35\u0d7a\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f \u0d2b\u0d3f\u0d7d\u0d1f\u0d4d\u0d1f\u0d7c \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d21\u0d4d\u0d30\u0d3f\u0d7d \u0d21\u0d4c\u0d23\u0d41\u0d15\u0d7e \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d35\u0d47\u0d17\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d41\u0d02 \u0d0e\u0d33\u0d41\u0d2a\u0d4d\u0d2a\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d41\u0d02 \u0d24\u0d3f\u0d30\u0d2f\u0d7d",schemeInDetailHead:"\u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f \u0d35\u0d3f\u0d36\u0d26\u0d2e\u0d3e\u0d2f\u0d3f",schemeInDetailDesc:"\u0d05\u0d2a\u0d47\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d2e\u0d41\u0d2e\u0d4d\u0d2a\u0d4d \u0d2b\u0d48\u0d7b \u0d17\u0d4d\u0d30\u0d46\u0d2f\u0d3f\u0d7b\u0d21\u0d4d \u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d24 \u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d47\u0d1c\u0d41\u0d15\u0d33\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d06\u0d34\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d2a\u0d4b\u0d15\u0d41\u0d15.",documentRequired:"\u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d30\u0d47\u0d16\u0d15\u0d7e",faqHead:"\u0d2a\u0d24\u0d3f\u0d35\u0d3e\u0d2f\u0d3f \u0d1a\u0d4b\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d1a\u0d4b\u0d26\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e",faqSubHead1:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d1a\u0d3f\u0d32 \u0d09\u0d24\u0d4d\u0d24\u0d30\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f \u0d1e\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d35\u0d3f\u0d1c\u0d4d\u0d1e\u0d3e\u0d28 \u0d05\u0d1f\u0d3f\u0d24\u0d4d\u0d24\u0d31 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15!",ques1:"\u0d0e\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d4d \u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02, \u0d2e\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d32\u0d41\u0d15\u0d33\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d07\u0d24\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d35\u0d4d\u0d2f\u0d24\u0d4d\u0d2f\u0d38\u0d4d\u0d24\u0d2e\u0d3e\u0d23\u0d4d?",ans1:"\u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30, \u0d38\u0d02\u0d38\u0d4d\u0d25\u0d3e\u0d28/\u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d2d\u0d30\u0d23 \u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d46 \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d41\u0d15\u0d33\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d35\u0d48\u0d35\u0d3f\u0d27\u0d4d\u0d2f\u0d2e\u0d3e\u0d7c\u0d28\u0d4d\u0d28 \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e \u0d06\u0d15\u0d4d\u0d38\u0d38\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d26\u0d47\u0d36\u0d40\u0d2f \u0d35\u0d47\u0d26\u0d3f\u0d2f\u0d3e\u0d23\u0d4d \u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02. \u0d1c\u0d28\u0d38\u0d02\u0d16\u0d4d\u0d2f\u0d3e\u0d2a\u0d30\u0d2e\u0d3e\u0d2f \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e \u0d24\u0d3f\u0d30\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d2e\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d31\u0d4d\u0d31\u0d24\u0d4d\u0d24\u0d35\u0d23 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d2e\u0d3e\u0d23\u0d4d \u0d07\u0d24\u0d4d. \u0d2a\u0d30\u0d2e\u0d4d\u0d2a\u0d30\u0d3e\u0d17\u0d24 \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d32\u0d41\u0d15\u0d33\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d35\u0d4d\u0d2f\u0d24\u0d4d\u0d2f\u0d38\u0d4d\u0d24\u0d2e\u0d3e\u0d2f\u0d3f, \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30 \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c, \u0d38\u0d02\u0d38\u0d4d\u0d25\u0d3e\u0d28 \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d41\u0d15\u0d7e, \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d2d\u0d30\u0d23 \u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d33\u0d46 \u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d12\u0d30\u0d4a\u0d31\u0d4d\u0d31 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d2e\u0d3f\u0d7d \u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d41\u0d35\u0d30\u0d3f\u0d15\u0d2f\u0d41\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d33\u0d46 \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d2f\u0d4b\u0d17\u0d4d\u0d2f\u0d24\u0d2f\u0d41\u0d1f\u0d46 \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d2a\u0d4d\u0d30\u0d38\u0d15\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d3e\u0d7b \u0d38\u0d39\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d41\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41.",ques2:"\u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f \u0d38\u0d3e\u0d27\u0d3e\u0d30\u0d23 \u0d2a\u0d4c\u0d30\u0d28\u0d4d\u0d2e\u0d3e\u0d30\u0d46 \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d38\u0d39\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02?",ans2:"\u0d2a\u0d4d\u0d30\u0d38\u0d15\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e \u0d12\u0d30\u0d3f\u0d1f\u0d24\u0d4d\u0d24\u0d4d \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d3e\u0d7b \u0d2a\u0d4c\u0d30\u0d28\u0d4d\u0d2e\u0d3e\u0d30\u0d46 \u0d2a\u0d4d\u0d30\u0d3e\u0d2a\u0d4d\u0d24\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d32\u0d42\u0d1f\u0d46\u0d2f\u0d41\u0d02 \u0d12\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d27\u0d3f\u0d15\u0d02 \u0d35\u0d15\u0d41\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d35\u0d46\u0d2c\u0d4d\u0d38\u0d48\u0d31\u0d4d\u0d31\u0d41\u0d15\u0d7e \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d23\u0d4d\u0d1f\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d15\u0d24 \u0d07\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d32\u0d42\u0d1f\u0d46\u0d2f\u0d41\u0d02 \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d2f\u0d4b\u0d17\u0d4d\u0d2f\u0d24 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d35\u0d3f\u0d2a\u0d41\u0d32\u0d2e\u0d3e\u0d2f \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f \u0d2e\u0d3e\u0d7c\u0d17\u0d4d\u0d17\u0d28\u0d3f\u0d7c\u0d26\u0d4d\u0d26\u0d47\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d35\u0d32\u0d4b\u0d15\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d32\u0d42\u0d1f\u0d46\u0d2f\u0d41\u0d02 \u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d02 \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d33\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d4d\u0d30\u0d35\u0d47\u0d36\u0d28\u0d02 \u0d32\u0d33\u0d3f\u0d24\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",ques3:"\u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41?",ans3:"\u0d2a\u0d4c\u0d30\u0d28\u0d4d\u0d2e\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d7c\u0d39\u0d24\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d3e\u0d7b \u0d38\u0d39\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d32\u0d33\u0d3f\u0d24\u0d35\u0d41\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d43 \u0d38\u0d4c\u0d39\u0d3e\u0d7c\u0d26\u0d4d\u0d26\u0d2a\u0d30\u0d35\u0d41\u0d2e\u0d3e\u0d2f \u0d2e\u0d42\u0d28\u0d4d\u0d28\u0d4d \u0d18\u0d1f\u0d4d\u0d1f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d4d\u0d30\u0d15\u0d4d\u0d30\u0d3f\u0d2f\u0d2f\u0d3e\u0d23\u0d4d \u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d02 \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d1f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d\u0d03 \u0d18\u0d1f\u0d4d\u0d1f\u0d02 1: \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d35\u0d4d \u0d1c\u0d28\u0d38\u0d02\u0d16\u0d4d\u0d2f\u0d3e\u0d36\u0d3e\u0d38\u0d4d\u0d24\u0d4d\u0d30\u0d02, \u0d35\u0d30\u0d41\u0d2e\u0d3e\u0d28\u0d02, \u0d38\u0d3e\u0d2e\u0d42\u0d39\u0d3f\u0d15 \u0d35\u0d3f\u0d2d\u0d3e\u0d17\u0d02 \u0d24\u0d41\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28 \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d18\u0d1f\u0d4d\u0d1f\u0d02 2: \u0d28\u0d7d\u0d15\u0d3f\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d7d, \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d35\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d28\u0d42\u0d31\u0d41\u0d15\u0d23\u0d15\u0d4d\u0d15\u0d3f\u0d28\u0d4d \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d33\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d4d\u0d30\u0d38\u0d15\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e \u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d18\u0d1f\u0d4d\u0d1f\u0d02 3: \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d35\u0d3f\u0d28\u0d4d \u0d2f\u0d4b\u0d17\u0d4d\u0d2f\u0d24\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d38\u0d4d\u0d15\u0d40\u0d2e\u0d41\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d1f\u0d4d\u0d1f\u0d3f\u0d15\u0d2f\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d35\u0d3f\u0d36\u0d26\u0d2e\u0d3e\u0d2f \u0d05\u0d31\u0d3f\u0d35\u0d4d, \u0d2a\u0d24\u0d3f\u0d35\u0d41\u0d1a\u0d4b\u0d26\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e, \u0d05\u0d2a\u0d47\u0d15\u0d4d\u0d37\u0d3e \u0d2a\u0d4d\u0d30\u0d15\u0d4d\u0d30\u0d3f\u0d2f \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d24 \u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d47\u0d1c\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d15\u0d42\u0d1f\u0d41\u0d24\u0d7d \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d47\u0d1f\u0d3e\u0d28\u0d41\u0d02 \u0d05\u0d24\u0d24\u0d4d \u0d06\u0d2a\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d2f\u0d41. \u0d06\u0d7c. \u0d0e\u0d32\u0d4d\u0d32\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3e\u0d35\u0d3f\u0d17\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d41\u0d02 \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02.",ques4:"\u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d2e\u0d3f\u0d7d \u0d36\u0d30\u0d3f\u0d2f\u0d3e\u0d2f \u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d05\u0d31\u0d3f\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d28\u0d1f\u0d2a\u0d1f\u0d3f\u0d15\u0d4d\u0d30\u0d2e\u0d02 \u0d0e\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d4d?",ans4:"\u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d2e\u0d3f\u0d7d \u0d36\u0d30\u0d3f\u0d2f\u0d3e\u0d2f \u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d, \u0d2a\u0d4c\u0d30\u0d28\u0d4d\u0d2e\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d2e\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d14\u0d26\u0d4d\u0d2f\u0d4b\u0d17\u0d3f\u0d15 \u0d35\u0d46\u0d2c\u0d4d\u0d38\u0d48\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d06\u0d30\u0d02\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02. \u0d39\u0d4b\u0d02\u0d2a\u0d47\u0d1c\u0d3f\u0d7d \u0d0e\u0d24\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d34\u0d3f\u0d1e\u0d4d\u0d1e\u0d3e\u0d7d, \u0d2a\u0d4d\u0d30\u0d3e\u0d2f\u0d02, \u0d32\u0d3f\u0d02\u0d17\u0d2d\u0d47\u0d26\u0d02, \u0d35\u0d30\u0d41\u0d2e\u0d3e\u0d28 \u0d28\u0d3f\u0d32\u0d35\u0d3e\u0d30\u0d02, \u0d35\u0d3f\u0d2d\u0d3e\u0d17\u0d02 \u0d2e\u0d41\u0d24\u0d32\u0d3e\u0d2f \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d1c\u0d28\u0d38\u0d02\u0d16\u0d4d\u0d2f\u0d3e\u0d2a\u0d30\u0d2e\u0d3e\u0d2f \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d7d\u0d15\u0d3e\u0d7b \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d33\u0d46 \u0d05\u0d28\u0d41\u0d35\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 '\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d41\u0d15' \u0d0e\u0d28\u0d4d\u0d28 \u0d38\u0d35\u0d3f\u0d36\u0d47\u0d37\u0d24 \u0d05\u0d35\u0d7c \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d41\u0d02. \u0d08 \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d1a\u0d4d\u0d1a\u0d41\u0d15\u0d34\u0d3f\u0d1e\u0d4d\u0d1e\u0d3e\u0d7d, \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d35\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d32\u0d3f\u0d28\u0d46 \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f \u0d2a\u0d4d\u0d30\u0d38\u0d15\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d38\u0d4d\u0d15\u0d40\u0d2e\u0d41\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d12\u0d30\u0d41 \u0d32\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d28\u0d7d\u0d15\u0d41\u0d02.",ques5:"\u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d24\u0d4d\u0d2f\u0d47\u0d15 \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d2f\u0d46\u0d15\u0d4d\u0d15\u0d41\u0d31\u0d3f\u0d1a\u0d4d\u0d1a\u0d41\u0d33\u0d4d\u0d33 \u0d0e\u0d28\u0d4d\u0d24\u0d4d \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d4d\u0d15\u0d40\u0d2e\u0d3f\u0d7d \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d02?",ans5:"\u0d2f\u0d4b\u0d17\u0d4d\u0d2f\u0d24\u0d3e \u0d2e\u0d3e\u0d28\u0d26\u0d23\u0d4d\u0d21\u0d19\u0d4d\u0d19\u0d7e, \u0d35\u0d3e\u0d17\u0d4d\u0d26\u0d3e\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d06\u0d28\u0d41\u0d15\u0d42\u0d32\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e, \u0d05\u0d2a\u0d47\u0d15\u0d4d\u0d37\u0d3e \u0d28\u0d1f\u0d2a\u0d1f\u0d3f\u0d15\u0d4d\u0d30\u0d2e\u0d19\u0d4d\u0d19\u0d7e, \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f \u0d2a\u0d4d\u0d30\u0d2f\u0d4b\u0d1c\u0d28\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d41\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d46 \u0d13\u0d30\u0d4b \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d2f\u0d46\u0d2f\u0d41\u0d02 \u0d15\u0d41\u0d31\u0d3f\u0d1a\u0d4d\u0d1a\u0d41\u0d33\u0d4d\u0d33 \u0d38\u0d2e\u0d17\u0d4d\u0d30\u0d2e\u0d3e\u0d2f \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d2f\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d2a\u0d4a\u0d24\u0d41\u0d35\u0d3e\u0d2f \u0d1a\u0d4b\u0d26\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d09\u0d24\u0d4d\u0d24\u0d30\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d24\u0d2e\u0d3e\u0d2f \u0d2a\u0d24\u0d3f\u0d35\u0d3e\u0d2f\u0d3f \u0d1a\u0d4b\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d1a\u0d4b\u0d26\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e (\u0d0e\u0d2b\u0d4d. \u0d0e. \u0d15\u0d4d\u0d2f\u0d41) \u0d35\u0d3f\u0d2d\u0d3e\u0d17\u0d35\u0d41\u0d02 \u0d07\u0d24\u0d3f\u0d32\u0d41\u0d23\u0d4d\u0d1f\u0d4d.",ques6:"\u0d2e\u0d48 \u0d38\u0d4d\u0d15\u0d40\u0d2e\u0d3f\u0d7d \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d35\u0d3f\u0d36\u0d3e\u0d32\u0d2e\u0d3e\u0d2f \u0d35\u0d3f\u0d2d\u0d3e\u0d17\u0d19\u0d4d\u0d19\u0d7e \u0d0f\u0d24\u0d4a\u0d15\u0d4d\u0d15\u0d46\u0d2f\u0d3e\u0d23\u0d4d?",ans6:"\u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d2e\u0d3f\u0d7d \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d33\u0d46 \u0d05\u0d35\u0d2f\u0d41\u0d1f\u0d46 \u0d06\u0d28\u0d41\u0d15\u0d42\u0d32\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d38\u0d4d\u0d35\u0d2d\u0d3e\u0d35\u0d35\u0d41\u0d02 \u0d32\u0d15\u0d4d\u0d37\u0d4d\u0d2f\u0d2e\u0d3f\u0d1f\u0d41\u0d28\u0d4d\u0d28 \u0d17\u0d41\u0d23\u0d2d\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d33\u0d41\u0d02 \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f 15 \u0d35\u0d3f\u0d2d\u0d3e\u0d17\u0d19\u0d4d\u0d19\u0d33\u0d3e\u0d2f\u0d3f \u0d35\u0d3f\u0d36\u0d3e\u0d32\u0d2e\u0d3e\u0d2f\u0d3f \u0d24\u0d30\u0d02\u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d15\u0d43\u0d37\u0d3f, \u0d17\u0d4d\u0d30\u0d3e\u0d2e\u0d40\u0d23, \u0d2a\u0d30\u0d3f\u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f, \u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d, \u0d38\u0d3e\u0d2e\u0d4d\u0d2a\u0d24\u0d4d\u0d24\u0d3f\u0d15 \u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d7e, \u0d07\u0d7b\u0d37\u0d41\u0d31\u0d7b\u0d38\u0d4d, \u0d2c\u0d3f\u0d38\u0d3f\u0d28\u0d38\u0d4d, \u0d38\u0d02\u0d30\u0d02\u0d2d\u0d15\u0d24\u0d4d\u0d35\u0d02, \u0d35\u0d3f\u0d26\u0d4d\u0d2f\u0d3e\u0d2d\u0d4d\u0d2f\u0d3e\u0d38\u0d02, \u0d2a\u0d20\u0d28\u0d02, \u0d06\u0d30\u0d4b\u0d17\u0d4d\u0d2f\u0d02, \u0d15\u0d4d\u0d37\u0d47\u0d2e\u0d02, \u0d2a\u0d3e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d1f\u0d02, \u0d2a\u0d3e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d1f\u0d02, \u0d2a\u0d4a\u0d24\u0d41 \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37, \u0d28\u0d3f\u0d2f\u0d2e\u0d02, \u0d28\u0d40\u0d24\u0d3f, \u0d36\u0d3e\u0d38\u0d4d\u0d24\u0d4d\u0d30\u0d02, \u0d10\u0d1f\u0d3f, \u0d35\u0d3e\u0d7c\u0d24\u0d4d\u0d24\u0d3e\u0d35\u0d3f\u0d28\u0d3f\u0d2e\u0d2f\u0d02, \u0d28\u0d48\u0d2a\u0d41\u0d23\u0d4d\u0d2f\u0d35\u0d41\u0d02 \u0d24\u0d4a\u0d34\u0d3f\u0d32\u0d41\u0d02, \u0d38\u0d3e\u0d2e\u0d42\u0d39\u0d3f\u0d15\u0d15\u0d4d\u0d37\u0d47\u0d2e\u0d35\u0d41\u0d02 \u0d36\u0d3e\u0d15\u0d4d\u0d24\u0d40\u0d15\u0d30\u0d23\u0d35\u0d41\u0d02, \u0d15\u0d3e\u0d2f\u0d3f\u0d15\u0d02, \u0d38\u0d02\u0d38\u0d4d\u0d15\u0d3e\u0d30\u0d02, \u0d17\u0d24\u0d3e\u0d17\u0d24\u0d02, \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28 \u0d38\u0d4c\u0d15\u0d30\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e, \u0d2f\u0d3e\u0d24\u0d4d\u0d30, \u0d35\u0d3f\u0d28\u0d4b\u0d26\u0d38\u0d1e\u0d4d\u0d1a\u0d3e\u0d30\u0d02, \u0d2f\u0d42\u0d1f\u0d4d\u0d1f\u0d3f\u0d32\u0d3f\u0d31\u0d4d\u0d31\u0d3f, \u0d36\u0d41\u0d1a\u0d3f\u0d24\u0d4d\u0d35\u0d02, \u0d38\u0d4d\u0d24\u0d4d\u0d30\u0d40\u0d15\u0d7e, \u0d15\u0d41\u0d1f\u0d4d\u0d1f\u0d3f\u0d15\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d08 \u0d35\u0d3f\u0d2d\u0d3e\u0d17\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41.",ques7:"\u0d2e\u0d48\u0d37\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d02 \u0d2c\u0d39\u0d41\u0d2d\u0d3e\u0d37\u0d3e \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41\u0d23\u0d4d\u0d1f\u0d4b?",ans7:"\u0d05\u0d24\u0d46, \u0d2e\u0d48\u0d37\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d02 \u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d7d \u0d07\u0d02\u0d17\u0d4d\u0d32\u0d40\u0d37\u0d4d \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d46 15 \u0d2d\u0d3e\u0d37\u0d15\u0d33\u0d3f\u0d7d \u0d09\u0d33\u0d4d\u0d33\u0d1f\u0d15\u0d4d\u0d15\u0d24\u0d4d\u0d24\u0d46 \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d15\u0d42\u0d1f\u0d41\u0d24\u0d7d \u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d7b \u0d2d\u0d3e\u0d37\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23 \u0d09\u0d1f\u0d7b \u0d28\u0d7d\u0d15\u0d41\u0d02.",ques8:"\u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d02 \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30, \u0d38\u0d02\u0d38\u0d4d\u0d25\u0d3e\u0d28/\u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d2d\u0d30\u0d23 \u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d28\u0d3f\u0d7c\u0d26\u0d4d\u0d26\u0d3f\u0d37\u0d4d\u0d1f \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41\u0d23\u0d4d\u0d1f\u0d4b?",ans8:"\u0d05\u0d24\u0d46, \u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d02 \u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d7d 4,700-\u0d32\u0d27\u0d3f\u0d15\u0d02 \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30 \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c, \u0d38\u0d02\u0d38\u0d4d\u0d25\u0d3e\u0d28/\u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d2d\u0d30\u0d23 \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d33\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d4d\u0d30\u0d35\u0d47\u0d36\u0d28\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d05\u0d27\u0d3f\u0d15 \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e \u0d24\u0d41\u0d1f\u0d7c\u0d1a\u0d4d\u0d1a\u0d2f\u0d3e\u0d2f\u0d3f \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d2e\u0d3f\u0d7d \u0d13\u0d7a\u0d2c\u0d4b\u0d7c\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d24\u0d41\u0d1f\u0d30\u0d41\u0d02.",ques9:"\u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d2e\u0d3f\u0d7d \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d24\u0d4d\u0d2f\u0d47\u0d15 \u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d1e\u0d4d\u0d1e\u0d3f\u0d32\u0d4d\u0d32. \u0d1e\u0d3e\u0d7b \u0d0e\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d47\u0d23\u0d4d\u0d1f\u0d24\u0d4d?",ans9:'\u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d7d 4,700-\u0d32\u0d27\u0d3f\u0d15\u0d02 \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30 \u0d17\u0d35\u0d7a\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46\u0d2f\u0d41\u0d02 \u0d38\u0d02\u0d38\u0d4d\u0d25\u0d3e\u0d28/\u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d2d\u0d30\u0d23 \u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36 \u0d17\u0d35\u0d7a\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46\u0d2f\u0d41\u0d02 \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e \u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d2e\u0d3f\u0d7d \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d3f\u0d2f\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d23\u0d4d\u0d1f\u0d4d. \u0d05\u0d27\u0d3f\u0d15 \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e \u0d2a\u0d24\u0d3f\u0d35\u0d3e\u0d2f\u0d3f \u0d1a\u0d47\u0d7c\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d2e\u0d3f\u0d7d \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f "\u0d17\u0d46\u0d31\u0d4d\u0d31\u0d4d \u0d07\u0d7b \u0d1f\u0d1a\u0d4d\u0d1a\u0d4d" \u0d35\u0d3f\u0d2d\u0d3e\u0d17\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d42\u0d1f\u0d46 \u0d0f\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d15\u0d3e\u0d23\u0d3e\u0d24\u0d3e\u0d2f \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d2f\u0d46\u0d15\u0d4d\u0d15\u0d41\u0d31\u0d3f\u0d1a\u0d4d\u0d1a\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d33\u0d4b \u0d28\u0d3f\u0d7c\u0d26\u0d4d\u0d26\u0d47\u0d36\u0d19\u0d4d\u0d19\u0d33\u0d4b \u0d2a\u0d4c\u0d30\u0d28\u0d4d\u0d2e\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d3e\u0d02.',ques10:"\u0d2e\u0d31\u0d3e\u0d24\u0d4d\u0d24\u0d3f \u0d2d\u0d3e\u0d37\u0d2f\u0d3f\u0d32\u0d46 \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d09\u0d33\u0d4d\u0d33\u0d1f\u0d15\u0d4d\u0d15\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d1a\u0d3f\u0d32 \u0d2a\u0d3f\u0d36\u0d15\u0d41\u0d15\u0d7e \u0d1e\u0d3e\u0d7b \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d3f. \u0d1e\u0d3e\u0d7b \u0d0e\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d47\u0d23\u0d4d\u0d1f\u0d24\u0d4d?",ans10:"\u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d09\u0d33\u0d4d\u0d33\u0d1f\u0d15\u0d4d\u0d15\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2e\u0d31\u0d3e\u0d24\u0d4d\u0d24\u0d3f \u0d2a\u0d24\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d7d \u0d0e\u0d28\u0d4d\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d2a\u0d4a\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d15\u0d4d\u0d15\u0d47\u0d1f\u0d41\u0d15\u0d7e \u0d36\u0d4d\u0d30\u0d26\u0d4d\u0d27\u0d2f\u0d3f\u0d7d\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f\u0d3e\u0d7d, \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d24\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f \u0d2a\u0d4c\u0d30\u0d28\u0d4d\u0d2e\u0d3e\u0d7c \u0d07\u0d02\u0d17\u0d4d\u0d32\u0d40\u0d37\u0d4d \u0d2a\u0d24\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d28\u0d3f\u0d7c\u0d26\u0d4d\u0d26\u0d47\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d2a\u0d4d\u0d30\u0d36\u0d4d\u0d28\u0d02 \u0d24\u0d41\u0d1f\u0d30\u0d41\u0d15\u0d2f\u0d3e\u0d23\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d15\u0d43\u0d24\u0d4d\u0d2f\u0d35\u0d41\u0d02 \u0d15\u0d3e\u0d32\u0d3f\u0d15\u0d35\u0d41\u0d2e\u0d3e\u0d2f \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d2e\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d3e\u0d32\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46\u0d2f\u0d4b \u0d35\u0d15\u0d41\u0d2a\u0d4d\u0d2a\u0d3f\u0d7b\u0d31\u0d46\u0d2f\u0d4b \u0d14\u0d26\u0d4d\u0d2f\u0d4b\u0d17\u0d3f\u0d15 \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d32\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d31\u0d2b\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02. \u0d15\u0d42\u0d1f\u0d3e\u0d24\u0d46, support-myscheme[at]digitalindia[dot]gov[dot]in \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d12\u0d30\u0d41 \u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d \u0d05\u0d2f\u0d1a\u0d4d\u0d1a\u0d41\u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d4d \u0d2a\u0d4d\u0d30\u0d36\u0d4d\u0d28\u0d02 \u0d31\u0d3f\u0d2a\u0d4d\u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02.",ques11:"\u0d35\u0d3f\u0d26\u0d4d\u0d2f\u0d3e\u0d7c\u0d24\u0d4d\u0d25\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d38\u0d4d\u0d15\u0d4b\u0d33\u0d7c\u0d37\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e \u0d05\u0d28\u0d4d\u0d35\u0d47\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d1e\u0d3e\u0d7b \u0d06\u0d17\u0d4d\u0d30\u0d39\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d38\u0d4d\u0d15\u0d40\u0d2e\u0d3f\u0d32\u0d42\u0d1f\u0d46 \u0d07\u0d24\u0d4d \u0d38\u0d3e\u0d27\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4b?",ans11:"\u0d05\u0d24\u0d46, \u0d35\u0d3f\u0d26\u0d4d\u0d2f\u0d3e\u0d7c\u0d24\u0d4d\u0d25\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33 \u0d38\u0d4d\u0d15\u0d4b\u0d33\u0d7c\u0d37\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d46 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d06\u0d28\u0d41\u0d15\u0d42\u0d32\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d24\u0d30\u0d35\u0d41\u0d02 \u0d35\u0d4d\u0d2f\u0d3e\u0d2a\u0d4d\u0d24\u0d3f\u0d2f\u0d41\u0d02 \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e \u0d0e\u0d33\u0d41\u0d2a\u0d4d\u0d2a\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d24\u0d3f\u0d30\u0d2f\u0d3e\u0d28\u0d41\u0d02 \u0d2a\u0d30\u0d4d\u0d2f\u0d35\u0d47\u0d15\u0d4d\u0d37\u0d23\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d41\u0d02 \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d3e\u0d28\u0d41\u0d02 \u0d2a\u0d4c\u0d30\u0d28\u0d4d\u0d2e\u0d3e\u0d30\u0d46 \u0d2a\u0d4d\u0d30\u0d3e\u0d2a\u0d4d\u0d24\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d15\u0d40\u0d35\u0d47\u0d21\u0d4d \u0d05\u0d27\u0d3f\u0d37\u0d4d\u0d20\u0d3f\u0d24 \u0d24\u0d3f\u0d30\u0d2f\u0d7d \u0d38\u0d35\u0d3f\u0d36\u0d47\u0d37\u0d24 \u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d02 \u0d35\u0d3e\u0d17\u0d4d\u0d26\u0d3e\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41.",ques12:"\u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d24\u0d4d\u0d2f\u0d47\u0d15 \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d2a\u0d47\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d1e\u0d3e\u0d7b \u0d06\u0d17\u0d4d\u0d30\u0d39\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d05\u0d2a\u0d47\u0d15\u0d4d\u0d37\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d05\u0d31\u0d3f\u0d2f\u0d3e\u0d7b \u0d1e\u0d3e\u0d7b \u0d06\u0d17\u0d4d\u0d30\u0d39\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d08 \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d2f\u0d3f\u0d7d \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d2e\u0d4b?",ans12:"\u0d05\u0d24\u0d46, \u0d13\u0d30\u0d4b \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d2f\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d05\u0d2a\u0d47\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d30\u0d47\u0d16\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d42\u0d7c\u0d23\u0d4d\u0d23\u0d2e\u0d3e\u0d2f \u0d2a\u0d1f\u0d4d\u0d1f\u0d3f\u0d15 \u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d07\u0d24\u0d4d \u0d2a\u0d4c\u0d30\u0d28\u0d4d\u0d2e\u0d3e\u0d30\u0d46 \u0d0e\u0d33\u0d41\u0d2a\u0d4d\u0d2a\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d24\u0d2f\u0d4d\u0d2f\u0d3e\u0d31\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d05\u0d2a\u0d47\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d3e\u0d2a\u0d4d\u0d24\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",ques13:"\u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f \u0d35\u0d34\u0d3f \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d2a\u0d47\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d2e\u0d4b?",ans13:"\u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d7d, \u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d33\u0d46 \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d2e\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d3e\u0d32\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46\u0d2f\u0d4b \u0d35\u0d15\u0d41\u0d2a\u0d4d\u0d2a\u0d3f\u0d28\u0d4d\u0d31\u0d46\u0d2f\u0d4b \u0d05\u0d24\u0d24\u0d4d \u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d06\u0d2a\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d2a\u0d47\u0d1c\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d31\u0d40\u0d21\u0d2f\u0d31\u0d15\u0d4d\u0d1f\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d35\u0d30\u0d41\u0d02 \u0d18\u0d1f\u0d4d\u0d1f\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d, \u0d2a\u0d4c\u0d30\u0d28\u0d4d\u0d2e\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d7d/\u0d09\u0d2e\u0d02\u0d17\u0d4d \u0d06\u0d2a\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d35\u0d34\u0d3f \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d2a\u0d47\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d2e\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d35\u0d3f\u0d2d\u0d3e\u0d35\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41.",ques14:'\u0d12\u0d30\u0d41 \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d35\u0d3f\u0d28\u0d4d \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d05\u0d28\u0d41\u0d2f\u0d4b\u0d1c\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d38\u0d4d\u0d15\u0d40\u0d2e\u0d41\u0d15\u0d7e \u0d2a\u0d30\u0d4d\u0d2f\u0d35\u0d47\u0d15\u0d4d\u0d37\u0d23\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d, \u0d2e\u0d48 \u0d38\u0d4d\u0d15\u0d40\u0d2e\u0d3f\u0d28\u0d4d\u0d31\u0d46 "\u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d17\u0d24\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f \u0d24\u0d3f\u0d30\u0d2f\u0d7d" \u0d38\u0d35\u0d3f\u0d36\u0d47\u0d37\u0d24\u0d2f\u0d3f\u0d7d \u0d0e\u0d28\u0d4d\u0d24\u0d4d \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d7d\u0d15\u0d47\u0d23\u0d4d\u0d1f\u0d24\u0d41\u0d23\u0d4d\u0d1f\u0d4d?',ans14:'\u0d2e\u0d48 \u0d38\u0d4d\u0d15\u0d40\u0d2e\u0d3f\u0d28\u0d4d\u0d31\u0d46 "\u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d17\u0d24\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f \u0d24\u0d3f\u0d30\u0d2f\u0d7d" \u0d38\u0d35\u0d3f\u0d36\u0d47\u0d37\u0d24 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d, \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d7e \u0d32\u0d3f\u0d02\u0d17\u0d2d\u0d47\u0d26\u0d02, \u0d2a\u0d4d\u0d30\u0d3e\u0d2f\u0d02, \u0d35\u0d48\u0d35\u0d3e\u0d39\u0d3f\u0d15 \u0d28\u0d3f\u0d32, \u0d38\u0d02\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d02, \u0d24\u0d3e\u0d2e\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d38\u0d4d\u0d25\u0d32\u0d02 (\u0d28\u0d17\u0d30\u0d2e\u0d4b \u0d17\u0d4d\u0d30\u0d3e\u0d2e\u0d2e\u0d4b), \u0d38\u0d3e\u0d2e\u0d42\u0d39\u0d3f\u0d15 \u0d35\u0d3f\u0d2d\u0d3e\u0d17\u0d02, \u0d35\u0d48\u0d15\u0d32\u0d4d\u0d2f \u0d28\u0d3f\u0d32, \u0d28\u0d4d\u0d2f\u0d42\u0d28\u0d2a\u0d15\u0d4d\u0d37 \u0d28\u0d3f\u0d32, \u0d24\u0d4a\u0d34\u0d3f\u0d7d \u0d28\u0d3f\u0d32, \u0d2e\u0d31\u0d4d\u0d31\u0d4d \u0d2a\u0d4d\u0d30\u0d38\u0d15\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d2a\u0d4b\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28 \u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d7d \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d7d\u0d15\u0d47\u0d23\u0d4d\u0d1f\u0d24\u0d41\u0d23\u0d4d\u0d1f\u0d4d. \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d35\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d32\u0d3f\u0d28\u0d4d \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d38\u0d15\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d38\u0d4d\u0d15\u0d40\u0d2e\u0d41\u0d15\u0d7e \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d3e\u0d7b \u0d07\u0d24\u0d4d \u0d38\u0d39\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.',ques15:'"\u0d2f\u0d4b\u0d17\u0d4d\u0d2f\u0d24\u0d3e \u0d1a\u0d4b\u0d26\u0d4d\u0d2f\u0d3e\u0d35\u0d32\u0d3f \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15" \u0d0e\u0d28\u0d4d\u0d28 \u0d38\u0d35\u0d3f\u0d36\u0d47\u0d37\u0d24 \u0d0e\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d4d?',ans15:'"\u0d1a\u0d46\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d32\u0d3f\u0d1c\u0d3f\u0d2c\u0d3f\u0d32\u0d3f\u0d31\u0d4d\u0d31\u0d3f \u0d1a\u0d4b\u0d26\u0d4d\u0d2f\u0d3e\u0d35\u0d32\u0d3f" \u0d38\u0d35\u0d3f\u0d36\u0d47\u0d37\u0d24 \u0d38\u0d4d\u0d15\u0d40\u0d02-\u0d28\u0d3f\u0d7c\u0d26\u0d4d\u0d26\u0d3f\u0d37\u0d4d\u0d1f \u0d2f\u0d4b\u0d17\u0d4d\u0d2f\u0d24\u0d3e \u0d2e\u0d3e\u0d28\u0d26\u0d23\u0d4d\u0d21\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d36\u0d4d\u0d30\u0d26\u0d4d\u0d27 \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d41\u0d02 \u0d32\u0d33\u0d3f\u0d24\u0d2e\u0d3e\u0d2f \u0d05\u0d24\u0d46/\u0d07\u0d32\u0d4d\u0d32 \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d1a\u0d4b\u0d26\u0d4d\u0d2f\u0d3e\u0d35\u0d32\u0d3f\u0d2f\u0d3f\u0d32\u0d42\u0d1f\u0d46 \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d33\u0d46 \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d2f\u0d4b\u0d17\u0d4d\u0d2f\u0d24 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d2a\u0d4d\u0d30\u0d3e\u0d2a\u0d4d\u0d24\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d41\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d28\u0d7d\u0d15\u0d3f\u0d2f \u0d2a\u0d4d\u0d30\u0d24\u0d3f\u0d15\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d7d, \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d24\u0d4d\u0d2f\u0d47\u0d15 \u0d38\u0d4d\u0d15\u0d40\u0d2e\u0d3f\u0d28\u0d4d \u0d05\u0d7c\u0d39\u0d24\u0d2f\u0d41\u0d23\u0d4d\u0d1f\u0d4b \u0d0e\u0d28\u0d4d\u0d28\u0d4d \u0d35\u0d47\u0d17\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d35\u0d3f\u0d32\u0d2f\u0d3f\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02.',ques16:"\u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d4d\u0d15\u0d40\u0d2e\u0d3f\u0d28\u0d4d \u0d12\u0d30\u0d41 \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2c\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d \u0d38\u0d4c\u0d15\u0d30\u0d4d\u0d2f\u0d2e\u0d41\u0d23\u0d4d\u0d1f\u0d4b, \u0d05\u0d24\u0d4d \u0d2a\u0d4c\u0d30\u0d28\u0d4d\u0d2e\u0d3e\u0d30\u0d46 \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d38\u0d39\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41?",ans16:"\u0d05\u0d24\u0d46, \u0d2a\u0d4d\u0d30\u0d38\u0d15\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d2a\u0d4c\u0d30\u0d28\u0d4d\u0d2e\u0d3e\u0d30\u0d46 \u0d38\u0d39\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d36\u0d2c\u0d4d\u0d26-\u0d2a\u0d4d\u0d30\u0d3e\u0d2a\u0d4d\u0d24\u0d2e\u0d3e\u0d2f, \u0d2c\u0d39\u0d41\u0d2d\u0d3e\u0d37\u0d3e \u0d0e\u0d10-\u0d2a\u0d35\u0d7c\u0d21\u0d4d \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2c\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d \u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d35\u0d3f\u0d28\u0d4d\u0d2f\u0d38\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d23\u0d4d\u0d1f\u0d4d. \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2c\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d43 \u0d1a\u0d4b\u0d26\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d17\u0d24\u0d35\u0d41\u0d02 \u0d24\u0d7d\u0d15\u0d4d\u0d37\u0d23\u0d35\u0d41\u0d2e\u0d3e\u0d2f \u0d2a\u0d4d\u0d30\u0d24\u0d3f\u0d15\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d38\u0d02\u0d2d\u0d3e\u0d37\u0d23 \u0d38\u0d39\u0d3e\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d42\u0d1f\u0d46 \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d7d \u0d32\u0d33\u0d3f\u0d24\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d06\u0d15\u0d7c\u0d37\u0d15\u0d35\u0d41\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d43 \u0d38\u0d4c\u0d39\u0d43\u0d26\u0d35\u0d41\u0d2e\u0d3e\u0d2f \u0d05\u0d28\u0d41\u0d2d\u0d35\u0d02 \u0d35\u0d3e\u0d17\u0d4d\u0d26\u0d3e\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d41\u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d4d \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c-\u0d2a\u0d4c\u0d30\u0d28\u0d4d\u0d2e\u0d3e\u0d30\u0d41\u0d1f\u0d46 \u0d07\u0d1f\u0d2a\u0d46\u0d1f\u0d7d \u0d35\u0d7c\u0d26\u0d4d\u0d27\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",ques17:"\u0d2e\u0d48 \u0d38\u0d4d\u0d15\u0d40\u0d2e\u0d3f\u0d32\u0d46 \u0d0e\u0d10 \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2c\u0d4b\u0d1f\u0d4d\u0d1f\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d4d\u0d30\u0d27\u0d3e\u0d28 \u0d38\u0d35\u0d3f\u0d36\u0d47\u0d37\u0d24\u0d15\u0d7e \u0d0e\u0d28\u0d4d\u0d24\u0d4a\u0d15\u0d4d\u0d15\u0d46\u0d2f\u0d3e\u0d23\u0d4d?",ans17:"\u0d36\u0d2c\u0d4d\u0d26\u0d35\u0d41\u0d02 \u0d35\u0d3e\u0d1a\u0d15\u0d35\u0d41\u0d02 \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d07\u0d1f\u0d2a\u0d46\u0d1f\u0d32\u0d41\u0d15\u0d7e, \u0d39\u0d3f\u0d28\u0d4d\u0d26\u0d3f\u0d2f\u0d3f\u0d32\u0d41\u0d02 \u0d07\u0d02\u0d17\u0d4d\u0d32\u0d40\u0d37\u0d3f\u0d32\u0d41\u0d02 \u0d26\u0d4d\u0d35\u0d3f\u0d2d\u0d3e\u0d37\u0d3e \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23, \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d2d-\u0d05\u0d35\u0d2c\u0d4b\u0d27\u0d2e\u0d41\u0d33\u0d4d\u0d33 \u0d38\u0d02\u0d2d\u0d3e\u0d37\u0d23\u0d19\u0d4d\u0d19\u0d7e, \u0d38\u0d46\u0d37\u0d7b \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d02, \u0d2a\u0d4d\u0d30\u0d24\u0d3f\u0d15\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d7e \u0d2a\u0d15\u0d7c\u0d24\u0d4d\u0d24\u0d3e\u0d28\u0d41\u0d02 \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d3e\u0d28\u0d41\u0d2e\u0d41\u0d33\u0d4d\u0d33 \u0d13\u0d2a\u0d4d\u0d37\u0d28\u0d41\u0d15\u0d7e, \u0d24\u0d1f\u0d38\u0d4d\u0d38\u0d2e\u0d3f\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d4d\u0d24\u0d24\u0d41\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d43-\u0d38\u0d4c\u0d39\u0d43\u0d26\u0d35\u0d41\u0d2e\u0d3e\u0d2f \u0d05\u0d28\u0d41\u0d2d\u0d35\u0d02 \u0d09\u0d31\u0d2a\u0d4d\u0d2a\u0d3e\u0d15\u0d4d\u0d15\u0d7d \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d2e\u0d48\u0d37\u0d40\u0d02 \u0d0e\u0d10 \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2c\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d \u0d35\u0d3e\u0d17\u0d4d\u0d26\u0d3e\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41.",ques18:"\u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d09\u0d33\u0d4d\u0d33\u0d1f\u0d15\u0d4d\u0d15\u0d24\u0d4d\u0d24\u0d46\u0d15\u0d4d\u0d15\u0d41\u0d31\u0d3f\u0d1a\u0d4d\u0d1a\u0d41\u0d33\u0d4d\u0d33 \u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d4d\u0d30\u0d24\u0d3f\u0d15\u0d30\u0d23\u0d02 \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d28\u0d7d\u0d15\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02?",ans18:'1 \u0d2e\u0d41\u0d24\u0d7d 5 \u0d35\u0d30\u0d46 \u0d28\u0d15\u0d4d\u0d37\u0d24\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d09\u0d33\u0d4d\u0d33\u0d1f\u0d15\u0d4d\u0d15\u0d02 \u0d31\u0d47\u0d31\u0d4d\u0d31\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d41\u0d02 \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d05\u0d28\u0d41\u0d2d\u0d35\u0d19\u0d4d\u0d19\u0d7e, \u0d28\u0d3f\u0d7c\u0d26\u0d4d\u0d26\u0d47\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d2b\u0d40\u0d21\u0d4d\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d3e\u0d28\u0d41\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d33\u0d46 \u0d05\u0d28\u0d41\u0d35\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d13\u0d30\u0d4b \u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d47\u0d1c\u0d3f\u0d28\u0d4d\u0d31\u0d46\u0d2f\u0d41\u0d02 \u0d1a\u0d41\u0d35\u0d1f\u0d46\u0d2f\u0d41\u0d33\u0d4d\u0d33 "\u0d07\u0d24\u0d4d \u0d38\u0d39\u0d3e\u0d2f\u0d15\u0d30\u0d2e\u0d3e\u0d2f\u0d3f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d4b?" \u0d2b\u0d40\u0d21\u0d4d\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d4d \u0d35\u0d3f\u0d2d\u0d3e\u0d17\u0d02 \u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d02 \u0d35\u0d3e\u0d17\u0d4d\u0d26\u0d3e\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d2e\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d24\u0d41\u0d1f\u0d7c\u0d1a\u0d4d\u0d1a\u0d2f\u0d3e\u0d2f \u0d2e\u0d46\u0d1a\u0d4d\u0d1a\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d32\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d24\u0d3f\u0d15\u0d30\u0d23\u0d36\u0d47\u0d37\u0d3f\u0d2f\u0d41\u0d02 \u0d09\u0d31\u0d2a\u0d4d\u0d2a\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d38\u0d39\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d support-myscheme@digitalindia.gov.in \u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d \u0d35\u0d34\u0d3f \u0d35\u0d3f\u0d36\u0d26\u0d2e\u0d3e\u0d2f \u0d2b\u0d40\u0d21\u0d4d\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d2f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02.',ques19:"\u0d12\u0d30\u0d41 \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d35\u0d3f\u0d28\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d4d\u0d15\u0d40\u0d2e\u0d3f\u0d7d \u0d38\u0d48\u0d7b \u0d05\u0d2a\u0d4d\u0d2a\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d4b \u0d38\u0d48\u0d7b \u0d07\u0d7b \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d4b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02?",ans19:"\u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2e\u0d46\u0d30\u0d3f\u0d2a\u0d46\u0d39\u0d4d\u0d1a\u0d3e\u0d28\u0d41\u0d2e\u0d3e\u0d2f\u0d3f (\u0d28\u0d3e\u0d37\u0d23\u0d7d \u0d38\u0d3f\u0d02\u0d17\u0d3f\u0d7e \u0d38\u0d48\u0d7b-\u0d13\u0d7a) \u0d38\u0d02\u0d2f\u0d4b\u0d1c\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d07\u0d24\u0d4d \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d33\u0d46 \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d2e\u0d46\u0d30\u0d3f\u0d2a\u0d46\u0d39\u0d4d\u0d1a\u0d3e\u0d7b \u0d15\u0d4d\u0d30\u0d46\u0d21\u0d7b\u0d37\u0d4d\u0d2f\u0d32\u0d41\u0d15\u0d7e \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d38\u0d48\u0d7b \u0d05\u0d2a\u0d4d\u0d2a\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d4b \u0d38\u0d48\u0d7b \u0d07\u0d7b \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d4b \u0d2a\u0d4d\u0d30\u0d3e\u0d2a\u0d4d\u0d24\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d38\u0d48\u0d7b \u0d07\u0d7b \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d24\u0d46 \u0d24\u0d28\u0d4d\u0d28\u0d46 \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c \u0d2a\u0d26\u0d4d\u0d27\u0d24\u0d3f\u0d15\u0d7e \u0d2c\u0d4d\u0d30\u0d4c\u0d38\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d41\u0d02 \u0d24\u0d3f\u0d30\u0d2f\u0d3e\u0d28\u0d41\u0d02 \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02. \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d3e\u0d32\u0d41\u0d02, \u0d38\u0d48\u0d7b \u0d07\u0d7b \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d33\u0d46 \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d7d \u0d38\u0d47\u0d35\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d41\u0d02 \u0d2c\u0d41\u0d15\u0d4d\u0d15\u0d4d\u0d2e\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d38\u0d4d\u0d15\u0d40\u0d2e\u0d41\u0d15\u0d7e \u0d38\u0d4d\u0d35\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d38\u0d47\u0d35\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d17\u0d24\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f \u0d36\u0d41\u0d2a\u0d3e\u0d7c\u0d36\u0d15\u0d7e \u0d38\u0d4d\u0d35\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d05\u0d28\u0d41\u0d35\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",ques20:"\u0d2e\u0d48\u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2b\u0d4b\u0d2e\u0d3f\u0d7d \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d12\u0d30\u0d41 \u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d24\u0d3f\u0d30\u0d2f\u0d3e\u0d02?",ans20:"\u0d38\u0d4d\u0d15\u0d40\u0d2e\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d47\u0d30\u0d4b \u0d15\u0d40\u0d35\u0d47\u0d21\u0d41\u0d15\u0d33\u0d4b \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d24\u0d3f\u0d30\u0d2f\u0d41\u0d15, \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d17\u0d24\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f \u0d36\u0d41\u0d2a\u0d3e\u0d7c\u0d36\u0d15\u0d7e, \u0d38\u0d02\u0d38\u0d4d\u0d25\u0d3e\u0d28/\u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d2d\u0d30\u0d23 \u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30 \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c \u0d38\u0d4d\u0d15\u0d40\u0d2e\u0d41\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d2b\u0d3f\u0d7d\u0d1f\u0d4d\u0d1f\u0d31\u0d3f\u0d02\u0d17\u0d4d, \u0d38\u0d4d\u0d15\u0d40\u0d02 \u0d2c\u0d46\u0d28\u0d3f\u0d2b\u0d3f\u0d31\u0d4d\u0d31\u0d4d \u0d35\u0d3f\u0d2d\u0d3e\u0d17\u0d19\u0d4d\u0d19\u0d7e \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d2c\u0d4d\u0d30\u0d4c\u0d38\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15, \u0d17\u0d48\u0d21\u0d21\u0d4d \u0d38\u0d39\u0d3e\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f AI-\u0d2a\u0d35\u0d7c\u0d21\u0d4d \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2c\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d46 \u0d38\u0d4d\u0d15\u0d40\u0d2e\u0d41\u0d15\u0d7e \u0d24\u0d3f