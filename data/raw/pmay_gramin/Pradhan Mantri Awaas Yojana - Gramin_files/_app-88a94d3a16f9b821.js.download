u0ab0\u0aa4\u0abf\u0aac\u0aa6\u0acd\u0aa7 \u0a9b\u0ac0\u0a8f \u0a95\u0ac7 \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0a8f\u0aaa\u0acd\u0ab2\u0abf\u0a95\u0ac7\u0ab6\u0aa8 \u0a89\u0aaa\u0aaf\u0acb\u0a97\u0aae\u0abe\u0a82 \u0ab2\u0ac7\u0ab5\u0abe\u0aa4\u0abe \u0a89\u0aaa\u0a95\u0ab0\u0aa3, \u0aa4\u0a95\u0aa8\u0ac0\u0a95\u0ac0 \u0a85\u0aa5\u0ab5\u0abe \u0a95\u0acd\u0ab7\u0aae\u0aa4\u0abe\u0aa8\u0ac7 \u0aa7\u0acd\u0aaf\u0abe\u0aa8\u0aae\u0abe\u0a82 \u0ab2\u0ac0\u0aa7\u0abe \u0ab5\u0abf\u0aa8\u0abe \u0aa4\u0aae\u0abe\u0aae \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0ac1\u0ab2\u0aad \u0a9b\u0ac7. \u0aa4\u0ac7 \u0aa4\u0ac7\u0aa8\u0abe \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4\u0ac0\u0a93\u0aa8\u0ac7 \u0aae\u0ab9\u0aa4\u0acd\u0aa4\u0aae \u0ab8\u0ac1\u0ab2\u0aad\u0aa4\u0abe \u0a85\u0aa8\u0ac7 \u0a89\u0aaa\u0aaf\u0acb\u0a97\u0ac0\u0aa4\u0abe \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0abe \u0ab9\u0ac7\u0aa4\u0ac1\u0aa5\u0ac0 \u0aac\u0aa8\u0abe\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7. \u0aaa\u0ab0\u0abf\u0aa3\u0abe\u0aae\u0ac7 \u0a86 \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae\u0aa8\u0ac7 \u0aa1\u0ac7\u0ab8\u0acd\u0a95\u0a9f\u0acb\u0aaa/\u0ab2\u0ac7\u0aaa\u0a9f\u0acb\u0aaa \u0a95\u0aae\u0acd\u0aaa\u0acd\u0aaf\u0ac1\u0a9f\u0ab0\u0acd\u0ab8, \u0ab5\u0ac7\u0aac-\u0ab8\u0a95\u0acd\u0ab7\u0aae \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0a89\u0aaa\u0a95\u0ab0\u0aa3\u0acb \u0ab5\u0a97\u0ac7\u0ab0\u0ac7 \u0a9c\u0ac7\u0ab5\u0abe \u0ab5\u0abf\u0ab5\u0abf\u0aa7 \u0a89\u0aaa\u0a95\u0ab0\u0aa3\u0acb\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0a9c\u0acb\u0a88 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7. </p> <p> \u0a85\u0aae\u0ac7 \u0a86 \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aaa\u0ab0\u0aa8\u0ac0 \u0aa4\u0aae\u0abe\u0aae \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0ab5\u0abf\u0a95\u0ab2\u0abe\u0a82\u0a97 \u0ab2\u0acb\u0a95\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0ac1\u0ab2\u0aad \u0a9b\u0ac7 \u0aa4\u0ac7\u0aa8\u0ac0 \u0a96\u0abe\u0aa4\u0ab0\u0ac0 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0aae\u0abe\u0ab0\u0abe \u0ab6\u0acd\u0ab0\u0ac7\u0ab7\u0acd\u0aa0 \u0aaa\u0acd\u0ab0\u0aaf\u0abe\u0ab8\u0acb \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0a9b\u0ac7. \u0a89\u0aa6\u0abe\u0ab9\u0ab0\u0aa3 \u0aa4\u0ab0\u0ac0\u0a95\u0ac7, \u0aa6\u0ac3\u0ab7\u0acd\u0a9f\u0abf\u0aa8\u0ac0 \u0a85\u0a95\u0acd\u0ab7\u0aae\u0aa4\u0abe \u0aa7\u0ab0\u0abe\u0ab5\u0aa4\u0abe \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe \u0ab8\u0ab9\u0abe\u0aaf\u0a95 \u0aa4\u0a95\u0aa8\u0ac0\u0a95\u0acb\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a86 \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7, \u0a9c\u0ac7\u0aae \u0a95\u0ac7 \u0ab8\u0acd\u0a95\u0acd\u0ab0\u0ac0\u0aa8 \u0ab0\u0ac0\u0aa1\u0ab0\u0acd\u0ab8 \u0a85\u0aa8\u0ac7 \u0ab8\u0acd\u0a95\u0acd\u0ab0\u0ac0\u0aa8 \u0aae\u0ac7\u0a97\u0acd\u0aa8\u0abf\u0aab\u0abe\u0aaf\u0ab0\u0acd\u0ab8. </p> \u0a85\u0aae\u0ac7 \u0aaa\u0aa3 \u0aa7\u0acb\u0ab0\u0aa3\u0acb\u0aa8\u0ac1\u0a82 \u0aaa\u0abe\u0ab2\u0aa8 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0a85\u0aa8\u0ac7 \u0ab8\u0abf\u0aa6\u0acd\u0aa7\u0abe\u0a82\u0aa4\u0acb\u0aa8\u0ac1\u0a82 \u0aaa\u0abe\u0ab2\u0aa8 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0ab2\u0a95\u0acd\u0ab7\u0acd\u0aaf \u0ab0\u0abe\u0a96\u0ac0\u0a8f \u0a9b\u0ac0\u0a8f. \u0aac\u0abe\u0ab9\u0acd\u0aaf \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f\u0acd\u0ab8. \u0aac\u0abe\u0ab9\u0acd\u0aaf \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f\u0acd\u0ab8 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0ab5\u0abf\u0aad\u0abe\u0a97\u0acb \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9c\u0abe\u0ab3\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7 \u0a9c\u0ac7\u0a93 \u0a86 \u0ab8\u0abe\u0a87\u0a9f\u0acd\u0ab8\u0aa8\u0ac7 \u0ab8\u0ac1\u0ab2\u0aad \u0aac\u0aa8\u0abe\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a9c\u0ab5\u0abe\u0aac\u0aa6\u0abe\u0ab0 \u0a9b\u0ac7. </p> <p> \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aa4\u0ac7\u0aa8\u0abe \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae\u0aa8\u0ac7 \u0ab5\u0abf\u0a95\u0ab2\u0abe\u0a82\u0a97 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0ac1\u0ab2\u0aad \u0aac\u0aa8\u0abe\u0ab5\u0ab5\u0abe \u0aa4\u0ab0\u0aab \u0a95\u0abe\u0aae \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0ac0 \u0a9b\u0ac7, \u0a9c\u0acb \u0a95\u0ac7 \u0ab9\u0abe\u0ab2\u0aae\u0abe\u0a82 \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ac7\u0aac\u0ab2 \u0aa1\u0acb\u0a95\u0acd\u0aaf\u0ac1\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0aab\u0acb\u0ab0\u0acd\u0aae\u0ac7\u0a9f (\u0aaa\u0ac0\u0aa1\u0ac0\u0a8f\u0aab) \u0aab\u0abe\u0a87\u0ab2\u0acb \u0ab8\u0ac1\u0ab2\u0aad \u0aa8\u0aa5\u0ac0. \u0ab5\u0aa7\u0ac1\u0aae\u0abe\u0a82, \u0ab9\u0abf\u0aa8\u0acd\u0aa6\u0ac0 \u0aad\u0abe\u0ab7\u0abe\u0aae\u0abe\u0a82 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0ac0 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0aaa\u0aa3 \u0ab8\u0ac1\u0ab2\u0aad \u0aa8\u0aa5\u0ac0. </p> <p> \u0a9c\u0acb \u0aa4\u0aae\u0aa8\u0ac7 \u0a86 \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae\u0aa8\u0ac0 \u0ab8\u0ac1\u0ab2\u0aad\u0aa4\u0abe \u0a85\u0a82\u0a97\u0ac7 \u0a95\u0acb\u0a88 \u0ab8\u0aae\u0ab8\u0acd\u0aaf\u0abe \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0ac2\u0a9a\u0aa8 \u0ab9\u0acb\u0aaf, \u0aa4\u0acb \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a85\u0aae\u0aa8\u0ac7 support-myscheme[at]myScheme[dot]gov[dot]in \u0ab2\u0a96\u0acb \u0a9c\u0ac7\u0aa5\u0ac0 \u0a85\u0aae\u0ac7 \u0aae\u0aa6\u0aa6\u0ab0\u0ac2\u0aaa \u0ab0\u0ac0\u0aa4\u0ac7 \u0a9c\u0ab5\u0abe\u0aac \u0a86\u0aaa\u0ac0 \u0ab6\u0a95\u0ac0\u0a8f. \u0ab6\u0ac1\u0a82 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0ab8\u0abe\u0aa5\u0ac7 \u0ab8\u0aae\u0ab8\u0acd\u0aaf\u0abe\u0aa8\u0ac1\u0a82 \u0ab8\u0acd\u0ab5\u0ab0\u0ac2\u0aaa \u0a85\u0aae\u0aa8\u0ac7 \u0a9c\u0aa3\u0abe\u0ab5\u0acb."),(0,xe.Z)(re,"privacyPolicy","\u0a97\u0acb\u0aaa\u0aa8\u0ac0\u0aaf\u0aa4\u0abe \u0aa8\u0ac0\u0aa4\u0abf"),(0,xe.Z)(re,"hyperlinkPolicy","\u0ab9\u0abe\u0aaf\u0aaa\u0ab0\u0ab2\u0abf\u0a82\u0a95\u0abf\u0a82\u0a97 \u0aa8\u0ac0\u0aa4\u0abf"),(0,xe.Z)(re,"termsOfUse","\u0a89\u0aaa\u0aaf\u0acb\u0a97\u0aa8\u0ac0 \u0ab6\u0ab0\u0aa4\u0acb"),(0,xe.Z)(re,"terms","\u0aa8\u0abf\u0aaf\u0aae\u0acb \u0a85\u0aa8\u0ac7 \u0ab6\u0ab0\u0aa4\u0acb"),(0,xe.Z)(re,"copyrightPolicy","\u0a95\u0ac9\u0aaa\u0abf\u0ab0\u0abe\u0a87\u0a9f \u0aa8\u0ac0\u0aa4\u0abf"),(0,xe.Z)(re,"termsConditions","<p> \u0aa8\u0abf\u0aaf\u0aae\u0acb \u0a85\u0aa8\u0ac7 \u0ab6\u0ab0\u0aa4\u0acb </p>"),(0,xe.Z)(re,"copyrightPolicyText","\u0a86 \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aaa\u0ab0 \u0aa6\u0ab0\u0acd\u0ab6\u0abe\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0 \u0aae\u0aab\u0aa4\u0aae\u0abe\u0a82 \u0aaa\u0ac1\u0aa8\u0a83\u0a89\u0aa4\u0acd\u0aaa\u0abe\u0aa6\u0abf\u0aa4 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7. \u0a9c\u0acb \u0a95\u0ac7, \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab8\u0a9a\u0acb\u0a9f \u0ab0\u0ac0\u0aa4\u0ac7 \u0aaa\u0ac1\u0aa8\u0a83\u0a89\u0aa4\u0acd\u0aaa\u0abe\u0aa6\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0ac0 \u0aaa\u0aa1\u0ab6\u0ac7 \u0a85\u0aa8\u0ac7 \u0a85\u0aaa\u0aae\u0abe\u0aa8\u0a9c\u0aa8\u0a95 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a85\u0aa5\u0ab5\u0abe \u0a97\u0ac7\u0ab0\u0aae\u0abe\u0ab0\u0acd\u0a97\u0ac7 \u0aa6\u0acb\u0ab0\u0aa4\u0abe \u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad\u0aae\u0abe\u0a82 \u0aa4\u0ac7\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0aa8 \u0a95\u0ab0\u0ab5\u0acb \u0a9c\u0acb\u0a88\u0a8f. \u0a9c\u0acd\u0aaf\u0abe\u0a82 \u0aaa\u0aa3 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab6\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0ab0\u0ab9\u0ac0 \u0a9b\u0ac7 \u0a85\u0aa5\u0ab5\u0abe \u0a85\u0aa8\u0acd\u0aaf \u0ab2\u0acb\u0a95\u0acb\u0aa8\u0ac7 \u0a9c\u0abe\u0ab0\u0ac0 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0ab0\u0ab9\u0ac0 \u0a9b\u0ac7, \u0aa4\u0acd\u0aaf\u0abe\u0a82 \u0ab8\u0acd\u0ab0\u0acb\u0aa4\u0aa8\u0ac7 \u0ab8\u0acd\u0aaa\u0ab7\u0acd\u0a9f\u0aaa\u0aa3\u0ac7 \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0abe\u0ab0\u0ab5\u0acb \u0a86\u0ab5\u0ab6\u0acd\u0aaf\u0a95 \u0a9b\u0ac7. \u0a9c\u0acb \u0a95\u0ac7, \u0a86 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u0aa8\u0ac1\u0a82 \u0aaa\u0ac1\u0aa8\u0a83\u0a89\u0aa4\u0acd\u0aaa\u0abe\u0aa6\u0aa8 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0aaa\u0ab0\u0ab5\u0abe\u0aa8\u0a97\u0ac0 \u0a95\u0acb\u0a88 \u0aaa\u0aa3 \u0a8f\u0ab5\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0 \u0ab8\u0ac1\u0aa7\u0ac0 \u0ab5\u0abf\u0ab8\u0acd\u0aa4\u0ab0\u0ab6\u0ac7 \u0aa8\u0ab9\u0ac0\u0a82 \u0a9c\u0ac7 \u0aa4\u0ac3\u0aa4\u0ac0\u0aaf \u0aaa\u0a95\u0acd\u0ab7 (\u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ac7\u0ab2\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0) \u0aa8\u0abe \u0a95\u0ac9\u0aaa\u0abf\u0ab0\u0abe\u0a87\u0a9f \u0aa4\u0ab0\u0ac0\u0a95\u0ac7 \u0a93\u0ab3\u0a96\u0abe\u0aaf \u0a9b\u0ac7. \u0a86\u0ab5\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u0aa8\u0ac1\u0a82 \u0aaa\u0ac1\u0aa8\u0a83\u0a89\u0aa4\u0acd\u0aaa\u0abe\u0aa6\u0aa8 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0a85\u0aa7\u0abf\u0a95\u0ac3\u0aa4\u0aa4\u0abe \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0a95\u0ac9\u0aaa\u0abf\u0ab0\u0abe\u0a87\u0a9f \u0aa7\u0abe\u0ab0\u0a95 \u0aaa\u0abe\u0ab8\u0ac7\u0aa5\u0ac0 \u0aae\u0ac7\u0ab3\u0ab5\u0ab5\u0ac0 \u0a86\u0ab5\u0ab6\u0acd\u0aaf\u0a95 \u0a9b\u0ac7."),(0,xe.Z)(re,"privacyPolicyText","<p> \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0a86\u0aaa\u0aae\u0ac7\u0ab3\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0abe\u0ab8\u0ac7\u0aa5\u0ac0 \u0a95\u0acb\u0a88 \u0a9a\u0acb\u0a95\u0acd\u0a95\u0ab8 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 (\u0a9c\u0ac7\u0aae \u0a95\u0ac7 \u0aa8\u0abe\u0aae, \u0aab\u0acb\u0aa8 \u0aa8\u0a82\u0aac\u0ab0 \u0a85\u0aa5\u0ab5\u0abe \u0a88-\u0aae\u0ac7\u0ab2 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82) \u0aae\u0ac7\u0ab3\u0ab5\u0aa4\u0ac1\u0a82 \u0aa8\u0aa5\u0ac0, \u0a9c\u0ac7 \u0a85\u0aae\u0aa8\u0ac7 \u0aa4\u0aae\u0aa8\u0ac7 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a93\u0ab3\u0a96\u0ab5\u0abe\u0aa8\u0ac0 \u0aae\u0a82\u0a9c\u0ac2\u0ab0\u0ac0 \u0a86\u0aaa\u0ac7 \u0a9b\u0ac7. \u0a9c\u0acb \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aa4\u0aae\u0aa8\u0ac7 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7, \u0aa4\u0acb \u0aa4\u0aae\u0aa8\u0ac7 \u0a9a\u0acb\u0a95\u0acd\u0a95\u0ab8 \u0ab9\u0ac7\u0aa4\u0ac1\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0a9c\u0abe\u0aa3 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7 \u0a95\u0ac7 \u0a9c\u0ac7\u0aa8\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0a8f\u0a95\u0aa4\u0acd\u0ab0\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0\u0aa8\u0ac7 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0ab0\u0abe\u0a96\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aaa\u0ac2\u0ab0\u0aa4\u0abe \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0aaa\u0a97\u0ab2\u0abe\u0a82 \u0ab2\u0ac7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7. \u0a85\u0aae\u0ac7 \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0ab0 \u0ab8\u0acd\u0ab5\u0ac8\u0a9a\u0acd\u0a9b\u0abf\u0a95 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a93\u0ab3\u0a96\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0aa4\u0ac7\u0ab5\u0ac0 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0\u0aa8\u0ac7 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0aa4\u0ac3\u0aa4\u0ac0\u0aaf \u0aaa\u0a95\u0acd\u0ab7 (\u0a9c\u0abe\u0ab9\u0ac7\u0ab0/\u0a96\u0abe\u0aa8\u0a97\u0ac0) \u0aa8\u0ac7 \u0ab5\u0ac7\u0a9a\u0aa4\u0abe \u0aa8\u0aa5\u0ac0 \u0a85\u0aa5\u0ab5\u0abe \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0aa4\u0abe \u0aa8\u0aa5\u0ac0. \u0a86 \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aaa\u0ab0 \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0ac0 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8, \u0aa6\u0ac1\u0ab0\u0ac2\u0aaa\u0aaf\u0acb\u0a97, \u0a85\u0aa8\u0aa7\u0abf\u0a95\u0ac3\u0aa4 \u0a8d\u0a95\u0acd\u0ab8\u0ac7\u0ab8 \u0a85\u0aa5\u0ab5\u0abe \u0a9c\u0abe\u0ab9\u0ac7\u0ab0\u0abe\u0aa4, \u0aab\u0ac7\u0ab0\u0aab\u0abe\u0ab0 \u0a85\u0aa5\u0ab5\u0abe \u0ab5\u0abf\u0aa8\u0abe\u0ab6\u0aa5\u0ac0 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0ab0\u0ab9\u0ac7\u0ab6\u0ac7. \u0a85\u0aae\u0ac7 \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe \u0ab5\u0abf\u0ab6\u0ac7 \u0a95\u0ac7\u0a9f\u0ab2\u0ac0\u0a95 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0a8f\u0a95\u0aa4\u0acd\u0ab0\u0abf\u0aa4 \u0a95\u0ab0\u0ac0\u0a8f \u0a9b\u0ac0\u0a8f, \u0a9c\u0ac7\u0aae \u0a95\u0ac7 \u0a87\u0aa8\u0acd\u0a9f\u0ab0\u0aa8\u0ac7\u0a9f \u0aaa\u0acd\u0ab0\u0acb\u0a9f\u0acb\u0a95\u0acb\u0ab2 (IP) \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0a93, \u0aa1\u0acb\u0aae\u0ac7\u0aa8 \u0aa8\u0abe\u0aae, \u0aac\u0acd\u0ab0\u0abe\u0a89\u0a9d\u0ab0 \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0."),(0,xe.Z)(re,"hyperlinkPolicyText","<p> <strong> \u0aac\u0abe\u0ab9\u0acd\u0aaf \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f\u0acd\u0ab8/\u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae\u0acd\u0ab8\u0aa8\u0ac0 \u0ab2\u0abf\u0a82\u0a95\u0acd\u0ab8 </strong> <p> <p> \u0a86 \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aaa\u0ab0 \u0a98\u0aa3\u0ac0 \u0a9c\u0a97\u0acd\u0aaf\u0abe\u0a8f \u0aa4\u0aae\u0aa8\u0ac7 \u0a85\u0aa8\u0acd\u0aaf \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f\u0acd\u0ab8/\u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae\u0acd\u0ab8\u0aa8\u0ac0 \u0ab2\u0abf\u0a82\u0a95\u0acd\u0ab8 \u0aae\u0ab3\u0ab6\u0ac7. \u0ab2\u0abf\u0a82\u0a95\u0acd\u0ab8 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aae\u0ac2\u0a95\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7. \u0aae\u0abe\u0aaf\u0ab8\u0acd\u0a95\u0ac0\u0aae \u0ab2\u0abf\u0a82\u0a95 \u0a95\u0ab0\u0ac7\u0ab2\u0ac0 \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f\u0acd\u0ab8\u0aa8\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0 \u0a85\u0aa8\u0ac7 \u0ab5\u0abf\u0ab6\u0acd\u0ab5\u0ab8\u0aa8\u0ac0\u0aaf\u0aa4\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a9c\u0ab5\u0abe\u0aac\u0aa6\u0abe\u0ab0 \u0aa8\u0aa5\u0ac0 \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aae\u0abe\u0a82 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4 \u0a95\u0ab0\u0ac7\u0ab2\u0abe \u0aae\u0a82\u0aa4\u0ab5\u0acd\u0aaf\u0acb\u0aa8\u0ac7 \u0a86\u0ab5\u0ab6\u0acd\u0aaf\u0a95\u0aaa\u0aa3\u0ac7 \u0ab8\u0aae\u0ab0\u0acd\u0aa5\u0aa8 \u0a86\u0aaa\u0aa4\u0ac1\u0a82 \u0aa8\u0aa5\u0ac0. \u0a86 \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aaa\u0ab0 \u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0ab2\u0abf\u0a82\u0a95 \u0a85\u0aa5\u0ab5\u0abe \u0aa4\u0ac7\u0aa8\u0ac0 \u0ab8\u0ac2\u0a9a\u0abf\u0aa8\u0ac0 \u0ab9\u0abe\u0a9c\u0ab0\u0ac0\u0aa8\u0ac7 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0\u0aa8\u0ac0 \u0ab8\u0aae\u0ab0\u0acd\u0aa5\u0aa8 \u0aa4\u0ab0\u0ac0\u0a95\u0ac7 \u0a97\u0aa3\u0ab5\u0ac0 \u0a9c\u0acb\u0a88\u0a8f \u0aa8\u0ab9\u0ac0\u0a82. \u0a85\u0aae\u0ac7 \u0aac\u0abe\u0a82\u0ab9\u0ac7\u0aa7\u0ab0\u0ac0 \u0a86\u0aaa\u0ac0 \u0ab6\u0a95\u0aa4\u0abe \u0aa8\u0aa5\u0ac0 \u0a95\u0ac7 \u0a86 \u0ab2\u0abf\u0a82\u0a95\u0acd\u0ab8 \u0ab9\u0a82\u0aae\u0ac7\u0ab6\u0abe\u0a82 \u0a95\u0abe\u0aae \u0a95\u0ab0\u0ab6\u0ac7 \u0a85\u0aa8\u0ac7 \u0ab2\u0abf\u0a82\u0a95 \u0a95\u0ab0\u0ac7\u0ab2\u0abe \u0aaa\u0ac3\u0ab7\u0acd\u0aa0\u0acb\u0aa8\u0ac0 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7\u0aa4\u0abe \u0aaa\u0ab0 \u0a85\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0a95\u0acb\u0a88 \u0aa8\u0abf\u0aaf\u0a82\u0aa4\u0acd\u0ab0\u0aa3 \u0aa8\u0aa5\u0ac0."),(0,xe.Z)(re,"termsText1","<p> \u0a86 \u0a89\u0aaa\u0aaf\u0acb\u0a97\u0aa8\u0ac0 \u0ab6\u0ab0\u0aa4\u0acb https://www.myscheme.gov.in \u0aa8\u0abe \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe \u0aa4\u0ab0\u0ac0\u0a95\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a85\u0aa7\u0abf\u0a95\u0abe\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0a9c\u0ab5\u0abe\u0aac\u0aa6\u0abe\u0ab0\u0ac0\u0a93\u0aa8\u0ac1\u0a82 \u0ab5\u0ab0\u0acd\u0aa3\u0aa8 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7. \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0a96\u0abe\u0aa4\u0ac1\u0a82 \u0ab0\u0abe\u0a96\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7, \u0aa4\u0aae\u0abe\u0ab0\u0ac7 \u0a86 \u0a89\u0aaa\u0aaf\u0acb\u0a97\u0aa8\u0ac0 \u0ab6\u0ab0\u0aa4\u0acb \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0abe\u0ab0\u0ab5\u0ac0 \u0a9c \u0a9c\u0acb\u0a87\u0a8f. </p> <p> \u0a8f\u0aae\u0a87\u0a86\u0a87\u0a9f\u0ac0\u0ab5\u0abe\u0aaf \u0a85\u0aa8\u0ac7 \u0aad\u0abe\u0ab0\u0aa4 \u0ab8\u0ab0\u0a95\u0abe\u0ab0 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0ab8\u0aae\u0aaf\u0ac7 \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0a85\u0aa8\u0ac7 \u0a89\u0aaa\u0aaf\u0acb\u0a97\u0aa8\u0ac0 \u0a86 \u0ab6\u0ab0\u0aa4\u0acb\u0aae\u0abe\u0a82 \u0aab\u0ac7\u0ab0\u0aab\u0abe\u0ab0 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0acb \u0a85\u0aa7\u0abf\u0a95\u0abe\u0ab0 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0ab0\u0abe\u0a96\u0ac7 \u0a9b\u0ac7. \u0a9c\u0acb \u0aa4\u0ac7 \u0aab\u0ac7\u0ab0\u0aab\u0abe\u0ab0\u0acb \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a85\u0aa7\u0abf\u0a95\u0abe\u0ab0\u0acb \u0a85\u0aa5\u0ab5\u0abe \u0a9c\u0ab5\u0abe\u0aac\u0aa6\u0abe\u0ab0\u0ac0\u0a93\u0aa8\u0ac7 \u0a85\u0ab8\u0ab0 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7, \u0aa4\u0acb \u0aa4\u0aae\u0aa8\u0ac7 \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab8\u0ac2\u0a9a\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7. </p> <p> \u0aa8\u0ac0\u0a9a\u0ac7\u0aa8\u0ac0 \u0a89\u0aaa\u0aaf\u0acb\u0a97\u0aa8\u0ac0 \u0ab6\u0ab0\u0aa4\u0acb \u0aa4\u0aae\u0ac7 \u0a85\u0a97\u0abe\u0a89 \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0abe\u0ab0\u0ac7\u0ab2 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0aa8\u0abf\u0aaf\u0aae\u0acb \u0a85\u0aa8\u0ac7 \u0ab6\u0ab0\u0aa4\u0acb\u0aa8\u0ac7 \u0ab8\u0acd\u0aa5\u0abe\u0aa8\u0abe\u0a82\u0aa4\u0ab0\u0abf\u0aa4 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7 \u0a9c\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae\u0aa8\u0abe \u0a89\u0aaa\u0aaf\u0acb\u0a97\u0aa8\u0ac7 \u0ab8\u0a82\u0a9a\u0abe\u0ab2\u0abf\u0aa4 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7. \u0aa8\u0ac0\u0a9a\u0ac7\u0aa8\u0ac0 \u0ab6\u0ab0\u0aa4\u0acb \u0a85\u0aa8\u0ac7 \u0ab6\u0ab0\u0aa4\u0acb \u0aa4\u0aae\u0ac7 \u0aa4\u0ac7\u0aa8\u0ac7 \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0abe\u0ab0\u0acd\u0aaf\u0abe \u0aaa\u0a9b\u0ac0 \u0aa4\u0ab0\u0aa4 \u0a9c \u0a85\u0aae\u0ab2\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0a96\u0abe\u0aa4\u0ac1\u0a82 \u0aac\u0aa8\u0abe\u0ab5\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7. \u0aad\u0abe\u0ab0\u0aa4 \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0aa8\u0ac0 \u0ab8\u0a82\u0ab8\u0acd\u0aa5\u0abe\u0a93, \u0ab5\u0abf\u0aad\u0abe\u0a97\u0acb \u0a85\u0aa8\u0ac7 \u0aae\u0a82\u0aa4\u0acd\u0ab0\u0abe\u0ab2\u0aaf\u0acb. </p> <p> \u0a9c\u0acb\u0a95\u0ac7 \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0ab0\u0aa8\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u0aa8\u0ac0 \u0a9a\u0acb\u0a95\u0ab8\u0abe\u0a88 \u0ab8\u0ac1\u0aa8\u0abf\u0ab6\u0acd\u0a9a\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0aae\u0abe\u0aae \u0aaa\u0acd\u0ab0\u0aaf\u0abe\u0ab8\u0acb \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0abe \u0a9b\u0ac7, \u0aa4\u0ac7\u0aae \u0a9b\u0aa4\u0abe\u0a82 \u0aa4\u0ac7\u0aa8\u0ac7 \u0a95\u0abe\u0aaf\u0aa6\u0abe\u0aa8\u0abe \u0aa8\u0abf\u0ab5\u0ac7\u0aa6\u0aa8 \u0aa4\u0ab0\u0ac0\u0a95\u0ac7 \u0ab8\u0aae\u0a9c\u0ab5\u0ac1\u0a82 \u0a9c\u0acb\u0a88\u0a8f \u0aa8\u0ab9\u0ac0\u0a82 \u0a85\u0aa5\u0ab5\u0abe \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a95\u0abe\u0aa8\u0ac2\u0aa8\u0ac0 \u0ab9\u0ac7\u0aa4\u0ac1\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0ac7\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ab5\u0acb \u0a9c\u0acb\u0a88\u0a8f \u0aa8\u0ab9\u0ac0\u0a82. \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a85\u0ab8\u0acd\u0aaa\u0ab7\u0acd\u0a9f\u0aa4\u0abe \u0a85\u0aa5\u0ab5\u0abe \u0ab6\u0a82\u0a95\u0abe\u0aa8\u0abe \u0a95\u0abf\u0ab8\u0acd\u0ab8\u0abe\u0aae\u0abe\u0a82, \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a93\u0aa8\u0ac7 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aae\u0a82\u0aa4\u0acd\u0ab0\u0abe\u0ab2\u0aaf/\u0ab5\u0abf\u0aad\u0abe\u0a97/\u0ab8\u0a82\u0ab8\u0acd\u0aa5\u0abe \u0a85\u0aa8\u0ac7/\u0a85\u0aa5\u0ab5\u0abe \u0a85\u0aa8\u0acd\u0aaf \u0ab8\u0acd\u0ab0\u0acb\u0aa4 (\u0a93) \u0ab8\u0abe\u0aa5\u0ac7 \u0a9a\u0a95\u0abe\u0ab8\u0aa3\u0ac0/\u0aa4\u0aaa\u0abe\u0ab8 \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0aa8\u0ac7 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0ab5\u0acd\u0aaf\u0abe\u0ab5\u0ab8\u0abe\u0aaf\u0abf\u0a95 \u0ab8\u0ab2\u0abe\u0ab9 \u0aae\u0ac7\u0ab3\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0ab2\u0abe\u0ab9 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7. </p> <p> \u0a95\u0acb\u0a88 \u0aaa\u0aa3 \u0ab8\u0a82\u0a9c\u0acb\u0a97\u0acb\u0aae\u0abe\u0a82 \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0aae\u0a82\u0aa4\u0acd\u0ab0\u0abe\u0ab2\u0aaf/\u0ab5\u0abf\u0aad\u0abe\u0a97/\u0ab8\u0a82\u0ab8\u0acd\u0aa5\u0abe \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a96\u0ab0\u0acd\u0a9a, \u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8 \u0a85\u0aa5\u0ab5\u0abe \u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8 \u0aae\u0abe\u0a9f\u0ac7 \u0a9c\u0ab5\u0abe\u0aac\u0aa6\u0abe\u0ab0 \u0ab0\u0ab9\u0ac7\u0ab6\u0ac7 \u0aa8\u0ab9\u0ac0\u0a82, \u0a9c\u0ac7\u0aae\u0abe\u0a82 \u0aae\u0ab0\u0acd\u0aaf\u0abe\u0aa6\u0abe \u0ab5\u0abf\u0aa8\u0abe, \u0aaa\u0ab0\u0acb\u0a95\u0acd\u0ab7 \u0a85\u0aa5\u0ab5\u0abe \u0aaa\u0ab0\u0abf\u0aa3\u0abe\u0aae\u0ac0 \u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8 \u0a85\u0aa5\u0ab5\u0abe \u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8, \u0a85\u0aa5\u0ab5\u0abe \u0a89\u0aaa\u0aaf\u0acb\u0a97\u0aa5\u0ac0 \u0a89\u0aa6\u0acd\u0aad\u0ab5\u0aa4\u0abe \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a96\u0ab0\u0acd\u0a9a, \u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8 \u0a85\u0aa5\u0ab5\u0abe \u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8, \u0a85\u0aa5\u0ab5\u0abe"),(0,xe.Z)(re,"termsHead1","\u0a89\u0aaa\u0aaf\u0acb\u0a97\u0aa8\u0ac0 \u0aae\u0ab0\u0acd\u0aaf\u0abe\u0aa6\u0abe:"),(0,xe.Z)(re,"termsText2","<p> \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae\u0aa8\u0acb \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a85\u0aa8\u0aa7\u0abf\u0a95\u0ac3\u0aa4 \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0a9b\u0ac7. \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aaa\u0ac3\u0ab7\u0acd\u0aa0\u0acb\u0aa8\u0ac7 \u0a8d\u0a95\u0acd\u0ab8\u0ac7\u0ab8 \u0a95\u0ab0\u0ab5\u0abe, \u0aae\u0acb\u0aa8\u0abf\u0a9f\u0ab0 \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0aa5\u0ab5\u0abe \u0a95\u0ac9\u0aaa\u0abf \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0ab8\u0acb\u0aab\u0acd\u0a9f\u0ab5\u0ac7\u0ab0 (\u0aa6\u0abe. \u0aa4. \u0aac\u0ac9\u0a9f\u0acb, \u0ab8\u0acd\u0a95\u0acd\u0ab0\u0ac7\u0aaa\u0ab0 \u0a9f\u0ac2\u0ab2\u0acd\u0ab8) \u0a85\u0aa5\u0ab5\u0abe \u0a85\u0aa8\u0acd\u0aaf \u0ab8\u0acd\u0ab5\u0a9a\u0abe\u0ab2\u0abf\u0aa4 \u0a89\u0aaa\u0a95\u0ab0\u0aa3\u0acb\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a9c\u0acd\u0aaf\u0abe\u0a82 \u0ab8\u0ac1\u0aa7\u0ac0 \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab2\u0ac7\u0a96\u0abf\u0aa4\u0aae\u0abe\u0a82 \u0ab8\u0acd\u0aaa\u0ab7\u0acd\u0a9f \u0ab0\u0ac0\u0aa4\u0ac7 \u0a85\u0aa7\u0abf\u0a95\u0ac3\u0aa4 \u0aa8 \u0ab9\u0acb\u0aaf \u0aa4\u0acd\u0aaf\u0abe\u0a82 \u0ab8\u0ac1\u0aa7\u0ac0 \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0a9b\u0ac7."),(0,xe.Z)(re,"termsHead2","\u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa7\u0acd\u0aaf\u0abe\u0aa8\u0aae\u0abe\u0a82 \u0ab0\u0abe\u0a96\u0ab5\u0abe\u0aa8\u0ac0 \u0aa8\u0ac0\u0aa4\u0abf:"),(0,xe.Z)(re,"termsText3","<p> \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0ab0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0 \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0aa5\u0ab5\u0abe \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7, \u0aa4\u0aae\u0ac7 \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae\u0aa8\u0ac7 \u0ab6\u0abe\u0ab6\u0acd\u0ab5\u0aa4, \u0ab5\u0abf\u0ab6\u0acd\u0ab5\u0ab5\u0acd\u0aaf\u0abe\u0aaa\u0ac0, \u0ab0\u0acb\u0aaf\u0ab2\u0acd\u0a9f\u0ac0-\u0aae\u0ac1\u0a95\u0acd\u0aa4, \u0a85\u0a9f\u0ab2, \u0aac\u0abf\u0aa8-\u0ab5\u0abf\u0ab6\u0abf\u0ab7\u0acd\u0a9f \u0a85\u0aa7\u0abf\u0a95\u0abe\u0ab0 \u0a85\u0aa8\u0ac7 \u0ab2\u0abe\u0a87\u0ab8\u0aa8\u0acd\u0ab8 \u0a86\u0aaa\u0acb \u0a9b\u0acb (\u0a85\u0aa5\u0ab5\u0abe \u0aac\u0abe\u0a82\u0ab9\u0ac7\u0aa7\u0ab0\u0ac0 \u0a86\u0aaa\u0acb \u0a9b\u0acb \u0a95\u0ac7 \u0a86\u0ab5\u0abe \u0a85\u0aa7\u0abf\u0a95\u0abe\u0ab0\u0acb\u0aa8\u0abe \u0aae\u0abe\u0ab2\u0abf\u0a95\u0ac7 \u0ab8\u0acd\u0aaa\u0ab7\u0acd\u0a9f\u0aaa\u0aa3\u0ac7 \u0aae\u0a82\u0a9c\u0ac2\u0ab0\u0ac0 \u0a86\u0aaa\u0ac0 \u0a9b\u0ac7), \u0a9c\u0ac7\u0aae\u0abe\u0a82 \u0ab8\u0aac\u0ab2\u0abe\u0a87\u0ab8\u0ac7\u0aa8\u0acd\u0ab8\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0acb, \u0aaa\u0ac1\u0aa8\u0a83\u0a89\u0aa4\u0acd\u0aaa\u0abe\u0aa6\u0aa8 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0acb, \u0ab8\u0a82\u0ab6\u0acb\u0aa7\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0acb, \u0a85\u0aa8\u0ac1\u0a95\u0ac2\u0ab2\u0aa8 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0acb, \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab6\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0acb, \u0a9c\u0abe\u0ab9\u0ac7\u0ab0\u0aae\u0abe\u0a82 \u0aaa\u0acd\u0ab0\u0aa6\u0ab0\u0acd\u0ab6\u0aa8 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0acb, \u0a9c\u0abe\u0ab9\u0ac7\u0ab0\u0aae\u0abe\u0a82 \u0aaa\u0acd\u0ab0\u0aa6\u0ab0\u0acd\u0ab6\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0acb, \u0aa1\u0abf\u0a9c\u0abf\u0a9f\u0ab2 \u0ab0\u0ac0\u0aa4\u0ac7 \u0aaa\u0acd\u0ab0\u0aa6\u0ab0\u0acd\u0ab6\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0acb \u0a85\u0aa8\u0ac7 \u0aa1\u0abf\u0a9c\u0abf\u0a9f\u0ab2 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a85\u0aa8\u0ac1\u0ab5\u0abe\u0aa6 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0acb, \u0a86\u0ab5\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0ab5\u0acd\u0aaf\u0ac1\u0aa4\u0acd\u0aaa\u0aa8\u0acd\u0aa8 \u0a95\u0ac3\u0aa4\u0abf\u0a93 \u0aac\u0aa8\u0abe\u0ab5\u0ab5\u0abe\u0aa8\u0acb \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aa8\u0ac1\u0a82 \u0ab5\u0abf\u0aa4\u0ab0\u0aa3 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0acb \u0a85\u0aa5\u0ab5\u0abe \u0a86\u0ab5\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab9\u0ab5\u0ac7 \u0ab8\u0aae\u0a97\u0acd\u0ab0 \u0aac\u0acd\u0ab0\u0ab9\u0acd\u0aae\u0abe\u0a82\u0aa1\u0aae\u0abe\u0a82 \u0a9c\u0abe\u0aa3\u0ac0\u0aa4\u0abe \u0a85\u0aa5\u0ab5\u0abe \u0aaa\u0a9b\u0ac0\u0aa5\u0ac0 \u0ab5\u0abf\u0a95\u0ab8\u0abf\u0aa4 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0ab8\u0acd\u0ab5\u0ab0\u0ac2\u0aaa, \u0aae\u0abe\u0aa7\u0acd\u0aaf\u0aae \u0a85\u0aa5\u0ab5\u0abe \u0aa4\u0a95\u0aa8\u0ac0\u0a95\u0aae\u0abe\u0a82 \u0ab8\u0abe\u0aae\u0ac7\u0ab2 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0acb \u0a85\u0aa7\u0abf\u0a95\u0abe\u0ab0 \u0a9b\u0ac7. \u0aa4\u0aae\u0ac7 \u0ab8\u0a82\u0aae\u0aa4 \u0aa5\u0abe\u0a93 \u0a9b\u0acb \u0a95\u0ac7 \u0aa4\u0aae\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa4\u0abe \u0ab8\u0abe\u0aae\u0ac7 \u0a95\u0acb\u0a88 \u0a95\u0aa5\u0abf\u0aa4 \u0a85\u0aa5\u0ab5\u0abe \u0ab5\u0abe\u0ab8\u0acd\u0aa4\u0ab5\u0abf\u0a95 \u0a89\u0ab2\u0acd\u0ab2\u0a82\u0a98\u0aa8 \u0a85\u0aa5\u0ab5\u0abe \u0a85\u0aae\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0ab8\u0a82\u0aa6\u0ac7\u0ab6\u0abe\u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0\u0aae\u0abe\u0a82 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0aae\u0abe\u0ab2\u0abf\u0a95\u0ac0\u0aa8\u0abe \u0a85\u0aa7\u0abf\u0a95\u0abe\u0ab0\u0aa8\u0ac0 \u0a97\u0ac7\u0ab0\u0ab0\u0ac0\u0aa4\u0abf \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0acb\u0a88 \u0a86\u0ab6\u0acd\u0ab0\u0aaf \u0aae\u0ab3\u0ab6\u0ac7 \u0aa8\u0ab9\u0ac0\u0a82."),(0,xe.Z)(re,"termsHead3","\u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0aa8\u0ac0 \u0a9c\u0ab5\u0abe\u0aac\u0aa6\u0abe\u0ab0\u0ac0:"),(0,xe.Z)(re,"termsText4","<p> \u0aa4\u0aae\u0abe\u0ab0\u0ac7: </p>"),(0,xe.Z)(re,"termsPoints","<li> \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0aad\u0acd\u0aaf \u0ab8\u0ac7\u0ab5\u0abe\u0aa8\u0ac7 \u0a8d\u0a95\u0acd\u0ab8\u0ac7\u0ab8 \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0aa5\u0ab5\u0abe \u0a8d\u0a95\u0acd\u0ab8\u0ac7\u0ab8 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0acb \u0aaa\u0acd\u0ab0\u0aaf\u0abe\u0ab8 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ac1\u0aa6\u0ab0\u0aa4\u0ac0 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf \u0aac\u0aa8\u0acb; </li> \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a85\u0aa8\u0acd\u0aaf \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0aa8\u0abe \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0aad\u0acd\u0aaf \u0ab8\u0ac7\u0ab5\u0abe \u0a96\u0abe\u0aa4\u0abe\u0aa8\u0ac7 \u0a8d\u0a95\u0acd\u0ab8\u0ac7\u0ab8 \u0a85\u0aa5\u0ab5\u0abe \u0ab2\u0abf\u0a82\u0a95 \u0a85\u0aa5\u0ab5\u0abe \u0a8d\u0a9