939\u0947.",aboutDesc2:"\u0928\u093e\u0917\u0930\u093f\u0915\u093e\u0902\u091a\u094d\u092f\u093e \u092a\u093e\u0924\u094d\u0930\u0924\u0947\u0935\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u092f\u094b\u091c\u0928\u0947\u091a\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0939\u093e \u090f\u0915 \u0928\u093e\u0935\u093f\u0928\u094d\u092f\u092a\u0942\u0930\u094d\u0923, \u0924\u0902\u0924\u094d\u0930\u091c\u094d\u091e\u093e\u0928-\u0906\u0927\u093e\u0930\u093f\u0924 \u0909\u092a\u093e\u092f \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u094b.",aboutDesc3:"\u0939\u093e \u092e\u0902\u091a \u0928\u093e\u0917\u0930\u093f\u0915\u093e\u0902\u0928\u093e \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u094b\u0917\u094d\u092f \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u0924 \u092e\u0926\u0924 \u0915\u0930\u0924\u094b. \u0935\u093f\u0935\u093f\u0927 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0902\u0938\u093e\u0920\u0940 \u0905\u0930\u094d\u091c \u0915\u0938\u093e \u0915\u0930\u093e\u0935\u093e \u092f\u093e\u092c\u0926\u094d\u0926\u0932\u0939\u0940 \u0939\u0947 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928 \u0915\u0930\u0924\u0947. \u0924\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0905\u0928\u0947\u0915 \u0938\u0930\u0915\u093e\u0930\u0940 \u0938\u0902\u0915\u0947\u0924\u0938\u094d\u0925\u0933\u093e\u0902\u0928\u093e \u092d\u0947\u091f \u0926\u0947\u0923\u094d\u092f\u093e\u091a\u0940 \u0917\u0930\u091c \u0928\u093e\u0939\u0940.",vision:"\u0906\u092e\u091a\u0940 \u0926\u0943\u0937\u094d\u091f\u0940",visionText:"\u0928\u093e\u0917\u0930\u093f\u0915\u093e\u0902\u091a\u0947 \u091c\u0940\u0935\u0928 \u0938\u0941\u0932\u092d \u0915\u0930\u0923\u0947 \u0939\u093e \u0906\u092e\u091a\u093e \u0926\u0943\u0937\u094d\u091f\u0940\u0915\u094b\u0928 \u0906\u0939\u0947.",mission:"\u0906\u092e\u091a\u0947 \u0927\u094d\u092f\u0947\u092f",mission1:"\u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e \u0906\u0923\u093f \u0932\u093e\u092d\u093e\u0902\u0938\u093e\u0920\u0940 \u0938\u0930\u0915\u093e\u0930-\u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e \u0938\u0902\u0935\u093e\u0926 \u0938\u0941\u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093f\u0924 \u0915\u0930\u0923\u0947 \u0939\u0947 \u0906\u092e\u091a\u0947 \u0927\u094d\u092f\u0947\u092f \u0906\u0939\u0947.",mission2:"\u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u091a\u093e \u0932\u093e\u092d \u0918\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0932\u093e\u0917\u0923\u093e\u0930\u093e \u0935\u0947\u0933 \u0906\u0923\u093f \u092e\u0947\u0939\u0928\u0924 \u0915\u092e\u0940 \u0915\u0930\u093e.",aboutPageDesc1:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0902\u091a \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0908-\u092a\u094d\u0930\u0936\u093e\u0938\u0928 \u0935\u093f\u092d\u093e\u0917\u093e\u0926\u094d\u0935\u093e\u0930\u0947 (\u090f\u0928. \u0908. \u091c\u0940. \u0921\u0940.), \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915\u094d\u0938 \u0906\u0923\u093f \u092e\u093e\u0939\u093f\u0924\u0940 \u0924\u0902\u0924\u094d\u0930\u091c\u094d\u091e\u093e\u0928 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f (\u090f\u092e. \u0908. \u0906\u092f. \u091f\u0940. \u0935\u093e\u092f.), \u092a\u094d\u0930\u0936\u093e\u0938\u0915\u0940\u092f \u0938\u0941\u0927\u093e\u0930\u0923\u093e \u0906\u0923\u093f \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0924\u0915\u094d\u0930\u093e\u0930 \u0935\u093f\u092d\u093e\u0917 (\u0921\u0940. \u090f. \u0906\u0930. \u092a\u0940. \u091c\u0940.) \u092f\u093e\u0902\u091a\u094d\u092f\u093e \u092e\u0926\u0924\u0940\u0928\u0947 \u0906\u0923\u093f \u0907\u0924\u0930 \u0915\u0947\u0902\u0926\u094d\u0930 \u0906\u0923\u093f \u0930\u093e\u091c\u094d\u092f \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f\u0947/\u0935\u093f\u092d\u093e\u0917\u093e\u0902\u091a\u094d\u092f\u093e \u092d\u093e\u0917\u0940\u0926\u093e\u0930\u0940\u0924 \u0935\u093f\u0915\u0938\u093f\u0924, \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0906\u0923\u093f \u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u0915\u0947\u0932\u093e \u091c\u093e\u0924\u094b.",eligibilityCheckHead:"\u092a\u093e\u0924\u094d\u0930\u0924\u093e \u0924\u092a\u093e\u0938\u0923\u0940",eligibilityCheckDesc:"\u0924\u0941\u092e\u094d\u0939\u0940 \u0935\u0947\u0917\u0935\u0947\u0917\u0933\u094d\u092f\u093e \u0928\u093f\u0915\u0937\u093e\u0902\u091a\u093e \u0906\u0923\u093f \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915 \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f\u093e\u0902\u091a\u093e \u0935\u093e\u092a\u0930 \u0915\u0930\u0942\u0928 \u092f\u094b\u091c\u0928\u093e\u0902\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u0940 \u092a\u093e\u0924\u094d\u0930\u0924\u093e \u0924\u092a\u093e\u0938\u0942 \u0936\u0915\u0924\u093e.",schemeFinderHead:"\u092f\u094b\u091c\u0928\u093e \u0936\u094b\u0927\u0915",schemeFinderDesc:"\u0935\u093f\u0935\u093f\u0927 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0902\u0938\u093e\u0920\u0940 \u092b\u093f\u0932\u094d\u091f\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0921\u094d\u0930\u093f\u0932 \u0921\u093e\u090a\u0928\u094d\u0938\u0938\u0939 \u091c\u0932\u0926 \u0906\u0923\u093f \u0938\u094b\u092a\u0947 \u0936\u094b\u0927",schemeInDetailHead:"\u092f\u094b\u091c\u0928\u093e \u0924\u092a\u0936\u0940\u0932\u0935\u093e\u0930",schemeInDetailDesc:"\u0924\u0941\u092e\u094d\u0939\u0940 \u0905\u0930\u094d\u091c \u0915\u0930\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u092c\u093e\u0930\u0940\u0915 \u0926\u093e\u0923\u0947\u0926\u093e\u0930 \u092f\u094b\u091c\u0928\u0947\u091a\u094d\u092f\u093e \u0924\u092a\u0936\u0940\u0932\u093e\u0902\u0938\u093e\u0920\u0940 \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u092f\u094b\u091c\u0928\u093e \u092a\u0943\u0937\u094d\u0920\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u0916\u094b\u0932\u0935\u0930 \u091c\u093e.",documentRequired:"\u0906\u0935\u0936\u094d\u092f\u0915 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947",faqHead:"\u0935\u093e\u0930\u0902\u0935\u093e\u0930 \u0935\u093f\u091a\u093e\u0930\u0932\u0947 \u091c\u093e\u0923\u093e\u0930\u0947 \u092a\u094d\u0930\u0936\u094d\u0928",faqSubHead1:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0915\u093e\u0939\u0940 \u0909\u0924\u094d\u0924\u0930\u093e\u0902\u0938\u093e\u0920\u0940 \u0906\u092e\u091a\u094d\u092f\u093e \u091c\u094d\u091e\u093e\u0928\u093e\u091a\u093e \u0906\u0927\u093e\u0930 \u092a\u0939\u093e!",ques1:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u094d\u0939\u0923\u091c\u0947 \u0915\u093e\u092f \u0906\u0923\u093f \u0924\u0940 \u0907\u0924\u0930 \u0938\u0930\u0915\u093e\u0930\u0940 \u092a\u094b\u0930\u094d\u091f\u0932\u092a\u0947\u0915\u094d\u0937\u093e \u0915\u0936\u0940 \u0935\u0947\u0917\u0933\u0940 \u0906\u0939\u0947?",ans1:"\u0915\u0947\u0902\u0926\u094d\u0930 \u0906\u0923\u093f \u0930\u093e\u091c\u094d\u092f/\u0915\u0947\u0902\u0926\u094d\u0930\u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936 \u0938\u0930\u0915\u093e\u0930\u093e\u0902\u0915\u0921\u0942\u0928 \u0935\u093f\u0935\u093f\u0927 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0902\u091a\u093e \u0932\u093e\u092d \u0918\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u0939\u093e \u090f\u0915 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u092e\u0902\u091a \u0906\u0939\u0947. \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0924\u092a\u0936\u0940\u0932\u093e\u0902\u0935\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0902\u091a\u093e \u0936\u094b\u0927 \u0906\u0923\u093f \u0936\u094b\u0927 \u0918\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0939\u093e \u090f\u0915 \u0925\u093e\u0902\u092c\u093e \u0905\u0938\u0932\u0947\u0932\u093e \u092e\u0902\u091a \u0906\u0939\u0947. \u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u0938\u0930\u0915\u093e\u0930\u0940 \u092a\u094b\u0930\u094d\u091f\u0932\u091a\u094d\u092f\u093e \u0909\u0932\u091f, \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0930\u0915\u093e\u0930, \u0930\u093e\u091c\u094d\u092f \u0938\u0930\u0915\u093e\u0930\u0947 \u0906\u0923\u093f \u0915\u0947\u0902\u0926\u094d\u0930\u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936\u093e\u0902\u091a\u094d\u092f\u093e \u092f\u094b\u091c\u0928\u093e \u090f\u0915\u093e\u091a \u0935\u094d\u092f\u093e\u0938\u092a\u0940\u0920\u093e\u0935\u0930 \u090f\u0915\u0924\u094d\u0930 \u0906\u0923\u0924\u0947 \u0906\u0923\u093f \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\u0928\u093e \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u092a\u093e\u0924\u094d\u0930\u0924\u0947\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092f\u094b\u091c\u0928\u093e \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u0924 \u092e\u0926\u0924 \u0915\u0930\u0924\u0947.",ques2:"\u092e\u093e\u091d\u0940 \u092f\u094b\u091c\u0928\u093e \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0928\u093e\u0917\u0930\u093f\u0915\u093e\u0902\u0928\u093e \u0915\u0936\u0940 \u092e\u0926\u0924 \u0915\u0930\u0947\u0932?",ans2:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0902\u091a \u0928\u093e\u0917\u0930\u093f\u0915\u093e\u0902\u0928\u093e \u090f\u0915\u093e\u091a \u0920\u093f\u0915\u093e\u0923\u0940 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092f\u094b\u091c\u0928\u093e \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u0938 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0942\u0928, \u0924\u094d\u092f\u093e\u0902\u091a\u0940 \u092a\u093e\u0924\u094d\u0930\u0924\u093e \u0924\u092a\u093e\u0938\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0928\u0947\u0915 \u0935\u093f\u092d\u093e\u0917\u0940\u092f \u0938\u0902\u0915\u0947\u0924\u0938\u094d\u0925\u0933\u093e\u0902\u0928\u093e \u092d\u0947\u091f \u0926\u0947\u0923\u094d\u092f\u093e\u091a\u0940 \u0915\u093f\u0902\u0935\u093e \u092f\u094b\u091c\u0928\u0947\u091a\u094d\u092f\u093e \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0915 \u0924\u0924\u094d\u0924\u094d\u0935\u093e\u0902\u091a\u0947 \u092a\u0941\u0928\u0930\u093e\u0935\u0932\u094b\u0915\u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0917\u0930\u091c \u0926\u0942\u0930 \u0915\u0930\u0942\u0928 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0902\u091a\u093e \u092a\u094d\u0930\u0935\u0947\u0936 \u0938\u0941\u0932\u092d \u0915\u0930\u0924\u094b.",ques3:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u0915\u0936\u0940 \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0924\u0947?",ans3:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0902\u091a, \u0928\u093e\u0917\u0930\u093f\u0915\u093e\u0902\u0928\u093e \u091c\u094d\u092f\u093e \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0902\u0938\u093e\u0920\u0940 \u0924\u0947 \u092a\u093e\u0924\u094d\u0930 \u0906\u0939\u0947\u0924 \u0924\u094d\u092f\u093e \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u0924 \u092e\u0926\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0938\u094b\u092a\u094d\u092f\u093e \u0906\u0923\u093f \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e-\u0905\u0928\u0941\u0915\u0942\u0932 \u0924\u0940\u0928-\u091a\u0930\u0923\u093e\u0902\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u0947\u091a\u0947 \u0905\u0928\u0941\u0938\u0930\u0923 \u0915\u0930\u0924\u094b\u0903 \u092a\u093e\u092f\u0930\u0940 1: \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f, \u0909\u0924\u094d\u092a\u0928\u094d\u0928, \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0936\u094d\u0930\u0947\u0923\u0940 \u0907\u0924\u094d\u092f\u093e\u0926\u0940 \u092e\u0942\u0932\u092d\u0942\u0924 \u0924\u092a\u0936\u0940\u0932 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u0924\u094b. \u092a\u093e\u092f\u0930\u0940 2: \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u092e\u093e\u0939\u093f\u0924\u0940\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930\u0947, \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0936\u0947\u0915\u0921\u094b \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0902\u092e\u0927\u0940\u0932 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092f\u094b\u091c\u0928\u093e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u0947. \u092a\u093e\u092f\u0930\u0940 3: \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e \u092a\u093e\u0924\u094d\u0930 \u092f\u094b\u091c\u0928\u093e\u0902\u091a\u094d\u092f\u093e \u092f\u093e\u0926\u0940\u092e\u0927\u0942\u0928 \u0928\u093f\u0935\u0921\u0942 \u0936\u0915\u0924\u094b \u0906\u0923\u093f \u0924\u092a\u0936\u0940\u0932\u0935\u093e\u0930 \u091c\u094d\u091e\u093e\u0928, \u0935\u093e\u0930\u0902\u0935\u093e\u0930 \u0935\u093f\u091a\u093e\u0930\u0932\u0947 \u091c\u093e\u0923\u093e\u0930\u0947 \u092a\u094d\u0930\u0936\u094d\u0928 \u0906\u0923\u093f \u0905\u0930\u094d\u091c \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u0947\u0938\u0939 \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u092f\u094b\u091c\u0928\u093e \u092a\u0943\u0937\u094d\u0920\u093e\u0935\u0930\u0942\u0928 \u0905\u0927\u093f\u0915 \u092e\u093e\u0939\u093f\u0924\u0940 \u092e\u093f\u0933\u0935\u0942 \u0936\u0915\u0924\u094b \u0906\u0923\u093f \u0905\u0930\u094d\u091c \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0905\u0930\u094d\u091c \u092f\u0942. \u0906\u0930. \u090f\u0932. \u0935\u0930 \u091c\u093e\u090a \u0936\u0915\u0924\u094b.",ques4:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0902\u091a\u093e\u0935\u0930 \u092f\u094b\u0917\u094d\u092f \u092f\u094b\u091c\u0928\u093e \u091c\u093e\u0923\u0942\u0928 \u0918\u0947\u0923\u094d\u092f\u093e\u091a\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u093e\u092f \u0906\u0939\u0947?",ans4:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0902\u091a\u093e\u0935\u0930 \u092f\u094b\u0917\u094d\u092f \u092f\u094b\u091c\u0928\u093e \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u0928\u093e\u0917\u0930\u093f\u0915 \u0935\u094d\u092f\u093e\u0938\u092a\u0940\u0920\u093e\u091a\u094d\u092f\u093e \u0905\u0927\u093f\u0915\u0943\u0924 \u0938\u0902\u0915\u0947\u0924\u0938\u094d\u0925\u0933\u093e\u0932\u093e \u092d\u0947\u091f \u0926\u0947\u090a\u0928 \u0938\u0941\u0930\u0941\u0935\u093e\u0924 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e\u0924. \u090f\u0915\u0926\u093e \u092e\u0941\u0916\u092a\u0943\u0937\u094d\u0920\u093e\u0935\u0930, \u0924\u094d\u092f\u093e\u0902\u0928\u093e '\u0924\u0941\u092e\u091a\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u094b\u091c\u0928\u093e \u0936\u094b\u0927\u093e' \u0939\u0947 \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f \u0926\u093f\u0938\u0947\u0932, \u091c\u0947 \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\u0928\u093e \u0924\u094d\u092f\u093e\u0902\u091a\u0947 \u0935\u092f, \u0932\u093f\u0902\u0917, \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u092a\u093e\u0924\u0933\u0940, \u0936\u094d\u0930\u0947\u0923\u0940 \u0907\u0924\u094d\u092f\u093e\u0926\u0940 \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0924\u092a\u0936\u0940\u0932 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0905\u0928\u0941\u092e\u0924\u0940 \u0926\u0947\u0924\u0947. \u090f\u0915\u0926\u093e \u0939\u0947 \u0924\u092a\u0936\u0940\u0932 \u0938\u093e\u0926\u0930 \u091d\u093e\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930, \u092a\u094d\u0932\u0945\u091f\u092b\u0949\u0930\u094d\u092e \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932\u0935\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092f\u094b\u091c\u0928\u093e\u0902\u091a\u0940 \u092f\u093e\u0926\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0947\u0932.",ques5:"\u090f\u0916\u093e\u0926\u094d\u092f\u093e \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092f\u094b\u091c\u0928\u0947\u091a\u0940 \u0915\u094b\u0923\u0924\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u092e\u0932\u093e \u092e\u093e\u091d\u094d\u092f\u093e \u092f\u094b\u091c\u0928\u0947\u0935\u0930 \u092e\u093f\u0933\u0942 \u0936\u0915\u0947\u0932?",ans5:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0902\u091a \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092f\u094b\u091c\u0928\u0947\u092c\u0926\u094d\u0926\u0932 \u092a\u093e\u0924\u094d\u0930\u0924\u093e \u0928\u093f\u0915\u0937, \u0926\u0947\u090a \u0915\u0947\u0932\u0947\u0932\u0947 \u0932\u093e\u092d, \u0905\u0930\u094d\u091c \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0906\u0923\u093f \u092f\u094b\u091c\u0928\u0947\u091a\u093e \u0932\u093e\u092d \u0918\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u092f\u093e\u0938\u0939 \u0938\u0930\u094d\u0935\u0938\u092e\u093e\u0935\u0947\u0936\u0915 \u092e\u093e\u0939\u093f\u0924\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u094b. \u092f\u093e \u092f\u094b\u091c\u0928\u0947\u0936\u0940 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u092a\u094d\u0930\u0936\u094d\u0928\u093e\u0902\u091a\u0940 \u0909\u0924\u094d\u0924\u0930\u0947 \u0926\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u090f\u0915 \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u0935\u093e\u0930\u0902\u0935\u093e\u0930 \u0935\u093f\u091a\u093e\u0930\u0932\u0947 \u091c\u093e\u0923\u093e\u0930\u0947 \u092a\u094d\u0930\u0936\u094d\u0928 (\u090f\u092b. \u090f. \u0915\u094d\u092f\u0942.) \u0935\u093f\u092d\u093e\u0917 \u0926\u0947\u0916\u0940\u0932 \u0906\u0939\u0947.",ques6:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e\u0935\u0930 \u0915\u094b\u0923\u0924\u094d\u092f\u093e \u0935\u094d\u092f\u093e\u092a\u0915 \u0936\u094d\u0930\u0947\u0923\u0940\u0902\u092e\u0927\u094d\u092f\u0947 \u092f\u094b\u091c\u0928\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947\u0924?",ans6:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0902\u091a\u093e\u0935\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u0905\u0938\u0932\u0947\u0932\u094d\u092f\u093e \u092f\u094b\u091c\u0928\u093e\u0902\u091a\u0947 \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0932\u093e\u092d\u093e\u0902\u091a\u0947 \u0938\u094d\u0935\u0930\u0942\u092a \u0906\u0923\u093f \u0932\u0915\u094d\u0937\u094d\u092f\u093f\u0924 \u0932\u093e\u092d\u093e\u0930\u094d\u0925\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930\u093e\u0935\u0930 15 \u0936\u094d\u0930\u0947\u0923\u0940\u0902\u092e\u0927\u094d\u092f\u0947 \u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923 \u0915\u0947\u0932\u0947 \u0906\u0939\u0947. \u092f\u093e \u0936\u094d\u0930\u0947\u0923\u0940\u0902\u092e\u0927\u094d\u092f\u0947 \u0915\u0943\u0937\u0940, \u0917\u094d\u0930\u093e\u092e\u0940\u0923 \u0906\u0923\u093f \u092a\u0930\u094d\u092f\u093e\u0935\u0930\u0923; \u092c\u0901\u0915\u093f\u0902\u0917, \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0938\u0947\u0935\u093e \u0906\u0923\u093f \u0935\u093f\u092e\u093e; \u0935\u094d\u092f\u0935\u0938\u093e\u092f \u0906\u0923\u093f \u0909\u0926\u094d\u092f\u094b\u091c\u0915\u0924\u093e; \u0936\u093f\u0915\u094d\u0937\u0923 \u0906\u0923\u093f \u0936\u093f\u0915\u094d\u0937\u0923; \u0906\u0930\u094b\u0917\u094d\u092f \u0906\u0923\u093f \u0915\u0932\u094d\u092f\u093e\u0923; \u0917\u0943\u0939\u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0906\u0923\u093f \u0928\u093f\u0935\u093e\u0930\u093e; \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e, \u0915\u093e\u092f\u0926\u093e \u0906\u0923\u093f \u0928\u094d\u092f\u093e\u092f; \u0935\u093f\u091c\u094d\u091e\u093e\u0928, \u092e\u093e\u0939\u093f\u0924\u0940 \u0924\u0902\u0924\u094d\u0930\u091c\u094d\u091e\u093e\u0928 \u0906\u0923\u093f \u0926\u0933\u0923\u0935\u0933\u0923; \u0915\u094c\u0936\u0932\u094d\u092f \u0906\u0923\u093f \u0930\u094b\u091c\u0917\u093e\u0930; \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0915\u0932\u094d\u092f\u093e\u0923 \u0906\u0923\u093f \u0938\u0915\u094d\u0937\u092e\u0940\u0915\u0930\u0923; \u0915\u094d\u0930\u0940\u0921\u093e \u0906\u0923\u093f \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u0940; \u0935\u093e\u0939\u0924\u0942\u0915 \u0906\u0923\u093f \u092a\u093e\u092f\u093e\u092d\u0942\u0924 \u0938\u0941\u0935\u093f\u0927\u093e; \u092a\u094d\u0930\u0935\u093e\u0938 \u0906\u0923\u093f \u092a\u0930\u094d\u092f\u091f\u0928; \u0909\u092a\u092f\u0941\u0915\u094d\u0924\u0924\u093e \u0906\u0923\u093f \u0938\u094d\u0935\u091a\u094d\u091b\u0924\u093e; \u0906\u0923\u093f \u092e\u0939\u093f\u0932\u093e \u0906\u0923\u093f \u092c\u093e\u0932 \u092f\u093e\u0902\u091a\u093e \u0938\u092e\u093e\u0935\u0947\u0936 \u0906\u0939\u0947.",ques7:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0902\u091a \u092c\u0939\u0941\u092d\u093e\u0937\u093f\u0915 \u0938\u092e\u0930\u094d\u0925\u0928 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u094b \u0915\u093e?",ans7:"\u0939\u094b\u092f, \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0902\u091a \u0938\u0927\u094d\u092f\u093e \u0907\u0902\u0917\u094d\u0930\u091c\u0940\u0938\u0939 15 \u092d\u093e\u0937\u093e\u0902\u092e\u0927\u0940\u0932 \u092e\u091c\u0915\u0941\u0930\u093e\u0932\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0926\u0947\u0924\u094b. \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u092d\u093e\u0930\u0924\u0940\u092f \u092d\u093e\u0937\u093e\u0902\u0928\u093e \u0932\u0935\u0915\u0930\u091a \u092a\u093e\u0920\u092c\u0933 \u0926\u093f\u0932\u0947 \u091c\u093e\u0908\u0932.",ques8:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0902\u091a \u0915\u0947\u0902\u0926\u094d\u0930 \u0906\u0923\u093f \u0930\u093e\u091c\u094d\u092f/\u0915\u0947\u0902\u0926\u094d\u0930\u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936 \u092f\u093e \u0926\u094b\u0928\u094d\u0939\u0940 \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092f\u094b\u091c\u0928\u093e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u094b \u0915\u093e?",ans8:"\u0939\u094b\u092f, \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0902\u091a \u0938\u0927\u094d\u092f\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0930\u0915\u093e\u0930 \u0906\u0923\u093f \u0930\u093e\u091c\u094d\u092f/\u0915\u0947\u0902\u0926\u094d\u0930\u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936 \u0938\u0930\u0915\u093e\u0930\u091a\u094d\u092f\u093e 4,700 \u0939\u0942\u0928 \u0905\u0927\u093f\u0915 \u092f\u094b\u091c\u0928\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u092a\u094d\u0930\u0935\u0947\u0936 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u094b. \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u092f\u094b\u091c\u0928\u093e \u0938\u0924\u0924 \u092f\u093e \u092e\u0902\u091a\u093e\u0935\u0930 \u0938\u092e\u093e\u0935\u093f\u0937\u094d\u091f \u0915\u0947\u0932\u094d\u092f\u093e \u091c\u093e\u0924\u0940\u0932.",ques9:"\u092e\u0932\u093e \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0945\u091f\u092b\u0949\u0930\u094d\u092e\u0935\u0930 \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092f\u094b\u091c\u0928\u093e \u0938\u093e\u092a\u0921\u0932\u0940 \u0928\u093e\u0939\u0940. \u092e\u0940 \u0915\u093e\u092f \u0915\u0930\u093e\u0935\u0947?",ans9:"\u0938\u0927\u094d\u092f\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0930\u0915\u093e\u0930 \u0906\u0923\u093f \u0930\u093e\u091c\u094d\u092f/\u0915\u0947\u0902\u0926\u094d\u0930\u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936 \u0938\u0930\u0915\u093e\u0930\u091a\u094d\u092f\u093e 4,700 \u0939\u0942\u0928 \u0905\u0927\u093f\u0915 \u092f\u094b\u091c\u0928\u093e \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0902\u091a\u093e\u0935\u0930 \u0938\u092e\u093e\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u094d\u092f\u093e \u0906\u0939\u0947\u0924. \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u092f\u094b\u091c\u0928\u093e \u0928\u093f\u092f\u092e\u093f\u0924\u092a\u0923\u0947 \u091c\u094b\u0921\u0932\u094d\u092f\u093e \u091c\u093e\u0924 \u0906\u0939\u0947\u0924. \u0935\u094d\u092f\u093e\u0938\u092a\u0940\u0920\u093e\u0935\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u0905\u0938\u0932\u0947\u0932\u094d\u092f\u093e '\u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e' \u0935\u093f\u092d\u093e\u0917\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u0928\u093e\u0917\u0930\u093f\u0915 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0939\u0930\u0935\u0932\u0947\u0932\u094d\u092f\u093e \u092f\u094b\u091c\u0928\u0947\u092c\u093e\u092c\u0924 \u0924\u092a\u0936\u0940\u0932 \u0915\u093f\u0902\u0935\u093e \u0938\u0942\u091a\u0928\u093e \u0938\u093e\u092e\u093e\u092f\u093f\u0915 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e\u0924.",ques10:"\u092e\u0930\u093e\u0920\u0940 \u092d\u093e\u0937\u0947\u0924\u0940\u0932 \u092f\u094b\u091c\u0928\u093e\u0902\u091a\u094d\u092f\u093e \u092e\u091c\u0915\u0941\u0930\u093e\u0924 \u092e\u0932\u093e \u0915\u093e\u0939\u0940 \u0924\u094d\u0930\u0941\u091f\u0940 \u0906\u0922\u0933\u0932\u094d\u092f\u093e. \u092e\u0940 \u0915\u093e\u092f \u0915\u0930\u093e\u0935\u0947?",ans10:"\u092f\u094b\u091c\u0928\u0947\u091a\u094d\u092f\u093e \u092e\u091c\u0915\u0941\u0930\u093e\u091a\u094d\u092f\u093e \u092e\u0930\u093e\u0920\u0940 \u0906\u0935\u0943\u0924\u094d\u0924\u0940\u092e\u0927\u094d\u092f\u0947 \u0915\u093e\u0939\u0940 \u0935\u093f\u0938\u0902\u0917\u0924\u0940 \u0906\u0922\u0933\u0932\u094d\u092f\u093e\u0938, \u0928\u093e\u0917\u0930\u093f\u0915\u093e\u0902\u0928\u093e \u0938\u094d\u092a\u0937\u094d\u091f\u0940\u0915\u0930\u0923\u093e\u0938\u093e\u0920\u0940 \u0907\u0902\u0917\u094d\u0930\u091c\u0940 \u0906\u0935\u0943\u0924\u094d\u0924\u0940\u091a\u093e \u0938\u0902\u0926\u0930\u094d\u092d \u0918\u0947\u0923\u094d\u092f\u093e\u091a\u093e \u0938\u0932\u094d\u0932\u093e \u0926\u093f\u0932\u093e \u091c\u093e\u0924\u094b. \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u093e\u092f\u092e \u0930\u093e\u0939\u093f\u0932\u094d\u092f\u093e\u0938, \u0938\u0930\u094d\u0935\u093e\u0924 \u0905\u091a\u0942\u0915 \u0906\u0923\u093f \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u092e\u093e\u0939\u093f\u0924\u0940\u0938\u093e\u0920\u0940 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f\u093e\u091a\u094d\u092f\u093e \u0915\u093f\u0902\u0935\u093e \u0935\u093f\u092d\u093e\u0917\u093e\u091a\u094d\u092f\u093e \u0905\u0927\u093f\u0915\u0943\u0924 \u092a\u094b\u0930\u094d\u091f\u0932\u091a\u093e \u0938\u0902\u0926\u0930\u094d\u092d \u0918\u0947\u0924\u0932\u093e \u091c\u093e\u090a \u0936\u0915\u0924\u094b. \u092f\u093e\u0935\u094d\u092f\u0924\u093f\u0930\u093f\u0915\u094d\u0924, support-myscheme[at]digitalindia[dot]gov[dot]in \u0935\u0930 \u0908\u092e\u0947\u0932 \u092a\u093e\u0920\u0935\u0942\u0928 \u0938\u092e\u0938\u094d\u092f\u0947\u091a\u0940 \u0924\u0915\u094d\u0930\u093e\u0930 \u0915\u0947\u0932\u0940 \u091c\u093e\u090a \u0936\u0915\u0924\u0947.",ques11:"\u091c\u094d\u092f\u093e \u092f\u094b\u091c\u0928\u093e\u0902\u0924\u0930\u094d\u0917\u0924 \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u094d\u092f\u093e\u0902\u0928\u093e \u0936\u093f\u0937\u094d\u092f\u0935\u0943\u0924\u094d\u0924\u0940 \u0926\u093f\u0932\u0940 \u091c\u093e\u0924\u0947 \u0924\u094d\u092f\u093e \u092f\u094b\u091c\u0928\u093e \u092e\u0932\u093e \u0936\u094b\u0927\u093e\u092f\u091a\u094d\u092f\u093e \u0906\u0939\u0947\u0924. \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e\u091a\u094d\u092f\u093e \u092e\u093e\u0927\u094d\u092f\u092e\u093e\u0924\u0942\u0928 \u0939\u0947 \u0936\u0915\u094d\u092f \u0906\u0939\u0947 \u0915\u093e?",ans11:"\u0939\u094b\u092f, \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0902\u091a \u090f\u0915 \u092e\u0941\u0916\u094d\u092f \u0936\u092c\u094d\u0926-\u0906\u0927\u093e\u0930\u093f\u0924 \u0936\u094b\u0927 \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u094b \u091c\u0947 \u0928\u093e\u0917\u0930\u093f\u0915\u093e\u0902\u0928\u093e \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u094d\u092f\u093e\u0902\u0928\u093e \u0936\u093f\u0937\u094d\u092f\u0935\u0943\u0924\u094d\u0924\u0940\u0938\u0939 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0932\u093e\u092d\u093e\u0902\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u0915\u093e\u0930 \u0906\u0923\u093f \u0935\u094d\u092f\u093e\u092a\u094d\u0924\u0940\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930\u0947 \u092f\u094b\u091c\u0928\u093e \u0938\u0939\u091c\u092a\u0923\u0947 \u0936\u094b\u0927\u0923\u0947, \u0936\u094b\u0927\u0923\u0947 \u0906\u0923\u093f \u0913\u0933\u0916\u0923\u0947 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u0947.",ques12:"\u092e\u0932\u093e \u090f\u0915\u093e \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092f\u094b\u091c\u0928\u0947\u0938\u093e\u0920\u0940 \u0905\u0930\u094d\u091c \u0915\u0930\u093e\u092f\u091a\u093e \u0906\u0939\u0947 \u0906\u0923\u093f \u0905\u0930\u094d\u091c\u093e\u0938\u093e\u0920\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u091c\u093e\u0923\u0942\u0928 \u0918\u094d\u092f\u093e\u092f\u091a\u0940 \u0906\u0939\u0947\u0924. \u092e\u0932\u093e \u0939\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u092e\u093e\u091d\u094d\u092f\u093e \u092f\u094b\u091c\u0928\u0947\u0935\u0930 \u092e\u093f\u0933\u0942 \u0936\u0915\u0947\u0932 \u0915\u093e?",ans12:"\u0939\u094b\u092f, \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0902\u091a \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092f\u094b\u091c\u0928\u0947\u0938\u093e\u0920\u0940 \u0905\u0930\u094d\u091c \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0905\u0938\u0932\u0947\u0932\u094d\u092f\u093e \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u093e\u0902\u091a\u0940 \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u092f\u093e\u0926\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u094b, \u091c\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0928\u093e\u0917\u0930\u093f\u0915 \u0938\u0939\u091c\u092a\u0923\u0947 \u0924\u092f\u093e\u0930\u0940 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e\u0924 \u0906\u0923\u093f \u0905\u0930\u094d\u091c \u0915\u0930\u0942 \u0936\u0915\u0924\u093e\u0924.",ques13:"\u092e\u0940 \u092e\u093e\u091d\u094d\u092f\u093e \u092f\u094b\u091c\u0928\u0947\u091a\u094d\u092f\u093e \u092e\u093e\u0927\u094d\u092f\u092e\u093e\u0924\u0942\u0928 \u092f\u094b\u091c\u0928\u093e\u0902\u0938\u093e\u0920\u0940 \u0905\u0930\u094d\u091c \u0915\u0930\u0942 \u0936\u0915\u0924\u094b \u0915\u093e?",ans13:"\u0938\u0927\u094d\u092f\u093e, \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0902\u091a \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\u0928\u093e \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0915\u093f\u0902\u0935\u093e \u0935\u093f\u092d\u093e\u0917\u093e\u091a\u094d\u092f\u093e \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092f\u094b\u091c\u0928\u0947\u091a\u094d\u092f\u093e \u0905\u0930\u094d\u091c \u092a\u0943\u0937\u094d\u0920\u093e\u0935\u0930 \u092a\u0941\u0928\u0930\u094d\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0915\u0930\u0924\u094b. \u0906\u0917\u093e\u092e\u0940 \u091f\u092a\u094d\u092a\u094d\u092f\u093e\u0924, \u0928\u093e\u0917\u0930\u093f\u0915 \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094b\u0930\u094d\u091f\u0932/\u0909\u092e\u0902\u0917 \u090d\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928\u0926\u094d\u0935\u093e\u0930\u0947 \u092f\u094b\u091c\u0928\u093e\u0902\u0938\u093e\u0920\u0940 \u0905\u0930\u094d\u091c \u0915\u0930\u0942 \u0936\u0915\u0924\u0940\u0932 \u0905\u0936\u0940 \u0915\u0932\u094d\u092a\u0928\u093e \u0906\u0939\u0947.",ques14:"\u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0938\u0930\u094d\u0935\u093e\u0924 \u092f\u094b\u0917\u094d\u092f \u092f\u094b\u091c\u0928\u093e \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e\u091a\u094d\u092f\u093e '\u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915\u0943\u0924 \u0936\u094b\u0927' \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f\u093e\u0924 \u0915\u094b\u0923\u0924\u0947 \u0924\u092a\u0936\u0940\u0932 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0923\u0947 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947?",ans14:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e\u091a\u0947 '\u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915\u0943\u0924 \u0936\u094b\u0927' \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f \u0935\u093e\u092a\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\u0928\u0940 \u0932\u093f\u0902\u0917, \u0935\u092f, \u0935\u0948\u0935\u093e\u0939\u093f\u0915 \u0938\u094d\u0925\u093f\u0924\u0940, \u0930\u093e\u091c\u094d\u092f, \u0930\u093e\u0939\u0923\u094d\u092f\u093e\u091a\u0947 \u0920\u093f\u0915\u093e\u0923 (\u0936\u0939\u0930\u0940 \u0915\u093f\u0902\u0935\u093e \u0917\u094d\u0930\u093e\u092e\u0940\u0923), \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0936\u094d\u0930\u0947\u0923\u0940, \u0905\u092a\u0902\u0917\u0924\u094d\u0935 \u0938\u094d\u0925\u093f\u0924\u0940, \u0905\u0932\u094d\u092a\u0938\u0902\u0916\u094d\u092f\u093e\u0915 \u0938\u094d\u0925\u093f\u0924\u0940, \u0930\u094b\u091c\u0917\u093e\u0930\u093e\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u0906\u0923\u093f \u0907\u0924\u0930 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092e\u093e\u0939\u093f\u0924\u0940 \u092f\u093e\u0938\u093e\u0930\u0916\u0947 \u092e\u0942\u0932\u092d\u0942\u0924 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0924\u092a\u0936\u0940\u0932 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0923\u0947 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947. \u0939\u0947 \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932\u0936\u0940 \u0938\u0930\u094d\u0935\u093e\u0924 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092f\u094b\u091c\u0928\u093e \u0913\u0933\u0916\u0923\u094d\u092f\u093e\u0938 \u092e\u0926\u0924 \u0915\u0930\u0924\u0947.",ques15:"'\u092a\u093e\u0924\u094d\u0930\u0924\u093e \u092a\u094d\u0930\u0936\u094d\u0928\u093e\u0935\u0932\u0940 \u0924\u092a\u093e\u0938\u093e' \u0939\u0947 \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f \u0915\u093e\u092f \u0906\u0939\u0947?",ans15:"'\u092a\u093e\u0924\u094d\u0930\u0924\u093e \u092a\u094d\u0930\u0936\u094d\u0928\u093e\u0935\u0932\u0940 \u0924\u092a\u093e\u0938\u093e' \u0939\u0947 \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f \u092f\u094b\u091c\u0928\u093e-\u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092a\u093e\u0924\u094d\u0930\u0924\u093e \u0928\u093f\u0915\u0937\u093e\u0902\u0935\u0930 \u0932\u0915\u094d\u0937 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0915\u0930\u0924\u0947 \u0906\u0923\u093f \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\u0928\u093e \u0938\u094b\u092a\u094d\u092f\u093e \u0939\u094b\u092f/\u0928\u093e\u0939\u0940-\u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u094d\u0930\u0936\u094d\u0928\u093e\u0935\u0932\u0940\u0926\u094d\u0935\u093e\u0930\u0947 \u0924\u094d\u092f\u093e\u0902\u091a\u0940 \u092a\u093e\u0924\u094d\u0930\u0924\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u0947. \u0926\u093f\u0932\u0947\u0932\u094d\u092f\u093e \u092a\u094d\u0930\u0924\u093f\u0938\u093e\u0926\u093e\u0902\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930\u0947, \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u0947 \u090f\u0916\u093e\u0926\u094d\u092f\u093e \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092f\u094b\u091c\u0928\u0947\u0938\u093e\u0920\u0940 \u092a\u093e\u0924\u094d\u0930 \u0906\u0939\u0947\u0924 \u0915\u0940 \u0928\u093e\u0939\u0940 \u092f\u093e\u091a\u0947 \u0924\u094d\u0935\u0930\u093f\u0924 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e\u0924.",ques16:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e\u092e\u0927\u094d\u092f\u0947 \u091a\u0945\u091f\u092c\u0949\u091f\u091a\u0940 \u0938\u0941\u0935\u093f\u0927\u093e \u0906\u0939\u0947 \u0915\u093e \u0906\u0923\u093f \u0924\u0940 \u0928\u093e\u0917\u0930\u093f\u0915\u093e\u0902\u0928\u093e \u0915\u0936\u0940 \u092e\u0926\u0924 \u0915\u0930\u0924\u0947?",ans16:"\u0939\u094b\u092f, \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e\u0928\u0947 \u0928\u093e\u0917\u0930\u093f\u0915\u093e\u0902\u0928\u093e \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u0924 \u092e\u0926\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0935\u093e\u091c-\u0938\u0915\u094d\u0937\u092e, \u092c\u0939\u0941\u092d\u093e\u0937\u093f\u0915 \u090f\u0906\u092f-\u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u091a\u0945\u091f\u092c\u0949\u091f \u0924\u0948\u0928\u093e\u0924 \u0915\u0947\u0932\u093e \u0906\u0939\u0947. \u091a\u0945\u091f\u092c\u0949\u091f \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u0936\u094d\u0928\u093e\u0902\u0928\u093e \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915\u0943\u0924 \u0906\u0923\u093f \u0924\u094d\u0935\u0930\u093f\u0924 \u092a\u094d\u0930\u0924\u093f\u0938\u093e\u0926 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u094b, \u0938\u0902\u0935\u093e\u0926\u093e\u0924\u094d\u092e\u0915 \u0938\u0939\u093e\u092f\u094d\u092f\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u092f\u094b\u091c\u0928\u0947\u091a\u093e \u0936\u094b\u0927 \u0938\u0941\u0932\u092d \u0915\u0930\u0924\u094b \u0906\u0923\u093f \u090f\u0915 \u0906\u0915\u0930\u094d\u0937\u0915 \u0906\u0923\u093f \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e-\u0905\u0928\u0941\u0915\u0942\u0932 \u0905\u0928\u0941\u092d\u0935 \u0926\u0947\u090a\u0928 \u0938\u0930\u0915\u093e\u0930-\u0928\u093e\u0917\u0930\u093f\u0915 \u0938\u0902\u0935\u093e\u0926 \u0935\u093e\u0922\u0935\u0924\u094b.",ques17:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e\u0935\u0930\u0940\u0932 \u090f. \u0906\u092f. \u091a\u0945\u091f\u092c\u0949\u091f\u091a\u0940 \u092a\u094d\u0930\u092e\u0941\u0916 \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f\u0947 \u0915\u094b\u0923\u0924\u0940 \u0906\u0939\u0947\u0924?",ans17:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u090f. \u0906\u092f. \u091a\u0945\u091f\u092c\u0949\u091f \u0906\u0935\u093e\u091c \u0906\u0923\u093f \u092e\u091c\u0915\u0942\u0930-\u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u0902\u0935\u093e\u0926, \u0939\u093f\u0902\u0926\u0940 \u0906\u0923\u093f \u0907\u0902\u0917\u094d\u0930\u091c\u0940\u092e\u0927\u094d\u092f\u0947 \u0926\u094d\u0935\u093f\u092d\u093e\u0937\u093f\u0915 \u0938\u092e\u0930\u094d\u0925\u0928, \u0938\u0902\u0926\u0930\u094d\u092d-\u091c\u093e\u0917\u0930\u0942\u0915 \u0938\u0902\u092d\u093e\u0937\u0923\u0947, \u0938\u0924\u094d\u0930-\u0906\u0927\u093e\u0930\u093f\u0924 \u091a\u0945\u091f \u0907\u0924\u093f\u0939\u093e\u0938 \u0906\u0923\u093f \u092a\u094d\u0930\u0924\u093f\u0938\u093e\u0926\u093e\u0902\u091a\u0940 \u0928\u0915\u094d\u0915\u0932 \u0906\u0923\u093f \u0938\u093e\u092e\u093e\u092f\u093f\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0947 \u092a\u0930\u094d\u092f\u093e\u092f \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0947, \u091c\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0905\u0916\u0902\u0921 \u0906\u0923\u093f \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e-\u0905\u0928\u0941\u0915\u0942\u0932 \u0905\u0928\u0941\u092d\u0935 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0939\u094b\u0924\u094b.",ques18:"\u092f\u094b\u091c\u0928\u093e\u0902\u091a\u094d\u092f\u093e \u092e\u091c\u0915\u0941\u0930\u093e\u092c\u093e\u092c\u0924 \u092e\u0940 \u092e\u093e\u091d\u093e \u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f \u0915\u0938\u093e \u0926\u0947\u090a \u0936\u0915\u0924\u094b?",ans18:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0902\u091a \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092f\u094b\u091c\u0928\u093e \u092a\u0943\u0937\u094d\u0920\u093e\u091a\u094d\u092f\u093e \u0924\u0933\u093e\u0936\u0940 '\u0939\u0947 \u0909\u092a\u092f\u0941\u0915\u094d\u0924 \u0939\u094b\u0924\u0947 \u0915\u093e?' \u0905\u0938\u093e \u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f \u0935\u093f\u092d\u093e\u0917 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u094b, \u091c\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\u0928\u093e 1 \u0924\u0947 5 \u0924\u093e\u0930\u0915\u093e\u0902\u092a\u0930\u094d\u092f\u0902\u0924 \u0938\u093e\u092e\u0917\u094d\u0930\u0940\u091a\u0947 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0915\u0930\u0924\u093e \u092f\u0947\u0924\u0947 \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0902\u091a\u0947 \u0905\u0928\u0941\u092d\u0935, \u0938\u0942\u091a\u0928\u093e \u0915\u093f\u0902\u0935\u093e \u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f \u0938\u093e\u092e\u093e\u092f\u093f\u0915 \u0915\u0930\u0924\u093e \u092f\u0947\u0924\u094b. \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u0947 support-myscheme@digitalindia.gov.in \u0935\u0930 \u0908\u092e\u0947\u0932\u0926\u094d\u0935\u093e\u0930\u0947 \u0924\u092a\u0936\u0940\u0932\u0935\u093e\u0930 \u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f \u0926\u0947\u0916\u0940\u0932 \u092a\u093e\u0920\u0935\u0942 \u0936\u0915\u0924\u093e\u0924, \u091c\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0935\u094d\u092f\u093e\u0938\u092a\u0940\u0920\u093e\u091a\u0940 \u0938\u0924\u0924 \u0938\u0941\u0927\u093e\u0930\u0923\u093e \u0906\u0923\u093f \u092a\u094d\u0930\u0924\u093f\u0938\u093e\u0926\u093e\u0924\u094d\u092e\u0915\u0924\u093e \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u092e\u0926\u0924 \u0939\u094b\u0924\u0947.",ques19:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e\u0935\u0930 \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e \u0928\u094b\u0902\u0926\u0923\u0940 \u0915\u0936\u0940 \u0915\u0930\u0942 \u0936\u0915\u0924\u094b \u0915\u093f\u0902\u0935\u093e \u092a\u094d\u0930\u0935\u0947\u0936 \u0915\u0938\u093e \u0915\u0930\u0942 \u0936\u0915\u0924\u094b?",ans19:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0947\u0930\u0940\u092a\u0947\u0939\u091a\u093e\u0928 (\u0928\u0945\u0936\u0928\u0932 \u0938\u093f\u0902\u0917\u0932 \u0938\u093e\u0907\u0928-\u0911\u0928) \u0938\u0939 \u0938\u092e\u093e\u0915\u0932\u093f\u0924 \u0906\u0939\u0947, \u091c\u0947 \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\u0928\u093e \u0924\u094d\u092f\u093e\u0902\u091a\u0940 \u092e\u0947\u0930\u0940\u092a\u0947\u0939\u091a\u093e\u0928 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930\u0947 \u0935\u093e\u092a\u0930\u0942\u0928 \u0938\u093e\u0907\u0928 \u0905\u092a \u0915\u093f\u0902\u0935\u093e \u0938\u093e\u0907\u0928 \u0907\u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u0947. \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u0947 \u0938\u093e\u0907\u0928 \u0907\u0928 \u0928 \u0915\u0930\u0924\u093e \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e \u092c\u094d\u0930\u093e\u0909\u091d \u0906\u0923\u093f \u0936\u094b\u0927\u0942 \u0936\u0915\u0924\u093e\u0924. \u0924\u0925\u093e\u092a\u093f, \u0938\u093e\u0907\u0928 \u0907\u0928 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0947 \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u0947 \u0924\u094d\u092f\u093e\u0902\u091a\u0947 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u091c\u0924\u0928 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e\u0924, \u092f\u094b\u091c\u0928\u093e \u092c\u0941\u0915\u092e\u093e\u0930\u094d\u0915 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e\u0924 \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u091c\u0924\u0928 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0924\u092a\u0936\u0940\u0932\u093e\u0902\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930\u0947 \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915\u0943\u0924 \u0936\u093f\u092b\u093e\u0930\u0938\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e\u0924.",ques20:"\u092e\u0940 \u092e\u093e\u091d\u094d\u092f\u093e \u092f\u094b\u091c\u0928\u093e \u092e\u0902\u091a\u093e\u0935\u0930 \u092f\u094b\u091c\u0928\u093e \u0915\u0936\u0940 \u0936\u094b\u0927\u0942 \u0936\u0915\u0924\u094b?",ans20:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092e\u0902\u091a \u092f\u094b\u091c\u0928\u093e\u0902\u091a\u093e \u0936\u094b\u0927 \u0918\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0923\u093f \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0928\u0947\u0915 \u092e\u093e\u0930\u094d\u0917 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u094b, \u091c\u094d\u092f\u093e\u0924 \u092f\u094b\u091c\u0928\u0947\u091a\u0947 \u0928\u093e\u0935 \u0915\u093f\u0902\u0935\u093e \u092e\u0941\u0916\u094d\u092f \u0936\u092c\u094d\u0926\u093e\u0902\u0928\u0941\u0938\u093e\u0930 \u0936\u094b\u0927 \u0918\u0947\u0923\u0947, \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915 \u0936\u093f\u092b\u093e\u0930\u0938\u0940 \u0915\u0930\u0923\u0947, \u0930\u093e\u091c\u094d\u092f/\u0915\u0947\u0902\u0926\u094d\u0930\u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936 \u0915\u093f\u0902\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0930\u0915\u093e\u0930\u091a\u094d\u092f\u093e \u092f\u094b\u091c\u0928\u093e\u0902\u0926\u094d\u0935\u093e\u0930\u0947 \u091b\u093e\u0928\u0928\u0940 \u0915\u0930\u0923\u0947, \u092f\u094b\u091c\u0928\u093e \u0932\u093e\u092d \u0936\u094d\u0930\u0947\u0923\u0940\u0902\u0928\u0941\u0938\u093e\u0930 \u092c\u094d\u0930\u093e\u0909\u091d\u093f\u0902\u0917 \u0915\u0930\u0923\u0947 \u0906\u0923\u093f \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u093f\u0924 \u092e\u0926\u0924\u0940\u0938\u093e\u0920\u0940 \u090f. \u0906\u092f.-\u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u091a\u0945\u091f\u092c\u0949\u091f\u091a\u093e \u0935\u093e\u092a\u0930 \u0915\u0930\u0923\u0947 \u092f\u093e\u0902\u091a\u093e \u0938\u092e\u093e\u0935\u0947\u0936 \u0906\u0939\u0947.",viewMore:"\u0905\u0927\u093f\u0915 \u092a\u0939\u093e",yourNameLabel:"\u0924\u0941\u092e\u091a\u0947 \u0928\u093e\u0935."},(0,xe.Z)(oe,"contactUs","\u0906\u092e\u091a\u094d\u092f\u093e\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e"),(0,xe.Z)(oe,"emailLabel","\u0908\u092e\u0947\u0932"),(0,xe.Z)(oe,"phon