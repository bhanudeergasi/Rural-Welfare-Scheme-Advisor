92c\u093e\u092c\u0926\u093e\u0930 \u0930\u093e\u0939\u0923\u093e\u0930 \u0928\u093e\u0939\u0940, \u091c\u094d\u092f\u093e\u0924, \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u092e\u0930\u094d\u092f\u093e\u0926\u0947\u0936\u093f\u0935\u093e\u092f, \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u0926\u094b\u0937, \u0935\u093f\u0937\u093e\u0923\u0942, \u0924\u094d\u0930\u0941\u091f\u0940, \u0935\u0917\u0933\u0923\u0947, \u0935\u094d\u092f\u0924\u094d\u092f\u092f \u0915\u093f\u0902\u0935\u093e \u0935\u093f\u0932\u0902\u092c, \u0924\u094d\u092f\u093e \u0938\u0902\u0926\u0930\u094d\u092d\u093e\u0924, \u0905\u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u0915\u093f\u0902\u0935\u093e \u0926\u0942\u0930\u0938\u094d\u0925. \u0935\u094d\u092f\u093e\u0938\u092a\u0940\u0920\u093e\u091a\u093e \u0935\u093e\u092a\u0930 \u0939\u093e \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u091a\u093e \u090f\u0915\u092e\u0947\u0935 \u0927\u094b\u0915\u093e \u0906\u0939\u0947. \u090f\u092e. \u0908. \u0906\u092f. \u091f\u0940. \u0906\u0923\u093f \u090f\u0928. \u0908. \u091c\u0940. \u0921\u0940. \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0935\u0930\u094d\u0924\u0928\u093e\u0938\u093e\u0920\u0940 \u091c\u092c\u093e\u092c\u0926\u093e\u0930 \u0928\u093e\u0939\u0940\u0924 \u0939\u0947 \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e \u0935\u093f\u0936\u0947\u0937\u0924\u0903 \u0915\u092c\u0942\u0932 \u0915\u0930\u0924\u094b \u0906\u0923\u093f \u092e\u093e\u0928\u094d\u092f \u0915\u0930\u0924\u094b. \u092f\u093e \u092e\u0902\u091a\u093e\u0935\u0930 \u0938\u092e\u093e\u0935\u093f\u0937\u094d\u091f \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0907\u0924\u0930 \u0938\u0902\u0915\u0947\u0924\u0938\u094d\u0925\u0933\u093e\u0902\u091a\u0947 \u0926\u0941\u0935\u0947 \u0915\u0947\u0935\u0933 \u0932\u094b\u0915\u093e\u0902\u091a\u094d\u092f\u093e \u0938\u094b\u092f\u0940\u0938\u093e\u0920\u0940 \u0926\u093f\u0932\u0947 \u091c\u093e\u0924\u093e\u0924. \u0924\u0925\u093e\u092a\u093f, \u090f\u092e. \u0908. \u0906\u092f. \u091f\u0940. \u0915\u093f\u0902\u0935\u093e \u090f\u0928. \u0908. \u091c\u0940. \u0921\u0940. \u0932\u093f\u0902\u0915 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0938\u0902\u0915\u0947\u0924\u0938\u094d\u0925\u0933\u093e\u0902\u091a\u094d\u092f\u093e \u0938\u093e\u092e\u0917\u094d\u0930\u0940\u0938\u093e\u0920\u0940 \u0915\u093f\u0902\u0935\u093e \u0935\u093f\u0936\u094d\u0935\u093e\u0938\u093e\u0930\u094d\u0939\u0924\u0947\u0938\u093e\u0920\u0940 \u091c\u092c\u093e\u092c\u0926\u093e\u0930 \u0928\u093e\u0939\u0940 \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0924 \u0935\u094d\u092f\u0915\u094d\u0924 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u092e\u0924\u093e\u0902\u0928\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0926\u0947\u0924 \u0928\u093e\u0939\u0940. \u090f\u092e. \u0908. \u0906\u092f. \u091f\u0940. \u0915\u093f\u0902\u0935\u093e \u090f\u0928. \u0908. \u091c\u0940. \u0921\u0940. \u0928\u0947\u0939\u092e\u0940\u091a \u0905\u0936\u093e \u091c\u094b\u0921\u0932\u094d\u092f\u093e \u0917\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u092a\u0943\u0937\u094d\u0920\u093e\u0902\u091a\u094d\u092f\u093e \u0909\u092a\u0932\u092c\u094d\u0927\u0924\u0947\u091a\u0940 \u0939\u092e\u0940 \u0926\u0947\u0924 \u0928\u093e\u0939\u0940. \u092f\u093e \u0905\u091f\u0940 \u0906\u0923\u093f \u0936\u0930\u094d\u0924\u0940\u0902\u092e\u0941\u0933\u0947 \u0909\u0926\u094d\u092d\u0935\u0923\u093e\u0930\u0947 \u0915\u094b\u0923\u0924\u0947\u0939\u0940 \u0935\u093f\u0935\u093e\u0926 \u092d\u093e\u0930\u0924\u093e\u091a\u094d\u092f\u093e \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0935\u093f\u0936\u0947\u0937 \u0905\u0927\u093f\u0915\u093e\u0930\u0915\u094d\u0937\u0947\u0924\u094d\u0930\u093e\u091a\u094d\u092f\u093e \u0905\