0932\u092d \u0939\u0948\u0964 \u0907\u0938\u0947 \u0905\u092a\u0928\u0947 \u0906\u0917\u0902\u0924\u0941\u0915\u094b\u0902 \u0915\u094b \u0905\u0927\u093f\u0915\u0924\u092e \u092a\u0939\u0941\u0902\u091a \u0914\u0930 \u0909\u092a\u092f\u094b\u0917\u093f\u0924\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0938\u0947 \u092c\u0928\u093e\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u092a\u0930\u093f\u0923\u093e\u092e\u0938\u094d\u0935\u0930\u0942\u092a \u0907\u0938 \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u094b \u0921\u0947\u0938\u094d\u0915\u091f\u0949\u092a/\u0932\u0948\u092a\u091f\u0949\u092a \u0915\u0902\u092a\u094d\u092f\u0942\u091f\u0930, \u0935\u0947\u092c-\u0938\u0915\u094d\u0937\u092e \u092e\u094b\u092c\u093e\u0907\u0932 \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u091c\u0948\u0938\u0947 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u0938\u0947 \u0926\u0947\u0916\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964</p><p>\u0939\u092e\u0928\u0947 \u092f\u0939 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u0938\u0930\u094d\u0935\u0936\u094d\u0930\u0947\u0937\u094d\u0920 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u093f\u092f\u093e \u0939\u0948 \u0915\u093f \u0907\u0938 \u092a\u094b\u0930\u094d\u091f\u0932 \u092a\u0930 \u0938\u092d\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0935\u093f\u0915\u0932\u093e\u0902\u0917 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0938\u0941\u0932\u092d \u0939\u094b\u0964 \u0909\u0926\u093e\u0939\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f, \u0926\u0943\u0936\u094d\u092f \u0905\u0915\u094d\u0937\u092e\u0924\u093e \u0935\u093e\u0932\u093e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0930\u0940\u0921\u0930 \u0914\u0930 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092e\u0948\u0917\u094d\u0928\u093f\u092b\u093e\u092f\u0930 \u091c\u0948\u0938\u0940 \u0938\u0939\u093e\u092f\u0915 \u0924\u0915\u0928\u0940\u0915\u094b\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0907\u0938 \u092a\u094b\u0930\u094d\u091f\u0932 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a \u0938\u0915\u0924\u093e \u0939\u0948\u0964</p><p>\u0939\u092e\u093e\u0930\u093e \u0932\u0915\u094d\u0937\u094d\u092f \u092e\u093e\u0928\u0915\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0930\u0942\u092a \u0939\u094b\u0928\u093e \u0914\u0930 \u0909\u092a\u092f\u094b\u0917\u093f\u0924\u093e \u0914\u0930 \u0938\u093e\u0930\u094d\u0935\u092d\u094c\u092e\u093f\u0915 \u0921\u093f\u091c\u093e\u0907\u0928 \u0915\u0947 \u0938\u093f\u0926\u094d\u0927\u093e\u0902\u0924\u094b\u0902 \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0928\u093e \u0939\u0948, \u091c\u093f\u0938\u0938\u0947 \u0907\u0938 \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u0947 \u0938\u092d\u0940 \u0906\u0917\u0902\u0924\u0941\u0915\u094b\u0902 \u0915\u0940 \u092e\u0926\u0926 \u0915\u0930\u0928\u0940 \u091a\u093e\u0939\u093f\u090f\u0964</p><p>\u092f\u0939 \u092a\u094b\u0930\u094d\u091f\u0932 \u092d\u093e\u0930\u0924 \u0938\u0930\u0915\u093e\u0930 \u0915\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0926\u093f\u0936\u093e\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u094b\u0902 \u0915\u094b \u092a\u0942\u0930\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0930\u093f\u090f\u0915\u094d\u091f \u091c\u0947\u090f\u0938, \u0928\u0947\u0915\u094d\u0938\u094d\u091f \u091c\u0947\u090f\u0938 \u091c\u0948\u0938\u0940 \u0928\u0935\u0940\u0928\u0924\u092e \u0924\u0915\u0928\u0940\u0915\u094b\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0921\u093f\u091c\u093c\u093e\u0907\u0928 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0914\u0930 \u0935\u0930\u094d\u0932\u094d\u0921 \u0935\u093e\u0907\u0921 \u0935\u0947\u092c \u0915\u0902\u0938\u094b\u0930\u094d\u091f\u093f\u092f\u092e (\u0921\u092c\u094d\u0932\u094d\u092f\u0942 3 \u0938\u0940) \u0926\u094d\u0935\u093e\u0930\u093e \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0935\u0947\u092c \u0915\u0902\u091f\u0947\u0902\u091f \u090f\u0915\u094d\u0938\u0947\u0938\u093f\u092c\u093f\u0932\u093f\u091f\u0940 \u0917\u093e\u0907\u0921\u0932\u093e\u0907\u0902\u0938 (\u0921\u092c\u094d\u0932\u094d\u092f\u0942\u0938\u0940\u090f\u091c\u0940) 2.0 \u0915\u0947 \u0938\u094d\u0924\u0930 \u090f \u0915\u093e \u092d\u0940 \u092a\u093e\u0932\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092e\u0902\u091a \u092e\u0947\u0902 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u093e \u090f\u0915 \u0939\u093f\u0938\u094d\u0938\u093e \u092c\u093e\u0939\u0930\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u094b\u0902 \u0915\u0947 \u0932\u093f\u0902\u0915 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092d\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0915\u0930\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092c\u093e\u0939\u0930\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u094b\u0902 \u0915\u093e \u0930\u0916\u0930\u0916\u093e\u0935 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0935\u093f\u092d\u093e\u0917\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u091c\u094b \u0907\u0928 \u0938\u093e\u0907\u091f\u094b\u0902 \u0915\u094b \u0938\u0941\u0932\u092d \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964</p><p>myScheme \u0905\u092a\u0928\u0947 \u092e\u0902\u091a \u0915\u094b \u0935\u093f\u0915\u0932\u093e\u0902\u0917 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0938\u0941\u0932\u092d \u092c\u0928\u093e\u0928\u0947 \u0915\u0940 \u0926\u093f\u0936\u093e \u092e\u0947\u0902 \u0915\u093e\u092e \u0915\u0930 \u0930\u0939\u093e \u0939\u0948, \u0939\u093e\u0932\u093e\u0902\u0915\u093f \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u092a\u094b\u0930\u094d\u091f\u0947\u092c\u0932 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092a\u094d\u0930\u093e\u0930\u0942\u092a (\u092a\u0940\u0921\u0940\u090f\u092b) \u092b\u093e\u0907\u0932\u0947\u0902 \u0938\u0941\u0932\u092d \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964 \u0907\u0938\u0915\u0947 \u0905\u0932\u093e\u0935\u093e, \u0939\u093f\u0902\u0926\u0940 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0909\u092a\u0932\u092c\u094d\u0927 \u0915\u0930\u093e\u0908 \u0917\u0908 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092d\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964</p><p>\u092f\u0926\u093f \u0906\u092a\u0915\u094b \u0907\u0938 \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u0940 \u092a\u0939\u0941\u0902\u091a \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0938\u092e\u0938\u094d\u092f\u093e \u092f\u093e \u0938\u0941\u091d\u093e\u0935 \u0939\u0948, \u0924\u094b \u0915\u0943\u092a\u092f\u093e \u0939\u092e\u0947\u0902 contact[at]myScheme[dot]gov[dot]in \u092a\u0930 \u0932\u093f\u0916\u0947\u0902 \u0924\u093e\u0915\u093f \u0939\u092e \u092e\u0926\u0926\u0917\u093e\u0930 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u091c\u0935\u093e\u092c \u0926\u0947 \u0938\u0915\u0947\u0902\u0964 \u0905\u092a\u0928\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0939\u092e\u0947\u0902 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u0940 \u092a\u094d\u0930\u0915\u0943\u0924\u093f \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092c\u0924\u093e\u090f\u0902\u0964</p>"),(0,xe.Z)($,"privacyPolicy","\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f"),(0,xe.Z)($,"hyperlinkPolicy","\u0939\u093e\u0907\u092a\u0930\u0932\u093f\u0902\u0915\u093f\u0902\u0917 \u0928\u0940\u0924\u093f"),(0,xe.Z)($,"termsOfUse","\u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u0936\u0930\u094d\u0924\u0947\u0902"),(0,xe.Z)($,"terms","\u0928\u093f\u092f\u092e \u090f\u0935\u0902 \u0936\u0930\u094d\u0924\u0947\u0902"),(0,xe.Z)($,"websitePolicy","\u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0928\u0940\u0924\u093f\u092f\u093e\u0902"),(0,xe.Z)($,"copyrightPolicy","\u0915\u0949\u092a\u0940\u0930\u093e\u0907\u091f \u0928\u0940\u0924\u093f"),(0,xe.Z)($,"termsConditions","<p>\u0928\u093f\u092f\u092e \u090f\u0935\u0902 \u0936\u0930\u094d\u0924\u0947\u0902</p>"),(0,xe.Z)($,"copyrightPolicyText","\u0907\u0938 \u092a\u094b\u0930\u094d\u091f\u0932 \u092a\u0930 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u094b \u0928\u093f\u0903\u0936\u0941\u0932\u094d\u0915 \u092a\u0941\u0928: \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0939\u093e\u0932\u093e\u0902\u0915\u093f, \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u094b \u0938\u091f\u0940\u0915 \u0930\u0942\u092a \u0938\u0947 \u092a\u0941\u0928: \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u0914\u0930 \u0905\u092a\u092e\u093e\u0928\u091c\u0928\u0915 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u092f\u093e \u092d\u094d\u0930\u093e\u092e\u0915 \u0938\u0902\u0926\u0930\u094d\u092d \u092e\u0947\u0902 \u0909\u092a\u092f\u094b\u0917 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964 \u091c\u0939\u093e\u0902 \u0915\u0939\u0940\u0902 \u092d\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u0940 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948 \u092f\u093e \u0926\u0942\u0938\u0930\u094b\u0902 \u0915\u094b \u091c\u093e\u0930\u0940 \u0915\u0940 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948, \u0938\u094d\u0930\u094b\u0924 \u0915\u094b \u092a\u094d\u0930\u092e\u0941\u0916\u0924\u093e \u0938\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964 \u0939\u093e\u0932\u093e\u0902\u0915\u093f, \u0907\u0938 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u094b \u092a\u0941\u0928: \u092a\u0947\u0936 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0924\u0915 \u0935\u093f\u0938\u094d\u0924\u093e\u0930\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u0940, \u091c\u093f\u0938\u0947 \u0915\u093f\u0938\u0940 \u0924\u0940\u0938\u0930\u0947 \u092a\u0915\u094d\u0937 (\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0938\u093e\u092e\u0917\u094d\u0930\u0940) \u0915\u0947 \u0915\u0949\u092a\u0940\u0930\u093e\u0907\u091f \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092a\u0939\u091a\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0910\u0938\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u094b \u092a\u0941\u0928: \u092a\u0947\u0936 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u093e\u0927\u093f\u0915\u0930\u0923 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0915\u0949\u092a\u0940\u0930\u093e\u0907\u091f \u0927\u093e\u0930\u0915 \u0938\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964"),(0,xe.Z)($,"privacyPolicyText","<p>myScheme \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0906\u092a\u0938\u0947 \u0915\u094b\u0908 \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 (\u091c\u0948\u0938\u0947 \u0928\u093e\u092e, \u092b\u094b\u0928 \u0928\u0902\u092c\u0930 \u092f\u093e \u0908-\u092e\u0947\u0932 \u092a\u0924\u093e) \u0928\u0939\u0940\u0902 \u0932\u0947\u0924\u093e \u0939\u0948, \u091c\u094b \u0939\u092e\u0947\u0902 \u0906\u092a\u0915\u094b \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0930\u0942\u092a \u0938\u0947 \u092a\u0939\u091a\u093e\u0928\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u092f\u0926\u093f myScheme-\u092a\u094b\u0930\u094d\u091f\u0932 \u0906\u092a\u0938\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930\u0924\u0940 \u0939\u0948, \u0924\u094b \u0906\u092a\u0915\u094b \u0909\u0928 \u0935\u093f\u0936\u0947\u0937 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0938\u0942\u091a\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e \u091c\u093f\u0928\u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u090f\u0915\u0924\u094d\u0930 \u0915\u0940 \u0917\u0908 \u0939\u0948 \u0914\u0930 \u0906\u092a\u0915\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0909\u092a\u093e\u092f \u0915\u093f\u090f \u091c\u093e\u090f\u0902\u0917\u0947\u0964 \u0939\u092e \u0915\u093f\u0938\u0940 \u092d\u0940 \u0924\u0940\u0938\u0930\u0947 \u092a\u0915\u094d\u0937 (\u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915/\u0928\u093f\u091c\u0940) \u0915\u094b myScheme-\u092a\u094b\u0930\u094d\u091f\u0932 \u092a\u0930 \u0938\u094d\u0935\u0947\u091a\u094d\u091b\u093e \u0938\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u092a\u0939\u091a\u093e\u0928 \u092f\u094b\u0917\u094d\u092f \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u094b \u092c\u0947\u091a\u0924\u0947 \u092f\u093e \u0938\u093e\u091d\u093e \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938 \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u094b \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u0917\u0908 \u0915\u094b\u0908 \u092d\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0939\u093e\u0928\u093f, \u0926\u0941\u0930\u0941\u092a\u092f\u094b\u0917, \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u092a\u0939\u0941\u0902\u091a \u092f\u093e \u092a\u094d\u0930\u0915\u091f\u0940\u0915\u0930\u0923, \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u092f\u093e \u0935\u093f\u0928\u093e\u0936 \u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0939\u0947\u0917\u0940\u0964 \u0939\u092e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0915\u0941\u091b \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u090f\u0915\u0924\u094d\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u091c\u0948\u0938\u0947 \u0915\u093f \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 (\u0906\u0908\u092a\u0940) \u092a\u0924\u0947, \u0921\u094b\u092e\u0947\u0928 \u0928\u093e\u092e, \u092c\u094d\u0930\u093e\u0909\u091c\u093c\u0930 \u092a\u094d\u0930\u0915\u093e\u0930, \u0911\u092a\u0930\u0947\u091f\u093f\u0902\u0917 \u0938\u093f\u0938\u094d\u091f\u092e, \u0935\u093f\u091c\u093c\u093f\u091f \u0915\u0940 \u0924\u093f\u0925\u093f \u0914\u0930 \u0938\u092e\u092f \u0914\u0930 \u0926\u0947\u0916\u0947 \u0917\u090f \u092a\u0943\u0937\u094d\u0920\u0964 \u0939\u092e \u0907\u0928 \u092a\u0924\u094b\u0902 \u0915\u094b \u0939\u092e\u093e\u0930\u0940 \u0938\u093e\u0907\u091f \u092a\u0930 \u0906\u0928\u0947 \u0935\u093e\u0932\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u092f\u094b\u0902 \u0915\u0940 \u092a\u0939\u091a\u093e\u0928 \u0938\u0947 \u091c\u094b\u0921\u093c\u0928\u0947 \u0915\u093e \u0915\u094b\u0908 \u092a\u094d\u0930\u092f\u093e\u0938 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u091c\u092c \u0924\u0915 \u0915\u093f \u0938\u093e\u0907\u091f \u0915\u094b \u0928\u0941\u0915\u0938\u093e\u0928 \u092a\u0939\u0941\u0902\u091a\u093e\u0928\u0947 \u0915\u0947 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u093e \u092a\u0924\u093e \u0928\u0939\u0940\u0902 \u091a\u0932\u0924\u093e\u0964</p>"),(0,xe.Z)($,"hyperlinkPolicyText","<p><strong>\u092c\u093e\u0939\u094d\u092f \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u094b\u0902/\u092a\u094b\u0930\u094d\u091f\u0932\u094b\u0902 \u0938\u0947 \u0932\u093f\u0902\u0915</strong></p> <p> \u0907\u0938 \u092a\u094b\u0930\u094d\u091f\u0932 \u092e\u0947\u0902 \u0905\u0928\u0947\u0915 \u0938\u094d\u200d\u0925\u0932\u094b\u0902 \u092a\u0930 \u0906\u092a\u0915\u094b \u0905\u0928\u094d\u200d\u092f \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u094b\u0902/\u092a\u094b\u0930\u094d\u091f\u0932\u094b\u0902 \u0915\u0947 \u0932\u093f\u0902\u0915 \u092e\u093f\u0932\u0947\u0902\u0917\u0947\u0964 \u092f\u0947 \u0932\u093f\u0902\u0915 \u0906\u092a\u0915\u0940 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u0947 \u0932\u093f\u090f \u0926\u093f\u090f \u0917\u090f \u0939\u0948\u0902\u0964 myScheme \u0932\u093f\u0902\u0915 \u0915\u093f\u090f \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u0940 \u0935\u093f\u0937\u092f \u090f\u0935\u0902 \u0935\u093f\u0936\u094d\u200d\u0935\u0938\u0928\u0940\u092f\u0924\u093e \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u091c\u0935\u093e\u092c\u0926\u0947\u0939 \u0928\u0939\u0940\u0902 \u0939\u0948 \u0914\u0930 \u0928 \u0939\u0940 \u0909\u0928\u0915\u0947 \u0935\u093f\u091a\u093e\u0930\u094b\u0902 \u0915\u093e \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f\u0924: \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0907\u0938 \u092a\u094b\u0930\u094d\u091f\u0932 \u092a\u0930 \u0909\u0928\u0915\u0947 \u0932\u093f\u0902\u0915 \u0915\u093e \u0939\u094b\u0928\u093e \u0905\u0925\u0935\u093e \u0909\u0928\u0915\u0940 \u0932\u093f\u0938\u094d\u091f\u093f\u0902\u0917 \u092e\u093e\u0924\u094d\u0930 \u0938\u0947 \u0939\u092e\u093e\u0930\u093e \u0909\u0928\u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u0915\u093f\u0938\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0928 \u092e\u093e\u0928\u093e \u091c\u093e\u090f\u0964 \u092f\u0947 \u0932\u093f\u0902\u0915 \u0939\u0930 \u0938\u092e\u092f \u0915\u093e\u092e \u0915\u0930\u0947\u0902\u0917\u0947, \u0907\u0938\u0915\u0940 \u0917\u093e\u0902\u0930\u091f\u0940 \u092d\u0940 \u0939\u092e \u0928\u0939\u0940\u0902 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0932\u093f\u0902\u0915 \u0915\u093f\u090f \u0917\u090f \u092a\u0947\u091c\u094b\u0902 \u0915\u0940 \u0909\u092a\u0932\u092c\u094d\u200d\u0927\u0924\u093e \u092a\u0930 \u092d\u0940 \u0939\u092e\u093e\u0930\u093e \u0915\u094b\u0908 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964</p> <p><strong>\u0905\u0928\u094d\u092f \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e myScheme \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u093e \u0932\u093f\u0902\u0915</strong></p> <p> \u0907\u0938 \u0938\u093e\u0907\u091f \u092a\u0930 \u0926\u0940 \u091c\u093e \u0930\u0939\u0940 \u0938\u0942\u091a\u0928\u093e\u0913\u0902 \u0938\u0947 \u0906\u092a \u0938\u0940\u0927\u0947 \u0932\u093f\u0902\u0915 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0907\u0938\u092e\u0947\u0902 \u0939\u092e\u0947\u0902 \u0915\u094b\u0908 \u0906\u092a\u0924\u094d\u0924\u093f \u0928\u0939\u0940\u0902 \u0939\u0948 \u0914\u0930 \u0928 \u0939\u0940 \u0907\u0938\u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u094b \u092a\u0942\u0930\u094d\u0935 \u0905\u0928\u0941\u092e\u0924\u093f \u0915\u0940 \u0906\u0935\u0936\u094d\u200d\u092f\u0915\u0924\u093e \u0939\u0948\u0964 \u0939\u093e\u0932\u093e\u0902\u0915\u093f \u0939\u092e \u091a\u093e\u0939\u0947\u0902\u0917\u0947 \u0915\u093f \u0906\u092a \u0907\u0938 \u092a\u094b\u0930\u094d\u091f\u0932 \u092a\u0930 \u0926\u093f\u090f \u0917\u090f \u0915\u093f\u0938\u0940 \u0932\u093f\u0902\u0915 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0939\u092e\u0947\u0902 \u0938\u0942\u091a\u093f\u0924 \u0915\u0930\u0947\u0902, \u0924\u093e\u0915\u093f \u0909\u0938\u092e\u0947\u0902 \u0915\u093f\u0938\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0947 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0905\u0925\u0935\u093e \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0940 \u0938\u0942\u091a\u0928\u093e \u0906\u092a\u0915\u094b \u0926\u0940 \u091c\u093e \u0938\u0915\u0947\u0964 \u092f\u0939 \u092d\u0940 \u0915\u093f \u0939\u092e \u0905\u092a\u0928\u0947 \u092a\u0947\u091c\u094b\u0902 \u0915\u094b \u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f \u0915\u0947 \u092b\u094d\u0930\u0947\u092e \u092e\u0947\u0902 \u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0928\u0939\u0940\u0902 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938 \u0938\u093e\u0907\u091f \u0915\u0947 \u092a\u0947\u091c \u092a\u094d\u0930\u092f\u094b\u0915\u094d\u200d\u0924\u093e \u0926\u094d\u0935\u093e\u0930\u093e \u0916\u094b\u0932\u0947 \u0917\u090f \u0928\u090f \u092c\u094d\u0930\u093e\u0909\u091c\u0930 \u0935\u093f\u0928\u094d\u200d\u0921\u094b \u092e\u0947\u0902 \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f\u0924: \u0932\u094b\u0921 \u0915\u093f\u090f \u091c\u093e\u090f\u0902\u0964</p>"),(0,xe.Z)($,"termsText1","<p>\u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u092f\u0947 \u0936\u0930\u094d\u0924\u0947\u0902 https://www.myscheme.gov.in \u0915\u0947 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0906\u092a\u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930\u094b\u0902 \u0914\u0930 \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u093e \u0935\u0930\u094d\u0923\u0928 \u0915\u0930\u0924\u0940 \u0939\u0948\u0902\u0964 \u090f\u0915 myScheme \u0916\u093e\u0924\u093e \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0906\u092a\u0915\u094b \u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u0907\u0928 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e\u0964</p><p>MeitY \u0914\u0930 Government\u0964 \u092d\u093e\u0930\u0924 \u0915\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u092f myScheme \u0914\u0930 \u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u0907\u0928 \u0936\u0930\u094d\u0924\u094b\u0902 \u092e\u0947\u0902 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0915\u0930\u0928\u0947 \u0915\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0926\u093f \u0935\u0947 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0906\u092a\u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930\u094b\u0902 \u092f\u093e \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0906\u092a\u0915\u094b myScheme \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0938\u0942\u091a\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964 </p><p>\u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u0936\u0930\u094d\u0924\u0947\u0902 \u0906\u092a\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e myScheme \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u094b \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0928\u093f\u092f\u092e \u0914\u0930 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u093e \u0938\u094d\u0925\u093e\u0928 \u0932\u0947\u0924\u0940 \u0939\u0948\u0902 \u0914\u0930 \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948\u0902\u0964 \u091c\u0948\u0938\u0947 \u0939\u0940 \u0906\u092a \u0907\u0938\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0905\u092a\u0928\u093e myScheme \u0916\u093e\u0924\u093e \u092c\u0928\u093e \u0932\u0947\u0924\u0947 \u0939\u0948\u0902, \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0928\u093f\u092f\u092e \u0914\u0930 \u0936\u0930\u094d\u0924\u0947\u0902 \u092a\u094d\u0930\u092d\u093e\u0935\u0940 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0902\u0964 \u0914\u0930 \u0907\u0928 \u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940\u0964 \u092a\u094d\u0930\u0926\u093e\u0924\u093e \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u092f \u0915\u093f\u0938\u0940 \u092d\u0940 \u0915\u093e\u0930\u0923 \u0938\u0947 \u0907\u0938 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0915\u094b \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964</p><p>\u092e\u0947\u0930\u0940 \u092f\u094b\u091c\u0928\u093e \u090f\u0928\u0908\u091c\u0940\u0921\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0921\u093f\u091c\u093c\u093e\u0907\u0928 \u0915\u0940 \u0917\u0908 \u0939\u0948 \u0914\u0930 \u0905\u092e\u0947\u091c\u093c\u0928 \u0935\u0947\u092c \u0938\u0947\u0935\u093e\u090f\u0901 \u0926\u094d\u0935\u093e\u0930\u093e \u0939\u094b\u0938\u094d\u091f \u0915\u0940 \u0917\u0908 \u0939\u0948, \u0914\u0930 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092d\u093e\u0930\u0924 \u0938\u0930\u0915\u093e\u0930 \u0915\u0947 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0938\u0902\u0917\u0920\u0928\u094b\u0902, \u0935\u093f\u092d\u093e\u0917\u094b\u0902 \u0914\u0930 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 .</p><p>\u092f\u0926\u094d\u092f\u092a\u093f myScheme \u092a\u0930 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u0940 \u0938\u091f\u0940\u0915\u0924\u093e \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u092d\u0940 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u093f\u090f \u0917\u090f \u0939\u0948\u0902, \u0907\u0938\u0947 \u0915\u093e\u0928\u0942\u0928 \u0915\u0947 \u090f\u0915 \u092c\u092f\u093e\u0928 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u092e\u093e\u0928\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u092f\u093e \u0915\u093f\u0938\u0940 \u0915\u093e\u0928\u0942\u0928\u0940 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0905\u0938\u094d\u092a\u0937\u094d\u091f\u0924\u093e \u092f\u093e \u0938\u0902\u0926\u0947\u0939 \u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902, \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u0938\u0932\u093e\u0939 \u0926\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948 \u0915\u093f \u0935\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f/\u0935\u093f\u092d\u093e\u0917/\u0938\u0902\u0917\u0920\u0928 \u0914\u0930/\u092f\u093e \u0905\u0928\u094d\u092f \u0938\u094d\u0930\u094b\u0924\u094b\u0902 \u0938\u0947 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924/\u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902, \u0914\u0930 \u0909\u091a\u093f\u0924 \u092a\u0947\u0936\u0947\u0935\u0930 \u0938\u0932\u093e\u0939 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902\u0964</p><p>\u0915\u093f\u0938\u0940 \u092d\u0940 \u092a\u0930\u093f\u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902 \u0938\u0930\u0915\u093e\u0930\u0940 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f/\u0935\u093f\u092d\u093e\u0917/\u0938\u0902\u0917\u0920\u0928 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0916\u0930\u094d\u091a, \u0939\u093e\u0928\u093f, \u092f\u093e \u0915\u094d\u0937\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u0940 \u0939\u094b\u0917\u093e, \u091c\u093f\u0938\u092e\u0947\u0902 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0938\u0940\u092e\u093e \u0915\u0947, \u0905\u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u092f\u093e \u092a\u0930\u093f\u0923\u093e\u092e\u0940 \u0939\u093e\u0928\u093f \u092f\u093e \u0915\u094d\u0937\u0924\u093f, \u092f\u093e \u0915\u093f\u0938\u0940 \u092d\u0940 \u0935\u094d\u092f\u092f, \u0939\u093e\u0928\u093f, \u092f\u093e \u0928\u0941\u0915\u0938\u093e\u0928, \u091c\u094b \u092d\u0940 \u0921\u0947\u091f\u093e \u0915\u0947 \u0909\u092a\u092f\u094b\u0917, \u092f\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u0939\u093e\u0928\u093f \u0938\u0947 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0939\u094b\u0924\u093e \u0939\u0948, \u0915\u0947 \u0932\u093f\u090f \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u0940 \u0939\u094b\u0917\u093e\u0964 myScheme \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947\u0902 \u092f\u093e \u0909\u0938\u0938\u0947 \u0909\u0924\u094d\u092a\u0928\u094d\u0928\u0964</p>"),(0,xe.Z)($,"termsHead1","\u0909\u092a\u092f\u094b\u0917 \u092a\u0930 \u0938\u0940\u092e\u093e:"),(0,xe.Z)($,"termsText2","<p>myScheme \u0915\u093e \u0915\u094b\u0908 \u092d\u0940 \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u0909\u092a\u092f\u094b\u0917 \u0928\u093f\u0937\u093f\u0926\u094d\u0927 \u0939\u0948\u0964 \u091c\u092c \u0924\u0915 myScheme \u0926\u094d\u0935\u093e\u0930\u093e \u0932\u093f\u0916\u093f\u0924 \u0930\u0942\u092a \u092e\u0947\u0902 \u0938\u094d\u092a\u0937\u094d\u091f \u0930\u0942\u092a \u0938\u0947 \u0905\u0927\u093f\u0915\u0943\u0924 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u0924\u092c \u0924\u0915 \u092a\u094b\u0930\u094d\u091f\u0932 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u0924\u0915 \u092a\u0939\u0941\u0901\u091a\u0928\u0947, \u0928\u093f\u0917\u0930\u093e\u0928\u0940 \u0915\u0930\u0928\u0947 \u092f\u093e \u0915\u0949\u092a\u0940 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u0949\u092b\u093c\u094d\u091f\u0935\u0947\u092f\u0930 (\u091c\u0948\u0938\u0947 \u092c\u0949\u091f\u094d\u0938, \u0938\u094d\u0915\u094d\u0930\u0948\u092a\u0930 \u091f\u0942\u0932) \u092f\u093e \u0905\u0928\u094d\u092f \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0928\u093f\u0937\u093f\u0926\u094d\u0927 \u0939\u0948\u0964</p>"),(0,xe.Z)($,"termsHead2","\u0906\u092a\u0915\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0928\u0940\u0924\u093f:"),(0,xe.Z)($,"termsText3","<p>myScheme \u092a\u0930 \u0909\u092a\u092f\u094b\u0917 \u0915\u0947 \u0932\u093f\u090f \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0928\u093e \u092f\u093e \u0915\u094b\u0908 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0928\u093e, \u0906\u092a myScheme \u0915\u094b \u090f\u0915 \u0938\u094d\u0925\u093e\u092f\u0940, \u0935\u093f\u0936\u094d\u0935\u0935\u094d\u092f\u093e\u092a\u0940, \u0930\u0949\u092f\u0932\u094d\u091f\u0940-\u092e\u0941\u0915\u094d\u0924, \u0905\u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928\u0940\u092f, \u0917\u0948\u0930-\u0905\u0928\u0928\u094d\u092f \u0905\u0927\u093f\u0915\u093e\u0930 \u0914\u0930 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0915\u0947 \u0938\u093e\u0925 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 (\u092f\u093e \u0935\u093e\u0930\u0902\u091f\u0940 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0910\u0938\u0947 \u0905\u0927\u093f\u0915\u093e\u0930\u094b\u0902 \u0915\u0947 \u0938\u094d\u0935\u093e\u092e\u0940 \u0928\u0947 \u0938\u094d\u092a\u0937\u094d\u091f \u0930\u0942\u092a \u0938\u0947 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0940 \u0939\u0948) \u0909\u092a\u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0915\u093e \u0905\u0927\u093f\u0915\u093e\u0930, \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947, \u092a\u0941\u0928: \u092a\u0947\u0936 \u0915\u0930\u0928\u0947, \u0938\u0902\u0936\u094b\u0927\u093f\u0924 \u0915\u0930\u0928\u0947, \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0928\u0947, \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u0930\u0928\u0947, \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0915\u0930\u0928\u0947, \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0928\u0947, \u0921\u093f\u091c\u093f\u091f\u0932 \u0930\u0942\u092a \u0938\u0947 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0928\u0947 \u0914\u0930 \u0921\u093f\u091c\u093f\u091f\u0932 \u0930\u0942\u092a \u0938\u0947 \u0905\u0928\u0941\u0935\u093e\u0926 \u0915\u0930\u0928\u0947, \u0910\u0938\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0938\u0947 \u0935\u094d\u092f\u0941\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u093e\u0930\u094d\u092f \u092c\u0928\u093e\u0928\u0947 \u0914\u0930 \u0935\u093f\u0924\u0930\u093f\u0924 \u0915\u0930\u0928\u0947 \u092f\u093e \u0910\u0938\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u094b \u0915\u093f\u0938\u0940 \u092d\u0940 \u0930\u0942\u092a, \u092e\u093e\u0927\u094d\u092f\u092e \u092f\u093e \u0924\u0915\u0928\u0940\u0915 \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0915\u0930\u0928\u0947 \u0915\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u091c\u093f\u0938\u0947 \u0905\u092c \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092f\u093e \u092c\u093e\u0926 \u092e\u0947\u0902 \u092a\u0942\u0930\u0947 \u092c\u094d\u0930\u0939\u094d\u092e\u093e\u0902\u0921 \u092e\u0947\u0902 \u0935\u093f\u0915\u0938\u093f\u0924 \u0939\u0941\u0906\u0964 \u0906\u092a \u0938\u0939\u092e\u0924 \u0939\u0948\u0902 \u0915\u093f \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u0906\u092a\u0915\u0947 \u0938\u0902\u091a\u093e\u0930 \u092e\u0947\u0902 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u094d\u0935\u093e\u092e\u093f\u0924\u094d\u0935 \u0905\u0927\u093f\u0915\u093e\u0930 \u0915\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0915\u0925\u093f\u0924 \u092f\u093e \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u092f\u093e \u0926\u0941\u0930\u0941\u092a\u092f\u094b\u0917 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u092a\u094d\u0930\u0926\u093e\u0924\u093e \u0915\u0947 \u0916\u093f\u0932\u093e\u092b \u0915\u094b\u0908 \u0938\u0939\u093e\u0930\u093e \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u093e\u0964 </p>"),(0,xe.Z)($,"termsHead3","\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0940 \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u0940:"),(0,xe.Z)($,"termsText4","<p>\u0906\u092a\u0915\u094b \u092f\u0939 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e:</p>"),(0,xe.Z)($,"termsPoints","<li>myScheme \u092f\u093e \u0938\u0926\u0938\u094d\u092f \u0938\u0947\u0935\u093e \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u0928\u0947 \u092f\u093e \u090f\u0915\u094d\u0938\u0947\u0938 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0938\u094d\u0935\u093e\u092d\u093e\u0935\u093f\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u092c\u0928\u0947\u0902;</li><li>\u0915\u093f\u0938\u0940 \u0905\u0928\u094d\u092f \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u0940 myScheme \u092f\u093e \u0938\u0926\u0938\u094d\u092f \u0915\u0940 \u090f\u0915\u094d\u0938\u0947\u0938 \u092f\u093e \u0932\u093f\u0902\u0915 \u092f\u093e \u090f\u0915\u094d\u0938\u0947\u0938 \u092f\u093e \u0932\u093f\u0902\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f (\u092f\u093e \u0924\u094b \u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u092f\u093e \u0905\u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u0930\u0942\u092a \u0938\u0947) \u0928\u0939\u0940\u0902 \u0938\u0947\u0935\u093e \u0916\u093e\u0924\u093e;</li><li>\u0915\u093f\u0938\u0940 \u0905\u0928\u094d\u092f \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u094b \u0906\u092a\u0915\u0947 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e \u0914\u0930 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0928 \u0926\u0947\u0902; \u0905\u092a\u0928\u093e myScheme \u0916\u093e\u0924\u093e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e \u0914\u0930 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0939\u0930 \u0938\u092e\u092f \u0930\u0916\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u093f\u0938\u0940 \u0914\u0930 \u0915\u094b \u0928 \u092c\u0924\u093e\u090f\u0902;</li><li>\u092f\u0926\u093f \u0906\u092a\u0915\u094b \u0938\u0902\u0926\u0947\u0939 \u0939\u0948 \u0915\u093f \u0906\u092a\u0915\u0947 myScheme \u0916\u093e\u0924\u0947 \u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0947 \u0938\u092e\u091d\u094c\u0924\u093e \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948, \u0924\u094b \u0924\u0941\u0930\u0902\u0924 \u0939\u0947\u0932\u094d\u092a\u0921\u0947\u0938\u094d\u0915 \u0915\u094b \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0930\u0947\u0902 \u091c\u0948\u0938\u0947: \u0906\u092a\u0915\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092f\u093e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e \u0916\u094b \u0917\u092f\u093e \u0939\u0948 \u092f\u093e \u091a\u094b\u0930\u0940 \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964 \u0939\u092e\u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902 \u092a\u0930 \u0935\u093f\u0935\u0930\u0923 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 myScheme \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902;</li><li>\u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0906\u092a\u0915\u0947 \u0935\u093f\u0935\u0930\u0923 (\u0906\u092a\u0915\u0947 \u0928\u093e\u092e \u0914\u0930 \u091c\u0928\u094d\u092e \u0924\u093f\u0925\u093f \u0938\u0939\u093f\u0924) \u0938\u091f\u0940\u0915 \u0939\u0948\u0902 \u0914\u0930 myScheme \u0915\u0947 \u0938\u093e\u0925 \u0905\u0926\u094d\u092f\u0924\u093f\u0924 \u0930\u0939\u0947\u0902;</li><li>\u0906\u092a \u0915\u093f\u0938\u0940 \u092d\u0940 \u091a\u0940\u091c\u093c \u0915\u0947 \u0932\u093f\u090f \u091c\u093c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u0939\u0948\u0902 \u0905\u092a\u0928\u0947 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e \u0914\u0930 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0905\u092a\u0928\u0947 myScheme \u0916\u093e\u0924\u0947 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902, \u091a\u093e\u0939\u0947 \u0910\u0938\u093e \u0909\u092a\u092f\u094b\u0917 \u0906\u092a\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u0927\u093f\u0915\u0943\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u094b \u092f\u093e \u0928\u0939\u0940\u0902\u0964</li><li>myScheme \u092a\u0930 \u0935\u093f\u0935\u0930\u0923 \u0915\u0947\u0935\u0932 myScheme \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092a\u0939\u0941\u0901\u091a\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948, \u0914\u0930 \u0915\u0947\u0935\u0932 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e \u0914\u0930 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0935\u093f\u0935\u0930\u0923 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0906\u092a\u0915\u094b \u0935\u093f\u0936\u0947\u0937 \u0930\u0942\u092a \u0938\u0947 \u0906\u0935\u0902\u091f\u093f\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964</li><li>\u0906\u092a\u0915\u094b myScheme \u0914\u0930 \u0905\u092a\u0928\u0947 myScheme \u0916\u093e\u0924\u0947 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0947\u0935\u0932 \u0935\u0948\u0927 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0914\u0930 \u0907\u0938 \u0924\u0930\u0939 \u0938\u0947 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u091c\u094b \u0915\u093f\u0938\u0940 \u0924\u0940\u0938\u0930\u0947 \u092a\u0915\u094d\u0937 \u0926\u094d\u0935\u093e\u0930\u093e myScheme \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u094b \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u093f\u0924 \u092f\u093e \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u093f\u0924 \u092f\u093e \u092c\u093e\u0927\u093f\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u092e\u0947\u0902 \u0910\u0938\u093e \u0906\u091a\u0930\u0923 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948 \u091c\u094b \u0917\u0948\u0930\u0915\u093e\u0928\u0942\u0928\u0940 \u0939\u0948 \u092f\u093e \u091c\u094b \u0915\u093f\u0938\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u094b \u092a\u0930\u0947\u0936\u093e\u0928 \u092f\u093e \u092a\u0930\u0947\u0936\u093e\u0928 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948 \u092f\u093e \u0905\u0938\u0941\u0935\u093f\u0927\u093e \u092a\u0948\u0926\u093e \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948, \u0905\u0936\u094d\u0932\u0940\u0932 \u092f\u093e \u0906\u092a\u0924\u094d\u0924\u093f\u091c\u0928\u0915 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u093e \u092a\u094d\u0930\u0938\u093e\u0930\u0923, \u092f\u093e myScheme \u092e\u0947\u0902 \u0935\u094d\u092f\u0935\u0927\u093e\u0928 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964</li>"),(0,xe.Z)($,"termsHead4","\u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u091c\u094b \u0906\u092a myScheme \u092a\u0930 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902:"),(0,xe.Z)($,"termsText5","<p>\u092f\u0926\u093f \u0906\u092a\u0915\u0947 myScheme \u0916\u093e\u0924\u0947 \u092e\u0947\u0902, \u0906\u092a\u0915\u094b \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0939\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u0924\u094b \u0906\u092a\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u0942\u0930\u094d\u0923 \u0914\u0930 \u0938\u091f\u0940\u0915 \u0939\u094b\u0928\u0940 \u091a\u093e\u0939\u093f\u090f\u0964 \u0906\u092a \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u092f\u0926\u093f \u0906\u092a \u0905\u0927\u0942\u0930\u0940, \u0917\u0932\u0924, \u092f\u093e \u091d\u0942\u0920\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b myScheme \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0930\u0928\u0947 (\u092f\u093e \u0915\u0930\u0928\u0947 \u0915\u093e \u092a\u094d\u0930\u092f\u093e\u0938) \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u092f\u093e \u0905\u0928\u094d\u092f\u0925\u093e myScheme \u0915\u093e \u0926\u0941\u0930\u0941\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u092f\u0939 \u0906\u092a\u0915\u0940 myScheme \u090f\u0915\u094d\u0938\u0947\u0938 \u0915\u094b \u0928\u093f\u0932\u0902\u092c\u093f\u0924 \u092f\u093e \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964</p><p>\u0926\u0947\u0928\u0947 \u091d\u0942\u0920\u0940 \u092f\u093e \u092d\u094d\u0930\u093e\u092e\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u090f\u0915 \u0917\u0902\u092d\u0940\u0930 \u0905\u092a\u0930\u093e\u0927 \u0939\u0948\u0964 myScheme \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0905\u0927\u0942\u0930\u0940, \u0917\u0932\u0924, \u092f\u093e \u091d\u0942\u0920\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u094b \u0909\u0938\u0940 \u0924\u0930\u0939 \u0938\u0947 \u092e\u093e\u0928\u093e \u091c\u093e\u090f\u0917\u093e \u091c\u0948\u0938\u0947 \u0915\u093f\u0938\u0940 \u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u092f\u093e \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0930\u0942\u092a \u0938\u0947 \u0917\u0932\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0928\u093e \u0914\u0930 \u0907\u0938\u0915\u0947 \u092a\u0930\u093f\u0923\u093e\u092e\u0938\u094d\u0935\u0930\u0942\u092a \u0905\u092d\u093f\u092f\u094b\u091c\u0928 \u0914\u0930 \u0928\u093e\u0917\u0930\u093f\u0915 \u092f\u093e \u0906\u092a\u0930\u093e\u0927\u093f\u0915 \u0926\u0902\u0921 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948\u0964</p>"),(0,xe.Z)($,"securityPolicy","\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0928\u0940\u0924\u093f"),(0,xe.Z)($,"securityText","myScheme \u092a\u094b\u0930\u094d\u091f\u0932 \u0905\u092e\u0947\u091c\u093c\u0928 \u0935\u0947\u092c \u0938\u0947\u0935\u093e\u090f\u0901 (AWS) \u0915\u0947 \u0938\u0930\u094d\u0935\u0930 \u092a\u0930 \u0939\u094b\u0938\u094d\u091f \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0907\u0938\u0932\u093f\u090f, \u0907\u0938 \u0935\u093f\u092d\u093e\u0917 \u0915\u0940 \u092a\u094b\u0930\u094d\u091f\u0932 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0938\u092d\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u0941\u0926\u094d\u0926\u094b\u0902 \u0915\u094b AWS \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0902\u092c\u094b\u0927\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0926\u093f\u0936\u093e-\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930, AWS \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u092a\u0921\u093c\u0928\u0947 \u092a\u0930 \u0906\u0935\u0936\u094d\u092f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0911\u0921\u093f\u091f \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964"),(0,xe.Z)($,"monitoringPolicy","\u0928\u093f\u0917\u0930\u093e\u0928\u0940 \u0928\u0940\u0924\u093f"),(0,xe.Z)($,"monitoringText","myScheme \u091f\u0940\u092e \u0938\u092e\u092f-\u0938\u092e\u092f \u092a\u0930 myScheme \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u0940 \u0928\u093f\u0917\u0930\u093e\u0928\u0940 \u0915\u0930\u0947\u0917\u0940 \u0924\u093e\u0915\u093f \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u0914\u0930 \u0905\u0928\u0941\u0915\u0942\u0932\u0924\u093e \u0915\u0947 \u092e\u0941\