926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",hiwStep1:"<span>\u0905\u092a\u0928\u093e <strong>\u092e\u0942\u0932 \u0935\u093f\u0935\u0930\u0923 \u0926\u0930\u094d\u091c \u0915\u0930\u0915\u0947 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0915\u0930\u0947\u0902!</strong></span>",hiwStep2Head:"\u0916\u094b\u091c",hiwStep2:"<span>\u0939\u092e\u093e\u0930\u093e \u0938\u0930\u094d\u091a \u0907\u0902\u091c\u0928 <strong>\u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u094b \u0922\u0942\u0902\u0922\u0947\u0917\u093e</strong></span>",hiwStep3Head:"\u091a\u092f\u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u0947\u0902",hiwStep3:"<span>\u0938\u092c\u0938\u0947 \u0909\u092a\u092f\u0941\u0915\u094d\u0924 \u092f\u094b\u091c\u0928\u093e <strong>\u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u0947\u0902</strong></span>",aboutSubHead:"Get your government scheme here!",aboutHead:"\u0905\u0935\u0932\u094b\u0915\u0928",aboutDesc1:"myScheme \u090f\u0915 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u092a\u094d\u0932\u0948\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u0939\u0948 \u091c\u093f\u0938\u0915\u093e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u090f\u0902 \u0916\u094b\u091c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u201c\u0935\u0928 \u0938\u094d\u091f\u0949\u092a\u201d \u0938\u092e\u093e\u0927\u093e\u0928 \u092a\u094d\u0930\u0927\u093e\u0928 \u0915\u0930\u0928\u093e \u0939\u0948\u0964",aboutDesc2:"\u092f\u0939 \u090f\u0915 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928\u0915\u093e\u0930\u0940 \u090f\u0935\u0902 \u092a\u094d\u0930\u094c\u0926\u094d\u092f\u094b\u0917\u093f\u0915\u0940-\u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u092e\u093e\u0927\u093e\u0928 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948 \u091c\u093f\u0938\u092e\u0947 \u0928\u093e\u0917\u0930\u093f\u0915 \u0915\u0940 \u092f\u094b\u0917\u094d\u092f\u0924\u093e \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964",aboutDesc3:"\u092f\u0939 \u092a\u094b\u0930\u094d\u091f\u0932 \u0928\u093e\u0917\u0930\u093f\u0915\u094b\u0902 \u0915\u094b \u0909\u0928\u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u0940 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u094b \u0916\u094b\u091c\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0947\u0926\u0928 \u0915\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u094b \u092d\u0940 \u0926\u0930\u094d\u0936\u093e\u0924\u093e \u0939\u0948\u0964 myScheme \u0928\u093e\u0917\u0930\u093f\u0915 \u0915\u094b \u092d\u093f\u0928\u094d\u0928 \u092d\u093f\u0928\u094d\u0928 \u0938\u0930\u0915\u093e\u0930\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u094b\u0902 \u092a\u0930 \u091c\u093e\u0928\u0947 \u0915\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u094b \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",vision:"\u0939\u092e\u093e\u0930\u0940 \u0926\u0943\u0937\u094d\u091f\u093f",visionText:"\u0939\u092e\u093e\u0930\u0940 \u0926\u0942\u0930\u0926\u0930\u094d\u0936\u093f\u0924\u093e \u0928\u093e\u0917\u0930\u093f\u0915\u094b\u0902 \u0915\u0947 \u091c\u0940\u0935\u0928 \u0915\u094b \u0906\u0938\u093e\u0928 \u092c\u0928\u093e\u0928\u093e \u0939\u0948",mission:"\u0939\u092e\u093e\u0930\u093e \u092e\u093f\u0936\u0928",mission1:"\u0939\u092e\u093e\u0930\u093e \u092e\u093f\u0936\u0928 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0914\u0930 \u0932\u093e\u092d\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0938\u0930\u0915\u093e\u0930 - \u092f\u0942\u091c\u0930 \u0907\u0902\u091f\u0930\u092b\u0947\u0938 \u0915\u094b \u0938\u0941\u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093f\u0924 \u0915\u0930\u0928\u093e \u0939\u0948\u0964",mission2:"\u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e \u0915\u094b \u0916\u094b\u091c\u0928\u0947 \u0914\u0930 \u0909\u0938\u0915\u093e \u0932\u093e\u092d \u0909\u0920\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0936\u094d\u092f\u0915 \u0938\u092e\u092f \u0914\u0930 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u094b \u0915\u092e \u0915\u0930\u0947\u0902",aboutPageDesc1:"myScheme \u092a\u094d\u0932\u0948\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u0915\u093e \u0928\u093f\u0930\u094d\u092e\u093e\u0923, \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0914\u0930 \u0938\u0902\u091a\u093e\u0932\u0928 \u0928\u0948\u0936\u094d\u200c\u0928\u0932 \u0908-\u0917\u0935\u0930\u094d\u0928\u0947\u0902\u0938 \u0921\u093f\u0935\u0940\u091c\u0928 (NeGD) \u0926\u094d\u0935\u093e\u0930\u093e, \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915\u094d\u0938 \u0914\u0930 \u0938\u0942\u091a\u0928\u093e \u092a\u094d\u0930\u094c\u0926\u094d\u092f\u094b\u0917\u093f\u0915\u0940 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f (MeitY), \u092a\u094d\u0930\u0936\u093e\u0938\u0928\u093f\u0915 \u0938\u0941\u0927\u093e\u0930 \u0914\u0930 \u0932\u094b\u0915 \u0936\u093f\u0915\u093e\u092f\u0924 \u0935\u093f\u092d\u093e\u0917 (DARPG) \u0914\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0924\u0925\u093e \u0930\u093e\u091c\u094d\u092f \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f\u094b\u0902 \u090f\u0935\u0902 \u0935\u093f\u092d\u093e\u0917\u094b\u0902 \u0915\u0947 \u0938\u0939\u092f\u094b\u0917 \u0938\u0947 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964",eligibilityCheckHead:"\u092a\u093e\u0924\u094d\u0930\u0924\u093e \u091c\u093e\u0902\u091a",eligibilityCheckDesc:"\u0906\u092a \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u092e\u093e\u0928\u0926\u0902\u0921\u094b\u0902 \u0914\u0930 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0935\u093f\u0936\u0947\u0937\u0924\u093e\u0913\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0940 \u092a\u093e\u0924\u094d\u0930\u0924\u093e \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902",schemeFinderHead:"\u092f\u094b\u091c\u0928\u093e \u0916\u094b\u091c\u0915",schemeFinderDesc:"\u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u092b\u093f\u0932\u094d\u091f\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0921\u094d\u0930\u093f\u0932 \u0921\u093e\u0909\u0928 \u0915\u0947 \u0938\u093e\u0925 \u0924\u0947\u091c \u0914\u0930 \u0906\u0938\u093e\u0928 \u0916\u094b\u091c",schemeInDetailHead:"\u092f\u094b\u091c\u0928\u093e \u0935\u093f\u0938\u094d\u0924\u093e\u0930 \u0938\u0947",schemeInDetailDesc:"\u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092c\u093e\u0930\u0940\u0915 \u092f\u094b\u091c\u0928\u093e \u0935\u093f\u0935\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u092f\u094b\u091c\u0928\u093e \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u0915\u094b \u0927\u094d\u092f\u093e\u0928 \u0938\u0947 \u0926\u0947\u0916\u0947\u0902",documentRequired:"\u0906\u0935\u0936\u094d\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c",faqHead:"\u0905\u0927\u093f\u0915\u0924\u0930 \u092a\u0942\u091b\u0947 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0938\u0935\u093e\u0932",faqSubHead1:"\u0905\u092a\u0928\u0947 \u0915\u0941\u091b \u0909\u0924\u094d\u0924\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u092e\u093e\u0930\u093e \u0928\u0949\u0932\u0947\u091c\u092c\u0947\u0938 \u0926\u0947\u0916\u0947\u0902!",ques1:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u0915\u094d\u092f\u093e \u0939\u0948 \u0914\u0930 \u092f\u0939 \u0905\u0928\u094d\u092f \u0938\u0930\u0915\u093e\u0930\u0940 \u092a\u094b\u0930\u094d\u091f\u0932 \u0938\u0947 \u0915\u0948\u0938\u0947 \u0905\u0932\u0917 \u0939\u0948?",ans1:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u0915\u0947\u0902\u0926\u094d\u0930 \u0914\u0930 \u0930\u093e\u091c\u094d\u092f/\u0915\u0947\u0902\u0926\u094d\u0930 \u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936 \u0926\u094b\u0928\u094b\u0902 \u0938\u0930\u0915\u093e\u0930\u094b\u0902 \u0938\u0947 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0940 \u090f\u0915 \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u0936\u094d\u0930\u0943\u0902\u0916\u0932\u093e \u0924\u0915 \u092a\u0939\u0941\u0901\u091a \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u092e\u0902\u091a \u0939\u0948\u0964 \u092f\u0939 \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0935\u093f\u0935\u0930\u0923 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0940 \u0916\u094b\u091c \u0914\u0930 \u0916\u094b\u091c \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0935\u0928-\u0938\u094d\u091f\u0949\u092a \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0939\u0948\u0964 \u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u0938\u0930\u0915\u093e\u0930\u0940 \u092a\u094b\u0930\u094d\u091f\u0932\u094b\u0902 \u0915\u0947 \u0935\u093f\u092a\u0930\u0940\u0924, \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0930\u0915\u093e\u0930, \u0930\u093e\u091c\u094d\u092f \u0938\u0930\u0915\u093e\u0930\u094b\u0902 \u0914\u0930 \u0915\u0947\u0902\u0926\u094d\u0930 \u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936\u094b\u0902 \u0915\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u094b \u090f\u0915 \u092e\u0902\u091a \u092a\u0930 \u0932\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u0909\u0928\u0915\u0940 \u092a\u093e\u0924\u094d\u0930\u0924\u093e \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u094b \u0916\u094b\u091c\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",ques2:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u0906\u092e \u0928\u093e\u0917\u0930\u093f\u0915\u094b\u0902 \u0915\u0940 \u0915\u0948\u0938\u0947 \u092e\u0926\u0926 \u0915\u0930\u0947\u0917\u0940?",ans2:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0928\u093e\u0917\u0930\u093f\u0915\u094b\u0902 \u0915\u094b \u090f\u0915 \u0939\u0940 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0940 \u0916\u094b\u091c \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u0915\u094d\u0937\u092e \u092c\u0928\u093e\u0915\u0930 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a \u0915\u094b \u0938\u0930\u0932 \u092c\u0928\u093e\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0938\u0947 \u0909\u0928\u0915\u0940 \u092a\u093e\u0924\u094d\u0930\u0924\u093e \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0908 \u0935\u093f\u092d\u093e\u0917\u0940\u092f \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u094b\u0902 \u092a\u0930 \u091c\u093e\u0928\u0947 \u092f\u093e \u0935\u094d\u092f\u093e\u092a\u0915 \u092f\u094b\u091c\u0928\u093e \u0926\u093f\u0936\u093e\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u094b\u0902 \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0928\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964",ques3:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u0915\u0948\u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u0940 \u0939\u0948?",ans3:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0928\u093e\u0917\u0930\u093f\u0915\u094b\u0902 \u0915\u094b \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0940 \u0916\u094b\u091c \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0938\u0930\u0932 \u0914\u0930 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u0905\u0928\u0941\u0915\u0942\u0932 \u0924\u0940\u0928-\u091a\u0930\u0923\u0940\u092f \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0924\u093e \u0939\u0948 \u091c\u093f\u0938\u0915\u0947 \u0932\u093f\u090f \u0935\u0947 \u092a\u093e\u0924\u094d\u0930 \u0939\u0948\u0902\u0903 \u091a\u0930\u0923 1: \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f, \u0906\u092f, \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0936\u094d\u0930\u0947\u0923\u0940 \u0906\u0926\u093f \u091c\u0948\u0938\u0947 \u092c\u0941\u0928\u093f\u092f\u093e\u0926\u0940 \u0935\u093f\u0935\u0930\u0923 \u0926\u0930\u094d\u091c \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u091a\u0930\u0923 2: \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u0917\u0908 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930, \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0938\u0948\u0915\u0921\u093c\u094b\u0902 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0940 \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u094b \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u091a\u0930\u0923 3: \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u092f\u094b\u0917\u094d\u092f \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0940 \u0938\u0942\u091a\u0940 \u092e\u0947\u0902 \u0938\u0947 \u091a\u092f\u0928 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948 \u0914\u0930 \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940, \u0905\u0915\u094d\u0938\u0930 \u092a\u0942\u091b\u0947 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u092a\u094d\u0930\u0936\u094d\u0928 \u0914\u0930 \u0906\u0935\u0947\u0926\u0928 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0947 \u0938\u093e\u0925 \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u092f\u094b\u091c\u0928\u093e \u092a\u0943\u0937\u094d\u0920 \u0938\u0947 \u0905\u0927\u093f\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948 \u0914\u0930 \u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0906\u0935\u0947\u0926\u0928 \u092f\u0942. \u0906\u0930. \u090f\u0932. \u092a\u0930 \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964",ques4:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0938\u0939\u0940 \u092f\u094b\u091c\u0928\u093e \u091c\u093e\u0928\u0928\u0947 \u0915\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u094d\u092f\u093e \u0939\u0948?",ans4:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0938\u0939\u0940 \u092f\u094b\u091c\u0928\u093e \u0916\u094b\u091c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0928\u093e\u0917\u0930\u093f\u0915 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0915\u0940 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 \u091c\u093e\u0915\u0930 \u0936\u0941\u0930\u0941\u0906\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0939\u094b\u092e\u092a\u0947\u091c \u092a\u0930, \u0909\u0928\u094d\u0939\u0947\u0902 '\u092b\u093e\u0907\u0902\u0921 \u0938\u094d\u0915\u0940\u092e\u094d\u0938 \u092b\u0949\u0930 \u092f\u0942' \u0938\u0941\u0935\u093f\u0927\u093e \u092e\u093f\u0932\u0947\u0917\u0940, \u091c\u094b \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u0909\u092e\u094d\u0930, \u0932\u093f\u0902\u0917, \u0906\u092f \u0938\u094d\u0924\u0930, \u0936\u094d\u0930\u0947\u0923\u0940 \u0906\u0926\u093f \u091c\u0948\u0938\u0947 \u0905\u092a\u0928\u0947 \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0935\u093f\u0935\u0930\u0923 \u0926\u0930\u094d\u091c \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0924\u0940 \u0939\u0948\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0907\u0928 \u0935\u093f\u0935\u0930\u0923\u094b\u0902 \u0915\u094b \u091c\u092e\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0940 \u090f\u0915 \u0938\u0942\u091a\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0947\u0917\u093e\u0964",ques5:"\u0915\u093f\u0938\u0940 \u0935\u093f\u0936\u0947\u0937 \u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092e\u0941\u091d\u0947 \u0905\u092a\u0928\u0940 \u092f\u094b\u091c\u0928\u093e \u092a\u0930 \u0915\u094d\u092f\u093e \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092e\u093f\u0932 \u0938\u0915\u0924\u0940 \u0939\u0948?",ans5:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0935\u094d\u092f\u093e\u092a\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u092a\u093e\u0924\u094d\u0930\u0924\u093e \u092e\u093e\u0928\u0926\u0902\u0921, \u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935\u093f\u0924 \u0932\u093e\u092d, \u0906\u0935\u0947\u0926\u0928 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0914\u0930 \u092f\u094b\u091c\u0928\u093e \u0915\u093e \u0932\u093e\u092d \u0909\u0920\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0936\u094d\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902\u0964 \u0907\u0938\u092e\u0947\u0902 \u092f\u094b\u091c\u0928\u093e \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u092a\u094d\u0930\u0936\u094d\u0928\u094b\u0902 \u0915\u094b \u0938\u0902\u092c\u094b\u0927\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u0905\u0915\u094d\u0938\u0930 \u092a\u0942\u091b\u0947 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u092a\u094d\u0930\u0936\u094d\u0928 (\u090f\u092b. \u090f. \u0915\u094d\u092f\u0942.) \u0905\u0928\u0941\u092d\u093e\u0917 \u092d\u0940 \u0939\u0948\u0964",ques6:"\u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u0930 \u0915\u094c\u0928 \u0938\u0940 \u0935\u094d\u092f\u093e\u092a\u0915 \u0936\u094d\u0930\u0947\u0923\u093f\u092f\u093e\u0901 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0902?",ans6:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u094b \u0909\u0928\u0915\u0947 \u0932\u093e\u092d\u094b\u0902 \u0915\u0940 \u092a\u094d\u0930\u0915\u0943\u0924\u093f \u0914\u0930 \u0932\u0915\u094d\u0937\u093f\u0924 \u0932\u093e\u092d\u093e\u0930\u094d\u0925\u093f\u092f\u094b\u0902 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092e\u094b\u091f\u0947 \u0924\u094c\u0930 \u092a\u0930 15 \u0936\u094d\u0930\u0947\u0923\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0935\u0930\u094d\u0917\u0940\u0915\u0943\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0907\u0928 \u0936\u094d\u0930\u0947\u0923\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0915\u0943\u0937\u093f, \u0917\u094d\u0930\u093e\u092e\u0940\u0923 \u0914\u0930 \u092a\u0930\u094d\u092f\u093e\u0935\u0930\u0923; \u092c\u0948\u0902\u0915\u093f\u0902\u0917, \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0938\u0947\u0935\u093e \u0914\u0930 \u092c\u0940\u092e\u093e; \u0935\u094d\u092f\u0935\u0938\u093e\u092f \u0914\u0930 \u0909\u0926\u094d\u092f\u092e\u093f\u0924\u093e; \u0936\u093f\u0915\u094d\u0937\u093e \u0914\u0930 \u0936\u093f\u0915\u094d\u0937\u093e; \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0914\u0930 \u0915\u0932\u094d\u092f\u093e\u0923; \u0906\u0935\u093e\u0938 \u0914\u0930 \u0906\u0936\u094d\u0930\u092f; \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e, \u0915\u093e\u0928\u0942\u0928 \u0914\u0930 \u0928\u094d\u092f\u093e\u092f; \u0935\u093f\u091c\u094d\u091e\u093e\u0928, \u0906\u0908\u091f\u0940 \u0914\u0930 \u0938\u0902\u091a\u093e\u0930; \u0915\u094c\u0936\u0932 \u0914\u0930 \u0930\u094b\u091c\u0917\u093e\u0930; \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0915\u0932\u094d\u092f\u093e\u0923 \u0914\u0930 \u0938\u0936\u0915\u094d\u0924\u093f\u0915\u0930\u0923; \u0916\u0947\u0932 \u0914\u0930 \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f; \u092a\u0930\u093f\u0935\u0939\u0928 \u0914\u0930 \u092c\u0941\u0928\u093f\u092f\u093e\u0926\u0940 \u0922\u093e\u0902\u091a\u093e; \u092f\u093e\u0924\u094d\u0930\u093e \u0914\u0930 \u092a\u0930\u094d\u092f\u091f\u0928; \u0909\u092a\u092f\u094b\u0917\u093f\u0924\u093e \u0914\u0930 \u0938\u094d\u0935\u091a\u094d\u091b\u0924\u093e; \u0914\u0930 \u092e\u0939\u093f\u0932\u093e \u0914\u0930 \u092c\u093e\u0932 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902\u0964",ques7:"\u0915\u094d\u092f\u093e \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092c\u0939\u0941\u092d\u093e\u0937\u0940 \u0938\u0939\u093e\u092f\u0924\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948?",ans7:"\u0939\u093e\u0902, \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940 \u0938\u0939\u093f\u0924 15 \u092d\u093e\u0937\u093e\u0913\u0902 \u092e\u0947\u0902 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u092d\u093e\u0930\u0924\u0940\u092f \u092d\u093e\u0937\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0938\u092e\u0930\u094d\u0925\u0928 \u091c\u0932\u094d\u0926 \u0939\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964",ques8:"\u0915\u094d\u092f\u093e \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0915\u0947\u0902\u0926\u094d\u0930 \u0914\u0930 \u0930\u093e\u091c\u094d\u092f/\u0915\u0947\u0902\u0926\u094d\u0930 \u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936-\u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0926\u094b\u0928\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948?",ans8:"\u0939\u093e\u0902, \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 4,700 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0930\u0915\u093e\u0930 \u0914\u0930 \u0930\u093e\u091c\u094d\u092f/\u0915\u0947\u0902\u0926\u094d\u0930 \u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936 \u0938\u0930\u0915\u093e\u0930 \u0915\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u094b \u0928\u093f\u0930\u0902\u0924\u0930 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0936\u093e\u092e\u093f\u0932 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0930\u0939\u0947\u0917\u093e\u0964",ques9:"\u092e\u0941\u091d\u0947 \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0915\u094b\u0908 \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092f\u094b\u091c\u0928\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0940\u0964 \u092e\u0941\u091d\u0947 \u0915\u094d\u092f\u093e \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f?",ans9:'\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902, 4,700 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0930\u0915\u093e\u0930 \u0914\u0930 \u0930\u093e\u091c\u094d\u092f/\u0915\u0947\u0902\u0926\u094d\u0930 \u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936 \u0938\u0930\u0915\u093e\u0930 \u0915\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u094b \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0936\u093e\u092e\u093f\u0932 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0928\u093f\u092f\u092e\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u092f\u094b\u091c\u0928\u093e\u090f\u0902 \u091c\u094b\u0921\u093c\u0940 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948\u0902\u0964 \u0928\u093e\u0917\u0930\u093f\u0915 \u092e\u0902\u091a \u092a\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 "\u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902" \u0905\u0928\u0941\u092d\u093e\u0917 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0932\u093e\u092a\u0924\u093e \u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0935\u093f\u0935\u0930\u0923 \u092f\u093e \u0938\u0941\u091d\u093e\u0935 \u0938\u093e\u091d\u093e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964',ques10:"\u092e\u0941\u091d\u0947 \u092e\u0930\u093e\u0920\u0940 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092e\u0947\u0902 \u0915\u0941\u091b \u0924\u094d\u0930\u0941\u091f\u093f\u092f\u093e\u0901 \u092e\u093f\u0932\u0940\u0902\u0964 \u092e\u0941\u091d\u0947 \u0915\u094d\u092f\u093e \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f?",ans10:"\u092f\u0926\u093f \u092f\u094b\u091c\u0928\u093e \u0915\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u0947 \u092e\u0930\u093e\u0920\u0940 \u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0935\u093f\u0938\u0902\u0917\u0924\u093f \u0926\u0947\u0916\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948, \u0924\u094b \u0928\u093e\u0917\u0930\u093f\u0915\u094b\u0902 \u0915\u094b \u0938\u094d\u092a\u0937\u094d\u091f\u0940\u0915\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940 \u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u0915\u093e \u0938\u0902\u0926\u0930\u094d\u092d \u0932\u0947\u0928\u0947 \u0915\u0940 \u0938\u0932\u093e\u0939 \u0926\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092f\u0926\u093f \u0938\u092e\u0938\u094d\u092f\u093e \u092c\u0928\u0940 \u0930\u0939\u0924\u0940 \u0939\u0948, \u0924\u094b \u0938\u092c\u0938\u0947 \u0938\u091f\u0940\u0915 \u0914\u0930 \u0905\u0926\u094d\u092f\u0924\u0928 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0947 \u0932\u093f\u090f \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u092f\u093e \u0935\u093f\u092d\u093e\u0917 \u0915\u0947 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u094b \u0938\u0902\u0926\u0930\u094d\u092d\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u0915\u0947 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924, support-myscheme[at]digitalindia[dot]gov[dot]in \u092a\u0930 \u0908\u092e\u0947\u0932 \u092d\u0947\u091c\u0915\u0930 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u0940 \u0938\u0942\u091a\u0928\u093e \u0926\u0940 \u091c\u093e \u0938\u0915\u0924\u0940 \u0939\u0948\u0964",ques11:"\u092e\u0948\u0902 \u0909\u0928 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0902 \u091c\u093f\u0928\u0915\u0947 \u0924\u0939\u0924 \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0915\u094b \u091b\u093e\u0924\u094d\u0930\u0935\u0943\u0924\u094d\u0924\u093f \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u092f\u0939 \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0938\u0902\u092d\u0935 \u0939\u0948?",ans11:"\u0939\u093e\u0902, \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u090f\u0915 \u092e\u0941\u0916\u094d\u092f \u0936\u092c\u094d\u0926-\u0906\u0927\u093e\u0930\u093f\u0924 \u0916\u094b\u091c \u0938\u0941\u0935\u093f\u0927\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948 \u091c\u094b \u0928\u093e\u0917\u0930\u093f\u0915\u094b\u0902 \u0915\u094b \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u091b\u093e\u0924\u094d\u0930\u0935\u0943\u0924\u094d\u0924\u093f \u0938\u0939\u093f\u0924 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u093f\u090f \u0917\u090f \u0932\u093e\u092d\u094b\u0902 \u0915\u0947 \u092a\u094d\u0930\u0915\u093e\u0930 \u0914\u0930 \u0938\u0940\u092e\u093e \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u094b \u0906\u0938\u093e\u0928\u0940 \u0938\u0947 \u0916\u094b\u091c\u0928\u0947, \u0924\u0932\u093e\u0936\u0928\u0947 \u0914\u0930 \u092a\u0939\u091a\u093e\u0928\u0928\u0947 \u092e\u0947\u0902 \u0938\u0915\u094d\u0937\u092e \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u0964",ques12:"\u092e\u0948\u0902 \u090f\u0915 \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0906\u0935\u0947\u0926\u0928 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0936\u094d\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u0915\u094b \u091c\u093e\u0928\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0902\u0964 \u0915\u094d\u092f\u093e \u092e\u0941\u091d\u0947 \u092f\u0939 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0905\u092a\u0928\u0940 \u092f\u094b\u091c\u0928\u093e \u092a\u0930 \u092e\u093f\u0932 \u0938\u0915\u0924\u0940 \u0939\u0948?",ans12:"\u0939\u093e\u0902, \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092f\u094b\u091c\u0928\u093e \u092e\u0947\u0902 \u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0936\u094d\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u0915\u0940 \u092a\u0942\u0930\u0940 \u0938\u0942\u091a\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0938\u0947 \u0928\u093e\u0917\u0930\u093f\u0915 \u0906\u0938\u093e\u0928\u0940 \u0938\u0947 \u0924\u0948\u092f\u093e\u0930\u0940 \u0914\u0930 \u0906\u0935\u0947\u0926\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",ques13:"\u0915\u094d\u092f\u093e \u092e\u0948\u0902 \u0905\u092a\u0928\u0940 \u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0947\u0926\u0928 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0901?",ans13:"\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902, \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u092f\u093e \u0935\u093f\u092d\u093e\u0917 \u0915\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092f\u094b\u091c\u0928\u093e \u0906\u0935\u0947\u0926\u0928 \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u092a\u0941\u0928\u0930\u094d\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0906\u0917\u093e\u092e\u0940 \u091a\u0930\u0923\u094b\u0902 \u092e\u0947\u0902, \u092f\u0939 \u092a\u0930\u093f\u0915\u0932\u094d\u092a\u0928\u093e \u0915\u0940 \u0917\u0908 \u0939\u0948 \u0915\u093f \u0928\u093e\u0917\u0930\u093f\u0915 \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u094b\u0930\u094d\u091f\u0932/\u0909\u092e\u0902\u0917 \u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0947\u0926\u0928 \u0915\u0930 \u0938\u0915\u0947\u0902\u0917\u0947\u0964",ques14:'\u0915\u093f\u0938\u0940 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0938\u092c\u0938\u0947 \u0909\u092a\u092f\u0941\u0915\u094d\u0924 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0915\u0940 "\u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0916\u094b\u091c" \u0938\u0941\u0935\u093f\u0927\u093e \u092e\u0947\u0902 \u0915\u094d\u092f\u093e \u0935\u093f\u0935\u0930\u0923 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948?',ans14:'\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u0915\u0940 "\u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0916\u094b\u091c" \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u0932\u093f\u0902\u0917, \u0906\u092f\u0941, \u0935\u0948\u0935\u093e\u0939\u093f\u0915 \u0938\u094d\u0925\u093f\u0924\u093f, \u0930\u093e\u091c\u094d\u092f, \u0928\u093f\u0935\u093e\u0938 \u0938\u094d\u0925\u093e\u0928 (\u0936\u0939\u0930\u0940 \u092f\u093e \u0917\u094d\u0930\u093e\u092e\u0940\u0923), \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0936\u094d\u0930\u0947\u0923\u0940, \u0935\u093f\u0915\u0932\u093e\u0902\u0917\u0924\u093e \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f, \u0905\u0932\u094d\u092a\u0938\u0902\u0916\u094d\u092f\u0915 \u0938\u094d\u0925\u093f\u0924\u093f, \u0930\u094b\u091c\u0917\u093e\u0930 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0914\u0930 \u0905\u0928\u094d\u092f \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u091c\u0948\u0938\u0947 \u092c\u0941\u0928\u093f\u092f\u093e\u0926\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0935\u093f\u0935\u0930\u0923 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0915\u0947 \u0932\u093f\u090f \u0938\u092c\u0938\u0947 \u0905\u0927\u093f\u0915 \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0940 \u092a\u0939\u091a\u093e\u0928 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0924\u093e \u0939\u0948\u0964',ques15:'"\u092a\u093e\u0924\u094d\u0930\u0924\u093e \u092a\u094d\u0930\u0936\u094d\u0928\u093e\u0935\u0932\u0940 \u0915\u0940 \u091c\u093e\u0901\u091a \u0915\u0930\u0947\u0902" \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u094d\u092f\u093e \u0939\u0948?',ans15:'"\u091a\u0947\u0915 \u090f\u0932\u093f\u091c\u093f\u092c\u093f\u0932\u093f\u091f\u0940 \u0915\u094d\u0935\u0947\u0936\u094d\u091a\u0928\u0947\u092f\u0930" \u0938\u0941\u0935\u093f\u0927\u093e \u092f\u094b\u091c\u0928\u093e-\u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092a\u093e\u0924\u094d\u0930\u0924\u093e \u092e\u093e\u0928\u0926\u0902\u0921\u094b\u0902 \u092a\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0939\u0948 \u0914\u0930 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u090f\u0915 \u0938\u0930\u0932 \u0939\u093e\u0901/\u0928\u0939\u0940\u0902-\u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u094d\u0930\u0936\u094d\u0928\u093e\u0935\u0932\u0940 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0905\u092a\u0928\u0940 \u092a\u093e\u0924\u094d\u0930\u0924\u093e \u0915\u094b \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u0915\u094d\u0937\u092e \u092c\u0928\u093e\u0924\u0940 \u0939\u0948\u0964 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u0917\u0908 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e\u0913\u0902 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930, \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u091c\u0932\u094d\u0926\u0940 \u0938\u0947 \u0906\u0915\u0932\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0915\u094d\u092f\u093e \u0935\u0947 \u0915\u093f\u0938\u0940 \u0935\u093f\u0936\u0947\u0937 \u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u0932\u093f\u090f \u092a\u093e\u0924\u094d\u0930 \u0939\u0948\u0902\u0964',ques16:"\u0915\u094d\u092f\u093e \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092e\u0947\u0902 \u091a\u0948\u091f\u092c\u0949\u091f \u0915\u0940 \u0938\u0941\u0935\u093f\u0927\u093e \u0939\u0948, \u0914\u0930 \u092f\u0939 \u0928\u093e\u0917\u0930\u093f\u0915\u094b\u0902 \u0915\u0940 \u0915\u0948\u0938\u0947 \u092e\u0926\u0926 \u0915\u0930\u0924\u093e \u0939\u0948?",ans16:"\u0939\u093e\u0902, \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u0928\u0947 \u0928\u093e\u0917\u0930\u093f\u0915\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0940 \u0916\u094b\u091c \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0906\u0935\u093e\u091c-\u0938\u0915\u094d\u0937\u092e, \u092c\u0939\u0941\u092d\u093e\u0937\u0940 \u090f. \u0906\u0908.-\u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u091a\u0948\u091f\u092c\u0949\u091f \u0924\u0948\u0928\u093e\u0924 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u091a\u0948\u091f\u092c\u0949\u091f \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u092a\u094d\u0930\u0936\u094d\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0914\u0930 \u0924\u094d\u0935\u0930\u093f\u0924 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948, \u0938\u0902\u0935\u093e\u0926\u093e\u0924\u094d\u092e\u0915 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092f\u094b\u091c\u0928\u093e \u0915\u0940 \u0916\u094b\u091c \u0915\u094b \u0938\u0930\u0932 \u092c\u0928\u093e\u0924\u093e \u0939\u0948, \u0914\u0930 \u090f\u0915 \u0906\u0915\u0930\u094d\u0937\u0915 \u0914\u0930 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u0905\u0928\u0941\u0915\u0942\u0932 \u0905\u0928\u0941\u092d\u0935 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0915\u0947 \u0938\u0930\u0915\u093e\u0930-\u0928\u093e\u0917\u0930\u093f\u0915 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u094b \u092c\u0922\u093c\u093e\u0924\u093e \u0939\u0948\u0964",ques17:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u0930 \u090f. \u0906\u0908. \u091a\u0948\u091f\u092c\u0949\u091f \u0915\u0940 \u092a\u094d\u0930\u092e\u0941\u0916 \u0935\u093f\u0936\u0947\u0937\u0924\u093e\u090f\u0902 \u0915\u094d\u092f\u093e \u0939\u0948\u0902?",ans17:"\u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u090f\u0906\u0908 \u091a\u0948\u091f\u092c\u0949\u091f \u0906\u0935\u093e\u091c \u0914\u0930 \u092a\u093e\u0920-\u0906\u0927\u093e\u0930\u093f\u0924 \u092c\u093e\u0924\u091a\u0940\u0924, \u0939\u093f\u0902\u0926\u0940 \u0914\u0930 \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940 \u092e\u0947\u0902 \u0926\u094d\u0935\u093f\u092d\u093e\u0937\u0940 \u0938\u092e\u0930\u094d\u0925\u0928, \u0938\u0902\u0926\u0930\u094d\u092d-\u091c\u093e\u0917\u0930\u0942\u0915 \u092c\u093e\u0924\u091a\u0940\u0924, \u0938\u0924\u094d\u0930-\u0906\u0927\u093e\u0930\u093f\u0924 \u091a\u0948\u091f \u0907\u0924\u093f\u0939\u093e\u0938 \u0914\u0930 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e\u0913\u0902 \u0915\u094b \u0915\u0949\u092a\u0940 \u0915\u0930\u0928\u0947 \u0914\u0930 \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0935\u093f\u0915\u0932\u094d\u092a \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0938\u0947 \u090f\u0915 \u0928\u093f\u0930\u094d\u092c\u093e\u0927 \u0914\u0930 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u0905\u0928\u0941\u0915\u0942\u0932 \u0905\u0928\u0941\u092d\u0935 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964",ques18:"\u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0940 \u0935\u093f\u0937\u092f-\u0935\u0938\u094d\u0924\u0941 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092e\u0948\u0902 \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0948\u0938\u0947 \u0926\u0947 \u0938\u0915\u0924\u093e \u0939\u0942\u0902?",ans18:'\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092f\u094b\u091c\u0928\u093e \u092a\u0943\u0937\u094d\u0920 \u0915\u0947 \u0928\u0940\u091a\u0947 \u090f\u0915 "\u0915\u094d\u092f\u093e \u092f\u0939 \u092e\u0926\u0926\u0917\u093e\u0930 \u0925\u093e?" \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0905\u0928\u0941\u092d\u093e\u0917 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0938\u0947 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u094b 1 \u0938\u0947 5 \u0938\u093f\u0924\u093e\u0930\u094b\u0902 \u0924\u0915 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0905\u092a\u0928\u0947 \u0905\u0928\u0941\u092d\u0935, \u0938\u0941\u091d\u093e\u0935 \u092f\u093e \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u093e\u091d\u093e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0908\u092e\u0947\u0932 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 support-myscheme@digitalindia.gov.in \u092a\u0930 \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u092d\u0940 \u092d\u0947\u091c \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u091c\u093f\u0938\u0938\u0947 \u092e\u0902\u091a \u092e\u0947\u0902 \u0928\u093f\u0930\u0902\u0924\u0930 \u0938\u0941\u0927\u093e\u0930 \u0914\u0930 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964',ques19:"\u0915\u094b\u0908 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u092e\u093e\u0908 \u0938\u094d\u0915\u0940\u092e \u092a\u0930 \u0915\u0948\u0938\u0947 \u0938\u093e\u0907\u0928 \u0905\u092a \u092f\u093e \u0938\u093e\u0907\u0928 \u0907\u0928 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948?",ans19:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u0915\u094b \u092e\u0947\u0930\u0940\u092a\u0947\u0939\u091a\u093e\u0928 (\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u090f\u0915\u0932 \u0938\u093e\u0907\u0928-\u0911\u0928) \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915\u0940\u0915\u0943\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948, \u091c\u093f\u0938\u0938\u0947 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0905\u092a\u0928\u0940 \u092e\u0947\u0930\u0940\u092a\u0947\u0939\u091a\u093e\u0928 \u0938\u093e\u0916 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0938\u093e\u0907\u0928 \u0905\u092a \u092f\u093e \u0938\u093e\u0907\u0928 \u0907\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u092c\u093f\u0928\u093e \u0938\u093e\u0907\u0928 \u0907\u0928 \u0915\u093f\u090f \u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u094b \u092c\u094d\u0930\u093e\u0909\u091c\u093c \u0914\u0930 \u0916\u094b\u091c \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u093e\u0932\u093e\u0901\u0915\u093f, \u0938\u093e\u0907\u0928 \u0907\u0928 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932, \u092c\u0941\u0915\u092e\u093e\u0930\u094d\u0915 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u094b \u0938\u0947\u0935 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0905\u092a\u0928\u0947 \u0938\u0939\u0947\u091c\u0947 \u0917\u090f \u0935\u093f\u0935\u0930\u0923\u094b\u0902 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0905\u0928\u0941\u0936\u0902\u0938\u093e\u090f\u0901 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",ques20:"\u092e\u0948\u0902 \u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0915\u093f\u0938\u0940 \u092f\u094b\u091c\u0928\u093e \u0915\u094b \u0915\u0948\u0938\u0947 \u0916\u094b\u091c \u0938\u0915\u0924\u093e \u0939\u0942\u0902?",ans20:"\u092e\u093e\u092f \u0938\u094d\u0915\u0940\u092e \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u094b \u0916\u094b\u091c\u0928\u0947 \u0914\u0930 \u0916\u094b\u091c\u0928\u0947 \u0915\u0947 \u0915\u0908 \u0924\u0930\u0940\u0915\u0947 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u0928\u093e\u092e \u092f\u093e \u092e\u0941\u0916\u094d\u092f \u0936\u092c\u094d\u0926\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0916\u094b\u091c, \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0938\u093f\u092b\u093e\u0930\u093f\u0936\u0947\u0902, \u0930\u093e\u091c\u094d\u092f/\u0915\u0947\u0902\u0926\u094d\u0930 \u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936 \u092f\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0930\u0915\u093e\u0930 \u0915\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u091b\u093e\u0928\u0928\u093e, \u092f\u094b\u091c\u0928\u093e \u0932\u093e\u092d \u0936\u094d\u0930\u0947\u0923\u093f\u092f\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u092c\u094d\u0930\u093e\u0909\u091c\u093c \u0915\u0930\u0928\u093e \u0914\u0930 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u090f\u0906\u0908-\u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u091a\u0948\u091f\u092c\u0949\u091f \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u093e 