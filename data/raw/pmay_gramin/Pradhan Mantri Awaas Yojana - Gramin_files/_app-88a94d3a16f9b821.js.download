3. \u09a6\u09be\u09af\u09bc\u09ac\u09a6\u09cd\u09a7\u09a4\u09be\u09f0 \u09b8\u09c0\u09ae\u09be\u09ac\u09a6\u09cd\u09a7\u09a4\u09be"),(0,xe.Z)(te,"urlSubHeading14","14. \u0997\u09ae\u09cd\u09ad\u09c0\u09f0\u09a4\u09be"),(0,xe.Z)(te,"urlSubHeading15","15. \u09aa\u09cd\u09f0\u09b6\u09be\u09b8\u09a8\u09bf\u0995 \u0986\u0987\u09a8, \u0985\u09a7\u09bf\u0995\u09be\u09f0 \u0986\u09f0\u09c1 \u09ac\u09bf\u09ac\u09be\u09a6 \u09a8\u09bf\u09b7\u09cd\u09aa\u09a4\u09cd\u09a4\u09bf"),(0,xe.Z)(te,"urlSubHeading1Text","<span> 1.1 \u09ae\u09be\u0987\u099a\u09bf\u09ae \u0987\u0989. \u0986\u09f0. \u098f\u09b2. \u0987\u09af\u09bc\u09be\u09f0 \u09ae\u09c2\u09b2 \u09f0\u09c2\u09aa\u09a4 \u09a5\u09be\u0995\u09bf\u09ac \u09b2\u09be\u0997\u09bf\u09ac, \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0\u0995\u09be\u09f0\u09c0\u09b8\u0995\u09b2\u0995 \u099a\u09f0\u0995\u09be\u09f0\u09c0 \u09ae\u09be\u0987\u099a\u09bf\u09ae \u09aa '\u09f0\u09cd\u099f\u09c7\u09b2\u09b2\u09c8 \u09aa\u09f0\u09bf\u09f1\u09f0\u09cd\u09a4\u09a8 \u09a8\u0995\u09f0\u09be\u0995\u09c8, \u099a\u09c1\u099f\u09bf \u09a8\u0995\u09f0\u09be\u0995\u09c8, \u09ae\u09be\u09b8\u09cd\u0995\u09bf\u0982 \u09a8\u0995\u09f0\u09be\u0995\u09c8 \u09ac\u09be \u0986\u0987\u09ab\u09cd\u09f0\u09c7\u09ae \u09ac\u09be \u09aa\u09c1\u09a8\u09f0\u09a8\u09bf\u09f0\u09cd\u09a6\u09c7\u09b6 \u09b8\u09c7\u09f1\u09be\u0995\u09c7 \u09a7\u09f0\u09bf \u09af\u09bf\u0995\u09cb\u09a8\u09cb \u09b8\u09ae\u09b2 \u098f\u09ae\u09cd\u09ac\u09c7\u09a1 \u09a8\u0995\u09f0\u09be\u0995\u09c8 \u09a8\u09bf\u09f0\u09cd\u09a6\u09c7\u09b6\u09bf\u09a4 \u0995\u09f0\u09bf\u09ac \u09b2\u09be\u0997\u09bf\u09ac\u0964 </span> <span> 1.2 \u0987\u0989. \u0986\u09f0. \u098f\u09b2.-\u098f \u09b8\u09a6\u09be\u09af\u09bc \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0\u0995\u09be\u09f0\u09c0\u09b8\u0995\u09b2\u0995 \u0995\u09cb\u09a8\u09cb \u09ae\u09a7\u09cd\u09af\u09b8\u09cd\u09a5 \u09aa\u09c3\u09b7\u09cd\u09a0\u09be, \u09aa\u09aa-\u0986\u09aa \u09ac\u09be \u09b8\u09ae\u09b2 \u09b8\u09cd\u09a4\u09f0 \u0985\u09ac\u09bf\u09b9\u09a8\u09c7 \u099a\u09f0\u0995\u09be\u09f0\u09c0 myScheme.gov.in \u09f1\u09c7\u09ac\u099b\u09be\u0987\u099f\u09b2\u09c8 \u09a8\u09bf\u09f0\u09cd\u09a6\u09c7\u09b6\u09bf\u09a4 \u0995\u09f0\u09bf\u09ac \u09b2\u09be\u0997\u09bf\u09ac\u0964 </span> <span> 1.3 \u0986\u09ae\u09bf \u09ae\u09be\u0987\u099a\u09bf\u09ae\u09f0 \u09aa\u09c3\u09b7\u09cd\u09a0\u09be\u09b8\u09ae\u09c2\u09b9\u0995 \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u099b\u09be\u0987\u099f\u09f0 \u09ab\u09cd\u09f0\u09c7\u09ae\u09a4 \u09b2' \u09a1 \u0995\u09f0\u09be\u09f0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a8\u09bf\u09a6\u09bf\u0993\u0981\u0964 \u09ae\u09be\u0987\u099a\u09bf\u09ae \u09f1\u09c7\u09ac\u099b\u09be\u0987\u099f\u09f0 \u09b8\u09c8\u09a4\u09c7 \u099c\u09a1\u09bc\u09bf\u09a4 \u09aa\u09c3\u09b7\u09cd\u09a0\u09be\u09b8\u09ae\u09c2\u09b9 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0\u0995\u09be\u09f0\u09c0\u09f0\u09c0\u09f0 \u09a8\u09a4\u09c1\u09a8\u0995\u09c8 \u0996\u09cb\u09b2\u09be \u09ac\u09cd\u09f0\u09be\u0989\u099c\u09be\u09f0 \u0989\u0987\u09a3\u09cd\u09a1\u09cb\u09a4 \u09b2 '\u09a1 \u0995\u09f0\u09bf\u09ac \u09b2\u09be\u0997\u09bf\u09ac\u0964"),(0,xe.Z)(te,"urlSubHeading2Text",'<span> 2.1 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0\u0995\u09be\u09f0\u09c0\u09f0 \u09a4\u09a5\u09cd\u09af \u0986\u09f0\u09c1 \u0987\u0989. \u0986\u09f0. \u098f\u09b2.-\u09f0 \u0985\u0996\u09a3\u09cd\u09a1\u09a4\u09be \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09bf\u09a4 \u0995\u09f0\u09bf\u09ac\u09b2\u09c8 \u09aa\u0995\u09cd\u09b7\u0987 \u098f\u0987\u099a. \u099f\u09bf. \u099f\u09bf. \u09aa\u09bf. \u098f\u099b. \u098f\u09a8\u0995\u09cd\u09f0\u09bf\u09aa\u09b6\u09cd\u09af\u09a8, \u09ab\u09be\u09af\u09bc\u09be\u09f0\u09f1\u09be\u09b2 \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09be, \u0986\u09f0\u09c1 \u09a8\u09bf\u09af\u09bc\u09ae\u09c0\u09af\u09bc\u09be \u09aa\u09cd\u09f0\u09f1\u09c7\u09b6 \u09aa\u09f0\u09c0\u0995\u09cd\u09b7\u09be\u0995\u09c7 \u09a7\u09f0\u09bf \u09b6\u0995\u09cd\u09a4\u09bf\u09b6\u09be\u09b2\u09c0 \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09be \u09aa\u09cd\u09f0\u099f "\u0995\u09b2\u09b8\u09ae\u09c2\u09b9 \u0995\u09be\u09f0\u09cd\u09af\u0995\u09f0\u09c0 \u0995\u09f0\u09bf\u09ac \u09b2\u09be\u0997\u09bf\u09ac\u0964 </span> <span> 2.2 \u09aa\u0995\u09cd\u09b7\u0987 \u09f1\u09c7\u09ac \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09be \u09a6\u09c1\u09f0\u09cd\u09ac\u09b2\u09a4\u09be\u09f0 \u09ac\u09be\u09ac\u09c7 \u0985". \u09a1\u09ac\u09cd\u09b2\u09bf\u0989. \u098f. \u098f\u099b. \u09aa\u09bf. \u09b6\u09c0\u09f0\u09cd\u09b7 10\u0995\u09c7 \u09a7\u09f0\u09bf \u09aa\u09cd\u09f0\u09a4\u09bf\u09b7\u09cd\u09a0\u09bf\u09a4 \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09be \u09ae\u09be\u09a8\u09a6\u09a3\u09cd\u09a1\u09b8\u09ae\u09c2\u09b9 \u09ae\u09be\u09a8\u09bf \u099a\u09b2\u09bf\u09ac \u09b2\u09be\u0997\u09bf\u09ac\u0964 </span> <span> 2.3 \u09af\u09bf\u0995\u09cb\u09a8\u09cb \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09be \u0989\u09b2\u0982\u0998\u09a8\u09f0 \u09ac\u09bf\u09b7\u09af\u09bc\u09c7 24 \u0998\u09a3\u09cd\u099f\u09be\u09f0 \u09ad\u09bf\u09a4\u09f0\u09a4 \u09ae\u09be\u0987\u099a\u09bf\u09ae \u09a6\u09b2\u09b2\u09c8 \u0985\u09f1\u0997\u09a4 \u0995\u09f0\u09bf\u09ac \u09b2\u09be\u0997\u09bf\u09ac, \u0986\u09f0\u09c1 \u098f\u0987 \u0989\u09b2\u0982\u0998\u09a8 \u09b9\u09cd\u09f0\u09be\u09b8 \u0995\u09f0\u09bf\u09ac\u09b2\u09c8 \u09a4\u09be\u09ce\u0995\u09cd\u09b7\u09a3\u09bf\u0995 \u09ac\u09cd\u09af\u09f1\u09b8\u09cd\u09a5\u09be \u0997\u09cd\u09f0\u09b9\u09a3 \u0995\u09f0\u09bf\u09ac \u09b2\u09be\u0997\u09bf\u09ac\u0964 </span> <span> 2.4 \u09a4\u09c3\u09a4\u09c0\u09af\u09bc \u09aa\u0995\u09cd\u09b7\u09f0 \u09ae\u09c2\u09b2\u09cd\u09af\u09be\u09af\u09bc\u09a8\u0995\u09c7 \u09a7\u09f0\u09bf \u09a8\u09bf\u09af\u09bc\u09ae\u09c0\u09af\u09bc\u09be \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09be \u0985\u09a1\u09bf\u099f\u09b8\u09ae\u09c2\u09b9 \u0985\u09a8\u09c1\u09b7\u09cd\u09a0\u09bf\u09a4 \u0995\u09f0\u09bf\u09ac \u09b2\u09be\u0997\u09bf\u09ac \u09af\u09be\u09a4\u09c7 \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09be \u09ae\u09be\u09a8\u09a6\u09a3\u09cd\u09a1\u09b8\u09ae\u09c2\u09b9\u09f0 \u09b8\u09c8\u09a4\u09c7 \u0985\u09ac\u09cd\u09af\u09be\u09b9\u09a4 \u0985\u09a8\u09c1\u09aa\u09be\u09b2\u09a8 \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09f0\u09be \u09b9\u09af\u09bc\u0964'),(0,xe.Z)(te,"urlSubHeading3Text","<span> <span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span> </span>"),(0,xe.Z)(te,"urlSubHeading4Text","<span> 4.1 \u0987\u0989. \u0986\u09f0. \u098f\u09b2. \u09a4\u09c3\u09a4\u09c0\u09af\u09bc \u09aa\u0995\u09cd\u09b7\u09f0 \u09f1\u09c7\u09ac\u099b\u09be\u0987\u099f\u09f0 \u09aa\u09cd\u09f0\u09be\u09b8\u0982\u0997\u09bf\u0995 \u0985\u0982\u09b6\u09b8\u09ae\u09c2\u09b9\u09a4 \u09b8\u09cd\u09a5\u09be\u09aa\u09a8 \u0995\u09f0\u09bf\u09ac \u09b2\u09be\u0997\u09bf\u09ac \u09af\u09bf \u09ae\u09be\u0987\u099a\u09bf\u09ae\u09f0 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af \u0986\u09f0\u09c1 \u09b8\u09c7\u09f1\u09be\u09b8\u09ae\u09c2\u09b9\u09f0 \u09b8\u09c8\u09a4\u09c7 \u09b8\u0982\u09b2\u0997\u09cd\u09a8, \u09a6\u09c3\u09b6\u09cd\u09af\u09ae\u09be\u09a8, \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0\u0995\u09be\u09f0\u09c0-\u0985\u09a8\u09c1\u0995\u09c2\u09b2 \u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09f0\u09b8\u09ae\u09c2\u09b9\u0995 \u0985\u0997\u09cd\u09f0\u09be\u09a7\u09bf\u0995\u09be\u09f0 \u09a6\u09bf\u09af\u09bc\u09be\u09f0 \u09b8\u09c8\u09a4\u09c7 (\u0989\u09a6\u09be\u09b9\u09f0\u09a3\u09b8\u09cd\u09ac\u09f0\u09c2\u09aa\u09c7, \u09ad\u09be\u0981\u099c\u09f0 \u0993\u09aa\u09f0\u09a4 \u09ac\u09be \u098f\u0995 \u09b8\u09ae\u09f0\u09cd\u09aa\u09bf\u09a4 \u099a\u09f0\u0995\u09be\u09f0\u09c0 \u09b8\u09c7\u09f1\u09be \u09b6\u09be\u0996\u09be\u09f0 \u09ad\u09bf\u09a4\u09f0\u09a4)\u0964"),(0,xe.Z)(te,"urlSubHeading5Text","5. 1 \u0986\u09aa\u09c1\u09a8\u09bf \u09b8\u0995\u09b2\u09cb \u09aa\u09cd\u09f0\u09af\u09cb\u099c\u09cd\u09af \u0986\u0987\u09a8, \u09a8\u09bf\u09af\u09bc\u09ae\u09be\u09f1\u09b2\u09c0, \u0986\u09f0\u09c1 \u09a4\u09c3\u09a4\u09c0\u09af\u09bc \u09aa\u0995\u09cd\u09b7\u09f0 \u0985\u09a7\u09bf\u0995\u09be\u09f0 (\u09a4\u09a5\u09cd\u09af \u09ac\u09be \u099b\u09ab\u09cd\u099f\u09f1\u09c7\u09f0, \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u0986\u09a6\u09bf\u09f0 \u0986\u09ae\u09a6\u09be\u09a8\u09bf \u09ac\u09be \u09f0\u09aa\u09cd\u09a4\u09be\u09a8\u09bf \u09b8\u09ae\u09cd\u09aa\u09f0\u09cd\u0995\u09c0\u09af\u09bc \u09b8\u09c0\u09ae\u09be\u09ac\u09a6\u09cd\u09a7\u09a4\u09be \u0986\u0987\u09a8\u0995\u09c7 \u09a7\u09f0\u09bf) \u09ae\u09be\u09a8\u09bf \u099a\u09b2\u09bf\u09ac\u0964"),(0,xe.Z)(te,"urlSubHeading6Text","<span> 6.1 \u09ae\u09be\u0987\u099a\u09bf\u09ae \u0987\u0989. \u0986\u09f0. \u098f\u09b2. \u0995\u09cb\u09a8\u09cb \u09a7\u09f0\u09a3\u09f0 \u09aa\u09cd\u09f0\u09a4\u09be\u09f0\u09a3\u09be\u09a6\u09be\u09af\u09bc\u0995, \u09ac\u09bf\u09ad\u09cd\u09b0\u09be\u09a8\u09cd\u09a4\u09bf\u09ae\u09c2\u09b2\u0995 \u09ac\u09be \u09ac\u09c7\u0986\u0987\u09a8\u09c0\u09ad\u09be\u09f1\u09c7 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0\u09bf\u09ac \u09a8\u09cb\u09f1\u09be\u09f0\u09bf\u09ac, \u09af\u09be\u09f0 \u09ad\u09bf\u09a4\u09f0\u09a4 \u0986\u099b\u09c7 \u09ac\u09c7\u0986\u0987\u09a8\u09c0 \u09aa\u09c1\u09a8\u09f0 \u09a8\u09bf\u09f0\u09cd\u09a6\u09c7\u09b6\u09a8\u09be, \u09ab\u09bf\u099b\u09bf\u0982 \u09ac\u09be \u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af \u09ac\u09bf\u09a6\u09cd\u09ac\u09c7\u09b7\u09aa\u09c2\u09f0\u09cd\u09a3 \u0995\u09be\u09f0\u09cd\u09af\u0995\u09b2\u09be\u09aa\u0964 \u0986\u09aa\u09cb\u09a8\u09be\u0995 \u0987\u0989. \u0986\u09f0. \u098f\u09b2. \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0\u09be\u09a4 \u098f\u09a8\u09c7 \u09a7\u09f0\u09a3\u09c7 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0\u09be\u09f0 \u09aa\u09f0\u09be \u09a8\u09bf\u09b7\u09bf\u09a6\u09cd\u09a7 \u0995\u09f0\u09be \u09b9\u09c8\u099b\u09c7 \u09af\u09bf \u09ae\u09be\u0987\u099a\u09bf\u09ae\u09f0 \u09ac\u09bf\u09b6\u09cd\u09ac\u09be\u09b8\u09af\u09cb\u0997\u09cd\u09af\u09a4\u09be \u09ad\u09c1\u09b2\u0995\u09c8 \u0989\u09aa\u09b8\u09cd\u09a5\u09be\u09aa\u09a8 \u0995\u09f0\u09c7 \u09ac\u09be \u09b9\u09cd\u09f0\u09be\u09b8 \u0995\u09f0\u09c7\u0964 </span> <span> 6.2 \u09ae\u09be\u0987\u099a\u09bf\u09ae\u09f0 \u09aa\u09c2\u09f0\u09cd\u09ac \u09b2\u09bf\u0996\u09bf\u09a4 \u09b8\u09a8\u09cd\u09ae\u09a4\u09bf \u0985\u09ac\u09bf\u09b9\u09a8\u09c7 \u09ac\u09be\u09a3\u09bf\u099c\u09cd\u09af\u09bf\u0995 \u09ac\u09bf\u099c\u09cd\u099e\u09be\u09aa\u09a8, \u09aa\u09cd\u09f0\u099a\u09be\u09f0 \u09ac\u09be \u09b2\u09be\u09ad-\u099a\u09be\u09b2\u09bf\u09a4 \u0995\u09be\u09f0\u09cd\u09af\u0995\u09b2\u09be\u09aa\u09a4 \u0987\u0989. \u0986\u09f0. \u098f\u09b2. \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0\u09be \u09a8\u09b9 '\u09ac\u0964"),(0,xe.Z)(te,"urlSubHeading7Text",'\u0986\u09aa\u09c1\u09a8\u09bf ("\u0995\u09cd\u09b7\u09a4\u09bf\u09aa\u09c2\u09b0\u09a3\u09ae\u09c2\u09b2\u0995 \u09aa\u0995\u09cd\u09b7" \u09b9\u09bf\u099a\u09be\u09aa\u09c7), \u0986\u0987\u09a8\u09c7 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a6\u09bf\u09af\u09bc\u09be \u09b8\u09f0\u09cd\u09ac\u09be\u09a7\u09bf\u0995 \u09aa\u09f0\u09bf\u09ae\u09be\u09a3\u09b2\u09c8\u0995\u09c7, \u0986\u09ae\u09be\u0995 \u09f0\u0995\u09cd\u09b7\u09be \u0995\u09f0\u09bf\u09ac, \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09be \u09a6\u09bf\u09ac \u0986\u09f0\u09c1 \u0995\u09cd\u09b7\u09a4\u09bf\u09aa\u09c2\u09b0\u09a3\u09ae\u09c2\u09b2\u0995 \u09aa\u09f0\u09bf\u09b6\u09cb\u09a7 \u0995\u09f0\u09bf\u09ac ("\u0995\u09cd\u09b7\u09a4\u09bf\u09aa\u09c2\u09b0\u09a3\u09ae\u09c2\u09b2\u0995 \u09aa\u0995\u09cd\u09b7" \u09b9\u09bf\u099a\u09be\u09aa\u09c7)\u0964 \u0995\u09cd\u09b7\u09a4\u09bf\u09aa\u09c2\u09b0\u09a3\u09ae\u09c2\u09b2\u0995 \u09aa\u0995\u09cd\u09b7\u0987 \u0995\u09cd\u09b7\u09a4\u09bf\u09aa\u09c2\u09b0\u09a3\u09ae\u09c2\u09b2\u0995 \u09aa\u0995\u09cd\u09b7 \u0986\u09f0\u09c1 \u09a4\u09c7\u0993\u0981\u09b2\u09cb\u0995\u09f0 \u09ac\u09bf\u09b7\u09af\u09bc\u09be, \u0995\u09f0\u09cd\u09ae\u099a\u09be\u09f0\u09c0, \u09b8\u099e\u09cd\u099a\u09be\u09b2\u0995, \u0986\u09f0\u09c1 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6\u09a6\u09be\u09a4\u09be\u09b8\u0995\u09b2\u0995 \u09af\u09bf\u0995\u09cb\u09a8\u09cb \u0986\u09f0\u09c1 \u09b8\u0995\u09b2\u09cb \u09aa\u09cd\u09f0\u09ae\u09be\u09a3\u09bf\u09a4 \u09ac\u09be \u0985\u09ad\u09bf\u09af\u09c1\u0995\u09cd\u09a4 \u0995\u09cd\u09b7\u09a4\u09bf, \u09a6\u09be\u09ac\u09c0, \u0995\u09cd\u09b7\u09a4\u09bf, \u09a6\u09be\u09af\u09bc\u09ac\u09a6\u09cd\u09a7\u09a4\u09be, \u09b8\u09c1\u09a4, \u09ac\u0981\u099f\u09be, \u09ac\u09bf\u099a\u09be\u09f0, \u09a8\u09bf\u09b7\u09cd\u09aa\u09a4\u09cd\u09a4\u09bf, \u099c\u09f0\u09bf\u09ae\u09a8\u09be, \u099c\u09f0\u09bf\u09ae\u09a8\u09be, \u0986\u09f0\u09c1 \u09af\u09bf\u0995\u09cb\u09a8\u09cb \u09a4\u09c3\u09a4\u09c0\u09af\u09bc \u09aa\u0995\u09cd\u09b7\u09f0 \u09a6\u09be\u09ac\u09c0, \u0995\u09be\u09f0\u09cd\u09af\u09cd\u09af, \u0995\u09be\u09f0\u09cd\u09af\u09cd\u09af\u09f0 \u0995\u09be\u09f0\u09a3 \u09ac\u09be \u0997\u09cb\u099a\u09f0\u09f0 \u09ab\u09b2\u09a4 \u0989\u09a6\u09cd\u09ad\u09f1 \u09b9\u09cb\u09f1\u09be \u0986\u09aa\u09cb\u099a\u09f0 \u09aa\u09f0\u09be \u09a8\u09bf\u09f0\u09be\u09aa\u09a6 \u0995\u09f0\u09bf \u09f0\u09be\u0996\u09bf\u09ac\u0964 / \u09b8\u09cd\u09aa\u09cd\u09af\u09be\u09a8>'),(0,xe.Z)(te,"urlSubHeading8Text","8. 1 \u098f\u09aa\u09bf\u0986\u0987\u09ac\u09cb\u09f0 \u0995\u09cb\u09a8\u09cb \u09a7\u09f0\u09a3\u09f0 \u09f1\u09be\u09f0\u09c7\u09a3\u09cd\u099f\u09bf \u0985\u09ac\u09bf\u09b9\u09a8\u09c7 \"\u09af\u09c7\u09a8\u09c7\u09a6\u09f0\u09c7 \u0986\u099b\u09c7\" \u09aa\u09cd\u09f0\u09a6\u09be\u09a8 \u0995\u09f0\u09be \u09b9\u09af\u09bc\u0964 \u0986\u09ae\u09bf \u09b8\u0995\u09b2\u09cb \u09b8\u09cd\u09aa\u09b7\u09cd\u099f \u09ac\u09be \u0985\u09a8\u09cd\u09a4\u09f0\u09cd\u09a8\u09bf\u09b9\u09bf\u09a4 \u09f1\u09be\u09f0\u09c7\u09a3\u09cd\u099f\u09bf \u0985\u09b8\u09cd\u09ac\u09c0\u0995\u09be\u09f0 \u0995\u09f0\u09cb\u0981, \u09af\u09be\u09f0 \u09ad\u09bf\u09a4\u09f0\u09a4 \u0986\u099b\u09c7 \u09ac\u09cd\u09af\u09f1\u09b8\u09be\u09af\u09bc\u09c0\u0995\u09f0\u09a3\u09f0 \u09f1\u09be\u09f0\u09c7\u09a3\u09cd\u099f\u09bf, \u0995\u09cb\u09a8\u09cb \u09ac\u09bf\u09b6\u09c7\u09b7 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u09f0 \u09ac\u09be\u09ac\u09c7 \u0989\u09aa\u09af\u09c1\u0995\u09cd\u09a4\u09a4\u09be, \u0986\u09f0\u09c1 \u0989\u09b2\u0982\u0998\u09a8 \u09a8\u0995\u09f0\u09be\u09f0 \u09f1\u09be\u09f0\u09c7\u09a3\u09cd\u099f\u09bf\u0964 8.2 \u099a\u09be\u0987\u09ac\u09be\u09f0 \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09be\u09f0 \u09ad\u09be\u09ac\u09c1\u0995\u09bf, \u09b8\u09c1\u09a8\u09be\u09ae\u09f0 \u0995\u09cd\u09b7\u09a4\u09bf, \u09ac\u09be \u0986\u0987\u09a8\u09c0 \u09aa\u09f0\u09bf\u09a3\u09be\u09ae\u0995\u09c7 \u09a7\u09f0\u09bf \u09b8\u09c0\u09ae\u09bf\u09a4 \u09a8\u09cb\u09b9\u09cb\u09f1\u09be\u0995\u09c8 \u09ae\u09be\u0987\u099a\u09bf\u09ae \u0987\u0989. \u0986\u09f0. \u098f\u09b2. \u09b9\u09cb\u09b7\u09cd\u099f \u0995\u09f0\u09be\u09f0 \u09b8\u09c8\u09a4\u09c7 \u099c\u09a1\u09bc\u09bf\u09a4 \u09af\u09bf\u0995\u09cb\u09a8\u09cb \u0986\u09f0\u09c1 \u09b8\u0995\u09b2\u09cb \u09ac\u09bf\u09aa\u09a6\u09be\u09b6\u0982\u0995\u09be\u09f0 \u09ac\u09be\u09ac\u09c7 \u09a6\u09b2 \u098f\u0995\u09ae\u09be\u09a4\u09cd\u09f0 \u09a6\u09be\u09af\u09bc\u09ac\u09a6\u09cd\u09a7 \u09b9 '\u09ac\u0964 8.3 \u09ae\u09be\u0987\u099a\u09bf\u09ae \u0987\u0989. \u0986\u09f0. \u098f\u09b2. \u09b9\u09cb\u09b7\u09cd\u099f \u0995\u09f0\u09be\u09f0 \u09b8\u09c8\u09a4\u09c7 \u09b8\u09ae\u09cd\u09aa\u09f0\u09cd\u0995\u09bf\u09a4 \u09a6\u09b2\u09f0 \u0995\u09be\u09f0\u09cd\u09af\u09cd\u09af \u09ac\u09be \u09ad\u09c1\u09b2\u09f0 \u09aa\u09f0\u09be \u0989\u09a6\u09cd\u09ad\u09f1 \u09b9\u09cb\u09f1\u09be \u0995\u09cb\u09a8\u09cb \u0995\u09cd\u09b7\u09a4\u09bf, \u09b2\u09cb\u0995\u099a\u09be\u09a8 \u09ac\u09be \u09a6\u09be\u09af\u09bc\u09ac\u09a6\u09cd\u09a7\u09a4\u09be\u09f0 \u09ac\u09be\u09ac\u09c7 \u09a6\u09be\u09af\u09bc\u09ac\u09a6\u09cd\u09a7 \u09a8\u09b9' \u09ac\u0964"),(0,xe.Z)(te,"urlSubHeading9Text","<\u09b8\u09cd\u09aa\u09cd\u09af\u09be\u09a8> 9.1 \u09ae\u09be\u0987\u099b\u0995\u09bf\u09ae\u09c7 \u09a4\u09be\u09ce\u0995\u09cd\u09b7\u09a3\u09bf\u0995\u09ad\u09be\u09f1\u09c7 \u0986\u0981\u09a4\u09f0\u09cb\u09f1\u09be\u09f0 \u0986\u09a6\u09c7\u09b6 \u09a6\u09bf\u09af\u09bc\u09be\u09f0 \u0985\u09a7\u09bf\u0995\u09be\u09f0 \u09b8\u0982\u09f0\u0995\u09cd\u09b7\u09bf\u09a4 \u0995\u09f0\u09c7 \u0986\u09f0\u09c1 \u09af\u09a6\u09bf \u0986\u09aa\u09c1\u09a8\u09bf \u0995\u09cb\u09a8\u09cb \u099a\u09f0\u09cd\u09a4\u09be\u09f1\u09b2\u09c0 \u0989\u09b2\u0982\u0998\u09a8 \u0995\u09f0\u09be \u09a6\u09c7\u0996\u09be \u09af\u09be\u09af\u09bc \u09a4\u09c7\u09a8\u09cd\u09a4\u09c7 \u0986\u09aa\u09c1\u09a8\u09bf \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09f1\u09c7\u09ac\u099b\u09be\u0987\u099f\u09f0 \u09aa\u09f0\u09be \u0987\u0989. \u0986\u09f0. \u098f\u09b2. \u09a4\u09ce\u0995\u09cd\u09b7\u09a3\u09be\u09a4 \u0986\u0981\u09a4\u09f0\u09be\u09ac \u09b2\u09be\u0997\u09bf\u09ac\u0964"),(0,xe.Z)(te,"urlSubHeading10Text","<span> \u09ae\u09be\u0987\u099b\u0995\u09bf\u09ae\u09c7 \u09a8\u09bf\u099c\u09f0 \u09ac\u09bf\u09ac\u09c7\u099a\u09a8\u09be\u09ae\u09a4\u09c7 \u0987\u0989. \u0986\u09f0. \u098f\u09b2. \u09b8\u09cd\u09a5\u09be\u09aa\u09a8, \u09b8\u09c1\u09f0\u0995\u09cd\u09b7\u09be \u09ac\u09cd\u09af\u09f1\u09b8\u09cd\u09a5\u09be, \u0986\u09f0\u09c1 \u09b8\u09ae\u09b2 \u09b9\u09cb\u09b7\u09cd\u099f\u09bf\u0982\u09f0 \u09ac\u09be\u09ac\u09c7 \u09b8\u09f0\u09cd\u09ac\u09b6\u09cd\u09f0\u09c7\u09b7\u09cd\u09a0 \u0985\u09a8\u09c1\u09b6\u09c0\u09b2\u09a8\u0995\u09c7 \u09a7\u09f0\u09bf \u098f\u0987 \u099a\u09f0\u09cd\u09a4\u09b8\u09ae\u09c2\u09b9 \u09ae\u09be\u09a8\u09bf \u099a\u09b2\u09be\u09a4 \u09aa\u0995\u09cd\u09b7\u0995 \u09b8\u09b9\u09be\u09af\u09bc \u0995\u09f0\u09bf\u09ac\u09b2\u09c8 \u09b8\u09ae\u09cd\u09aa\u09a6 \u09ac\u09be \u09a8\u09bf\u09f0\u09cd\u09a6\u09c7\u09b6\u09a8\u09be \u09aa\u09cd\u09f0\u09a6\u09be\u09a8 \u0995\u09f0\u09bf\u09ac \u09aa\u09be\u09f0\u09c7\u0964"),(0,xe.Z)(te,"urlSubHeading11Text","<\u09b8\u09cd\u09aa\u09cd\u09af\u09be\u09a8> \u0995. \u09f1\u09c7\u09ac\u099b\u09be\u0987\u099f\u09a4 \u09a5\u0995\u09be \u09b8\u09c0\u09ae\u09be\u09ac\u09a6\u09cd\u09a7\u09a4\u09be, \u099f\u09cd\u09f0\u09c7\u09a1\u09ae\u09be\u09f0\u09cd\u0995, \u0995\u09aa\u09bf\u09f0\u09be\u0987\u099f, \u09a1\u09bf\u099c\u09be\u0987\u09a8 \u09ac\u09be \u09aa\u09c7\u099f\u09c7\u09a3\u09cd\u099f\u0995\u09c7 \u09a7\u09f0\u09bf \u09b8\u0995\u09b2\u09cb \u09ac\u09cc\u09a6\u09cd\u09a7\u09bf\u0995 \u09b8\u09ae\u09cd\u09aa\u09a4\u09cd\u09a4\u09bf\u09f0 \u0985\u09a7\u09bf\u0995\u09be\u09f0 \u0986\u09f0\u09c1 \u09b8\u09cd\u09ac\u09be\u09f0\u09cd\u09a5 \u098f\u0995\u099a\u09c7\u099f\u09bf\u09af\u09bc\u09be\u09ad\u09be\u09f1\u09c7 \u0986\u09ae\u09be\u09f0 \u09b9 '\u09ac\u0964 \u098f\u0987 \u099a\u09f0\u09cd\u09a4\u09b8\u09ae\u09c2\u09b9\u09c7 \u0986\u09aa\u09cb\u09a8\u09be\u0995 \u09f1\u09c7\u09ac\u099b\u09be\u0987\u099f\u09f0 \u0993\u09aa\u09f0\u09a4 \u0995\u09cb\u09a8\u09cb \u09a7\u09f0\u09a3\u09f0 \u09ae\u09be\u09b2\u09bf\u0995\u09c0\u09b8\u09cd\u09ac\u09a4\u09cd\u09ac\u09f0 \u0985\u09a7\u09bf\u0995\u09be\u09f0 \u09ac\u09be \u098f\u0995\u099a\u09c7\u099f\u09bf\u09af\u09bc\u09be \u0985\u09a7\u09bf\u0995\u09be\u09f0 \u09aa\u09cd\u09f0\u09a6\u09be\u09a8 \u09a8\u0995\u09f0\u09c7\u0964 </span> <span> \u0996\u0964 \u0986\u09ae\u09be\u09f0 \u09aa\u09c2\u09f0\u09cd\u09ac \u09b2\u09bf\u0996\u09bf\u09a4 \u0985\u09a8\u09c1\u09ae\u09cb\u09a6\u09a8 \u0985\u09ac\u09bf\u09b9\u09a8\u09c7 \u0986\u09ae\u09be\u09f0 \u09a6\u09cd\u09ac\u09be\u09f0\u09be \u0985\u0982\u09b6\u09c0\u09a6\u09be\u09f0\u09c0\u09a4\u09cd\u09ac, \u09aa\u09c3\u09b7\u09cd\u09a0\u09aa\u09cb\u09b7\u0995\u09a4\u09be \u09ac\u09be \u0985\u09a8\u09c1\u09ae\u09cb\u09a6\u09a8\u09f0 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6 \u09a6\u09bf\u09af\u09bc\u09be \u09f1\u09c7\u09ac\u099b\u09be\u0987\u099f\u099f\u09cb\u09f0 \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09b9\u09cb\u09b7\u09cd\u099f\u09bf\u0982/\u09b9\u09be\u0987\u09aa\u09be\u09f0\u09b2\u09bf\u0982\u0995\u09bf\u0982 \u09b8\u09ae\u09cd\u09aa\u09f0\u09cd\u0995\u09c7 \u0986\u09aa\u09c1\u09a8\u09bf \u0995\u09cb\u09a8\u09cb \u09ac\u09bf\u09ac\u09c3\u09a4\u09bf \u09aa\u09cd\u09f0\u09a6\u09be\u09a8 \u09a8\u0995\u09f0\u09c7\u0964 </span> <span> \u0997\u0964 \u0986\u09ae\u09bf \u098f\u099f\u09be \u09b9\u09be\u0987\u09aa\u09be\u09f0\u09b2\u09bf\u0982\u0995\u09f0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a6\u09bf\u0993\u0981 \u09af\u09bf \u0995\u09c7\u09f1\u09b2 \u0986\u09ae\u09be\u09f0 \u09a8\u09be\u09ae \u09ac\u09be \u09f1\u09c7\u09ac\u099b\u09be\u0987\u099f\u09f0 \u09a0\u09bf\u0995\u09a8\u09be \u09aa\u09cd\u09f0\u09a6\u09f0\u09cd\u09b6\u09a8 \u0995\u09f0\u09c7\u0964 \u09b9\u09be\u0987\u09aa\u09be\u09f0\u09b2\u09bf\u0982\u0995 \u09b9\u09bf\u099a\u09be\u09aa\u09c7 \u09ae\u09be\u0987\u099a\u09bf\u09ae\u09f0 \u09b2' \u0997 ', \u099f\u09cd\u09f0\u09c7\u09a1 \u09a8\u09be\u09ae, \u0986\u09f0\u09c1 \u099f\u09cd\u09f0\u09c7\u09a1\u09ae\u09be\u09f0\u09cd\u0995\u09f0 \u09af\u09bf\u0995\u09cb\u09a8\u09cb \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u09ac\u09be \u09aa\u09cd\u09f0\u09a6\u09f0\u09cd\u09b6\u09a8 \u0995\u09f0\u09be\u09f0\u09be\u09f0\u09be\u09f0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a6\u09bf\u09af\u09bc\u09be"),(0,xe.Z)(te,"urlSubHeading12Text","\u0986\u09ae\u09bf \u09af\u09bf\u0995\u09cb\u09a8\u09cb \u09b8\u09ae\u09af\u09bc\u09a4\u09c7, \u099c\u09be\u09a8\u09a8\u09c0\u09f0 \u09b8\u09c8\u09a4\u09c7 \u09ac\u09be \u099c\u09be\u09a8\u09a8\u09c0 \u0985\u09ac\u09bf\u09b9\u09a8\u09c7 \u098f\u0987 \u099a\u09f0\u09cd\u09a4\u09ac\u09cb\u09f0 \u09b8\u0982\u09b6\u09cb\u09a7\u09a8 \u0995\u09f0\u09be\u09f0 \u0985\u09a7\u09bf\u0995\u09be\u09f0 \u09b8\u0982\u09f0\u0995\u09cd\u09b7\u09bf\u09a4 \u0995\u09f0\u09bf \u09f0\u09be\u0996\u09bf\u099b\u09cb\u0964 \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09ae\u09be\u0987\u099a\u09bf\u09ae \u0987\u0989. \u0986\u09f0. \u098f\u09b2.-\u09f0 \u0985\u09ac\u09bf\u09f0\u09a4 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0/\u09b9\u09cb\u09b7\u09cd\u099f\u09bf\u0982\u09f0 \u09ac\u09be\u09ac\u09c7 \u0986\u09aa\u09cb\u09a8\u09be\u0995 \u09b8\u09ae\u09af\u09bc\u09c7 \u09b8\u09ae\u09af\u09bc\u09c7 \u098f\u0987 \u099a\u09f0\u09cd\u09a4\u09ac\u09cb\u09f0 \u09aa\u09c1\u09a8\u09f0\u09c0\u0995\u09cd\u09b7\u09a3 \u0995\u09f0\u09bf\u09ac\u09b2\u09c8 \u0985\u09a8\u09c1\u09f0\u09cb\u09a7 \u099c\u09a8\u09cb\u09f1\u09be \u09b9\u09c8\u099b\u09c7\u0964"),(0,xe.Z)(te,"urlSubHeading13Text","\u0995\u09cb\u09a8\u09cb \u09aa\u09f0\u09bf\u09b8\u09cd\u09a5\u09bf\u09a4\u09bf\u09a4\u09c7\u0987 \u0986\u09ae\u09bf \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09ae\u09be\u0987\u099a\u09bf\u09ae \u0987\u0989. \u0986\u09f0. \u098f\u09b2.-\u09f0 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0/\u09b9\u09cb\u09b7\u09cd\u099f\u09bf\u0982\u09f0 \u09aa\u09f0\u09be \u09ac\u09be \u0987\u09af\u09bc\u09be\u09f0 \u09b8\u09ae\u09cd\u09aa\u09f0\u09cd\u0995\u09a4 \u0989\u09a6\u09cd\u09ad\u09f1 \u09b9\u09cb\u09f1\u09be \u09af\u09bf\u0995\u09cb\u09a8\u09cb \u09aa\u09f0\u09cb\u0995\u09cd\u09b7, \u09ac\u09bf\u09b6\u09c7\u09b7, \u0986\u09a8\u09c1\u09b7\u0982\u0997\u09bf\u0995 \u09ac\u09be \u09aa\u09f0\u09bf\u09a3\u09be\u09ae\u0997\u09a4 \u0995\u09cd\u09b7\u09a4\u09bf\u09f0 \u09ac\u09be\u09ac\u09c7 \u09a6\u09be\u09af\u09bc\u09ac\u09a6\u09cd\u09a7 \u09a8\u09b9 '\u09ae, \u09ac\u09cd\u09af\u09f1\u09b8\u09cd\u09a5\u09be \u0997\u09cd\u09f0\u09b9\u09a3\u09f0 \u0995\u09be\u09f0\u09a3 \u09a8\u09bf\u09f0\u09cd\u09ac\u09bf\u09b6\u09c7\u09b7\u09c7 (\u099a\u09c1\u0995\u09cd\u09a4\u09bf, \u0985\u09aa\u09f0\u09be\u09a7, \u09f1\u09be\u09f0\u09c7\u09a3\u09cd\u099f\u09bf \u0989\u09b2\u0982\u0998\u09a8, \u09ac\u09be \u0985\u09a8\u09cd\u09af\u09a5\u09be) \u0986\u09f0\u09c1 \u09af\u09a6\u09bf\u0993 \u0986\u09ae\u09be\u0995 \u098f\u09a8\u09c7 \u0995\u09cd\u09b7\u09a4\u09bf\u09f0 \u09b8\u09ae\u09cd\u09ad\u09be\u09f1\u09a8\u09be\u09f0 \u09ac\u09bf\u09b7\u09af\u09bc\u09c7 \u09aa\u09f0\u09be\u09ae\u09f0\u09cd\u09b6 \u09a6\u09bf\u09af\u09bc\u09be \u09b9\u09c8\u099b\u09c7\u0964"),(0,xe.Z)(te,"urlSubHeading14Text","\u09af\u09a6\u09bf \u098f\u0987 \u099a\u09f0\u09cd\u09a4\u09b8\u09ae\u09c2\u09b9\u09f0 \u0995\u09cb\u09a8\u09cb \u09ac\u09cd\u09af\u09f1\u09b8\u09cd\u09a5\u09be \u0995\u09cb\u09a8\u09cb \u0995\u09be\u09f0\u09a3\u09a4 \u09ac\u09b2\u09f1\u09ce \u0995\u09f0\u09bf\u09ac \u09a8\u09cb\u09f1\u09be\u09f0\u09be \u09ac\u09c1\u09b2\u09bf \u09a8\u09bf\u09f0\u09cd\u09a3\u09af\u09bc \u0995\u09f0\u09be \u09b9\u09af\u09bc, \u09a4\u09c7\u09a8\u09cd\u09a4\u09c7 \u0987\u09af\u09bc\u09be\u09f0 \u09ac\u09be\u0995\u09c0 \u09a5\u0995\u09be \u09ac\u09cd\u09af\u09f1\u09b8\u09cd\u09a5\u09be\u09b8\u09ae\u09c2\u09b9 \u09aa\u09cd\u09f0\u09ad\u09be\u09f1\u09bf\u09a4 \u09a8\u09b9 '\u09ac \u0986\u09f0\u09c1 \u09b8\u09ae\u09cd\u09aa\u09c2\u09f0\u09cd\u09a3 \u09ac\u09b2\u09f1\u09ce \u0986\u09f0\u09c1 \u0995\u09be\u09f0\u09cd\u09af\u0995\u09f0\u09c0 \u09b9\u09c8 \u09a5\u09be\u0995\u09bf\u09ac\u0964"),(0,xe.Z)(te,"urlSubHeading15Text","\u09aa\u09cd\u09b2\u09c7\u099f\u09ab\u09f0\u09cd\u09ae, \u0987\u09af\u09bc\u09be\u09f0 \u09ac\u09bf\u09b7\u09af\u09bc\u09ac\u09b8\u09cd\u09a4\u09c1 \u09ac\u09be \u0987\u09af\u09bc\u09be\u09f0 \u09b8\u09c7\u09f1\u09be\u09b8\u09ae\u09c2\u09b9 \u09b8\u09ae\u09cd\u09aa\u09f0\u09cd\u0995\u09c0\u09af\u09bc \u09af\u09bf\u0995\u09cb\u09a8\u09cb \u0985\u09ad\u09bf\u09af\u09cb\u0997, \u0985\u09ad\u09bf\u09af\u09cb\u0997 \u09ac\u09be \u0989\u09a6\u09cd\u09ac\u09c7\u0997 \u09aa\u09cd\u09f0\u09a5\u09ae\u09c7 \u099a\u09bf. \u099f\u09bf. \u0985 '., \u098f\u09a8. \u0987. \u099c\u09bf. \u09a1\u09bf., \u09a1\u09bf\u099c\u09bf\u099f\u09c7\u09b2 \u0987\u09a3\u09cd\u09a1\u09bf\u09af\u09bc\u09be \u0995\u09f0\u09cd\u09aa\u09cb\u09f0\u09c7\u099a\u09a8\u09b2\u09c8 \u09a8\u09bf\u09f0\u09cd\u09a6\u09c7\u09b6\u09bf\u09a4 \u0995\u09f0\u09be \u09b9' \u09ac \u0986\u09f0\u09c1 \u09ae\u09a7\u09cd\u09af\u09b8\u09cd\u09a5\u09a4\u09be\u09f0 \u099c\u09f0\u09bf\u09af\u09bc\u09a4\u09c7 \u09aa\u09be\u09f0\u09b8\u09cd\u09aa\u09f0\u09bf\u0995\u09ad\u09be\u09f1\u09c7 \u09b8\u09ae\u09be\u09a7\u09be\u09a8 \u0995\u09f0\u09be \u09b9 '\u09ac\u0964 \u098f\u0987 \u099a\u09f0\u09cd\u09a4\u09b8\u09ae\u09c2\u09b9 \u09ad\u09be\u09f0\u09a4\u09c0\u09af\u09bc \u0986\u0987\u09a8 \u0985\u09a8\u09c1\u09b8\u09f0\u09bf \u09aa\u09f0\u09bf\u099a\u09be\u09b2\u09bf\u09a4 \u09b9' \u09ac \u0986\u09f0\u09c1 \u09aa\u09cd\u09f0\u09a4\u09bf\u099f\u09cb \u09aa\u0995\u09cd\u09b7\u0987 \u09ad\u09be\u09f0\u09a4\u09f0 \u09a6\u09bf\u09b2\u09cd\u09b2\u09c0\u09f0 \u0986\u09a6\u09be\u09b2\u09a4\u09f0 \u0985\u09a7\u09bf\u0995\u09be\u09f0\u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09f0\u09a4 \u09a6\u09be\u0996\u09bf\u09b2 \u0995\u09f0\u09bf\u09ac\u0964 \u0987\u09af\u09bc\u09be\u09f0 \u0985\u09b8\u09cd\u09a4\u09bf\u09a4\u09cd\u09ac, \u09ac\u09c8\u09a7\u09a4\u09be \u09ac\u09be \u09b8\u09ae\u09be\u09aa\u09cd\u09a4\u09bf \u09b8\u09ae\u09cd\u09aa\u09f0\u09cd\u0995\u09c0\u09af\u09bc \u09af\u09bf\u0995\u09cb\u09a8\u09cb \u09aa\u09cd\u09f0\u09b6\u09cd\u09a8\u0995\u09c7 \u09a7\u09f0\u09bf \u098f\u0987 \u099a\u09f0\u09cd\u09a4\u09b8\u09ae\u09c2\u09b9\u09f0 \u09aa\u09f0\u09be \u0989\u09a6\u09cd\u09ad\u09f1 \u09b9\u09cb\u09f1\u09be \u09af\u09bf\u0995\u09cb\u09a8\u09cb \u09aa\u09be\u09f0\u09cd\u09a5\u0995\u09cd\u09af \u09ac\u09be \u09ac\u09bf\u09ac\u09be\u09a6 \u09aa\u0995\u09cd\u09b7\u09b8\u09ae\u09c2\u09b9\u09c7 \u0986\u09b2\u09cb\u099a\u09a8\u09be\u09f0 \u099c\u09f0\u09bf\u09af\u09bc\u09a4\u09c7 \u09aa\u09be\u09f0\u09b8\u09cd\u09aa\u09f0\u09bf\u0995\u09ad\u09be\u09f1\u09c7 \u09b8\u09ae\u09be\u09a7\u09be\u09a8 \u0995\u09f0\u09bf\u09ac\u0964 \u0993\u09aa\u09f0\u09a4 \u0989\u09b2\u09cd\u09b2\u09c7\u0996 \u0995\u09f0\u09be \u09ac\u09bf\u09ac\u09be\u09a6\u09b8\u09ae\u09c2\u09b9\u09f0 \u09b8\u09ae\u09be\u09a7\u09be\u09a8 \u09a8\u09b9 '\u09b2\u09c7, \u09ac\u09bf\u09ac\u09be\u09a6\u099f\u09cb \u09a6\u09c1\u09af\u09bc\u09cb\u099c\u09a8\u09c7 \u09aa\u09be\u09f0\u09b8\u09cd\u09aa\u09f0\u09bf\u0995\u09ad\u09be\u09f1\u09c7 \u09a8\u09bf\u09af\u09c1\u0995\u09cd\u09a4 \u0995\u09f0\u09be \u098f\u0995\u09ae\u09be\u09a4\u09cd\u09f0 \u09ae\u09a7\u09cd\u09af\u09b8\u09cd\u09a5\u09a4\u09be\u0995\u09be\u09f0\u09c0\u09f0 \u09ae\u09a7\u09cd\u09af\u09b8\u09cd\u09a5\u09a4\u09be\u0995 \u09aa\u09cd\u09f0\u09c7\u09f0\u09c7\u09f0\u09a3 \u0995\u09f0\u09be \u09b9' \u09ac\u0964"),(0,xe.Z)(te,"urlHostingText1",'<p> \u098f\u0987 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0\u09f0 \u099a\u09f0\u09cd\u09a4\u09ac\u09cb\u09f0\u09c7 ("\u099a\u09f0\u09cd\u09a4\u09ac\u09cb\u09f0") \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09f1\u09c7\u09ac\u099b\u09be\u0987\u099f\u09a4 \u0986\u09aa\u09cb\u09a8\u09be\u09f0 ("\u0986\u09aa\u09c1\u09a8\u09bf/\u0986\u09aa\u09cb\u09a8\u09be\u09f0/\u09a6\u09b2") \u09ae\u09be\u0987\u099a\u09bf\u09ae\u09f0 \u0987\u0989. \u0986\u09f0. \u098f\u09b2. \u09b9\u09cb\u09b7\u09cd\u099f \u0995\u09f0\u09be \u0986\u09f0\u09c1 \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0\u09be\u099f\u09cb \u09a8\u09bf\u09af\u09bc\u09a8\u09cd\u09a4\u09cd\u09f0\u09a3 \u0995\u09f0\u09c7\u0964 \u09ae\u09be\u0987\u099a\u09bf\u09ae\u09f0 \u0987\u0989. \u0986\u09f0. \u098f\u09b2. \u09b9\u09cb\u09b7\u09cd\u099f \u0995\u09f0\u09bf \u09ac\u09be \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0\u09bf ("\u09aa\u09cd\u09b2\u09c7\u099f\u09ab\u09f0\u09cd\u09ae/\u0986\u09ae\u09bf/\u0986\u09ae\u09be\u09f0/\u0986\u09ae\u09be\u09f0"), \u0986\u09aa\u09c1\u09a8\u09bf \u098f\u0987 \u099a\u09f0\u09cd\u09a4\u09ac\u09cb\u09f0\u09f0 \u09a6\u09cd\u09ac\u09be\u09f0\u09be \u0995\u09a0\u09cb\u09f0\u09ad\u09be\u09f1\u09c7 \u0986\u09ac\u09a6\u09cd\u09a7 \u09b9 \'\u09ac\u09b2\u09c8 \u09b8\u09a8\u09cd\u09ae\u09a4 \u09b9\u09af\u09bc \u0986\u09f0\u09c1 \u099a\u09f0\u09cd\u09a4\u09ac\u09cb\u09f0\u09c7 \u0986\u09ae\u09be\u09f0 \u09b8\u09c8\u09a4\u09c7 \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09b8\u09ae\u09cd\u09aa\u09f0\u09cd\u0995 \u09a8\u09bf\u09af\u09bc\u09a8\u09cd\u09a4\u09cd\u09f0\u09a3 \u0995\u09f0\u09c7\u0964 \u09b8\u0995\u09b2\u09cb \u099a\u09f0\u09cd\u09a4\u09ac\u09cb\u09f0 \u09b8\u09be\u09f1\u09a7\u09be\u09a8\u09c7 \u09aa\u09a2\u09bc\u0995\u0964 \u09af\u09a6\u09bf \u0986\u09aa\u09c1\u09a8\u09bf \u098f\u0987 \u099a\u09f0\u09cd\u09a4\u09ac\u09cb\u09f0\u09f0 \u09b8\u09c8\u09a4\u09c7 \u09b8\u09a8\u09cd\u09ae\u09a4 \u09a8\u09b9\u09af\u09bc, \u0985\u09a8\u09c1\u0997\u09cd\u09f0\u09b9 \u0995\u09f0\u09bf \u09af\u09bf\u0995\u09cb\u09a8\u09cb \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u09f0 \u09ac\u09be\u09ac\u09c7 \u0986\u09aa\u09cb\u09a8\u09be\u09f0 \u09f1\u09c7\u09ac\u099b\u09be\u0987\u099f\u09a4 \u09ae\u09be\u0987\u099a\u09bf\u09ae\u09f0 \u0987\u0989. \u0986\u09f0. \u098f\u09b2. \u09b9\u09cb\u09b7\u09cd\u099f \u0995\u09f0\u09be \u09ac\u09be \u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0\u09be\u09f0 \u09aa\u09f0\u09be \u09ac\u09bf\u09f0\u09a4 \u09a5\u09be\u0995\u0995\u0964 \u098f\u0987 \u099a\u09f0\u09cd\u09a4\u09ac\u09cb\u09f0\u09f0 \u0985\u09aa\u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u09ac\u09be \u0985\u09aa\u09ac\u09cd\u09af\u09f1\u09b9\u09be\u09f0 \u0995\u09f0 \u0995\u09f0 \u098f\u09ae\u099b, \u0986\u09aa\u09c1\u09a8\u09bf \u09b8\u09c7\u0987 \u09b8\u09a4\u09cd\u09a4\u09be\u09f0 \u09b9\u09c8 \u098f\u09a8\u09c7 \u0995\u09f0\u09bf \u0986\u099b\u09c7 (\u0986\u09f0\u09c1 \u099a\u09f0\u09cd\u09a4\u09ac\u09cb\u09f0\u09a4 "\u0986\u09aa\u09c1\u09a8\u09bf" \u09f0 \u09b8\u0995\u09b2\u09cb \u0989\u09b2\u09cd\u09b2\u09c7\u0996 \u09b8\u09c7\u0987 \u09b8\u09a4\u09cd\u09a4\u09be\u0995 \u09ac\u09c1\u099c\u09be\u09af\u09bc)\u0964 \u0987\u0989. \u0986\u09f0. \u098f\u09b2. \u09b9\u09cb\u09b7\u09cd\u099f \u0995\u09f0\u09bf\u09ac\u09b2\u09c8 \u0986\u09aa\u09c1\u09a8\u09bf \u0995\u09bf\u099b\u09c1\u09ae\u09be\u09a8 \u09a4\u09a5\u09cd\u09af \u09aa\u09cd\u09f0\u09a6\u09be\u09a8 \u0995\u09f0\u09bf\u09ac \u09b