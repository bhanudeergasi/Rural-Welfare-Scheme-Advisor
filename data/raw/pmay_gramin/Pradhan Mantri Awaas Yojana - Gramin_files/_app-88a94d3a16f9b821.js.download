ba \u067e\u0627\u0646\u0679\u06be \u062a\u0633\u0644\u06cc\u0645 \u06a9\u0631\u0646\u06d4 \u062a\u0627\u06c1\u0645\u060c \u06cc\u06c1\u0655 \u0645\u0648\u0627\u062f \u062f\u0648\u0628\u0627\u0631\u0655 \u067e\u06cc\u062f\u0655 \u06a9\u0631\u0646\u0686 \u0627\u062c\u0627\u0632\u062a \u0686\u06be\u0646\u06c1\u0655 \u06a9\u0648\u0646\u06c1\u0655 \u062a\u06c1\u0655 \u06cc\u062a\u06be \u0645\u0648\u0627\u062f\u0633 \u062a\u0627\u0645 \u067e\u0654\u062f\u0655 \u06af\u0698\u0627\u0646 \u06cc\u0645\u0686 \u0634\u0646\u0627\u062e\u062a \u062a\u06be\u0631\u0688 \u067e\u0627\u0631\u0679\u06cc \u06c1\u0646\u065b\u062f \u06a9\u0627\u067e\u06cc \u0631\u0627\u0626\u0679 \u06a9\u06c1 \u0637\u0648\u0631 \u067e\u0623\u0646\u0679\u06be \u0686\u06be \u06a9\u0631\u0646\u06c1\u0655 \u06cc\u0648\u0627\u0646 (\u0635\u0627\u0631\u0641 \u0633\u0646\u065b\u062f \u062c\u0645\u0639 \u06a9\u0631\u062f\u0655 \u0645\u0648\u0627\u062f)\u06d4 \u06cc\u062a\u06be \u0645\u0648\u0627\u062f \u062f\u0648\u0628\u0627\u0631\u0655 \u067e\u06cc\u0634 \u06a9\u0631\u0646\u06a9 \u0627\u062c\u0627\u0632\u062a \u06af\u0698\u06be \u0645\u062a\u0639\u0644\u0642\u06c1 \u06a9\u0627\u067e\u06cc \u0631\u0627\u0626\u0679 \u06c1\u0648\u0644\u0688\u0631 \u0646\u0634 \u062d\u0672\u0635\u0644 \u06a9\u0631\u0646\u06c1\u0655 \u06cc\u0646\u06d4"),(0,xe.Z)(de,"privacyPolicyText","<p> \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0686\u06be\u0646\u06c1\u0655 \u067e\u0627\u0646\u06c1\u0655 \u062a\u06c4\u06c1\u06c1 \u0646\u0634 \u06a9\u0627\u0646\u065b\u06c1\u06c1 \u062e\u0627\u0635 \u0630\u0672\u062a\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062d\u0672\u0635\u0644 \u06a9\u0631\u0627\u0646\u060c (\u06cc\u062a\u06be \u06a9\u0654\u0646\u06cd \u0646\u0627\u0648\u060c \u0641\u0648\u0646 \u0646\u0645\u0628\u0631 \u06cc\u0627 \u0627\u06cc \u0645\u06cc\u0644 \u0627\u06cc\u0688\u0631\u06cc\u0633)\u060c \u06cc\u0633 \u0627\u0633\u06c1 \u0627\u0644\u06af \u0627\u0644\u06af \u062a\u06c4\u06c1\u06c1 \u0634\u0646\u0627\u062e\u062a \u06a9\u0631\u0646\u06a9 \u0627\u062c\u0627\u0632\u062a \u0686\u06be \u062f\u0648\u0627\u0646\u06d4 \u0627\u06af\u0631 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u062a\u06c4\u06c1\u06c1 \u0630\u0672\u062a\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u0655\u0686 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0686\u06be \u06a9\u0631\u0627\u0646\u060c \u062a\u06cc\u065a\u0644\u06c1 \u06cc\u06cc \u062a\u06c4\u06c1\u06c1 \u062a\u0645\u0646 \u062e\u0627\u0635 \u0645\u0642\u0635\u062f\u0646 \u062e\u0672\u0637\u0631\u0655 \u0627\u0637\u0644\u0627\u0639 \u062f\u0646\u06c1\u0655 \u06cc\u0645\u0646 \u062e\u0672\u0637\u0631\u0655 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0686\u06be \u062c\u0645\u0639 \u06a9\u0631\u0646\u06c1\u0655 \u06cc\u0648\u0627\u0646 \u062a\u06c1\u0655 \u062a\u06c1\u0646\u065b\u0632 \u0630\u0672\u062a\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u06c1\u0655 \u0628\u0686\u0627\u0648\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655 \u06cc\u06cc\u06c1\u0655 \u06a9\u0672\u0641\u06cc \u062d\u0641\u0627\u0638\u062a\u06cc \u062a\u062f\u0627\u0628\u06cc\u0631 \u0627\u062e\u062a\u06cc\u0627\u0631 \u06a9\u0631\u0646\u06c1\u0655\u06d4 \u0623\u0633\u06cd \u0686\u06be\u0646\u06c1\u0655 \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645\u0633 \u067e\u06cc\u065a\u0679\u06be \u0631\u0636\u0627\u06a9\u0627\u0631\u0627\u0646\u06c1\u0655 \u0637\u0648\u0631 \u06a9\u0627\u0646\u065b\u06c1\u06c1 \u0630\u0672\u062a\u06cc \u0634\u0646\u0627\u062e\u062a\u0655\u0686 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u0646\u06c1 \u062a\u06c1 \u062a\u0631\u065b\u06cc\u065a\u06cc\u0645 \u067e\u0627\u0631\u0679\u06cc (\u0639\u0648\u0672\u0645\u06cc/\u0630\u0672\u062a\u06cc) \u06a9\u0655\u0646\u0627\u0646 \u06cc\u0627 \u0634\u06cc\u0626\u0631 \u06a9\u0631\u0627\u0646\u06d4 \u0627\u062a\u06be \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0633 \u067e\u06cc\u065a\u0679\u06be \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u06c1\u0655 \u0622\u0645\u0655\u0698 \u06a9\u0627\u0646\u065b\u06c1\u06c1 \u062a\u06c1 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0622\u0633\u06c1 \u0646\u0642\u0635\u0627\u0646\u060c \u063a\u0644\u0637 \u0627\u0633\u062a\u0639\u0645\u0627\u0644\u060c \u063a\u0672\u0631 \u0642\u0648\u0646\u0648\u0657\u0646\u06cc \u0631\u0633\u0627\u0626\u06cc \u06cc\u0627 \u0627\u0641\u0634\u0672\u06cc\u06cc\u060c \u062a\u0628\u062f\u06cc\u0644\u06cc \u06cc\u0627 \u062a\u0628\u0627\u06c1 \u06af\u0698\u06be\u0646\u06c1\u0655 \u0646\u0634 \u0645\u062d\u0641\u0648\u0638\u06d4 \u0623\u0633\u06cd \u0686\u06be \u0635\u0627\u0631\u0641\u0633 \u0645\u062a\u0639\u0644\u0642 \u06a9\u06cc\u065a\u0646\u065b\u06c1\u06c1 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062c\u0645\u0639 \u06a9\u0631\u0627\u0646\u060c \u06cc\u062a\u06be \u06a9\u0654\u0646\u06cd \u0627\u0646\u0679\u0631\u0646\u06cc\u0679 \u067e\u0631\u0648\u0679\u0648\u06a9\u0648\u0644 (IP) \u0627\u06cc\u0688\u0631\u06cc\u0633\u060c \u0688\u0648\u0645\u06cc\u0646 \u0646\u0627\u0648\u060c \u0628\u0631\u0627\u0624\u0632\u0631 \u0679\u0627\u0626\u067e\u06d4"),(0,xe.Z)(de,"hyperlinkPolicyText","\u0628\u06cc\u0631\u0648\u0646\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679\u0633/\u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0646 \u06c1\u0646\u065b\u062f \u0644\u0646\u06a9\u0633 \u0627\u062a\u06be \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0633 \u0645\u0646\u065b\u0632 \u0648\u0627\u0631\u06cc\u06c1 \u0645\u0642\u0627\u0645\u0646 \u067e\u06cc\u0679\u06be \u0645\u0644\u0620\u0648 \u062a\u06c4\u06c1\u06c1 \u0628\u0627\u0642\u06cc\u0646 \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679\u0633/\u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0646 \u06c1\u0646\u065b\u062f \u0644\u0646\u06a9\u06d4 \u0644\u0646\u06a9 \u0686\u06be \u062a\u06c1\u0646\u065b\u0632 \u0633\u06c1\u0648\u0644\u062a \u062e\u0672\u0637\u0631\u0655 \u062a\u06be\u0648\u0646\u06c1\u0655 \u0622\u0645\u062a\u06d4 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0686\u06be\u0646\u06c1\u0655 \u0644\u0646\u06a9\u0688 \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679\u0633\u06a9 \u0645\u0648\u0627\u062f \u062a\u06c1\u0655 \u0648\u0634\u0648\u0633\u0646\u06cc\u06cc\u062a\u0627 \u062e\u0672\u0637\u0631\u0655 \u0630\u0645\u06c1 \u062f\u0627\u0631 \u062a\u06c1\u0655 \u0636\u0631\u0648\u0631\u06cc \u0686\u06be\u0646\u06c1\u0655 \u0632 \u0627\u062a\u06be \u0645\u0646\u065b\u0632 \u0638\u0672\u06c1\u0631 \u06a9\u0631\u062f\u0655 \u062e\u06cc\u0627\u0644\u0627\u062a\u0686 \u062a\u0627\u0626\u06cc\u062f \u06a9\u0631\u0627\u0646\u06d4 \u0635\u0631\u0641 \u0644\u0646\u06a9\u0686 \u0645\u0648\u062c\u0648\u062f\u06af\u06cc \u06cc\u0627 \u0627\u062a\u06be \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0633 \u067e\u06cc\u0679\u06be \u0627\u0645\u0686 \u0644\u0633\u0679\u0646\u06af \u06af\u0698\u06be \u0646\u06c1\u0655 \u06a9\u0646\u06c1\u0655 \u062a\u06c1\u0655 \u0642\u0633\u0645\u0686 \u062a\u0648\u062b\u06cc\u0642 \u0633\u0645\u062c\u06be\u0646\u06c1\u0655 \u06cc\u0646\u06d4 \u0623\u0633\u06cd \u06c1\u06cc\u06a9\u0648 \u0646\u06c1\u0655 \u0636\u0645\u0627\u0646\u062a \u062f\u062a\u06be \u0632 \u06cc\u0645 \u0644\u0646\u06a9 \u06af\u0698\u06be\u0646 \u06c1\u0631 \u0648\u0642\u062a \u06a9\u0672\u0645 \u06a9\u0631\u0646 \u062a\u06c1\u0655 \u0627\u0633\u06c1 \u0686\u06be\u0646\u06c1\u0655 \u0644\u0646\u06a9\u0688 \u067e\u06cc\u062c\u0632\u0686 \u062f\u0633\u062a\u06cc\u0627\u0628\u06cc \u067e\u06cc\u0679\u06be \u06a9\u0646\u06c1\u06c1 \u06a9\u0646\u0679\u0631\u0648\u0644\u06d4"),(0,xe.Z)(de,"termsText1","<p> \u0627\u0633\u062a\u0639\u0645\u0627\u0644\u0655\u06a9\u06c1 \u06cc\u0645 \u0634\u0631\u0637\u06c1\u0655 \u0686\u06be https://www.myscheme.gov.in \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646 \u0648\u0672\u0644\u0633 \u0637\u0648\u0631\u0633 \u067e\u06cc\u065a\u0679\u06be \u062a\u06c1\u0646\u065b\u062f \u062d\u0642\u0648\u0642 \u062a\u06c1\u0655 \u0630\u0645\u06c1\u0655 \u062f\u0672\u0631\u06cc \u0628\u06cc\u0627\u0646 \u06a9\u0631\u0627\u0646\u06d4 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0627\u06a9\u0627\u0648\u0646\u0679 \u0628\u0646\u0627\u0648\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655 \u067e\u0632 \u062a\u06c4\u06c1\u06c1 \u0627\u0633\u062a\u0639\u0645\u0627\u0644\u0655\u06a9\u06c1 \u06cc\u0645 \u0634\u0631\u0637\u06c1\u0655 \u0642\u0628\u0648\u0644 \u06a9\u0631\u0646\u06d4 </p> <p> \u0645\u06cc\u0626\u0679\u06cc \u062a\u06c1\u0655 \u062d\u06a9\u0648\u0645\u062a \u06c1\u0646\u062f \u0686\u06be \u06a9\u0646\u06c1 \u062a\u06c1 \u0648\u0642\u062a\u06c1\u0655 \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645\u0633 \u062a\u06c1\u0655 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06cc\u065a\u0646 \u06cc\u0645\u0646 \u0634\u0631\u0637\u0646 \u0645\u0646\u065b\u0632 \u062a\u0628\u062f\u06cc\u0644\u06cc\u06c1\u0655 \u06a9\u0631\u0646\u06a9 \u062d\u0642 \u0645\u062d\u0641\u0648\u0638 \u062a\u06be\u0627\u0648\u0627\u0646\u06d4 \u0627\u06af\u0631 \u06cc\u0645 \u062a\u0628\u062f\u06cc\u0644\u06cc\u06c1\u0655 \u062a\u06c1\u0646\u065b\u062f\u0620\u0646 \u062d\u0642\u0648\u0642\u0646 \u06cc\u0627 \u0630\u0645\u06c1\u0655 \u062f\u0627\u0631\u0646 \u067e\u06cc\u065a\u0679\u06be \u0627\u062b\u0631 \u062a\u0631\u065b\u0627\u0648\u0627\u0646 \u0686\u06be\u060c \u062a\u06cc\u065a\u0644\u06c1 \u06cc\u06cc \u062a\u06c4\u06c1\u06c1 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06c1 \u0630\u0654\u0631\u06cc\u0639 \u0627\u0637\u0644\u0627\u0639 \u062f\u0646\u06c1\u0655\u06d4 </p> \u0627\u0633\u062a\u0639\u0645\u0627\u0644\u0655\u06a9\u06cd \u062f\u0631\u062c \u0630\u06cc\u0644 \u0634\u0631\u0637\u06c1\u0655 \u0686\u06be\u06d2\u065a \u0628\u0631\u062e\u0627\u0633\u062a \u06af\u0698\u06be\u0627\u0646 \u062a\u06c1\u0655 \u06a9\u0646\u06c1 \u062a\u06c1 \u0634\u0631\u0637\u06c1\u0655 \u062a\u06c1\u0655 \u0636\u0654\u0631\u0648\u0657\u0631\u062a\u0646 \u06c1\u0655\u0646\u065b\u0632 \u062c\u0627\u06d2 \u0646\u0648\u0627\u0646 \u06cc\u0645 \u062a\u06c4\u06c1\u06c1 \u0628\u0631\u065b\u06c4\u0646\u065b\u06c1\u06c1 \u067e\u0646\u0646\u06c1 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u0633 \u0627\u0633\u062a\u0639\u0645\u0627\u0644\u0633 \u067e\u06cc\u065a\u0679\u06be \u0627\u062e\u062a\u06cc\u0627\u0631 \u06a9\u0631\u0646\u06c1\u0655 \u0622\u0645\u0655\u062a\u06cd \u0622\u0633\u0646\u06d4 \u06cc\u0645 \u062f\u0631\u062c \u0630\u06cc\u0644 \u0634\u0631\u0627\u0626\u0637 \u062a\u06c1\u0655 \u0636\u0654\u0631\u0648\u0657\u0631\u062a\u06c1\u0655 \u0686\u06be\u06d2\u065a \u062a\u0645\u06c1\u0655 \u0648\u0642\u062a\u06c1\u0655 \u067e\u06cc\u065a\u0679\u06be \u0644\u0627\u06af\u0648 \u06af\u0698\u06be\u0627\u0646 \u06cc\u06cc\u065a\u0644\u06c1 \u062a\u06c4\u06c1\u06c1 \u06cc\u06c1 \u0642\u0628\u0648\u0657\u0644 \u06a9\u0654\u0631\u062a\u06be \u067e\u0646\u0646 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0627\u06a9\u0627\u0648\u0646\u0679 \u0628\u0646\u0627\u0648\u06d4 \u062d\u06a9\u0648\u0645\u062a \u06c1\u0646\u062f\u0686 \u062a\u0646\u0638\u06cc\u0645\u06cc\u06ba\u060c \u0645\u062d\u06a9\u0645\u06c1\u0655\u060c \u062a\u06c1\u0655 \u0648\u0632\u0627\u0631\u062a\u06c1\u0655\u06d4 \u0627\u06af\u0631\u0686\u06c1 \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645\u0633 \u067e\u06cc\u0679\u06be \u0645\u0648\u062c\u0648\u062f \u0645\u0648\u0627\u062f\u0686 \u062f\u0631\u0633\u062a\u06af\u06cc \u06cc\u0642\u06cc\u0646\u06cc \u0628\u0646\u0627\u0648\u0646\u06c1\u0655 \u062e\u0627\u0637\u0631\u0655 \u0686\u06be \u062a\u0645\u0627\u0645 \u06a9\u0648\u0634\u0634\u06cc\u06ba \u06a9\u0631\u0646\u06c1\u0655 \u0622\u0645\u0698\u0655\u060c \u0645\u06af\u0631 \u06cc\u06c1\u0655 \u06af\u0698\u06be \u0646\u06c1\u0655 \u0642\u0627\u0646\u0648\u0646 \u06a9\u06c1 \u0628\u06cc\u0627\u0646 \u06a9\u06c1 \u0637\u0648\u0631 \u067e\u0623\u0646\u0679\u06be \u0633\u0645\u062c\u06be\u0646\u06c1\u0655 \u06cc\u0646 \u06cc\u0627 \u06a9\u0646\u06c1\u0655 \u062a\u06cc\u06cc\u06c1\u0655 \u0642\u0627\u0646\u0648\u0646\u06cc \u0645\u0642\u0635\u062f \u062e\u0623\u0637\u0631\u0655 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u06c1\u0655 \u06cc\u0646\u06d4 \u06a9\u0646\u06c1\u0655 \u062a\u06c1\u0655 \u0627\u0628\u06c1\u0627\u0645 \u06cc\u0627 \u0634\u06a9\u0648\u06a9 \u0648 \u0634\u0628\u06c1\u0627\u062a \u06a9\u06c1 \u0635\u0648\u0631\u062a\u0633 \u0645\u0646\u065b\u0632\u060c \u0635\u0627\u0631\u0641\u06cc\u0646\u0646 \u0686\u06be \u0635\u0644\u0627\u062d \u062f\u06cc\u0646\u06c1\u0655 \u06cc\u0648\u0627\u0646 \u06a9\u06c1 \u062a\u0645 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0648\u0632\u0627\u0631\u062a/\u0645\u062d\u06a9\u0645\u06c1\u0655/\u062a\u0646\u0638\u06cc\u0645 \u062a\u06c1\u0655/\u06cc\u0627 \u0628\u0627\u0642\u06cc \u0630\u0631\u0627\u0626\u0639\u0633 \u0633\u06ed\u062a\u06cd \u062a\u0635\u062f\u06cc\u0642/\u062c\u0627\u0646\u0686 \u06a9\u0631\u0646\u060c \u062a\u06c1\u0655 \u0645\u0646\u0627\u0633\u0628 \u067e\u06cc\u0634\u06c1 \u0648\u0631\u0627\u0646\u06c1 \u0645\u0634\u0648\u0631\u06d2 \u062d\u0623\u0635\u0644 \u06a9\u0631\u0646\u06d4 \u06a9\u0646\u06c1\u0655 \u062a\u06cc\u06cc\u06c1\u0655 \u0635\u0648\u0631\u062a\u06c1\u0655 \u0645\u0646\u065b\u0632 \u06af\u0698\u06be \u0646\u06c1\u0655 \u062d\u06a9\u0648\u0645\u062a\u06cc \u0648\u0632\u0627\u0631\u062a/\u0645\u062d\u06a9\u0645\u06c1/\u062a\u0646\u0638\u06cc\u0645 \u06a9\u0646\u06c1\u0655 \u062a\u06cc\u06cc\u06c1\u0655 \u0627\u062e\u0631\u0627\u062c\u0627\u062a\u060c \u0646\u0642\u0635\u0627\u0646\u060c \u06cc\u0627 \u0646\u0642\u0635\u0627\u0646\u06a9 \u0630\u0645\u06c1 \u062f\u0627\u0631 \u0623\u0633\u062a\u06be\u060c \u0628\u0634\u0645\u0648\u0644 \u062d\u062f\u0655\u060c \u0628\u0627\u0644\u0648\u0627\u0633\u0637\u06c1 \u06cc\u0627 \u0646\u062a\u06cc\u062c\u06c1\u0655 \u062e\u06cc\u0632 \u0646\u0642\u0635\u0627\u0646 \u06cc\u0627 \u0646\u0642\u0635\u0627\u0646\u060c \u06cc\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u0633\u06ed\u062a\u06cd \u067e\u06cc\u062f\u0655 \u06af\u0698\u06be\u0646 \u0648\u0672\u0644 \u06a9\u0646\u06c1\u06c1 \u062a\u06c1\u0655 \u0627\u062e\u0631\u0627\u062c\u0627\u062a\u060c \u0646\u0642\u0635\u0627\u0646\u060c \u06cc\u0627 \u0646\u0642\u0635\u0627\u0646\u06d4"),(0,xe.Z)(de,"termsHead1","\u0627\u0633\u062a\u0639\u0645\u0627\u0644\u0655\u0686 \u062d\u062f:"),(0,xe.Z)(de,"termsText2","\u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645\u06a9 \u06a9\u0646\u06c1\u06c1 \u062a\u06c1\u0655 \u063a\u0672\u0631 \u0645\u062c\u0627\u0632 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u0686\u06be \u0645\u0645\u0646\u0648\u0639\u06d4 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u067e\u06cc\u062c\u0633 \u062a\u0627\u0645 \u0631\u0633\u0627\u0626\u06cc\u060c \u0646\u06af\u0631\u0672\u0646\u06cc\u060c \u06cc\u0627 \u06a9\u0627\u067e\u06cc \u06a9\u0631\u0646\u06c1\u0655 \u062e\u0627\u0637\u0631\u0655 \u06a9\u0646\u06c1\u06c1 \u062a\u06c1\u0655 \u0633\u0627\u0641\u0679 \u0648\u06cc\u0626\u0631\u06a9 (\u0645\u062b\u0644\u0627 \u0628\u0648\u0679\u0633\u060c \u0633\u06a9\u0631\u06cc\u067e\u0631 \u0679\u0648\u0644\u0632) \u06cc\u0627 \u0628\u0627\u0642\u06cc \u062e\u0648\u062f\u06a9\u0627\u0631 \u0622\u0644\u0627\u062a\u06a9 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u0686\u06be \u0645\u0645\u0646\u0648\u0639 \u06cc\u0648\u065a\u062a\u0627\u0645 \u0646\u06c1\u0655 \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645\u06a9 \u062a\u062d\u0631\u06cc\u0631\u06cc \u0637\u0648\u0631 \u067e\u0623\u0646\u0679\u06be \u0648\u0627\u0636\u062d \u0637\u0648\u0631 \u067e\u0623\u0646\u0679\u06be \u0627\u062c\u0627\u0632\u062a \u0622\u0633\u06c1\u0655\u06d4"),(0,xe.Z)(de,"termsHead2","\u067e\u0646\u0646\u06c1 \u0645\u0648\u0627\u062f\u0633 \u067e\u06cc\u0679\u06be \u063a\u0648\u0631 \u06a9\u0631\u0646 \u0648\u0627\u062c\u0646\u06c1 \u067e\u0627\u0644\u06cc\u0633\u06cc:"),(0,xe.Z)(de,"termsText3","<p> \u0645\u0648\u0627\u062f \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u0646 \u06cc\u0627 \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645\u0633 \u067e\u06cc\u0679\u06be \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655 \u06a9\u0646\u06c1\u06c1 \u0645\u0648\u0627\u062f \u062c\u0645\u0639 \u06a9\u0631\u0646\u060c \u062a\u06c1\u06cd \u0686\u06be\u0648 \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645\u0633 \u0627\u06a9\u06be \u0645\u0633\u062a\u0642\u0644\u060c \u0639\u0627\u0644\u0645\u06cc \u0633\u0637\u062d\u0633 \u067e\u06cc\u0679\u06be\u060c \u0631\u0627\u0626\u0644\u0679\u06cc \u0641\u0631\u06cc\u060c \u0627\u0679\u0644\u060c \u063a\u06cc\u0631 \u062e\u0635\u0648\u0635\u06cc \u062d\u0642 \u062a\u06c1\u0655 \u0644\u0627\u0626\u0633\u0646\u0633 \u0639\u0637\u0627 \u06a9\u0631\u0627\u0646 (\u06cc\u0627 \u0648\u0627\u0631\u0646\u0679 \u06a9\u0631\u0627\u0646 \u0632 \u06cc\u062a\u06be \u062d\u0642\u0648\u0642\u06a9 \u0645\u0672\u0644\u06a9\u0646 \u0686\u06be \u0648\u0627\u0636\u062d \u0637\u0648\u0631 \u067e\u0672\u0646\u0679\u06be \u0639\u0637\u0627 \u06a9\u0648\u065a\u0631\u0645\u062a)\u060c \u0630\u06cc\u0644\u06cc \u0644\u0627\u0626\u0633\u0646\u0633 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u06a9\u060c \u062f\u0648\u0628\u0627\u0631\u0655 \u067e\u06cc\u062f\u0655 \u06a9\u0631\u0646\u06c1\u0655\u060c \u062a\u0631\u0645\u06cc\u0645 \u06a9\u0631\u0646\u06a9\u060c \u0645\u0648\u0627\u0641\u0642\u062a \u06a9\u0631\u0646\u06a9\u060c \u0634\u0627\u0626\u0639 \u06a9\u0631\u0646\u06a9\u060c \u0639\u0648\u0672\u0645\u06cc \u0637\u0648\u0631 \u067e\u0672\u0646\u0679\u06be \u067e\u0631\u0641\u0627\u0631\u0645 \u06a9\u0631\u0646\u06a9\u060c \u0639\u0648\u0672\u0645\u06cc \u0637\u0648\u0631 \u067e\u0672\u0646\u0679\u06be \u0688\u0633\u067e\u0644\u06d2 \u06a9\u0631\u0646\u06a9\u060c \u0688\u06cc\u062c\u06cc\u0679\u0644 \u0637\u0648\u0631 \u067e\u0672\u0646\u0679\u06be \u0688\u0633\u067e\u0644\u06d2 \u06a9\u0631\u0646\u06a9 \u062a\u06c1\u0655 \u0688\u06cc\u062c\u06cc\u0679\u0644 \u0637\u0648\u0631 \u067e\u0672\u0646\u0679\u06be \u062a\u0631\u062c\u0645\u06c1\u0655 \u06a9\u0631\u0646\u06a9\u060c \u06cc\u062a\u06be \u0645\u0648\u0627\u062f\u0633 \u0633\u0654\u062a\u06cd \u0645\u0634\u062a\u0642 \u06a9\u0672\u0645 \u062a\u062e\u0644\u06cc\u0642 \u06a9\u0631\u0646 \u062a\u06c1\u0655 \u062a\u0642\u0633\u06cc\u0645 \u06a9\u0631\u0646 \u06cc\u0627 \u06cc\u062a\u06be \u0645\u0648\u0627\u062f\u0633 \u06a9\u0646\u06c1\u0655 \u062a\u06c1\u0655 \u0634\u06a9\u0644\u06c1\u0655\u060c \u0645\u06cc\u0688\u06cc\u0645\u060c \u06cc\u0627 \u0679\u06cc\u06a9\u0646\u0627\u0644\u0648\u062c\u06cc \u0645\u0646\u065b\u0632 \u0634\u0672\u0645\u0644 \u06a9\u0631\u0646 \u06cc\u0633 \u06c4\u0646\u06cd \u067e\u0648\u0631\u0655 \u06a9\u0627\u0626\u0646\u0627\u062a\u0633 \u0645\u0646\u065b\u0632 \u0645\u0634\u06c1\u0648\u0631 \u06cc\u0627 \u067e\u062a\u06c1\u0655 \u062a\u06cc\u0627\u0631 \u0686\u06be\u06d4 \u062a\u06c1\u06cd \u0686\u06be\u0648 \u0627\u062a\u06be \u06a9\u062a\u06be\u06c1\u0655 \u067e\u06cc\u0679\u06be \u0627\u062a\u0641\u0627\u0642 \u06a9\u0631\u0627\u0646 \u0632 \u062a\u06c4\u06c1\u06c1 \u0622\u0633\u06c1 \u0646\u06c1\u0655 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0646\u0646\u062f\u06c1\u0633 \u062e\u0644\u0627\u0641 \u06a9\u0648\u0646\u06c1\u0655 \u062a\u06c1\u0655 \u0645\u0628\u06cc\u0646\u06c1 \u06cc\u0627 \u062d\u0642\u06cc\u0642\u06cc \u062e\u0644\u0627\u0641 \u0648\u0631\u0632\u06cc \u06cc\u0627 \u063a\u0644\u0637 \u0627\u0633\u062a\u0639\u0645\u0627\u0644\u06a9 \u062d\u0642"),(0,xe.Z)(de,"termsHead3","\u0630\u0645\u06c1\u0655 \u062f\u0672\u0631\u06cc:"),(0,xe.Z)(de,"termsText4","<p> \u062a\u06c4\u06c1\u06c1 \u067e\u0632\u0655: </p>"),(0,xe.Z)(de,"termsPoints","\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06cc\u0627 \u0645\u0645\u0628\u0631 \u0633\u0631\u0648\u0633\u0633 \u062a\u0627\u0645 \u0631\u0633\u0672\u0626\u06cc \u06cc\u0627 \u0631\u0633\u0672\u0626\u06cc \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646 \u0648\u0648\u0644 \u0641\u0637\u0631\u06cc \u0634\u062e\u0635 \u0628\u0646\u0648 \u061b \u06a9\u0646\u06c1 \u0628\u06cc\u06cc\u06c1\u0655 \u0634\u062e\u0635\u06c1\u0655 \u0633\u0646\u062f \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06cc\u0627 \u0645\u0645\u0628\u0631 \u0633\u0631\u0648\u0633 \u0627\u06a9\u0627\u0624\u0646\u0679\u0633 \u062a\u0627\u0645 \u0631\u0633\u0672\u0626\u06cc \u06cc\u0627 \u0644\u0646\u06a9 \u06cc\u0627 \u0631\u0633\u0672\u0626\u06cc \u06cc\u0627 \u0644\u0646\u06a9\u0686 \u062a\u0644\u0627\u0634 \u0646\u06c1 \u06a9\u0631\u0646 (\u0628\u0631\u0627\u06c1 \u0631\u0627\u0633\u062a \u06cc\u0627 \u0628\u0627\u0644\u0648\u0627\u0633\u0637\u06c1\u0655 \u0637\u0648\u0631 \u067e\u0672\u0646\u0679\u06be) \u061b \u06a9\u0646\u06c1\u0655 \u0628\u06cc\u06cc\u06c1\u0655 \u0634\u062e\u0635\u0633 \u0646\u06c1\u0655 \u067e\u0646\u0646 \u06cc\u0648\u0632\u0631 \u0646\u06cc\u0645 \u062a\u06c1\u0655 \u067e\u0627\u0633 \u0648\u0631\u0688 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u0686 \u0627\u062c\u0627\u0632\u062a \u062f\u06cc\u06cc\u0648 \u061b \u067e\u0646\u0646 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0627\u06a9\u0627\u0624\u0646\u0679 \u06cc\u0648\u0632\u0631 \u0646\u06cc\u0645 \u062a\u06c1\u0655 \u067e\u0627\u0633 \u0648\u0631\u0688 \u06c1\u0631 \u0648\u0642\u062a\u06c1\u0655 \u062a\u06be\u06cc\u0648 \u062a\u06c1\u0655 \u067e\u0646\u0646 \u067e\u0627\u0633 \u0648\u0631\u0688 \u06a9\u0646\u06c1\u0655 \u0628\u06cc\u06cc\u06c1\u0655 \u0634\u062e\u0635\u0633 \u0638\u0627\u06c1\u0631 \u0646\u06c1 \u06a9\u0631\u0648 \u061b \u0627\u06af\u0631 \u062a\u06c4\u06c1\u06c1 \u0634\u06a9 \u0686\u06be \u0632 \u062a\u06c1\u0646\u065b\u062f \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0627\u06a9\u0627\u0624\u0646\u0679\u0686 \u0633\u06cc\u06a9\u06cc\u0648\u0631\u0679\u06cc \u0633\u06ed\u062a\u06cd \u06c1\u06cc\u06a9\u06c1\u0655 \u0633\u0645\u062c\u06be\u0648\u062a\u06c1\u0655 \u06af\u0698\u06be\u062a\u06be \u0645\u062b\u0644\u0627: \u062a\u06c1\u0646\u065b\u062f \u067e\u0627\u0633 \u0648\u0631\u0688 \u06cc\u0627 \u06cc\u0648\u0632\u0631 \u0646\u06cc\u0645 \u0686\u06be \u06af\u0645\u0698 \u06cc\u0627 \u0686\u0648\u0631\u06cc \u06af\u0648\u0645\u062a\u06d4 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06c1 \u0630\u0631\u06cc\u0639 \u0631\u0633\u0627\u0626\u06cc\u060c \u062a\u06c1\u0655 \u0635\u0631\u0641 \u062a\u0645 \u06cc\u0648\u0632\u0631 \u0646\u06cc\u0645 \u062a\u06c1\u0655 \u062a\u0635\u062f\u06cc\u0642\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646 \u06cc\u0645 \u062e\u0627\u0635 \u0637\u0648\u0631\u0633 \u067e\u06cc\u0679\u06be \u062a\u06c4\u06c1\u06c1 \u062e\u0672\u0637\u0631\u0655 \u0645\u062e\u062a\u0635 \u06a9\u0631\u0646\u06c1\u0655 \u0622\u0645\u0655\u062a\u06cd \u0686\u06be\u06d4 \u062a\u06c4\u06c1\u06c1 \u067e\u0632\u0655 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u062a\u06c1\u0655 \u067e\u0646\u0646 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0627\u06a9\u0627\u0624\u0646\u0679 \u0635\u0631\u0641 \u0642\u0627\u0646\u0648\u0646\u06cc \u0645\u0642\u0635\u062f\u0646 \u062e\u0672\u0637\u0631\u0655 \u062a\u06c1\u0655 \u0627\u062a\u06be \u0627\u0646\u062f\u0627\u0632\u0633 \u0645\u0646\u065b\u0632 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646 \u06cc\u0633 \u0646\u06c1\u0655 \u06a9\u0646\u06c1 \u062a\u06c1 \u062a\u0631\u065b\u06cc\u065a\u06cc\u0645 \u067e\u0627\u0631\u0679\u06cc \u06a9\u06c1 \u0637\u0631\u0641\u06c1\u0655 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06c1 \u062d\u0642\u0648\u0642\u0655\u0686 \u062e\u0644\u0627\u0641 \u0648\u0631\u0632\u06cc \u0622\u0633\u06c1 \u06a9\u0631\u0627\u0646 \u06cc\u0627 \u0627\u062a\u06be \u0627\u0633\u062a\u0639\u0645\u0627\u0644\u0633 \u0645\u062d\u062f\u0648\u062f \u06cc\u0627 \u0631\u0648\u06a9\u0627\u0648\u0627\u0646\u06d4 \u0627\u062a\u06be \u0645\u0646\u065b\u0632 \u0686\u06be \u0633\u06c1 \u0637\u0631\u0632 \u0639\u0645\u0644 \u0634\u0672\u0645\u0644 \u06cc\u0633 \u063a\u0672\u0631 \u0642\u0648\u0646\u0648\u0657\u0646\u06cc \u0686\u06be \u06cc\u0627 \u06cc\u0633 \u06a9\u0646\u06c1 \u062a\u06c1 \u0646\u0641\u0631\u0633 \u06c1\u0631\u0627\u0633\u0627\u06ba \u06cc\u0627 \u062a\u06a9\u0644\u06cc\u0641 \u06cc\u0627 \u062a\u06a9\u0644\u06cc\u0641 \u06c1\u06cc\u06a9\u06c1\u0655 \u062f\u06cc\u062a\u06be\u060c \u0641\u062d\u0627\u0634\u06cc \u06cc\u0627 \u062c\u0627\u0631\u062d\u0627\u0646\u06c1 \u0645\u0648\u0627\u062f\u0686 \u062a\u0631\u0633\u06cc\u0644\u060c \u06cc\u0627 \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645\u0633 \u0645\u0646\u065b\u0632 \u062e\u0644\u0644\u06d4"),(0,xe.Z)(de,"termsHead4","\u06cc\u06c1 \u0632\u0627\u0646\u065b\u06a9\u0672\u0631\u06cc \u0632 \u062a\u06c1\u06cd \u0686\u06be\u0648\u0655 \u0645\u06cc\u06cc\u0633 \u0633\u06a9\u06cc\u0645\u0633 \u067e\u0620\u0679\u06be \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0627\u0646:"),(0,xe.Z)(de,"termsText5","<p> \u0627\u06af\u0631 \u062a\u06c1\u0646\u065b\u062f\u0633 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0627\u06a9\u0627\u0648\u0646\u0679\u0633 \u0645\u0646\u065b\u0632 \u062a\u06c4\u06c1\u06c1 \u0632\u0627\u0646\u065b\u06a9\u0672\u0631\u06cc \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655 \u0648\u0646\u065b\u0646\u06c1\u0655 \u0686\u06be \u06cc\u0648\u0627\u0646\u060c \u062a\u06cc\u065a\u0644\u06c1 \u067e\u0632 \u062a\u06c4\u06c1\u06c1 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646 \u0648\u0627\u062c\u06cc\u065a\u0646\u06cd \u0632\u0627\u0646\u065b\u06a9\u0672\u0631\u06cc \u0645\u06a9\u0645\u0644 \u062a\u06c1\u0655 \u062f\u0631\u0633\u062a \u0622\u0633\u0646\u06d4 \u062a\u06c1\u06cd \u0686\u06be\u0648 \u06cc\u06c1 \u062a\u0633\u0644\u06cc\u0645 \u06a9\u0631\u0627\u0646 \u0632 \u0627\u06af\u0631 \u062a\u06c1\u06cd \u0646\u0627\u0645\u06a9\u0645\u0644\u060c \u063a\u0644\u0637\u060c \u06cc\u0627 \u063a\u0644\u0637 \u0632\u0627\u0646\u065b\u06a9\u0672\u0631\u06cc \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0627\u0646 \u0686\u06be\u0648\u060c \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645\u06a9 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0654\u0631\u0648 \u0627\u06a9\u06be \u063a\u0672\u0631 \u0642\u0648\u0646\u0648\u0657\u0646\u06cc \u06a9\u0627\u0631\u0648\u0672\u06cc\u06cc \u0627\u0646\u062c\u0627\u0645 \u062f\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655 (\u06cc\u0627 \u0627\u0646\u062c\u0627\u0645 \u062f\u0646\u0655\u0686 \u06a9\u0648\u0657\u0634\u0634 \u06a9\u0631\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655)\u060c \u06cc\u0627 \u0628\u0635\u0648\u0631\u062a \u062f\u06cc\u06af\u0631 \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645\u06a9 \u063a\u0644\u0637 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0654\u0631\u062a\u06be\u060c \u06cc\u06c1 \u06c1\u06cc\u065a\u06a9\u06c1 \u062a\u06c1\u0646\u065b\u062f \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u062a\u0627\u0645 \u0631\u0633\u0672\u06cc\u06cc \u0645\u0639\u0637\u0644 \u06cc\u0627 \u062e\u062a\u0645 \u06a9\u0654\u0631\u062a\u06be\u06d4 \u063a\u0644\u0637 \u06cc\u0627 \u06af\u0645\u0631\u0627\u06c1 \u06a9\u0646 \u0632\u0627\u0646\u065b\u06a9\u0672\u0631\u06cc \u062f\u0646\u06c1\u0655 \u0686\u06be \u0627\u06a9\u06be \u0633\u0646\u06af\u06cc\u0646 \u062c\u0631\u0645\u06d4 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06c1 \u0630\u0654\u0631\u06cc\u0639 \u0646\u0627\u0645\u06a9\u0645\u0644\u060c \u063a\u0644\u0637\u060c \u06cc\u0627 \u063a\u0644\u0637 \u0632\u0627\u0646\u065b\u06a9\u0672\u0631\u06cc \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u06c1\u0655 \u0633\u06ed\u062a\u06cd \u06cc\u06cc\u06c1\u0655 \u06cc\u062a\u06be \u06a9\u0654\u0646\u06cd \u0628\u0631\u062a\u0627\u0624 \u06a9\u0631\u0646\u06c1\u0655 \u06cc\u062a\u06be \u06a9\u0654\u0646\u06cd \u0632\u0646 \u0623\u06a9\u0633 \u0641\u0627\u0631\u0645\u0633 \u067e\u06cc\u065a\u0679\u06be \u06cc\u0627 \u0630\u0672\u062a\u06cc \u0637\u0648\u0631 \u063a\u0644\u0637 \u0632\u0627\u0646\u065b\u06a9\u0672\u0631\u06cc \u0641\u0631\u0627\u06c