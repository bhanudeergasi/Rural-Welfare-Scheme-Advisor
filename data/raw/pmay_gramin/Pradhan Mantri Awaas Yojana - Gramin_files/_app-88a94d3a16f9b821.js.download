28, \u0905\u0927\u093f\u0915\u093e\u0930 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0914\u0930 \u0935\u093f\u0935\u093e\u0926 \u0938\u092e\u093e\u0927\u093e\u0928"),(0,xe.Z)($,"urlSubHeading1Text","<span>1.1 myScheme URL \u0915\u094b \u0905\u092a\u0928\u0947 \u092e\u0942\u0932 \u0938\u094d\u0935\u0930\u0942\u092a \u092e\u0947\u0902 \u0939\u0940 \u0930\u0939\u0928\u093e \u091a\u093e\u0939\u093f\u090f, \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0938\u0902\u0936\u094b\u0927\u0928, \u091b\u094b\u091f\u093e \u0915\u0930\u0928\u0947, \u092e\u093e\u0938\u094d\u0915\u093f\u0902\u0917 \u092f\u093e \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092e\u0947\u0902 \u090f\u092e\u094d\u092c\u0947\u0921 \u0915\u093f\u090f, \u091c\u093f\u0938\u092e\u0947\u0902 iframes \u092f\u093e \u092a\u0941\u0928\u0930\u094d\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u0928 \u0938\u0947\u0935\u093e\u090f\u0901 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902, \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 myScheme \u092a\u094b\u0930\u094d\u091f\u0932 \u092a\u0930 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964</span><span>1.2 URL \u0915\u094b \u0939\u092e\u0947\u0936\u093e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u092e\u0927\u094d\u092f\u0938\u094d\u0925 \u092a\u0943\u0937\u094d\u0920, \u092a\u0949\u092a-\u0905\u092a \u092f\u093e \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092a\u0930\u0924\u094b\u0902 \u0915\u0947 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 myScheme.gov.in \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964</span><span>1.3 \u0939\u092e myScheme \u0915\u0947 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u0915\u094b \u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f \u092a\u0930 \u092b\u093c\u094d\u0930\u0947\u092e \u092e\u0947\u0902 \u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0928\u0939\u0940\u0902 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 myScheme \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u0915\u094b \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0940 \u0928\u0908 \u0916\u0941\u0932\u0940 \u092c\u094d\u0930\u093e\u0909\u091c\u093c\u0930 \u0935\u093f\u0902\u0921\u094b \u092e\u0947\u0902 \u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964</span>"),(0,xe.Z)($,"urlSubHeading2Text","<span>2.1 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0921\u0947\u091f\u093e \u0914\u0930 URL \u0915\u0940 \u0905\u0916\u0902\u0921\u0924\u093e \u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u092a\u093e\u0930\u094d\u091f\u0940 \u0915\u094b HTTPS \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u0936\u0928, \u092b\u093c\u093e\u092f\u0930\u0935\u0949\u0932 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0914\u0930 \u0928\u093f\u092f\u092e\u093f\u0924 \u092a\u0948\u0920 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0938\u0939\u093f\u0924 \u092e\u091c\u092c\u0942\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 \u0932\u093e\u0917\u0942 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964</span><span>2.2 \u092a\u093e\u0930\u094d\u091f\u0940 \u0915\u094b \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0921\u0947\u091f\u093e \u0914\u0930 URL \u0915\u0940 \u0905\u0916\u0902\u0921\u0924\u093e \u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f HTTPS \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u0936\u0928, \u092b\u093c\u093e\u092f\u0930\u0935\u0949\u0932 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0914\u0930 \u0928\u093f\u092f\u092e\u093f\u0924 \u092a\u0948\u0920 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0938\u0939\u093f\u0924 \u092e\u091c\u092c\u0942\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 \u0932\u093e\u0917\u0942 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964</span><span>2.2 \u092a\u093e\u0930\u094d\u091f\u0940 \u0915\u094b \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0921\u0947\u091f\u093e \u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f HTTPS \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u0936\u0928, \u092b\u093c\u093e\u092f\u0930\u0935\u0949\u0932 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0914\u0930 \u0928\u093f\u092f\u092e\u093f\u0924 \u092a\u0948\u0920 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0938\u0939\u093f\u0924 \u092e\u091c\u092c\u0942\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 \u0932\u093e\u0917\u0942 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964</span><span> \u0935\u0947\u092c \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u092e\u091c\u093c\u094b\u0930\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f OWASP \u0936\u0940\u0930\u094d\u0937 10 \u0938\u0939\u093f\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u093e\u0928\u0915\u094b\u0902 \u0915\u093e \u0905\u0928\u0941\u092a\u093e\u0932\u0928 \u0915\u0930\u0947\u0902\u0964</span><span>2.3 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u0915\u0940 \u0938\u0942\u091a\u0928\u093e 24 \u0918\u0902\u091f\u0947 \u0915\u0947 \u092d\u0940\u0924\u0930 myScheme \u091f\u0940\u092e \u0915\u094b \u0926\u0940 \u091c\u093e\u0928\u0940 \u091a\u093e\u0939\u093f\u090f, \u0914\u0930 \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u0915\u094b \u0915\u092e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0924\u094d\u0915\u093e\u0932 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0940 \u091c\u093e\u0928\u0940 \u091a\u093e\u0939\u093f\u090f\u0964</span><span>2.4 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u093e\u0928\u0915\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0928\u093f\u0930\u0902\u0924\u0930 \u0905\u0928\u0941\u092a\u093e\u0932\u0928 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0940\u0938\u0930\u0947 \u092a\u0915\u094d\u0937 \u0915\u0947 \u0906\u0915\u0932\u0928 \u0938\u0939\u093f\u0924 \u0928\u093f\u092f\u092e\u093f\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0911\u0921\u093f\u091f \u0915\u093f\u090f \u091c\u093e\u0928\u0947 \u091a\u093e\u0939\u093f\u090f\u0964</span>"),(0,xe.Z)($,"urlSubHeading3Text","<span>3.1 myScheme URL \u0915\u094b \u0910\u0938\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0939\u094b\u0938\u094d\u091f \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u091c\u094b myScheme \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0915\u094b \u0938\u091f\u0940\u0915 \u0930\u0942\u092a \u0938\u0947 \u0926\u0930\u094d\u0936\u093e\u0924\u0940 \u0939\u094b \u0914\u0930 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u0917\u0941\u092e\u0930\u093e\u0939 \u0928 \u0915\u0930\u0947\u0964 \u0907\u0938\u0947 \u0905\u092a\u092e\u093e\u0928\u091c\u0928\u0915, \u0905\u0936\u094d\u0932\u0940\u0932, \u092d\u094d\u0930\u093e\u092e\u0915 \u092f\u093e \u0905\u0928\u094d\u092f\u0925\u093e \u0905\u0928\u0941\u091a\u093f\u0924 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0935\u093e\u0932\u0947 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u092a\u0930 \u0939\u094b\u0938\u094d\u091f \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u091c\u094b \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0928\u0940\u0924\u093f \u092f\u093e \u0938\u093e\u092e\u0941\u0926\u093e\u092f\u093f\u0915 \u092e\u093e\u0928\u0915\u094b\u0902 \u0915\u093e \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u0915\u0930\u0924\u093e \u0939\u094b\u0964</span><span>3.2 myScheme \u091f\u0940\u092e \u092d\u093e\u0917\u0940\u0926\u093e\u0930 \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u094b\u0902 \u092a\u0930 URL \u0915\u0947 \u092a\u094d\u0932\u0947\u0938\u092e\u0947\u0902\u091f \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0928\u0947 \u0915\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0924\u0940 \u0939\u0948\u0964</span>"),(0,xe.Z)($,"urlSubHeading4Text","<span>4.1 URL \u0915\u094b \u0924\u0943\u0924\u0940\u092f-\u092a\u0915\u094d\u0937 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0915\u0947 \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u0905\u0928\u0941\u092d\u093e\u0917\u094b\u0902 \u092e\u0947\u0902 \u0930\u0916\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u091c\u094b myScheme \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0914\u0930 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0938\u0902\u0930\u0947\u0916\u093f\u0924 \u0939\u094b\u0902, \u091c\u093f\u0938\u092e\u0947\u0902 \u0926\u0943\u0936\u094d\u092f\u092e\u093e\u0928, \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u0905\u0928\u0941\u0915\u0942\u0932 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 (\u091c\u0948\u0938\u0947, \u092b\u094b\u0932\u094d\u0921 \u0915\u0947 \u090a\u092a\u0930 \u092f\u093e \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u0938\u0930\u0915\u093e\u0930\u0940 \u0938\u0947\u0935\u093e \u0905\u0928\u0941\u092d\u093e\u0917 \u0915\u0947 \u092d\u0940\u0924\u0930) \u0915\u094b \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e \u0926\u0940 \u091c\u093e\u090f\u0964</span><span>4.2 URL \u0915\u094b \u0910\u0938\u0947 \u0938\u0902\u0926\u0930\u094d\u092d \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0930\u0916\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u091c\u094b \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b myScheme \u0915\u0940 \u092a\u094d\u0930\u0915\u0943\u0924\u093f \u092f\u093e \u0907\u0938\u0915\u0940 \u0938\u0930\u0915\u093e\u0930\u0940 \u0938\u0902\u092c\u0926\u094d\u0927\u0924\u093e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092d\u094d\u0930\u092e\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964</span>"),(0,xe.Z)($,"urlSubHeading5Text","<span>5.1 \u0906\u092a \u0938\u092d\u0940 \u0932\u093e\u0917\u0942 \u0915\u093e\u0928\u0942\u0928, \u0935\u093f\u0928\u093f\u092f\u092e\u0928 \u0914\u0930 \u0924\u0940\u0938\u0930\u0947 \u092a\u0915\u094d\u0937 \u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930\u094b\u0902 (\u0921\u0947\u091f\u093e \u092f\u093e \u0938\u0949\u092b\u093c\u094d\u091f\u0935\u0947\u092f\u0930 \u0915\u0947 \u0906\u092f\u093e\u0924 \u092f\u093e \u0928\u093f\u0930\u094d\u092f\u093e\u0924, \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0938\u0940\u092e\u093e \u0915\u0947 \u0915\u093e\u0928\u0942\u0928\u094b\u0902 \u0938\u0939\u093f\u0924) \u0915\u093e \u0905\u0928\u0941\u092a\u093e\u0932\u0928 \u0915\u0930\u0947\u0902\u0917\u0947 \u0906\u0926\u093f)\u0964</span><span>5.2 \u0906\u092a \u0907\u0928 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u0947 \u0924\u0939\u0924 \u0906\u092a\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u090f\u0915\u094d\u0938\u0947\u0938 \u092f\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u093f\u090f \u0917\u090f \u0921\u0947\u091f\u093e \u0915\u094b \u0938\u0902\u092d\u093e\u0932\u0924\u0947 \u0938\u092e\u092f \u0909\u092a\u092f\u094b\u0917 \u0915\u0947 \u0938\u092e\u092f \u0921\u093f\u091c\u093f\u091f\u0932 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0921\u0947\u091f\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0905\u0927\u093f\u0928\u093f\u092f\u092e, 2023, \u0914\u0930 \u0938\u0942\u091a\u0928\u093e \u092a\u094d\u0930\u094c\u0926\u094d\u092f\u094b\u0917\u093f\u0915\u0940 \u0905\u0927\u093f\u0928\u093f\u092f\u092e, 2000, \u092f\u093e \u0907\u0938\u092e\u0947\u0902 \u092c\u0928\u093e\u090f \u0917\u090f \u0915\u093f\u0938\u0940 \u092d\u0940 \u0928\u093f\u092f\u092e \u092f\u093e \u0935\u093f\u0928\u093f\u092f\u092e\u0928, \u0914\u0930 \u0905\u0928\u094d\u092f \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u092a\u094d\u0930\u091a\u0932\u093f\u0924 \u0915\u093e\u0928\u0942\u0928\u094b\u0902/\u0928\u093f\u092f\u092e\u094b\u0902/\u0905\u0927\u094d\u092f\u093e\u0926\u0947\u0936\u094b\u0902/\u0905\u0927\u093f\u0938\u0942\u091a\u0928\u093e\u0913\u0902/\u0909\u092a\u0928\u093f\u092f\u092e\u094b\u0902 \u0906\u0926\u093f \u0938\u0939\u093f\u0924 \u092a\u094d\u0930\u091a\u0932\u093f\u0924 \u0921\u0947\u091f\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u093e\u0928\u0942\u0928\u094b\u0902 \u0914\u0930 \u0935\u093f\u0928\u093f\u092f\u092e\u094b\u0902 \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0947\u0902\u0917\u0947\u0964</span><span>5.3 \u0906\u092a \u0915\u093f\u0938\u0940 \u092d\u0940 \u0910\u0938\u0947 \u0921\u0947\u091f\u093e \u0915\u094b \u0938\u0902\u0938\u093e\u0927\u093f\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930\u0947\u0902\u0917\u0947 \u091c\u094b \u0915\u093f\u0938\u0940 \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u0915\u093e\u0928\u0942\u0928 \u092f\u093e \u0935\u093f\u0928\u093f\u092f\u092e\u0928 \u0915\u0947 \u0924\u0939\u0924 \u0936\u093e\u0938\u093f\u0924 \u0939\u094b \u091c\u093f\u0938\u0915\u0947 \u0932\u093f\u090f \u0938\u0915\u094d\u0937\u092e \u092a\u094d\u0930\u093e\u0927\u093f\u0915\u093e\u0930\u0940 \u0938\u0947 \u0909\u0915\u094d\u0924 \u0938\u0939\u092e\u0924\u093f \u092f\u093e \u0905\u0928\u0941\u092e\u094b\u0926\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u093f\u090f \u092c\u093f\u0928\u093e \u0905\u0932\u0917 \u0938\u0939\u092e\u0924\u093f \u092f\u093e \u0905\u0928\u0941\u092e\u094b\u0926\u0928 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0924\u0940 \u0939\u0948\u0964</span><span>5.4 \u092a\u093e\u0930\u094d\u091f\u0940 \u0915\u094b \u092f\u0939 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e \u0915\u093f URL \u0915\u094b \u0939\u094b\u0938\u094d\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947\u0902 \u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u0915\u094b\u0908 \u092d\u0940 \u0924\u0943\u0924\u0940\u092f-\u092a\u0915\u094d\u0937 \u0938\u0947\u0935\u093e\u090f\u0901 \u092f\u093e \u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u0915\u093e\u0928\u0942\u0928\u094b\u0902 \u0915\u093e \u0905\u0928\u0941\u092a\u093e\u0932\u0928 \u0915\u0930\u0924\u0940 \u0939\u0948\u0902\u0964</span>"),(0,xe.Z)($,"urlSubHeading6Text","<span>6.1 myScheme URL \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0910\u0938\u0947 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u091c\u094b \u092d\u094d\u0930\u093e\u092e\u0915, \u092d\u094d\u0930\u093e\u092e\u0915 \u092f\u093e \u0917\u0948\u0930\u0915\u093e\u0928\u0942\u0928\u0940 \u0939\u094b, \u091c\u093f\u0938\u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0907\u0938\u0915\u0947 \u0905\u0932\u093e\u0935\u093e \u0917\u0948\u0930\u0915\u093e\u0928\u0942\u0928\u0940 \u092a\u0941\u0928\u0930\u094d\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u0928, \u092b\u093c\u093f\u0936\u093f\u0902\u0917 \u092f\u093e \u0905\u0928\u094d\u092f \u0926\u0941\u0930\u094d\u092d\u093e\u0935\u0928\u093e\u092a\u0942\u0930\u094d\u0923 \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u0924\u0915 \u0938\u0940\u092e\u093f\u0924\u0964 \u0906\u092a\u0915\u094b URL \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u093f\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948, \u0907\u0938\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0910\u0938\u0947 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u091c\u094b myScheme \u0915\u0940 \u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f\u0924\u093e \u0915\u094b \u0917\u0932\u0924 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0924\u093e \u0939\u094b \u092f\u093e \u0915\u092e \u0915\u0930\u0924\u093e \u0939\u094b\u0964</span><span>6.2 URL \u0915\u093e \u0909\u092a\u092f\u094b\u0917 myScheme \u0915\u0940 \u092a\u0942\u0930\u094d\u0935 \u0932\u093f\u0916\u093f\u0924 \u0938\u0939\u092e\u0924\u093f \u0915\u0947 \u092c\u093f\u0928\u093e \u0935\u093e\u0923\u093f\u091c\u094d\u092f\u093f\u0915 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928\u094b\u0902, \u092a\u094d\u0930\u091a\u093e\u0930\u094b\u0902 \u092f\u093e \u0932\u093e\u092d-\u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964</span>"),(0,xe.Z)($,"urlSubHeading7Text","<span>\u0906\u092a (\u090f\u0915 \u201c\u0915\u094d\u0937\u0924\u093f\u092a\u0942\u0930\u094d\u0924\u093f \u092a\u0915\u094d\u0937\u201d \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902), \u0915\u093e\u0928\u0942\u0928 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u0928\u0941\u092e\u0924 \u0905\u0927\u093f\u0915\u0924\u092e \u0938\u0940\u092e\u093e \u0924\u0915, \u0939\u092e\u093e\u0930\u093e \u092c\u091a\u093e\u0935, \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0914\u0930 \u0915\u094d\u0937\u0924\u093f\u092a\u0942\u0930\u094d\u0924\u093f \u0915\u0930\u0947\u0902\u0917\u0947 (\u090f\u0915 \u201c\u0915\u094d\u0937\u0924\u093f\u092a\u0942\u0930\u094d\u0924\u093f \u092a\u0915\u094d\u0937\u201d \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902)\u0964 \u0915\u094d\u0937\u0924\u093f\u092a\u0942\u0930\u094d\u0924\u093f \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u092a\u0915\u094d\u0937 \u0915\u094d\u0937\u0924\u093f\u092a\u0942\u0930\u094d\u0924\u093f \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u092a\u0915\u094d\u0937 \u0914\u0930 \u0909\u0928\u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930\u093f\u092f\u094b\u0902, \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u093f\u092f\u094b\u0902, \u0928\u093f\u0926\u0947\u0936\u0915\u094b\u0902 \u0914\u0930 \u0938\u0932\u093e\u0939\u0915\u093e\u0930\u094b\u0902 \u0915\u094b, \u091c\u0948\u0938\u093e \u092d\u0940 \u092e\u093e\u092e\u0932\u093e \u0939\u094b (\u0907\u0938 \u0916\u0902\u0921 \u092e\u0947\u0902 '\u0915\u094d\u0937\u0924\u093f\u092a\u0942\u0930\u094d\u0924\u093f \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u092a\u0915\u094d\u0937' \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0938\u0902\u0926\u0930\u094d\u092d\u093f\u0924 \u0938\u092d\u0940 \u0924\u0943\u0924\u0940\u092f \u092a\u0915\u094d\u0937), \u0915\u093f\u0938\u0940 \u092d\u0940 \u0914\u0930 \u0938\u092d\u0940 \u0938\u093f\u0926\u094d\u0927 \u092f\u093e \u0915\u0925\u093f\u0924 \u0928\u0941\u0915\u0938\u093e\u0928, \u092e\u093e\u0902\u0917\u094b\u0902, \u0915\u094d\u0937\u0924\u093f\u092f\u094b\u0902, \u0926\u0947\u0928\u0926\u093e\u0930\u093f\u092f\u094b\u0902, \u092c\u094d\u092f\u093e\u091c, \u092a\u0941\u0930\u0938\u094d\u0915\u093e\u0930, \u0928\u093f\u0930\u094d\u0923\u092f, \u0928\u093f\u092a\u091f\u093e\u0928, \u091c\u0941\u0930\u094d\u092e\u093e\u0928\u093e, \u0926\u0902\u0921 \u0914\u0930 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0924\u0943\u0924\u0940\u092f \u092a\u0915\u094d\u0937 \u0915\u0947 \u0926\u093e\u0935\u094b\u0902, \u0915\u093e\u0930\u094d\u092f\u094b\u0902, \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0947 \u0915\u093e\u0930\u0923\u094b\u0902 \u092f\u093e \u092e\u0941\u0915\u0926\u092e\u094b\u0902 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0938\u092e\u091d\u094c\u0924\u094b\u0902 \u0938\u0947 \u0939\u093e\u0928\u093f\u0930\u0939\u093f\u0924 \u0930\u0916\u0947\u0917\u093e, \u091c\u094b \u0907\u0928 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u0947 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u092f\u093e \u0917\u0948\u0930-\u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u092f\u093e \u092f\u0939\u093e\u0902 \u0928\u093f\u0939\u093f\u0924 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0935\u093e\u0930\u0902\u091f\u0940, \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f\u0924\u094d\u0935 \u092f\u093e \u0935\u093e\u091a\u093e \u0915\u0947 \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u0915\u0947 \u0915\u093e\u0930\u0923 \u092f\u093e \u0907\u0938\u0915\u0947 \u0915\u093e\u0930\u0923 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u094d\u0937\u0924\u093f\u092a\u0942\u0930\u094d\u0924\u093f \u0915\u0930\u0928\u0947 \u0915\u093e \u0926\u093e\u092f\u093f\u0924\u094d\u0935 \u0915\u094d\u0937\u0924\u093f\u092a\u0942\u0930\u094d\u0924\u093f \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u092a\u0915\u094d\u0937 \u0926\u094d\u0935\u093e\u0930\u093e \u0910\u0938\u0947 \u0926\u093e\u0935\u094b\u0902, \u092e\u093e\u0902\u0917\u094b\u0902, \u092e\u0941\u0915\u0926\u092e\u094b\u0902 \u092f\u093e \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0907\u092f\u094b\u0902 \u0915\u093e \u092c\u091a\u093e\u0935 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0915\u093f\u090f \u0917\u090f \u0938\u092d\u0940 \u0932\u093e\u0917\u0924\u094b\u0902 \u0914\u0930 \u0916\u0930\u094d\u091a\u094b\u0902 \u0924\u0915 \u0935\u093f\u0938\u094d\u0924\u093e\u0930\u093f\u0924 \u0914\u0930 \u0936\u093e\u092e\u093f\u0932 \u0939\u094b\u0917\u093e, \u091c\u093f\u0938\u092e\u0947\u0902 \u0935\u0915\u0940\u0932, \u0917\u0935\u093e\u0939 \u0914\u0930 \u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e \u0917\u0935\u093e\u0939 \u0915\u0940 \u092b\u0940\u0938 \u0914\u0930 \u0915\u094b\u0908 \u0905\u0928\u094d\u092f \u092e\u0941\u0915\u0926\u092e\u0947\u092c\u093e\u091c\u0940 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0916\u0930\u094d\u091a \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0907\u0928\u094d\u0939\u0940\u0902 \u0924\u0915 \u0938\u0940\u092e\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964</span>"),(0,xe.Z)($,"urlSubHeading8Text",'<span>8.1 API \u0915\u094b "\u091c\u0948\u0938\u093e \u0939\u0948" \u0915\u093f\u0938\u0940 \u092d\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0940 \u0935\u093e\u0930\u0902\u091f\u0940 \u0915\u0947 \u092c\u093f\u0928\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0939\u092e \u0938\u092d\u0940 \u0935\u093e\u0930\u0902\u091f\u0940, \u0935\u094d\u092f\u0915\u094d\u0924 \u092f\u093e \u0928\u093f\u0939\u093f\u0924, \u091c\u093f\u0938\u092e\u0947\u0902 \u0935\u094d\u092f\u093e\u092a\u093e\u0930\u093f\u0915\u0924\u093e, \u0915\u093f\u0938\u0940 \u0935\u093f\u0936\u0947\u0937 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u0941\u0915\u094d\u0924\u0924\u093e \u0914\u0930 \u0917\u0948\u0930-\u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u0915\u0940 \u0935\u093e\u0930\u0902\u091f\u0940 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0907\u0928\u094d\u0939\u0940\u0902 \u0924\u0915 \u0938\u0940\u092e\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0915\u094b \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964</span><span>8.2 \u092a\u093e\u0930\u094d\u091f\u0940 myScheme URL \u0915\u094b \u0939\u094b\u0938\u094d\u091f \u0915\u0930\u0928\u0947 \u0938\u0947 \u091c\u0941\u0921\u093c\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0914\u0930 \u0938\u092d\u0940 \u091c\u094b\u0916\u093f\u092e\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u0939\u094b\u0917\u0940, \u091c\u093f\u0938\u092e\u0947\u0902 \u0938\u093e\u0907\u092c\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0916\u0924\u0930\u0947, \u092a\u094d\u0930\u0924\u093f\u0937\u094d\u0920\u093e \u0915\u094b \u0928\u0941\u0915\u0938\u093e\u0928 \u092f\u093e \u0915\u093e\u0928\u0942\u0928\u0940 \u092a\u0930\u093f\u0923\u093e\u092e \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0907\u0928\u094d\u0939\u0940\u0902 \u0924\u0915 \u0938\u0940\u092e\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964</span><span>8.3 myScheme URL \u0915\u094b \u0939\u094b\u0938\u094d\u091f \u0915\u0930\u0928\u0947 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092a\u093e\u0930\u094d\u091f\u0940 \u0915\u0940 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0907\u092f\u094b\u0902 \u092f\u093e \u091a\u0942\u0915 \u0938\u0947 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0940 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0915\u094d\u0937\u0924\u093f, \u0939\u093e\u0928\u093f \u092f\u093e \u0926\u0947\u0928\u0926\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u0940 \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u0940\u0964 \u092a\u093e\u0930\u094d\u091f\u0940 \u0938\u092d\u0940 \u0932\u093e\u0917\u0942 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932, \u0915\u093e\u0928\u0942\u0928\u094b\u0902 \u0914\u0930 \u0935\u093f\u0928\u093f\u092f\u092e\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u092a\u093e\u0932\u0928 \u0915\u094b \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u0939\u094b\u0917\u0940\u0964</span>'),(0,xe.Z)($,"urlSubHeading9Text","<span>9.1 myScheme \u0924\u0924\u094d\u0915\u093e\u0932 \u0939\u091f\u093e\u0928\u0947 \u0915\u093e \u0906\u0926\u0947\u0936 \u0926\u0947\u0928\u0947 \u0915\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0924\u093e \u0939\u0948 \u0914\u0930 \u092f\u0926\u093f \u0906\u092a \u0915\u093f\u0938\u0940 \u092d\u0940 \u0928\u093f\u092f\u092e \u0915\u093e \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u0915\u0930\u0924\u0947 \u092a\u093e\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0938\u0947 URL \u0915\u094b \u0924\u0941\u0930\u0902\u0924 \u0939\u091f\u093e\u0928\u093e \u0939\u094b\u0917\u093e\u0964</span><span>9.2 \u092a\u093e\u0930\u094d\u091f\u0940 \u0915\u094b \u0907\u0938 \u0924\u0930\u0939 \u0915\u0947 \u0938\u0902\u091a\u093e\u0930 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0905\u0921\u093c\u0924\u093e\u0932\u0940\u0938 (48) \u0918\u0902\u091f\u094b\u0902 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0939\u091f\u093e\u0928\u0947 \u0915\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0910\u0938\u0947 \u0906\u0926\u0947\u0936 \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e\u0964</span>"),(0,xe.Z)($,"urlSubHeading10Text","<span>myScheme \u0905\u092a\u0928\u0947 \u0935\u093f\u0935\u0947\u0915 \u092a\u0930, URL \u092a\u094d\u0932\u0947\u0938\u092e\u0947\u0902\u091f, \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0909\u092a\u093e\u092f\u094b\u0902 \u0914\u0930 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0939\u094b\u0938\u094d\u091f\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0938\u0930\u094d\u0935\u094b\u0924\u094d\u0924\u092e \u092a\u094d\u0930\u0925\u093e\u0913\u0902 \u0938\u0939\u093f\u0924 \u0907\u0928 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u093e \u0905\u0928\u0941\u092a\u093e\u0932\u0928 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092a\u093e\u0930\u094d\u091f\u0940 \u0915\u0940 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0938\u0902\u0938\u093e\u0927\u0928 \u092f\u093e \u0926\u093f\u0936\u093e\u0928\u093f\u0930\u094d\u0926\u0947\u0936 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964</span>"),(0,xe.Z)($,"urlSubHeading11Text","<span>a. \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092e\u0947\u0902 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0938\u0940\u092e\u093e \u0915\u0947, \u091f\u094d\u0930\u0947\u0921\u092e\u093e\u0930\u094d\u0915, \u0915\u0949\u092a\u0940\u0930\u093e\u0907\u091f, \u0921\u093f\u091c\u093c\u093e\u0907\u0928 \u092f\u093e \u092a\u0947\u091f\u0947\u0902\u091f \u0938\u0939\u093f\u0924 \u0938\u092d\u0940 \u092c\u094c\u0926\u094d\u0927\u093f\u0915 \u0938\u0902\u092a\u0926\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0914\u0930 \u0939\u093f\u0924 \u0935\u093f\u0936\u0947\u0937 \u0930\u0942\u092a \u0938\u0947 \u0939\u092e\u093e\u0930\u0947 \u092a\u093e\u0938 \u0939\u094b\u0902\u0917\u0947\u0964 \u092f\u0947 \u0936\u0930\u094d\u0924\u0947\u0902 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0906\u092a\u0915\u094b \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 \u0915\u094b\u0908 \u0938\u094d\u0935\u093e\u092e\u093f\u0924\u094d\u0935 \u0905\u0927\u093f\u0915\u093e\u0930 \u092f\u093e \u0935\u093f\u0936\u093f\u0937\u094d\u091f\u0924\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964</span><span>b. \u0906\u092a \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0915\u0940 \u0905\u092a\u0928\u0940 \u0939\u094b\u0938\u094d\u091f\u093f\u0902\u0917/\u0939\u093e\u0907\u092a\u0930\u0932\u093f\u0902\u0915\u093f\u0902\u0917 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0915\u094b\u0908 \u092d\u0940 \u0910\u0938\u093e \u092c\u092f\u093e\u0928 \u0928\u0939\u0940\u0902 \u0926\u0947\u0902\u0917\u0947 \u091c\u094b \u0939\u092e\u093e\u0930\u0940 \u092a\u0942\u0930\u094d\u0935 \u0932\u093f\u0916\u093f\u0924 \u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f \u0915\u0947 \u092c\u093f\u0928\u093e \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u0938\u093e\u091d\u0947\u0926\u093e\u0930\u0940, \u092a\u094d\u0930\u093e\u092f\u094b\u091c\u0928 \u092f\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u093e \u0938\u0941\u091d\u093e\u0935 \u0926\u0947\u0924\u093e \u0939\u094b\u0964</span><span>c. \u0939\u092e \u0910\u0938\u0947 \u0939\u093e\u0907\u092a\u0930\u0932\u093f\u0902\u0915 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u0915\u0947\u0935\u0932 \u0939\u092e\u093e\u0930\u093e \u0928\u093e\u092e \u092f\u093e \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0924\u093e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u094b\u0964 \u0939\u093e\u0907\u092a\u0930\u0932\u093f\u0902\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 myScheme \u0932\u094b\u0917\u094b, \u0935\u094d\u092f\u093e\u092a\u093e\u0930 \u0928\u093e\u092e \u0914\u0930 \u091f\u094d\u0930\u0947\u0921\u092e\u093e\u0930\u094d\u0915 \u0915\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0909\u092a\u092f\u094b\u0917 \u092f\u093e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0928\u0939\u0940\u0902 \u0926\u0940 \u091c\u093e\u090f\u0917\u0940\u0964</span>"),(0,xe.Z)($,"urlSubHeading12Text","<span>\u0939\u092e \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u092f, \u0928\u094b\u091f\u093f\u0938 \u0915\u0947 \u0938\u093e\u0925 \u092f\u093e \u092c\u093f\u0928\u093e \u0928\u094b\u091f\u093f\u0938 \u0915\u0947 \u0907\u0928 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u094b \u0938\u0902\u0936\u094b\u0927\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0938\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0939\u0948 \u0915\u093f \u0906\u092a myScheme URL \u0915\u0947 \u0928\u093f\u0930\u0902\u0924\u0930 \u0909\u092a\u092f\u094b\u0917/\u0939\u094b\u0938\u094d\u091f\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0938\u092e\u092f-\u0938\u092e\u092f \u092a\u0930 \u0907\u0928 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902\u0964</span>"),(0,xe.Z)($,"urlSubHeading13Text","<span>\u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902 \u0939\u092e myScheme URL \u0915\u0947 \u0906\u092a\u0915\u0947 \u0909\u092a\u092f\u094b\u0917/\u0939\u094b\u0938\u094d\u091f\u093f\u0902\u0917 \u0938\u0947 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u092f\u093e \u0909\u0938\u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0905\u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937, \u0935\u093f\u0936\u0947\u0937, \u0906\u0915\u0938\u094d\u092e\u093f\u0915 \u092f\u093e \u092a\u0930\u093f\u0923\u093e\u092e\u0940 \u0915\u094d\u0937\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u0940 \u0928\u0939\u0940\u0902 \u0939\u094b\u0902\u0917\u0947, \u091a\u093e\u0939\u0947 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u093e \u0915\u093e\u0930\u0923 \u0915\u0941\u091b \u092d\u0940 \u0939\u094b (\u091a\u093e\u0939\u0947 \u0905\u0928\u0941\u092c\u0902\u0927, \u0905\u092a\u0915\u093e\u0930, \u0935\u093e\u0930\u0902\u091f\u0940 \u0915\u093e \u0909\u0932\u094d\u0932\u0902\u0918\u0928, \u092f\u093e \u0905\u0928\u094d\u092f\u0925\u093e) \u0914\u0930 \u092d\u0932\u0947 \u0939\u0940 \u0939\u092e\u0947\u0902 \u0910\u0938\u0947 \u0928\u0941\u0915\u0938\u093e\u0928 \u0915\u0940 \u0938\u0902\u092d\u093e\u0935\u0928\u093e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0938\u0942\u091a\u093f\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u094b\u0964</span>"),(0,xe.Z)($,"urlSubHeading14Text","<span>\u092f\u0926\u093f \u0907\u0928 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u093e \u0915\u094b\u0908 \u092a\u094d\u0930\u093e\u0935\u0927\u093e\u0928 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0915\u093e\u0930\u0923 \u0938\u0947 \u0932\u093e\u0917\u0942 \u0928 \u0939\u094b\u0928\u0947 \u092f\u094b\u0917\u094d\u092f \u092a\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u0924\u094b \u0907\u0938\u0915\u0947 \u0936\u0947\u0937 \u092a\u094d\u0930\u093e\u0935\u0927\u093e\u0928 \u0905\u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0930\u0939\u0947\u0902\u0917\u0947 \u0914\u0930 \u092a\u0942\u0930\u094d\u0923 \u092c\u0932 \u0914\u0930 \u092a\u094d\u0930\u092d\u093e\u0935 \u092e\u0947\u0902 \u0930\u0939\u0947\u0902\u0917\u0947\u0964</span>"),(0,xe.Z)($,"urlSubHeading15Text","<span>\u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e, \u0907\u0938\u0915\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092f\u093e \u0907\u0938\u0915\u0940 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0915\u094b\u0908 \u092d\u0940 \u0936\u093f\u0915\u093e\u092f\u0924, \u0936\u093f\u0915\u093e\u092f\u0924 \u092f\u093e \u091a\u093f\u0902\u0924\u093e, \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 CTO, NeGD, Digital \u0915\u094b \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0915\u0940 \u091c\u093e\u090f\u0917\u0940\u0964 \u0907\u0902\u0921\u093f\u092f\u093e \u0915\u0949\u0930\u092a\u094b\u0930\u0947\u0936\u0928 \u0926\u094d\u0935\u093e\u0930\u093e \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930\u093f\u0924 \u0914\u0930 \u092e\u0927\u094d\u092f\u0938\u094d\u0925\u0924\u093e \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092a\u093e\u0930\u0938\u094d\u092a\u0930\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0939\u0932 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964</span><span>\u092f\u0947 \u0928\u093f\u092f\u092e \u092d\u093e\u0930\u0924\u0940\u092f \u0915\u093e\u0928\u0942\u0928\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0936\u093e\u0938\u093f\u0924 \u0939\u094b\u0902\u0917\u0947 \u0914\u0930 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092a\u0915\u094d\u0937 \u0926\u093f\u0932\u094d\u0932\u0940, \u092d\u093e\u0930\u0924 \u092e\u0947\u0902 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u094b\u0902 \u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u094b \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0947\u0917\u093e\u0964</span><span>\u0907\u0928 \u0928\u093f\u092f\u092e\u094b\u0902 \u0938\u0947 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u092e\u0924\u092d\u0947\u0926 \u092f\u093e \u0935\u093f\u0935\u093e\u0926, \u091c\u093f\u0938\u092e\u0947\u0902 \u0907\u0938\u0915\u0947 \u0905\u0938\u094d\u0924\u093f\u0924\u094d\u0935, \u0935\u0948\u0927\u0924\u093e \u092f\u093e \u0938\u092e\u093e\u092a\u094d\u0924\u093f \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0915\u094b\u0908 \u092a\u094d\u0930\u0936\u094d\u0928 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948, \u0915\u094b \u092a\u093e\u0930\u094d\u091f\u093f\u092f\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092a\u093e\u0930\u0938\u094d\u092a\u0930\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0939\u0932 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964</span><span>\u0909\u092a\u0930\u094d\u092f\u0941\u0915\u094d\u0924 \u0930\u0942\u092a \u0938\u0947 \u0935\u093f\u0935\u093e\u0926\u094b\u0902 \u0915\u0947 \u0938\u092e\u093e\u0927\u093e\u0928 \u0928 \u0939\u094b\u0928\u0947 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902, \u0935\u093f\u0935\u093e\u0926 \u0915\u094b \u092e\u0927\u094d\u092f\u0938\u094d\u0925\u0924\u093e \u0914\u0930 \u0938\u0941\u0932\u0939 \u0905\u0927\u093f\u0928\u093f\u092f\u092e, 1996 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0926\u094b\u0928\u094b\u0902 \u092a\u0915\u094d\u0937\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u093e\u0930\u0938\u094d\u092a\u0930\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0928\u093f\u092f\u0941\u0915\u094d\u0924 \u090f\u0915\u092e\u093e\u0924\u094d\u0930 \u092e\u0927\u094d\u092f\u0938\u094d\u0925 \u0915\u0947 \u092e\u0927\u094d\u092f\u0938\u094d\u0925\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u092d\u0947\u091c\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u092e\u0927\u094d\u092f\u0938\u094d\u0925\u0924\u093e \u0915\u093e \u0938\u094d\u0925\u093e\u0928 \u0914\u0930 \u0938\u0940\u091f \u0928\u0908 \u0926\u093f\u0932\u094d\u0932\u0940 \u092e\u0947\u0902 \u0939\u094b\u0917\u0940 \u0914\u0930 \u0915\u093e\u0930\u094d\u092f\u0935\u093e\u0939\u0940 \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0906\u092f\u094b\u091c\u093f\u0924 \u0915\u0940 \u091c\u093e\u090f\u0917\u0940\u0964 \u092f\u0926\u093f \u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u0935\u093f\u0935\u093e\u0926 \u0938\u092e\u093e\u0927\u093e\u0928 \u0924\u0902\u0924\u094d\u0930 \u0935\u093f\u0935\u093e\u0926 \u0915\u094b \u0939\u0932 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932 \u0930\u0939\u0924\u093e \u0939\u0948, \u0924\u094b \u092a\u0915\u094d\u0937 \u092e\u0941\u0915\u0926\u092e\u0947\u092c\u093e\u091c\u0940 \u0915\u094b \u0905\u0902\u0924\u093f\u092e \u0909\u092a\u093e\u092f \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0939\u0940 \u0905\u092a\u0928\u093e\u090f\u0902\u0917\u0947\u0964</span>"),(0,xe.Z)($,"urlHostingText1",'<p>\u092f\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u0936\u0930\u094d\u0924\u0947\u0902 ("\u0936\u0930\u094d\u0924\u0947\u0902") \u0906\u092a\u0915\u0940 ("\u0906\u092a/\u0906\u092a\u0915\u0940/\u092a\u093e\u0930\u094d\u091f\u0940") \u0939\u094b\u0938\u094d\u091f\u093f\u0902\u0917 \u0914\u0930 \u0906\u092a\u0915\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 myScheme \u0915\u0947 URL \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u094b \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948\u0902\u0964 myScheme \u0915\u0947 URL ("\u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e/\u0939\u092e/\u0939\u092e\u0947\u0902/\u0939\u092e\u093e\u0930\u093e") \u0915\u094b \u0939\u094b\u0938\u094d\u091f \u092f\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947, \u0906\u092a \u0907\u0928 \u0936\u0930\u094d\u0924\u094b\u0902 \u0938\u0947 \u0938\u0916\u094d\u0924\u0940 \u0938\u0947 \u092c\u0902\u0927\u0947 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u092e\u0924 \u0939\u0948\u0902 \u0914\u0930 \u092f\u0939 \u0915\u093f \u0936\u0930\u094d\u0924\u0947\u0902 \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u0906\u092a\u0915\u0947 \u0938\u0902\u092c\u0902\u0927\u094b\u0902 \u0915\u094b \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948\u0902\u0964 \u0938\u092d\u0940 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u094b \u0927\u094d\u092f\u093e\u0928 \u0938\u0947 \u092a\u0922\u093c\u0947\u0902\u0964 \u092f\u0926\u093f \u0906\u092a \u0907\u0928 \u0936\u0930\u094d\u0924\u094b\u0902 \u0938\u0947 \u0938\u0939\u092e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902, \u0924\u094b \u0915\u0943\u092a\u092f\u093e \u0915\u093f\u0938\u0940 \u092d\u0940 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 myScheme \u0915\u0947 URL \u0915\u094b \u0939\u094b\u0938\u094d\u091f \u092f\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092c\u091a\u0947\u0902\u0964 \u0907\u0928 \u0936\u0930\u094d\u0924\u094b\u0902 \u0938\u0947 \u0915\u094b\u0908 \u0935\u093f\u091a\u0932\u0928 \u092f\u093e \u0926\u0941\u0930\u0941\u092a\u092f\u094b\u0917 \u0907\u0928 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u093e \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u092e\u093e\u0928\u093e \u091c\u093e\u090f\u0917\u093e \u0914\u0930 \u0907\u0938\u0915\u0947 \u092a\u0930\u093f\u0923\u093e\u092e\u0938\u094d\u0935\u0930\u0942\u092a \u0906\u092a\u0915\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 URL \u0915\u094b \u0939\u094b\u0938\u094d\u091f/\u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0924\u0924\u094d\u0915\u093e\u0932 \u0938\u092e\u093e\u092a\u094d\u0924\u093f \u0939\u094b\u0917\u0940\u0964</p><p>\u0906\u092a URL \u0915\u094b \u0939\u094b\u0938\u094d\u091f \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u092f\u0926\u093f (a) \u0906\u092a \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u092c\u093e\u0927\u094d\u092f\u0915\u093e\u0930\u0940 \u0905\u0928\u0941\u092c\u0902\u0927 \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u093e\u0928\u0942\u0928\u0940 \u0909\u092e\u094d\u0930 \u0915\u0947 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902, \u092f\u093e (b) \u0906\u092a \u0915\u093f\u0938\u0940 \u092d\u0940 \u0932\u093e\u0917\u0942 \u0915\u093e\u0928\u0942\u0928 \u0915\u0947 \u0924\u0939\u0924 URL \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u092f\u093e \u0939\u094b\u0938\u094d\u091f\u093f\u0902\u0917 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u093f\u0924 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0939\u0948\u0902\u0964 \u092f\u0926\u093f \u0906\u092a \u0915\u093f\u0938\u0940 \u0907\u0915\u093e\u0908 \u0915\u0940 \u0913\u0930 \u0938\u0947 URL \u0939\u094b\u0938\u094d\u091f \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0924\u094b \u0906\u092a \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f\u0924\u094d\u0935 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0935\u093e\u0930\u0902\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0909\u0938 \u0907\u0915\u093e\u0908 \u0915\u094b \u092c\u093e\u0927\u094d\u092f \u0915\u0930\u0928\u0947 \u0915\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0939\u0948\u0964 \u0936\u0930\u094d\u0924\u094b\u0902 \u0914\u0930 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0915\u0947, \u0906\u092a \u0909\u0938 \u0907\u0915\u093e\u0908 \u0915\u0940 \u0913\u0930 \u0938\u0947 \u0910\u0938\u093e \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902 (\u0914\u0930 \u0936\u0930\u094d\u0924\u094b\u0902 \u092e\u0947\u0902 "\u0906\u092a" \u0915\u0947 \u0938\u092d\u0940 \u0938\u0902\u0926\u0930\u094d\u092d \u0909\u0938 \u0907\u0915\u093e\u0908 \u0915\u094b \u0938\u0902\u0926\u0930\u094d\u092d\u093f\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902)\u0964</p><p>URL \u0915\u094b \u0939\u094b\u0938\u094d\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u094b \u0915\u0941\u091b \u091c\u093e\u0928\u0915\u093e\u0930\u0940 (\u091c\u0948\u0938\u0947 \u092a\u0939\u091a\u093e\u0928 \u092f\u093e \u0938\u