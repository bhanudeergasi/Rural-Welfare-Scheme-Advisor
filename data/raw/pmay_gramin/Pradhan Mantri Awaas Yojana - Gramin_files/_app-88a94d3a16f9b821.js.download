e\u0a9f\u0ac7 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0ab6\u0acb\u0aa7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aae\u0aa6\u0aa6 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7. \u0aa4\u0ac7 \u0ab5\u0abf\u0ab5\u0abf\u0aa7 \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a85\u0ab0\u0a9c\u0ac0 \u0a95\u0ab0\u0ab5\u0ac0 \u0aa4\u0ac7 \u0a85\u0a82\u0a97\u0ac7 \u0aaa\u0aa3 \u0aae\u0abe\u0ab0\u0acd\u0a97\u0aa6\u0ab0\u0acd\u0ab6\u0aa8 \u0a86\u0aaa\u0ac7 \u0a9b\u0ac7. \u0aa4\u0ac7\u0aa5\u0ac0 \u0aac\u0ab9\u0ac1\u0ab5\u0abf\u0aa7 \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f\u0acd\u0ab8\u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0ac7\u0ab5\u0abe\u0aa8\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0 \u0aa8\u0aa5\u0ac0.",vision:"\u0a85\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0ab5\u0abf\u0a9d\u0aa8",visionText:"\u0a85\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0ab5\u0abf\u0a9d\u0aa8 \u0aa8\u0abe\u0a97\u0ab0\u0abf\u0a95\u0acb\u0aa8\u0ac1\u0a82 \u0a9c\u0ac0\u0ab5\u0aa8 \u0ab8\u0ab0\u0ab3 \u0aac\u0aa8\u0abe\u0ab5\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0a9b\u0ac7.",mission:"\u0a85\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0aae\u0abf\u0ab6\u0aa8",mission1:"\u0a85\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0aae\u0abf\u0ab6\u0aa8 \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0a85\u0aa8\u0ac7 \u0ab2\u0abe\u0aad\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0ab0\u0a95\u0abe\u0ab0-\u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe \u0a87\u0aa8\u0acd\u0a9f\u0ab0\u0aab\u0ac7\u0ab8\u0aa8\u0ac7 \u0ab8\u0ac1\u0ab5\u0acd\u0aaf\u0ab5\u0ab8\u0acd\u0aa5\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0a9b\u0ac7.",mission2:"\u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0ab6\u0acb\u0aa7\u0ab5\u0abe \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aa8\u0acb \u0ab2\u0abe\u0aad \u0ab2\u0ac7\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0ab8\u0aae\u0aaf \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aaf\u0aa4\u0acd\u0aa8\u0acb\u0aae\u0abe\u0a82 \u0a98\u0a9f\u0abe\u0aa1\u0acb \u0a95\u0ab0\u0ab5\u0acb.",aboutPageDesc1:"\u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0a87\u0ab2\u0ac7\u0a95\u0acd\u0a9f\u0acd\u0ab0\u0acb\u0aa8\u0abf\u0a95\u0acd\u0ab8 \u0a85\u0aa8\u0ac7 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0a9f\u0ac7\u0a95\u0aa8\u0acb\u0ab2\u0acb\u0a9c\u0ac0 \u0aae\u0a82\u0aa4\u0acd\u0ab0\u0abe\u0ab2\u0aaf (\u0a8f\u0aae. \u0a87. \u0a86\u0a87. \u0a9f\u0ac0. \u0ab5\u0abe\u0aaf.), \u0ab5\u0ab9\u0ac0\u0ab5\u0a9f\u0ac0 \u0ab8\u0ac1\u0aa7\u0abe\u0ab0\u0abe \u0a85\u0aa8\u0ac7 \u0a9c\u0abe\u0ab9\u0ac7\u0ab0 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 \u0ab5\u0abf\u0aad\u0abe\u0a97 (\u0aa1\u0ac0. \u0a8f. \u0a86\u0ab0. \u0aaa\u0ac0. \u0a9c\u0ac0.) \u0a85\u0aa8\u0ac7 \u0a85\u0aa8\u0acd\u0aaf \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0a85\u0aa8\u0ac7 \u0ab0\u0abe\u0a9c\u0acd\u0aaf \u0aae\u0a82\u0aa4\u0acd\u0ab0\u0abe\u0ab2\u0aaf\u0acb/\u0ab5\u0abf\u0aad\u0abe\u0a97\u0acb\u0aa8\u0ac0 \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0ac0 \u0ab8\u0abe\u0aa5\u0ac7 \u0ab0\u0abe\u0ab7\u0acd\u0a9f\u0acd\u0ab0\u0ac0\u0aaf \u0a87-\u0a97\u0ab5\u0ab0\u0acd\u0aa8\u0aa8\u0acd\u0ab8 \u0ab5\u0abf\u0aad\u0abe\u0a97 (\u0a8f\u0aa8. \u0a87. \u0a9c\u0ac0. \u0aa1\u0ac0.) \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab5\u0abf\u0a95\u0ab8\u0abe\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82, \u0ab8\u0a82\u0a9a\u0abe\u0ab2\u0abf\u0aa4 \u0a85\u0aa8\u0ac7 \u0ab8\u0a82\u0a9a\u0abe\u0ab2\u0abf\u0aa4 \u0a9b\u0ac7.",eligibilityCheckHead:"\u0aaa\u0abe\u0aa4\u0acd\u0ab0\u0aa4\u0abe \u0aa4\u0aaa\u0abe\u0ab8\u0acb",eligibilityCheckDesc:"\u0aa4\u0aae\u0ac7 \u0ab5\u0abf\u0ab5\u0abf\u0aa7 \u0aae\u0abe\u0aaa\u0aa6\u0a82\u0aa1 \u0a85\u0aa8\u0ac7 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0ab2\u0a95\u0acd\u0ab7\u0aa3\u0acb\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0abe\u0aa4\u0acd\u0ab0\u0aa4\u0abe \u0a9a\u0a95\u0abe\u0ab8\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb.",schemeFinderHead:"\u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0ab6\u0acb\u0aa7\u0a95",schemeFinderDesc:"\u0ab5\u0abf\u0ab5\u0abf\u0aa7 \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0aab\u0abf\u0ab2\u0acd\u0a9f\u0ab0 \u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0aa1\u0acd\u0ab0\u0abf\u0ab2 \u0aa1\u0abe\u0a89\u0aa8\u0acd\u0ab8 \u0ab8\u0abe\u0aa5\u0ac7 \u0a9d\u0aa1\u0aaa\u0ac0 \u0a85\u0aa8\u0ac7 \u0ab8\u0ab0\u0ab3 \u0ab6\u0acb\u0aa7",schemeInDetailHead:"\u0ab5\u0abf\u0a97\u0aa4\u0ab5\u0abe\u0ab0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe",schemeInDetailDesc:"\u0aa4\u0aae\u0ac7 \u0a85\u0ab0\u0a9c\u0ac0 \u0a95\u0ab0\u0acb \u0aa4\u0ac7 \u0aaa\u0ab9\u0ac7\u0ab2\u0abe\u0a82 \u0ab8\u0ac2\u0a95\u0acd\u0ab7\u0acd\u0aae \u0aa6\u0abe\u0aa3\u0abe\u0aa6\u0abe\u0ab0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0aa8\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0aae\u0ab0\u0acd\u0aaa\u0abf\u0aa4 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0aaa\u0ac3\u0ab7\u0acd\u0aa0\u0acb\u0aae\u0abe\u0a82 \u0a8a\u0a82\u0aa1\u0abe\u0aa3\u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0a95 \u0a9c\u0abe\u0ab5.",documentRequired:"\u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb",faqHead:"\u0ab5\u0abe\u0ab0\u0a82\u0ab5\u0abe\u0ab0 \u0aaa\u0ac2\u0a9b\u0abe\u0aa4\u0abe \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb",faqSubHead1:"\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a95\u0ac7\u0a9f\u0ab2\u0abe\u0a95 \u0a9c\u0ab5\u0abe\u0aac\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0aae\u0abe\u0ab0\u0acb \u0a9c\u0acd\u0a9e\u0abe\u0aa8 \u0a86\u0aa7\u0abe\u0ab0 \u0aa4\u0aaa\u0abe\u0ab8\u0acb!",ques1:"\u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7 \u0a85\u0aa8\u0acd\u0aaf \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2\u0aa5\u0ac0 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a85\u0ab2\u0a97 \u0a9b\u0ac7?",ans1:"\u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0a8f \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0a85\u0aa8\u0ac7 \u0ab0\u0abe\u0a9c\u0acd\u0aaf/\u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0ab6\u0abe\u0ab8\u0abf\u0aa4 \u0aaa\u0acd\u0ab0\u0aa6\u0ac7\u0ab6\u0acb \u0aac\u0a82\u0aa8\u0ac7 \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0acb \u0aaa\u0abe\u0ab8\u0ac7\u0aa5\u0ac0 \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93\u0aa8\u0ac0 \u0ab5\u0abf\u0ab6\u0abe\u0ab3 \u0ab6\u0acd\u0ab0\u0ac7\u0aa3\u0ac0 \u0aae\u0ac7\u0ab3\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7\u0aa8\u0ac1\u0a82 \u0a8f\u0a95 \u0ab0\u0abe\u0ab7\u0acd\u0a9f\u0acd\u0ab0\u0ac0\u0aaf \u0aae\u0a82\u0a9a \u0a9b\u0ac7. \u0aa4\u0ac7 \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 \u0ab5\u0abf\u0ab7\u0aaf\u0a95 \u0ab5\u0abf\u0a97\u0aa4\u0acb\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0ac7 \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93\u0aa8\u0ac0 \u0ab6\u0acb\u0aa7 \u0a85\u0aa8\u0ac7 \u0ab6\u0acb\u0aa7 \u0aae\u0abe\u0a9f\u0ac7 \u0ab5\u0aa8-\u0ab8\u0acd\u0a9f\u0acb\u0aaa \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0a9b\u0ac7. \u0aaa\u0ab0\u0a82\u0aaa\u0ab0\u0abe\u0a97\u0aa4 \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2\u0aa5\u0ac0 \u0ab5\u0abf\u0aaa\u0ab0\u0ac0\u0aa4, \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0ab8\u0ab0\u0a95\u0abe\u0ab0, \u0ab0\u0abe\u0a9c\u0acd\u0aaf \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0ab6\u0abe\u0ab8\u0abf\u0aa4 \u0aaa\u0acd\u0ab0\u0aa6\u0ac7\u0ab6\u0acb\u0aa8\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93\u0aa8\u0ac7 \u0a8f\u0a95 \u0a9c \u0aae\u0a82\u0a9a \u0aaa\u0ab0 \u0ab2\u0abe\u0ab5\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a93\u0aa8\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 \u0ab2\u0abe\u0aaf\u0a95\u0abe\u0aa4\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0ac7 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0ab6\u0acb\u0aa7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aae\u0aa6\u0aa6 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7.",ques2:"\u0aae\u0abe\u0ab0\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0ab8\u0abe\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0aa8\u0abe\u0a97\u0ab0\u0abf\u0a95\u0acb\u0aa8\u0ac7 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0aae\u0aa6\u0aa6 \u0a95\u0ab0\u0ab6\u0ac7?",ans2:"\u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aa8\u0abe\u0a97\u0ab0\u0abf\u0a95\u0acb\u0aa8\u0ac7 \u0a8f\u0a95 \u0a9c \u0a9c\u0a97\u0acd\u0aaf\u0abe\u0a8f \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0ab6\u0acb\u0aa7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0a95\u0acd\u0ab7\u0aae \u0aac\u0aa8\u0abe\u0ab5\u0ac0\u0aa8\u0ac7, \u0aac\u0ab9\u0ac1\u0ab5\u0abf\u0aa7 \u0ab5\u0abf\u0aad\u0abe\u0a97\u0ac0\u0aaf \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f\u0acd\u0ab8\u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0ac7\u0ab5\u0abe\u0aa8\u0ac0 \u0a85\u0aa5\u0ab5\u0abe \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 \u0aaa\u0abe\u0aa4\u0acd\u0ab0\u0aa4\u0abe \u0a9a\u0a95\u0abe\u0ab8\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab5\u0acd\u0aaf\u0abe\u0aaa\u0a95 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0aae\u0abe\u0ab0\u0acd\u0a97\u0aa6\u0ab0\u0acd\u0ab6\u0abf\u0a95\u0abe\u0a93\u0aa8\u0ac0 \u0ab8\u0aae\u0ac0\u0a95\u0acd\u0ab7\u0abe \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0\u0abf\u0aaf\u0abe\u0aa4\u0aa8\u0ac7 \u0aa6\u0ac2\u0ab0 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93\u0aa8\u0ac0 \u0aaa\u0ab9\u0acb\u0a82\u0a9a\u0aa8\u0ac7 \u0ab8\u0ab0\u0ab3 \u0aac\u0aa8\u0abe\u0ab5\u0ac7 \u0a9b\u0ac7.",ques3:"\u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a95\u0abe\u0aae \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7?",ans3:"\u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aa8\u0abe\u0a97\u0ab0\u0abf\u0a95\u0acb\u0aa8\u0ac7 \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0ab6\u0acb\u0aa7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aae\u0aa6\u0aa6 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a8f\u0a95 \u0ab8\u0ab0\u0ab3 \u0a85\u0aa8\u0ac7 \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe-\u0aae\u0ac8\u0aa4\u0acd\u0ab0\u0ac0\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0aa4\u0acd\u0ab0\u0aa3-\u0aaa\u0a97\u0ab2\u0abe\u0a82\u0aa8\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe\u0aa8\u0ac7 \u0a85\u0aa8\u0ac1\u0ab8\u0ab0\u0ac7 \u0a9b\u0ac7, \u0a9c\u0ac7\u0aa8\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0ac7\u0a93 \u0aaa\u0abe\u0aa4\u0acd\u0ab0 \u0a9b\u0ac7\u0a83 \u0aaa\u0a97\u0ab2\u0ac1\u0a82 1: \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 \u0ab5\u0abf\u0ab7\u0aaf\u0a95, \u0a86\u0ab5\u0a95, \u0ab8\u0abe\u0aae\u0abe\u0a9c\u0abf\u0a95 \u0ab6\u0acd\u0ab0\u0ac7\u0aa3\u0ac0 \u0ab5\u0a97\u0ac7\u0ab0\u0ac7 \u0a9c\u0ac7\u0ab5\u0ac0 \u0aae\u0ac2\u0ab3\u0aad\u0ac2\u0aa4 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7. \u0aaa\u0a97\u0ab2\u0ac1\u0a82 2: \u0aaa\u0ac2\u0ab0\u0ac0 \u0aaa\u0abe\u0aa1\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0ac0 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0ac7, \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0ac7\u0a82\u0a95\u0aa1\u0acb \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0aaa\u0acd\u0ab0\u0aa6\u0ab0\u0acd\u0ab6\u0abf\u0aa4 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7. \u0aaa\u0a97\u0ab2\u0ac1\u0a82 3: \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe \u0aaa\u0abe\u0aa4\u0acd\u0ab0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93\u0aa8\u0ac0 \u0ab8\u0ac2\u0a9a\u0abf\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0ab5\u0abf\u0a97\u0aa4\u0ab5\u0abe\u0ab0 \u0a9c\u0acd\u0a9e\u0abe\u0aa8, \u0ab5\u0abe\u0ab0\u0a82\u0ab5\u0abe\u0ab0 \u0aaa\u0ac2\u0a9b\u0abe\u0aa4\u0abe \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb \u0a85\u0aa8\u0ac7 \u0a85\u0ab0\u0a9c\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0ab8\u0abe\u0aa5\u0ac7 \u0ab8\u0aae\u0ab0\u0acd\u0aaa\u0abf\u0aa4 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0aaa\u0ac3\u0ab7\u0acd\u0aa0 \u0aaa\u0ab0\u0aa5\u0ac0 \u0ab5\u0aa7\u0ac1 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0aae\u0ac7\u0ab3\u0ab5\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0a85\u0ab0\u0a9c\u0ac0 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0a8f\u0aaa\u0acd\u0ab2\u0abf\u0a95\u0ac7\u0ab6\u0aa8 \u0aaf\u0ac1\u0a86\u0ab0\u0a8f\u0ab2 \u0aaa\u0ab0 \u0a9c\u0a88 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7",ques4:"\u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aaa\u0ab0 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0a9c\u0abe\u0aa3\u0ab5\u0abe\u0aa8\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?",ans4:"\u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aaa\u0ab0 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0ab6\u0acb\u0aa7\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7, \u0aa8\u0abe\u0a97\u0ab0\u0abf\u0a95\u0acb \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae\u0aa8\u0ac0 \u0ab8\u0aa4\u0acd\u0aa4\u0abe\u0ab5\u0abe\u0ab0 \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f\u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0a88\u0aa8\u0ac7 \u0ab6\u0ab0\u0ac2\u0a86\u0aa4 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. \u0a8f\u0a95\u0ab5\u0abe\u0ab0 \u0ab9\u0acb\u0aae\u0aaa\u0ac7\u0a9c \u0aaa\u0ab0, \u0aa4\u0ac7\u0aae\u0aa8\u0ac7 '\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0ab6\u0acb\u0aa7\u0acb' \u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe \u0aae\u0ab3\u0ab6\u0ac7, \u0a9c\u0ac7 \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a93\u0aa8\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 \u0ab5\u0abf\u0ab7\u0aaf\u0a95 \u0ab5\u0abf\u0a97\u0aa4\u0acb, \u0a9c\u0ac7\u0aae \u0a95\u0ac7 \u0a89\u0a82\u0aae\u0ab0, \u0ab2\u0abf\u0a82\u0a97, \u0a86\u0ab5\u0a95 \u0ab8\u0acd\u0aa4\u0ab0, \u0ab6\u0acd\u0ab0\u0ac7\u0aa3\u0ac0 \u0ab5\u0a97\u0ac7\u0ab0\u0ac7 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0aae\u0a82\u0a9c\u0ac2\u0ab0\u0ac0 \u0a86\u0aaa\u0ac7 \u0a9b\u0ac7. \u0a8f\u0a95\u0ab5\u0abe\u0ab0 \u0a86 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0aa5\u0a88 \u0a9c\u0abe\u0aaf \u0aaa\u0a9b\u0ac0, \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0aa8\u0ac0 \u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0ac7 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93\u0aa8\u0ac0 \u0ab8\u0ac2\u0a9a\u0abf \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ab6\u0ac7.",ques5:"\u0a95\u0acb\u0a88 \u0a9a\u0acb\u0a95\u0acd\u0a95\u0ab8 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0ab5\u0abf\u0ab6\u0ac7 \u0aae\u0aa8\u0ac7 \u0aae\u0abe\u0ab0\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0aaa\u0ab0 \u0a95\u0a88 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0aae\u0ab3\u0ac0 \u0ab6\u0a95\u0ac7?",ans5:"\u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aa6\u0ab0\u0ac7\u0a95 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0ab5\u0abf\u0ab6\u0ac7 \u0ab5\u0acd\u0aaf\u0abe\u0aaa\u0a95 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7, \u0a9c\u0ac7\u0aae\u0abe\u0a82 \u0aaa\u0abe\u0aa4\u0acd\u0ab0\u0aa4\u0abe\u0aa8\u0abe \u0aae\u0abe\u0aaa\u0aa6\u0a82\u0aa1, \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0aa4\u0abe \u0ab2\u0abe\u0aad\u0acb, \u0a85\u0ab0\u0a9c\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0a85\u0aa8\u0ac7 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0aa8\u0acb \u0ab2\u0abe\u0aad \u0ab2\u0ac7\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0ab8\u0abe\u0aae\u0ac7\u0ab2 \u0a9b\u0ac7. \u0aa4\u0ac7\u0aae\u0abe\u0a82 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0ab8\u0abe\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb\u0aa8\u0abe \u0a9c\u0ab5\u0abe\u0aac \u0a86\u0aaa\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0aae\u0ab0\u0acd\u0aaa\u0abf\u0aa4 \u0ab5\u0abe\u0ab0\u0a82\u0ab5\u0abe\u0ab0 \u0aaa\u0ac2\u0a9b\u0abe\u0aa4\u0abe \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb (\u0a8f\u0aab. \u0a8f. \u0a95\u0acd\u0aaf\u0ac1.) \u0ab5\u0abf\u0aad\u0abe\u0a97 \u0aaa\u0aa3 \u0a9b\u0ac7.",ques6:"\u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0ab0 \u0a95\u0a88 \u0ab5\u0acd\u0aaf\u0abe\u0aaa\u0a95 \u0ab6\u0acd\u0ab0\u0ac7\u0aa3\u0ac0\u0a93 \u0ab9\u0ac7\u0aa0\u0ab3 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a9b\u0ac7?",ans6:"\u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aaa\u0ab0 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93\u0aa8\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0abe \u0ab2\u0abe\u0aad\u0acb\u0aa8\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0ac3\u0aa4\u0abf \u0a85\u0aa8\u0ac7 \u0ab2\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0ab2\u0abe\u0aad\u0abe\u0ab0\u0acd\u0aa5\u0ac0\u0a93\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0ac7 \u0ab5\u0acd\u0aaf\u0abe\u0aaa\u0a95 \u0ab0\u0ac0\u0aa4\u0ac7 15 \u0ab6\u0acd\u0ab0\u0ac7\u0aa3\u0ac0\u0a93\u0aae\u0abe\u0a82 \u0ab5\u0ab0\u0acd\u0a97\u0ac0\u0a95\u0ac3\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7. \u0a86 \u0ab6\u0acd\u0ab0\u0ac7\u0aa3\u0ac0\u0a93\u0aae\u0abe\u0a82 \u0a95\u0ac3\u0ab7\u0abf, \u0a97\u0acd\u0ab0\u0abe\u0aae\u0ac0\u0aa3 \u0a85\u0aa8\u0ac7 \u0aaa\u0ab0\u0acd\u0aaf\u0abe\u0ab5\u0ab0\u0aa3; \u0aac\u0ac7\u0a82\u0a95\u0abf\u0a82\u0a97, \u0aa8\u0abe\u0aa3\u0abe\u0a95\u0ac0\u0aaf \u0ab8\u0ac7\u0ab5\u0abe\u0a93 \u0a85\u0aa8\u0ac7 \u0ab5\u0ac0\u0aae\u0abe; \u0ab5\u0acd\u0aaf\u0ab5\u0ab8\u0abe\u0aaf \u0a85\u0aa8\u0ac7 \u0a89\u0aa6\u0acd\u0aaf\u0acb\u0a97\u0ab8\u0abe\u0ab9\u0ab8\u0abf\u0a95\u0aa4\u0abe; \u0ab6\u0abf\u0a95\u0acd\u0ab7\u0aa3 \u0a85\u0aa8\u0ac7 \u0ab6\u0abf\u0a95\u0acd\u0ab7\u0aa3; \u0a86\u0ab0\u0acb\u0a97\u0acd\u0aaf \u0a85\u0aa8\u0ac7 \u0ab8\u0ac1\u0a96\u0abe\u0a95\u0abe\u0ab0\u0ac0; \u0a86\u0ab5\u0abe\u0ab8 \u0a85\u0aa8\u0ac7 \u0a86\u0ab6\u0acd\u0ab0\u0aaf; \u0a9c\u0abe\u0ab9\u0ac7\u0ab0 \u0ab8\u0ab2\u0abe\u0aae\u0aa4\u0ac0, \u0a95\u0abe\u0aaf\u0aa6\u0acb \u0a85\u0aa8\u0ac7 \u0aa8\u0acd\u0aaf\u0abe\u0aaf; \u0ab5\u0abf\u0a9c\u0acd\u0a9e\u0abe\u0aa8, \u0a86\u0a87\u0a9f\u0ac0 \u0a85\u0aa8\u0ac7 \u0ab8\u0a82\u0a9a\u0abe\u0ab0; \u0a95\u0acc\u0ab6\u0ab2\u0acd\u0aaf \u0a85\u0aa8\u0ac7 \u0ab0\u0acb\u0a9c\u0a97\u0abe\u0ab0; \u0ab8\u0abe\u0aae\u0abe\u0a9c\u0abf\u0a95 \u0a95\u0ab2\u0acd\u0aaf\u0abe\u0aa3 \u0a85\u0aa8\u0ac7 \u0ab8\u0ab6\u0a95\u0acd\u0aa4\u0abf\u0a95\u0ab0\u0aa3; \u0ab0\u0aae\u0aa4\u0a97\u0aae\u0aa4 \u0a85\u0aa8\u0ac7 \u0ab8\u0a82\u0ab8\u0acd\u0a95\u0ac3\u0aa4\u0abf; \u0aaa\u0ab0\u0abf\u0ab5\u0ab9\u0aa8 \u0a85\u0aa8\u0ac7 \u0aae\u0abe\u0ab3\u0a96\u0abe\u0a97\u0aa4 \u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe\u0a93; \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0\u0ac0 \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0ab5\u0abe\u0ab8\u0aa8; \u0a89\u0aaa\u0aaf\u0acb\u0a97\u0abf\u0aa4\u0abe \u0a85\u0aa8\u0ac7 \u0ab8\u0acd\u0ab5\u0a9a\u0acd\u0a9b\u0aa4\u0abe; \u0a85\u0aa8\u0ac7 \u0aae\u0ab9\u0abf\u0ab2\u0abe\u0a93 \u0a85\u0aa8\u0ac7 \u0aac\u0abe\u0ab3\u0a95\u0acb\u0aa8\u0acb \u0ab8\u0aae\u0abe\u0ab5\u0ac7\u0ab6 \u0aa5\u0abe\u0aaf \u0a9b\u0ac7.",ques7:"\u0ab6\u0ac1\u0a82 \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aac\u0ab9\u0ac1\u0aad\u0abe\u0ab7\u0ac0 \u0ab8\u0aae\u0ab0\u0acd\u0aa5\u0aa8 \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7?",ans7:"\u0ab9\u0abe, \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0ab9\u0abe\u0ab2\u0aae\u0abe\u0a82 \u0a85\u0a82\u0a97\u0acd\u0ab0\u0ac7\u0a9c\u0ac0 \u0ab8\u0ab9\u0abf\u0aa4 15 \u0aad\u0abe\u0ab7\u0abe\u0a93\u0aae\u0abe\u0a82 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7. \u0ab5\u0aa7\u0abe\u0ab0\u0abe\u0aa8\u0ac0 \u0aad\u0abe\u0ab0\u0aa4\u0ac0\u0aaf \u0aad\u0abe\u0ab7\u0abe\u0a93\u0aa8\u0ac7 \u0a9f\u0ac2\u0a82\u0a95 \u0ab8\u0aae\u0aaf\u0aae\u0abe\u0a82 \u0a9f\u0ac7\u0a95\u0acb \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7.",ques8:"\u0ab6\u0ac1\u0a82 \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0a85\u0aa8\u0ac7 \u0ab0\u0abe\u0a9c\u0acd\u0aaf/\u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0ab6\u0abe\u0ab8\u0abf\u0aa4 \u0aaa\u0acd\u0ab0\u0aa6\u0ac7\u0ab6-\u0ab5\u0abf\u0ab6\u0abf\u0ab7\u0acd\u0a9f \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0aac\u0a82\u0aa8\u0ac7\u0aa8\u0ac1\u0a82 \u0aaa\u0acd\u0ab0\u0aa6\u0ab0\u0acd\u0ab6\u0aa8 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7?",ans8:"\u0ab9\u0abe, \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0ab9\u0abe\u0ab2\u0aae\u0abe\u0a82 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0ab8\u0ab0\u0a95\u0abe\u0ab0 \u0a85\u0aa8\u0ac7 \u0ab0\u0abe\u0a9c\u0acd\u0aaf/\u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0ab6\u0abe\u0ab8\u0abf\u0aa4 \u0aaa\u0acd\u0ab0\u0aa6\u0ac7\u0ab6\u0acb\u0aa8\u0ac0 4,700\u0aa5\u0ac0 \u0ab5\u0aa7\u0ac1 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93\u0aa8\u0ac0 \u0aaa\u0ab9\u0acb\u0a82\u0a9a \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7. \u0ab5\u0aa7\u0abe\u0ab0\u0abe\u0aa8\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0ab8\u0aa4\u0aa4 \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aaa\u0ab0 \u0a9a\u0abe\u0ab2\u0ac1 \u0ab0\u0ab9\u0ac7\u0ab6\u0ac7.",ques9:"\u0aae\u0aa8\u0ac7 \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aaa\u0ab0 \u0a95\u0acb\u0a88 \u0a9a\u0acb\u0a95\u0acd\u0a95\u0ab8 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0aae\u0ab3\u0ac0 \u0aa8 \u0ab9\u0aa4\u0ac0. \u0aae\u0abe\u0ab0\u0ac7 \u0ab6\u0ac1\u0a82 \u0a95\u0ab0\u0ab5\u0ac1\u0a82 \u0a9c\u0acb\u0a88\u0a8f?",ans9:'\u0ab9\u0abe\u0ab2\u0aae\u0abe\u0a82 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0ab8\u0ab0\u0a95\u0abe\u0ab0 \u0a85\u0aa8\u0ac7 \u0ab0\u0abe\u0a9c\u0acd\u0aaf/\u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0ab6\u0abe\u0ab8\u0abf\u0aa4 \u0aaa\u0acd\u0ab0\u0aa6\u0ac7\u0ab6\u0acb\u0aa8\u0ac0 4,700\u0aa5\u0ac0 \u0ab5\u0aa7\u0ac1 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aaa\u0ab0 \u0ab8\u0abe\u0aae\u0ac7\u0ab2 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7. \u0ab5\u0aa7\u0abe\u0ab0\u0abe\u0aa8\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0aa8\u0abf\u0aaf\u0aae\u0abf\u0aa4 \u0aa7\u0acb\u0ab0\u0aa3\u0ac7 \u0a89\u0aae\u0ac7\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0ab0\u0ab9\u0ac0 \u0a9b\u0ac7. \u0aa8\u0abe\u0a97\u0ab0\u0abf\u0a95\u0acb \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aaa\u0ab0 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 "\u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0a95\u0ab0\u0acb" \u0ab5\u0abf\u0aad\u0abe\u0a97 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a97\u0ac1\u0aae \u0aa5\u0aaf\u0ac7\u0ab2 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0ac2\u0a9a\u0aa8\u0acb \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.',ques10:"\u0aae\u0aa8\u0ac7 \u0aae\u0ab0\u0abe\u0aa0\u0ac0 \u0aad\u0abe\u0ab7\u0abe\u0aae\u0abe\u0a82 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93\u0aa8\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u0aae\u0abe\u0a82 \u0a95\u0ac7\u0a9f\u0ab2\u0ac0\u0a95 \u0aad\u0ac2\u0ab2\u0acb \u0a9c\u0acb\u0ab5\u0abe \u0aae\u0ab3\u0ac0. \u0aae\u0abe\u0ab0\u0ac7 \u0ab6\u0ac1\u0a82 \u0a95\u0ab0\u0ab5\u0ac1\u0a82 \u0a9c\u0acb\u0a88\u0a8f?",ans10:"\u0a9c\u0acb \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0aa8\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u0aa8\u0abe \u0aae\u0ab0\u0abe\u0aa0\u0ac0 \u0ab8\u0a82\u0ab8\u0acd\u0a95\u0ab0\u0aa3\u0aae\u0abe\u0a82 \u0a95\u0acb\u0a88 \u0ab5\u0abf\u0ab8\u0a82\u0a97\u0aa4\u0aa4\u0abe \u0a9c\u0acb\u0ab5\u0abe \u0aae\u0ab3\u0ac7, \u0aa4\u0acb \u0aa8\u0abe\u0a97\u0ab0\u0abf\u0a95\u0acb\u0aa8\u0ac7 \u0ab8\u0acd\u0aaa\u0ab7\u0acd\u0a9f\u0aa4\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0a82\u0a97\u0acd\u0ab0\u0ac7\u0a9c\u0ac0 \u0ab8\u0a82\u0ab8\u0acd\u0a95\u0ab0\u0aa3\u0aa8\u0acb \u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad \u0ab2\u0ac7\u0ab5\u0abe\u0aa8\u0ac0 \u0ab8\u0ab2\u0abe\u0ab9 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7. \u0a9c\u0acb \u0ab8\u0aae\u0ab8\u0acd\u0aaf\u0abe \u0a9a\u0abe\u0ab2\u0ac1 \u0ab0\u0ab9\u0ac7, \u0aa4\u0acb \u0ab8\u0acc\u0aa5\u0ac0 \u0ab8\u0a9a\u0acb\u0a9f \u0a85\u0aa8\u0ac7 \u0a85\u0aa6\u0acd\u0aaf\u0aa4\u0aa8 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aae\u0a82\u0aa4\u0acd\u0ab0\u0abe\u0ab2\u0aaf \u0a85\u0aa5\u0ab5\u0abe \u0ab5\u0abf\u0aad\u0abe\u0a97\u0aa8\u0abe \u0ab8\u0aa4\u0acd\u0aa4\u0abe\u0ab5\u0abe\u0ab0 \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2\u0aa8\u0acb \u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad \u0ab2\u0a88 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7. \u0ab5\u0aa7\u0ac1\u0aae\u0abe\u0a82, support-myscheme[at]digitalindia[dot]gov[dot]in \u0aaa\u0ab0 \u0a87\u0aae\u0ac7\u0a87\u0ab2 \u0aae\u0acb\u0a95\u0ab2\u0ac0\u0aa8\u0ac7 \u0ab8\u0aae\u0ab8\u0acd\u0aaf\u0abe\u0aa8\u0ac0 \u0a9c\u0abe\u0aa3 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7.",ques11:"\u0ab9\u0ac1\u0a82 \u0a8f\u0ab5\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0ab6\u0acb\u0aa7\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0ac1 \u0a9b\u0ac1\u0a82 \u0a95\u0ac7 \u0a9c\u0ac7\u0aa8\u0abe \u0ab9\u0ac7\u0aa0\u0ab3 \u0ab5\u0abf\u0aa6\u0acd\u0aaf\u0abe\u0ab0\u0acd\u0aa5\u0ac0\u0a93\u0aa8\u0ac7 \u0ab6\u0abf\u0ab7\u0acd\u0aaf\u0ab5\u0ac3\u0aa4\u0acd\u0aa4\u0abf \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7. \u0ab6\u0ac1\u0a82 \u0a86 \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab6\u0a95\u0acd\u0aaf \u0a9b\u0ac7?",ans11:"\u0ab9\u0abe, \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aae\u0ac1\u0a96\u0acd\u0aaf \u0ab6\u0aac\u0acd\u0aa6 \u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0ab6\u0acb\u0aa7 \u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7 \u0a9c\u0ac7 \u0aa8\u0abe\u0a97\u0ab0\u0abf\u0a95\u0acb\u0aa8\u0ac7 \u0ab5\u0abf\u0aa6\u0acd\u0aaf\u0abe\u0ab0\u0acd\u0aa5\u0ac0\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0ab6\u0abf\u0ab7\u0acd\u0aaf\u0ab5\u0ac3\u0aa4\u0acd\u0aa4\u0abf \u0ab8\u0ab9\u0abf\u0aa4 \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ac7\u0ab2\u0abe \u0ab2\u0abe\u0aad\u0acb\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0 \u0a85\u0aa8\u0ac7 \u0ab9\u0aa6\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0ac7 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93\u0aa8\u0ac7 \u0ab8\u0ab0\u0ab3\u0aa4\u0abe\u0aa5\u0ac0 \u0ab6\u0acb\u0aa7\u0ab5\u0abe, \u0a85\u0aa8\u0acd\u0ab5\u0ac7\u0ab7\u0aa3 \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0aa8\u0ac7 \u0a93\u0ab3\u0a96\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0a95\u0acd\u0ab7\u0aae \u0aac\u0aa8\u0abe\u0ab5\u0ac7 \u0a9b\u0ac7.",ques12:"\u0ab9\u0ac1\u0a82 \u0a8f\u0a95 \u0a9a\u0acb\u0a95\u0acd\u0a95\u0ab8 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab0\u0a9c\u0ac0 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0ac1 \u0a9b\u0ac1\u0a82 \u0a85\u0aa8\u0ac7 \u0a85\u0ab0\u0a9c\u0ac0 \u0aae\u0abe\u0a9f\u0ac7 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a9c\u0abe\u0aa3\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0ac1 \u0a9b\u0ac1\u0a82. \u0ab6\u0ac1\u0a82 \u0ab9\u0ac1\u0a82 \u0a86 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0aae\u0abe\u0ab0\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0aaa\u0ab0 \u0aae\u0ac7\u0ab3\u0ab5\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",ans12:"\u0ab9\u0abe, \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aa6\u0ab0\u0ac7\u0a95 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0aae\u0abe\u0a82 \u0a85\u0ab0\u0a9c\u0ac0 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb\u0aa8\u0ac0 \u0ab8\u0a82\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0ab8\u0ac2\u0a9a\u0abf \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7, \u0a9c\u0ac7\u0aa8\u0abe\u0aa5\u0ac0 \u0aa8\u0abe\u0a97\u0ab0\u0abf\u0a95\u0acb \u0ab8\u0ab0\u0ab3\u0aa4\u0abe\u0aa5\u0ac0 \u0aa4\u0ac8\u0aaf\u0abe\u0ab0\u0ac0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0a85\u0ab0\u0a9c\u0ac0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.",ques13:"\u0ab6\u0ac1\u0a82 \u0ab9\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab0\u0a9c\u0ac0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",ans13:"\u0ab9\u0abe\u0ab2\u0aae\u0abe\u0a82, \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a93\u0aa8\u0ac7 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aae\u0a82\u0aa4\u0acd\u0ab0\u0abe\u0ab2\u0aaf \u0a85\u0aa5\u0ab5\u0abe \u0ab5\u0abf\u0aad\u0abe\u0a97\u0aa8\u0abe \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0a8f\u0aaa\u0acd\u0ab2\u0abf\u0a95\u0ac7\u0ab6\u0aa8 \u0aaa\u0ac3\u0ab7\u0acd\u0aa0 \u0aaa\u0ab0 \u0ab0\u0ac0\u0aa1\u0abe\u0aaf\u0ab0\u0ac7\u0a95\u0acd\u0a9f \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7. \u0a86\u0a97\u0abe\u0aae\u0ac0 \u0aa4\u0aac\u0a95\u0acd\u0a95\u0abe\u0aae\u0abe\u0a82, \u0a8f\u0ab5\u0ac0 \u0a95\u0ab2\u0acd\u0aaa\u0aa8\u0abe \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7 \u0a95\u0ac7 \u0aa8\u0abe\u0a97\u0ab0\u0abf\u0a95\u0acb \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2/\u0a89\u0aae\u0a82\u0a97 \u0a8f\u0aaa\u0acd\u0ab2\u0abf\u0a95\u0ac7\u0ab6\u0aa8 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab0\u0a9c\u0ac0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ab6\u0ac7.",ques14:'\u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0acc\u0aa5\u0ac0 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93\u0aa8\u0ac1\u0a82 \u0a85\u0aa8\u0acd\u0ab5\u0ac7\u0ab7\u0aa3 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7, \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae\u0aa8\u0ac0 "\u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0ab6\u0acb\u0aa7" \u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe\u0aae\u0abe\u0a82 \u0a95\u0a88 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0 \u0a9b\u0ac7?',ans14:'\u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae\u0aa8\u0ac0 "\u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0ab6\u0acb\u0aa7" \u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7, \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a93\u0a8f \u0ab2\u0abf\u0a82\u0a97, \u0a89\u0a82\u0aae\u0ab0, \u0ab5\u0ac8\u0ab5\u0abe\u0ab9\u0abf\u0a95 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf, \u0ab0\u0abe\u0a9c\u0acd\u0aaf, \u0ab0\u0ab9\u0ac7\u0aa0\u0abe\u0aa3\u0aa8\u0ac1\u0a82 \u0ab8\u0acd\u0aa5\u0ab3 (\u0ab6\u0ab9\u0ac7\u0ab0\u0ac0 \u0a85\u0aa5\u0ab5\u0abe \u0a97\u0acd\u0ab0\u0abe\u0aae\u0ac0\u0aa3), \u0ab8\u0abe\u0aae\u0abe\u0a9c\u0abf\u0a95 \u0ab6\u0acd\u0ab0\u0ac7\u0aa3\u0ac0, \u0a85\u0aaa\u0a82\u0a97\u0aa4\u0abe \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf, \u0ab2\u0a98\u0ac1\u0aae\u0aa4\u0ac0 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf, \u0ab0\u0acb\u0a9c\u0a97\u0abe\u0ab0 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf \u0a85\u0aa8\u0ac7 \u0a85\u0aa8\u0acd\u0aaf \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0a9c\u0ac7\u0ab5\u0ac0 \u0aae\u0ac2\u0ab3\u0aad\u0ac2\u0aa4 \u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ab5\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0a9b\u0ac7. \u0a86 \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0aa8\u0ac0 \u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2 \u0ab8\u0abe\u0aa5\u0ac7 \u0ab8\u0acc\u0aa5\u0ac0 \u0ab5\u0aa7\u0ac1 \u0ab8\u0ac1\u0ab8\u0a82\u0a97\u0aa4 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93\u0aa8\u0ac7 \u0a93\u0ab3\u0a96\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aae\u0aa6\u0aa6 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7.',ques15:'"\u0aaa\u0abe\u0aa4\u0acd\u0ab0\u0aa4\u0abe \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0abe\u0ab5\u0ab2\u0ac0 \u0aa4\u0aaa\u0abe\u0ab8\u0acb" \u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?',ans15:'"\u0aaa\u0abe\u0aa4\u0acd\u0ab0\u0aa4\u0abe \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0abe\u0ab5\u0ab2\u0ac0 \u0aa4\u0aaa\u0abe\u0ab8\u0acb" \u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe \u0aaf\u0acb\u0a9c\u0aa8\u0abe-\u0ab5\u0abf\u0ab6\u0abf\u0ab7\u0acd\u0a9f \u0aaa\u0abe\u0aa4\u0acd\u0ab0\u0aa4\u0abe \u0aae\u0abe\u0aaa\u0aa6\u0a82\u0aa1 \u0aaa\u0ab0 \u0aa7\u0acd\u0aaf\u0abe\u0aa8 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0abf\u0aa4 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a93\u0aa8\u0ac7 \u0ab8\u0ab0\u0ab3 \u0ab9\u0abe/\u0aa8\u0abe-\u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0abe\u0ab5\u0ab2\u0ac0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 \u0ab2\u0abe\u0aaf\u0a95\u0abe\u0aa4 \u0a9a\u0a95\u0abe\u0ab8\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0a95\u0acd\u0ab7\u0aae \u0aac\u0aa8\u0abe\u0ab5\u0ac7 \u0a9b\u0ac7. \u0aaa\u0ac2\u0ab0\u0ac0 \u0aaa\u0abe\u0aa1\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2 \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6\u0acb\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0ac7, \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a93 \u0a9d\u0aa1\u0aaa\u0aa5\u0ac0 \u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7 \u0a95\u0ac7 \u0aa4\u0ac7\u0a93 \u0a95\u0acb\u0a88 \u0a9a\u0acb\u0a95\u0acd\u0a95\u0ab8 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aaa\u0abe\u0aa4\u0acd\u0ab0 \u0a9b\u0ac7 \u0a95\u0ac7 \u0a95\u0ac7\u0aae.',ques16:"\u0ab6\u0ac1\u0a82 \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0abe\u0ab8\u0ac7 \u0a9a\u0ac7\u0a9f\u0aac\u0acb\u0a9f \u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe \u0a9b\u0ac7, \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7 \u0aa8\u0abe\u0a97\u0ab0\u0abf\u0a95\u0acb\u0aa8\u0ac7 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0aae\u0aa6\u0aa6 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7?",ans16:"\u0ab9\u0abe, \u0aae\u0abe\u0aaf\u0ab6\u0ac0\u0aae\u0ac7 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0ab6\u0acb\u0aa7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa8\u0abe\u0a97\u0ab0\u0abf\u0a95\u0acb\u0aa8\u0ac7 \u0aae\u0aa6\u0aa6 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab5\u0abe\u0a9c-\u0ab8\u0a95\u0acd\u0ab7\u0aae, \u0aac\u0ab9\u0ac1\u0aad\u0abe\u0ab7\u0ac0 AI-\u0ab8\u0a82\u0a9a\u0abe\u0ab2\u0abf\u0aa4 \u0a9a\u0ac7\u0a9f\u0aac\u0acb\u0a9f \u0aa4\u0ac8\u0aa8\u0abe\u0aa4 \u0a95\u0ab0\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7. \u0a9a\u0ac7\u0a9f\u0aac\u0acb\u0a9f \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb\u0aa8\u0abe \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0a85\u0aa8\u0ac7 \u0aa4\u0abe\u0aa4\u0acd\u0a95\u0abe\u0ab2\u0abf\u0a95 \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6 \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7, \u0ab5\u0abe\u0aa4\u0a9a\u0ac0\u0aa4 \u0ab8\u0ab9\u0abe\u0aaf \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0aa8\u0ac0 \u0ab6\u0acb\u0aa7\u0aa8\u0ac7 \u0ab8\u0ab0\u0ab3 \u0aac\u0aa8\u0abe\u0ab5\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0a86\u0a95\u0ab0\u0acd\u0ab7\u0a95 \u0a85\u0aa8\u0ac7 \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe-\u0aae\u0ac8\u0aa4\u0acd\u0ab0\u0ac0\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0a85\u0aa8\u0ac1\u0aad\u0ab5 \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab8\u0ab0\u0a95\u0abe\u0ab0-\u0aa8\u0abe\u0a97\u0ab0\u0abf\u0a95\u0acb\u0aa8\u0ac0 \u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe\u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe\u0aa8\u0ac7 \u0ab5\u0aa7\u0abe\u0ab0\u0ac7 \u0a9b\u0ac7.",ques17:"\u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0ab0 AI \u0a9a\u0ac7\u0a9f\u0aac\u0acb\u0a9f\u0aa8\u0ac0 \u0aae\u0ac1\u0a96\u0acd\u0aaf \u0ab2\u0abe\u0a95\u0acd\u0ab7\u0aa3\u0abf\u0a95\u0aa4\u0abe\u0a93 \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?",ans17:"\u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae AI \u0a9a\u0ac7\u0a9f\u0aac\u0acb\u0a9f \u0a85\u0ab5\u0abe\u0a9c \u0a85\u0aa8\u0ac7 \u0ab2\u0a96\u0abe\u0aa3 \u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe\u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe\u0a93, \u0ab9\u0abf\u0aa8\u0acd\u0aa6\u0ac0 \u0a85\u0aa8\u0ac7 \u0a85\u0a82\u0a97\u0acd\u0ab0\u0ac7\u0a9c\u0ac0\u0aae\u0abe\u0a82 \u0aa6\u0acd\u0ab5\u0abf\u0aad\u0abe\u0ab7\u0ac0 \u0ab8\u0aae\u0ab0\u0acd\u0aa5\u0aa8, \u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad-\u0a9c\u0abe\u0a97\u0ac3\u0aa4 \u0ab5\u0abe\u0aa4\u0a9a\u0ac0\u0aa4, \u0ab8\u0aa4\u0acd\u0ab0-\u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0a9a\u0ac7\u0a9f \u0a87\u0aa4\u0abf\u0ab9\u0abe\u0ab8 \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe\u0a93\u0aa8\u0ac0 \u0aa8\u0a95\u0ab2 \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0aa8\u0ac7 \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0abe \u0ab5\u0abf\u0a95\u0ab2\u0acd\u0aaa\u0acb \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7, \u0a9c\u0ac7 \u0a8f\u0a95 \u0a85\u0ab5\u0abf\u0ab0\u0aa4 \u0a85\u0aa8\u0ac7 \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe-\u0aae\u0ac8\u0aa4\u0acd\u0ab0\u0ac0\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0a85\u0aa8\u0ac1\u0aad\u0ab5 \u0ab8\u0ac1\u0aa8\u0abf\u0ab6\u0acd\u0a9a\u0abf\u0aa4 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7.",ques18:"\u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93\u0aa8\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0 \u0a85\u0a82\u0a97\u0ac7 \u0ab9\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0acb \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a86\u0aaa\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",ans18:'\u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aa6\u0ab0\u0ac7\u0a95 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0aaa\u0ac3\u0ab7\u0acd\u0aa0\u0aa8\u0abe \u0aa4\u0ab3\u0abf\u0aaf\u0ac7 "\u0ab6\u0ac1\u0a82 \u0a86 \u0aae\u0aa6\u0aa6\u0ab0\u0ac2\u0aaa \u0ab9\u0aa4\u0ac1\u0a82?" \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6 \u0ab5\u0abf\u0aad\u0abe\u0a97 \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7, \u0a9c\u0ac7 \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a93\u0aa8\u0ac7 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u0aa8\u0ac7 1 \u0aa5\u0ac0 5 \u0aa4\u0abe\u0ab0\u0abe\u0a93 \u0ab8\u0ac1\u0aa7\u0ac0 \u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0abe \u0a85\u0aa8\u0ac1\u0aad\u0ab5\u0acb, \u0ab8\u0ac2\u0a9a\u0aa8\u0acb \u0a85\u0aa5\u0ab5\u0abe \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6 \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0aae\u0a82\u0a9c\u0ac2\u0ab0\u0ac0 \u0a86\u0aaa\u0ac7 \u0a9b\u0ac7. \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a93 support-myscheme@digitalindia.gov.in \u0aaa\u0ab0 \u0a87\u0aae\u0ac7\u0a87\u0ab2 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab5\u0abf\u0a97\u0aa4\u0ab5\u0abe\u0ab0 \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6 \u0aaa\u0aa3 \u0aae\u0acb\u0a95\u0ab2\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7, \u0a9c\u0ac7 \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae\u0aae\u0abe\u0a82 \u0ab8\u0aa4\u0aa4 \u0ab8\u0ac1\u0aa7\u0abe\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0aad\u0abe\u0ab5 \u0ab8\u0ac1\u0aa8\u0abf\u0ab6\u0acd\u0a9a\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aae\u0aa6\u0aa6 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7.',ques19:"\u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0ab8\u0abe\u0a87\u0aa8 \u0a85\u0aaa \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa5\u0ab5\u0abe \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0ab0 \u0ab8\u0abe\u0a87\u0aa8 \u0a87\u0aa8 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7?",ans19:"\u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aae\u0ac7\u0ab0\u0ac0\u0aaa\u0ac7\u0ab9\u0a9a\u0abe\u0aa8 (\u0aa8\u0ac7\u0ab6\u0aa8\u0ab2 \u0ab8\u0abf\u0a82\u0a97\u0ab2 \u0ab8\u0abe\u0a87\u0aa8-\u0a93\u0aa8) \u0ab8\u0abe\u0aa5\u0ac7 \u0ab8\u0a82\u0a95\u0ab2\u0abf\u0aa4 \u0a9b\u0ac7, \u0a9c\u0ac7 \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a93\u0aa8\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 \u0aae\u0ac7\u0ab0\u0ac0\u0aaa\u0ac7\u0ab9\u0a9a\u0abe\u0aa8 \u0a93\u0ab3\u0a96\u0aaa\u0aa4\u0acd\u0ab0\u0acb\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab8\u0abe\u0a87\u0aa8 \u0a85\u0aaa \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0abe\u0a87\u0aa8 \u0a87\u0aa8 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0a95\u0acd\u0ab7\u0aae \u0aac\u0aa8\u0abe\u0ab5\u0ac7 \u0a9b\u0ac7. \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a93 \u0ab8\u0abe\u0a87\u0aa8 \u0a87\u0aa8 \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0ab5\u0abf\u0aa8\u0abe \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0aac\u0acd\u0ab0\u0abe\u0a89\u0a9d \u0a95\u0ab0\u0ac0 \u0a85\u0aa8\u0ac7 \u0ab6\u0acb\u0aa7\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. \u0a9c\u0acb \u0a95\u0ac7, \u0ab8\u0abe\u0a87\u0aa8 \u0a87\u0aa8 \u0a95\u0ab0\u0ab5\u0abe\u0aa5\u0ac0 \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a93 \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 \u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2, \u0aac\u0ac1\u0a95\u0aae\u0abe\u0ab0\u0acd\u0a95 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0ab8\u0abe\u0a9a\u0ab5\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 \u0ab8\u0abe\u0a9a\u0ab5\u0ac7\u0ab2 \u0ab5\u0abf\u0a97\u0aa4\u0acb\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0ac7 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0aad\u0ab2\u0abe\u0aae\u0aa3\u0acb \u0aaa\u0acd\u0ab0\u0abe\u0aaa\u0acd\u0aa4 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.",ques20:"\u0ab9\u0ac1\u0a82 \u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aaa\u0ab0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0ab6\u0acb\u0aa7\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",ans20:"\u0aae\u0abe\u0aaf \u0ab8\u0acd\u0a95\u0ac0\u0aae \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0ab6\u0acb\u0aa7\u0ab5\u0abe \u0a85\u0aa8\u0ac7 \u0ab6\u0acb\u0aa7\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aac\u0ab9\u0ac1\u0ab5\u0abf\u0aa7 \u0ab0\u0ac0\u0aa4\u0acb \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7, \u0a9c\u0ac7\u0aae\u0abe\u0a82 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0aa8\u0abe \u0aa8\u0abe\u0aae \u0a85\u0aa5\u0ab5\u0abe \u0aae\u0ac1\u0a96\u0acd\u0aaf \u0ab6\u0aac\u0acd\u0aa6\u0acb \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab6\u0acb\u0aa7, \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0aad\u0ab2\u0abe\u0aae\u0aa3\u0acb, \u0ab0\u0abe\u0a9c\u0acd\u0aaf/\u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0ab6\u0abe\u0ab8\u0abf\u0aa4 \u0aaa\u0acd\u0ab0\u0aa6\u0ac7\u0ab6\u0acb \u0a85\u0aa5\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0aa8\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe\u0a93 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aab\u0abf\u0ab2\u0acd\u0a9f\u0ab0\u0abf\u0a82\u0a97, \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0ab2\u0abe\u0aad \u0ab5\u0ab0\u0acd\u0a97\u0acb \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aac\u0acd\u0ab0\u0abe\u0a89\u0a9d\u0abf\u0a82\u0a97 \u0a85\u0aa8\u0ac7 \u0aae\u0abe\u0ab0\u0acd\u0a97\u0aa6\u0ab0\u0acd\u0ab6\u0abf\u0aa4 \u0ab8\u0ab9\u0abe\u0aaf \u0aae\u0abe\u0a9f\u0ac7 AI-\u0ab8\u0a82\u0a9a\u0abe\u0ab2\u0abf\u0aa4 \u0a9a\u0ac7\u0a9f\u0aac\u0acb\u0a9f\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0ab8\u0abe\u0aae\u0ac7\u0ab2 \u0a9b\u0ac7.",viewMore:"\u0ab5\u0aa7\u0ac1 \u0a9c\u0ac1\u0a93",yourNameLabel:"\u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0aa8\u0abe\u0aae"},