u0aa4\u0aae\u0ac7 30 \u0aa6\u0abf\u0ab5\u0ab8 \u0aaa\u0a9b\u0ac0 \u0a8f\u0a9f\u0ab2\u0ac7 \u0a95\u0ac7 \u0aaa\u0a9b\u0ac0 \u0a9c \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0a85\u0ab0\u0a9c\u0ac0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb.",noStatusFound:"\u0a95\u0acb\u0a88 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf \u0aae\u0ab3\u0ac0 \u0aa8\u0aa5\u0ac0",invalidTrackingId:"\u0a85\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0a9f\u0acd\u0ab0\u0ac7\u0a95\u0abf\u0a82\u0a97 \u0a86\u0a88\u0aa1\u0ac0",noStatusFoundJanSamarth:"\u0a8f\u0ab5\u0ac1\u0a82 \u0ab2\u0abe\u0a97\u0ac7 \u0a9b\u0ac7 \u0a95\u0ac7 \u0a9c\u0aa8 \u0ab8\u0aae\u0ab0\u0acd\u0aa5 \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2 \u0aaa\u0ab0 \u0ab9\u0a9c\u0ac1 \u0ab8\u0ac1\u0aa7\u0ac0 \u0a85\u0ab0\u0a9c\u0ac0 \u0ab6\u0ab0\u0ac2 \u0aa5\u0a88 \u0aa8\u0aa5\u0ac0.",noStatusFoundJanSamarthDesc:"\u0aae\u0ab9\u0ac7\u0ab0\u0aac\u0abe\u0aa8\u0ac0 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aae\u0abe\u0ab0\u0ac0 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0aaa\u0ab0 \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0a85\u0ab0\u0a9c\u0ac0 \u0a95\u0ab0\u0acb",userConsentJanSamarth:"\u0aa4\u0aae\u0abe\u0ab0\u0acb \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0a9c\u0aa8 \u0ab8\u0aae\u0ab0\u0acd\u0aa5 \u0ab8\u0abe\u0aa5\u0ac7 \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7 \u0a85\u0aa8\u0ac7 \u0aa4\u0aae\u0aa8\u0ac7 \u0aac\u0abe\u0ab9\u0acd\u0aaf \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f \u0aaa\u0ab0 \u0ab0\u0ac0\u0aa1\u0abe\u0aaf\u0ab0\u0ac7\u0a95\u0acd\u0a9f \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7.",userConsent:"\u0aa4\u0aae\u0aa8\u0ac7 \u0aac\u0abe\u0ab9\u0acd\u0aaf \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f \u0aaa\u0ab0 \u0ab0\u0ac0\u0aa1\u0abe\u0aaf\u0ab0\u0ac7\u0a95\u0acd\u0a9f \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0abe \u0a9b\u0ac7. \u0a86\u0a97\u0ab3 \u0a9c\u0aa4\u0abe\u0a82, \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0ab8\u0a82\u0a