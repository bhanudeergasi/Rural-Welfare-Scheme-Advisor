8\u0ab9\u0abe\u0aaf \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0aa8\u0acb \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0a95\u0ab0\u0acb. \u0aad\u0abe\u0ab7\u0abe\u0aa8\u0abe \u0ab8\u0acd\u0aa4\u0acd\u0ab0\u0acb\u0aa4/\u0aae\u0ac2\u0ab3 \u0ab8\u0acd\u0ab5\u0ab0\u0ac2\u0aaa \u0aa4\u0ab0\u0ac0\u0a95\u0ac7 \u0a85\u0a82\u0a97\u0acd\u0ab0\u0ac7\u0a9c\u0ac0 \u0ab8\u0a82\u0ab8\u0acd\u0a95\u0ab0\u0aa3 \u0a95\u0abe\u0aae \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7.",dashboard:"\u0aa1\u0ac7\u0ab6\u0aac\u0acb\u0ab0\u0acd\u0aa1","Dairy Farmer":"\u0aa1\u0ac7\u0ab0\u0ac0 \u0a96\u0ac7\u0aa1\u0ac2\u0aa4","Agriculture Labour":"\u0a95\u0ac3\u0ab7\u0abf \u0ab6\u0acd\u0ab0\u0aae",applicationReturned:"\u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0a85\u0ab0\u0a9c\u0ac0 \u0aaa\u0ab0\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7. \u0aa4\u0aae\u0ac7 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aaa\u0ac3\u0ab7\u0acd\u0aa0 \u0aaa\u0ab0\u0aa5\u0ac0 \u0a9f\u0abf\u0aaa\u0acd\u0aaa\u0aa3\u0ac0\u0aa8\u0ac0 \u0ab8\u0aae\u0ac0\u0a95\u0acd\u0ab7\u0abe \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb \u0a85\u0aa8\u0ac7 \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0a85\u0ab0\u0a9c\u0ac0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb.",applicationRejected:"\u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0a85\u0ab0\u0a9c\u0ac0 \u0aa8\u0a95\u0abe\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7. \u0aa4\u0aae\u0ac7 \u0aaf\u0acb\u0a9c\u0aa8\u0abe \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aaa\u0ac3\u0ab7\u0acd\u0aa0 \u0aaa\u0ab0\u0aa5\u0ac0 \u0a9f\u0abf\u0aaa\u0acd\u0aaa\u0aa3\u0ac0\u0aa8\u0ac0 \u0ab8\u0aae\u0ac0\u0a95\u0acd\u0ab7\u0abe \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb \u0a85\u0aa8\u0ac7 \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0a85\u0ab0\u0a9c\u0ac0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb.",retryRejectedApplication:"\u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0a85\u0ab0\u0a9c\u0ac0 \u0aa8\u0a95\u0abe\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7. \u0aa4\u0aae\u