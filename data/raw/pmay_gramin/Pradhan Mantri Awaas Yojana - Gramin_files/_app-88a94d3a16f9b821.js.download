d\u0c15\u0c40\u0c2e\u0c4d\u0c32\u0c28\u0c41 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f</strong>!</span>",hiwStep3Head:"\u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f & \u0c35\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",hiwStep3:"<span><strong>\u0c09\u0c24\u0c4d\u0c24\u0c2e\u0c02\u0c17\u0c3e \u0c38\u0c30\u0c3f\u0c2a\u0c4b\u0c2f\u0c47 \u0c2a\u0c25\u0c15\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c41\u0c28\u0c3f \u0c35\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f</strong></span>",aboutSubHead:"\u0c2e\u0c40 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c25\u0c15\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c2a\u0c4a\u0c02\u0c26\u0c02\u0c21\u0c3f!",aboutHead:"\u0c17\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c3f",aboutDesc1:"\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c05\u0c28\u0c47\u0c26\u0c3f \u0c12\u0c15 \u0c1c\u0c3e\u0c24\u0c40\u0c2f \u0c35\u0c47\u0c26\u0c3f\u0c15, \u0c07\u0c26\u0c3f \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c25\u0c15\u0c3e\u0c32 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c12\u0c15-\u0c38\u0c4d\u0c1f\u0c3e\u0c2a\u0c4d \u0c36\u0c4b\u0c27\u0c28 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c06\u0c35\u0c3f\u0c37\u0c4d\u0c15\u0c30\u0c23\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c3f \u0c32\u0c15\u0c4d\u0c37\u0c4d\u0c2f\u0c02\u0c17\u0c3e \u0c2a\u0c46\u0c1f\u0c4d\u0c1f\u0c41\u0c15\u0c41\u0c02\u0c26\u0c3f.",aboutDesc2:"\u0c07\u0c26\u0c3f \u0c2a\u0c4c\u0c30\u0c41\u0c32 \u0c05\u0c30\u0c4d\u0c39\u0c24 \u0c06\u0c27\u0c3e\u0c30\u0c02\u0c17\u0c3e \u0c2a\u0c25\u0c15\u0c02 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c3f\u0c28\u0c42\u0c24\u0c4d\u0c28\u0c2e\u0c48\u0c28, \u0c38\u0c3e\u0c02\u0c15\u0c47\u0c24\u0c3f\u0c15 \u0c06\u0c27\u0c3e\u0c30\u0c3f\u0c24 \u0c2a\u0c30\u0c3f\u0c37\u0c4d\u0c15\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.",aboutDesc3:"\u0c08 \u0c35\u0c47\u0c26\u0c3f\u0c15 \u0c2a\u0c4c\u0c30\u0c41\u0c32\u0c41 \u0c35\u0c3e\u0c30\u0c3f \u0c15\u0c4b\u0c38\u0c02 \u0c38\u0c30\u0c48\u0c28 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c39\u0c3e\u0c2f\u0c2a\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c35\u0c3f\u0c35\u0c3f\u0c27 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c15\u0c41 \u0c0e\u0c32\u0c3e \u0c26\u0c30\u0c16\u0c3e\u0c38\u0c4d\u0c24\u0c41 \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c4b \u0c15\u0c42\u0c21\u0c3e \u0c07\u0c26\u0c3f \u0c2e\u0c3e\u0c30\u0c4d\u0c17\u0c28\u0c3f\u0c30\u0c4d\u0c26\u0c47\u0c36\u0c02 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c05\u0c02\u0c26\u0c41\u0c35\u0c32\u0c4d\u0c32 \u0c2c\u0c39\u0c41\u0c33 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c35\u0c46\u0c2c\u0c4d\u0c38\u0c48\u0c1f\u0c4d\u0c32\u0c28\u0c41 \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c4d\u0c38\u0c3f\u0c28 \u0c05\u0c35\u0c38\u0c30\u0c02 \u0c32\u0c47\u0c26\u0c41.",vision:"\u0c2e\u0c28 \u0c26\u0c3e\u0c30\u0c4d\u0c36\u0c28\u0c3f\u0c15\u0c24",visionText:"\u0c2a\u0c4c\u0c30\u0c41\u0c32 \u0c1c\u0c40\u0c35\u0c3f\u0c24\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c41\u0c32\u0c2d\u0c24\u0c30\u0c02 \u0c1a\u0c47\u0c2f\u0c21\u0c2e\u0c47 \u0c2e\u0c3e \u0c32\u0c15\u0c4d\u0c37\u0c4d\u0c2f\u0c02.",mission:"\u0c2e\u0c3e \u0c2e\u0c3f\u0c37\u0c28\u0c4d",mission1:"\u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c4d\u0c30\u0c2f\u0c4b\u0c1c\u0c28\u0c3e\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35-\u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c07\u0c02\u0c1f\u0c30\u0c4d\u0c2b\u0c47\u0c38\u0c4d\u0c28\u0c41 \u0c15\u0c4d\u0c30\u0c2e\u0c2c\u0c26\u0c4d\u0c27\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c2e\u0c3e \u0c32\u0c15\u0c4d\u0c37\u0c4d\u0c2f\u0c02.",mission2:"\u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c25\u0c15\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c1f\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c35\u0c38\u0c30\u0c2e\u0c48\u0c28 \u0c38\u0c2e\u0c2f\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c15\u0c43\u0c37\u0c3f\u0c28\u0c3f \u0c24\u0c17\u0c4d\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",aboutPageDesc1:"\u0c0e\u0c32\u0c15\u0c4d\u0c1f\u0c4d\u0c30\u0c3e\u0c28\u0c3f\u0c15\u0c4d\u0c38\u0c4d \u0c05\u0c02\u0c21\u0c4d \u0c07\u0c28\u0c4d\u0c2b\u0c30\u0c4d\u0c2e\u0c47\u0c37\u0c28\u0c4d \u0c1f\u0c46\u0c15\u0c4d\u0c28\u0c3e\u0c32\u0c1c\u0c40 \u0c2e\u0c02\u0c24\u0c4d\u0c30\u0c3f\u0c24\u0c4d\u0c35 \u0c36\u0c3e\u0c16 (\u0c0e\u0c02\u0c08\u0c10\u0c1f\u0c40\u0c35\u0c48), \u0c05\u0c21\u0c4d\u0c2e\u0c3f\u0c28\u0c3f\u0c38\u0c4d\u0c1f\u0c4d\u0c30\u0c47\u0c1f\u0c3f\u0c35\u0c4d \u0c30\u0c3f\u0c2b\u0c3e\u0c30\u0c4d\u0c2e\u0c4d\u0c38\u0c4d \u0c05\u0c02\u0c21\u0c4d \u0c2a\u0c2c\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c17\u0c4d\u0c30\u0c40\u0c35\u0c46\u0c28\u0c4d\u0c38\u0c4d \u0c35\u0c3f\u0c2d\u0c3e\u0c17\u0c02 (\u0c21\u0c3f\u0c0e\u0c06\u0c30\u0c4d\u0c2a\u0c3f\u0c1c\u0c3f) \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41\u0c24\u0c4b \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c07\u0c24\u0c30 \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c30\u0c3e\u0c37\u0c4d\u0c1f\u0c4d\u0c30 \u0c2e\u0c02\u0c24\u0c4d\u0c30\u0c3f\u0c24\u0c4d\u0c35 \u0c36\u0c3e\u0c16\u0c32\u0c41/\u0c35\u0c3f\u0c2d\u0c3e\u0c17\u0c3e\u0c32 \u0c2d\u0c3e\u0c17\u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c4d\u0c2f\u0c02\u0c24\u0c4b \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c2e\u0c4d\u0c28\u0c41 \u0c28\u0c47\u0c37\u0c28\u0c32\u0c4d \u0c07-\u0c17\u0c35\u0c30\u0c4d\u0c28\u0c46\u0c28\u0c4d\u0c38\u0c4d \u0c21\u0c3f\u0c35\u0c3f\u0c1c\u0c28\u0c4d (\u0c0e\u0c28\u0c4d\u0c08\u0c1c\u0c3f\u0c21\u0c3f) \u0c05\u0c2d\u0c3f\u0c35\u0c43\u0c26\u0c4d\u0c27\u0c3f \u0c1a\u0c47\u0c38\u0c3f\u0c02\u0c26\u0c3f, \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c3f\u0c02\u0c26\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c38\u0c4d\u0c24\u0c4b\u0c02\u0c26\u0c3f.",eligibilityCheckHead:"\u0c05\u0c30\u0c4d\u0c39\u0c24 \u0c24\u0c28\u0c3f\u0c16\u0c40",eligibilityCheckDesc:"\u0c2e\u0c40\u0c30\u0c41 \u0c35\u0c3f\u0c35\u0c3f\u0c27 \u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24 \u0c32\u0c15\u0c4d\u0c37\u0c23\u0c3e\u0c32\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3f \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c15\u0c41 \u0c2e\u0c40 \u0c05\u0c30\u0c4d\u0c39\u0c24\u0c28\u0c41 \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",schemeFinderHead:"\u0c2a\u0c25\u0c15\u0c02 \u0c2b\u0c48\u0c02\u0c21\u0c30\u0c4d",schemeFinderDesc:"\u0c35\u0c3f\u0c35\u0c3f\u0c27 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c25\u0c15\u0c3e\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c35\u0c21\u0c2a\u0c4b\u0c24 \u0c06\u0c27\u0c3e\u0c30\u0c3f\u0c24 \u0c21\u0c4d\u0c30\u0c3f\u0c32\u0c4d \u0c21\u0c4c\u0c28\u0c4d\u0c32\u0c24\u0c4b \u0c35\u0c47\u0c17\u0c35\u0c02\u0c24\u0c2e\u0c48\u0c28 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c41\u0c32\u0c2d\u0c2e\u0c48\u0c28 \u0c36\u0c4b\u0c27\u0c28",schemeInDetailHead:"\u0c35\u0c3f\u0c35\u0c30\u0c02\u0c17\u0c3e \u0c2a\u0c25\u0c15\u0c02",schemeInDetailDesc:"\u0c2e\u0c40\u0c30\u0c41 \u0c26\u0c30\u0c16\u0c3e\u0c38\u0c4d\u0c24\u0c41 \u0c1a\u0c47\u0c38\u0c47 \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c2b\u0c48\u0c28\u0c4d \u0c17\u0c4d\u0c30\u0c48\u0c28\u0c4d\u0c21\u0c4d \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c47\u0c15 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c47\u0c1c\u0c40\u0c32\u0c28\u0c41 \u0c32\u0c4b\u0c24\u0c41\u0c17\u0c3e \u0c2a\u0c30\u0c3f\u0c36\u0c40\u0c32\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",documentRequired:"\u0c05\u0c35\u0c38\u0c30\u0c2e\u0c48\u0c28 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c41",faqHead:"\u0c24\u0c30\u0c1a\u0c41\u0c17\u0c3e \u0c05\u0c21\u0c3f\u0c17\u0c47 \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32\u0c41",faqSubHead1:"\u0c2e\u0c40 \u0c38\u0c2e\u0c3e\u0c27\u0c3e\u0c28\u0c3e\u0c32\u0c32\u0c4b \u0c15\u0c4a\u0c28\u0c4d\u0c28\u0c3f\u0c02\u0c1f\u0c3f \u0c15\u0c4b\u0c38\u0c02 \u0c2e\u0c3e \u0c28\u0c3e\u0c32\u0c46\u0c21\u0c4d\u0c1c\u0c4d \u0c2c\u0c47\u0c38\u0c4d\u0c28\u0c41 \u0c1a\u0c42\u0c21\u0c02\u0c21\u0c3f!",ques1:"\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c05\u0c02\u0c1f\u0c47 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f, \u0c07\u0c26\u0c3f \u0c07\u0c24\u0c30 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c0e\u0c32\u0c3e \u0c2d\u0c3f\u0c28\u0c4d\u0c28\u0c02\u0c17\u0c3e \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f?",ans1:"\u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c30\u0c3e\u0c37\u0c4d\u0c1f\u0c4d\u0c30/\u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30 \u0c2a\u0c3e\u0c32\u0c3f\u0c24 \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c3e\u0c32 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35\u0c3e\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c35\u0c3f\u0c38\u0c4d\u0c24\u0c43\u0c24 \u0c36\u0c4d\u0c30\u0c47\u0c23\u0c3f \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c12\u0c15 \u0c1c\u0c3e\u0c24\u0c40\u0c2f \u0c35\u0c47\u0c26\u0c3f\u0c15. \u0c1c\u0c28\u0c3e\u0c2d\u0c3e \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32 \u0c06\u0c27\u0c3e\u0c30\u0c02\u0c17\u0c3e \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c25\u0c15\u0c3e\u0c32 \u0c36\u0c4b\u0c27\u0c28 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c06\u0c35\u0c3f\u0c37\u0c4d\u0c15\u0c30\u0c23 \u0c15\u0c4b\u0c38\u0c02 \u0c07\u0c26\u0c3f \u0c12\u0c15-\u0c38\u0c4d\u0c1f\u0c3e\u0c2a\u0c4d \u0c35\u0c47\u0c26\u0c3f\u0c15. \u0c38\u0c3e\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3e\u0c2f \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d\u0c32 \u0c2e\u0c3e\u0c26\u0c3f\u0c30\u0c3f\u0c17\u0c3e \u0c15\u0c3e\u0c15\u0c41\u0c02\u0c21\u0c3e, \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35\u0c02, \u0c30\u0c3e\u0c37\u0c4d\u0c1f\u0c4d\u0c30 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c2a\u0c3e\u0c32\u0c3f\u0c24 \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c3e\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c12\u0c15\u0c47 \u0c35\u0c47\u0c26\u0c3f\u0c15\u0c2a\u0c48 \u0c24\u0c40\u0c38\u0c41\u0c15\u0c41\u0c35\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41\u0c32\u0c15\u0c41 \u0c35\u0c3e\u0c30\u0c3f \u0c05\u0c30\u0c4d\u0c39\u0c24 \u0c06\u0c27\u0c3e\u0c30\u0c02\u0c17\u0c3e \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c21\u0c02\u0c32\u0c4b \u0c38\u0c39\u0c3e\u0c2f\u0c2a\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",ques2:"\u0c28\u0c3e \u0c2a\u0c25\u0c15\u0c02 \u0c38\u0c3e\u0c2e\u0c3e\u0c28\u0c4d\u0c2f \u0c2a\u0c4c\u0c30\u0c41\u0c32\u0c15\u0c41 \u0c0e\u0c32\u0c3e \u0c38\u0c39\u0c3e\u0c2f\u0c2a\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f?",ans2:"\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c02 \u0c2a\u0c4c\u0c30\u0c41\u0c32\u0c41 \u0c12\u0c15\u0c47 \u0c1a\u0c4b\u0c1f \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c40\u0c32\u0c41 \u0c15\u0c32\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c15\u0c41 \u0c2a\u0c4d\u0c30\u0c3e\u0c2a\u0c4d\u0c2f\u0c24\u0c28\u0c41 \u0c38\u0c41\u0c32\u0c2d\u0c24\u0c30\u0c02 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f, \u0c2c\u0c39\u0c41\u0c33 \u0c36\u0c3e\u0c16\u0c32 \u0c35\u0c46\u0c2c\u0c4d\u0c38\u0c48\u0c1f\u0c4d\u0c32\u0c28\u0c41 \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c4d\u0c38\u0c3f\u0c28 \u0c05\u0c35\u0c38\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c35\u0c3e\u0c30\u0c3f \u0c05\u0c30\u0c4d\u0c39\u0c24\u0c28\u0c41 \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c3f\u0c38\u0c4d\u0c24\u0c43\u0c24\u0c2e\u0c48\u0c28 \u0c2a\u0c25\u0c15\u0c02 \u0c2e\u0c3e\u0c30\u0c4d\u0c17\u0c26\u0c30\u0c4d\u0c36\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c2e\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.",ques3:"\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c0e\u0c32\u0c3e \u0c2a\u0c28\u0c3f\u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f?",ans3:"\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c02 \u0c2a\u0c4c\u0c30\u0c41\u0c32\u0c41 \u0c05\u0c30\u0c4d\u0c39\u0c41\u0c32\u0c48\u0c28 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c21\u0c02\u0c32\u0c4b \u0c38\u0c39\u0c3e\u0c2f\u0c2a\u0c21\u0c1f\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c30\u0c33\u0c2e\u0c48\u0c28 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2f\u0c42\u0c1c\u0c30\u0c4d \u0c2b\u0c4d\u0c30\u0c46\u0c02\u0c21\u0c4d\u0c32\u0c40 \u0c2e\u0c42\u0c21\u0c41-\u0c26\u0c36\u0c32 \u0c2a\u0c4d\u0c30\u0c15\u0c4d\u0c30\u0c3f\u0c2f\u0c28\u0c41 \u0c05\u0c28\u0c41\u0c38\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f\u0c03 \u0c26\u0c36 1: \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c1c\u0c28\u0c3e\u0c2d\u0c3e, \u0c06\u0c26\u0c3e\u0c2f\u0c02, \u0c38\u0c3e\u0c2e\u0c3e\u0c1c\u0c3f\u0c15 \u0c35\u0c30\u0c4d\u0c17\u0c02 \u0c2e\u0c4a\u0c26\u0c32\u0c48\u0c28 \u0c2a\u0c4d\u0c30\u0c3e\u0c25\u0c2e\u0c3f\u0c15 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c3e\u0c30\u0c41. \u0c26\u0c36 2: \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c06\u0c27\u0c3e\u0c30\u0c02\u0c17\u0c3e, \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c15\u0c4b\u0c38\u0c02 \u0c35\u0c02\u0c26\u0c32\u0c3e\u0c26\u0c3f \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c25\u0c15\u0c3e\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c2a\u0c4d\u0c30\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c26\u0c36 3: \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c05\u0c30\u0c4d\u0c39\u0c2e\u0c48\u0c28 \u0c2a\u0c25\u0c15\u0c3e\u0c32 \u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c35\u0c1a\u0c4d\u0c1a\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c3f\u0c35\u0c30\u0c23\u0c3e\u0c24\u0c4d\u0c2e\u0c15 \u0c1c\u0c4d\u0c1e\u0c3e\u0c28\u0c02, \u0c24\u0c30\u0c1a\u0c41\u0c17\u0c3e \u0c05\u0c21\u0c3f\u0c17\u0c47 \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c26\u0c30\u0c16\u0c3e\u0c38\u0c4d\u0c24\u0c41 \u0c2a\u0c4d\u0c30\u0c15\u0c4d\u0c30\u0c3f\u0c2f\u0c24\u0c4b \u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c47\u0c15 \u0c2a\u0c25\u0c15\u0c02 \u0c2a\u0c47\u0c1c\u0c40 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c2e\u0c30\u0c3f\u0c02\u0c24 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c4a\u0c02\u0c26\u0c35\u0c1a\u0c4d\u0c1a\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c26\u0c30\u0c16\u0c3e\u0c38\u0c4d\u0c24\u0c41 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c26\u0c30\u0c16\u0c3e\u0c38\u0c4d\u0c24\u0c41 URL \u0c15\u0c3f \u0c28\u0c3e\u0c35\u0c3f\u0c17\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",ques4:"\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u0c32\u0c4b \u0c38\u0c30\u0c48\u0c28 \u0c2a\u0c25\u0c15\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c24\u0c46\u0c32\u0c41\u0c38\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?",ans4:"\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c2e\u0c4d\u0c32\u0c4b \u0c38\u0c30\u0c48\u0c28 \u0c2a\u0c25\u0c15\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c2a\u0c4c\u0c30\u0c41\u0c32\u0c41 \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c02 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c05\u0c27\u0c3f\u0c15\u0c3e\u0c30\u0c3f\u0c15 \u0c35\u0c46\u0c2c\u0c4d\u0c38\u0c48\u0c1f\u0c4d\u0c28\u0c41 \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c39\u0c4b\u0c2e\u0c4d\u0c2a\u0c47\u0c1c\u0c40\u0c32\u0c4b \u0c12\u0c15\u0c38\u0c3e\u0c30\u0c3f, \u0c35\u0c3e\u0c30\u0c41 '\u0c2b\u0c48\u0c02\u0c21\u0c4d \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d\u0c38\u0c4d \u0c2b\u0c30\u0c4d \u0c2f\u0c41' \u0c2b\u0c40\u0c1a\u0c30\u0c4d\u0c28\u0c41 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c02\u0c1f\u0c3e\u0c30\u0c41, \u0c07\u0c26\u0c3f \u0c35\u0c2f\u0c38\u0c4d\u0c38\u0c41, \u0c32\u0c3f\u0c02\u0c17\u0c02, \u0c06\u0c26\u0c3e\u0c2f \u0c38\u0c4d\u0c25\u0c3e\u0c2f\u0c3f, \u0c35\u0c30\u0c4d\u0c17\u0c02 \u0c2e\u0c4a\u0c26\u0c32\u0c48\u0c28 \u0c35\u0c3e\u0c30\u0c3f \u0c1c\u0c28\u0c3e\u0c2d\u0c3e \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41\u0c32\u0c28\u0c41 \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c08 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24, \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c02 \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c02\u0c17\u0c3e \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c2a\u0c25\u0c15\u0c3e\u0c32 \u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.",ques5:"\u0c12\u0c15 \u0c28\u0c3f\u0c30\u0c4d\u0c26\u0c3f\u0c37\u0c4d\u0c1f \u0c2a\u0c25\u0c15\u0c02 \u0c17\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c3f \u0c0f \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c47\u0c28\u0c41 \u0c28\u0c3e \u0c2a\u0c25\u0c15\u0c02\u0c32\u0c4b \u0c2a\u0c4a\u0c02\u0c26\u0c17\u0c32\u0c28\u0c41?",ans5:"\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c02 \u0c2a\u0c4d\u0c30\u0c24\u0c3f \u0c2a\u0c25\u0c15\u0c02\u0c2a\u0c48 \u0c05\u0c30\u0c4d\u0c39\u0c24 \u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c3e\u0c32\u0c41, \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c47 \u0c2a\u0c4d\u0c30\u0c2f\u0c4b\u0c1c\u0c28\u0c3e\u0c32\u0c41, \u0c26\u0c30\u0c16\u0c3e\u0c38\u0c4d\u0c24\u0c41 \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c25\u0c15\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c4a\u0c02\u0c26\u0c1f\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c35\u0c38\u0c30\u0c2e\u0c48\u0c28 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c24\u0c4b \u0c38\u0c39\u0c3e \u0c38\u0c2e\u0c17\u0c4d\u0c30 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c08 \u0c2a\u0c25\u0c15\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c38\u0c3e\u0c27\u0c3e\u0c30\u0c23 \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32\u0c28\u0c41 \u0c2a\u0c30\u0c3f\u0c37\u0c4d\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c47\u0c15\u0c2e\u0c48\u0c28 \u0c24\u0c30\u0c1a\u0c41\u0c17\u0c3e \u0c05\u0c21\u0c3f\u0c17\u0c47 \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32\u0c41 (\u0c0e\u0c2b\u0c4d\u0c0e\u0c15\u0c4d\u0c2f\u0c42\u0c32\u0c41) \u0c35\u0c3f\u0c2d\u0c3e\u0c17\u0c02 \u0c15\u0c42\u0c21\u0c3e \u0c07\u0c02\u0c26\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c26\u0c3f.",ques6:"\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d\u0c32\u0c4b \u0c0f\u0c2f\u0c47 \u0c35\u0c3f\u0c38\u0c4d\u0c24\u0c43\u0c24 \u0c35\u0c30\u0c4d\u0c17\u0c3e\u0c32 \u0c15\u0c3f\u0c02\u0c26 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c41 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3f?",ans6:"\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c2e\u0c4d\u0c32\u0c4b \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c35\u0c3e\u0c1f\u0c3f \u0c2a\u0c4d\u0c30\u0c2f\u0c4b\u0c1c\u0c28\u0c3e\u0c32 \u0c38\u0c4d\u0c35\u0c2d\u0c3e\u0c35\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c32\u0c15\u0c4d\u0c37\u0c4d\u0c2f \u0c32\u0c2c\u0c4d\u0c27\u0c3f\u0c26\u0c3e\u0c30\u0c41\u0c32 \u0c06\u0c27\u0c3e\u0c30\u0c02\u0c17\u0c3e 15 \u0c35\u0c30\u0c4d\u0c17\u0c3e\u0c32\u0c41\u0c17\u0c3e \u0c35\u0c3f\u0c38\u0c4d\u0c24\u0c43\u0c24\u0c02\u0c17\u0c3e \u0c35\u0c30\u0c4d\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c30\u0c41. \u0c08 \u0c35\u0c30\u0c4d\u0c17\u0c3e\u0c32\u0c32\u0c4b \u0c35\u0c4d\u0c2f\u0c35\u0c38\u0c3e\u0c2f\u0c02, \u0c17\u0c4d\u0c30\u0c3e\u0c2e\u0c40\u0c23 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c30\u0c4d\u0c2f\u0c3e\u0c35\u0c30\u0c23\u0c02; \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c3f\u0c02\u0c17\u0c4d, \u0c06\u0c30\u0c4d\u0c25\u0c3f\u0c15 \u0c38\u0c47\u0c35\u0c32\u0c41 & \u0c2c\u0c40\u0c2e\u0c3e; \u0c35\u0c4d\u0c2f\u0c3e\u0c2a\u0c3e\u0c30\u0c02 & \u0c35\u0c4d\u0c2f\u0c35\u0c38\u0c4d\u0c25\u0c3e\u0c2a\u0c15\u0c24; \u0c35\u0c3f\u0c26\u0c4d\u0c2f & \u0c05\u0c2d\u0c4d\u0c2f\u0c3e\u0c38\u0c02; \u0c06\u0c30\u0c4b\u0c17\u0c4d\u0c2f\u0c02 & \u0c36\u0c4d\u0c30\u0c47\u0c2f\u0c38\u0c4d\u0c38\u0c41; \u0c17\u0c43\u0c39\u0c28\u0c3f\u0c30\u0c4d\u0c2e\u0c3e\u0c23\u0c02 & \u0c06\u0c36\u0c4d\u0c30\u0c2f\u0c02; \u0c2a\u0c4d\u0c30\u0c1c\u0c3e \u0c2d\u0c26\u0c4d\u0c30\u0c24, \u0c1a\u0c1f\u0c4d\u0c1f\u0c02 & \u0c28\u0c4d\u0c2f\u0c3e\u0c2f\u0c02; \u0c38\u0c48\u0c28\u0c4d\u0c38\u0c4d, \u0c10\u0c1f\u0c3f & \u0c15\u0c2e\u0c4d\u0c2f\u0c42\u0c28\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d\u0c38\u0c4d; \u0c28\u0c48\u0c2a\u0c41\u0c23\u0c4d\u0c2f\u0c3e\u0c32\u0c41 & \u0c09\u0c2a\u0c3e\u0c27\u0c3f; \u0c38\u0c3e\u0c2e\u0c3e\u0c1c\u0c3f\u0c15 \u0c38\u0c02\u0c15\u0c4d\u0c37\u0c47\u0c2e\u0c02 & \u0c38\u0c3e\u0c27\u0c3f\u0c15\u0c3e\u0c30\u0c24; \u0c15\u0c4d\u0c30\u0c40\u0c21\u0c32\u0c41 & \u0c38\u0c02\u0c38\u0c4d\u0c15\u0c43\u0c24\u0c3f; \u0c30\u0c35\u0c3e\u0c23\u0c3e & \u0c2e\u0c4c\u0c32\u0c3f\u0c15 \u0c38\u0c26\u0c41\u0c2a\u0c3e\u0c2f\u0c3e\u0c32\u0c41; \u0c2a\u0c4d\u0c30\u0c2f\u0c3e\u0c23\u0c02 & \u0c2a\u0c30\u0c4d\u0c2f\u0c3e\u0c1f\u0c15\u0c02; \u0c2f\u0c41\u0c1f\u0c3f\u0c32\u0c3f\u0c1f\u0c40 & \u0c2a\u0c3e\u0c30\u0c3f\u0c36\u0c41\u0c26\u0c4d\u0c27\u0c4d\u0c2f\u0c02; \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2e\u0c39\u0c3f\u0c33\u0c32\u0c41 & \u0c2a\u0c3f\u0c32\u0c4d\u0c32\u0c32\u0c41 \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3f.",ques7:"\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c02 \u0c2c\u0c39\u0c41\u0c2d\u0c3e\u0c37\u0c3e \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3e?",ans7:"\u0c05\u0c35\u0c41\u0c28\u0c41, \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c02 \u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24\u0c02 \u0c07\u0c02\u0c17\u0c4d\u0c32\u0c40\u0c37\u0c41\u0c24\u0c4b \u0c38\u0c39\u0c3e 15 \u0c2d\u0c3e\u0c37\u0c32\u0c32\u0c4b \u0c15\u0c02\u0c1f\u0c46\u0c02\u0c1f\u0c4d\u0c15\u0c41 \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41 \u0c07\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c05\u0c26\u0c28\u0c2a\u0c41 \u0c2d\u0c3e\u0c30\u0c24\u0c40\u0c2f \u0c2d\u0c3e\u0c37\u0c32\u0c15\u0c41 \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41 \u0c24\u0c4d\u0c35\u0c30\u0c32\u0c4b \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",ques8:"\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c02 \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c30\u0c3e\u0c37\u0c4d\u0c1f\u0c4d\u0c30/\u0c2f\u0c41\u0c1f\u0c3f-\u0c28\u0c3f\u0c30\u0c4d\u0c26\u0c3f\u0c37\u0c4d\u0c1f \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c2a\u0c4d\u0c30\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3e?",ans8:"\u0c05\u0c35\u0c41\u0c28\u0c41, \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c02 \u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24\u0c02 4,700 \u0c15\u0c3f \u0c2a\u0c48\u0c17\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c30\u0c3e\u0c37\u0c4d\u0c1f\u0c4d\u0c30/\u0c2f\u0c41\u0c1f\u0c3f \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c15\u0c41 \u0c2a\u0c4d\u0c30\u0c3e\u0c2a\u0c4d\u0c2f\u0c24\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c05\u0c26\u0c28\u0c2a\u0c41 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c41 \u0c28\u0c3f\u0c30\u0c02\u0c24\u0c30 \u0c2a\u0c4d\u0c30\u0c3e\u0c24\u0c3f\u0c2a\u0c26\u0c3f\u0c15\u0c28 \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u0c32\u0c4b \u0c06\u0c28\u0c4d\u0c2c\u0c4b\u0c30\u0c4d\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f.",ques9:"\u0c28\u0c47\u0c28\u0c41 \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u0c32\u0c4b \u0c28\u0c3f\u0c30\u0c4d\u0c26\u0c3f\u0c37\u0c4d\u0c1f \u0c2a\u0c25\u0c15\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c2f\u0c3e\u0c28\u0c41. \u0c28\u0c47\u0c28\u0c47\u0c02 \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c3f?",ans9:'\u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24\u0c02, 4,700 \u0c15\u0c3f \u0c2a\u0c48\u0c17\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c30\u0c3e\u0c37\u0c4d\u0c1f\u0c4d\u0c30/\u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c2a\u0c3e\u0c32\u0c3f\u0c24 \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c3e\u0c32 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c41 \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c35\u0c47\u0c26\u0c3f\u0c15\u0c2a\u0c48 \u0c06\u0c28\u0c4d\u0c2c\u0c4b\u0c30\u0c4d\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c4d\u0c21\u0c3e\u0c2f\u0c3f. \u0c15\u0c4d\u0c30\u0c2e\u0c02 \u0c24\u0c2a\u0c4d\u0c2a\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c05\u0c26\u0c28\u0c2a\u0c41 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c41 \u0c1c\u0c4b\u0c21\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3f. \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u0c32\u0c4b \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28 "\u0c17\u0c46\u0c1f\u0c4d \u0c07\u0c28\u0c4d \u0c1f\u0c1a\u0c4d" \u0c35\u0c3f\u0c2d\u0c3e\u0c17\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c4c\u0c30\u0c41\u0c32\u0c41 \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c24\u0c2a\u0c4d\u0c2a\u0c3f\u0c2a\u0c4b\u0c2f\u0c3f\u0c28 \u0c2a\u0c25\u0c15\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c38\u0c32\u0c39\u0c3e\u0c32\u0c28\u0c41 \u0c2a\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c35\u0c1a\u0c4d\u0c1a\u0c41.',ques10:"\u0c2e\u0c30\u0c3e\u0c20\u0c40 \u0c2d\u0c3e\u0c37\u0c32\u0c4b\u0c28\u0c3f \u0c2a\u0c25\u0c15\u0c3e\u0c32 \u0c35\u0c3f\u0c37\u0c2f\u0c3e\u0c32\u0c32\u0c4b \u0c15\u0c4a\u0c28\u0c4d\u0c28\u0c3f \u0c32\u0c4b\u0c2a\u0c3e\u0c32\u0c28\u0c41 \u0c28\u0c47\u0c28\u0c41 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41. \u0c28\u0c47\u0c28\u0c47\u0c02 \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c3f?",ans10:"\u0c2a\u0c25\u0c15\u0c02 \u0c15\u0c02\u0c1f\u0c46\u0c02\u0c1f\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c2e\u0c30\u0c3e\u0c20\u0c40 \u0c38\u0c02\u0c38\u0c4d\u0c15\u0c30\u0c23\u0c32\u0c4b \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c35\u0c4d\u0c2f\u0c24\u0c4d\u0c2f\u0c3e\u0c38\u0c02 \u0c15\u0c28\u0c3f\u0c2a\u0c3f\u0c02\u0c1a\u0c3f\u0c28\u0c1f\u0c4d\u0c32\u0c2f\u0c3f\u0c24\u0c47, \u0c35\u0c3f\u0c35\u0c30\u0c23 \u0c15\u0c4b\u0c38\u0c02 \u0c2a\u0c4c\u0c30\u0c41\u0c32\u0c41 \u0c06\u0c02\u0c17\u0c4d\u0c32 \u0c38\u0c02\u0c38\u0c4d\u0c15\u0c30\u0c23\u0c28\u0c41 \u0c1a\u0c42\u0c21\u0c3e\u0c32\u0c28\u0c3f \u0c38\u0c42\u0c1a\u0c3f\u0c02\u0c1a\u0c3e\u0c30\u0c41. \u0c38\u0c2e\u0c38\u0c4d\u0c2f \u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c3f\u0c24\u0c47, \u0c05\u0c24\u0c4d\u0c2f\u0c02\u0c24 \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c2e\u0c48\u0c28 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c2e\u0c02\u0c24\u0c4d\u0c30\u0c3f\u0c24\u0c4d\u0c35 \u0c36\u0c3e\u0c16 \u0c32\u0c47\u0c26\u0c3e \u0c35\u0c3f\u0c2d\u0c3e\u0c17\u0c02 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c05\u0c27\u0c3f\u0c15\u0c3e\u0c30\u0c3f\u0c15 \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d\u0c28\u0c41 \u0c38\u0c42\u0c1a\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c05\u0c26\u0c28\u0c02\u0c17\u0c3e, support-myscheme[at]digitalindia[dot]gov[dot]in \u0c15\u0c41 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c2a\u0c02\u0c2a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c38\u0c2e\u0c38\u0c4d\u0c2f\u0c28\u0c41 \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",ques11:"\u0c35\u0c3f\u0c26\u0c4d\u0c2f\u0c3e\u0c30\u0c4d\u0c25\u0c41\u0c32\u0c15\u0c41 \u0c38\u0c4d\u0c15\u0c3e\u0c32\u0c30\u0c4d\u0c37\u0c3f\u0c2a\u0c4d\u0c32\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c47 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c28\u0c47\u0c28\u0c41 \u0c05\u0c28\u0c4d\u0c35\u0c47\u0c37\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41. \u0c07\u0c26\u0c3f \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c38\u0c3e\u0c27\u0c4d\u0c2f\u0c2e\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3e?",ans11:"\u0c05\u0c35\u0c41\u0c28\u0c41, \u0c35\u0c3f\u0c26\u0c4d\u0c2f\u0c3e\u0c30\u0c4d\u0c25\u0c41\u0c32\u0c15\u0c41 \u0c38\u0c4d\u0c15\u0c3e\u0c32\u0c30\u0c4d\u0c37\u0c3f\u0c2a\u0c4d\u0c32\u0c24\u0c4b \u0c38\u0c39\u0c3e \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c47 \u0c2a\u0c4d\u0c30\u0c2f\u0c4b\u0c1c\u0c28\u0c3e\u0c32 \u0c30\u0c15\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c30\u0c3f\u0c27\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c02\u0c17\u0c3e \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c41\u0c32\u0c2d\u0c02\u0c17\u0c3e \u0c36\u0c4b\u0c27\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c05\u0c28\u0c4d\u0c35\u0c47\u0c37\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2a\u0c4c\u0c30\u0c41\u0c32\u0c15\u0c41 \u0c35\u0c40\u0c32\u0c41 \u0c15\u0c32\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c47 \u0c15\u0c40\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c3f\u0c24 \u0c36\u0c4b\u0c27\u0c28 \u0c32\u0c15\u0c4d\u0c37\u0c23\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c02 \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.",ques12:"\u0c28\u0c47\u0c28\u0c41 \u0c12\u0c15 \u0c28\u0c3f\u0c30\u0c4d\u0c26\u0c3f\u0c37\u0c4d\u0c1f \u0c2a\u0c25\u0c15\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c26\u0c30\u0c16\u0c3e\u0c38\u0c4d\u0c24\u0c41 \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c26\u0c30\u0c16\u0c3e\u0c38\u0c4d\u0c24\u0c41\u0c15\u0c41 \u0c05\u0c35\u0c38\u0c30\u0c2e\u0c48\u0c28 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c24\u0c46\u0c32\u0c41\u0c38\u0c41\u0c15\u0c4b\u0c35\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41. \u0c28\u0c47\u0c28\u0c41 \u0c08 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c3e \u0c2a\u0c25\u0c15\u0c02\u0c32\u0c4b \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c17\u0c32\u0c28\u0c3e?",ans12:"\u0c05\u0c35\u0c41\u0c28\u0c41, \u0c2a\u0c4d\u0c30\u0c24\u0c3f \u0c2a\u0c25\u0c15\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c26\u0c30\u0c16\u0c3e\u0c38\u0c4d\u0c24\u0c41 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c35\u0c38\u0c30\u0c2e\u0c48\u0c28 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e\u0c28\u0c41 \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c02 \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f, \u0c2a\u0c4c\u0c30\u0c41\u0c32\u0c41 \u0c38\u0c41\u0c32\u0c2d\u0c02\u0c17\u0c3e \u0c38\u0c3f\u0c26\u0c4d\u0c27\u0c02 \u0c15\u0c3e\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c26\u0c30\u0c16\u0c3e\u0c38\u0c4d\u0c24\u0c41 \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c40\u0c32\u0c41 \u0c15\u0c32\u0c4d\u0c2a\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.",ques13:"\u0c28\u0c47\u0c28\u0c41 \u0c28\u0c3e \u0c2a\u0c25\u0c15\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c25\u0c15\u0c3e\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c26\u0c30\u0c16\u0c3e\u0c38\u0c4d\u0c24\u0c41 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c3e?",ans13:"\u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24\u0c02, \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c02 \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41\u0c32\u0c28\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c2e\u0c02\u0c24\u0c4d\u0c30\u0c3f\u0c24\u0c4d\u0c35 \u0c36\u0c3e\u0c16 \u0c32\u0c47\u0c26\u0c3e \u0c35\u0c3f\u0c2d\u0c3e\u0c17\u0c02 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c2a\u0c25\u0c15\u0c02 \u0c26\u0c30\u0c16\u0c3e\u0c38\u0c4d\u0c24\u0c41 \u0c2a\u0c47\u0c1c\u0c40\u0c15\u0c3f \u0c2e\u0c33\u0c4d\u0c33\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c30\u0c3e\u0c2c\u0c4b\u0c2f\u0c47 \u0c26\u0c36\u0c32\u0c4d\u0c32\u0c4b, \u0c2a\u0c4c\u0c30\u0c41\u0c32\u0c41 \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d/\u0c09\u0c2e\u0c02\u0c17\u0c4d \u0c05\u0c2a\u0c4d\u0c32\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c15\u0c41 \u0c26\u0c30\u0c16\u0c3e\u0c38\u0c4d\u0c24\u0c41 \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c17\u0c32\u0c30\u0c28\u0c3f \u0c2d\u0c3e\u0c35\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c30\u0c41.",ques14:'\u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41\u0c15\u0c41 \u0c2c\u0c3e\u0c17\u0c3e \u0c38\u0c30\u0c3f\u0c2a\u0c4b\u0c2f\u0c47 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c05\u0c28\u0c4d\u0c35\u0c47\u0c37\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 "\u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c36\u0c4b\u0c27\u0c28" \u0c32\u0c15\u0c4d\u0c37\u0c23\u0c02\u0c32\u0c4b \u0c0f \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f?',ans14:'\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 "\u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c36\u0c4b\u0c27\u0c28" \u0c32\u0c15\u0c4d\u0c37\u0c23\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41\u0c32\u0c41 \u0c32\u0c3f\u0c02\u0c17\u0c02, \u0c35\u0c2f\u0c38\u0c4d\u0c38\u0c41, \u0c35\u0c48\u0c35\u0c3e\u0c39\u0c3f\u0c15 \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f, \u0c30\u0c3e\u0c37\u0c4d\u0c1f\u0c4d\u0c30\u0c02, \u0c28\u0c3f\u0c35\u0c3e\u0c38 \u0c38\u0c4d\u0c25\u0c32\u0c02 (\u0c2a\u0c1f\u0c4d\u0c1f\u0c23 \u0c32\u0c47\u0c26\u0c3e \u0c17\u0c4d\u0c30\u0c3e\u0c2e\u0c40\u0c23), \u0c38\u0c3e\u0c2e\u0c3e\u0c1c\u0c3f\u0c15 \u0c35\u0c30\u0c4d\u0c17\u0c02, \u0c35\u0c48\u0c15\u0c32\u0c4d\u0c2f\u0c02 \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f, \u0c2e\u0c48\u0c28\u0c3e\u0c30\u0c3f\u0c1f\u0c40 \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f, \u0c09\u0c2a\u0c3e\u0c27\u0c3f \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c07\u0c24\u0c30 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c35\u0c02\u0c1f\u0c3f \u0c2a\u0c4d\u0c30\u0c3e\u0c25\u0c2e\u0c3f\u0c15 \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f. \u0c07\u0c26\u0c3f \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \u0c15\u0c41 \u0c05\u0c24\u0c4d\u0c2f\u0c02\u0c24 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c21\u0c02\u0c32\u0c4b \u0c38\u0c39\u0c3e\u0c2f\u0c2a\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.',ques15:'"\u0c1a\u0c46\u0c15\u0c4d \u0c0e\u0c32\u0c3f\u0c1c\u0c3f\u0c2c\u0c3f\u0c32\u0c3f\u0c1f\u0c40 \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c3e\u0c35\u0c33\u0c3f" \u0c32\u0c15\u0c4d\u0c37\u0c23\u0c02 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?',ans15:'"\u0c1a\u0c46\u0c15\u0c4d \u0c0e\u0c32\u0c3f\u0c1c\u0c3f\u0c2c\u0c3f\u0c32\u0c3f\u0c1f\u0c40 \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c3e\u0c2a\u0c24\u0c4d\u0c30\u0c02" \u0c32\u0c15\u0c4d\u0c37\u0c23\u0c02 \u0c2a\u0c25\u0c15\u0c02-\u0c28\u0c3f\u0c30\u0c4d\u0c26\u0c3f\u0c37\u0c4d\u0c1f \u0c05\u0c30\u0c4d\u0c39\u0c24 \u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c3e\u0c32\u0c2a\u0c48 \u0c26\u0c43\u0c37\u0c4d\u0c1f\u0c3f \u0c2a\u0c46\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41\u0c32\u0c41 \u0c38\u0c3e\u0c27\u0c3e\u0c30\u0c23 \u0c05\u0c35\u0c41\u0c28\u0c41/\u0c15\u0c3e\u0c26\u0c41 \u0c06\u0c27\u0c3e\u0c30\u0c3f\u0c24 \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c3e\u0c2a\u0c24\u0c4d\u0c30\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c35\u0c3e\u0c30\u0c3f \u0c05\u0c30\u0c4d\u0c39\u0c24\u0c28\u0c41 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c40\u0c32\u0c41 \u0c15\u0c32\u0c4d\u0c2a\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c38\u0c4d\u0c2a\u0c02\u0c26\u0c28\u0c32 \u0c06\u0c27\u0c3e\u0c30\u0c02\u0c17\u0c3e, \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41\u0c32\u0c41 \u0c12\u0c15 \u0c28\u0c3f\u0c30\u0c4d\u0c26\u0c3f\u0c37\u0c4d\u0c1f \u0c2a\u0c25\u0c15\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c30\u0c4d\u0c39\u0c41\u0c32\u0c3e \u0c15\u0c3e\u0c26\u0c3e \u0c05\u0c28\u0c3f \u0c24\u0c4d\u0c35\u0c30\u0c17\u0c3e \u0c05\u0c02\u0c1a\u0c28\u0c3e \u0c35\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41.',ques16:"\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d\u0c32\u0c4b \u0c1a\u0c3e\u0c1f\u0c4d\u0c2c\u0c3e\u0c1f\u0c4d \u0c38\u0c4c\u0c15\u0c30\u0c4d\u0c2f\u0c02 \u0c09\u0c02\u0c26\u0c3e, \u0c05\u0c26\u0c3f \u0c2a\u0c4c\u0c30\u0c41\u0c32\u0c15\u0c41 \u0c0e\u0c32\u0c3e \u0c38\u0c39\u0c3e\u0c2f\u0c2a\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f?",ans16:"\u0c05\u0c35\u0c41\u0c28\u0c41, \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c21\u0c02\u0c32\u0c4b \u0c2a\u0c4c\u0c30\u0c41\u0c32\u0c15\u0c41 \u0c38\u0c39\u0c3e\u0c2f\u0c2a\u0c21\u0c1f\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c35\u0c3e\u0c2f\u0c3f\u0c38\u0c4d-\u0c0e\u0c28\u0c47\u0c2c\u0c41\u0c32\u0c4d\u0c21\u0c4d, \u0c2c\u0c39\u0c41\u0c2d\u0c3e\u0c37\u0c3e AI-\u0c36\u0c15\u0c4d\u0c24\u0c3f\u0c24\u0c4b \u0c15\u0c42\u0c21\u0c3f\u0c28 \u0c1a\u0c3e\u0c1f\u0c4d\u0c2c\u0c3e\u0c1f\u0c4d\u0c28\u0c41 \u0c2e\u0c4b\u0c39\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c02\u0c26\u0c3f. \u0c1a\u0c3e\u0c1f\u0c4d\u0c2c\u0c3e\u0c1f\u0c4d \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32\u0c15\u0c41 \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c24\u0c15\u0c4d\u0c37\u0c23 \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c38\u0c4d\u0c2a\u0c02\u0c26\u0c28\u0c32\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f, \u0c38\u0c02\u0c2d\u0c3e\u0c37\u0c23\u0c3e \u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c25\u0c15\u0c02 \u0c06\u0c35\u0c3f\u0c37\u0c4d\u0c15\u0c30\u0c23\u0c28\u0c41 \u0c38\u0c41\u0c32\u0c2d\u0c24\u0c30\u0c02 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c06\u0c15\u0c30\u0c4d\u0c37\u0c23\u0c40\u0c2f\u0c2e\u0c48\u0c28 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41-\u0c38\u0c4d\u0c28\u0c47\u0c39\u0c2a\u0c42\u0c30\u0c4d\u0c35\u0c15 \u0c05\u0c28\u0c41\u0c2d\u0c35\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35-\u0c2a\u0c4c\u0c30\u0c41\u0c32 \u0c2a\u0c30\u0c38\u0c4d\u0c2a\u0c30 \u0c1a\u0c30\u0c4d\u0c2f\u0c28\u0c41 \u0c2a\u0c46\u0c02\u0c1a\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",ques17:"\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d\u0c32\u0c4b \u0c0f\u0c10 \u0c1a\u0c3e\u0c1f\u0c4d\u0c2c\u0c3e\u0c1f\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c2e\u0c41\u0c16\u0c4d\u0c2f \u0c32\u0c15\u0c4d\u0c37\u0c23\u0c3e\u0c32\u0c41 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?",ans17:"MyScheme AI \u0c1a\u0c3e\u0c1f\u0c4d\u0c2c\u0c3e\u0c1f\u0c4d \u0c35\u0c3e\u0c2f\u0c3f\u0c38\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1f\u0c46\u0c15\u0c4d\u0c38\u0c4d\u0c1f\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c3f\u0c24 \u0c2a\u0c30\u0c38\u0c4d\u0c2a\u0c30 \u0c1a\u0c30\u0c4d\u0c2f\u0c32\u0c41, \u0c39\u0c3f\u0c02\u0c26\u0c40 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c06\u0c02\u0c17\u0c4d\u0c32\u0c02\u0c32\u0c4b \u0c26\u0c4d\u0c35\u0c3f\u0c2d\u0c3e\u0c37\u0c3e \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41, \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c2d-\u0c05\u0c35\u0c17\u0c3e\u0c39\u0c28 \u0c38\u0c02\u0c2d\u0c3e\u0c37\u0c23\u0c32\u0c41, \u0c38\u0c46\u0c37\u0c28\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c3f\u0c24 \u0c1a\u0c3e\u0c1f\u0c4d \u0c1a\u0c30\u0c3f\u0c24\u0c4d\u0c30 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c38\u0c4d\u0c2a\u0c02\u0c26\u0c28\u0c32\u0c28\u0c41 \u0c15\u0c3e\u0c2a\u0c40 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c0e\u0c02\u0c2a\u0c3f\u0c15\u0c32\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f, \u0c07\u0c26\u0c3f \u0c05\u0c24\u0c41\u0c15\u0c41\u0c32\u0c41 \u0c32\u0c47\u0c28\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2f\u0c42\u0c1c\u0c30\u0c4d \u0c2b\u0c4d\u0c30\u0c46\u0c02\u0c21\u0c4d\u0c32\u0c40 \u0c05\u0c28\u0c41\u0c2d\u0c35\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.",ques18:"\u0c2a\u0c25\u0c15\u0c3e\u0c32 \u0c35\u0c3f\u0c37\u0c2f\u0c3e\u0c32\u0c15\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f \u0c28\u0c3e \u0c05\u0c2d\u0c3f\u0c2a\u0c4d\u0c30\u0c3e\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c47\u0c28\u0c41 \u0c0e\u0c32\u0c3e \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c17\u0c32\u0c28\u0c41?",ans18:"\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c02 \u0c2a\u0c4d\u0c30\u0c24\u0c3f \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c47\u0c1c\u0c40 \u0c26\u0c3f\u0c17\u0c41\u0c35\u0c28 \u0c09\u0c28\u0c4d\u0c28 \u0c2b\u0c40\u0c21\u0c4d\u0c2c\u0c4d\u0c2f\u0c3e\u0c15\u0c4d \u0c35\u0c3f\u0c2d\u0c3e\u0c17\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f, \u0c07\u0c26\u0c3f \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41\u0c32\u0c15\u0c41 1 \u0c28\u0c41\u0c02\u0c21\u0c3f 5 \u0c28\u0c15\u0c4d\u0c37\u0c24\u0c4d\u0c30\u0c3e\u0c32 \u0c35\u0c30\u0c15\u0c41 \u0c15\u0c02\u0c1f\u0c46\u0c02\u0c1f\u0c4d\u0c28\u0c41 \u0c30\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c3e\u0c30\u0c3f \u0c05\u0c28\u0c41\u0c2d\u0c35\u0c3e\u0c32\u0c41, \u0c38\u0c42\u0c1a\u0c28\u0c32\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c05\u0c2d\u0c3f\u0c2a\u0c4d\u0c30\u0c3e\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c40\u0c32\u0c41 \u0c15\u0c32\u0c4d\u0c2a\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c02 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c28\u0c3f\u0c30\u0c02\u0c24\u0c30 \u0c2e\u0c46\u0c30\u0c41\u0c17\u0c41\u0c26\u0c32 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c38\u0c4d\u0c2a\u0c02\u0c26\u0c28\u0c28\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41\u0c32\u0c41 support-myscheme@digitalindia.gov.in \u0c15\u0c41 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c35\u0c3f\u0c35\u0c30\u0c23\u0c3e\u0c24\u0c4d\u0c2e\u0c15 \u0c05\u0c2d\u0c3f\u0c2a\u0c4d\u0c30\u0c3e\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c15\u0c42\u0c21\u0c3e \u0c2a\u0c02\u0c2a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",ques19:"\u0c12\u0c15 \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d\u0c32\u0c4b \u0c0e\u0c32\u0c3e \u0c38\u0c48\u0c28\u0c4d \u0c05\u0c2a\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c38\u0c48\u0c28\u0c4d \u0c07\u0c28\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41?",ans19:"\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2e\u0c46\u0c30\u0c3f\u0c2a\u0c46\u0c39\u0c4d\u0c1a\u0c3e\u0c28\u0c4d (\u0c28\u0c47\u0c37\u0c28\u0c32\u0c4d \u0c38\u0c3f\u0c02\u0c17\u0c3f\u0c32\u0c4d \u0c38\u0c48\u0c28\u0c4d-\u0c06\u0c28\u0c4d) \u0c24\u0c4b \u0c05\u0c28\u0c41\u0c38\u0c02\u0c27\u0c3e\u0c28\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f \u0c09\u0c02\u0c26\u0c3f, \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41\u0c32\u0c41 \u0c35\u0c3e\u0c30\u0c3f \u0c2e\u0c46\u0c30\u0c3f\u0c2a\u0c46\u0c39\u0c4d\u0c1a\u0c3e\u0c28\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3f \u0c38\u0c48\u0c28\u0c4d \u0c05\u0c2a\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c38\u0c48\u0c28\u0c4d \u0c07\u0c28\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c40\u0c32\u0c41 \u0c15\u0c32\u0c4d\u0c2a\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41\u0c32\u0c41 \u0c38\u0c48\u0c28\u0c4d \u0c07\u0c28\u0c4d \u0c1a\u0c47\u0c2f\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c2c\u0c4d\u0c30\u0c4c\u0c1c\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c36\u0c4b\u0c27\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c05\u0c2f\u0c3f\u0c24\u0c47, \u0c38\u0c48\u0c28\u0c4d \u0c07\u0c28\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c02 \u0c35\u0c32\u0c4d\u0c32 \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41\u0c32\u0c41 \u0c35\u0c3e\u0c30\u0c3f \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d\u0c28\u0c41 \u0c38\u0c47\u0c35\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c2c\u0c41\u0c15\u0c4d\u0c2e\u0c3e\u0c30\u0c4d\u0c15\u0c4d \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d\u0c32\u0c28\u0c41 \u0c38\u0c47\u0c35\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c3e\u0c30\u0c3f \u0c38\u0c47\u0c35\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32 \u0c06\u0c27\u0c3e\u0c30\u0c02\u0c17\u0c3e \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c38\u0c3f\u0c2b\u0c3e\u0c30\u0c4d\u0c38\u0c41\u0c32\u0c28\u0c41 \u0c38\u0c4d\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.",ques20:"\u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u0c32\u0c4b \u0c28\u0c47\u0c28\u0c41 \u0c12\u0c15 \u0c2a\u0c25\u0c15\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c32\u0c3e \u0c36\u0c4b\u0c27\u0c3f\u0c02\u0c1a\u0c17\u0c32\u0c28\u0c41?",ans20:"\u0c2a\u0c25\u0c15\u0c02 \u0c2a\u0c47\u0c30\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c15\u0c40\u0c32\u0c15 \u0c2a\u0c26\u0c3e\u0c32 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c36\u0c4b\u0c27\u0c3f\u0c02\u0c1a\u0c21\u0c02, \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c38\u0c3f\u0c2b\u0c3e\u0c30\u0c4d\u0c38\u0c41\u0c32\u0c41, \u0c30\u0c3e\u0c37\u0c4d\u0c1f\u0c4d\u0c30\u0c02/\u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c2a\u0c3e\u0c32\u0c3f\u0c24 \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2a\u0c25\u0c15\u0c3e\u0c32 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c35\u0c21\u0c2a\u0c4b\u0c24, \u0c2a\u0c25\u0c15\u0c02 \u0c2a\u0c4d\u0c30\u0c2f\u0c4b\u0c1c\u0c28 \u0c35\u0c30\u0c4d\u0c17\u0c3e\u0c32 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2c\u0c4d\u0c30\u0c4c\u0c1c\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2e\u0c3e\u0c30\u0c4d\u0c17\u0c26\u0c30\u0c4d\u0c36\u0c15 \u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c15\u0c4b\u0c38\u0c02 AI-\u0c36\u0c15\u0c4d\u0c24\u0c3f\u0c24\u0c4b \u0c15\u0c42\u0c21\u0c3f\u0c28 \u0c1a\u0c3e\u0c1f\u0c4d\u0c2c\u0c3e\u0c1f\u0c4d\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c35\u0c02\u0c1f\u0c3f \u0c2a\u0c25\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c36\u0c4b\u0c27\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c28\u0c47\u0c15 \u0c2e\u0c3e\u0c30\u0c4d\u0c17\u0c3e\u0c32\u0c28\u0c41 MyScheme \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c02 \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c