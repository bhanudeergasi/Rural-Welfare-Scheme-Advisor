0 NeGD \u0935\u093f\u0937\u092f \u0915\u0940 \u0938\u091f\u0940\u0915\u0924\u093e, \u092a\u0942\u0930\u094d\u0923\u0924\u093e, \u0909\u092a\u092f\u094b\u0917\u093f\u0924\u093e \u092f\u093e \u0905\u0928\u094d\u092f\u0925\u093e \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947\u0902 \u0915\u094b\u0908 \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0918\u091f\u0928\u093e \u092e\u0947\u0902, Meity \u092f\u093e NeGD \u0915\u093f\u0938\u0940 \u092d\u0940 \u0928\u0941\u0915\u0938\u093e\u0928, \u0915\u094d\u0937\u0924\u093f, \u0926\u093e\u092f\u093f\u0924\u094d\u0935 \u092f\u093e \u0916\u0930\u094d\u091a \u0915\u0947 \u0932\u093f\u090f \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u0940 \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u093e, \u091c\u094b \u0907\u0938 \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u0947 \u092a\u0930\u093f\u0923\u093e\u092e\u0938\u094d\u0935\u0930\u0942\u092a \u0939\u094b\u0928\u0947 \u0915\u093e \u0926\u093e\u0935\u093e \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0938\u0940\u092e\u093e \u0915\u0947, \u0915\u094b\u0908 \u0926\u094b\u0937, \u0935\u093e\u092f\u0930\u0938, \u0924\u094d\u0930\u0941\u091f\u093f, \u091a\u0942\u0915, \u0930\u0941\u0915\u093e\u0935\u091f \u092f\u093e \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0964 \u0926\u0947\u0930\u0940, \u0909\u0938\u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947\u0902, \u0905\u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u092f\u093e \u0926\u0942\u0930\u0938\u094d\u0925\u0964 \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u090f\u0915\u092e\u093e\u0924\u094d\u0930 \u091c\u094b\u0916\u093f\u092e \u0915\u093e \u0939\u0948\u0964 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0935\u093f\u0936\u0947\u0937 \u0930\u0942\u092a \u0938\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0938\u0939\u092e\u0924 \u0939\u094b\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u093f\u0938\u0940 \u092d\u0940 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0906\u091a\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f Meity \u0914\u0930 NeGD \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964 \u0907\u0938 \u092a\u094b\u0930\u094d\u091f\u0932 \u092a\u0930 \u0936\u093e\u092e\u093f\u0932 \u0915\u0940 \u0917\u0908 \u0905\u0928\u094d\u092f \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u094b\u0902 \u0915\u0947 \u0932\u093f\u0902\u0915 \u0915\u0947\u0935\u0932 \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u0932\u092c\u094d\u0927 \u0915\u0930\u093e\u090f \u0917\u090f \u0939\u0948\u0902\u0964 \u0939\u093e\u0932\u093e\u0902\u0915\u093f, Meity \u092f\u093e NeGD \u0932\u093f\u0902\u0915\u094d\u0921 \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u094b\u0902 \u0915\u0940 \u0935\u093f\u0937\u092f \u092f\u093e \u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948 \u0914\u0930 \u091c\u0930\u0942\u0930\u0940 \u0928\u0939\u0940\u0902 \u0915\u093f \u0909\u0938\u092e\u0947\u0902 \u0935\u094d\u092f\u0915\u094d\u0924 \u0935\u093f\u091a\u093e\u0930\u094b\u0902 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0930\u0924\u093e \u0939\u094b\u0964 Meity \u092f\u093e NeGD \u0910\u0938\u0947 \u0932\u093f\u0902\u0915\u094d\u0921 \u092a\u0947\u091c\u094b\u0902 \u0915\u0940