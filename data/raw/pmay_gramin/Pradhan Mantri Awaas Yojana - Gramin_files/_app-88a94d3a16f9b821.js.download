46",mission1:"\u0633\u0627\u0646\u06c1 \u0645\u0634\u0646 \u0686\u06be \u0633\u0631\u06a9\u0672\u0631\u06cd \u0633\u06a9\u06cc\u0645\u0646 \u062a\u06c1\u0655 \u0641\u0672\u0626\u062f\u0646 \u062e\u0672\u0637\u0631\u0655 \u062d\u06a9\u0648\u0657\u0645\u062a-\u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646 \u0648\u0672\u0644\u0633 \u0627\u0646\u0679\u0631\u0641\u06cc\u0633\u0633 \u06c1\u0645\u0648\u0627\u0631 \u06a9\u0631\u0655\u0646\u06cd\u06d4",mission2:"\u0633\u0631\u06a9\u0672\u0631 \u0645\u0646\u0635\u0648\u0657\u0628\u06c1\u0655 \u0698\u06be\u0627\u0646\u065b\u0691\u0646\u06c1\u0655 \u062a\u06c1\u0655 \u0627\u0645\u06cc\u06a9 \u0641\u0672\u0626\u062f\u0655 \u062d\u0672\u0635\u0644 \u06a9\u0631\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655 \u062f\u0631\u06a9\u0627\u0631 \u0648\u0642\u062a \u062a\u06c1\u0655 \u06a9\u0648\u0634\u0634 \u06a9\u0631\u06cc\u0648 \u06a9\u0645\u06d4",aboutPageDesc1:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0686\u06be \u0646\u06cc\u0634\u0646\u0644 \u0627\u06cc \u06af\u0648\u0631\u0646\u0646\u0633 \u0688\u0648\u06cc\u0698\u0646 (\u0627\u06cc\u0646 \u0627\u06cc \u062c\u06cc \u0688\u06cc) \u06a9\u06c1 \u0630\u0631\u06cc\u0639 \u062a\u06cc\u0627\u0631\u060c \u0645\u0646\u0638\u0645 \u062a\u06c1\u0655 \u0686\u0644\u0627\u0648\u0646\u06c1\u0655 \u06cc\u0648\u0627\u0646\u060c \u0648\u0632\u0627\u0631\u062a \u0627\u0644\u06cc\u06a9\u0679\u0631\u0627\u0646\u06a9\u0633 \u0627\u06cc\u0646\u0688 \u0627\u0646\u0641\u0627\u0631\u0645\u06cc\u0634\u0646 \u0679\u06cc\u06a9\u0646\u0627\u0644\u0648\u062c\u06cc (\u0627\u06cc\u0645 \u0627\u06cc \u0622\u0626\u06cc \u0679\u06cc \u0648\u0627\u0626\u06cc)\u060c \u0627\u0646\u062a\u0638\u0627\u0645\u06cc \u0627\u0635\u0644\u0627\u062d\u0627\u062a \u062a\u06c1\u0655 \u0639\u0648\u0627\u0645\u06cc \u0634\u06a9\u0627\u06cc\u0627\u062a\u06a9 \u0645\u062d\u06a9\u0645\u06c1\u0655 (\u0688\u06cc \u0627\u06d2 \u0622\u0631 \u067e\u06cc \u062c\u06cc) \u06a9\u06c1 \u0645\u062f\u062a\u06c1\u0655 \u0633\u06ed\u062a\u06cd \u062a\u06c1\u0655 \u062f\u06cc\u0645\u0646 \u0645\u0631\u06a9\u0632\u06cc \u062a\u06c1\u0655 \u0631\u06cc\u0627\u0633\u062a\u06cc \u0648\u0632\u0627\u0631\u062a\u0646/\u0645\u062d\u06a9\u0645\u0646 \u0633\u06ed\u062a\u06cd \u0634\u0631\u0627\u06a9\u062a \u0645\u0646\u065b\u0632\u06d4",eligibilityCheckHead:"\u0627\u06c1\u0644\u06cc\u062a\u0686 \u062c\u0627\u0646\u0686\u06d4",eligibilityCheckDesc:"\u062a\u06c1\u06cd \u06c1\u06cc\u065a\u06a9\u0648 \u0645\u062e\u062a\u0654\u0644\u0641 \u0645\u0639\u06cc\u0627\u0631\u0646 \u062a\u06c1\u0655 \u0630\u0672\u062a\u06cc \u0635\u0641\u0672\u06cc\u06cc \u06c1\u0646\u065b\u062f \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0654\u0631\u062a\u06be \u0633\u06a9\u06cc\u0645\u0646 \u062e\u0672\u0637\u0631\u0655 \u067e\u0646\u0655\u0646\u06cd \u0627\u06c1\u0644\u06cc\u062a \u0624\u0686\u06be\u062a\u06be\u06d4",schemeFinderHead:"\u0633\u06a9\u06cc\u0645 \u0641\u0627\u0626\u0646\u0688\u0631",schemeFinderDesc:"\u0645\u062e\u062a\u0654\u0644\u0641 \u0633\u0631\u06a9\u0672\u0631 \u0645\u0646\u0635\u0648\u0657\u0628\u0646 \u062e\u0672\u0637\u0631\u0655 \u0641\u0644\u0679\u0631\u0633 \u067e\u0620\u0679\u06be \u0645\u0628\u0646\u06cc \u0688\u0631\u0644 \u0688\u0627\u0648\u0646\u0633 \u0633\u06ed\u062a\u06cd \u062a\u06cc\u0632 \u062a\u06c1\u0655 \u0633\u06c1\u0644 \u062a\u0644\u0627\u0634\u06d4",schemeInDetailHead:"\u0645\u0646\u0635\u0648\u0628\u06c1\u0655 \u062a\u0641\u0635\u06cc\u0644 \u0633\u0627\u0646",schemeInDetailDesc:"\u0627\u067e\u0644\u0627\u06cc\u0688 \u06a9\u0631\u0646\u06c1\u0655 \u0628\u0631\u065b\u0648\u0646\u065b\u06c1\u06c1 \u06a9\u0654\u0631\u0648 \u062e\u0627\u0635 \u0633\u06a9\u06cc\u0645\u06c1\u0655 \u06c1\u0655\u0646\u065b\u062f\u0620\u0646 \u067e\u062c\u0646\u0646 \u0645\u0646\u065b\u0632 \u0633\u0620\u0679\u06be\u0627 \u063a\u0672\u0644\u0628 \u06cc\u062a\u06be \u0645\u0646\u065b\u0632 \u0633\u0620\u0679\u06be\u0627 \u06a9\u06be\u0648\u0657\u0631 \u062f\u0627\u0631 \u0633\u06a9\u06cc\u0645\u06c1 \u06c1\u0655\u0646\u065b\u0632\u0655 \u062a\u0641\u0635\u06cc\u0656\u0644 \u0644\u0628\u0646\u06c1\u0655 \u06cc\u0646\u06c1\u06d4",documentRequired:"\u0636\u0631\u0648\u0631\u06cc \u062f\u0633\u062a\u0627\u0648\u06cc\u0632",faqHead:"\u0627\u06a9\u062b\u0631 \u067e\u0648\u0686\u06be\u06d2 \u06af\u0626\u06d2 \u0633\u0648\u0627\u0644\u0627\u062a",faqSubHead1:"\u067e\u0646\u0646\u0620\u0646 \u06a9\u06cc\u065a\u0646\u065b\u06c1\u06c1 \u062c\u0648\u0627\u0628\u0646 \u062e\u0672\u0637\u0631\u0655 \u06a9\u0654\u0631\u0648 \u0633\u0672\u0646\u06cd \u0639\u0644\u0645\u0655\u0686 \u0628\u0646\u06cc\u0627\u062f \u0686\u06cc\u06a9\u06d4",ques1:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u06a9\u06cc\u065b\u0627\u06c1 \u0686\u06be\u060c \u062a\u06c1\u0655 \u06cc\u06c1 \u06a9\u062a\u06be \u06a9\u0654\u0646\u06cd \u0686\u06be \u0628\u0627\u0642\u06cc\u0646 \u0633\u0631\u06a9\u0672\u0631\u06cd \u067e\u0648\u0631\u0679\u0644\u0646 \u0646\u0634 \u0645\u062e\u062a\u0654\u0644\u0641\u061f",ans1:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0686\u06be \u0645\u0631\u06a9\u0632\u06cc \u062a\u06c1\u0655 \u0631\u06cc\u0627\u0633\u062a/\u0645\u0631\u06a9\u0632\u0655 \u0632\u06cc\u0631 \u0627\u0646\u062a\u0638\u0627\u0645 \u0639\u0644\u0627\u0642\u06c1\u0655 \u062f\u0634\u0648\u0646\u06cc \u062d\u06a9\u0648\u0645\u062a\u0646 \u06c1\u0646\u065b\u062f \u0637\u0631\u0641\u06c1\u0655 \u0633\u0631\u06a9\u0672\u0631\u06cd \u0633\u06a9\u06cc\u0645\u0646 \u06c1\u0646\u065b\u0632 \u0627\u06a9\u06be \u0648\u0633\u06cc\u0639 \u0631\u06cc\u0646\u062c\u0633 \u062a\u0627\u0645 \u0631\u0633\u0672\u06cc\u06cc \u062e\u0672\u0637\u0631\u0655 \u0627\u06a9\u06be \u0642\u0648\u0645\u06cc \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u06d4 \u06cc\u06c1 \u0686\u06be \u0688\u06cc\u0645\u0648\u06af\u0631\u0627\u0641\u06a9 \u062a\u0641\u0635\u06cc\u0644\u0646 \u067e\u06cc\u065a\u0679\u06be \u0645\u0628\u0646\u06cc \u0633\u0631\u06a9\u0672\u0631\u06cd \u0633\u06a9\u06cc\u0645\u0646 \u06c1\u0655\u0646\u065b\u0632 \u062a\u0644\u0627\u0634 \u062a\u06c1\u0655 \u062f\u0631\u06cc\u0627\u0641\u062a \u062e\u0672\u0637\u0631\u0655 \u0627\u06a9\u06be \u0648\u0646 \u0633\u0679\u0627\u067e \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u06d4 \u0631\u0620\u0648\u0672\u06cc\u062a\u06cc \u0633\u0631\u06a9\u0672\u0631 \u067e\u0648\u0631\u0679\u0644\u0646 \u0628\u0631\u0639\u06a9\u0633 \u0686\u06be \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0645\u0631\u06a9\u0632\u06cc \u062d\u06a9\u0648\u0645\u062a\u060c \u0631\u06cc\u0627\u0633\u062a\u06cc \u062d\u06a9\u0648\u0645\u062a\u0646 \u062a\u06c1\u0655 \u0645\u0631\u06a9\u0632\u06cc \u0632\u06cc\u0631 \u0627\u0646\u062a\u0638\u0627\u0645 \u0639\u0644\u0627\u0642\u0646 \u06c1\u0646\u065b\u0632 \u0633\u06a9\u06cc\u0645\u0646 \u0627\u06a9\u06c1\u0655 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0633 \u067e\u0620\u0679\u06be \u06cc\u06a9\u062c\u0627 \u06a9\u0631\u0627\u0646 \u062a\u06c1\u0655 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646 \u0648\u0627\u0644\u0620\u0646 \u0686\u06be \u067e\u0646\u0655\u0646\u06cd \u0627\u06c1\u0644\u06cc\u062a \u06a9\u0633 \u0628\u0646\u06cc\u0627\u062f\u0633 \u067e\u0620\u0679\u06be \u0645\u062a\u0639\u0644\u0642\u06c1 \u0633\u06a9\u06cc\u0645\u0646 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u0633 \u0645\u0646\u065b\u0632 \u0645\u062f\u062f \u06a9\u0631\u0627\u0646\u06d4",ques2:"\u0645\u06cc\u065a\u06cc\u06cc \u0633\u06a9\u06cc\u0645 \u06a9\u062a\u06be \u06a9\u0654\u0646\u06cd \u06a9\u0631 \u0639\u0627\u0645 \u0634\u06c1\u0631\u06cc\u0646 \u0645\u062f\u062f\u061f",ans2:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0686\u06be \u0634\u06c1\u0631\u06cc\u0646 \u0627\u06a9\u0633 \u062c\u0627\u06cc\u06c1 \u0645\u062a\u0639\u0644\u0642\u06c1\u0655 \u0633\u06a9\u06cc\u0645\u0646 \u06c1\u0646\u065b\u0632 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u0633 \u0642\u0672\u0628\u0644 \u0628\u0646\u0672\u0648\u062a\u06be \u062d\u06a9\u0648\u0645\u062a\u06cc \u0633\u06a9\u06cc\u0645\u0646 \u062a\u0627\u0645 \u0631\u0633\u0672\u0626\u06cc \u0622\u0633\u0627\u0646 \u0628\u0646\u0627\u0648\u0627\u0646\u060c \u0645\u062a\u0639\u062f\u062f \u0645\u062d\u06a9\u0645\u0672\u062a\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679\u0646 \u067e\u06cc\u0679\u06be \u06af\u0698\u06be\u0646\u0686 \u0636\u0631\u0648\u0631\u062a \u0686\u06be \u062e\u062a\u0645 \u06a9\u0631\u0627\u0646 \u06cc\u0627 \u067e\u0646\u0646\u06c1\u0655 \u0627\u06c1\u0644\u06cc\u062a\u0686 \u062c\u0627\u0646\u0686 \u06a9\u0631\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655 \u0633\u06a9\u06cc\u0645\u0646 \u06c1\u0646\u065b\u062f \u0648\u0633\u06cc\u0639 \u0631\u06c1\u0646\u0645\u0627 \u062e\u0637\u0648\u0637\u06a9 \u062c\u0627\u0626\u0632\u0655 \u0686\u06be \u06a9\u0631\u0627\u0646\u06d4",ques3:"\u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645 \u06a9\u062a\u06be \u06a9\u0654\u0646\u06cd \u0686\u06be \u06a9\u0672\u0645 \u06a9\u0631\u0627\u0646\u061f",ans3:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0686\u06be \u0627\u06a9\u06be \u0633\u0627\u062f\u0655 \u062a\u06c1\u0655 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646 \u0648\u0627\u0644\u0620\u0646 \u062e\u0672\u0637\u0631\u0655 \u0633\u06c1\u0644 \u062a\u0631\u065b\u0620\u0646 \u0645\u0631\u062d\u0644\u0646 \u067e\u0620\u0679\u06be \u0639\u0645\u0644 \u06a9\u0631\u0627\u0646 \u062a\u0627\u06a9\u06c1 \u0634\u06c1\u0631\u06cc\u0646 \u0633\u0631\u06a9\u0672\u0631\u06cd \u0633\u06a9\u06cc\u0645\u0646 \u06c1\u0646\u065b\u062f \u067e\u062a\u06c1 \u0644\u06af\u0627\u0648\u0646\u06c1\u0655 \u0645\u0646\u065b\u0632 \u0645\u062f\u062f \u06a9\u0654\u0631\u062a\u06be \u06cc\u0645\u0646 \u062e\u0672\u0637\u0631\u0655 \u062a\u0645 \u0627\u06c1\u0644 \u0686\u06be: \u0645\u0631\u062d\u0644\u06c1\u0655 1: \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646 \u0648\u0648\u0644 \u0686\u06be \u0628\u0646\u06cc\u0672\u062f\u06cc \u062a\u0641\u0635\u06cc\u0644\u0646 \u06cc\u062a\u06be \u06a9\u0654\u0646\u06cd \u0688\u06cc\u0645\u0648\u06af\u0631\u0627\u0641\u06a9\u060c \u0622\u0645\u062f\u0646\u06cc\u060c \u0633\u0645\u0672\u062c\u06cc \u0632\u0645\u0631\u0655 \u0648\u063a\u06cc\u0631\u06c1 \u062f\u0672\u062e\u0644 \u06a9\u0631\u0627\u0646\u06d4 \u0645\u0631\u062d\u0644\u06c1\u0655 2: \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u06c1\u0655 \u0622\u0645\u0655\u0698 \u0632\u0627\u0646\u065b\u06a9\u0672\u0631\u06cc \u06c1\u0646\u065b\u062f\u0633 \u0628\u0646\u06cc\u0627\u062f\u0633 \u067e\u06cc\u065a\u0679\u06be\u060c \u0686\u06be \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646 \u0648\u0672\u0644\u0633 \u062e\u0672\u0637\u0631\u0655 \u06c1\u062a\u06c1\u0655 \u0628\u0654\u062f \u0633\u0631\u06a9\u0672\u0631\u06cd \u0633\u06a9\u06cc\u0645\u0646 \u06c1\u0655\u0646\u065b\u062f\u06cd \u0645\u062a\u0639\u0644\u0642\u06c1 \u0633\u06a9\u06cc\u0645\u06c1\u0655 \u06c1\u0627\u0648\u0646\u06c1\u0655 \u06cc\u0648\u0627\u0646\u06d4 \u0645\u0631\u062d\u0644\u06c1 3: \u0635\u0627\u0631\u0641 \u06c1\u0620\u06a9\u06c1 \u0627\u06c1\u0644 \u0633\u06a9\u06cc\u0645\u0646 \u06c1\u0646\u065b\u062f\u0633 \u0641\u06c1\u0631\u0633\u062a\u0633 \u0645\u0646\u065b\u0632 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0654\u0631\u062a\u06be \u062a\u06c1\u0655 \u062a\u0641\u0635\u06cc\u0644\u06cc \u0639\u0644\u0645\u060c \u0639\u0627\u0645 \u0633\u0648\u0627\u0644\u0646\u060c \u062a\u06c1\u0655 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0633 \u0639\u0645\u0644\u0633 \u0633\u06ed\u062a\u06cd \u0648\u0642\u0641 \u0633\u06a9\u06cc\u0645\u0646 \u06c1\u0646\u065b\u062f\u0633 \u0635\u0641\u062d\u0633 \u067e\u0620\u0679\u06be \u0632\u06cc\u0627\u062f\u0655 \u0632\u0627\u0646\u065b\u06a9\u0672\u0631\u06cc \u062d\u0672\u0635\u0644 \u06a9\u0654\u0631\u062a\u06be \u062a\u06c1\u0655 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062f\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655 \u0645\u062a\u0639\u0644\u0642\u06c1 \u062f\u0631\u062e\u0648\u0627\u0633\u062a\u06a9 \u06cc\u0648 \u0622\u0631 \u0627\u06cc\u0644\u0633 \u067e\u0620\u0679\u06be \u06af\u0698\u06be\u062a\u06be\u06d4",ques4:"\u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0633 \u067e\u0620\u0679\u06be \u0635\u062d\u06cc\u062d \u0633\u06a9\u06cc\u0645 \u0632\u0627\u0646\u065b\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655 \u06a9\u06cc\u0627 \u0637\u0631\u06cc\u0642\u06c1\u0655 \u06a9\u0627\u0631 \u0686\u06be\u061f",ans4:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0633 \u067e\u0620\u0679\u06be \u0635\u062d\u06cc\u0656\u062d \u0633\u06a9\u06cc\u0645 \u0698\u06be\u0627\u0646\u065b\u0691\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655 \u06c1\u0620\u06a9\u0646 \u0634\u06c1\u0631\u06cc \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0686\u06c1 \u0633\u0631\u06a9\u0672\u0631 \u0648\u06cc\u0628 \u0633\u0627\u06cc\u0679\u06c1 \u067e\u0620\u0679\u06be \u06af\u0698\u06be\u062a\u06be \u0634\u0631\u0648\u0657\u0639 \u06a9\u0654\u0631\u062a\u06be\u06d4 \u06c1\u0648\u0645 \u067e\u06cc\u062c\u0633 \u067e\u0620\u0679\u06be \u0627\u06a9\u06c1 \u0644\u0679\u06c1 \u0645\u0644\u0620\u0648 \u062a\u0645\u0646 '\u0641\u0627\u0626\u0646\u0688 \u0633\u06a9\u06cc\u0645\u0632 \u0641\u0627\u0631 \u06cc\u0648' \u0641\u06cc\u0686\u0631\u060c \u06cc\u0633 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646 \u0648\u0627\u0644\u0620\u0646 \u067e\u0646\u0646 \u0688\u06cc\u0645\u0648\u06af\u0631\u0627\u0641\u06a9 \u0688\u06cc\u0679\u06cc\u0644\u060c \u06cc\u062a\u06be \u06a9\u0654\u0646\u06cd \u0632\u0646 \u0648\u0672\u0646\u065b\u0633\u06c1\u060c \u062c\u0646\u0633\u060c \u0622\u0645\u062f\u0646\u06cc \u06c1\u0646\u065b\u0632 \u0633\u0637\u062d\u060c \u0632\u0645\u0631\u0655 \u0648\u063a\u06cc\u0631\u06c1 \u062f\u0672\u062e\u0644 \u06a9\u0631\u0646\u06a9 \u0627\u062c\u0627\u0632\u062a \u0686\u06be \u062f\u0648\u0627\u0646\u06d4 \u0627\u06a9\u06c1 \u0644\u0679\u06c1 \u06cc\u06cc\u065a\u0644\u06c1 \u06cc\u0645 \u062a\u0641\u0635\u06cc\u0656\u0644 \u062c\u0645\u0639 \u06a9\u0631\u0646\u06c1\u0655 \u0686\u06be \u06cc\u0648\u0627\u0646\u060c \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u06a9\u0631 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646 \u0648\u0672\u0644\u0633 \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u06a9\u0633 \u0628\u0646\u06cc\u0627\u062f\u0633 \u067e\u0620\u0679\u06be \u0645\u062a\u0639\u0644\u0642\u06c1 \u0633\u06a9\u06cc\u0645\u0646 \u06c1\u0646\u065b\u0632 \u0641\u06c1\u0631\u0633\u062a \u0641\u0631\u0627\u06c1\u0645\u06d4",ques5:"\u06a9\u0646\u06c1 \u062e\u0627\u0635 \u0633\u06a9\u06cc\u0645 \u06a9\u0633 \u0628\u0627\u0631\u0633 \u0645\u0646\u065b\u0632 \u06a9\u06cc\u065b\u0627\u06c1 \u0632\u0627\u0646\u065b\u06a9\u0672\u0631\u06cc \u06c1\u0620\u06a9\u06c1\u0655 \u0645\u06d2\u065a \u067e\u0646\u0646\u0633 \u0633\u06a9\u06cc\u0645\u0633 \u067e\u0620\u0679\u06be \u0645\u0644\u062a\u06be",ans5:"\u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0686\u06be \u067e\u0631\u065b\u0620\u062a\u06be \u0633\u06a9\u06cc\u0645\u06c1\u0655 \u0645\u062a\u0639\u0644\u0642 \u062c\u0627\u0645\u0639 \u0632\u0627\u0646\u065b\u06a9\u0672\u0631\u06cc \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0627\u0646\u060c \u06cc\u062a\u06be \u0645\u0646\u065b\u0632 \u0627\u06c1\u0644\u06cc\u062a\u06a9 \u0645\u0639\u06cc\u0627\u0631\u060c \u067e\u06cc\u0634 \u06a9\u0631\u062f\u0655 \u0641\u0672\u0626\u062f\u0655\u060c \u062f\u0631\u062e\u0627\u0633\u062a\u06a9 \u0637\u0631\u06cc\u0642\u06c1\u0655 \u06a9\u0627\u0631\u060c \u062a\u06c1\u0655 \u0633\u06a9\u06cc\u0645\u06c1\u0655 \u06c1\u0646\u065b\u062f \u0641\u0672\u0626\u062f\u0655 \u062d\u0672\u0635\u0644 \u06a9\u0631\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655 \u0636\u0631\u0648\u0631\u06cc \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0634\u0672\u0645\u0644 \u0686\u06be\u06d4 \u0627\u062a\u06be \u0645\u0646\u065b\u0632 \u0686\u06be \u0633\u06a9\u06cc\u0645\u06c1\u0655 \u0633\u06ed\u062a\u06cd \u0645\u062a\u0639\u0644\u0642 \u0639\u0627\u0645 \u0633\u0648\u0627\u0644\u0646 \u06c1\u0646\u065b\u062f \u062c\u0648\u0627\u0628 \u062f\u06cc\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655 \u0627\u06a9\u06be \u0648\u0642\u0641 \u0627\u06a9\u062b\u0631 \u067e\u0648\u0686\u06be\u0646\u06c1\u0655 \u06cc\u0646\u06c1\u0655 \u0648\u0648\u0644 \u0633\u0648\u0627\u0644 (\u0627\u06cc\u0641 \u0627\u06d2 \u06a9\u06cc\u0648) \u0633\u06cc\u06a9\u0634\u0646 \u062a\u06c1 \u0634\u0672\u0645\u0644\u06d4",ques6:"\u06cc\u0645 \u0628\u0654\u0691\u06cd \u0632\u0645\u0631\u0655 \u06a9\u06cc\u065b\u0627\u06c1 \u0686\u06be \u06cc\u0645\u0646 \u062a\u062d\u062a \u0633\u06a9\u06cc\u0645\u06c1\u0655 \u0686\u06be\u06d2\u065a \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645\u0633 \u067e\u0620\u0679\u06be \u062f\u0654\u0633\u062a\u06cc\u0627\u0628",ans6:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0633 \u067e\u0620\u0679\u06be \u062f\u0654\u0633\u062a\u06cc\u0627\u0628 \u0633\u06a9\u06cc\u0645\u0646 \u0686\u06be \u0628\u0654\u0691\u0633 \u067e\u06cc\u0645\u0627\u0646\u0633 \u067e\u0620\u0679\u06be 15 \u0632\u0645\u0631\u0646 \u0645\u0646\u065b\u0632 \u062f\u0631\u062c\u06c1\u0655 \u0628\u0654\u0646\u065b\u062f\u06cc \u06a9\u0631\u0646\u06c1\u0655 \u0622\u0645\u0655\u0698 \u06cc\u0645 \u062a\u06c1\u0646\u065b\u062f\u0620\u0646 \u0641\u0672\u0626\u062f\u0646 \u06c1\u0646\u065b\u0632 \u0646\u0648\u0639\u06cc\u062a \u062a\u06c1\u0655 \u0679\u0627\u0631\u06af\u06cc\u0679 \u0628\u06cc\u0646\u06cc\u0641\u0634\u0631\u06cc \u06c1\u0655\u0646\u065b\u062f \u0628\u0646\u06cc\u0627\u062f\u0633 \u067e\u0620\u0679\u06be \u0686\u06be\u06d4 \u06cc\u0645\u0646 \u0632\u0645\u0631\u0646 \u0645\u0646\u065b\u0632 \u0686\u06be \u0632\u0631\u0627\u0639\u062a\u060c \u062f\u06cc\u06c1\u06cc \u062a\u06c1\u0655 \u0645\u0627\u062d\u0648\u0644\u06cc\u0627\u062a \u061b \u0628\u06cc\u0646\u06a9\u0646\u06af\u060c \u0645\u0672\u0644\u06cc \u062e\u062f\u0645\u0627\u062a \u062a\u06c1\u0655 \u0627\u0646\u0634\u0648\u0631\u0646\u0633 \u061b \u06a9\u0627\u0631\u0628\u0627\u0631 \u062a\u06c1\u0655 \u06a9\u0627\u0631\u0648\u0628\u0627\u0631 \u061b \u062a\u0639\u0644\u06cc\u0645 \u062a\u06c1\u0655 \u0639\u0644\u0645 \u061b \u0635\u062d\u062a \u062a\u06c1\u0655 \u062a\u0646\u062f\u0631\u0633\u062a\u06cc \u061b \u06c1\u0627\u0624\u0633\u0646\u06af \u062a\u06c1\u0655 \u067e\u0646\u0627\u06c1 \u06af\u0627\u06c1 \u061b \u0639\u0648\u0672\u0645\u06cc \u062d\u0641\u0627\u0638\u062a\u060c \u0642\u0627\u0646\u0648\u0646 \u062a\u06c1\u0655 \u0627\u0646\u0635\u0627\u0641 \u061b \u0633\u0627\u0626\u0646\u0633\u060c \u0622\u0626\u06cc \u0679\u06cc \u062a\u06c1\u0655 \u0645\u0648\u0627\u0635\u0644\u0627\u062a \u061b \u06c1\u0646\u0631 \u062a\u06c1\u0655 \u0631\u0648\u0632\u06af\u0627\u0631 \u061b \u0633\u0645\u0672\u062c\u06cc \u0628\u06c1\u0628\u0648\u062f \u062a\u06c1\u0655 \u0627\u062e\u062a\u06cc\u0627\u0631 \u061b \u06a9\u06be\u06cc\u0644 \u062a\u06c1\u0655 \u062b\u0642\u0627\u0641\u062a \u061b \u0646\u0642\u0644 \u0648 \u062d\u0645\u0644 \u062a\u06c1\u0655 \u0628\u0646\u06cc\u0627\u062f\u06cc \u0688\u06be\u0627\u0646\u0686\u06c1 \u061b \u0633\u0641\u0631 \u062a\u06c1\u0655 \u0633\u06cc\u0627\u062d\u062a \u061b \u0627\u0641\u0627\u062f\u06cc\u062a \u062a\u06c1\u0655 \u0635\u0641\u0627\u0626\u06cc \u0633\u062a\u06be\u0631\u0627\u0626\u06cc \u061b \u062a\u06c1\u0655 \u0632\u0646\u0627\u0646\u06c1\u0655 \u062a\u06c1\u0655 \u0628\u0686\u06c1\u0655 \u0634\u0672\u0645\u0644\u06d4",ques7:"\u06a9\u06cc\u065b\u0627\u06c1 \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0686\u06be \u0648\u0627\u0631\u06cc\u0627\u06c1\u0646 \u0632\u0628\u0627\u0646\u0646 \u0645\u0646\u065b\u0632 \u0645\u062f\u062f \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0627\u0646",ans7:"\u06c1\u0627\u060c \u0645\u0627\u06cc\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0686\u06be \u0648\u0646\u06a9\u06cc\u0646\u0633 \u0627\u0646\u06af\u0631\u06cc\u0632\u06cc \u06c1\u06cc\u062a\u06be 15 \u0632\u0628\u0627\u0646\u0646 \u0645\u0646\u065b\u0632 \u0645\u0648\u0627\u062f\u0633 \u0633\u067e\u0648\u0631\u0679 \u06a9\u0631\u0627\u0646\u06d4 \u0627\u0636\u0672\u0641\u06cc \u06c1\u0646\u062f\u0648\u0633\u062a\u0672\u0646\u06cc \u0632\u0628\u0627\u0646\u0646 \u062e\u0672\u0637\u0631\u0655 \u0622\u0633\u06c1\u0655 \u062c\u0644\u062f\u0655\u06cc\u06c1 \u0645\u062f\u062f \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u06c1\u0655\u06d4",ques8:"\u06a9\u06cc\u065b\u0627\u06c1 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0686\u06be \u0645\u0631\u06a9\u0632\u06cc \u062a\u06c1\u0655 \u0631\u06cc\u0627\u0633\u062a/\u0645\u0631\u06a9\u0632 \u0632\u06cc\u0631 \u0627\u0646\u062a\u0638\u0627\u0645 \u0639\u0644\u0627\u0642\u06c1\u0655 \u062f\u06c4\u0634\u0648\u0655\u0646\u06cc \u0633\u06a9\u06cc\u0645\u0646 \u06c1\u0646\u065b\u062f \u0645\u0638\u0672\u06c1\u0631\u0655 \u06a9\u0631\u0627\u0646",ans8:"\u06c1\u0627\u060c \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0686\u06be \u0648\u0646\u06a9\u06cc\u0646\u0633 4,700 \u06a9\u06be\u06c4\u062a\u06c1\u0655 \u0632\u06cc\u0627\u062f\u0655 \u0645\u0631\u06a9\u0632\u06cc \u062d\u06a9\u0648\u0657\u0645\u062a\u0646 \u062a\u06c1\u0655 \u0631\u06cc\u0627\u0633\u062a/\u0645\u0631\u06a9\u0632 \u0632\u06cc\u0631 \u0627\u0646\u062a\u0638\u0627\u0645 \u062d\u06a9\u0648\u0657\u0645\u062a\u0646 \u06c1\u0655\u0646\u065b\u0632\u0646 \u0633\u06a9\u06cc\u0645\u0646 \u062a\u0627\u0645 \u0631\u0633\u0672\u06cc\u06cc \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0627\u0646\u06d4 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0633 \u067e\u0620\u0679\u06be \u0631\u0648\u0632 \u0627\u0636\u0672\u0641\u06cc \u0633\u06a9\u06cc\u0645\u06c1\u0655 \u062c\u0672\u0631\u06cc\u06d4",ques9:"\u0628\u06c1\u0655 \u06c1\u06cc\u065a\u06a9\u06c1\u0655 \u0646\u06c1\u0655 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0633 \u067e\u0620\u0679\u06be \u06a9\u0627\u0646\u065b\u06c1\u06c1 \u062e\u0627\u0635 \u0633\u06a9\u06cc\u0645 \u0624\u0686\u06be\u062a\u06be\u06d4 \u0628\u06c1\u0655 \u06a9\u06cc\u065b\u0627\u06c1 \u06a9\u0631\u06cd",ans9:'\u0648\u0646\u06a9\u06cc\u0646\u0633 \u0686\u06be 4,700 \u06a9\u06be\u06c4\u062a\u06c1\u0655 \u0632\u06cc\u065b\u0627\u062f\u0655 \u0645\u0631\u06a9\u0632\u06cc \u062d\u06a9\u0648\u0657\u0645\u062a \u062a\u06c1\u0655 \u0631\u06cc\u0627\u0633\u062a/\u0645\u0631\u06a9\u0632 \u0632\u06cc\u0631 \u0627\u0646\u062a\u0638\u0627\u0645 \u062d\u06a9\u0648\u0657\u0645\u062a\u0655\u0686 \u0633\u06a9\u06cc\u0645\u06c1\u0655 \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0633 \u067e\u0620\u0679\u06be \u0634\u0672\u0645\u0644 \u06a9\u0631\u0646\u06c1\u0655 \u0622\u0645\u0655\u0698\u06d4 \u0628\u0627\u0642\u0672\u0639\u062f\u0655 \u067e\u0672\u0679\u06be\u06cd \u0686\u06be \u0627\u0636\u0672\u0641\u06cc \u0633\u06a9\u06cc\u0645\u06c1\u0655 \u0634\u0672\u0645\u0644 \u06cc\u0648\u0627\u0646 \u06a9\u0631\u0646\u06c1\u0655\u06d4 \u0634\u06c1\u0631\u06cc \u06c1\u0620\u06a9\u0646 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0633 \u067e\u0620\u0679\u06be \u062f\u0654\u0633\u062a\u06cc\u0627\u0628 "\u06af\u06cc\u0679 \u0627\u0646 \u0679\u0686" \u0633\u06cc\u06a9\u0634\u0646 \u06a9\u06c1 \u0630\u0654\u0631\u06cc\u0639\u06c1\u0655 \u06a9\u0646\u06c1 \u062a\u06c1 \u06af\u0645\u0634\u062f\u0655 \u0633\u06a9\u06cc\u0645\u06c1\u0655 \u0645\u062a\u0639\u0644\u0642 \u062a\u0641\u0635\u06cc\u0644\u0646 \u06cc\u0627 \u062a\u062c\u0648\u06cc\u0656\u0632\u0646 \u06c1\u0646\u065b\u062f \u0627\u0634\u062a\u0631\u0627\u06a9 \u06a9\u0654\u0631\u062a\u06be\u06d4',ques10:"\u0645\u06d2\u065a \u0648\u0686\u06be \u0645\u0631\u0627\u0679\u06be\u06cc \u0632\u0628\u0672\u0646\u06cd \u0645\u0646\u065b\u0632 \u0633\u06a9\u06cc\u0645\u0646 \u06c1\u0646\u065b\u062f\u0633 \u0645\u0648\u0627\u062f\u0633 \u0645\u0646\u065b\u0632 \u06a9\u06cc\u0646\u065b\u06c1\u06c1 \u063a\u0644\u0637\u06cc\u06c1\u0655\u06d4 \u0628\u06c1\u0655 \u06a9\u06cc\u065b\u0627\u06c1 \u06a9\u0631\u06cd",ans10:"\u0627\u06af\u0631 \u0645\u0646\u0635\u0648\u0657\u0628\u06c1\u0655 \u06a9\u0633 \u0645\u0648\u0627\u062f \u06a9\u0633 \u0645\u0631\u0672\u0679\u06be\u06c1 \u0648\u0631\u062c\u0646\u0633 \u0645\u0646\u065b\u0632 \u06a9\u0627\u0646\u065b\u06c1\u06c1 \u062a\u0636\u0627\u062f \u0646\u0638\u0631 \u0686\u06be \u06cc\u0648\u0627\u0646\u060c \u0634\u06c1\u0631\u06cc\u0646 \u0686\u06be \u0645\u0634\u0648\u0631\u0655 \u062f\u0646\u06c1\u0655 \u06cc\u0648\u0627\u0646 \u0632 \u062a\u0645 \u06af\u0698\u06be\u0646 \u0648\u0636\u0627\u062d\u062a \u0628\u0627\u067e\u062a\u06be \u0627\u0646\u06af\u0631\u06cc\u0632\u06cc \u0648\u0631\u062c\u0646\u0633 \u06a9\u0646 \u0631\u062c\u0648\u0639 \u06a9\u0631\u0646\u06d4 \u0627\u06af\u0631 \u0645\u0633\u0644\u06c1\u0655 \u062c\u0672\u0631\u06cc \u0631\u0648\u0632\u0655\u060c \u062a\u06cc\u065a\u0644\u06c1 \u06c1\u0620\u06a9\u06c1 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0648\u0632\u0627\u0631\u062a \u06cc\u0627 \u0645\u062d\u06a9\u0645\u06a9 \u0633\u0631\u06a9\u0672\u0631 \u067e\u0648\u0631\u0679\u0644\u0633 \u0633\u0627\u0631\u0648\u06cc \u06a9\u06be\u06c4\u062a\u06c1\u0655 \u062f\u0631\u0633\u062a \u062a\u06c1\u0655 \u062a\u0627\u0632\u06c1 \u062a\u0631\u06cc\u0646 \u0632\u0627\u0646\u065b\u06a9\u0672\u0631\u06cc \u062e\u0672\u0637\u0631\u0655 \u062d\u0648\u0627\u0644\u06c1\u0655 \u062f\u0646\u06c1\u0655 \u06cc\u062a\u06be\u06d4 \u0627\u0645\u06c1 \u0639\u0644\u0627\u0648\u0655 \u06c1\u06cc\u065a\u06a9\u06c1 \u06cc\u06c1 \u0645\u0633\u0644\u06c1\u0655 support-myscheme[at]digitalindia[dot]gov[dot]in \u06cc\u0633 \u067e\u0620\u0679\u06be \u0627\u06cc \u0645\u06cc\u0644 \u0633\u0648\u0632\u062a\u06be \u0631\u067e\u0648\u0631\u0679 \u06a9\u0631\u0646\u06c1\u0655 \u06cc\u062a\u06be\u06d4",ques11:"\u0628\u06c1\u0655 \u0686\u06be\u0633 \u06cc\u0698\u06be\u0627\u0646 \u062a\u0645\u0646 \u0633\u06a9\u06cc\u0645\u0646 \u06c1\u0646\u065b\u0632 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0655\u0646 \u06cc\u0645\u0646 \u062a\u062d\u062a \u0637\u0672\u0644\u0628\u06c1 \u0639\u0644\u0645\u0648 \u0633\u06a9\u0627\u0644\u0631\u0634\u067e \u0686\u06be \u062f\u0646\u06c1\u0655 \u06cc\u0648\u0627\u0646\u06d4 \u06a9\u06cc\u065b\u0627\u06c1 \u06cc\u06c1 \u0686\u06be \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645 \u0630\u0654\u0631\u06cc\u0639\u06c1\u0655 \u0645\u0645\u06a9\u0646",ans11:"\u06c1\u0627\u060c \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0686\u06be \u06a9\u0644\u06cc\u062f\u06cc \u0627\u0644\u0641\u0627\u0638\u0633 \u067e\u06cc\u0679\u06be \u0645\u0628\u0646\u06cc \u062a\u0644\u0627\u0634\u0655\u0686 \u062e\u0635\u0648\u0635\u06cc\u062a \u067e\u06cc\u0634 \u06a9\u0631\u0627\u0646 \u06cc\u0633 \u0634\u06c1\u0631\u06cc\u0646 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062f\u0655 \u0641\u0672\u0626\u062f\u0646 \u06c1\u0646\u065b\u0632 \u0642\u0633\u0645 \u062a\u06c1\u0655 \u062d\u062f \u06a9\u0633 \u0628\u0646\u06cc\u0627\u062f\u0633 \u067e\u06cc\u0679\u06be \u0633\u06a9\u06cc\u0645\u0646 \u06c1\u0646\u065b\u0632 \u0622\u0633\u0627\u0646\u06cc \u0633\u0627\u0646 \u062a\u0644\u0627\u0634\u060c \u062a\u0644\u0627\u0634 \u062a\u06c1\u0655 \u0634\u0646\u0627\u062e\u062a \u06a9\u0631\u0646\u0633 \u0642\u0672\u0628\u0644 \u0628\u0646\u0627\u0648\u0627\u0646 \u0686\u06be\u060c \u0628\u0634\u0645\u0648\u0644 \u0637\u0672\u0644\u0628\u06c1 \u0639\u0644\u0645\u0648 \u062e\u0672\u0637\u0631\u0655 \u0633\u06a9\u0627\u0644\u0631\u0634\u067e\u06d4",ques12:"\u0628\u06c1\u0655 \u0686\u06be\u0633 \u06cc\u0698\u06be\u0627\u0646 \u0623\u06a9\u0633 \u062e\u0627\u0635 \u0633\u06a9\u06cc\u0645\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062f\u06cc\u0646 \u062a\u06c1\u0655 \u0628\u06c1\u0655 \u0686\u06be\u0633 \u06cc\u0698\u06be\u0627\u0646 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062f\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655 \u0636\u0631\u0648\u0631\u06cc \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0632\u0627\u0646\u065b\u0646\u06c1\u0655\u06d4 \u06a9\u06cc\u065b\u0627\u06c1 \u0628\u06c1\u0655 \u06c1\u0620\u06a9\u0627 \u06cc\u06c1 \u0632\u0627\u0646\u065b\u06a9\u0672\u0631\u06cc \u067e\u0646\u0646\u06c1 \u0633\u06a9\u06cc\u0645\u0633 \u067e\u0620\u0679\u06be \u062d\u0672\u0635\u0644 \u06a9\u0654\u0631\u062a\u06be",ans12:"\u06c1\u0627\u060c \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0686\u06be \u067e\u0631\u065b\u0620\u062a\u06be \u0633\u06a9\u06cc\u0645\u0633 \u0645\u0646\u065b\u0632 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062f\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655 \u0636\u0631\u0648\u0631\u06cc \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0646 \u06c1\u0646\u065b\u0632 \u067e\u0648\u0657\u0631\u0655 \u0641\u06c1\u0631\u0633\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0627\u0646\u060c \u06cc\u06cc\u065a\u0645\u06c1 \u0633\u06ed\u062a\u06cd \u0634\u06c1\u0631\u06cc \u0622\u0633\u0627\u0646\u06cc \u0633\u0627\u0646 \u062a\u06cc\u0627\u0631 \u062a\u06c1\u0655 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062f\u062a\u06be \u0686\u06be\u06d4",ques13:"\u06a9\u06cc\u065b\u0627\u06c1 \u0628\u06c1\u0655 \u06c1\u0620\u06a9\u0627 \u067e\u0646\u0646\u06c1 \u0633\u06a9\u06cc\u0645 \u06a9\u06c1 \u0630\u0654\u0631\u06cc\u0639\u06c1\u0655 \u0633\u06a9\u06cc\u0645\u0646 \u0628\u0627\u067e\u062a\u06be \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062f\u062a\u06be",ans13:"\u0648\u0646\u06a9\u06cc\u0646\u0633 \u0686\u06be \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0635\u0627\u0631\u0641\u06cc\u0646\u0646 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0648\u0632\u0627\u0631\u062a \u06cc\u0627 \u0645\u062d\u06a9\u0645\u06c1\u0655 \u06a9\u06c1 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0633\u06a9\u06cc\u0645 \u0627\u06cc\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u067e\u06cc\u062c\u0633 \u067e\u06cc\u0679\u06be \u0631\u06cc \u0688\u0627\u0626\u0631\u06cc\u06a9\u0679 \u06a9\u0631\u0627\u0646\u06d4 \u06cc\u0646\u06c1\u0655 \u0648\u0627\u0644\u0620\u0646 \u0645\u0631\u062d\u0644\u0646 \u0645\u0646\u065b\u0632 \u0686\u06be \u06cc\u06c1 \u062a\u0635\u0648\u0631 \u06a9\u0631\u0646\u06c1\u0655 \u0622\u0645\u062a \u0632 \u0634\u06c1\u0631\u06cc \u06c1\u06cc\u06a9\u0646 \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0648\u0631\u0679\u0644/\u0627\u0645\u0646\u06af \u0627\u06cc\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u06a9\u06c1 \u0630\u0654\u0631\u06cc\u0639\u06c1\u0655 \u0633\u06a9\u06cc\u0645\u0646 \u062e\u0672\u0637\u0631\u0655 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062f\u062a\u06be\u06d4",ques14:'\u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646 \u0648\u0672\u0644\u0633 \u062e\u0672\u0637\u0631\u0655 \u0628\u06c1\u062a\u0631\u06cc\u0646 \u0633\u06a9\u06cc\u0645\u0646 \u06c1\u0646\u065b\u062f \u067e\u062a\u06c1 \u0644\u06af\u0627\u0648\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655\u060c \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645 \u06a9\u0633 "\u067e\u0631\u0633\u0646\u0644\u0627\u0626\u0632\u0688 \u0633\u0631\u0686" \u0641\u06cc\u0686\u0631\u0633 \u0645\u0646\u065b\u0632 \u06a9\u06cc\u0627 \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u0655\u0686 \u0636\u0631\u0648\u0631\u062a \u0686\u06be\u061f',ans14:'\u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645\u06a9 "\u067e\u0631\u0633\u0646\u0644\u0627\u0626\u0632\u0688 \u0633\u0631\u0686" \u0641\u06cc\u0686\u0631 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655 \u0686\u06be \u0635\u0627\u0631\u0641\u06cc\u0646\u0646 \u0628\u0646\u06cc\u0627\u062f\u06cc \u067e\u0631\u0648\u0641\u0627\u0626\u0644\u0655\u0686 \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u0655\u0686 \u0636\u0654\u0631\u0648\u0657\u0631\u062a \u06cc\u062a\u06be \u06a9\u0654\u0646\u06c1 \u0632\u0646 \u062c\u0646\u0633\u060c \u0648\u0672\u0646\u065b\u0633\u06c1\u060c \u0627\u0632\u062f\u0648\u0627\u062c\u06cc \u062d\u06cc\u062b\u06cc\u062a\u060c \u0631\u06cc\u0627\u0633\u062a\u060c \u0631\u0648\u0632\u0646\u0655\u0686 \u062c\u0627\u06d2 (\u0634\u0654\u06c1\u0631\u06cc \u06cc\u0627 \u06af\u0623\u0645\u06cc)\u060c \u0633\u0645\u0672\u062c\u06cc \u0632\u0645\u0631\u0655\u060c \u0645\u0639\u0630\u0648\u0631\u06cc \u06c1\u0646\u065b\u0632 \u062d\u06cc\u062b\u06cc\u062a\u060c \u0627\u0642\u0644\u06cc\u062a\u06cc \u062d\u06cc\u062b\u06cc\u062a\u060c \u0631\u0648\u0632\u06af\u0627\u0631\u0655\u0686 \u062d\u06cc\u062b\u06cc\u062a\u060c \u062a\u06c1\u0655 \u0628\u0627\u0642\u06cc \u0645\u062a\u0639\u0644\u0642\u06c1 \u0632\u0627\u0646\u065b\u06a9\u0672\u0631\u06cc\u06d4 \u06cc\u06c1\u0655 \u0686\u06be \u0635\u0627\u0631\u0641 \u06a9\u0633 \u067e\u0631\u0648\u0641\u0627\u0626\u0644\u0633 \u0633\u06ed\u062a\u06cd \u0633\u0627\u0631\u0648\u06cc \u06a9\u06be\u0648\u062a\u06c1\u0655 \u0632\u06cc\u0627\u062f\u0655 \u0645\u062a\u0639\u0644\u0642\u06c1\u0655 \u0633\u06a9\u06cc\u0645\u0646 \u06c1\u0646\u065b\u0632 \u0634\u0646\u0627\u062e\u062a \u06a9\u0631\u0646\u0633 \u0645\u0646\u065b\u0632 \u0645\u062f\u062f \u06a9\u0631\u0627\u0646\u06d4',ques15:'"\u0686\u06cc\u06a9 \u0627\u06cc\u0644\u06cc\u062c\u06cc\u0628\u0644\u0679\u06cc \u0633\u0648\u0627\u0644 \u0646\u0627\u0645\u06c1\u0655" \u062e\u0635\u0648\u0635\u06cc\u062a \u06a9\u06cc\u0627 \u0686\u06be\u061f',ans15:'"\u0686\u06cc\u06a9 \u0627\u06cc\u0644\u06cc\u062c\u06cc\u0628\u0644\u0679\u06cc \u0633\u0648\u0627\u0644\u0646\u0627\u0645\u06c1" \u062e\u0635\u0648\u0635\u06cc\u062a \u0686\u06be \u0633\u06a9\u06cc\u0645\u06a9 \u0645\u062e\u0635\u0648\u0635 \u0627\u06c1\u0644\u06cc\u062a \u06a9\u0633 \u0645\u0639\u06cc\u0627\u0631\u0633 \u067e\u06cc\u0679\u06be \u062a\u0648\u062c\u06c1 \u0645\u0631\u06a9\u0648\u0632 \u06a9\u0631\u0627\u0646 \u062a\u06c1\u0655 \u0635\u0627\u0631\u0641\u06cc\u0646\u0646 \u0686\u06be \u0622\u0633\u0627\u0646 \u06c1\u0627\u06ba/\u0646\u06c1 \u067e\u06cc\u0679\u06be \u0645\u0628\u0646\u06cc \u0633\u0648\u0627\u0644\u0646\u0627\u0645\u06c1 \u06a9\u06c1 \u0630\u0631\u06cc\u0639 \u067e\u0646\u0646 \u0627\u06c1\u0644\u06cc\u062a\u0686 \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u0646\u0633 \u0642\u0672\u0628\u0644 \u0628\u0646\u0627\u0648\u0627\u0646\u06d4 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062f\u0655 \u062c\u0648\u0627\u0628\u0646 \u06c1\u0646\u062f\u0633 \u0628\u0646\u06cc\u0627\u062f\u0633 \u067e\u06cc\u0679\u06be\u060c \u0635\u0627\u0631\u0641 \u06c1\u06cc\u06a9\u0646 \u062c\u0644\u062f\u06cc \u0627\u0646\u062f\u0627\u0632\u0655 \u0644\u06af\u0672\u0648\u062a\u06be \u0632 \u06a9\u06cc\u0627 \u062a\u0645 \u0686\u06be\u0627 \u06a9\u0646\u06c1 \u062e\u0627\u0635 \u0633\u06a9\u06cc\u0645\u06a9 \u0627\u06c1\u0644\u06d4',ques16:"\u06a9\u06cc\u065b\u0627\u06c1 \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645\u0633 \u0686\u06be\u06d2\u065a \u0686\u06cc\u0679 \u0628\u0648\u0679\u0655\u0686 \u0633\u06c1\u0648\u0644\u062a\u060c \u062a\u06c1\u0655 \u06cc\u06c1 \u06a9\u062a\u06be \u06a9\u0654\u0646\u06cd \u0686\u06be \u0634\u06c1\u0631\u06cc\u0646 \u0645\u062f\u062f \u06a9\u0631\u0627\u0646\u061f",ans16:"\u06c1\u0627\u060c \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645\u0646 \u0686\u06be \u0634\u06c1\u0631\u06cc\u0646 \u0645\u062a\u0639\u0644\u0642\u06c1\u0655 \u0633\u0631\u06a9\u0672\u0631\u06cd \u0633\u06a9\u06cc\u0645\u0646 \u06c1\u0646\u065b\u062f \u062f\u0631\u06cc\u0627\u0641\u062a \u06a9\u0631\u0646\u0633 \u0645\u0646\u065b\u0632 \u0645\u062f\u062f \u06a9\u0631\u0646\u06c1\u0655 \u062e\u0672\u0637\u0631\u0655 \u0627\u06a9\u06be \u0622\u0648\u0627\u0632 \u0633\u06ed\u062a\u06cd \u0641\u0639\u0627\u0644\u060c \u06a9\u062b\u06cc\u0631 \u0632\u0628\u0672\u0646\u06cc \u0627\u06d2 \u0622\u066e\u0654\u06cc \u0637\u0627\u0642\u062a \u0648\u0648\u0644 \u0686\u06cc\u0679 \u0628\u0648\u0679 \u062a\u0639\u06cc\u0646\u0627\u062a \u06a9\u0648\u065a\u0631\u0645\u062a\u06d4 \u0686\u06cc\u0679 \u0628\u0648\u0679 \u0686\u06be \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646 \u0648\u0627\u0644\u0620\u0646 \u06c1\u0646\u065b\u062f\u0620\u0646 \u0633\u0648\u0627\u0644\u0646 \u06c1\u0646\u065b\u062f \u0630\u0672\u062a\u06cc \u062a\u06c1\u0655 \u0641\u0648\u0631\u06cc \u062c\u0648\u0627\u0628 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0627\u0646\u060c \u06a9\u062a\u06be \u0628\u0627\u062a\u06be \u06c1\u0655\u0646\u065b\u062f \u0630\u0654\u0631\u06cc\u0639\u06c1\u0655 \u0645\u0646\u0635\u0648\u0657\u0628\u0646 \u06c1\u0655\u0646\u065b\u0632 \u062f\u0631\u06cc\u0627\u0641\u062a \u0633\u06c1\u0644 \u0628\u0646\u0627\u0648\u0627\u0646\u060c \u062a\u06c1\u0655 \u0627\u06a9\u06be \u062f\u0644\u06a9\u0634 \u062a\u06c1\u0655 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646 \u0648\u0627\u0644\u0620\u0646 \u062e\u0672\u0637\u0631\u0655 \u062f\u0648\u0633\u062a\u0627\u0646\u06c1\u0655 \u062a\u062c\u0631\u0657\u0628\u06c1\u0655 \u067e\u06cc\u0634 \u06a9\u0654\u0631\u062a\u06be \u0633\u0631\u06a9\u0672\u0631\u06cd \u0634\u06c1\u0631\u06cc\u0646 \u062f\u0631\u0645\u06cc\u0627\u0646 \u06a9\u062a\u06be \u0628\u0627\u062a\u06be \u0628\u0691\u0627\u0648\u0627\u0646\u06d4",ques17:"\u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645\u0633 \u067e\u0620\u0679\u06be \u06a9\u06cc\u065b\u0627\u06c1 \u0686\u06be \u0627\u06d2 \u0622\u066e\u0654\u06cc \u0686\u06cc\u0679 \u0628\u0648\u0679\u06a9 \u0627\u06c1\u0645 \u0641\u06cc\u0686\u0631",ans17:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0627\u06d2 \u0622\u066e\u0654\u06cc \u0686\u06cc\u0679 \u0628\u0648\u0679 \u0686\u06be \u0622\u0648\u0627\u0632 \u062a\u06c1\u0655 \u0645\u062a\u0646\u0633 \u067e\u0620\u0679\u06be \u0645\u0628\u0646\u06cc \u06a9\u062a\u06be \u0628\u0627\u062a\u06be\u060c \u06c1\u0646\u062f\u06cc \u062a\u06c1\u0655 \u0627\u0646\u06af\u0631\u06cc\u0632\u06cc \u0645\u0646\u065b\u0632 \u062f\u0648\u065b\u0646 \u0632\u0628\u0627\u0646\u0646 \u0645\u0646\u065b\u0632 \u0645\u062f\u062f\u060c \u0633\u06cc\u0627\u0642 \u0648 \u0633\u0628\u0627\u0642\u0633 \u0633\u06ed\u062a\u06cd \u0628\u0627\u062e\u0628\u0631 \u06a9\u062a\u06be \u0628\u0627\u062a\u06be\u060c \u0633\u06cc\u0634\u0646\u0633 \u067e\u0620\u0679\u06be \u0645\u0628\u0646\u06cc \u0686\u06cc\u0679 \u06c1\u0633\u0679\u0631\u06cc\u060c \u062a\u06c1\u0655 \u062c\u0648\u0627\u0628\u0646 \u06a9\u0627\u067e\u06cc \u062a\u06c1\u0655 \u0634\u06cc\u0626\u0631 \u06a9\u0631\u0646\u06a9 \u0622\u067e\u0634\u0646 \u067e\u06cc\u0634 \u06a9\u0631\u0627\u0646\u060c \u0627\u06a9\u06be \u06c1\u0645\u0648\u0627\u0631 \u062a\u06c1\u0655 \u0635\u0627\u0631\u0641 \u062f\u0648\u0633\u062a \u062a\u062c\u0631\u0628\u06c1\u0655 \u06cc\u0642\u06cc\u0646\u06cc \u0628\u0646\u0627\u0648\u0627\u0646\u06d4",ques18:"\u0628\u06c1\u0655 \u06a9\u062a\u06be \u06a9\u0654\u0646\u06cd \u06c1\u0620\u06a9\u06c1\u0655 \u0633\u06a9\u06cc\u0645\u0646 \u06c1\u0646\u065b\u062f\u0633 \u0645\u0648\u0627\u062f\u0633 \u0645\u062a\u0639\u0644\u0642 \u067e\u0646\u0646 \u0631\u062f\u0639\u0645\u0644 \u062f\u062a\u06be\u061f",ans18:'\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0686\u06be \u067e\u0631\u065b\u0620\u062a\u06be \u0633\u06a9\u06cc\u0645 \u067e\u06cc\u062c \u06a9\u0633 \u0672\u062e\u0655\u0631\u0633 \u062d\u0635\u0633 \u0645\u0646\u065b\u0632 \u0627\u06a9\u06be "\u06a9\u06cc\u0627 \u06cc\u06c1 \u0645\u062f\u062f\u06af\u0627\u0631 \u0627\u0648\u0633\u061f" \u0641\u06cc\u0688 \u0628\u06cc\u06a9 \u0633\u06cc\u06a9\u0634\u0646 \u067e\u06cc\u0634 \u06a9\u0631\u0627\u0646\u060c \u06cc\u0633 \u0635\u0627\u0631\u0641\u06cc\u0646\u0646 \u0645\u0648\u0627\u062f\u0633 1 \u067e\u06cc\u065a\u0679\u06be\u0655 5 \u0633\u062a\u0627\u0631\u0646 \u062a\u0627\u0645 \u0631\u06cc\u0679\u0646\u06af \u062f\u0646\u06a9 \u062a\u06c1\u0655 \u067e\u0646\u0646 \u062a\u062c\u0631\u0628\u06c1\u0655\u060c \u0645\u0634\u0648\u0631\u0655 \u06cc\u0627 \u0641\u06cc\u0688 \u0628\u06cc\u06a9 \u0634\u06cc\u0626\u0631 \u06a9\u0631\u0646\u06a9 \u0627\u062c\u0627\u0632\u062a \u0686\u06be \u062f\u0648\u0627\u0646\u06d4 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646 \u0648\u0672\u0644\u06c1 \u06c1\u0620\u06a9\u0646 \u0627\u06cc \u0645\u06cc\u0644 \u0630\u0654\u0631\u06cc\u0639\u06c1\u0655 support-myscheme@digitalindia.gov.in \u067e\u0620\u0679\u06be \u062a\u0641\u0635\u06cc\u0644\u06cc \u0631\u062f\u0639\u0645\u0644 \u062a\u06c1 \u0633\u0648\u0632\u062a\u06be\u060c \u06cc\u06cc\u065a\u0645\u06c1 \u0633\u06ed\u062a\u06c1 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0655\u0686 \u0644\u06af\u0627\u062a\u0627\u0631 \u0628\u06c1\u062a\u0631\u06cc \u062a\u06c1\u0655 \u0631\u062f\u0639\u0645\u0644 \u06cc\u0642\u06cc\u0646\u06cc \u0628\u0646\u0627\u0648\u0646\u0633 \u0645\u0646\u065b\u0632 \u0645\u062f\u062f \u0686\u06be \u06af\u0698\u06be\u0627\u0646\u06d4',ques19:"\u06a9\u0627\u0646\u065b\u06c1\u06c1 \u06cc\u0648\u0632\u0631 \u06a9\u062a\u06be \u06a9\u0654\u0646\u06cd \u06c1\u0620\u06a9\u06c1\u0655 \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645\u0633 \u067e\u0620\u0679\u06be \u0633\u0627\u0626\u0646 \u0627\u067e \u06a9\u0654\u0631\u062a\u06be \u06cc\u0627 \u0633\u0627\u0626\u0646 \u0627\u0646 \u06a9\u0654\u0631\u062a\u06be\u061f",ans19:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0686\u06be \u0645\u06cc\u0631\u06cc \u067e\u06c1\u0644\u0627\u0646 (\u0646\u06cc\u0634\u0646\u0644 \u0633\u0646\u06af\u0644 \u0633\u0627\u0626\u0646 \u0622\u0646) \u0633\u06ed\u062a\u06cd \u0645\u0631\u0628\u0648\u0637\u060c \u06cc\u0645\u06c1\u0655 \u0633\u06ed\u062a\u06cd \u0635\u0627\u0631\u0641 \u0686\u06be \u067e\u0646\u0646 \u0645\u06cc\u0631\u06cc \u067e\u06c1\u0644\u0627\u0646 \u0627\u0633\u0646\u0627\u062f \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0654\u0631\u062a\u06be \u0633\u0627\u0626\u0646 \u0627\u067e \u06cc\u0627 \u0633\u0627\u0626\u0646 \u0627\u0646 \u06a9\u0631\u0646\u0633 \u0642\u0672\u0628\u0644 \u0628\u0646\u0627\u0648\u0627\u0646\u06d4 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646 \u0648\u0672\u0644\u06c1 \u06c1\u0620\u06a9\u0646 \u0633\u0627\u0626\u0646 \u0627\u0646 \u06a9\u0631\u0646\u06c1\u0655 \u0628\u063a\u0672\u0631 \u0633\u0631\u06a9\u0672\u0631 \u0633\u06a9\u06cc\u0645\u06c1\u0655 \u0624\u0686\u06be\u062a\u06be \u062a\u06c1\u0655 \u062a\u0644\u0627\u0634 \u06a9\u0654\u0631\u062a\u06be\u06d4 \u0648\u0648\u0646\u06c1 \u06af\u0648\u0658\u060c \u0633\u0627\u0626\u0646 \u0627\u0646 \u0686\u06be \u0635\u0627\u0631\u0641\u06cc\u0646\u0646 \u067e\u0646\u0646 \u067e\u0631\u0648\u0641\u0627\u0626\u0644\u060c \u0628\u06a9 \u0645\u0627\u0631\u06a9 \u0633\u06a9\u06cc\u0645\u0646\u060c \u062a\u06c1\u0655 \u062a\u06c1\u0646\u062f\u06cc\u0646 \u0645\u062d\u0641\u0648\u0638 \u06a9\u0631\u062f\u0655 \u062a\u0641\u0635\u06cc\u0644\u0646 \u06c1\u0646\u062f\u0633 \u0628\u0646\u06cc\u0627\u062f\u0633 \u067e\u06cc\u0679\u06be \u0630\u0627\u062a\u06cc \u0633\u0641\u0627\u0631\u0634\u0627\u062a \u062d\u0672\u0635\u0644 \u06a9\u0631\u0646\u06a9 \u0627\u062c\u0627\u0632\u062a \u062f\u0648\u0627\u0646\u06d4",ques20:"\u0628\u06c1\u0655 \u06a9\u062a\u06be \u06a9\u0654\u0646\u06cd \u06c1\u0620\u06a9\u06c1\u0655 \u0645\u0627\u0626\u06cc \u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0633 \u067e\u0620\u0679\u06be \u0633\u06a9\u06cc\u0645 \u062a\u0644\u0627\u0634 \u06a9\u0654\u0631\u062a\u06be",ans20:"\u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u067e\u0644\u06cc\