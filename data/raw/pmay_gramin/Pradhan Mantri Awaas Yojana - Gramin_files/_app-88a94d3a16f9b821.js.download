\u062a\u06cd \u0642\u0637\u0639 \u0646\u0638\u0631 \u0686\u06be \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0627\u06cc\u067e \u062a\u0645\u0627\u0645 \u0635\u0627\u0631\u0641\u06cc\u0646\u0646 \u062a\u0627\u0645 \u0631\u0633\u0672\u0626\u06cc \u062d\u0672\u0635\u0644\u06d4 \u06cc\u06c1\u0655 \u0686\u06be \u0627\u06a9\u0633 \u0645\u0642\u0635\u062f\u0633 \u0633\u06ed\u062a\u06cd \u0628\u0646\u0627\u0648\u0646\u06c1\u0655 \u0622\u0645\u062a\u060c \u062a\u0627\u06a9\u06c1 \u067e\u0646\u0646\u06cc\u0646 \u0632\u0627\u0626\u0631\u06cc\u0646\u0646 \u0632\u06cc\u0627\u062f\u0655 \u06a9\u06be\u0648\u062a\u06c1\u0655 \u0632\u06cc\u0627\u062f\u0655 \u0631\u0633\u0672\u0626\u06cc \u062a\u06c1\u0655 \u0627\u0633\u062a\u0639\u0645\u0627\u0644\u0686 \u0627\u06c1\u0644\u06cc\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u06c1\u0655\u06d4 \u0646\u062a\u06cc\u062c\u0633 \u0645\u0646\u065b\u0632 \u0686\u06be \u06cc\u06c1\u0655 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0645\u062e\u062a\u0644\u0641 \u0622\u0644\u0627\u062a\u0646 \u06cc\u06cc\u062a\u06be \u06a9\u06cc\u065b\u0646 \u0632\u0646 \u0688\u06cc\u0633\u06a9 \u0679\u0627\u067e/\u0644\u06cc\u067e \u0679\u0627\u067e \u06a9\u0645\u067e\u06cc\u0648\u0679\u0631\u0632\u060c \u0648\u06cc\u0628 \u0633\u06ed\u062a\u06cd \u0641\u0639\u0627\u0644 \u0645\u0648\u0628\u0627\u0626\u0644 \u0688\u06cc\u0648\u0627\u0626\u0633\u0632 \u0648\u063a\u06cc\u0631\u06c1 \u0633\u06ed\u062a\u06cd \u06c1\u0627\u0648\u0646\u06c1\u0655 \u06cc\u0648\u0627\u0646\u06d4 </p> <p> \u0623\u0633\u06cd \u0686\u06be \u06cc\u06c1\u0655 \u06cc\u0642\u06cc\u0646\u06cc \u0628\u0646\u0627\u0648\u0646\u06c1\u0655 \u062e\u0627\u0637\u0631\u0655 \u0628\u06c1\u062a\u0631\u06cc\u0646 \u06a9\u0648\u0634\u0634\u06c1\u0655 \u06a9\u0631\u0645\u0698 \u06a9\u06c1 \u0627\u062a\u06be \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0633 \u067e\u06cc\u0679\u06be \u0686\u06be \u062a\u0645\u0627\u0645 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u0639\u0630\u0648\u0631 \u0644\u0648\u06a9\u0646 \u062a\u0627\u0645 \u0631\u0633\u0672\u0626\u06cc\u06d4 \u0645\u062b\u0644\u0646\u060c \u0628\u0635\u0631\u06cc \u0645\u0639\u0630\u0648\u0631\u0633 \u0633\u06ed\u062a\u06cd \u062f\u0648\u0686\u0627\u0631 \u0635\u0627\u0631\u0641 \u06c1\u06cc\u065b\u06a9\u06c1\u0655 \u0645\u0639\u0627\u0648\u0646 \u0679\u06cc\u06a9\u0646\u0627\u0644\u0648\u062c\u06cc\u0632\u060c \u06cc\u06cc\u062a\u06be \u06a9\u06cc\u065b\u0646 \u0633\u06a9\u0631\u06cc\u0646 \u0631\u06cc\u0688\u0631\u0632 \u062a\u06c1\u0655 \u0633\u06a9\u0631\u06cc\u0646 \u0645\u06cc\u06af\u0646\u0641\u0627\u0626\u0631\u0646 \u06c1\u0646\u065b\u062f \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06be \u0627\u062a\u06be \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0633 \u062a\u0627\u0645 \u0631\u0633\u0627\u0626\u06cc \u062d\u0672\u0635\u0644 \u06a9\u0631\u062a\u06be\u06d4 </p> <p> \u0627\u0633\u06c1 \u062a\u06c1\u0655 \u0686\u06be \u0645\u0642\u0635\u062f \u0645\u0639\u06cc\u0627\u0631\u0686 \u062a\u0639\u0645\u06cc\u0644 \u06a9\u0631\u0646 \u062a\u06c1\u0655 \u0627\u0635\u0648\u0644\u0646 \u06c1\u0646\u065b\u0632 \u067e\u06cc\u0631\u0648\u06cc \u06a9\u0631\u0646\u06d4 \u0628\u06cc\u0631\u0648\u0646\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679\u0633\u06d4 \u0628\u06cc\u0631\u0648\u0646\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679\u0633 \u0686\u06be \u0645\u062a\u0639\u0644\u0642\u06c1 \u0645\u062d\u06a9\u0645\u06c1\u0655 \u0628\u0631\u0642\u0631\u0627\u0631 \u062a\u06be\u0648\u0627\u0646 \u06cc\u0645 \u06cc\u0645\u0646 \u0633\u0627\u0626\u0679\u0633 \u062a\u0627\u0645 \u0631\u0633\u0672\u0626\u06cc \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u0686 \u0630\u0645\u06c1 \u062f\u0627\u0631 \u0686\u06be\u06d4 </p> <p> \u0645\u0627\u0626\u06cc \u0627\u0633\u06a9\u06cc\u0645 \u0686\u06be \u067e\u0646\u0646 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0645\u0639\u0630\u0648\u0631 \u0627\u0641\u0631\u0627\u062f\u0646 \u062e\u0627\u0637\u0631\u0655 \u0631\u0633\u0672\u0626\u06cc \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u06c1\u0655 \u062e\u0627\u0637\u0631\u0655 \u06a9\u0672\u0645 \u06a9\u0631\u0627\u0646\u060c \u062a\u0627\u06c1\u0645 \u0641\u06cc \u0627\u0644\u062d\u0627\u0644 \u0686\u06be \u0646\u06c1\u0655 \u067e\u0648\u0631\u0679\u06cc\u0628\u0644 \u0688\u0627\u06a9\u06cc\u0648\u0645\u0646\u0679 \u0641\u0627\u0631\u0645\u06cc\u0679 (\u067e\u06cc \u0688\u06cc \u0627\u06cc\u0641) \u0641\u0627\u0626\u0644\u06c1\u0655 \u0631\u0633\u0672\u0626\u06cc \u062d\u0672\u0635\u0644\u06d4 \u0627\u0645\u06c1\u0655 \u0639\u0644\u0627\u0648\u0655\u060c \u06c1\u0646\u062f\u06cc \u0632\u0628\u0672\u0646\u06cd \u0645\u0646\u065b\u0632 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062f\u0655 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062a\u06c1\u0655 \u0686\u06be \u0646\u06c1\u0655 \u0631\u0633\u0672\u0626\u06cc \u062d\u0672\u0635\u0644\u06d4 </p> \u0627\u06af\u0631 \u062a\u06c4\u06c1\u06c1 \u0686\u06be \u0627\u062a\u06be \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0686 \u0631\u0633\u0672\u0626\u06cc \u0645\u062a\u0639\u0644\u0642 \u06a9\u0627\u0646\u065b\u06c1\u06c1 \u0645\u0633\u0644\u06c1\u0655 \u06cc\u0627 \u0645\u0634\u0648\u0631\u0655\u060c \u0645\u06c1\u0631\u0628\u0672\u0646\u06cc \u06a9\u0654\u0631\u062a\u06be \u0644\u06cc\u06a9\u06be\u0648 \u0627\u0633\u06c1 support-myscheme[at]myScheme[dot]gov[dot]in \u062a\u0627\u06a9\u06c1 \u0623\u0633\u06cd \u06c1\u06cc\u06a9\u0646 \u0645\u062f\u062f\u06af\u0627\u0631 \u0637\u0631\u06cc\u0642\u06c1\u0655 \u0633\u06ed\u062a\u06cd \u062c\u0648\u0627\u0628 \u062f\u062a\u06be\u06d4 \u06a9\u06cc\u0627 \u0623\u0633\u06cd \u0648\u0646\u06cd \u067e\u0646\u0646\u06c1 \u0631\u0627\u0628\u0637\u06c1\u0655 \u06c1\u0646\u065b\u0632 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u0633 \u0633\u06ed\u062a\u06cd \u0645\u0633\u0626\u0644\u06c1\u0655 \u06c1\u0646\u065b\u0632 \u0646\u0648\u0639\u06cc\u062a\u06d4"),(0,xe.Z)(de,"privacyPolicy","\u067e\u0631\u0627\u0626\u06cc\u