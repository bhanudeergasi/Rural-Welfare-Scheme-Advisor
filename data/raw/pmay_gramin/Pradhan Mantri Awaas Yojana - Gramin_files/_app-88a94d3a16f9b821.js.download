\u0c47 \u0c32\u0c15\u0c4d\u0c37\u0c4d\u0c2f\u0c02\u0c24\u0c4b \u0c07\u0c26\u0c3f \u0c28\u0c3f\u0c30\u0c4d\u0c2e\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f. \u0c2b\u0c32\u0c3f\u0c24\u0c02\u0c17\u0c3e \u0c08 \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u0c28\u0c41 \u0c21\u0c46\u0c38\u0c4d\u0c15\u0c4d\u0c1f\u0c3e\u0c2a\u0c4d/\u0c32\u0c4d\u0c2f\u0c3e\u0c2a\u0c4d\u0c1f\u0c3e\u0c2a\u0c4d \u0c15\u0c02\u0c2a\u0c4d\u0c2f\u0c42\u0c1f\u0c30\u0c4d\u0c32\u0c41, \u0c35\u0c46\u0c2c\u0c4d-\u0c0e\u0c28\u0c47\u0c2c\u0c41\u0c32\u0c4d\u0c21\u0c4d \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c2a\u0c30\u0c3f\u0c15\u0c30\u0c3e\u0c32\u0c41 \u0c35\u0c02\u0c1f\u0c3f \u0c35\u0c3f\u0c35\u0c3f\u0c27 \u0c2a\u0c30\u0c3f\u0c15\u0c30\u0c3e\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c1a\u0c42\u0c21\u0c35\u0c1a\u0c4d\u0c1a\u0c41. </p> <p> \u0c08 \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u0c32\u0c4b\u0c28\u0c3f \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c35\u0c3f\u0c15\u0c32\u0c3e\u0c02\u0c17\u0c41\u0c32\u0c15\u0c41 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c21\u0c47\u0c32\u0c3e \u0c2e\u0c47\u0c2e\u0c41 \u0c2e\u0c3e \u0c09\u0c24\u0c4d\u0c24\u0c2e \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3e\u0c32\u0c28\u0c41 \u0c1a\u0c47\u0c38\u0c3e\u0c2e\u0c41. \u0c09\u0c26\u0c3e\u0c39\u0c30\u0c23\u0c15\u0c41, \u0c26\u0c43\u0c36\u0c4d\u0c2f \u0c35\u0c48\u0c15\u0c32\u0c4d\u0c2f\u0c02 \u0c09\u0c28\u0c4d\u0c28 \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c40\u0c28\u0c4d \u0c30\u0c40\u0c21\u0c30\u0c4d\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c40\u0c28\u0c4d \u0c2e\u0c3e\u0c17\u0c4d\u0c28\u0c3f\u0c2b\u0c48\u0c2f\u0c30\u0c4d\u0c32\u0c41 \u0c35\u0c02\u0c1f\u0c3f \u0c38\u0c39\u0c3e\u0c2f\u0c15 \u0c38\u0c3e\u0c02\u0c15\u0c47\u0c24\u0c3f\u0c15 \u0c2a\u0c30\u0c3f\u0c1c\u0c4d\u0c1e\u0c3e\u0c28\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3f \u0c08 \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u0c28\u0c41 \u0c2f\u0c3e\u0c15\u0c4d\u0c38\u0c46\u0c38\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c2c\u0c3e\u0c39\u0c4d\u0c2f \u0c35\u0c46\u0c2c\u0c4d\u0c38\u0c48\u0c1f\u0c4d\u0c32\u0c41. \u0c08 \u0c38\u0c48\u0c1f\u0c4d\u0c32\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2c\u0c3e\u0c27\u0c4d\u0c2f\u0c24 \u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c47 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c35\u0c3f\u0c2d\u0c3e\u0c17\u0c3e\u0c32\u0c41 \u0c2c\u0c3e\u0c39\u0c4d\u0c2f \u0c35\u0c46\u0c2c\u0c4d\u0c38\u0c48\u0c1f\u0c4d\u0c32\u0c28\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c3f. </p> <p> \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c24\u0c28 \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u0c28\u0c41 \u0c35\u0c3f\u0c15\u0c32\u0c3e\u0c02\u0c17\u0c41\u0c32\u0c15\u0c41 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c15\u0c43\u0c37\u0c3f \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c4b\u0c02\u0c26\u0c3f, \u0c05\u0c2f\u0c3f\u0c24\u0c47 \u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24\u0c02 \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c2c\u0c41\u0c32\u0c4d \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c2b\u0c3e\u0c30\u0c4d\u0c2e\u0c3e\u0c1f\u0c4d (\u0c2a\u0c3f\u0c21\u0c3f\u0c0e\u0c2b\u0c4d) \u0c2b\u0c48\u0c33\u0c4d\u0c32\u0c41 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c32\u0c47\u0c35\u0c41. \u0c05\u0c26\u0c28\u0c02\u0c17\u0c3e, \u0c39\u0c3f\u0c02\u0c26\u0c40 \u0c2d\u0c3e\u0c37\u0c32\u0c4b \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c15\u0c42\u0c21\u0c3e \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c32\u0c47\u0c26\u0c41. </p> \u0c08 \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c30\u0c2e\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c2a\u0c4d\u0c30\u0c3e\u0c2a\u0c4d\u0c2f\u0c24\u0c15\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f \u0c2e\u0c40\u0c15\u0c41 \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c38\u0c2e\u0c38\u0c4d\u0c2f \u0c32\u0c47\u0c26\u0c3e \u0c38\u0c32\u0c39\u0c3e \u0c09\u0c02\u0c1f\u0c47, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c3e\u0c15\u0c41 \u0c38\u0c39\u0c3e\u0c2f\u0c15\u0c30\u0c2e\u0c48\u0c28 \u0c30\u0c40\u0c24\u0c3f\u0c32\u0c4b \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c38\u0c4d\u0c2a\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c40\u0c32\u0c41\u0c17\u0c3e \u0c2e\u0c3e\u0c15\u0c41 support-myscheme[at]myScheme[dot]gov[dot]in \u0c05\u0c28\u0c3f \u0c35\u0c4d\u0c30\u0c3e\u0c2f\u0c02\u0c21\u0c3f. \u0c2e\u0c40 \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c2a\u0c41 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02\u0c24\u0c4b \u0c2a\u0c3e\u0c1f\u0c41 \u0c38\u0c2e\u0c38\u0c4d\u0c2f \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c38\u0c4d\u0c35\u0c2d\u0c3e\u0c35\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2e\u0c3e\u0c15\u0c41 \u0c24\u0c46\u0c32\u0c3f\u0c2f\u0c1c\u0c47\u0c2f\u0c02\u0c21\u0c3f."),(0,xe.Z)(ue,"privacyPolicy","\u0c17\u0c4b\u0c2a\u0c4d\u0c2f\u0c24\u0c3e \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02"),(0,xe.Z)(ue,"hyperlinkPolicy","\u0c39\u0c48\u0c2a\u0c30\u0c4d\u0c32\u0c3f\u0c02\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02"),(0,xe.Z)(ue,"termsOfUse","\u0c09\u0c2a\u0c2f\u0c4b\u0c17 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41"),(0,xe.Z)(ue,"terms","\u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c37\u0c30\u0c24\u0c41\u0c32\u0c41"),(0,xe.Z)(ue,"copyrightPolicy","\u0c15\u0c3e\u0c2a\u0c40\u0c30\u0c48\u0c1f\u0c4d \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02"),(0,xe.Z)(ue,"termsConditions","<p> \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41 & \u0c37\u0c30\u0c24\u0c41\u0c32\u0c41 </p>"),(0,xe.Z)(ue,"copyrightPolicyText","\u0c08 \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u0c32\u0c4b \u0c2a\u0c4d\u0c30\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c35\u0c38\u0c4d\u0c24\u0c41\u0c35\u0c41\u0c32\u0c28\u0c41 \u0c09\u0c1a\u0c3f\u0c24\u0c02\u0c17\u0c3e \u0c2a\u0c41\u0c28\u0c30\u0c41\u0c24\u0c4d\u0c2a\u0c24\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c0f\u0c26\u0c47\u0c2e\u0c48\u0c28\u0c3e, \u0c2a\u0c26\u0c3e\u0c30\u0c4d\u0c25\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c02\u0c17\u0c3e \u0c2a\u0c41\u0c28\u0c30\u0c41\u0c24\u0c4d\u0c2a\u0c24\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c35\u0c2e\u0c3e\u0c28\u0c15\u0c30\u0c2e\u0c48\u0c28 \u0c2a\u0c26\u0c4d\u0c27\u0c24\u0c3f\u0c32\u0c4b \u0c32\u0c47\u0c26\u0c3e \u0c24\u0c2a\u0c4d\u0c2a\u0c41\u0c26\u0c4b\u0c35 \u0c2a\u0c1f\u0c4d\u0c1f\u0c3f\u0c02\u0c1a\u0c47 \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c2d\u0c02\u0c32\u0c4b \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c15\u0c42\u0c21\u0c26\u0c41. \u0c35\u0c3f\u0c37\u0c2f\u0c02 \u0c0e\u0c15\u0c4d\u0c15\u0c21 \u0c2a\u0c4d\u0c30\u0c1a\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28\u0c3e \u0c32\u0c47\u0c26\u0c3e \u0c07\u0c24\u0c30\u0c41\u0c32\u0c15\u0c41 \u0c1c\u0c3e\u0c30\u0c40 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28\u0c3e, \u0c2e\u0c42\u0c32\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c4d\u0c30\u0c2e\u0c41\u0c16\u0c02\u0c17\u0c3e \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f. \u0c0f\u0c26\u0c47\u0c2e\u0c48\u0c28\u0c3e, \u0c08 \u0c35\u0c3f\u0c37\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c41\u0c28\u0c30\u0c41\u0c24\u0c4d\u0c2a\u0c24\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f \u0c2e\u0c42\u0c21\u0c35 \u0c2a\u0c15\u0c4d\u0c37\u0c02 (\u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c15\u0c02\u0c1f\u0c46\u0c02\u0c1f\u0c4d) \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c15\u0c3e\u0c2a\u0c40\u0c30\u0c48\u0c1f\u0c4d\u0c17\u0c3e \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c0f \u0c05\u0c02\u0c36\u0c3e\u0c28\u0c3f\u0c15\u0c40 \u0c35\u0c3f\u0c38\u0c4d\u0c24\u0c30\u0c3f\u0c02\u0c1a\u0c26\u0c41. \u0c05\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c35\u0c3f\u0c37\u0c2f\u0c3e\u0c32\u0c28\u0c41 \u0c2a\u0c41\u0c28\u0c30\u0c41\u0c24\u0c4d\u0c2a\u0c24\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c27\u0c3f\u0c15\u0c3e\u0c30\u0c02 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c15\u0c3e\u0c2a\u0c40\u0c30\u0c48\u0c1f\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c2a\u0c4a\u0c02\u0c26\u0c3e\u0c32\u0c3f."),(0,xe.Z)(ue,"privacyPolicyText","<p> \u0c2e\u0c3f\u0c2e\u0c4d\u0c2e\u0c32\u0c4d\u0c28\u0c3f \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24\u0c02\u0c17\u0c3e \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c3f\u0c2e\u0c4d\u0c2e\u0c32\u0c4d\u0c28\u0c3f \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f\u0c02\u0c1a\u0c47 \u0c28\u0c3f\u0c30\u0c4d\u0c26\u0c3f\u0c37\u0c4d\u0c1f \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f (\u0c2a\u0c47\u0c30\u0c41, \u0c2b\u0c4b\u0c28\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c07-\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c35\u0c02\u0c1f\u0c3f\u0c35\u0c3f) \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c1a\u0c3e\u0c32\u0c15\u0c02\u0c17\u0c3e \u0c38\u0c02\u0c17\u0c4d\u0c30\u0c39\u0c3f\u0c02\u0c1a\u0c26\u0c41. \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2e\u0c3f\u0c2e\u0c4d\u0c2e\u0c32\u0c4d\u0c28\u0c3f \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c3f \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c3f\u0c38\u0c4d\u0c24\u0c47, \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c38\u0c47\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c28\u0c3f\u0c30\u0c4d\u0c26\u0c3f\u0c37\u0c4d\u0c1f \u0c2a\u0c4d\u0c30\u0c2f\u0c4b\u0c1c\u0c28\u0c3e\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c2e\u0c40\u0c15\u0c41 \u0c24\u0c46\u0c32\u0c3f\u0c2f\u0c1c\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2e\u0c40 \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c24\u0c17\u0c3f\u0c28 \u0c2d\u0c26\u0c4d\u0c30\u0c24\u0c3e \u0c1a\u0c30\u0c4d\u0c2f\u0c32\u0c41 \u0c24\u0c40\u0c38\u0c41\u0c15\u0c4b\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f. \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d\u0c32\u0c4b \u0c38\u0c4d\u0c35\u0c1a\u0c4d\u0c1b\u0c02\u0c26\u0c02\u0c17\u0c3e \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24\u0c02\u0c17\u0c3e \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c26\u0c17\u0c3f\u0c28 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2e\u0c47\u0c2e\u0c41 \u0c0f \u0c2e\u0c42\u0c21\u0c35 \u0c2a\u0c15\u0c4d\u0c37\u0c3e\u0c28\u0c3f\u0c15\u0c3f (\u0c2a\u0c2c\u0c4d\u0c32\u0c3f\u0c15\u0c4d/\u0c2a\u0c4d\u0c30\u0c48\u0c35\u0c47\u0c1f\u0c4d) \u0c35\u0c3f\u0c15\u0c4d\u0c30\u0c2f\u0c3f\u0c02\u0c1a\u0c2e\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c2e\u0c41. \u0c08 \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u0c15\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c28\u0c37\u0c4d\u0c1f\u0c02, \u0c26\u0c41\u0c30\u0c4d\u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c02, \u0c05\u0c28\u0c27\u0c3f\u0c15\u0c3e\u0c30 \u0c2a\u0c4d\u0c30\u0c3e\u0c2a\u0c4d\u0c2f\u0c24 \u0c32\u0c47\u0c26\u0c3e \u0c2c\u0c39\u0c3f\u0c30\u0c4d\u0c17\u0c24\u0c02, \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c35\u0c3f\u0c27\u0c4d\u0c35\u0c02\u0c38\u0c02 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c2e\u0c47\u0c2e\u0c41 \u0c07\u0c02\u0c1f\u0c30\u0c4d\u0c28\u0c46\u0c1f\u0c4d \u0c2a\u0c4d\u0c30\u0c4b\u0c1f\u0c4b\u0c15\u0c3e\u0c32\u0c4d (\u0c10\u0c2a\u0c3f) \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e\u0c32\u0c41, \u0c21\u0c4a\u0c2e\u0c48\u0c28\u0c4d \u0c2a\u0c47\u0c30\u0c41, \u0c2c\u0c4d\u0c30\u0c4c\u0c1c\u0c30\u0c4d \u0c30\u0c15\u0c02 \u0c35\u0c02\u0c1f\u0c3f \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c17\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c3f \u0c15\u0c4a\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c47\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c2e\u0c41."),(0,xe.Z)(ue,"hyperlinkPolicyText","<p> <\u0c2c\u0c32\u0c2e\u0c48\u0c28> \u0c2c\u0c3e\u0c39\u0c4d\u0c2f \u0c35\u0c46\u0c2c\u0c4d\u0c38\u0c48\u0c1f\u0c4d\u0c32\u0c41/\u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u0c32\u0c15\u0c41 \u0c32\u0c3f\u0c02\u0c15\u0c4d\u0c32\u0c41 </\u0c2c\u0c32\u0c2e\u0c48\u0c28> </p> <p> \u0c08 \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u0c32\u0c4b\u0c28\u0c3f \u0c05\u0c28\u0c47\u0c15 \u0c2a\u0c4d\u0c30\u0c26\u0c47\u0c36\u0c3e\u0c32\u0c32\u0c4b, \u0c2e\u0c40\u0c30\u0c41 \u0c07\u0c24\u0c30 \u0c35\u0c46\u0c2c\u0c4d\u0c38\u0c48\u0c1f\u0c4d\u0c32\u0c41/\u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u0c32\u0c15\u0c41 \u0c32\u0c3f\u0c02\u0c15\u0c4d\u0c32\u0c28\u0c41 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c02\u0c1f\u0c3e\u0c30\u0c41. \u0c2e\u0c40 \u0c38\u0c4c\u0c32\u0c2d\u0c4d\u0c2f\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c32\u0c3f\u0c02\u0c15\u0c4d\u0c32\u0c41 \u0c09\u0c02\u0c1a\u0c2c\u0c21\u0c4d\u0c21\u0c3e\u0c2f\u0c3f. \u0c32\u0c3f\u0c02\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c35\u0c46\u0c2c\u0c4d\u0c38\u0c48\u0c1f\u0c4d\u0c32 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c15\u0c02\u0c1f\u0c46\u0c02\u0c1f\u0c4d\u0c32\u0c15\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c3f\u0c36\u0c4d\u0c35\u0c38\u0c28\u0c40\u0c2f\u0c24\u0c15\u0c41 \u0c2e\u0c48\u0c38\u0c4d\u0c15\u0c46\u0c2e\u0c4d \u0c2c\u0c3e\u0c27\u0c4d\u0c2f\u0c24 \u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c26\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c3e\u0c1f\u0c3f\u0c32\u0c4b \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c05\u0c2d\u0c3f\u0c2a\u0c4d\u0c30\u0c3e\u0c2f\u0c3e\u0c32\u0c28\u0c41 \u0c24\u0c2a\u0c4d\u0c2a\u0c28\u0c3f\u0c38\u0c30\u0c3f\u0c17\u0c3e \u0c06\u0c2e\u0c4b\u0c26\u0c3f\u0c02\u0c1a\u0c26\u0c41. \u0c08 \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u0c32\u0c4b \u0c15\u0c47\u0c35\u0c32\u0c02 \u0c32\u0c3f\u0c02\u0c15\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c26\u0c3e\u0c28\u0c3f \u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e \u0c09\u0c02\u0c21\u0c1f\u0c02 \u0c0f \u0c30\u0c15\u0c2e\u0c48\u0c28 \u0c0e\u0c02\u0c21\u0c3e\u0c30\u0c4d\u0c38\u0c4d\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u0c17\u0c3e \u0c2d\u0c3e\u0c35\u0c3f\u0c02\u0c1a\u0c15\u0c42\u0c21\u0c26\u0c41. \u0c08 \u0c32\u0c3f\u0c02\u0c15\u0c4d\u0c32\u0c41 \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c2e\u0c2f\u0c3e\u0c32\u0c32\u0c4b \u0c2a\u0c28\u0c3f\u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c28\u0c3f \u0c2e\u0c47\u0c2e\u0c41 \u0c39\u0c3e\u0c2e\u0c40 \u0c07\u0c35\u0c4d\u0c35\u0c32\u0c47\u0c2e\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c32\u0c3f\u0c02\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c2a\u0c47\u0c1c\u0c40\u0c32 \u0c32\u0c2d\u0c4d\u0c2f\u0c24\u0c2a\u0c48 \u0c2e\u0c3e\u0c15\u0c41 \u0c28\u0c3f\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c23 \u0c32\u0c47\u0c26\u0c41. </p> <\u0c2c\u0c32\u0c2e\u0c48\u0c28> \u0c07\u0c24\u0c30 \u0c35\u0c46\u0c2c\u0c4d\u0c38\u0c48\u0c1f\u0c4d\u0c32 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2e\u0c48\u0c38\u0c4d\u0c15\u0c46\u0c2e\u0c4d\u0c15\u0c41 \u0c32\u0c3f\u0c02\u0c15\u0c4d\u0c32\u0c41 </\u0c2c\u0c32\u0c2e\u0c48\u0c28> </p> \u0c2e\u0c47\u0c2e\u0c41 \u0c05\u0c2d\u0c4d\u0c2f\u0c02\u0c24\u0c30\u0c02 \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c02 \u0c1a\u0c47\u0c2f\u0c2e\u0c41"),(0,xe.Z)(ue,"termsText1","<p> \u0c08 \u0c09\u0c2a\u0c2f\u0c4b\u0c17 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41 https://www.myscheme.gov.in \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41\u0c17\u0c3e \u0c2e\u0c40 \u0c39\u0c15\u0c4d\u0c15\u0c41\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2c\u0c3e\u0c27\u0c4d\u0c2f\u0c24\u0c32\u0c28\u0c41 \u0c35\u0c3f\u0c35\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c3f. MyScheme \u0c16\u0c3e\u0c24\u0c3e\u0c28\u0c41 \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c02\u0c21\u0c1f\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c2e\u0c40\u0c30\u0c41 \u0c08 \u0c09\u0c2a\u0c2f\u0c4b\u0c17 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c28\u0c41 \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f. </p> <p> MeitY \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2d\u0c3e\u0c30\u0c24 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35\u0c02 \u0c0e\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c48\u0c28\u0c3e \u0c28\u0c3e \u0c2a\u0c25\u0c15\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c08 \u0c09\u0c2a\u0c2f\u0c4b\u0c17 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c32\u0c4b \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41\u0c32\u0c41 \u0c1a\u0c47\u0c38\u0c47 \u0c39\u0c15\u0c4d\u0c15\u0c41\u0c28\u0c41 \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c02\u0c1f\u0c3e\u0c2f\u0c3f. \u0c06 \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41\u0c32\u0c41 \u0c2e\u0c40 \u0c39\u0c15\u0c4d\u0c15\u0c41\u0c32\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c2c\u0c3e\u0c27\u0c4d\u0c2f\u0c24\u0c32\u0c28\u0c41 \u0c2a\u0c4d\u0c30\u0c2d\u0c3e\u0c35\u0c3f\u0c24\u0c02 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c47, \u0c2e\u0c40\u0c15\u0c41 \u0c28\u0c3e \u0c2a\u0c25\u0c15\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c24\u0c46\u0c32\u0c3f\u0c2f\u0c1c\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. </p> \u0c08 \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41 \u0c2e\u0c40\u0c30\u0c41 \u0c28\u0c3e \u0c2a\u0c25\u0c15\u0c02 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c3f\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c17\u0c24\u0c02\u0c32\u0c4b \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c0f\u0c35\u0c48\u0c28\u0c3e \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c37\u0c30\u0c24\u0c41\u0c32\u0c28\u0c41 \u0c2d\u0c30\u0c4d\u0c24\u0c40 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c3f. \u0c2e\u0c40\u0c30\u0c41 \u0c26\u0c3e\u0c28\u0c3f\u0c28\u0c3f \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f, \u0c2e\u0c40 \u0c28\u0c3e \u0c2a\u0c25\u0c15\u0c02 \u0c16\u0c3e\u0c24\u0c3e\u0c28\u0c41 \u0c38\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c35\u0c46\u0c02\u0c1f\u0c28\u0c47 \u0c08 \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26\u0c3f \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c37\u0c30\u0c24\u0c41\u0c32\u0c41 \u0c05\u0c2e\u0c32\u0c41\u0c32\u0c4b\u0c15\u0c3f \u0c35\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c3f. \u0c2d\u0c3e\u0c30\u0c24 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c38\u0c02\u0c38\u0c4d\u0c25\u0c32\u0c41, \u0c35\u0c3f\u0c2d\u0c3e\u0c17\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2e\u0c02\u0c24\u0c4d\u0c30\u0c3f\u0c24\u0c4d\u0c35 \u0c36\u0c3e\u0c16\u0c32\u0c41. </p> <p> \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d\u0c32\u0c4b\u0c28\u0c3f \u0c15\u0c02\u0c1f\u0c46\u0c02\u0c1f\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c24\u0c4d\u0c35\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3e\u0c32\u0c41 \u0c1a\u0c47\u0c38\u0c3f\u0c28\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c40, \u0c26\u0c3e\u0c28\u0c3f\u0c28\u0c3f \u0c1a\u0c1f\u0c4d\u0c1f \u0c2a\u0c4d\u0c30\u0c15\u0c1f\u0c28\u0c17\u0c3e \u0c2d\u0c3e\u0c35\u0c3f\u0c02\u0c1a\u0c15\u0c42\u0c21\u0c26\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c1a\u0c1f\u0c4d\u0c1f\u0c2a\u0c30\u0c2e\u0c48\u0c28 \u0c2a\u0c4d\u0c30\u0c2f\u0c4b\u0c1c\u0c28\u0c3e\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c15\u0c42\u0c21\u0c26\u0c41. \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c05\u0c38\u0c4d\u0c2a\u0c37\u0c4d\u0c1f\u0c24 \u0c32\u0c47\u0c26\u0c3e \u0c38\u0c02\u0c26\u0c47\u0c39\u0c3e\u0c32\u0c41 \u0c09\u0c02\u0c1f\u0c47, \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c2e\u0c02\u0c24\u0c4d\u0c30\u0c3f\u0c24\u0c4d\u0c35 \u0c36\u0c3e\u0c16/\u0c35\u0c3f\u0c2d\u0c3e\u0c17\u0c02/\u0c38\u0c02\u0c38\u0c4d\u0c25 \u0c2e\u0c30\u0c3f\u0c2f\u0c41/\u0c32\u0c47\u0c26\u0c3e \u0c07\u0c24\u0c30 \u0c35\u0c28\u0c30\u0c41\u0c32\u0c24\u0c4b \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c3f/\u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c28\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c24\u0c17\u0c3f\u0c28 \u0c35\u0c43\u0c24\u0c4d\u0c24\u0c3f\u0c2a\u0c30\u0c2e\u0c48\u0c28 \u0c38\u0c32\u0c39\u0c3e\u0c28\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c3e\u0c32\u0c28\u0c3f \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41\u0c32\u0c15\u0c41 \u0c38\u0c32\u0c39\u0c3e \u0c07\u0c38\u0c4d\u0c24\u0c3e\u0c30\u0c41. </p> \u0c0f \u0c2a\u0c30\u0c3f\u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c41\u0c32\u0c4d\u0c32\u0c4b\u0c28\u0c42 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 \u0c2e\u0c02\u0c24\u0c4d\u0c30\u0c3f\u0c24\u0c4d\u0c35 \u0c36\u0c3e\u0c16/\u0c35\u0c3f\u0c2d\u0c3e\u0c17\u0c02/\u0c38\u0c02\u0c38\u0c4d\u0c25 \u0c2a\u0c30\u0c3f\u0c2e\u0c3f\u0c24\u0c3f \u0c32\u0c47\u0c15\u0c41\u0c02\u0c21\u0c3e, \u0c2a\u0c30\u0c4b\u0c15\u0c4d\u0c37\u0c02\u0c17\u0c3e \u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c30\u0c4d\u0c2f\u0c35\u0c38\u0c3e\u0c28\u0c02\u0c17\u0c3e \u0c28\u0c37\u0c4d\u0c1f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c37\u0c4d\u0c1f\u0c02, \u0c32\u0c47\u0c26\u0c3e \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c02 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c09\u0c24\u0c4d\u0c2a\u0c28\u0c4d\u0c28\u0c2e\u0c2f\u0c4d\u0c2f\u0c47 \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c16\u0c30\u0c4d\u0c1a\u0c41, \u0c28\u0c37\u0c4d\u0c1f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c37\u0c4d\u0c1f\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2c\u0c3e\u0c27\u0c4d\u0c2f\u0c24 \u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c26\u0c41, \u0c32\u0c47\u0c26\u0c3e"),(0,xe.Z)(ue,"termsHead1","\u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2a\u0c30\u0c3f\u0c2e\u0c3f\u0c24\u0c3f\u0c03"),(0,xe.Z)(ue,"termsText2","<p> MyScheme \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c05\u0c28\u0c27\u0c3f\u0c15\u0c3e\u0c30 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c02 \u0c28\u0c3f\u0c37\u0c47\u0c27\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f. \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u0c2b\u0c3e\u0c02 \u0c2a\u0c47\u0c1c\u0c40\u0c32\u0c28\u0c41 \u0c2f\u0c3e\u0c15\u0c4d\u0c38\u0c46\u0c38\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c2a\u0c30\u0c4d\u0c2f\u0c35\u0c47\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c15\u0c3e\u0c2a\u0c40 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c38\u0c3e\u0c2b\u0c4d\u0c1f\u0c4d\u0c35\u0c47\u0c30\u0c4d (\u0c2c\u0c3e\u0c1f\u0c4d\u0c32\u0c41, \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c3e\u0c2a\u0c30\u0c4d \u0c1f\u0c42\u0c32\u0c4d\u0c38\u0c4d \u0c35\u0c02\u0c1f\u0c3f\u0c35\u0c3f) \u0c32\u0c47\u0c26\u0c3e \u0c07\u0c24\u0c30 \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c1a\u0c3e\u0c32\u0c15 \u0c2a\u0c30\u0c3f\u0c15\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c05\u0c28\u0c47\u0c26\u0c3f MyScheme \u0c35\u0c4d\u0c30\u0c3e\u0c24\u0c2a\u0c42\u0c30\u0c4d\u0c35\u0c15\u0c02\u0c17\u0c3e \u0c38\u0c4d\u0c2a\u0c37\u0c4d\u0c1f\u0c02\u0c17\u0c3e \u0c05\u0c27\u0c3f\u0c15\u0c3e\u0c30\u0c02 \u0c07\u0c35\u0c4d\u0c35\u0c15\u0c2a\u0c4b\u0c24\u0c47 \u0c28\u0c3f\u0c37\u0c47\u0c27\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f."),(0,xe.Z)(ue,"termsHead2","\u0c2e\u0c40 \u0c15\u0c02\u0c1f\u0c46\u0c02\u0c1f\u0c4d\u0c28\u0c41 \u0c2a\u0c30\u0c3f\u0c17\u0c23\u0c3f\u0c02\u0c1a\u0c47 \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02\u0c03"),(0,xe.Z)(ue,"termsText3","<p> \u0c15\u0c02\u0c1f\u0c46\u0c02\u0c1f\u0c4d\u0c28\u0c41 \u0c05\u0c2a\u0c4d\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c3e \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d\u0c32\u0c4b \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d\u0c32\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c21\u0c02, \u0c2e\u0c40\u0c30\u0c41 \u0c28\u0c3e \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d\u0c15\u0c41 \u0c36\u0c3e\u0c36\u0c4d\u0c35\u0c24, \u0c2a\u0c4d\u0c30\u0c2a\u0c02\u0c1a\u0c35\u0c4d\u0c2f\u0c3e\u0c2a\u0c4d\u0c24\u0c02\u0c17\u0c3e, \u0c30\u0c3e\u0c2f\u0c32\u0c4d\u0c1f\u0c40 \u0c30\u0c39\u0c3f\u0c24, \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c32\u0c47\u0c28\u0c3f, \u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c47\u0c15\u0c2e\u0c48\u0c28 \u0c39\u0c15\u0c4d\u0c15\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c32\u0c48\u0c38\u0c46\u0c28\u0c4d\u0c38\u0c4d\u0c28\u0c41 \u0c2e\u0c02\u0c1c\u0c42\u0c30\u0c41 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c3e\u0c30\u0c41 (\u0c32\u0c47\u0c26\u0c3e \u0c05\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c39\u0c15\u0c4d\u0c15\u0c41\u0c32 \u0c2f\u0c1c\u0c2e\u0c3e\u0c28\u0c3f \u0c38\u0c4d\u0c2a\u0c37\u0c4d\u0c1f\u0c02\u0c17\u0c3e \u0c2e\u0c02\u0c1c\u0c42\u0c30\u0c41 \u0c1a\u0c47\u0c38\u0c3f\u0c28\u0c1f\u0c4d\u0c32\u0c41 \u0c39\u0c3e\u0c2e\u0c40 \u0c07\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c30\u0c41), \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c2a\u0c41\u0c28\u0c30\u0c41\u0c24\u0c4d\u0c2a\u0c24\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c38\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c38\u0c4d\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c2a\u0c4d\u0c30\u0c1a\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c2c\u0c39\u0c3f\u0c30\u0c02\u0c17\u0c02\u0c17\u0c3e \u0c2a\u0c4d\u0c30\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c2c\u0c39\u0c3f\u0c30\u0c02\u0c17\u0c02\u0c17\u0c3e \u0c2a\u0c4d\u0c30\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c21\u0c3f\u0c1c\u0c3f\u0c1f\u0c32\u0c4d\u0c17\u0c3e \u0c2a\u0c4d\u0c30\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c21\u0c3f\u0c1c\u0c3f\u0c1f\u0c32\u0c4d\u0c17\u0c3e \u0c05\u0c28\u0c41\u0c35\u0c26\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c05\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c09\u0c24\u0c4d\u0c2a\u0c28\u0c4d\u0c28 \u0c30\u0c1a\u0c28\u0c32\u0c28\u0c41 \u0c38\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c02\u0c2a\u0c3f\u0c23\u0c40 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c35\u0c3f\u0c36\u0c4d\u0c35\u0c02 \u0c05\u0c02\u0c24\u0c1f\u0c3e \u0c07\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c24\u0c46\u0c32\u0c3f\u0c38\u0c3f\u0c28 \u0c32\u0c47\u0c26\u0c3e \u0c24\u0c30\u0c41\u0c35\u0c3e\u0c24 \u0c05\u0c2d\u0c3f\u0c35\u0c43\u0c26\u0c4d\u0c27\u0c3f \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c0f \u0c30\u0c42\u0c2a\u0c02, \u0c2e\u0c3e\u0c27\u0c4d\u0c2f\u0c2e\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c38\u0c3e\u0c02\u0c15\u0c47\u0c24\u0c3f\u0c15\u0c24\u0c32\u0c4b \u0c05\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d\u0c32\u0c28\u0c41 \u0c1a\u0c47\u0c30\u0c4d\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c40\u0c15\u0c41 \u0c36\u0c3e\u0c36\u0c4d\u0c35\u0c24, \u0c2a\u0c4d\u0c30\u0c2a\u0c02\u0c1a\u0c35\u0c4d\u0c2f\u0c3e\u0c2a\u0c4d\u0c24\u0c02\u0c17\u0c3e, \u0c30\u0c3e\u0c2f\u0c32\u0c4d\u0c1f\u0c40 \u0c30\u0c39\u0c3f\u0c24, \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c32\u0c47\u0c28\u0c3f, \u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c47\u0c15\u0c2e\u0c48\u0c28 \u0c39\u0c15\u0c4d\u0c15\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c32\u0c48\u0c38\u0c46\u0c28\u0c4d\u0c38\u0c4d \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f. \u0c2e\u0c3e\u0c15\u0c41 \u0c2e\u0c40 \u0c15\u0c2e\u0c4d\u0c2f\u0c42\u0c28\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d\u0c32\u0c4b \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c2f\u0c3e\u0c1c\u0c2e\u0c3e\u0c28\u0c4d\u0c2f \u0c39\u0c15\u0c4d\u0c15\u0c41\u0c28\u0c41 \u0c09\u0c32\u0c4d\u0c32\u0c02\u0c18\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c26\u0c41\u0c30\u0c4d\u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c02 \u0c1a\u0c47\u0c2f\u0c21\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c2e\u0c40\u0c15\u0c41 \u0c2a\u0c4d\u0c30\u0c4a\u0c35\u0c48\u0c21\u0c30\u0c4d\u0c15\u0c41 \u0c35\u0c4d\u0c2f\u0c24\u0c3f\u0c30\u0c47\u0c15\u0c02\u0c17\u0c3e \u0c0e\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c09\u0c02\u0c21\u0c26\u0c28\u0c3f \u0c2e\u0c40\u0c30\u0c41 \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c30\u0c41."),(0,xe.Z)(ue,"termsHead3","\u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c2c\u0c3e\u0c27\u0c4d\u0c2f\u0c24\u0c03"),(0,xe.Z)(ue,"termsText4","<p> \u0c2e\u0c40\u0c30\u0c41 \u0c24\u0c2a\u0c4d\u0c2a\u0c15: </p>"),(0,xe.Z)(ue,"termsPoints","\u0c28\u0c3e \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c38\u0c2d\u0c4d\u0c2f \u0c38\u0c47\u0c35\u0c28\u0c41 \u0c2f\u0c3e\u0c15\u0c4d\u0c38\u0c46\u0c38\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c2f\u0c3e\u0c15\u0c4d\u0c38\u0c46\u0c38\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c47 \u0c38\u0c39\u0c1c \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c3e \u0c09\u0c02\u0c21\u0c02\u0c21\u0c3f; (\u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c15\u0c4d\u0c37\u0c02\u0c17\u0c3e \u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c30\u0c4b\u0c15\u0c4d\u0c37\u0c02\u0c17\u0c3e) \u0c0f \u0c07\u0c24\u0c30 \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c28\u0c3e \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c2e\u0c46\u0c02\u0c2c\u0c30\u0c4d \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d \u0c16\u0c3e\u0c24\u0c3e\u0c15\u0c41 \u0c2f\u0c3e\u0c15\u0c4d\u0c38\u0c46\u0c38\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c26\u0c4d\u0c26\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c32\u0c3f\u0c02\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c26\u0c4d\u0c26\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c2f\u0c3e\u0c15\u0c4d\u0c38\u0c46\u0c38\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c32\u0c3f\u0c02\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c35\u0c26\u0c4d\u0c26\u0c41; (\u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c15\u0c4d\u0c37\u0c02\u0c17\u0c3e \u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c30\u0c4b\u0c15\u0c4d\u0c37\u0c02\u0c17\u0c3e) \u0c2e\u0c40 \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c2a\u0c47\u0c30\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c46\u0c35\u0c30\u0c3f\u0c28\u0c40 \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f\u0c02\u0c1a\u0c35\u0c26\u0c4d\u0c26\u0c41; \u0c2e\u0c40 \u0c28\u0c3e \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c16\u0c3e\u0c24\u0c3e \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c2a\u0c47\u0c30\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d\u0c28\u0c41 \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c2e\u0c2f\u0c3e\u0c32\u0c4d\u0c32\u0c4b \u0c09\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2e\u0c40 \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d\u0c28\u0c41 \u0c2e\u0c30\u0c46\u0c35\u0c30\u0c3f\u0c15\u0c40 \u0c2c\u0c39\u0c3f\u0c30\u0c4d\u0c17\u0c24\u0c02 \u0c1a\u0c47\u0c2f\u0c35\u0c26\u0c4d\u0c26\u0c41; \u0c2e\u0c40 \u0c28\u0c3e \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c16\u0c3e\u0c24\u0c3e \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c2d\u0c26\u0c4d\u0c30\u0c24 \u0c30\u0c3e\u0c1c\u0c40\u0c2a\u0c21\u0c3f \u0c09\u0c02\u0c21\u0c35\u0c1a\u0c4d\u0c1a\u0c28\u0c3f \u0c2e\u0c40\u0c30\u0c41 \u0c05\u0c28\u0c41\u0c2e\u0c3e\u0c28\u0c3f\u0c02\u0c1a\u0c3f\u0c28\u0c1f\u0c4d\u0c32\u0c2f\u0c3f\u0c24\u0c47 \u0c35\u0c46\u0c02\u0c1f\u0c28\u0c47 \u0c39\u0c46\u0c32\u0c4d\u0c2a\u0c4d\u0c21\u0c46\u0c38\u0c4d\u0c15\u0c4d\u0c28\u0c41 \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f \u0c09\u0c26\u0c3e.: \u0c2e\u0c40 \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c2a\u0c47\u0c30\u0c41 \u0c2a\u0c4b\u0c2f\u0c3f\u0c02\u0c26\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c26\u0c4a\u0c02\u0c17\u0c3f\u0c32\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f. MyScheme \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2f\u0c3e\u0c15\u0c4d\u0c38\u0c46\u0c38\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2e\u0c40\u0c15\u0c41 \u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c47\u0c15\u0c02\u0c17\u0c3e \u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c2a\u0c47\u0c30\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c2e\u0c40\u0c30\u0c41 MyScheme \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2e\u0c40 MyScheme \u0c16\u0c3e\u0c24\u0c3e\u0c28\u0c41 \u0c1a\u0c1f\u0c4d\u0c1f\u0c2c\u0c26\u0c4d\u0c27\u0c2e\u0c48\u0c28 \u0c2a\u0c4d\u0c30\u0c2f\u0c4b\u0c1c\u0c28\u0c3e\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c0f \u0c2e\u0c42\u0c21\u0c35 \u0c2a\u0c15\u0c4d\u0c37\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c05\u0c2f\u0c3f\u0c28\u0c3e MyScheme \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c39\u0c15\u0c4d\u0c15\u0c41\u0c32\u0c28\u0c41 \u0c09\u0c32\u0c4d\u0c32\u0c02\u0c18\u0c3f\u0c02\u0c1a\u0c28\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c30\u0c3f\u0c2e\u0c3f\u0c24\u0c02 \u0c1a\u0c47\u0c2f\u0c28\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c3f\u0c30\u0c4b\u0c27\u0c3f\u0c02\u0c1a\u0c28\u0c3f \u0c35\u0c3f\u0c27\u0c02\u0c17\u0c3e \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f. \u0c07\u0c02\u0c26\u0c41\u0c32\u0c4b \u0c1a\u0c1f\u0c4d\u0c1f\u0c35\u0c3f\u0c30\u0c41\u0c26\u0c4d\u0c27\u0c2e\u0c48\u0c28 \u0c32\u0c47\u0c26\u0c3e \u0c0f \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c15\u0c48\u0c28\u0c3e \u0c35\u0c47\u0c27\u0c3f\u0c02\u0c1a\u0c47 \u0c32\u0c47\u0c26\u0c3e \u0c2c\u0c3e\u0c27 \u0c15\u0c32\u0c3f\u0c17\u0c3f\u0c02\u0c1a\u0c47 \u0c32\u0c47\u0c26\u0c3e \u0c05\u0c38\u0c4c\u0c15\u0c30\u0c4d\u0c2f\u0c02 \u0c15\u0c32\u0c3f\u0c17\u0c3f\u0c02\u0c1a\u0c47 \u0c2a\u0c4d\u0c30\u0c35\u0c30\u0c4d\u0c24\u0c28, \u0c05\u0c36\u0c4d\u0c32\u0c40\u0c32 \u0c32\u0c47\u0c26\u0c3e \u0c05\u0c2d\u0c4d\u0c2f\u0c02\u0c24\u0c30\u0c15\u0c30\u0c2e\u0c48\u0c28 \u0c15\u0c02\u0c1f\u0c46\u0c02\u0c1f\u0c4d \u0c2a\u0c4d\u0c30\u0c38\u0c3e\u0c30\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c3e \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d\u0c15\u0c41 \u0c05\u0c02\u0c24\u0c30\u0c3e\u0c2f\u0c02 \u0c15\u0c32\u0c3f\u0c17\u0c3f\u0c02\u0c1a\u0c47 \u0c2a\u0c4d\u0c30\u0c35\u0c30\u0c4d\u0c24\u0c28 \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f."),(0,xe.Z)(ue,"termsHead4","\u0c28\u0c3e \u0c2a\u0c25\u0c15\u0c02\u0c32\u0c4b \u0c2e\u0c40\u0c30\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c47 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02:"),(0,xe.Z)(ue,"termsText5","<p> \u0c2e\u0c40 \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c16\u0c3e\u0c24\u0c3e\u0c32\u0c4b \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c2e\u0c28\u0c3f \u0c2e\u0c3f\u0c2e\u0c4d\u0c2e\u0c32\u0c4d\u0c28\u0c3f \u0c05\u0c21\u0c3f\u0c17\u0c3f\u0c24\u0c47, \u0c2e\u0c40\u0c30\u0c41 \u0c38\u0c30\u0c2b\u0c30\u0c3e \u0c1a\u0c47\u0c38\u0c47 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c2e\u0c48\u0c28\u0c26\u0c3f\u0c17\u0c3e \u0c09\u0c02\u0c21\u0c3e\u0c32\u0c3f. \u0c2e\u0c40\u0c30\u0c41 \u0c05\u0c38\u0c02\u0c2a\u0c42\u0c30\u0c4d\u0c23\u0c2e\u0c48\u0c28, \u0c38\u0c30\u0c3f\u0c15\u0c3e\u0c28\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c24\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c30\u0c2b\u0c30\u0c3e \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c47, \u0c05\u0c28\u0c27\u0c3f\u0c15\u0c3e\u0c30 \u0c1a\u0c30\u0c4d\u0c2f\u0c28\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f (\u0c32\u0c47\u0c26\u0c3e \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f) \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c30\u0c28\u0c3f, \u0c32\u0c47\u0c26\u0c3e \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d\u0c28\u0c41 \u0c26\u0c41\u0c30\u0c4d\u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c02 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c47, \u0c05\u0c26\u0c3f \u0c2e\u0c40 \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c2f\u0c3e\u0c15\u0c4d\u0c38\u0c46\u0c38\u0c4d\u0c28\u0c41 \u0c28\u0c3f\u0c32\u0c3f\u0c2a\u0c3f\u0c35\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41. </p> \u0c24\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c24\u0c2a\u0c4d\u0c2a\u0c41\u0c26\u0c4b\u0c35 \u0c2a\u0c1f\u0c4d\u0c1f\u0c3f\u0c02\u0c1a\u0c47 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c07\u0c35\u0c4d\u0c35\u0c21\u0c02 \u0c24\u0c40\u0c35\u0c4d\u0c30\u0c2e\u0c48\u0c28 \u0c28\u0c47\u0c30\u0c02. \u0c2e\u0c48 \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c05\u0c38\u0c02\u0c2a\u0c42\u0c30\u0c4d\u0c23\u0c2e\u0c48\u0c28, \u0c38\u0c30\u0c3f\u0c15\u0c3e\u0c28\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c24\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c05\u0c28\u0c47\u0c26\u0c3f \u0c12\u0c15 \u0c2b\u0c3e\u0c30\u0c02\u0c32\u0c4b \u0c32\u0c47\u0c26\u0c3e \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24\u0c02\u0c17\u0c3e \u0c24\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c35\u0c3f\u0c27\u0c02\u0c17\u0c3e\u0c28\u0c47 \u0c2a\u0c30\u0c3f\u0c17\u0c23\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c4d\u0c30\u0c3e\u0c38\u0c3f\u0c15\u0c4d\u0c2f\u0c42\u0c37\u0c28\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c3f\u0c35\u0c3f\u0c32\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c15\u0c4d\u0c30\u0c3f\u0c2e\u0c3f\u0c28\u0c32\u0c4d \u0c1c\u0c30\u0c3f\u